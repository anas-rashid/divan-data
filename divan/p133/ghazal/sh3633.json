{
 "FullUrl": "/p133/ghazal/sh3633",
 "Title": "خبر تحیر عشق سن نہ جنوں رہا نہ پری رہی",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "خبر تحیر عشق سن نہ جنوں رہا نہ پری رہی",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "نہ تو تو رہا نہ تو میں رہا جو رہی سو بے خبری رہی",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "شہ بے خودی نے عطا کیا مجھے اب لباس برہنگی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "نہ خرد کی بخیہ گری رہی نہ جنوں کی پردہ دری رہی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "چلی سمت غیب سیں کیا ہوا کہ چمن ظہور کا جل گیا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "مگر ایک شاخ نہال غم جسے دل کہو سو ہری رہی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "نظر تغافل یار کا گلہ کس زباں سیں بیاں کروں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کہ شراب صد قدح آرزو خم دل میں تھی سو بھری رہی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "وو عجب گھڑی تھی میں جس گھڑی لیا درس نسخۂ عشق کا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "کہ کتاب عقل کی طاق پر جوں دھری تھی تیوں ہی دھری رہی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "ترے جوش حیرت حسن کا اثر اس قدر سیں یہاں ہوا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "کہ نہ آئینہ میں رہی جلا نہ پری کوں جلوہ گری رہی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "کیا خاک آتش عشق نے دل بے نوائے سراجؔ کوں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "نہ خطر رہا نہ حذر رہا مگر ایک بے خطری رہی",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
