{
 "FullUrl": "/p238/farsi/asrar-khodi/sh19",
 "Title": "بخش ۱۹ - الوقت سیف",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "سبز بادا خاک پاک شافعی",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "عالمی سر خوش ز تاک شافعی",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "فکر او کوکب ز گردون چیده است",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "سیف بران وقت را نامیده است",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "من چه گویم سر این شمشیر چیست",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "آب او سرمایه دار از زندگیست",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "صاحبش بالاتر از امید و بیم",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "دست او بیضا تر از دست کلیم",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "سنگ از یک ضربت او تر شود",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "بحر از محرومی نم بر شود",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "در کف موسی همین شمشیر بود",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "کار او بالاتر از تدبیر بود",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "سینه ی دریای احمر چاک کرد",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "قلزمی را خشک مثل خاک کرد",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "پنجه ی حیدر که خیبر گیر بود",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "قوت او از همین شمشیر بود",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "گردش گردون گردان دیدنی است",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "انقلاب روز و شب فهمیدنی است",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "ای اسیر دوش و فردا در نگر",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "در دل خود عالم دیگر نگر",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "در گل خود تخم ظلمت کاشتی",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "وقت را مثل خطی پنداشتی",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Right",
   "Text": "باز با پیمانه ی لیل و نهار",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Left",
   "Text": "فکر تو پیمود طول روزگار",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Right",
   "Text": "ساختی این رشته را زنار دوش",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Left",
   "Text": "گشته ئی مثل بتان باطل فروش",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Right",
   "Text": "کیمیا بودی و مشت گل شدی",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Left",
   "Text": "سر حق زائیدی و باطل شدی",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Right",
   "Text": "مسلمی؟ آزاد این زنار باش",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Left",
   "Text": "شمع بزم ملت احرار باش",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Right",
   "Text": "تو که از اصل زمان آگه نه ئی",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Left",
   "Text": "از حیات جاودان آگه نه ئی",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Right",
   "Text": "تا کجا در روز و شب باشی اسیر",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Left",
   "Text": "رمز وقت از «لی مع الله» یاد گیر",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Right",
   "Text": "این و آن پیداست از رفتار وقت",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Left",
   "Text": "زندگی سریست از اسرار وقت",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Right",
   "Text": "اصل وقت از گردش خورشید نیست",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Left",
   "Text": "وقت جاوید است و خور جاوید نیست",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Right",
   "Text": "عیش و غم عاشور و هم عید است وقت",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Left",
   "Text": "سر تاب ماه و خورشید است وقت",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Right",
   "Text": "وقت را مثل مکان گسترده ئی",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Left",
   "Text": "امتیاز دوش و فردا کرده ئی",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Right",
   "Text": "ای چو بو رم کرده از بستان خویش",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 44,
   "Position": "Left",
   "Text": "ساختی از دست خود زندان خویش",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 45,
   "Position": "Right",
   "Text": "وقت ما کو اول و آخر ندید",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 46,
   "Position": "Left",
   "Text": "از خیابان ضمیر ما دمید",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 47,
   "Position": "Right",
   "Text": "زنده از عرفان اصلش زنده تر",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 48,
   "Position": "Left",
   "Text": "هستی او از سحر تابنده تر",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 49,
   "Position": "Right",
   "Text": "زندگی از دهر و دهر از زندگی است",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 50,
   "Position": "Left",
   "Text": "«لاتسبوالدهر» فرمان نبی است",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 51,
   "Position": "Right",
   "Text": "نکته ای می گویمت روشن چو در",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 52,
   "Position": "Left",
   "Text": "تا شناسی امتیاز عبد و حر",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 53,
   "Position": "Right",
   "Text": "عبد گردد یاوه در لیل و نهار",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 54,
   "Position": "Left",
   "Text": "در دل حر یاوه گردد روزگار",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 55,
   "Position": "Right",
   "Text": "عبد از ایام می بافد کفن",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 56,
   "Position": "Left",
   "Text": "روز و شب را می تند بر خویشتن",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 57,
   "Position": "Right",
   "Text": "مرد حر خود را ز گل بر می کند",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 58,
   "Position": "Left",
   "Text": "خویش را بر روزگاران می تند",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 59,
   "Position": "Right",
   "Text": "عبد چون طایر بدام صبح و شام",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 60,
   "Position": "Left",
   "Text": "لذت پرواز بر جانش حرام",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 61,
   "Position": "Right",
   "Text": "سینه ی آزاده ی چابک نفس",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 62,
   "Position": "Left",
   "Text": "طایر ایام را گردد قفس",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 63,
   "Position": "Right",
   "Text": "عبد را تحصیل حاصل فطرت است",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 64,
   "Position": "Left",
   "Text": "واردات جان او بی ندرت است",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 65,
   "Position": "Right",
   "Text": "از گران خیزی مقام او همان",
   "CoupletIndex": 32,
   "SectionIndex1": 0
  },
  {
   "VOrder": 66,
   "Position": "Left",
   "Text": "ناله های صبح و شام او همان",
   "CoupletIndex": 32,
   "SectionIndex1": 0
  },
  {
   "VOrder": 67,
   "Position": "Right",
   "Text": "دمبدم نو آفرینی کار حر",
   "CoupletIndex": 33,
   "SectionIndex1": 0
  },
  {
   "VOrder": 68,
   "Position": "Left",
   "Text": "نغمه پیهم تازه ریزد تار حر",
   "CoupletIndex": 33,
   "SectionIndex1": 0
  },
  {
   "VOrder": 69,
   "Position": "Right",
   "Text": "فطرتش زحمت کش تکرار نیست",
   "CoupletIndex": 34,
   "SectionIndex1": 0
  },
  {
   "VOrder": 70,
   "Position": "Left",
   "Text": "جاده ی او حلقه ی پرگار نیست",
   "CoupletIndex": 34,
   "SectionIndex1": 0
  },
  {
   "VOrder": 71,
   "Position": "Right",
   "Text": "عبد را ایام زنجیر است و بس",
   "CoupletIndex": 35,
   "SectionIndex1": 0
  },
  {
   "VOrder": 72,
   "Position": "Left",
   "Text": "بر لب او حرف تقدیر است و بس",
   "CoupletIndex": 35,
   "SectionIndex1": 0
  },
  {
   "VOrder": 73,
   "Position": "Right",
   "Text": "همت حر با قضا گردد مشیر",
   "CoupletIndex": 36,
   "SectionIndex1": 0
  },
  {
   "VOrder": 74,
   "Position": "Left",
   "Text": "حادثات از دست او صورت پذیر",
   "CoupletIndex": 36,
   "SectionIndex1": 0
  },
  {
   "VOrder": 75,
   "Position": "Right",
   "Text": "رفته و آینده در موجود او",
   "CoupletIndex": 37,
   "SectionIndex1": 0
  },
  {
   "VOrder": 76,
   "Position": "Left",
   "Text": "دیرها آسوده اندر زود او",
   "CoupletIndex": 37,
   "SectionIndex1": 0
  },
  {
   "VOrder": 77,
   "Position": "Right",
   "Text": "آمد از صوت و صدا پاک این سخن",
   "CoupletIndex": 38,
   "SectionIndex1": 0
  },
  {
   "VOrder": 78,
   "Position": "Left",
   "Text": "در نمی آید به ادراک این سخن",
   "CoupletIndex": 38,
   "SectionIndex1": 0
  },
  {
   "VOrder": 79,
   "Position": "Right",
   "Text": "گفتم و حرفم ز معنی شرمسار",
   "CoupletIndex": 39,
   "SectionIndex1": 0
  },
  {
   "VOrder": 80,
   "Position": "Left",
   "Text": "شکوه ی معنی که با حرفم چه کار",
   "CoupletIndex": 39,
   "SectionIndex1": 0
  },
  {
   "VOrder": 81,
   "Position": "Right",
   "Text": "زنده معنی چون به حرف آمد بمرد",
   "CoupletIndex": 40,
   "SectionIndex1": 0
  },
  {
   "VOrder": 82,
   "Position": "Left",
   "Text": "از نفس های تو نار او فسرد",
   "CoupletIndex": 40,
   "SectionIndex1": 0
  },
  {
   "VOrder": 83,
   "Position": "Right",
   "Text": "نکته ی غیب و حضور اندر دل است",
   "CoupletIndex": 41,
   "SectionIndex1": 0
  },
  {
   "VOrder": 84,
   "Position": "Left",
   "Text": "رمز ایام و مرور اندر دل است",
   "CoupletIndex": 41,
   "SectionIndex1": 0
  },
  {
   "VOrder": 85,
   "Position": "Right",
   "Text": "نغمه ی خاموش دارد ساز وقت",
   "CoupletIndex": 42,
   "SectionIndex1": 0
  },
  {
   "VOrder": 86,
   "Position": "Left",
   "Text": "غوطه در دل زن که بینی راز وقت",
   "CoupletIndex": 42,
   "SectionIndex1": 0
  },
  {
   "VOrder": 87,
   "Position": "Right",
   "Text": "یاد ایامی که سیف روزگار",
   "CoupletIndex": 43,
   "SectionIndex1": 0
  },
  {
   "VOrder": 88,
   "Position": "Left",
   "Text": "با توانا دستی ما بود یار",
   "CoupletIndex": 43,
   "SectionIndex1": 0
  },
  {
   "VOrder": 89,
   "Position": "Right",
   "Text": "تخم دین در کشت دلها کاشتیم",
   "CoupletIndex": 44,
   "SectionIndex1": 0
  },
  {
   "VOrder": 90,
   "Position": "Left",
   "Text": "پرده از رخسار حق برداشتیم",
   "CoupletIndex": 44,
   "SectionIndex1": 0
  },
  {
   "VOrder": 91,
   "Position": "Right",
   "Text": "ناخن ما عقده ی دنیا گشاد",
   "CoupletIndex": 45,
   "SectionIndex1": 0
  },
  {
   "VOrder": 92,
   "Position": "Left",
   "Text": "بخت این خاک از سجود ما گشاد",
   "CoupletIndex": 45,
   "SectionIndex1": 0
  },
  {
   "VOrder": 93,
   "Position": "Right",
   "Text": "از خم حق باده ی گلگون زدیم",
   "CoupletIndex": 46,
   "SectionIndex1": 0
  },
  {
   "VOrder": 94,
   "Position": "Left",
   "Text": "بر کهن میخانه ها شبخون زدیم",
   "CoupletIndex": 46,
   "SectionIndex1": 0
  },
  {
   "VOrder": 95,
   "Position": "Right",
   "Text": "ای می دیرینه در مینای تو",
   "CoupletIndex": 47,
   "SectionIndex1": 0
  },
  {
   "VOrder": 96,
   "Position": "Left",
   "Text": "شیشه آب از گرمی صهبای تو",
   "CoupletIndex": 47,
   "SectionIndex1": 0
  },
  {
   "VOrder": 97,
   "Position": "Right",
   "Text": "از غرور و نخوت و کبر و منی",
   "CoupletIndex": 48,
   "SectionIndex1": 0
  },
  {
   "VOrder": 98,
   "Position": "Left",
   "Text": "طعنه بر ناداری ما میزنی",
   "CoupletIndex": 48,
   "SectionIndex1": 0
  },
  {
   "VOrder": 99,
   "Position": "Right",
   "Text": "جام ما هم زیب محفل بوده است",
   "CoupletIndex": 49,
   "SectionIndex1": 0
  },
  {
   "VOrder": 100,
   "Position": "Left",
   "Text": "سینه ی ما صاحب دل بوده است",
   "CoupletIndex": 49,
   "SectionIndex1": 0
  },
  {
   "VOrder": 101,
   "Position": "Right",
   "Text": "عصر نو از جلوه ها آراسته",
   "CoupletIndex": 50,
   "SectionIndex1": 0
  },
  {
   "VOrder": 102,
   "Position": "Left",
   "Text": "از غبار پای ما برخاسته",
   "CoupletIndex": 50,
   "SectionIndex1": 0
  },
  {
   "VOrder": 103,
   "Position": "Right",
   "Text": "کشت حق سیراب گشت از خون ما",
   "CoupletIndex": 51,
   "SectionIndex1": 0
  },
  {
   "VOrder": 104,
   "Position": "Left",
   "Text": "حق پرستان جهان ممنون ما",
   "CoupletIndex": 51,
   "SectionIndex1": 0
  },
  {
   "VOrder": 105,
   "Position": "Right",
   "Text": "عالم از ما صاحب تکبیر شد",
   "CoupletIndex": 52,
   "SectionIndex1": 0
  },
  {
   "VOrder": 106,
   "Position": "Left",
   "Text": "از گل ما کعبه ها تعمیر شد",
   "CoupletIndex": 52,
   "SectionIndex1": 0
  },
  {
   "VOrder": 107,
   "Position": "Right",
   "Text": "حرف اقرأ حق بما تعلیم کرد",
   "CoupletIndex": 53,
   "SectionIndex1": 0
  },
  {
   "VOrder": 108,
   "Position": "Left",
   "Text": "رزق خویش از دست ما تقسیم کرد",
   "CoupletIndex": 53,
   "SectionIndex1": 0
  },
  {
   "VOrder": 109,
   "Position": "Right",
   "Text": "گرچه رفت از دست ما تاج و نگین",
   "CoupletIndex": 54,
   "SectionIndex1": 0
  },
  {
   "VOrder": 110,
   "Position": "Left",
   "Text": "ما گدایان را بچشم کم مبین",
   "CoupletIndex": 54,
   "SectionIndex1": 0
  },
  {
