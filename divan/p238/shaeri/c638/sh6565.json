{
 "FullUrl": "/p238/shaeri/c638/sh6565",
 "Title": "ابی سِینیا",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(۱۸ اگست ۱۹۳۵ء)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "یورپ کے کرگسوں کو نہیں ہے ابھی خبر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "ہے کتنی زہر ناک ابی سِینیا کی لاش",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Single",
   "Text": "ہونے کو ہے یہ مُردۂ دیرینہ قاش قاش!",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "تہذیب کا کمال شرافت کا ہے زوال",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "غارت گری جہاں میں ہے اقوام کی معاش",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Single",
   "Text": "ہر گُرگ کو ہے برّۂ معصوم کی تلاش!",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "اے وائے آبُروئے کلیسا کا آئِنہ",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "روما نے کر دیا سرِ بازار پاش پاش",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Single",
   "Text": "پیرِ کلیسیا! یہ حقیقت ہے دلخراش!",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
