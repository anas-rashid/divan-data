{
 "FullUrl": "/p238/shaeri/c638/sh6582",
 "Title": "امُرَائے عرب سے",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "کرے یہ کافرِ ہندی بھی جُرأتِ گُفتار",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "اگر نہ ہو اُمَرائے عرب کی بے ادبی!",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "یہ نکتہ پہلے سِکھایا گیا کس اُمّت کو؟",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "وصال مُصطفوی، افتراق بُولہَبی!",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "نہیں وجود حدود و ثُغُور سے اس کا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "محمدِؐ عَربی سے ہے عالمِ عَربی!",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Paragraph",
   "Text": "٭ بھوپال شیش محل میں لکھے گئے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  }
 ],
