{
 "FullUrl": "/p238/shaeri/c638/sh6593",
 "Title": "اُمِّید",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "مقابلہ تو زمانے کا خوب کرتا ہُوں",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "اگرچہ مَیں نہ سپاہی ہُوں نے امیرِ جنُود",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "مجھے خبر نہیں یہ شاعری ہے یا کچھ اور",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "عطا ہُوا ہے مجھے ذکر و فکر و جذب و سرود",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "جبینِ بندۂ حق میں نمود ہے جس کی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "اُسی جلال سے لبریز ہے ضمیرِ وجود",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "یہ کافری تو نہیں، کافری سے کم بھی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کہ مردِ حق ہو گرفتارِ حاضر و موجود",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "غمیں نہ ہو کہ بہت دَور ہیں ابھی باقی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "نئے ستاروں سے خالی نہیں سِپہرِ کبود",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Paragraph",
   "Text": "٭ ریاض منزل (دولت کدۂ سرراس مسعود) بھوپال میں لکھے گئے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  }
 ],
