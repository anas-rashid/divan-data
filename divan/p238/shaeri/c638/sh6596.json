{
 "FullUrl": "/p238/shaeri/c638/sh6596",
 "Title": "اِبلیس کا فرمان اپنے سیاسی فرزندوں کے نام",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "لا کر بَرہمنوں کو سیاست کے پیچ میں",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "زُناّریوں کو دَیرِ کُہن سے نکال دو",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "وہ فاقہ کش کہ موت سے ڈرتا نہیں ذرا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "رُوحِ محمدؐ اس کے بدن سے نکال دو",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "فکرِ عرب کو دے کے فرنگی تخیّلات",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "اسلام کو حِجاز و یمن سے نکال دو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "افغانیوں کی غیرتِ دیں کا ہے یہ علاج",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "مُلّا کو اُن کے کوہ و دمن سے نکال دو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "اہلِ حرم سے اُن کی روایات چھِین لو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "آہُو کو مرغزارِ خُتن سے نکال دو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "اقبالؔ کے نفَس سے ہے لالے کی آگ تیز",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "ایسے غزل سرا کو چمن سے نکال دو!",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Paragraph",
   "Text": "٭ بھوپال (شیش محل) میں لکھے گئے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
