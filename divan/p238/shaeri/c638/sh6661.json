{
 "FullUrl": "/p238/shaeri/c638/sh6661",
 "Title": "تصوّف",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "یہ حکمتِ ملکوتی، یہ علمِ لاہُوتی",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "حرم کے درد کا درماں نہیں تو کچھ بھی نہیں",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "یہ ذکرِ نیم شبی، یہ مراقبے، یہ سُرور",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "تری خودی کے نگہباں نہیں تو کچھ بھی نہیں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "یہ عقل، جو مہ و پرویں کا کھیلتی ہے شکار",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "شریکِ شورشِ پنہاں نہیں تو کچھ بھی نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "خِرد نے کہہ بھی دیا ’لااِلہ‘ تو کیا حاصل",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "دل و نگاہ مسلماں نہیں تو کچھ بھی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "عجب نہیں کہ پریشاں ہے گفتگو میری",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "فروغِ صبح پریشاں نہیں تو کچھ بھی نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Paragraph",
   "Text": "٭ ریاض منزل (دولت کدہ سرراس مسعود) بھوپال میں لکھے گئے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  }
 ],
