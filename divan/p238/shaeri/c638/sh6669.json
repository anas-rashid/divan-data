{
 "FullUrl": "/p238/shaeri/c638/sh6669",
 "Title": "تقدیر (اِبلیس و یَزداں)",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Single",
   "Text": "اِبلیس",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Single",
   "Text": "اے خدائے کُن فکاں! مجھ کو نہ تھا آدم سے بَیر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Single",
   "Text": "آہ! وہ زندانیِ نزدیک و دُور و دیر و زُود",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Single",
   "Text": "حرفِ ’اِستکبار‘ تیرے سامنے ممکن نہ تھا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Single",
   "Text": "ہاں، مگر تیری مشیّت میں نہ تھا میرا سجود",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "یزداں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "کب کھُلا تجھ پر یہ راز، انکار سے پہلے کہ بعد؟",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "اِبلیس",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "بعد، اے تیری تجلّی سے کمالاتِ وجود!",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "یزداں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "(فرشتوں کی طرف دیکھ کر)",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "پستیِ فطرت نے سِکھلائی ہے یہ حُجتّ اسے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "کہتا ہے ’تیری مشیّت میں نہ تھا میرا سجود،",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "دے رہا ہے اپنی آزادی کو مجبوری کا نام",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "ظالم اپنے شُعلۂ سوزاں کو خود کہتا ہے دُود!",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Single",
   "Text": "(ماخوذ از محی الدّین ابنِ عربیؒ)",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
