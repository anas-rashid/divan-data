{
 "FullUrl": "/p238/shaeri/c638/sh6698",
 "Title": "جمعیتِ اقوام مشرق",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "پانی بھی مسخرّ ہے، ہوا بھی ہے مسخرّ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "کیا ہو جو نگاہِ فلکِ پِیر بدل جائے",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "دیکھا ہے مُلوکِیّتِ افرنگ نے جو خواب",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "ممکن ہے کہ اُس خواب کی تعبیر بدل جائے",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "طہران ہو گر عالَمِ مشرق کا جینوا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "شاید کُرۂ ارض کی تقدیر بدل جائے!",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Paragraph",
   "Text": "٭ بھوپال (شیش محل) میں لکھے گئے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  }
 ],
