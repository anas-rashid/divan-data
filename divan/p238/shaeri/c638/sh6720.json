{
 "FullUrl": "/p238/shaeri/c638/sh6720",
 "Title": "حکومت",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "ہے مُریدوں کو تو حق بات گوارا لیکن",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "شیخ و مُلّا کو بُری لگتی ہے درویش کی بات",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "قوم کے ہاتھ سے جاتا ہے متاعِ کردار",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "بحث میں آتا ہے جب فلسفۂ ذات و صفات",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "گرچہ اس دَیرِ کُہن کا ہے یہ دستورِ قدیم",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "کہ نہیں مے کدہ و ساقی و مِینا کو ثبات",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "قسمتِ بادہ مگر حق ہے اُسی ملّت کا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "انگبیں جس کے جوانوں کو ہے تلخابِ حیات!",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Paragraph",
   "Text": "٭ ریاض منزل (دولت کدۂ سرراس مسعود) بھوپال میں لکھے گئے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  }
 ],
