{
 "FullUrl": "/p238/shaeri/c638/sh6910",
 "Title": "غلاموں کی نماز",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(تُرکی وفدِ ہلالِ احمر لاہور میں)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "کہا مجاہدِ تُرکی نے مجھ سے بعدِ نماز",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "طویل سجدہ ہیں کیوں اس قدر تمھارے امام",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "وہ سادہ مردِ مجاہد، وہ مومنِ آزاد",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "خبر نہ تھی اُسے کیا چیز ہے نمازِ غلام",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "ہزار کام ہیں مردانِ حُر کو دُنیا میں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "انھی کے ذوقِ عمل سے ہیں اُمتّوں کے نظام",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "بدن غلام کا سوزِ عمل سے ہے محروم",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "کہ ہے مروُر غلاموں کے روز و شب پہ حرام",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "طویل سجدہ اگر ہیں تو کیا تعجبّ ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "ورائے سجدہ غریبوں کو اَور کیا ہے کام",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "خدا نصیب کرے ہِند کے اماموں کو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "وہ سجدہ جس میں ہے مِلّت کی زندگی کا پیام!",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
