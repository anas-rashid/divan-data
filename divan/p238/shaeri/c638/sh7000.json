{
 "FullUrl": "/p238/shaeri/c638/sh7000",
 "Title": "مومن",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Single",
   "Text": "(دُنیا میں)",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Single",
   "Text": "ہو حلقۂ یاراں تو بریشم کی طرح نرم",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Single",
   "Text": "رزمِ حق و باطل ہو تو فولاد ہے مومن",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Single",
   "Text": "افلاک سے ہے اس کی حریفانہ کشاکش",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Single",
   "Text": "خاکی ہے مگر خاک سے آزاد ہے مومن",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Single",
   "Text": "جچتے نہیں کنجشک و حمام اس کی نظر میں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Single",
   "Text": "جِبریل و سرافیل کا صیّاد ہے مومن",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Single",
   "Text": "(جنّت میں)",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Single",
   "Text": "کہتے ہیں فرشتے کہ دِل آویز ہے مومن",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Single",
   "Text": "حُوروں کو شکایت ہے کم آمیز ہے مومن",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Paragraph",
   "Text": "٭ بھوپال (شیش محل) میں لکھے گئے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  }
 ],
