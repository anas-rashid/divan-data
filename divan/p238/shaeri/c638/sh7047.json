{
 "FullUrl": "/p238/shaeri/c638/sh7047",
 "Title": "نگاہ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "بہار و قافلۂ لالہ ہائے صحرائی",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "شباب و مستی و ذوق و سُرور و رعنائی!",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "اندھیری رات میں یہ چشمکیں ستاروں کی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "یہ بحر، یہ فَلکِ نیلگوں کی پہنائی!",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "سفر عروسِ قمر کا عماریِ شب میں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "طلوعِ مِہر و سکُوتِ سپہرِ مینائی!",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "نِگاہ ہو تو بہائے نظارہ کچھ بھی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کہ بیچتی نہیں فطرت جمال و زیبائی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Paragraph",
   "Text": "٭ ریاض منزل (دولت کدۂ سرراس مسعود) بھوپال میں لکھے گئے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  }
 ],
