{
 "FullUrl": "/p238/shaeri/c640/sh6564",
 "Title": "ابوالعلامعرّیؔ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "کہتے ہیں کبھی گوشت نہ کھاتا تھا معّری",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "پھل پھُول پہ کرتا تھا ہمیشہ گزر اوقات",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "اک دوست نے بھُونا ہوا تِیتر اسے بھیجا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "شاید کہ وہ شاطِر اسی ترکیب سے ہو مات",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "یہ خوانِ تر و تازہ معّری نے جو دیکھا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "کہنے لگا وہ صاحبِ عفران و لزومات",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "اے مُرغکِ بیچارہ! ذرا یہ تو بتا تُو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "تیرا وہ گُنہ کیا تھا یہ ہے جس کی مکافات؟",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "افسوس، صد افسوس کہ شاہیں نہ بنا تُو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "دیکھے نہ تری آنکھ نے فطرت کے اشارات",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "تقدیر کے قاضی کا یہ فتویٰ ہے ازل سے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "ہے جُرمِ ضعیفی کی سزا مرگِ مفاجات!",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Paragraph",
   "Text": "٭ عفران۔ رسالتہ الغفران، معری کی ایک مشہور کتاب کا نام ہے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
  "at": "2026-10-11T15:02:45.633Z"
 }
}
