{
 "FullUrl": "/p238/shaeri/c640/sh6574",
 "Title": "اعجاز ہے کسی کا یا گردش زمانہ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "اعجاز ہے کسی کا یا گردش زمانہ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "ٹوٹا ہے ایشیا میں سحر فرنگیانہ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "تعمیرِ آشیاں سے میں نے یہ راز پایا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "اہلِ نوا کے حق میں بجلی ہے آشیانہ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "یہ بندگی خدائی، وہ بندگی گدائی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "یہ بندۂ خدا بن یا بندۂ زمانہ",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "غافل نہ ہو خودی سے کر اپنی پاسبانی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "شاید کسی حرم کا تو بھی ہے آستانہ",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "اے لآ اِلہٰ کے وارث باقی نہیں ہے تجھ میں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "گفتارِ دلبرانہ، کردارِ قاہرانہ",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "تیری نگاہ سے دل سینوں میں کانپتے تھے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "کھویا گیا ہے تیرا جذب قلندرانہ",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "رازِ حرم سے شاید اقبال با خبر ہے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "ہیں اس کی گفتگو کے انداز محرمانہ",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
