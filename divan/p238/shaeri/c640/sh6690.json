{
 "FullUrl": "/p238/shaeri/c640/sh6690",
 "Title": "جاوید کے نام (دیارِ عشق میں اپنا مقام پیدا کر)",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(لندن میں اُس کے ہاتھ کا لِکھّا ہُوا پہلا خط آنے پر)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "دیارِ عشق میں اپنا مقام پیدا کر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "نیا زمانہ، نئے صبح و شام پیدا کر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "خدا اگر دل فطرت شناس دے تجھ کو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "سکُوتِ لالہ و گُل سے کلام پیدا کر",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "اُٹھا نہ شیشہ گرانِ فرنگ کے احساں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "سفالِ ہند سے مِینا و جام پیدا کر",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "میں شاخِ تاک ہوں، میری غزل ہے میرا ثمر",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "مرے ثمر سے میء لالہ فام پیدا کر",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "مرا طریق امیری نہیں، فقیری ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "خودی نہ بیچ، غریبی میں نام پیدا کر!",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  }
 ],
