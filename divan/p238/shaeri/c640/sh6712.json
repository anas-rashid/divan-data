{
 "FullUrl": "/p238/shaeri/c640/sh6712",
 "Title": "حال و مقام",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "دل زندہ و بیدار اگر ہو تو بتدریج",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "بندے کو عطا کرتے ہیں چشمِ نِگَراں اور",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "احوال و مقامات پہ موقوف ہے سب کچھ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "ہر لحظہ ہے سالک کا زماں اور مکاں اور",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "الفاظ و معانی میں تفاوت نہیں لیکن",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "مُلّا کی اذاں اور، مجاہد کی اذاں اور",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "پرواز ہے دونوں کی اسی ایک فضا میں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کرگس کا جہاں اور ہے، شاہیں کا جہاں اور",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Paragraph",
   "Text": "٭ ابو العلا معرّیؔ",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  }
 ],
