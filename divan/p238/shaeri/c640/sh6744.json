{
 "FullUrl": "/p238/shaeri/c640/sh6744",
 "Title": "خوشحال خاںکی وصیّت",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "قبائل ہوں ملّت کی وحدت میں گُم",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "کہ ہو نام افغانیوں کا بلند",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "محبّت مجھے اُن جوانوں سے ہے",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "ستاروں پہ جو ڈالتے ہیں کمند",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "مغل سے کسی طرح کمتر نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "قہستاں کا یہ بّچۂ ارجمند",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "کہوں تجھ سے اے ہم نشیں دل کی بات",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "وہ مدفن ہے خوشحال خاں کو پسند",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "اُڑا کر نہ لائے جہاں بادِ کوہ",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "مُغل شہسواروں کی گردِ سمند!",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Paragraph",
   "Text": "٭ خوشحال خاں خٹک پشتوزبان کا مشہور وطن دوست شاعر تھا جس نے افغانستان کو مغلوں سے آزادکرانے کے لیے سرحد کے افغانی قبائل کی ایک جمعیّت قائم کی۔قبائل میں صرف آفریدیوں نے آخردم تک اُس کا ساتھ دیا۔ اس کی قریبا ایک سو نظموں کا انگریزی ترجمہ ۱۸۶۲؁ء میں لندن میں شائع ہُوا تھا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  }
 ],
