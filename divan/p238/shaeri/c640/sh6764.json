{
 "FullUrl": "/p238/shaeri/c640/sh6764",
 "Title": "دُعا (ہے یہی میری نماز، ہے یہی میرا وضو)",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(مسجدِ قُرطُبہ میں لِکھّی گئی)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "ہے یہی میری نماز، ہے یہی میرا وضو",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "میری نواؤں میں ہے میرے جگر کا لہُو",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "صُحبتِ اہلِ صفا، نُور و حضور و سُرور",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "سر خوش و پُرسوز ہے لالہ لبِ آبُجو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "راہِ محبّت میں ہے کون کسی کا رفیق",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "ساتھ مرے رہ گئی ایک مری آرزو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "میرا نشیمن نہیں درگہِ میر و وزیر",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "میرا نشیمن بھی تُو، شاخِ نشیمن بھی تُو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "تجھ سے گریباں مرا مطلعِ صُبحِ نشور",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "تجھ سے مرے سینے میں آتشِ ’اَﷲ ھو‘",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "تجھ سے مری زندگی سوز و تب و درد و داغ",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "تُو ہی مری آرزو، تُو ہی مری جُستجو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "پاس اگر تُو نہیں، شہر ہے ویراں تمام",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "تُو ہے تو آباد ہیں اُجڑے ہُوئے کاخ و کُو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "پھر وہ شرابِ کُہن مجھ کو عطا کر کہ مَیں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "ڈھُونڈ رہا ہوں اُسے توڑ کے جام و سُبو",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "چشمِ کرم ساقیا! دیر سے ہیں منتظر",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "جلوَتیوں کے سُبو، خلوَتیوں کے کُدو",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "تیری خدائی سے ہے میرے جُنوں کو گِلہ",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "اپنے لیے لامکاں، میرے لیے چار سُو!",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "فلسفہ و شعر کی اور حقیقت ہے کیا",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "حرفِ تمنّا، جسے کہہ نہ سکیں رُو بُرو",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
