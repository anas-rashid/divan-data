{
 "FullUrl": "/p238/shaeri/c640/sh6775",
 "Title": "ذوق و شوق",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ان اشعار میں سے اکثر فلسطین میں لِکھّے گئے)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "’دریغ آمدم زاں ہمہ بوستاں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "تہی دست رفتن سوئے دوستاں‘",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "قلب و نظر کی زندگی دشت میں صُبح کا سماں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "چشمۂ آفتاب سے نُور کی ندّیاں رواں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "حُسنِ اَزل کی ہے نمود، چاک ہے پردۂ وجود",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "دل کے لیے ہزار سُود ایک نگاہ کا زیاں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "سُرخ و کبود بدلیاں چھوڑ گیا سحابِ شب",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "کوہِ اِضم کو دے گیا رنگ برنگ طَیلساں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "گرد سے پاک ہے ہوا، برگِ نخیل دھُل گئے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "ریگِ نواح کاظمہ نرم ہے مثلِ پرنیاں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "آگ بُجھی ہُوئی اِدھر، ٹُوٹی ہُوئی طناب اُدھر",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "کیا خبر اس مقام سے گزرے ہیں کتنے کارواں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "آئی صدائے جِبرئیل، تیرا مقام ہے یہی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "اہلِ فراق کے لیے عیشِ دوام ہے یہی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "کس سے کہوں کہ زہر ہے میرے لیے مئے حیات",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "کُہنہ ہے بزمِ کائنات، تازہ ہیں میرے واردات",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "کیا نہیں اور غزنوی کارگہِ حیات میں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "بیٹھے ہیں کب سے منتظر اہلِ حرم کے سومنات",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "ذکرِ عرب کے سوز میں، فکرِ عجم کے ساز میں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "نے عربی مشاہدات، نے عجمی تخیّلات",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "قافلۂ حجاز میں ایک حُسینؓ بھی نہیں",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "گرچہ ہے تاب دار ابھی گیسوئے دجلہ و فرات",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "عقل و دل و نگاہ کا مُرشدِ اوّلیں ہے عشق",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "عشق نہ ہو تو شرع و دِیں بُت کدۂ تصوّرات",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "صدقِ خلیلؑ بھی ہے عشق، صبر حُسینؓ بھی ہے عشق",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "معرکۂ وجُود میں بدر و حُنَین بھی ہے عشق",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "آیۂ کائنات کا معنیِ دیر یاب تُو",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "نکلے تری تلاش میں قافلہ ہائے رنگ و بُو",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "جلوَتیانِ مدرسہ کور نگاہ و مُردہ ذوق",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "خلوَتیانِ مے کدہ کم طلب و تہی کدُو",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "مَیں کہ مری غزل میں ہے آتشِ رفتہ کا سُراغ",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "میری تمام سرگزشت کھوئے ہُوؤں کی جُستجو",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "بادِ صبا کی موج سے نشوونَمائے خار و خس",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "میرے نَفس کی موج سے نشوونَمائے آرزو",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "خُونِ دل و جگر سے ہے میری نَوا کی پرورش",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "ہے رگِ ساز میں رواں صاحبِ ساز کا لہُو",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Right",
   "Text": "’فُرصتِ کشمکش مدہ ایں دلِ بے قرار را",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Left",
   "Text": "یک دو شکن زیادہ کُن گیسوے تابدار را‘",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Right",
   "Text": "لَوح بھی تُو، قلم بھی تُو، تیرا وجود الکتاب",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Left",
   "Text": "گُنبدِ آبگینہ رنگ تیرے محیط میں حباب",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Right",
   "Text": "عالَمِ آب و خاک میں تیرے ظہور سے فروغ",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Left",
   "Text": "ذرّۂ ریگ کو دیا تُو نے طلوعِ آفتاب",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 44,
   "Position": "Right",
   "Text": "شوکتِ سنجر و سلیم تیرے جلال کی نمود",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 45,
   "Position": "Left",
   "Text": "فقرِ جُنیدؒ و بایزیدؒ تیرا جمالِ بے نقاب",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 46,
   "Position": "Right",
   "Text": "شوق ترا اگر نہ ہو میری نماز کا امام",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 47,
   "Position": "Left",
   "Text": "میرا قیام بھی حجاب، میرا سجود بھی حجاب",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 48,
   "Position": "Right",
   "Text": "تیری نگاہ ناز سے دونوں مراد پا گئے",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 49,
   "Position": "Left",
   "Text": "عقل غیاب و جستجو، عشق حضور و اضطراب",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 50,
   "Position": "Right",
   "Text": "تِیرہ و تار ہے جہاں گردشِ آفتاب سے",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 51,
   "Position": "Left",
   "Text": "طبعِ زمانہ تازہ کر جلوۂ بے حجاب سے",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 52,
   "Position": "Right",
   "Text": "تیری نظر میں ہیں تمام میرے گزشتہ روز و شب",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 53,
   "Position": "Left",
   "Text": "مجھ کو خبر نہ تھی کہ ہے علم نخیلِ بے رُطَب",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 54,
   "Position": "Right",
   "Text": "تازہ مرے ضمیر میں معرکۂ کُہَن ہُوا",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 55,
   "Position": "Left",
   "Text": "عشق تمام مصطفیؐ، عقل تمام بُولَہب",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 56,
   "Position": "Right",
   "Text": "گاہ بحیلہ می برد، گاہ بزور می کشد",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 57,
   "Position": "Left",
   "Text": "عشق کی ابتدا عجب، عشق کی انتہا عجب",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 58,
   "Position": "Right",
   "Text": "عالمِ سوز و ساز میں وصل سے بڑھ کے ہے فراق",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 59,
   "Position": "Left",
   "Text": "وصل میں مرگِ آرزو، ہجر میں لذّتِ طلب",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 60,
   "Position": "Right",
   "Text": "عینِ وصال میں مجھے حوصلۂ نظر نہ تھا",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 61,
   "Position": "Left",
   "Text": "گرچہ بہانہ جُو رہی میری نگاہِ بے ادب",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 62,
   "Position": "Right",
   "Text": "گرمیِ آرزو فراق، شورشِ ہاے و ہُو فراق",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 63,
   "Position": "Left",
   "Text": "مَوج کی جُستجو فراق، قطرے کی آبرو فراق!",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
