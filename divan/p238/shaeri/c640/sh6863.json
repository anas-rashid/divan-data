{
 "FullUrl": "/p238/shaeri/c640/sh6863",
 "Title": "طارق کی دُعا",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(اندلس کے میدانِ جنگ میں)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "یہ غازی، یہ تیرے پُر اسرار بندے",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "جنھیں تُو نے بخشا ہے ذوقِ خدائی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "دونیم ان کی ٹھوکر سے صحرا و دریا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "سِمٹ کر پہاڑ ان کی ہیبت سے رائی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "دو عالم سے کرتی ہے بیگانہ دل کو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "عجب چیز ہے لذّتِ آشنائی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "شہادت ہے مطلوب و مقصودِ مومن",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "نہ مالِ غنیمت نہ کِشور کشائی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "خیاباں میں ہے مُنتظر لالہ کب سے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "قبا چاہیے اس کو خُونِ عرب سے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "کیا تُو نے صحرا نشینوں کو یکتا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "خبر میں، نظر میں، اذانِ سحَر میں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "طلب جس کی صدیوں سے تھی زندگی کو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "وہ سوز اس نے پایا انھی کے جگر میں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "کُشادِ درِ دل سمجھتے ہیں اس کو",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "ہلاکت نہیں موت ان کی نظر میں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "دلِ مردِ مومن میں پھر زندہ کر دے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "وہ بجلی کہ تھی نعرۂ ’لَاتَذَر‘ میں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "عزائم کو سینوں میں بیدار کر دے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "نگاہِ مسلماں کو تلوار کر دے!",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
