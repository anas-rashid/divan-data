{
 "FullUrl": "/p238/shaeri/c640/sh6874",
 "Title": "عبد الرّحمٰن اوّل کا بویا ہُوا کھجور کا پہلا درخت",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "سرزمینِ اندلس میں",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Paragraph",
   "Text": "یہ اشعار جو عبد الرحمٰن اوّل کی تصنیف سے ہیں، ’تاریخ المقری‘ میں درج ہیں مندرجہ ذیل اردو نظم ان کا آزاد ترجمہ ہے (درخت مذکور مدینتہ الزّہرا میں بویا گیا تھا)",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "میری آنکھوں کا نُور ہے تُو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "میرے دل کا سُرور ہے تُو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "اپنی وادی سے دُور ہوں مَیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "میرے لیے نخلِ طُور ہے تُو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "مغرب کی ہوا نے تجھ کو پالا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "صحرائے عرب کی حُور ہے تُو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "پردیس میں ناصبور ہوں مَیں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "پردیس میں ناصبُور ہے تو",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "غُربت کی ہوا میں باروَر ہو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "ساقی تیرا نمِ سحَر ہو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "عالَم کا عجیب ہے نظارہ",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "دامانِ نِگہ ہے پارہ پارہ",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "ہمّت کو شناوری مبارک!",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "پیدا نہیں بحر کا کنارہ",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "ہے سوزِ دُروں سے زندگانی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "اُٹھتا نہیں خاک سے شرارہ",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "صُبحِ غُربت میں اور چمکا",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "ٹُوٹا ہُوا شام کا ستارہ",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "مومن کے جہاں کی حد نہیں ہے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "مومن کا مقام ہر کہیں ہے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  }
 ],
