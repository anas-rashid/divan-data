{
 "FullUrl": "/p238/shaeri/c640/sh6919",
 "Title": "فرمانِ خدا",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(فرشتوں سے)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "اُٹھّو! مری دنیا کے غریبوں کو جگا دو",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "کاخِ اُمَرا کے در و دیوار ہِلا دو",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "گرماؤ غلاموں کا لہُو سوزِ یقیں سے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "کُنجشکِ فرومایہ کو شاہیں سے لڑا دو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "سُلطانیِ جمہور کا آتا ہے زمانہ",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "جو نقشِ کُہَن تم کو نظر آئے، مِٹا دو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "جس کھیت سے دہقاں کو میسرّ نہیں روزی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "اُس کھیت کے ہر خوشۂ گندم کو جلا دو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "کیوں خالق و مخلوق میں حائل رہیں پردے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "پِیرانِ کلیسا کو کلیسا سے اُٹھا دو",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "حق را بسجودے، صنَماں را بطوافے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "بہتر ہے چراغِ حَرم و دَیر بُجھا دو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "میں ناخوش و بیزار ہُوں مَرمَر کی سِلوں سے",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "میرے لیے مٹّی کا حرم اور بنا دو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "تہذیبِ نوی کارگہِ شیشہ گراں ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "آدابِ جُنوں شاعرِ مشرِق کو سِکھا دو!",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
