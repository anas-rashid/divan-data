{
 "FullUrl": "/p238/shaeri/c640/sh7003",
 "Title": "مسجدِ قُرطُبہ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ہسپانیہ کی سرزمین، بالخصوص قُرطُبہ میں لِکھّی گئی)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "سِلسلۂ روز و شب، نقش گرِ حادثات",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "سِلسلۂ روز و شب، اصلِ حیات و ممات",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "سِلسلۂ روز و شب، تارِ حریرِ دو رنگ",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "جس سے بناتی ہے ذات اپنی قبائے صفات",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "سِلسلۂ روز و شب، سازِ ازل کی فغاں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "جس سے دِکھاتی ہے ذات زِیروبمِ ممکنات",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "تجھ کو پرکھتا ہے یہ، مجھ کو پرکھتا ہے یہ",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "سِلسلۂ روز و شب، صَیرفیِ کائنات",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "تُو ہو اگر کم عیار، مَیں ہُوں اگر کم عیار",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "موت ہے تیری برات، موت ہے میری برات",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "تیرے شب وروز کی اور حقیقت ہے کیا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "ایک زمانے کی رَو جس میں نہ دن ہے نہ رات",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "آنی و فانی تمام معجزہ ہائے ہُنر",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "کارِ جہاں بے ثبات، کارِ جہاں بے ثبات!",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "اوّل و آخر فنا، باطن و ظاہر فنا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "نقشِ کُہن ہو کہ نَو، منزِل آخر فنا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "ہے مگر اس نقش میں رنگِ ثباتِ دوام",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "جس کو کِیا ہو کسی مردِ خدا نے تمام",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "مردِ خدا کا عمل عشق سے صاحب فروغ",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "عشق ہے اصلِ حیات، موت ہے اس پر حرام",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "تُند و سبک سَیر ہے گرچہ زمانے کی رَو",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "عشق خود اک سَیل ہے، سَیل کو لیتاہے تھام",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "عشق کی تقویم میں عصرِرواں کے سوا",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "اور زمانے بھی ہیں جن کا نہیں کوئی نام",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "عشق دمِ جبرئیل، عشق دلِ مصطفیؐ",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "عشق خدا کا رُسول، عشق خدا کا کلام",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "عشق کی مستی سے ہے پیکرِ گِل تابناک",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "عشق ہے صہبائے خام، عشق ہے کاسُ الکِرام",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "عشق فقیہِ حرم، عشق امیرِ جُنود",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "عشق ہے ابن السّبیل، اس کے ہزاروں مقام",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "عشق کے مِضراب سے نغمۂ تارِ حیات",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "عشق سے نُورِ حیات، عشق سے نارِ حیات",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "اے حَرمِ قُرطُبہ! عشق سے تیرا وجود",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "عشق سراپا دوام، جس میں نہیں رفت و بود",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "رنگ ہو یا خِشت و سنگ، چِنگ ہو یا حرف و صوت",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "معجزۂ فن کی ہے خُونِ جگر سے نمود",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Right",
   "Text": "قطرۂ خُونِ جگر، سِل کو بناتا ہے دل",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Left",
   "Text": "خُونِ جگر سے صدا سوز و سُرور و سرود",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Right",
   "Text": "تیری فضا دل فروز، میری نوا سینہ سوز",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Left",
   "Text": "تجھ سے دِلوں کا حضور، مجھ سے دِلوں کی کشود",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Right",
   "Text": "عرشِ معلّیٰ سے کم سینۂ آدم نہیں",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Left",
   "Text": "گرچہ کفِ خاک کی حد ہے سِپہرِ کبُود",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 44,
   "Position": "Right",
   "Text": "پیکرِ نُوری کو ہے سجدہ میّسر تو کیا",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 45,
   "Position": "Left",
   "Text": "اس کو میّسر نہیں سوز و گدازِ سجود",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 46,
   "Position": "Right",
   "Text": "کافرِ ہندی ہُوں مَیں، دیکھ مرا ذوق و شوق",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 47,
   "Position": "Left",
   "Text": "دل میں صلٰوۃ و دُرود، لب پہ صلوٰۃ و دُرود",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 48,
   "Position": "Right",
   "Text": "شوق مری لَے میں ہے، شوق مری نَے میں ہے",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 49,
   "Position": "Left",
   "Text": "نغمۂ ’اَﷲ ھُو‘ میرے رَگ و پَے میں ہے",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 50,
   "Position": "Right",
   "Text": "تیرا جلال و جمال، مردِ خدا کی دلیل",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 51,
   "Position": "Left",
   "Text": "وہ بھی جلیل و جمیل، تُو بھی جلیل و جمیل",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 52,
   "Position": "Right",
   "Text": "تیری بِنا پائدار، تیرے سُتوں بے شمار",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 53,
   "Position": "Left",
   "Text": "شام کے صحرا میں ہو جیسے ہُجومِ نخیل",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 54,
   "Position": "Right",
   "Text": "تیرے در و بام پر وادیِ اَیمن کا نور",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 55,
   "Position": "Left",
   "Text": "تیرا منارِ بلند جلوہ گہِ جبرئیل",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 56,
   "Position": "Right",
   "Text": "مِٹ نہیں سکتا کبھی مردِ مسلماں کہ ہے",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 57,
   "Position": "Left",
   "Text": "اس کی اذانوں سے فاش سرِّ کلیمؑ و خلیلؑ",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 58,
   "Position": "Right",
   "Text": "اس کی زمیں بے حدود، اس کا اُفُق بے ثُغور",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 59,
   "Position": "Left",
   "Text": "اس کے سمندر کی موج، دجلہ و دنیوب و نیل",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 60,
   "Position": "Right",
   "Text": "اس کے زمانے عجیب، اس کے فسانے غریب",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 61,
   "Position": "Left",
   "Text": "عہدِ کُہن کو دیا اس نے پیامِ رحیل",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 62,
   "Position": "Right",
   "Text": "ساقیِ اربابِ ذوق، فارسِ میدانِ شوق",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 63,
   "Position": "Left",
   "Text": "بادہ ہے اس کا رحیق، تیغ ہے اس کی اصیل",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 64,
   "Position": "Right",
   "Text": "مردِ سپاہی ہے وہ اس کی زِرہ ’لَا اِلہ‘",
   "CoupletIndex": 32,
   "SectionIndex1": 0
  },
  {
   "VOrder": 65,
   "Position": "Left",
   "Text": "سایۂ شمشیر میں اس کہ پنہ ’لَا اِلہ‘",
   "CoupletIndex": 32,
   "SectionIndex1": 0
  },
  {
   "VOrder": 66,
   "Position": "Right",
   "Text": "تجھ سے ہُوا آشکار بندۂ مومن کا راز",
   "CoupletIndex": 33,
   "SectionIndex1": 0
  },
  {
   "VOrder": 67,
   "Position": "Left",
   "Text": "اس کے دنوں کی تپِش، اس کی شبوں کا گداز",
   "CoupletIndex": 33,
   "SectionIndex1": 0
  },
  {
   "VOrder": 68,
   "Position": "Right",
   "Text": "اس کا مقامِ بلند، اس کا خیالِ عظیم",
   "CoupletIndex": 34,
   "SectionIndex1": 0
  },
  {
   "VOrder": 69,
   "Position": "Left",
   "Text": "اس کا سُرور اس کا شوق، اس کا نیاز اس کا ناز",
   "CoupletIndex": 34,
   "SectionIndex1": 0
  },
  {
   "VOrder": 70,
   "Position": "Right",
   "Text": "ہاتھ ہے اللہ کا بندۂ مومن کا ہاتھ",
   "CoupletIndex": 35,
   "SectionIndex1": 0
  },
  {
   "VOrder": 71,
   "Position": "Left",
   "Text": "غالب و کار آفریں، کارکُشا، کارساز",
   "CoupletIndex": 35,
   "SectionIndex1": 0
  },
  {
   "VOrder": 72,
   "Position": "Right",
   "Text": "خاکی و نوری نہاد، بندۂ مولا صفات",
   "CoupletIndex": 36,
   "SectionIndex1": 0
  },
  {
   "VOrder": 73,
   "Position": "Left",
   "Text": "ہر دو جہاں سے غنی اس کا دلِ بے نیاز",
   "CoupletIndex": 36,
   "SectionIndex1": 0
  },
  {
   "VOrder": 74,
   "Position": "Right",
   "Text": "اس کی اُمیدیں قلیل، اس کے مقاصد جلیل",
   "CoupletIndex": 37,
   "SectionIndex1": 0
  },
  {
   "VOrder": 75,
   "Position": "Left",
   "Text": "اس کی ادا دل فریب، اس کی نِگہ دل نواز",
   "CoupletIndex": 37,
   "SectionIndex1": 0
  },
  {
   "VOrder": 76,
   "Position": "Right",
   "Text": "نرم دمِ گُفتگو، گرم دمِ جُستجو",
   "CoupletIndex": 38,
   "SectionIndex1": 0
  },
  {
   "VOrder": 77,
   "Position": "Left",
   "Text": "رزم ہو یا بزم ہو، پاک دل و پاک باز",
   "CoupletIndex": 38,
   "SectionIndex1": 0
  },
  {
   "VOrder": 78,
   "Position": "Right",
   "Text": "نُقطۂ پرکارِ حق، مردِ خدا کا یقیں",
   "CoupletIndex": 39,
   "SectionIndex1": 0
  },
  {
   "VOrder": 79,
   "Position": "Left",
   "Text": "اور یہ عالم تمام وہم و طلسم و مجاز",
   "CoupletIndex": 39,
   "SectionIndex1": 0
  },
  {
   "VOrder": 80,
   "Position": "Right",
   "Text": "عقل کی منزل ہے وہ، عشق کا حاصل ہے وہ",
   "CoupletIndex": 40,
   "SectionIndex1": 0
  },
  {
   "VOrder": 81,
   "Position": "Left",
   "Text": "حلقۂ آفاق میں گرمیِ محفل ہے وہ",
   "CoupletIndex": 40,
   "SectionIndex1": 0
  },
  {
   "VOrder": 82,
   "Position": "Right",
   "Text": "کعبۂ اربابِ فن! سطوَتِ دینِ مبیں",
   "CoupletIndex": 41,
   "SectionIndex1": 0
  },
  {
   "VOrder": 83,
   "Position": "Left",
   "Text": "تجھ سے حرم مرتبت اندلسیوں کی زمیں",
   "CoupletIndex": 41,
   "SectionIndex1": 0
  },
  {
   "VOrder": 84,
   "Position": "Right",
   "Text": "ہے تہِ گردُوں اگر حُسن میں تیری نظیر",
   "CoupletIndex": 42,
   "SectionIndex1": 0
  },
  {
   "VOrder": 85,
   "Position": "Left",
   "Text": "قلبِ مسلماں میں ہے، اَور نہیں ہے کہیں",
   "CoupletIndex": 42,
   "SectionIndex1": 0
  },
  {
   "VOrder": 86,
   "Position": "Right",
   "Text": "آہ وہ مردانِ حق! وہ عَربی شہسوار",
   "CoupletIndex": 43,
   "SectionIndex1": 0
  },
  {
   "VOrder": 87,
   "Position": "Left",
   "Text": "حاملِ ’ خُلقِ عظِیم‘، صاحبِ صدق و یقیں",
   "CoupletIndex": 43,
   "SectionIndex1": 0
  },
  {
   "VOrder": 88,
   "Position": "Right",
   "Text": "جن کی حکومت سے ہے فاش یہ رمزِ غریب",
   "CoupletIndex": 44,
   "SectionIndex1": 0
  },
  {
   "VOrder": 89,
   "Position": "Left",
   "Text": "سلطنتِ اہلِ دل فقر ہے، شاہی نہیں",
   "CoupletIndex": 44,
   "SectionIndex1": 0
  },
  {
   "VOrder": 90,
   "Position": "Right",
   "Text": "جن کی نگاہوں نے کی تربیَتِ شرق و غرب",
   "CoupletIndex": 45,
   "SectionIndex1": 0
  },
  {
   "VOrder": 91,
   "Position": "Left",
   "Text": "ظُلمتِ یورپ میں تھی جن کی خرد راہ بیں",
   "CoupletIndex": 45,
   "SectionIndex1": 0
  },
  {
   "VOrder": 92,
   "Position": "Right",
   "Text": "جن کے لہُو کی طفیل آج بھی ہیں اندلسی",
   "CoupletIndex": 46,
   "SectionIndex1": 0
  },
  {
   "VOrder": 93,
   "Position": "Left",
   "Text": "خوش دل و گرم اختلاط، سادہ و روشن جبیں",
   "CoupletIndex": 46,
   "SectionIndex1": 0
  },
  {
   "VOrder": 94,
   "Position": "Right",
   "Text": "آج بھی اس دیس میں عام ہے چشمِ غزال",
   "CoupletIndex": 47,
   "SectionIndex1": 0
  },
  {
   "VOrder": 95,
   "Position": "Left",
   "Text": "اور نگاہوں کے تِیر آج بھی ہیں دل نشیں",
   "CoupletIndex": 47,
   "SectionIndex1": 0
  },
  {
   "VOrder": 96,
   "Position": "Right",
   "Text": "بُوئے یمن آج بھی اس کی ہواؤں میں ہے",
   "CoupletIndex": 48,
   "SectionIndex1": 0
  },
  {
   "VOrder": 97,
   "Position": "Left",
   "Text": "رنگِ حجاز آج بھی اس کی نواؤں میں ہے",
   "CoupletIndex": 48,
   "SectionIndex1": 0
  },
  {
   "VOrder": 98,
   "Position": "Right",
   "Text": "دیدۂ انجم میں ہے تیری زمیں، آسماں",
   "CoupletIndex": 49,
   "SectionIndex1": 0
  },
  {
   "VOrder": 99,
   "Position": "Left",
   "Text": "آہ کہ صدیوں سے ہے تیری فضا بے اذاں",
   "CoupletIndex": 49,
   "SectionIndex1": 0
  },
  {
   "VOrder": 100,
   "Position": "Right",
   "Text": "کون سی وادی میں ہے، کون سی منزل میں ہے",
   "CoupletIndex": 50,
   "SectionIndex1": 0
  },
  {
   "VOrder": 101,
   "Position": "Left",
   "Text": "عشقِ بلا خیز کا قافلۂ سخت جاں!",
   "CoupletIndex": 50,
   "SectionIndex1": 0
  },
  {
   "VOrder": 102,
   "Position": "Right",
   "Text": "دیکھ چُکا المنی، شورشِ اصلاحِ دیں",
   "CoupletIndex": 51,
   "SectionIndex1": 0
  },
  {
   "VOrder": 103,
   "Position": "Left",
   "Text": "جس نے نہ چھوڑے کہیں نقشِ کُہن کے نشاں",
   "CoupletIndex": 51,
   "SectionIndex1": 0
  },
  {
   "VOrder": 104,
   "Position": "Right",
   "Text": "حرفِ غَلط بن گئی عِصمتِ پیرِ کُنِشت",
   "CoupletIndex": 52,
   "SectionIndex1": 0
  },
  {
   "VOrder": 105,
   "Position": "Left",
   "Text": "اور ہُوئی فکر کی کشتیِ نازک رواں",
   "CoupletIndex": 52,
   "SectionIndex1": 0
  },
  {
   "VOrder": 106,
   "Position": "Right",
   "Text": "چشمِ فرانسیس بھی دیکھ چُکی انقلاب",
   "CoupletIndex": 53,
   "SectionIndex1": 0
  },
  {
   "VOrder": 107,
   "Position": "Left",
   "Text": "جس سے دِگرگُوں ہُوا مغربیوں کا جہاں",
   "CoupletIndex": 53,
   "SectionIndex1": 0
  },
  {
   "VOrder": 108,
   "Position": "Right",
   "Text": "ملّتِ رومی نژاد کُہنہ پرستی سے پیر",
   "CoupletIndex": 54,
   "SectionIndex1": 0
  },
  {
   "VOrder": 109,
   "Position": "Left",
   "Text": "لذّتِ تجدید سے وہ بھی ہوئی پھر جواں",
   "CoupletIndex": 54,
   "SectionIndex1": 0
  },
  {
   "VOrder": 110,
   "Position": "Right",
   "Text": "رُوحِ مسلماں میں ہے آج وہی اضطراب",
   "CoupletIndex": 55,
   "SectionIndex1": 0
  },
  {
   "VOrder": 111,
   "Position": "Left",
   "Text": "رازِ خدائی ہے یہ، کہہ نہیں سکتی زباں",
   "CoupletIndex": 55,
   "SectionIndex1": 0
  },
  {
   "VOrder": 112,
   "Position": "Right",
   "Text": "دیکھیے اس بحر کی تہ سے اُچھلتا ہے کیا",
   "CoupletIndex": 56,
   "SectionIndex1": 0
  },
  {
   "VOrder": 113,
   "Position": "Left",
   "Text": "گُنبدِ نیلو فری رنگ بدلتا ہے کیا!",
   "CoupletIndex": 56,
   "SectionIndex1": 0
  },
  {
   "VOrder": 114,
   "Position": "Right",
   "Text": "وادیِ کُہسار میں غرقِ شفَق ہے سحاب",
   "CoupletIndex": 57,
   "SectionIndex1": 0
  },
  {
   "VOrder": 115,
   "Position": "Left",
   "Text": "لعلِ بدخشاں کے ڈھیر چھوڑ گیا آفتاب",
   "CoupletIndex": 57,
   "SectionIndex1": 0
  },
  {
   "VOrder": 116,
   "Position": "Right",
   "Text": "سادہ و پُرسوز ہے دُخترِ دہقاں کا گیت",
   "CoupletIndex": 58,
   "SectionIndex1": 0
  },
  {
   "VOrder": 117,
   "Position": "Left",
   "Text": "کشتیِ دل کے لیے سَیل ہے عہدِ شباب",
   "CoupletIndex": 58,
   "SectionIndex1": 0
  },
  {
   "VOrder": 118,
   "Position": "Right",
   "Text": "آبِ روانِ کبیر! تیرے کنارے کوئی",
   "CoupletIndex": 59,
   "SectionIndex1": 0
  },
  {
   "VOrder": 119,
   "Position": "Left",
   "Text": "دیکھ رہا ہے کسی اور زمانے کا خواب",
   "CoupletIndex": 59,
   "SectionIndex1": 0
  },
  {
   "VOrder": 120,
   "Position": "Right",
   "Text": "عالمِ نَو ہے ابھی پردۂ تقدیر میں",
   "CoupletIndex": 60,
   "SectionIndex1": 0
  },
  {
   "VOrder": 121,
   "Position": "Left",
   "Text": "میری نگاہوں میں ہے اس کی سحَر بے حجاب",
   "CoupletIndex": 60,
   "SectionIndex1": 0
  },
  {
   "VOrder": 122,
   "Position": "Right",
   "Text": "پردہ اُٹھا دوں اگر چہرۂ افکار سے",
   "CoupletIndex": 61,
   "SectionIndex1": 0
  },
  {
   "VOrder": 123,
   "Position": "Left",
   "Text": "لا نہ سکے گا فرنگ میری نواؤں کی تاب",
   "CoupletIndex": 61,
   "SectionIndex1": 0
  },
  {
   "VOrder": 124,
   "Position": "Right",
   "Text": "جس میں نہ ہو انقلاب، موت ہے وہ زندگی",
   "CoupletIndex": 62,
   "SectionIndex1": 0
  },
  {
   "VOrder": 125,
   "Position": "Left",
   "Text": "رُوحِ اُمم کی حیات کشمکشِ انقلاب",
   "CoupletIndex": 62,
   "SectionIndex1": 0
  },
  {
   "VOrder": 126,
   "Position": "Right",
   "Text": "صُورت شمشیر ہے دستِ قضا میں وہ قوم",
   "CoupletIndex": 63,
   "SectionIndex1": 0
  },
  {
   "VOrder": 127,
   "Position": "Left",
   "Text": "کرتی ہے جو ہر زماں اپنے عمل کا حساب",
   "CoupletIndex": 63,
   "SectionIndex1": 0
  },
  {
   "VOrder": 128,
   "Position": "Right",
   "Text": "نقش ہیں سب ناتمام خُونِ جگر کے بغیر",
   "CoupletIndex": 64,
   "SectionIndex1": 0
  },
  {
   "VOrder": 129,
   "Position": "Left",
   "Text": "نغمہ ہے سودائے خام خُونِ جگر کے بغیر",
   "CoupletIndex": 64,
   "SectionIndex1": 0
  }
 ],
