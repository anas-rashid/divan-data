{
 "FullUrl": "/p238/shaeri/c640/sh7163",
 "Title": "ہے یاد مجھے نکتۂ سلمانِ خوش آہنگ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "ہے یاد مجھے نکتۂ سلمانِ خوش آہنگ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "دنیا نہیں مردانِ جفاکش کے لیے تنگ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "چیتے کا جگر چاہیے، شاہیں کا تجسّس",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "جی سکتے ہیں بے روشنیِ دانش و فرہنگ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "کر بُلبل و طاؤس کی تقلید سے توبہ",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "بُلبل فقط آواز ہے، طاؤس فقط رنگ!",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Paragraph",
   "Text": "٭ سلمان: مسعود سور سلیمانؔ۔ غزنوی دور کانامور ایرانی شاعر جو غالبا لاہور میں پیدا ہوا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  }
 ],
