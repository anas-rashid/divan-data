{
 "FullUrl": "/p238/shaeri/c641/sh6604",
 "Title": "اِلتجائے مُسافر",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(بہ درگاہِ حضرت محبوبِ الٰہیؒ دہلی)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "فرشتے پڑھتے ہیں جس کو وہ نام ہے تیرا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "بڑی جناب تری، فیض عام ہے تیرا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "ستارے عشق کے تیری کشش سے ہیں قائم",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "نظامِ مہر کی صورت نظام ہے تیرا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "تری لحد کی زیارت ہے زندگی دل کی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "مسیح و خضر سے اُونچا مقام ہے تیرا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "نہاں ہے تیری محبّت میں رنگِ محبوبی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "بڑی ہے شان، بڑا احترام ہے تیرا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "اگر سیاہ دلم، داغِ لالہ زارِ تو ام",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "وگر کُشادہ جبینم، گُلِ بہارِ تو ام",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "چمن کو چھوڑ کے نِکلا ہوں مثلِ نکہتِ گُل",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "ہُوا ہے صبر کا منظور امتحاں مجھ کو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "چلی ہے لے کے وطن کے نگار خانے سے",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "شرابِ علم کی لذّت کشاں کشاں مجھ کو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "نظر ہے ابرِ کرم پر، درختِ صحرا ہُوں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "کِیا خدا نے نہ محتاجِ باغباں مجھ کو",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "فلک نشیں صفَتِ مہر ہُوں زمانے میں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "تری دعا سے عطا ہو وہ نردباں مجھ کو",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "مقام ہم سفروں سے ہو اس قدر آگے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "کہ سمجھے منزلِ مقصود کارواں مجھ کو",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "مری زبانِ قلم سے کسی کا دل نہ دُکھے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "کسی سے شکوہ نہ ہو زیرِ آسماں مجھ کو",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "دلوں کو چاک کرے مثلِ شانہ جس کا اثر",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "تری جناب سے ایسی مِلے فغاں مجھ کو",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "بنایا تھا جسے چُن چُن کے خار و خس میں نے",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "چمن میں پھر نظر آئے وہ آشیاں مجھ کو",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "پھر آ رکھوں قدمِ مادر و پدر پہ جبیں",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "کِیا جنھوں نے محبّت کا رازداں مجھ کو",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "وہ شمعِ بارگہِ خاندانِ مرتضوی",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "رہے گا مثلِ حرم جس کا آستاں مجھ کو",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "نفَس سے جس کے کھِلی میری آرزو کی کلی",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "بنایا جس کی مروّت نے نکتہ داں مجھ کو",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "دعا یہ کر کہ خداوندِ آسمان و زمیں",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "کرے پھر اس کی زیارت سے شادماں مجھ کو",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "وہ میرا یوسفِ ثانی، وہ شمعِ محفلِ عشق",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "ہُوئی ہے جس کی اخوّت قرارِ جاں مجھ کو",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Right",
   "Text": "جَلا کے جس کی محبّت نے دفترِ من و تو",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Left",
   "Text": "ہوائے عیش میں پالا، کِیا جواں مجھ کو",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Right",
   "Text": "ریاضِ دہر میں مانندِ گُل رہے خنداں",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Left",
   "Text": "کہ ہے عزیز تر از جاں وہ جانِ جاں مجھ کو",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Right",
   "Text": "شگفتہ ہو کے کلی دل کی پھُول ہو جائے!",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Left",
   "Text": "یہ التجائے مسافر قبول ہو جائے!",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
