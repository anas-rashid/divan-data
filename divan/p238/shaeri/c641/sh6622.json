{
 "FullUrl": "/p238/shaeri/c641/sh6622",
 "Title": "ایک شام",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(دریائے نیکر، ہائیڈل برگ کے کنارے پر)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "خاموش ہے چاندنی قمر کی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "شاخیں ہیں خموش ہر شجر کی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "وادی کے نوا فروش خاموش",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "کُہسار کے سبز پوش خاموش",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "فطرت بے ہوش ہو گئی ہے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "آغوش میں شب کے سو گئی ہے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "کچھ ایسا سکُوت کا فُسوں ہے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "نیکر کا خرام بھی سکُوں ہے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "تاروں کا خموش کارواں ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "یہ قافلہ بے درا رواں ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "خاموش ہیں کوہ و دشت و دریا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "قُدرت ہے مُراقبے میں گویا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "اے دِل! تُو بھی خموش ہو جا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "آغوش میں غم کو لے کے سو جا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  }
 ],
