{
 "FullUrl": "/p238/shaeri/c641/sh6628",
 "Title": "ایک پہاڑ اور گلہری",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ از ایمرسن)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Heading",
   "Text": "بچوں کے لیے",
   "CoupletIndex": 1,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "کوئی پہاڑ یہ کہتا تھا اک گلہری سے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "تجھے ہو شرم تو پانی میں جا کے ڈوب مرے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "ذرا سی چیز ہے، اس پر غرور، کیا کہنا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "یہ عقل اور یہ سمجھ، یہ شعور، کیا کہنا!",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "خدا کی شان ہے ناچیز چیز بن بیٹھیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "جو بے شعور ہوں یوں باتمیز بن بیٹھیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "تری بساط ہے کیا میری شان کے آگے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "زمیں ہے پست مری آن بان کے آگے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "جو بات مجھ میں ہے، تجھ کو وہ ہے نصیب کہاں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "بھلا پہاڑ کہاں، جانور غریب کہاں!",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "کہا یہ سُن کے گلہری نے، مُنہ سنبھال ذرا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "یہ کچّی باتیں ہیں دل سے انھیں نکال ذرا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "جو مَیں بڑی نہیں تیری طرح تو کیا پروا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "نہیں ہے تُو بھی تو آخر مری طرح چھوٹا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "ہر ایک چیز سے پیدا خدا کی قدرت ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "کوئی بڑا، کوئی چھوٹا، یہ اُس کی حکمت ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "بڑا جہان میں تجھ کو بنا دیا اُس نے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "مجھے درخت پہ چڑھنا سِکھا دیا اُس نے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "قدم اُٹھانے کی طاقت نہیں ذرا تجھ میں",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "نِری بڑائی ہے، خوبی ہے اور کیا تجھ میں",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Right",
   "Text": "جو تُو بڑا ہے تو مجھ سا ہُنر دِکھا مجھ کو",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Left",
   "Text": "یہ چھالیا ہی ذرا توڑ کر دِکھا مجھ کو",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Right",
   "Text": "نہیں ہے چیز نِکمّی کوئی زمانے میں",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Left",
   "Text": "کوئی بُرا نہیں قُدرت کے کارخانے میں",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  }
 ],
