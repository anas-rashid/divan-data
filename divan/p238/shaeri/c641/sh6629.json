{
 "FullUrl": "/p238/shaeri/c641/sh6629",
 "Title": "ایک گائے اور بکری",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Heading",
   "Text": "بچوں کے لیے",
   "CoupletIndex": 1,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "اک چراگہ ہری بھری تھی کہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "تھی سراپا بہار جس کی زمیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "کیا سماں اُس بہار کا ہو بیاں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "ہر طرف صاف ندّیاں تھیں رواں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "تھے اناروں کے بے شمار درخت",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "اور پیپل کے سایہ دار درخت",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "ٹھنڈی ٹھنڈی ہوائیں آتی تھیں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "طائروں کی صدائیں آتی تھیں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "کسی ندّی کے پاس اک بکری",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "چَرتے چَرتے کہیں سے آ نکلی",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "جب ٹھہر کر اِدھر اُدھر دیکھا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "پاس اک گائے کو کھڑے پایا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "پہلے جھُک کر اُسے سلام کیا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "پھر سلیقے سے یوں کلام کیا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "کیوں بڑی بی! مزاج کیسے ہیں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "گائے بولی کہ خیر اچھّے ہیں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "کٹ رہی ہے بُری بھلی اپنی",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "ہے مصیبت میں زندگی اپنی",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "جان پر آ بنی ہے، کیا کہیے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "اپنی قِسمت بُری ہے، کیا کہیے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Right",
   "Text": "دیکھتی ہوں خدا کی شان کو مَیں",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Left",
   "Text": "رو رہی ہوں بُروں کی جان کو مَیں",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Right",
   "Text": "زور چلتا نہیں غریبوں کا",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Left",
   "Text": "پیش آیا لِکھا نصیبوں کا",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Right",
   "Text": "آدمی سے کوئی بھلا نہ کرے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Left",
   "Text": "اس سے پالا پڑے، خدا نہ کرے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Right",
   "Text": "دُودھ کم دوں تو بڑبڑاتا ہے",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Left",
   "Text": "ہوں جو دُبلی تو بیچ کھاتا ہے",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Right",
   "Text": "ہتھکنڈوں سے غلام کرتا ہے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Left",
   "Text": "کِن فریبوں سے رام کرتا ہے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Right",
   "Text": "اس کے بچوں کو پالتی ہوں مَیں",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Left",
   "Text": "دُودھ سے جان ڈالتی ہوں مَیں",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Right",
   "Text": "بدلے نیکی کے یہ بُرائی ہے",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Left",
   "Text": "میرے اللہ! تری دُہائی ہے",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Right",
   "Text": "سُن کے بکری یہ ماجرا سارا",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Left",
   "Text": "بولی، ایسا گِلہ نہیں اچھّا",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Right",
   "Text": "بات سچّی ہے بے مزا لگتی",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Left",
   "Text": "مَیں کہوں گی مگر خدا لگتی",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Right",
   "Text": "یہ چراگہ، یہ ٹھنڈی ٹھنڈی ہوا",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Left",
   "Text": "یہ ہری گھاس اور یہ سایا",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Right",
   "Text": "ایسی خوشیاں ہمیں نصیب کہاں",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 44,
   "Position": "Left",
   "Text": "یہ کہاں، بے زباں غریب کہاں!",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 45,
   "Position": "Right",
   "Text": "یہ مزے آدمی کے دَم سے ہیں",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 46,
   "Position": "Left",
   "Text": "لُطف سارے اسی کے دَم سے ہیں",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 47,
   "Position": "Right",
   "Text": "اس کے دَم سے ہے اپنی آبادی",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 48,
   "Position": "Left",
   "Text": "قید ہم کو بھلی کہ آزادی!",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 49,
   "Position": "Right",
   "Text": "سَو طرح کا بَنوں میں ہے کھٹکا",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 50,
   "Position": "Left",
   "Text": "واں کی گُزران سے بچائے خُدا",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 51,
   "Position": "Right",
   "Text": "ہم پہ احسان ہے بڑا اس کا",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 52,
   "Position": "Left",
   "Text": "ہم کو زیبا نہیں گِلا اس کا",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 53,
   "Position": "Right",
   "Text": "قدر آرام کی اگر سمجھو",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 54,
   "Position": "Left",
   "Text": "آدمی کا کبھی گِلہ نہ کرو",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 55,
   "Position": "Right",
   "Text": "گائے سُن کر یہ بات شرمائی",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 56,
   "Position": "Left",
   "Text": "آدمی کے گِلے سے پچھتائی",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 57,
   "Position": "Right",
   "Text": "دل میں پرکھا بھلا بُرا اُس نے",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 58,
   "Position": "Left",
   "Text": "اور کچھ سوچ کر کہا اُس نے",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 59,
   "Position": "Right",
   "Text": "یوں تو چھوٹی ہے ذات بکری کی",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 60,
   "Position": "Left",
   "Text": "دل کو لگتی ہے بات بکری کی",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
