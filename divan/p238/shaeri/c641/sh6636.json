{
 "FullUrl": "/p238/shaeri/c641/sh6636",
 "Title": "بلالؓ (لِکھّا ہے ایک مغربیِ حق شناس نے)",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "لِکھّا ہے ایک مغربیِ حق شناس نے",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "اہلِ قلم میں جس کا بہت احترام تھا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "جولاں گہِ سکندرِ رومی تھا ایشیا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "گردُوں سے بھی بلند تر اُس کا مقام تھا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "تاریخ کہہ رہی ہے کہ رومی کے سامنے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "دعویٰ کِیا جو پورس و دارا نے، خام تھا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "دنیا کے اُس شہنشہِ انجم سپاہ کو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "حیرت سے دیکھتا فلکِ نیل فام تھا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "آج ایشیا میں اُس کو کوئی جانتا نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "تاریخ دان بھی اُسے پہچانتا نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "لیکن بِلالؓ، وہ حبَشی زادۂ حقیر",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "فطرت تھی جس کی نُورِ نبوّت سے مُستنیر",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "جس کا امیں ازل سے ہُوا سینۂ بِلالؓ",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "محکوم اُس صدا کے ہیں شاہنشہ و فقیر",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "ہوتا ہے جس سے اسوَد و احمر میں اختلاط",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "کرتی ہے جو غریب کو ہم پہلوئے امیر",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "ہے تازہ آج تک وہ نوائے جگر گداز",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "صدیوں سے سُن رہا ہے جسے گوشِ چرخِ پیر",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "اقبالؔ! کس کے عشق کا یہ فیضِ عام ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "رومی فنا ہُوا، حبَشی کو دوام ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
