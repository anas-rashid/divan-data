{
 "FullUrl": "/p238/shaeri/c641/sh6637",
 "Title": "بلالؓ (چمک اُٹھا جو ستارہ ترے مقدّر کا)",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "چمک اُٹھا جو ستارہ ترے مقدّر کا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "حبَش سے تجھ کو اُٹھا کر حجاز میں لایا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "ہُوئی اسی سے ترے غم کدے کی آبادی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "تری غلامی کے صدقے ہزار آزادی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "وہ آستاں نہ چھُٹا تجھ سے ایک دم کے لیے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "کسی کے شوق میں تو نے مزے ستم کے لیے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "جفا جو عشق میں ہوتی ہے وہ جفا ہی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "ستم نہ ہو تو محبت میں کچھ مزا ہی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "نظر تھی صورتِ سلماںؓ ادا شناس تری",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "شرابِ دید سے بڑھتی تھی اور پیاس تری",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "تجھے نظارے کا مثلِ کلیمؑ سودا تھا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "اویسؓ طاقتِ دیدار کو ترستا تھا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "مدینہ تیری نگاہوں کا نور تھا گویا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "ترے لیے تو یہ صحرا ہی طُور تھا گویا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "تری نظر کو رہی دید میں بھی حسرتِ دید",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "خُنَک دلے کہ تپید و دمے نیا سائید",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "گری وہ برق تری جانِ ناشکیبا پر",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "کہ خندہ زن تری ظُلمت تھی دستِ موسیٰ پر",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "تپش ز شعلہ گر فتند و بر دلِ تو زدند",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "چہ برقِ جلوہ بخاشاکِ حاصلِ تو زدند!",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "ادائے دید سراپا نیاز تھی تیری",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "کسی کو دیکھتے رہنا نماز تھی تیری",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Right",
   "Text": "اذاں ازل سے ترے عشق کا ترانہ بنی",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Left",
   "Text": "نماز اس کے نظارے کا اک بہانہ بنی",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Right",
   "Text": "خوشا وہ وقت کہ یثرِب مقام تھا اس کا",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Left",
   "Text": "خوشا وہ دور کہ دیدار عام تھا اس کا",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
