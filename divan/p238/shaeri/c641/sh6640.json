{
 "FullUrl": "/p238/shaeri/c641/sh6640",
 "Title": "بچّہ اور شمع",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "کیسی حیرانی ہے یہ اے طفلکِ پروانہ خُو!",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "شمع کے شعلوں کو گھڑیوں دیکھتا رہتا ہے تو",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "یہ مری آغوش میں بیٹھے ہوئے جُنبش ہے کیا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "روشنی سے کیا بغَل گیری ہے تیرا مدّعا؟",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "اس نظارے سے ترا ننھّا سا دل حیران ہے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "یہ کسی دیکھی ہُوئی شے کی مگر پہچان ہے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "شمع اک شعلہ ہے لیکن تُو سراپا نور ہے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "آہ! اس محفل میں یہ عُریاں ہے تُو مستور ہے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "دستِ قُدرت نے اسے کیا جانے کیوں عُریاں کیا!",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "تُجھ کو خاکِ تِیرہ کے فانوس میں پنہاں کیا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "نور تیرا چھُپ گیا زیرِ نقابِ آگہی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "ہے غبارِ دیدۂ بینا حجابِ آگہی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "زندگانی جس کو کہتے ہیں فراموشی ہے یہ",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "خواب ہے، غفلت ہے، سرمستی ہے، بے ہوشی ہے یہ",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "محفلِ قُدرت ہے اک دریائے بے پایانِ حُسن",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "آنکھ اگر دیکھے تو ہر قطرے میں ہے طوفانِ حُسن",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "حُسن، کوہستاں کی ہیبت ناک خاموشی میں ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "مِہر کی ضوگستری، شب کی سِیہ پوشی میں ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "آسمانِ صبح کی آئینہ پوشی میں ہے یہ",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "شام کی ظُلمت، شفَق کی گُل فرو شی میں ہے یہ",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "عظمتِ دیرینہ کے مِٹتے ہُوئے آثار میں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "طفلکِ ناآشنا کی کوششِ گُفتار میں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Right",
   "Text": "ساکنانِ صحنِ گُلشن کی ہم آوازی میں ہے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Left",
   "Text": "ننھّے ننھّے طائروں کی آشیاں سازی میں ہے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Right",
   "Text": "چشمۂ کُہسار میں، دریا کی آزادی میں حُسن",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Left",
   "Text": "شہر میں، صحرا میں، ویرانے میں، آبادی میں حُسن",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Right",
   "Text": "رُوح کو لیکن کسی گُم گشتہ شے کی ہے ہوس",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Left",
   "Text": "ورنہ اس صحرا میں کیوں نالاں ہے یہ مثلِ جرس!",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Right",
   "Text": "حُسن کے اس عام جلوے میں بھی یہ بے تاب ہے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Left",
   "Text": "زندگی اس کی مثالِ ماہیِ بے آب ہے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
