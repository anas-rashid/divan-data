{
 "FullUrl": "/p238/shaeri/c641/sh6641",
 "Title": "بچے کی دُعا",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Heading",
   "Text": "بچوں کے لیے",
   "CoupletIndex": 1,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "لب پہ آتی ہے دعا بن کے تمنا میری",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "زندگی شمع کی صورت ہو خدایا میری",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "دور دنیا کا مرے دم سے اندھیرا ہو جائے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "ہر جگہ میرے چمکنے سے اجالا ہو جائے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "ہو مرے دم سے یونہی میرے وطن کی زینت",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "جس طرح پھول سے ہوتی ہے چمن کی زینت",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "زندگی ہو مری پروانے کی صورت یا رب",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "علم کی شمع سے ہو مجھ کو محبت یا رب",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "ہو مرا کام غریبوں کی حمایت کرنا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "درد مندوں سے ضعیفوں سے محبت کرنا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "مرے اللہ! برائی سے بچانا مجھ کو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "نیک جو راہ ہو اس رہ پہ چلانا مجھ کو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  }
 ],
