{
 "FullUrl": "/p238/shaeri/c641/sh6664",
 "Title": "تضمین بر شعرِ ابوطالب کلیمؔ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "خوب ہے تجھ کو شعارِ صاحبِ یثرِبؐ کا پاس",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "کہہ رہی ہے زندگی تیری کہ تُو مسلم نہیں",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "جس سے تیرے حلقۂ خاتم میں گردُوں تھا اسیر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "اے سلیماں! تیری غفلت نے گنوایا وہ نگیں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "وہ نشانِ سجدہ جو روشن تھا کوکب کی طرح",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "ہوگئی ہے اُس سے اب ناآشنا تیری جبیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "دیکھ تو اپنا عمل، تجھ کو نظر آتی ہے کیا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "وہ صداقت جس کی بے‌باکی تھی حیرت آفریں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "تیرے آبا کی نِگہ بجلی تھی جس کے واسطے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "ہے وہی باطل ترے کاشانۂ دل میں مکیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "غافل! اپنے آشیاں کو آ کے پھر آباد کر",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "نغمہ زن ہے طُورِ معنی پر کلیمِ نکتہ بیں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "“سرکشی باہر کہ کردی رامِ او باید شدن",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "شعلہ ساں از ہر کجا برخاستی، آنجانشیں\"",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
  "at": "2026-10-11T15:02:45.597Z"
 }
}
