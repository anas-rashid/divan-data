{
 "FullUrl": "/p238/shaeri/c641/sh6667",
 "Title": "تعلیم اور اس کے نتائج",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(تضمین بر شعرِ مُلّا عرشیؔ)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "خوش تو ہیں ہم بھی جوانوں کی ترقّی سے مگر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "لبِ خنداں سے نکل جاتی ہے فریاد بھی ساتھ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "ہم سمجھتے تھے کہ لائے گی فراغت تعلیم",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "کیا خبر تھی کہ چلا آئے گا الحاد بھی ساتھ",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "گھر میں پرویز کے شیریں تو ہوئی جلوہ نُما",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "لے کے آئی ہے مگر تیشۂ فرہاد بھی ساتھ",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "“تخمِ دیگر بکف آریم و بکاریم ز نو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "کانچہ کشتیم ز خجلت نتواں کرد درو”",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  }
 ],
