{
 "FullUrl": "/p238/shaeri/c641/sh6684",
 "Title": "تہذیبِ حاضر",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "تضمین بر شعرِ فیضیؔ",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "حرارت ہے بلا کی بادۂ تہذیبِ حاضر میں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "بھڑک اُٹھّا بھبُوکا بن کے مُسلم کا تنِ خاکی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "کِیا ذرّے کو جُگنو دے کے تابِ مُستعار اس نے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "کوئی دیکھے تو شوخی آفتابِ جلوہ فرما کی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "نئے انداز پائے نوجوانوں کی طبیعت نے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "یہ رعنائی، یہ بیداری، یہ آزادی، یہ بے باکی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "تغیّر آگیا ایسا تدبّر میں، تخیّل میں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "ہنسی سمجھی گئی گُلشن میں غُنچوں کی جگر چاکی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "کِیا گُم تازہ پروازوں نے اپنا آشیاں لیکن",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "مناظر دِلکُشا دِکھلا گئی ساحر کی چالاکی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "حیاتِ تازہ اپنے ساتھ لائی لذّتیں کیا کیا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "رقابت، خودفروشی، ناشکیبائی، ہوسناکی",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "فروغِ شمعِ نَو سے بزمِ مسلم جگمگا اُٹھّی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "مگر کہتی ہے پروانوں سے میری کُہنہ اِدراکی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "“تو اے پروانہ! ایں گرمی ز شمع محفلے داری",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "چو من در آتشِ خود سوز اگر سوزِ دلے داری”",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
