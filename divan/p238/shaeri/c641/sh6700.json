{
 "FullUrl": "/p238/shaeri/c641/sh6700",
 "Title": "جنگِ یرموک کا ایک واقعہ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "صف بستہ تھے عرب کے جوانانِ تیغ بند",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "تھی منتظر حِنا کی عروسِ زمینِ شام",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "اک نوجوان صُورتِ سیماب مُضطرب",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "آ کر ہُوا امیرِ عساکر سے ہم کلام",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "اے بُوعبیدہ رُخصتِ پیکار دے مجھے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "لبریز ہو گیا مرے صبر و سکُوں کا جام",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "بے تاب ہو رہا ہوں فراقِ رسُولؐ میں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "اک دم کی زندگی بھی محبّت میں ہے حرام",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "جاتا ہوں مَیں حضورِ رسالت پناہؐ میں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "لے جاؤں گا خوشی سے اگر ہو کوئی پیام",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "یہ ذوق و شوق دیکھ کے پُرنم ہوئی وہ آنکھ",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "جس کی نگاہ تھی صفَتِ تیغِ بے نیام",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "بولا امیرِ فوج کہ “وہ نوجواں ہے تُو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "پِیروں پہ تیرے عشق کا واجب ہے احترام",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "پُوری کرے خدائے محمدؐ تری مراد",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "کتنا بلند تیری محبّت کا ہے مقام!",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "پہنچے جو بارگاہِ رسُولِ امیںؐ میں تُو",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "کرنا یہ عرض میری طرف سے پس از سلام",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "ہم پر کرم کِیا ہے خدائے غیور نے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "پُورے ہوئے جو وعدے کیے تھے حضورؐ نے”",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
