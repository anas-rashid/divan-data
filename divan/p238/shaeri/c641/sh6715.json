{
 "FullUrl": "/p238/shaeri/c641/sh6715",
 "Title": "حضورِ رسالت مآبؐ میں",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "گراں جو مجھ پہ یہ ہنگامۂ زمانہ ہُوا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "جہاں سے باندھ کے رختِ سفر روانہ ہُوا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "قیودِ شام و سحَر میں بسر تو کی لیکن",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "نظامِ کُہنۂ عالم سے آشنا نہ ہُوا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "فرشتے بزمِ رسالتؐ میں لے گئے مجھ کو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "حضورِ آیۂ رحمتؐ میں لے گئے مجھ کو",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "کہا حضورؐ نے، اے عندلیبِ باغِ حجاز!",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کلی کلی ہے تری گرمیِ نوا سے گُداز",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "ہمیشہ سرخوشِ جامِ وِلا ہے دل تیرا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "فتادگی ہے تری غیرتِ سجودِ نیاز",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "اُڑا جو پستیِ دنیا سے تُو سُوئے گردُوں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "سِکھائی تجھ کو ملائک نے رفعتِ پرواز",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "نکل کے باغِ جہاں سے برنگِ بُو آیا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "ہمارے واسطے کیا تُحفہ لے کے تُو آیا؟",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "“حضورؐ! دہر میں آسُودگی نہیں مِلتی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "تلاش جس کی ہے وہ زندگی نہیں مِلتی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "ہزاروں لالہ و گُل ہیں ریاضِ ہستی میں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "وفا کی جس میں ہو بُو، وہ کلی نہیں مِلتی",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "مگر میں نذر کو اک آبگینہ لایا ہوں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "جو چیز اس میں ہے، جنّت میں بھی نہیں ملتی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "جھلکتی ہے تری اُمّت کی آبرو اس میں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "طرابلس کے شہیدوں کا ہے لہُو اس میں”",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
