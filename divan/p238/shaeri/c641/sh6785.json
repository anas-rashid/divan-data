{
 "FullUrl": "/p238/shaeri/c641/sh6785",
 "Title": "رُخصت اے بزمِ جہاں!",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ از ایمرسن)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "رُخصت اے بزمِ جہاں! سُوئے وطن جاتا ہوں مَیں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "آہ! اس آباد ویرانے میں گھبراتا ہوں مَیں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "بسکہ مَیں افسردہ دل ہوں، درخورِ محفل نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "تُو مرے قابل نہیں ہے، مَیں ترے قابل نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "قید ہے، دربارِ سُلطان و شبستانِ وزیر",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "توڑ کر نکلے گا زنجیرِ طلائی کا اسیر",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "گو بڑی لذّت تری ہنگامہ آرائی میں ہے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "اجنبیّت سی مگر تیری شناسائی میں ہے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "مدّتوں تیرے خود آراؤں سے ہم صحبت رہا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "مدّتوں بے تاب موجِ بحر کی صورت رہا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "مدّتوں بیٹھا ترے ہنگامۂ عشرت میں مَیں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "روشنی کی جُستجو کرتا رہا ظُلمت میں مَیں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "مدّتوں ڈھُونڈا کِیا نظّارۂ گُل، خار میں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "آہ، وہ یوسف نہ ہاتھ آیا ترے بازار میں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "چشمِ حیراں ڈھُونڈتی اب اور نظّارے کو ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "آرزو ساحل کی مجھ طوفان کے مارے کو ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "چھوڑ کر مانندِ بُو تیرا چمن جاتا ہوں مَیں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "رُخصت اے بزمِ جہاں! سُوئے وطن جاتا ہوں مَیں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "گھر بنایا ہے سکوتِ دامنِ کُہسار میں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "آہ! یہ لذّت کہاں موسیقیِ گُفتار میں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "ہم نشینِ نرگسِ شہلا، رفیقِ گُل ہوں مَیں",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "ہے چمن میرا وطن، ہمسایۂ بُلبل ہوں مَیں",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "شام کو آواز چشموں کی سُلاتی ہے مجھے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "صبح فرشِ سبز سے کوئل جگاتی ہے مجھے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "بزمِ ہستی میں ہے سب کو محفل آرائی پسند",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "ہے دلِ شاعر کو لیکن کُنجِ تنہائی پسند",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "ہے جُنوں مجھ کو کہ گھبراتا ہوں آبادی میں مَیں",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "ڈھُونڈتا پھرتا ہوں کس کو کوہ کی وادی میں مَیں؟",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "شوق کس کا سبزہ زاروں میں پھراتا ہے مجھے؟",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "اور چشموں کے کناروں پر سُلاتا ہے مجھے؟",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "طعنہ زن ہے تُو کہ شیدا کُنجِ عُزلت کا ہوں مَیں",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "دیکھ اے غافل! پیامی بزمِ قُدرت کا ہوں مَیں",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "ہم وطن شمشاد کا، قُمری کا مَیں ہم راز ہوں",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "اس چمن کی خامشی میں گوش بر آواز ہوں",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "کچھ جو سنتا ہوں تو اَوروں کو سُنانے کے لیے",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "دیکھتا ہوں کچھ تو اَوروں کو دِکھانے کے لیے",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Right",
   "Text": "عاشقِ عُزلت ہے دل، نازاں ہوں اپنے گھر پہ مَیں",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Left",
   "Text": "خندہ زن ہوں مسندِ دارا و اسکندر پہ مَیں",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Right",
   "Text": "لیٹنا زیرِ شجر رکھتا ہے جادُو کا اثر",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Left",
   "Text": "شام کے تارے پہ جب پڑتی ہو رہ رہ کر نظر",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Right",
   "Text": "عِلم کے حیرت کدے میں ہے کہاں اس کی نمود!",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Left",
   "Text": "گُل کی پتّی میں نظر آتا ہے رازِ ہست و بود",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  }
 ],
