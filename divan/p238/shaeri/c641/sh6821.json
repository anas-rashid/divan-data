{
 "FullUrl": "/p238/shaeri/c641/sh6821",
 "Title": "سُلَیمیٰ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "جس کی نمود دیکھی چشمِ ستارہ بیں نے",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "خورشید میں، قمر میں، تاروں کی انجمن میں",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "صُوفی نے جس کو دل کے ظُلمت کدے میں پایا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "شاعر نے جس کو دیکھا قُدرت کے بانکپن میں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "جس کی چمک ہے پیدا، جس کی مہک ہویدا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "شبنم کے موتیوں میں، پھُولوں کے پیرہن میں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "صحرا کو ہے بسایا جس نے سکُوت بن کر",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "ہنگامہ جس کے دم سے کاشانۂ چمن میں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "ہر شے میں ہے نمایاں یوں تو جمال اس کا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "آنکھوں میں ہے سُلَیمیٰ! تیری کمال اس کا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
