{
 "FullUrl": "/p238/shaeri/c641/sh6834",
 "Title": "شبلیؔ و حالیؔ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "مسلم سے ایک روز یہ اقبالؔ نے کہا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "دیوانِ جُزو و کُل میں ہے تیرا وجود فرد",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "تیرے سرودِ رفتہ کے نغمے علومِ نَو",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "تہذیب تیرے قافلہ ہائے کُہن کی گرد",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "پتھّر ہے اس کے واسطے موجِ نسیم بھی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "نازک بہت ہے آئنۂ آبرُوئے مرد",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "مردانِ کار، ڈھُونڈ کے اسبابِ حادثات",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کرتے ہیں چارۂ ستَمِ چرخِ لاجورد",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "پُوچھ اُن سے جو چمن کے ہیں دیرینہ رازدار",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "کیونکر ہوئی خزاں ترے گُلشن سے ہم نبرد",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "مسلم مرے کلام سے بے تاب ہوگیا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "غمّاز ہوگئی غمِ پنہاں کی آہِ سرد",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "کہنے لگا کہ دیکھ تو کیفیّتِ خزاں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "اوراق ہو گئے شجَرِ زندگی کے زرد",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "خاموش ہو گئے چمَنِستاں کے رازدار",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "سرمایۂ گداز تھی جن کی نوائے درد",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "شبلیؔ کو رو رہے تھے ابھی اہلِ گلستاں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "حالیؔ بھی ہوگیا سوئے فردوس رہ نورد",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "“اکنوں کرا دماغ کہ پُرسد زباغباں",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "بُلبل چہ گفت و گُل چہ شنید و صبا چہ کرد”",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
  "at": "2026-10-11T15:02:45.604Z"
 }
}
