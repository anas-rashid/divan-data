{
 "FullUrl": "/p238/shaeri/c641/sh6852",
 "Title": "شیکسپیئر",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "شفَقِ صبح کو دریا کا خرام آئینہ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "نغمۂ شام کو خاموشیِ شام آئینہ",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "برگِ گُل آئنۂ عارضِ زیبائے بہار",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "شاہدِ مے کے لیے حجلۂ جام آئینہ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "حُسن آئینۂ حق اور دل آئینۂ حُسن",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "دلِ انساں کو ترا حُسنِ کلام آئینہ",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "ہے ترے فکرِ فلک رس سے کمالِ ہستی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "کیا تری فطرتِ روشن تھی مآلِ ہستی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "تجھ کو جب دیدۂ دیدار طلب نے ڈھُونڈا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "تابِ خورشید میں خورشید کو پنہاں دیکھا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "چشمِ عالَم سے تو ہستی رہی مستور تری",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "اور عالَم کو تری آنکھ نے عُریاں دیکھا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "حِفظِ اسرار کا فطرت کو ہے سودا ایسا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "رازداں پھر نہ کرے گی کوئی پیدا ایسا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
