{
 "FullUrl": "/p238/shaeri/c641/sh6859",
 "Title": "صِقلیہ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(جزیرۂ سِسلی)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "رو لے اب دل کھول کر اے دیدۂ خُوننابہ بار",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "وہ نظر آتا ہے تہذیبِ حجازی کا مزار",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "تھا یہاں ہنگامہ ان صحرا نشینوں کا کبھی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "بحر بازی گاہ تھا جن کے سفینوں کا کبھی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "زلزلے جن سے شہنشاہوں کے درباروں میں تھے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "بجلیوں کے آشیانے جن کی تلواروں میں تھے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "اک جہانِ تازہ کا پیغام تھا جن کا ظُہور",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "کھا گئی عصرِ کُہن کو جن کی تیغِ نا صبور",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "مُردہ عالَم زندہ جن کی شورشِ قُم سے ہُوا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "آدمی آزاد زنجیرِ توہّم سے ہُوا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "غلغلوں سے جس کے لذّت گیر اب تک گوش ہے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "کیا وہ تکبیر اب ہمیشہ کے لیے خاموش ہے؟",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "آہ اے سِسلی! سمندرکی ہے تجھ سے آبرو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "رہنما کی طرح اس پانی کے صحرا میں ہے تو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "زیب تیرے خال سے رُخسارِ دریا کو رہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "تیری شمعوں سے تسلّی بحر پیما کو رہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "ہو سُبک چشمِ مسافر پر ترا منظر مدام",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "موج رقصاں تیرے ساحل کی چٹانوں پر مدام",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "تُو کبھی اُس قوم کی تہذیب کا گہوارہ تھا",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "حُسنِ عالم سوز جس کا آتشِ نظّارہ تھا",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "نالہ کش شیراز کا بُلبل ہُوا بغداد پر",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "داغؔ رویا خُون کے آنسو جہان آباد پر",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "آسماں نے دولتِ غرناطہ جب برباد کی",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "ابنِ بدرُوں کے دلِ ناشاد نے فریاد کی",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "غم نصیب اقبالؔ کو بخشا گیا ماتم ترا",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "چُن لیا تقدیر نے وہ دل کہ تھا محرم ترا",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "ہے ترے آثار میں پوشیدہ کس کی داستاں",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "تیرے ساحل کی خموشی میں ہے اندازِ بیاں",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "درد اپنا مجھ سے کہہ، مَیں بھی سراپا درد ہوں",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "جس کی تُو منزل تھا، میں اُس کارواں کی گرد ہوں",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "رنگ تصویرِ کُہن میں بھر کے دِکھلا دے مجھے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "قصّہ ایّامِ سلَف کا کہہ کے تڑپا دے مجھے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "مَیں ترا تُحفہ سوئے ہندوستاں لے جاؤں گا",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "خود یہاں روتا ہوں، اَوروں کو وہاں رُلواؤں گا",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  }
 ],
