{
 "FullUrl": "/p238/shaeri/c641/sh6879",
 "Title": "عشق اور موت",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ از ٹینی سن)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "سُہانی نمودِ جہاں کی گھڑی تھی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "تبسّم فشاں زندگی کی کلی تھی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "کہیں مہر کو تاجِ زر مِل رہا تھا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "عطا چاند کو چاندنی ہو رہی تھی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "سِیَہ پیرہن شام کو دے رہے تھے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "ستاروں کو تعلیمِ تابندگی تھی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "کہیں شاخِ ہستی کو لگتے تھے پتّے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "کہیں زندگی کی کلی پھُوٹتی تھی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "فرشتے سِکھاتے تھے شبنم کو رونا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "ہنسی گُل کو پہلے پہل آ رہی تھی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "عطا درد ہوتا تھا شاعر کے دل کو",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "خودی تَشنہ کامِ مئے بے خودی تھی",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "اُٹھی اوّل اوّل گھٹا کالی کالی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "کوئی حُور چوٹی کو کھولے کھڑی تھی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "زمیں کو تھا دعویٰ کہ مَیں آسماں ہوں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "مکاں کہہ رہا تھا کہ مَیں لا مکاں ہوں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "غَرض اس قدر یہ نظارہ تھا پیارا",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "کہ نظّارگی ہو سراپا نظارا",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "ملَک آزماتے تھے پرواز اپنی",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "جبینوں سے نورِ ازل آشکارا",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "فرشتہ تھا اک، عشق تھا نام جس کا",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "کہ تھی رہبری اُس کی سب کا سہارا",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "فرشتہ کہ پُتلا تھا بے تابیوں کا",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "مَلک کا مَلک اور پارے کا پارا",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "پئے سیر فردوس کو جا رہا تھا",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "قضا سے مِلا راہ میں وہ قضا را",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "یہ پُوچھا ترا نام کیا، کام کیا ہے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "نہیں آنکھ کو دید تیری گوارا",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "ہُوا سُن کے گویا قضا کا فرشتہ",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "اجل ہوں، مرا کام ہے آشکارا",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "اُڑاتی ہوں مَیں رختِ ہستی کے پُرزے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "بُجھاتی ہوں مَیں زندگی کا شرارا",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "مری آنکھ میں جادوئے نیستی ہے",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "پیامِ فنا ہے اسی کا اشارا",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "مگر ایک ہستی ہے دنیا میں ایسی",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "وہ آتش ہے مَیں سامنے اُس کے پارا",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Right",
   "Text": "شرر بن کے رہتی ہے انساں کے دل میں",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Left",
   "Text": "وہ ہے نورِ مطلق کی آنکھوں کا تارا",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Right",
   "Text": "ٹپکتی ہے آنکھوں سے بن بن کے آنسُو",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Left",
   "Text": "وہ آنسو کہ ہو جن کی تلخی گوارا",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Right",
   "Text": "سُنی عشق نے گفتگو جب قضا کی",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Left",
   "Text": "ہنسی اُس کے لب پر ہوئی آشکارا",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 44,
   "Position": "Right",
   "Text": "گری اُس تبسّم کی بجلی اجل پر",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 45,
   "Position": "Left",
   "Text": "اندھیرے کا ہو نور میں کیا گزارا",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 46,
   "Position": "Right",
   "Text": "بقا کو جو دیکھا فنا ہو گئی وہ",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 47,
   "Position": "Left",
   "Text": "قضا تھی، شکارِ قضا ہو گئی وہ",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
