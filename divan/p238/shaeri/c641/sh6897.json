{
 "FullUrl": "/p238/shaeri/c641/sh6897",
 "Title": "عُرفیؔ",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Single",
   "Text": "محل ایسا کِیا تعمیر عُرفیؔ کے تخیّل نے",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Single",
   "Text": "تَصدّق جس پہ حیرت خانۂ سیناؔ و فارابیؔ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Single",
   "Text": "فضائے عشق پر تحریر کی اُس نے نوا ایسی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Single",
   "Text": "میّسر جس سے ہیں آنکھوں کو اب تک اشکِ عُنّابی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Single",
   "Text": "مرے دل نے یہ اک دن اُس کی تُربت سے شکایت کی",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Single",
   "Text": "نہیں ہنگامۂ عالم میں اب سامانِ بیتابی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Single",
   "Text": "مزاجِ اہلِ عالم میں تغیّر آگیا ایسا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Single",
   "Text": "کہ رخصت ہوگئی دنیا سے کیفیّت وہ سیمابی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Single",
   "Text": "فغانِ نیم شب شاعر کی بارِ گوش ہوتی ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Single",
   "Text": "نہ ہو جب چشمِ محفل آشنائے لُطفِ بے خوابی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Single",
   "Text": "کسی کا شُعلۂ فریاد ہو ظُلمت رُبا کیونکر",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Single",
   "Text": "گراں ہے شب پرستوں پر سحَر کی آسماں تابی",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Single",
   "Text": "صدا تُربت سے آئی “شکوۂ اہلِ جہاں کم گو",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Single",
   "Text": "نوارا تلخ تر می زن چو ذوقِ نغمہ کم یابی",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Single",
   "Text": "حُدی را تیز تر می خواں چو محمل را گراں بینی”",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
