{
 "FullUrl": "/p238/shaeri/c641/sh6927",
 "Title": "فلسفۂ غم",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(میاں فضل حسین صاحب بیرسٹر ایٹ لاء لاہور کے نام)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "گو سراپا کیفِ عشرت ہے شرابِ زندگی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "اشک بھی رکھتا ہے دامن میں سحابِ زندگی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "موجِ غم پر رقص کرتا ہے حبابِ زندگی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "ہے ’الم‘ کا سُورہ بھی جُزوِ کتابِ زندگی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "ایک بھی پتّی اگر کم ہو تو وہ گُل ہی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "جو خزاں نادیدہ ہو بُلبل، وہ بُلبل ہی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "آرزو کے خُون سے رنگیں ہے دل کی داستاں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "نغمۂ انسانیت کامل نہیں غیر از فغاں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "دیدۂ بینا میں داغِ غم چراغِ سینہ ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "روح کو سامانِ زینت آہ کا آئینہ ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "حادثاتِ غم سے ہے انساں کی فطرت کو کمال",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "غازہ ہے آئینۂ دل کے لیے گردِ ملال",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "غم جوانی کو جگا دیتا ہے لُطفِ خواب سے",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "ساز یہ بیدار ہوتا ہے اسی مضراب سے",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "طائرِ دل کے لیے غم شہپرِ پرواز ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "راز ہے انساں کا دل، غم انکشافِ راز ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "غم نہیں غم، رُوح کا اک نغمۂ خاموش ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "جو سرودِ بربطِ ہستی سے ہم آغوش ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "شام جس کی آشنائے نالۂ ’یا رب‘ نہیں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "جلوہ پیرا جس کی شب میں اشک کے کوکب نہیں",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "جس کا جامِ دل شکستِ غم سے ہے ناآشنا",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "جو سدا مستِ شرابِ عیش و عشرت ہی رہا",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "ہاتھ جس گُلچیں کا ہے محفوظ نوکِ خار سے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "عشق جس کا بے خبر ہے ہجر کے آزار سے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "کُلفتِ غم گرچہ اُس کے روز و شب سے دُور ہے",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "زندگی کا راز اُس کی آنکھ سے مستُور ہے",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "اے کہ نظمِ دہر کا ادراک ہے حاصل تجھے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "کیوں نہ آساں ہو غم و اندوہ کی منزل تجھے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "ہے ابد کے نسخۂ دیرینہ کی تمہید عشق",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "عقلِ انسانی ہے فانی، زندۂ جاوید عشق",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "عشق کے خورشید سے شامِ اجل شرمندہ ہے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "عشق سوزِ زندگی ہے، تا ابد پائندہ ہے",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "رخصتِ محبوب کا مقصد فنا ہوتا اگر",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "جوشِ اُلفت بھی دلِ عاشق سے کر جاتا سفر",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "عشق کچھ محبوب کے مرنے سے مر جاتا نہیں",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "روح میں غم بن کے رہتا ہے، مگر جاتا نہیں",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 38,
   "Position": "Right",
   "Text": "ہے بقائے عشق سے پیدا بقا محبوب کی",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 39,
   "Position": "Left",
   "Text": "زندگانی ہے عدم ناآشنا محبوب کی",
   "CoupletIndex": 19,
   "SectionIndex1": 0
  },
  {
   "VOrder": 40,
   "Position": "Right",
   "Text": "آتی ہے ندّی جبینِ کوہ سے گاتی ہوئی",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 41,
   "Position": "Left",
   "Text": "آسماں کے طائروں کو نغمہ سِکھلاتی ہوئی",
   "CoupletIndex": 20,
   "SectionIndex1": 0
  },
  {
   "VOrder": 42,
   "Position": "Right",
   "Text": "آئنہ روشن ہے اُس کا صورتِ رخسار حُور",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 43,
   "Position": "Left",
   "Text": "گِر کے وادی کی چٹانوں پر یہ ہو جاتا ہے چُور",
   "CoupletIndex": 21,
   "SectionIndex1": 0
  },
  {
   "VOrder": 44,
   "Position": "Right",
   "Text": "نہر جو تھی، اُس کے گوہر پیارے پیارے بن گئے",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 45,
   "Position": "Left",
   "Text": "یعنی اس اُفتاد سے پانی کے تارے بن گئے",
   "CoupletIndex": 22,
   "SectionIndex1": 0
  },
  {
   "VOrder": 46,
   "Position": "Right",
   "Text": "جُوئے سیمابِ رواں پھٹ کر پریشاں ہو گئی",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 47,
   "Position": "Left",
   "Text": "مضطرب بوندوں کی اک دنیا نمایاں ہو گئی",
   "CoupletIndex": 23,
   "SectionIndex1": 0
  },
  {
   "VOrder": 48,
   "Position": "Right",
   "Text": "ہجر، ان قطروں کو لیکن وصل کی تعلیم ہے",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 49,
   "Position": "Left",
   "Text": "دو قدم پر پھر وہی جُو مثلِ تارِ سیم ہے",
   "CoupletIndex": 24,
   "SectionIndex1": 0
  },
  {
   "VOrder": 50,
   "Position": "Right",
   "Text": "ایک اصلیّت میں ہے نہرِ روانِ زندگی",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 51,
   "Position": "Left",
   "Text": "گِر کے رفعت سے ہجومِ نوعِ انساں بن گئی",
   "CoupletIndex": 25,
   "SectionIndex1": 0
  },
  {
   "VOrder": 52,
   "Position": "Right",
   "Text": "پستیِ عالم میں ملنے کو جُدا ہوتے ہیں ہم",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 53,
   "Position": "Left",
   "Text": "عارضی فُرقت کو دائم جان کر روتے ہیں ہم",
   "CoupletIndex": 26,
   "SectionIndex1": 0
  },
  {
   "VOrder": 54,
   "Position": "Right",
   "Text": "مرنے والے مرتے ہیں لیکن فنا ہوتے نہیں",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 55,
   "Position": "Left",
   "Text": "یہ حقیقت میں کبھی ہم سے جُدا ہوتے نہیں",
   "CoupletIndex": 27,
   "SectionIndex1": 0
  },
  {
   "VOrder": 56,
   "Position": "Right",
   "Text": "عقل جس دم دہر کی آفات میں محصور ہو",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 57,
   "Position": "Left",
   "Text": "یا جوانی کی اندھیری رات میں مستور ہو",
   "CoupletIndex": 28,
   "SectionIndex1": 0
  },
  {
   "VOrder": 58,
   "Position": "Right",
   "Text": "دامنِ دل بن گیا ہو رزم گاہِ خیر و شر",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 59,
   "Position": "Left",
   "Text": "راہ کی ظلمت سے ہو مشکل سوئے منزل سفر",
   "CoupletIndex": 29,
   "SectionIndex1": 0
  },
  {
   "VOrder": 60,
   "Position": "Right",
   "Text": "خضرِ ہمّت ہو گیا ہو آرزو سے گوشہ گیر",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 61,
   "Position": "Left",
   "Text": "فکر جب عاجز ہو اور خاموش آوازِ ضمیر",
   "CoupletIndex": 30,
   "SectionIndex1": 0
  },
  {
   "VOrder": 62,
   "Position": "Right",
   "Text": "وادیِ ہستی میں کوئی ہم سفر تک بھی نہ ہو",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 63,
   "Position": "Left",
   "Text": "جادہ دکھلانے کو جُگنو کا شرر تک بھی نہ ہو",
   "CoupletIndex": 31,
   "SectionIndex1": 0
  },
  {
   "VOrder": 64,
   "Position": "Right",
   "Text": "مرنے والوں کی جبیں روشن ہے اس ظلمات میں",
   "CoupletIndex": 32,
   "SectionIndex1": 0
  },
  {
   "VOrder": 65,
   "Position": "Left",
   "Text": "جس طرح تارے چمکتے ہیں اندھیری رات میں",
   "CoupletIndex": 32,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
