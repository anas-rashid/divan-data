{
 "FullUrl": "/p238/shaeri/c641/sh6954",
 "Title": "ماں کا خواب",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Heading",
   "Text": "بچوں کے لیے",
   "CoupletIndex": 1,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "میں سوئی جو اک شب تو دیکھا یہ خواب",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "بڑھا اور جس سے مرا اضطراب",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "یہ دیکھا کہ مَیں جا رہی ہوں کہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "اندھیرا ہے اور راہ مِلتی نہیں",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "لرزتا تھا ڈر سے مرا بال بال",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "قدم کا تھا دہشت سے اُٹھنا محال",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "جو کچھ حوصلہ پا کے آگے بڑھی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "تو دیکھا قطار ایک لڑکوں کی تھی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "زَمرّد سی پوشاک پہنے ہوئے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "دِیے سب کے ہاتھوں میں جلتے ہوئے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "وہ چُپ چاپ تھے آگے پیچھے رواں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "خدا جانے جانا تھا اُن کو کہاں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "اسی سوچ میں تھی کہ میرا پِسر",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "مجھے اُس جماعت میں آیا نظر",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "وہ پیچھے تھا اور تیز چلتا نہ تھا",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "دِیا اُس کے ہاتھوں میں جلتا نہ تھا",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "کہا مَیں نے پہچان کر، میری جاں!",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "مجھے چھوڑ کر آ گئے تم کہاں؟",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "جُدائی میں رہتی ہوں مَیں بے قرار",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "پروتی ہوں ہر روز اشکوں کے ہار",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Right",
   "Text": "نہ پروا ہماری ذرا تم نے کی",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Left",
   "Text": "گئے چھوڑ، اچھّی وفا تم نے کی!",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Right",
   "Text": "جو بچّے نے دیکھا مرا پیچ و تاب",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Left",
   "Text": "دیا اُس نے مُنہ پھیر کر یوں جواب",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Right",
   "Text": "رُلاتی ہے تجھ کو جُدائی مری",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Left",
   "Text": "نہیں اس میں کچھ بھی بھلائی مری",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Right",
   "Text": "یہ کہہ کر وہ کچھ دیر تک چُپ رہا",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Left",
   "Text": "دِیا پھر دِکھا کر یہ کہنے لگا",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Right",
   "Text": "سمجھتی ہے تُو ہو گیا کیا اسے؟",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Left",
   "Text": "ترے آنسوؤں نے بُجھایا اسے!",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
