{
 "FullUrl": "/p238/shaeri/c641/sh6970",
 "Title": "مذہب (تعلیمِ پیرِ فلسفۂ مغربی ہے یہ)",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "تضمین بر شعرِ میرزا بیدلؔ",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "تعلیمِ پیرِ فلسفۂ مغربی ہے یہ",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "ناداں ہیں جن کو ہستیِ غائب کی ہے تلاش",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "پیکر اگر نظر سے نہ ہو آشنا تو کیا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "ہے شیخ بھی مثالِ بَرہمن صنَم تراش",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "محسوس پر بِنا ہے علومِ جدید کی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "اس دَور میں ہے شیشہ عقائد کا پاش پاش",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "مذہب ہے جس کا نام، وہ ہے اک جنُونِ خام",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "ہے جس سے آدمی کے تخیّل کو انتعاش",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "کہتا مگر ہے فلسفۂ زندگی کچھ اور",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "مجھ پر کِیا یہ مُرشدِ کامل نے راز فاش",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "“باہر کمال اند کے آشفتگی خوش است",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "ہر چند عقلِ کُل شدہ ای بے جُنوں مباش”",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
