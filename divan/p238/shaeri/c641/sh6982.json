{
 "FullUrl": "/p238/shaeri/c641/sh6982",
 "Title": "مسلم",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(جون ۱۹۱۲ء)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "ہر نفَس اقبالؔ تیرا آہ میں مستور ہے",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "سینۂ سوزاں ترا فریاد سے معمور ہے",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "نغمۂ اُمّید تیری بربطِ دل میں نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "ہم سمجھتے ہیں یہ لیلیٰ تیرے محمل میں نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "گوش آوازِ سرودِ رفتہ کا جویا ترا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "اور دل ہنگامۂ حاضر سے بے پروا ترا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "قصّۂ گُل ہم نوایانِ چمن سُنتے نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "اہلِ محفل تیرا پیغامِ کُہن سُنتے نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "اے درائے کاروانِ خُفتہ پا! خاموش رہ",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "ہے بہت یاس آفریں تیری صدا خاموش رہ",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "زندہ پھر وہ محفلِ دیرینہ ہو سکتی نہیں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "شمع سے روشن شبِ دوشینہ ہوسکتی نہیں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "ہم نشیں! مسلم ہوں مَیں، توحید کا حامل ہوں مَیں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "اس صداقت پر ازل سے شاہدِ عادل ہوں مَیں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "نبضِ موجودات میں پیدا حرارت اس سے ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "اور مسلم کے تخیّل میں جسارت اس سے ہے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "حق نے عالم اس صداقت کے لیے پیدا کیا",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "اور مجھے اس کی حفاظت کے لیے پیدا کیا",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "دہر میں غارت گرِ باطل پرستی مَیں ہُوا",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "حق تو یہ ہے حافظِ ناموسِ ہستی مَیں ہُوا",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "میری ہستی پیرہن عُریانیِ عالم کی ہے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "میرے مِٹ جانے سے رُسوائی بنی آدم کی ہے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "قسمتِ عالم کا مسلم کوکبِ تابندہ ہے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "جس کی تابانی سے افسونِ سحَر شرمندہ ہے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "آشکارا ہیں مری آنکھوں پہ اسرارِ حیات",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "کہہ نہیں سکتے مجھے نومیدِ پیکارِ حیات",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "کب ڈرا سکتا ہے غم کا عارضی منظر مجھے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "ہے بھروسا اپنی ملّت کے مقّدر پر مجھے",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "یاس کے عُنصر سے ہے آزاد میرا روزگار",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "فتحِ کامل کی خبر دتیا ہے جوشِ کارزار",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 32,
   "Position": "Right",
   "Text": "ہاں یہ سچ ہے چشم بر عہدِ کُہن رہتا ہوں مَیں",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 33,
   "Position": "Left",
   "Text": "اہلِ محفل سے پُرانی داستاں کہتا ہوں مَیں",
   "CoupletIndex": 16,
   "SectionIndex1": 0
  },
  {
   "VOrder": 34,
   "Position": "Right",
   "Text": "یادِ عہدِ رفتہ میری خاک کو اِکسیر ہے",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 35,
   "Position": "Left",
   "Text": "میرا ماضی میرے استقبال کی تفسیر ہے",
   "CoupletIndex": 17,
   "SectionIndex1": 0
  },
  {
   "VOrder": 36,
   "Position": "Right",
   "Text": "سامنے رکھتا ہوں اُس دورِ نشاط افزا کو مَیں",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  },
  {
   "VOrder": 37,
   "Position": "Left",
   "Text": "دیکھتا ہوں دوش کے آئینے میں فردا کو مَیں",
   "CoupletIndex": 18,
   "SectionIndex1": 0
  }
 ],
