{
 "FullUrl": "/p238/shaeri/c641/sh6983",
 "Title": "مسلمان اور تعلیمِ جدید",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "تضمین بر شعرِ ملک قُمیؔ",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "مُرشد کی یہ تعلیم تھی اے مسلمِ شوریدہ سر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "لازم ہے رہرو کے لیے دُنیا میں سامانِ سفر",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "بدلی زمانے کی ہوا، ایسا تغیّر آگیا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "تھے جو گراں قیمت کبھی، اب ہیں متاعِ کس مخر",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "وہ شُعلۂ روشن ترا، ظُلمت گریزاں جس سے تھی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "گھَٹ کر ہُوا مثلِ شرر تارے سے بھی کم نُور تر",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "شیدائیِ غائب نہ رہ، دیوانۂ موجود ہو",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "غالب ہے اب اقوام پر معبودِ حاضر کا اثر",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "ممکن نہیں اس باغ میں کوشِش ہو بارآور تری",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "فرسُودہ ہے پھندا ترا، زِیرک ہے مُرغِ تیز پر",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "اس دَور میں تعلیم ہے امراضِ مِلّت کی دوا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "ہے خُونِ فاسد کے لیے تعلیم مثلِ نیشتر",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "رہبر کے ایما سے ہُوا تعلیم کا سودا مجھے",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "واجب ہے صحراگرد پر تعمیل فرمانِ خضَر",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Single",
   "Text": "لیکن نگاہِ نُکتہ‌بیں دیکھے زبُوں بختی مری",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Single",
   "Text": "“رفتم کہ خار از پا کشم، محمل نہاں شد از نظر",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Single",
   "Text": "یک لحظ غافل گشتم و صد سالہ را ہم دُور شد”",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
