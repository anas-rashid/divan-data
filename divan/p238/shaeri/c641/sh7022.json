{
 "FullUrl": "/p238/shaeri/c641/sh7022",
 "Title": "مَیں اور تُو",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "مذاقِ دید سے ناآشنا نظر ہے مری",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "تری نگاہ ہے فطرت کی راز داں، پھر کیا",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "رہینِ شکوۂ ایّام ہے زبان مری",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "تری مراد پہ ہے دَورِ آسماں، پھر کیا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "رکھا مجھے چمن آوارہ مثلِ موجِ نسیم",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "عطا فلک نے کِیا تجھ کو آشیاں، پھر کیا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "فزوں ہے سُود سے سرمایۂ حیات ترا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "مرے نصیب میں ہے کاوشِ زیاں، پھر کیا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "ہوا میں تیرتے پھرتے ہیں تیرے طیّارے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "مرا جہاز ہے محرومِ بادباں، پھر کیا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "قوی شدیم چہ شد، ناتواں شدیم چہ شد",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "چنیں شدیم چہ شد یا چناں شدیم چہ شد",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "بہیچ گونہ دریں گلستاں قرارے نیست",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "توگر بہار شدی، ما خزاں شدیم، چہ شد",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
