{
 "FullUrl": "/p238/shaeri/c641/sh7024",
 "Title": "نالۂ فراق",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(آرنلڈ کی یاد میں)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "جا بسا مغرب میں آخر اے مکاں تیرا مکیں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "آہ! مشرق کی پسند آئی نہ اس کو سر زمیں",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "آگیا آج اس صداقت کا مرے دل کو یقیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "ظُلمتِ شب سے ضیائے روزِ فرقت کم نہیں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "“تا ز آغوشِ وداعش داغِ حیرت چیدہ است",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "ہمچو شمعِ کُشتہ در چشمم نگہ خوابیدہ است”",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "کُشتۂ عُزلت ہوں، آبادی میں گھبراتا ہوں میں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "شہر سے سودا کی شدّت میں نکل جاتا ہوں میں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "یادِ ایّامِ سلَف سے دل کو تڑپاتا ہوں میں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "بہرِ تسکیں تیری جانب دوڑتا آتا ہوں میں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "آنکھ گو مانوس ہے تیرے در و دیوار سے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "اجنبیّت ہے مگر پیدا مری رفتار سے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "ذرّہ میرے دل کا خورشید آشنا ہونے کو تھا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "آئنہ ٹُوٹا ہُوا عالم نما ہونے کو تھا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "نخل میری آرزوؤں کا ہرا ہونے کو تھا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "آہ! کیا جانے کوئی میں کیا سے کیا ہونے کو تھا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "ابرِ رحمت دامن از گُلزارِ من برچید و رفت",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "اندکے بر غنچہ ہائے آرزُو بارید و رفت",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "تُو کہاں ہے اے کلیمِ ذروۂ سینائے علم",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "تھی تری موجِ نفَس بادِ نشاط افزائے علم",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "اب کہاں وہ شوقِ رہ پیمائیِ صحرائے علم",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "تیرے دم سے تھا ہمارے سر میں بھی سودائے علم",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "“شورِ لیلیٰ کو کہ باز آرایشِ سودا کند",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "خاکِ مجنوں را غبارِ خاطرِ صحرا کند”",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 26,
   "Position": "Right",
   "Text": "کھول دے گا دشتِ وحشت عقدۂ تقدیر کو",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 27,
   "Position": "Left",
   "Text": "توڑ کر پہنچوں گا مَیں پنجاب کی زنجیر کو",
   "CoupletIndex": 13,
   "SectionIndex1": 0
  },
  {
   "VOrder": 28,
   "Position": "Right",
   "Text": "دیکھتا ہے دیدۂ حیراں تری تصویر کو",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 29,
   "Position": "Left",
   "Text": "کیا تسلّی ہو مگر گرویدۂ تقریر کو",
   "CoupletIndex": 14,
   "SectionIndex1": 0
  },
  {
   "VOrder": 30,
   "Position": "Right",
   "Text": "“تابِ گویائی نہیں رکھتا دہَن تصویر کا",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  },
  {
   "VOrder": 31,
   "Position": "Left",
   "Text": "خامشی کہتے ہیں جس کو، ہے سخن تصویر کا”",
   "CoupletIndex": 15,
   "SectionIndex1": 0
  }
 ],
