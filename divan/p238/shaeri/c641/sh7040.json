{
 "FullUrl": "/p238/shaeri/c641/sh7040",
 "Title": "نویدِ صبح",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "آتی ہے مشرق سے جب ہنگامہ در دامن سحَر",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "منزلِ ہستی سے کر جاتی ہے خاموشی سفر",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "محفلِ قُدرت کا آخر ٹُوٹ جاتا ہے سکُوت",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "دیتی ہے ہر چیز اپنی زندگانی کا ثبوت",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "چہچہاتے ہیں پرندے پا کے پیغامِ حیات",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "باندھتے ہیں پھُول بھی گُلشن میں احرامِ حیات",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "مسلمِ خوابیدہ اُٹھ، ہنگامہ آرا تُو بھی ہو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "وہ چمک اُٹھّا اُفُق، گرمِ تقاضا تُو بھی ہو",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "وسعتِ عالم میں رہ پیما ہو مثلِ آفتاب",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "دامنِ گردُوں سے ناپیدا ہوں یہ داغِ سحاب",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "کھینچ کر خنجر کرن کا، پھر ہو سرگرمِ ستیز",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "پھر سِکھا تاریکیِ باطل کو آدابِ گریز",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "تُو سراپا نور ہے، خوشتر ہے عُریانی تُجھے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "اور عُریاں ہو کے لازم ہے خود افشانی تجھے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "ہاں، نمایاں ہو کے برقِ دیدۂ خفّاش ہو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "اے دلِ کون ومکاں کے رازِ مضمر! فاش ہو",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
