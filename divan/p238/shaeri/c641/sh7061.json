{
 "FullUrl": "/p238/shaeri/c641/sh7061",
 "Title": "وطنیّت",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(یعنی وطن بحیثیّت ایک سیاسی تصوّر کے)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "اس دور میں مے اور ہے، جام اور ہے جم اور",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "ساقی نے بِنا کی روِشِ لُطف و ستم اور",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "مسلم نے بھی تعمیر کِیا اپنا حرم اور",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "تہذیب کے آزر نے ترشوائے صنم اور",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "ان تازہ خداؤں میں بڑا سب سے وطن ہے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "جو پیرہن اس کا ہے، وہ مذہب کا کفن ہے",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "یہ بُت کہ تراشیدۂ تہذیبِ نوی ہے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "غارت گرِ کاشانۂ دینِ نبَوی ہے",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "بازو ترا توحید کی قوّت سے قوی ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "اسلام ترا دیس ہے، تُو مصطفوی ہے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "نظّارۂ دیرینہ زمانے کو دِکھا دے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "اے مصطفَوی خاک میں اس بُت کو ملا دے!",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "ہو قیدِ مقامی تو نتیجہ ہے تباہی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "رہ بحر میں آزادِ وطن صُورتِ ماہی",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "ہے ترکِ وطن سُنّتِ محبوبؐ الٰہی",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "دے تُو بھی نبوّت کی صداقت پہ گواہی",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "گُفتارِ سیاست میں وطن اور ہی کچھ ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "ارشادِ نبوّت میں وطن اور ہی کچھ ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "اقوامِ جہاں میں ہے رقابت تو اسی سے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "تسخیر ہے مقصودِ تجارت تو اسی سے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "خالی ہے صداقت سے سیاست تو اسی سے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "کمزور کا گھر ہوتا ہے غارت تو اسی سے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 24,
   "Position": "Right",
   "Text": "اقوام میں مخلوقِ خدا بٹتی ہے اس سے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  },
  {
   "VOrder": 25,
   "Position": "Left",
   "Text": "قومیّتِ اسلام کی جڑ کٹتی ہے اس سے",
   "CoupletIndex": 12,
   "SectionIndex1": 0
  }
 ],
