{
 "FullUrl": "/p238/shaeri/c641/sh7072",
 "Title": "پرندے کی فریاد",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "بچوں کے لیے",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "آتا ہے یاد مجھ کو گزرا ہوا زمانا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "وہ باغ کی بہاریں، وہ سب کا چہچہانا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "آزادیاں کہاں وہ اب اپنے گھونسلے کی",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "اپنی خوشی سے آنا، اپنی خوشی سے جانا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "لگتی ہے چوٹ دل پر، آتا ہے یاد جس دم",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "شبنم کے آنسوؤں پر کلیوں کا مُسکرانا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "وہ پیاری پیاری صورت، وہ کامنی سی مورت",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "آباد جس کے دم سے تھا میرا آشیانا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "آتی نہیں صدائیں اُس کی مرے قفس میں",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "ہوتی مری رہائی اے کاش میرے بس میں!",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "کیا بد نصیب ہوں مَیں گھر کو ترس رہا ہوں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "ساتھی تو ہیں وطن میں، مَیں قید میں پڑا ہوں",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "آئی بہار، کلیاں پھُولوں کی ہنس رہی ہیں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "مَیں اس اندھیرے گھر میں قسمت کو رو رہا ہوں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "اس قید کا الٰہی! دُکھڑا کسے سُناؤں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "ڈر ہے یہیں قفسں میں مَیں غم سے مر نہ جاؤں",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "جب سے چمن چھُٹا ہے، یہ حال ہو گیا ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "دل غم کو کھا رہا ہے، غم دل کو کھا رہا ہے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Right",
   "Text": "گانا اسے سمجھ کر خوش ہوں نہ سُننے والے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Left",
   "Text": "دُکھّے ہوئے دلوں کی فریاد یہ صدا ہے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Right",
   "Text": "آزاد مجھ کو کر دے، او قید کرنے والے!",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  },
  {
   "VOrder": 23,
   "Position": "Left",
   "Text": "مَیں بے زباں ہوں قیدی، تو چھوڑ کر دُعا لے",
   "CoupletIndex": 11,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
