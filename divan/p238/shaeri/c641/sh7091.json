{
 "FullUrl": "/p238/shaeri/c641/sh7091",
 "Title": "پیامِ صبح",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ از لانگ فیلو)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "اُجالا جب ہُوا رخصت جبینِ شب کی افشاں کا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "نسیمِ زندگی پیغام لائی صبحِ خنداں کا",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "جگایا بُلبلِ رنگیں نوا کو آشیانے میں",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "کنارے کھیت کے شانہ ہِلایا اُس نے دہقاں کا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "طلسمِ ظلمتِ شب سُورۂ والنُّور سے توڑا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "اندھیرے میں اُڑایا تاجِ زر شمعِ شبستاں کا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "پڑھا خوابیدگانِ دَیر پر افسونِ بیداری",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "برہمن کو دیا پیغام خورشیدِ دُرَخشاں کا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "ہُوئی بامِ حرم پر آ کے یوں گویا مؤذّن سے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "نہیں کھٹکا ترے دل میں نمودِ مہرِ تاباں کا؟",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "پُکاری اس طرح دیوارِ گلشن پر کھڑے ہو کر",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "چٹک او غنچہ گُل! تُو مؤذّن ہے گُلستاں کا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Right",
   "Text": "دیا یہ حکم صحرا میں چلو اے قافلے والو!",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Left",
   "Text": "چمکنے کو ہے جُگنو بن کے ہر ذرّہ بیاباں کا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Right",
   "Text": "سوئے گورِ غریباں جب گئی زندوں کی بستی سے",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Left",
   "Text": "تو یوں بولی نظارا دیکھ کر شہرِ خموشاں کا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Right",
   "Text": "ابھی آرام سے لیٹے رہو، مَیں پھر بھی آؤں گی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Left",
   "Text": "سُلادوں گی جہاں کو، خواب سے تم کو جگاؤں گی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
