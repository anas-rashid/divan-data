{
 "FullUrl": "/p238/shaeri/c641/sh7120",
 "Title": "کُفر و اسلام",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "تضمین بر شعرِ میر رضی دانشؔ",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "ایک دن اقبالؔ نے پُوچھا کلیمِ طُور سے",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "اے کہ تیرے نقشِ پا سے وادیِ سِینا چمن",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "آتشِ نمرود ہے اب تک جہاں میں شُعلہ ریز",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "ہوگیا آنکھوں سے پنہاں کیوں ترا سوزِ کُہن",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "تھا جوابِ صاحبِ سینا کہ مسلم ہے اگر",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "چھوڑ کر غائب کو تُو حاضر کا شیدائی نہ بن",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "ذوقِ حاضر ہے تو پھر لازم ہے ایمانِ خلیلؑ",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "ورنہ خاکستر ہے تیری زندگی کا پیرہن",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "ہے اگر دیوانۂ غائب تو کچھ پروا نہ کر",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "منتظر رہ وادیِ فاراں میں ہو کر خیمہ زن",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Right",
   "Text": "عارضی ہے شانِ حاضر، سطوَتِ غائب مدام",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Left",
   "Text": "اس صداقت کو محبّت سے ہے ربطِ جان و تن",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Single",
   "Text": "شُعلۂ نمرود ہے روشن زمانے میں تو کیا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Single",
   "Text": "“شمع خود را می گدازد درمیانِ انجمن",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Single",
   "Text": "نُورِ ما چوں آتشِ سنگ از نظر پنہاں خوش است”",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
