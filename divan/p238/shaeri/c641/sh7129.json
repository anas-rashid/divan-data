{
 "FullUrl": "/p238/shaeri/c641/sh7129",
 "Title": "۔۔۔۔ کی گود میں بِلّی دیکھ کر",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Right",
   "Text": "تجھ کو دُزدیدہ نگاہی یہ سِکھا دی کس نے",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Left",
   "Text": "رمز آغازِ محبّت کی بتا دی کس نے",
   "CoupletIndex": 0,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "ہر ادا سے تری پیدا ہے محبّت کیسی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "نیلی آنکھوں سے ٹپکتی ہے ذکاوت کیسی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "دیکھتی ہے کبھی ان کو، کبھی شرماتی ہے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "کبھی اُٹھتی ہے، کبھی لیٹ کے سو جاتی ہے",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "آنکھ تیری صفَتِ آئنہ حیران ہے کیا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "نُورِ آگاہی سے روشن تری پہچان ہے کیا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "مارتی ہے انھیں پونہچوں سے، عجب ناز ہے یہ",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "چھیڑ ہے، غُصّہ ہے یا پیار کا انداز ہے یہ؟",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "شوخ تُو ہوگی تو گودی سے اُتاریں گے تجھے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "گِر گیا پھُول جو سینے کا تو ماریں گے تجھے",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "کیا تجسّس ہے تجھے، کس کی تمنّائی ہے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "آہ! کیا تُو بھی اسی چیز کی سودائی ہے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "خاص انسان سے کچھ حُسن کا احساس نہیں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "صُورتِ دل ہے یہ ہر چیز کے باطن میں مکیں",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "شیشۂ دہر میں مانندِ مئے ناب ہے عشق",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "رُوح خورشید ہے، خونِ رگِ مہتاب ہے عشق",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 19,
   "Position": "Right",
   "Text": "دلِ ہر ذرّہ میں پوشیدہ کسک ہے اس کی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 20,
   "Position": "Left",
   "Text": "نور یہ وہ ہے کہ ہر شے میں جھلک ہے اس کی",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 21,
   "Position": "Right",
   "Text": "کہیں سامانِ مسرّت، کہیں سازِ غم ہے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  },
  {
   "VOrder": 22,
   "Position": "Left",
   "Text": "کہیں گوہر ہے، کہیں اشک، کہیں شبنم ہے",
   "CoupletIndex": 10,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
  "by": "دیوان",
