{
 "FullUrl": "/p238/shaeri/c641/sh7154",
 "Title": "ہمایوں",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(مسٹر جسٹس شاہ دین مرحوم)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Right",
   "Text": "اے ہمایوں! زندگی تیری سراپا سوز تھی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Left",
   "Text": "تیری چنگاری چراغِ انجمن افروز تھی",
   "CoupletIndex": 1,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Right",
   "Text": "گرچہ تھا تیرا تنِ خاکی نزار و دردمند",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Left",
   "Text": "تھی ستارے کی طرح روشن تری طبعِ بلند",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Right",
   "Text": "کس قدر بے باک دل اس ناتواں پیکر میں تھا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Left",
   "Text": "شعلۂ گردُوں نَورد اک مُشتِ خاکستر میں تھا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Right",
   "Text": "موت کی لیکن دلِ دانا کو کچھ پروا نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Left",
   "Text": "شب کی خاموشی میں جُز ہنگامۂ فردا نہیں",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Right",
   "Text": "موت کو سمجھے ہیں غافل اختتامِ زندگی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Left",
   "Text": "ہے یہ شامِ زندگی، صبحِ دوامِ زندگی",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  }
 ],
 "Edited": {
