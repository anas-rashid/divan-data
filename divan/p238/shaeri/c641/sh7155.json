{
 "FullUrl": "/p238/shaeri/c641/sh7155",
 "Title": "ہمدردی",
 "Verses": [
  {
   "VOrder": 1,
   "Position": "Heading",
   "Text": "(ماخوذ از ولیم کوپر)",
   "CoupletIndex": 0,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 2,
   "Position": "Heading",
   "Text": "بچوں کے لیے",
   "CoupletIndex": 1,
   "Level": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 3,
   "Position": "Right",
   "Text": "ٹہنی پہ کسی شجر کی تنہا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 4,
   "Position": "Left",
   "Text": "بُلبل تھا کوئی اُداس بیٹھا",
   "CoupletIndex": 2,
   "SectionIndex1": 0
  },
  {
   "VOrder": 5,
   "Position": "Right",
   "Text": "کہتا تھا کہ رات سر پہ آئی",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 6,
   "Position": "Left",
   "Text": "اُڑنے چُگنے میں دن گزارا",
   "CoupletIndex": 3,
   "SectionIndex1": 0
  },
  {
   "VOrder": 7,
   "Position": "Right",
   "Text": "پہنچوں کِس طرح آشیاں تک",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 8,
   "Position": "Left",
   "Text": "ہر چیز پہ چھا گیا اندھیرا",
   "CoupletIndex": 4,
   "SectionIndex1": 0
  },
  {
   "VOrder": 9,
   "Position": "Right",
   "Text": "سُن کر بُلبل کی آہ و زاری",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 10,
   "Position": "Left",
   "Text": "جُگنو کوئی پاس ہی سے بولا",
   "CoupletIndex": 5,
   "SectionIndex1": 0
  },
  {
   "VOrder": 11,
   "Position": "Right",
   "Text": "حاضر ہُوں مدد کو جان و دل سے",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 12,
   "Position": "Left",
   "Text": "کِیڑا ہوں اگرچہ مَیں ذرا سا",
   "CoupletIndex": 6,
   "SectionIndex1": 0
  },
  {
   "VOrder": 13,
   "Position": "Right",
   "Text": "کیا غم ہے جو رات ہے اندھیری",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 14,
   "Position": "Left",
   "Text": "مَیں راہ میں روشنی کروں گا",
   "CoupletIndex": 7,
   "SectionIndex1": 0
  },
  {
   "VOrder": 15,
   "Position": "Right",
   "Text": "اللہ نے دی ہے مجھ کو مشعل",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 16,
   "Position": "Left",
   "Text": "چمکا کے مجھے دِیا بنایا",
   "CoupletIndex": 8,
   "SectionIndex1": 0
  },
  {
   "VOrder": 17,
   "Position": "Right",
   "Text": "ہیں لوگ وہی جہاں میں اچھّے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  },
  {
   "VOrder": 18,
   "Position": "Left",
   "Text": "آتے ہیں جو کام دوسرں کے",
   "CoupletIndex": 9,
   "SectionIndex1": 0
  }
 ],
