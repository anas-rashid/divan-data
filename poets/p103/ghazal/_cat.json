  "Poems": [
    {
      "Id": 3002,
      "Title": "اے عشق تو نے واقف منزل بنا دیا",
      "FullUrl": "/p103/ghazal/sh3002",
      "RadifLetter": "ا"
    },
    {
      "Id": 3001,
      "Title": "اب کوئی غم گسار ہمارا نہیں رہا",
      "FullUrl": "/p103/ghazal/sh3001",
      "RadifLetter": "ا"
    },
    {
      "Id": 3009,
      "Title": "پھر اعتبار عشق کے قابل نہیں رہا",
      "FullUrl": "/p103/ghazal/sh3009",
      "RadifLetter": "ا"
    },
    {
      "Id": 3003,
      "Title": "بے سود ہے یہ جوش گریہ اے شمع سحر ہو جانے تک",
      "FullUrl": "/p103/ghazal/sh3003",
      "RadifLetter": "ک"
    },
    {
      "Id": 3004,
      "Title": "تمکیں ہے اور حسن گریباں ہے اور ہم",
      "FullUrl": "/p103/ghazal/sh3004",
      "RadifLetter": "م"
    },
    {
      "Id": 3005,
      "Title": "جہاں تک عشق کی توفیق ہے رنگیں بناتے ہیں",
      "FullUrl": "/p103/ghazal/sh3005",
      "RadifLetter": "ن"
    },
    {
      "Id": 3010,
      "Title": "کوچہ گردی میں جوانی جائے گی",
      "FullUrl": "/p103/ghazal/sh3010",
      "RadifLetter": "ی"
    },
    {
      "Id": 3011,
      "Title": "کیا کہئے داستان تمنا بدل گئی",
      "FullUrl": "/p103/ghazal/sh3011",
      "RadifLetter": "ی"
    },
    {
      "Id": 3013,
      "Title": "ہر سانس ہے شرح ناکامی پھر عشق کو رسوا کون کرے",
      "FullUrl": "/p103/ghazal/sh3013",
      "RadifLetter": "ے"
    },
    {
      "Id": 3006,
      "Title": "حسن نے مان لیا قابل تعزیر مجھے",
      "FullUrl": "/p103/ghazal/sh3006",
      "RadifLetter": "ے"
    },
    {
      "Id": 3008,
      "Title": "مایوس ازل ہوں یہ مانا ناکام تمنا رہنا ہے",
      "FullUrl": "/p103/ghazal/sh3008",
      "RadifLetter": "ے"
    },
    {
      "Id": 3007,
      "Title": "مئے کوثر کا اثر چشم سیہ فام میں ہے",
      "FullUrl": "/p103/ghazal/sh3007",
      "RadifLetter": "ے"
    }
  ]
}
