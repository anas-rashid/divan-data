      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کوچہ گردی میں جوانی جائے گی\r\nخاک ہو کر زندگانی جائے گی\r\nمٹ نہیں سکتا ہمارے دل کا داغ\r\nقبر میں بھی یہ نشانی جائے گی\r\nسچ ہے میری بات کا کیا اعتبار\r\nسچ کہوں گا جھوٹ جانی جائے گی\r\nحضرت دل جب بڑھاپا آئے گا\r\nخیر مقدم کو جوانی جائے گی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
