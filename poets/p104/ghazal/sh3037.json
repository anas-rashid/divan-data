      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ساقی قدح شراب دے دے\r\nمہتاب میں آفتاب دے دے\r\nساقی باقی جو کچھ ہے لے لے\r\nباقی ساقی شراب دے دے\r\nلیلیٰ میں نے تجھے بنایا\r\nمجنوں مجھ کو خطاب دے دے\r\nپیاسا جاتا ہے نشتر یار\r\nاو رگ کچھ خون ناب دے دے\r\nاس بت سے نسیم زر نہ تو مانگ\r\nجو چاہے وہ بے حساب دے دے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
