      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نام پر حرف نہ آنے دیجے\r\nجان اگر جائے تو جانے دیجے\r\nیاس کی آس نہ ٹوٹے جس میں\r\nآس کو پاس نہ آنے دیجے\r\nپارۂ دل نہ تھما مردم چشم\r\nبیٹھیے مجھ کو اوٹھانے دیجے\r\nغصہ کیا اب تو گیا یاں سے نسیمؔ\r\nآئیے بیٹھیے جانے دیجے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
