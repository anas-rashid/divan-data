      "RhymeLetters": null,
      "PlainText": "ٹکڑے جگر کے آنکھ سے بارے نکل گئے\r\nارمان آج دل کے ہمارے نکل گئے\r\nواحسرتا کہ لخت جگر تھے جو طفل اشک\r\nآنکھوں کے سامنے سے ہمارے نکل گئے\r\nشعلے ہمارے آہوں کے ایسے ہوئے بلند\r\nابروں سے آسماں کے ستارے نکل گئے\r\nمانند دشت خرقہ ہوا کہنہ اے نسیمؔ\r\nدامن کے ہر طرف سے کنارے نکل گئے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
