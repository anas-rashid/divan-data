  "Poems": [
    {
      "Id": 3074,
      "Title": "وہ اٹھ کر قیامت اٹھانا کسی کا",
      "FullUrl": "/p107/ghazal/sh3074"
    },
    {
      "Id": 3072,
      "Title": "شب وصل روٹھا ہے دلبر کسی کا",
      "FullUrl": "/p107/ghazal/sh3072"
    },
    {
      "Id": 3067,
      "Title": "حضور داور محشر قیامت خیز ساماں تھا",
      "FullUrl": "/p107/ghazal/sh3067"
    },
    {
      "Id": 3066,
      "Title": "اور تڑپائے مجھے درد جگر آج کی رات",
      "FullUrl": "/p107/ghazal/sh3066"
    },
    {
      "Id": 3070,
      "Title": "دل کو تسکیں ہو گئی ہے سامنے آنے کے بعد",
      "FullUrl": "/p107/ghazal/sh3070"
    },
    {
      "Id": 3076,
      "Title": "کیا ترے دل میں اے بت ہوں دل و جاں محفوظ",
      "FullUrl": "/p107/ghazal/sh3076"
    },
    {
      "Id": 3069,
      "Title": "دل رقیب تو دیکھا مرا جگر دیکھیں",
      "FullUrl": "/p107/ghazal/sh3069"
    },
    {
      "Id": 3071,
      "Title": "زاہد بھی میری طرح اسی پر فدا نہ ہو",
      "FullUrl": "/p107/ghazal/sh3071"
    },
    {
      "Id": 3075,
      "Title": "کس طرح چین سے دم بھر شب فرقت میں رہے",
      "FullUrl": "/p107/ghazal/sh3075"
    },
    {
      "Id": 3073,
      "Title": "ماہ اچھا ہے کہ وہ بدر کمال اچھا ہے",
      "FullUrl": "/p107/ghazal/sh3073"
    },
    {
      "Id": 3068,
      "Title": "خواب میں وہ مرے آغوش میں آ جاتا ہے",
      "FullUrl": "/p107/ghazal/sh3068"
    },
    {
      "Id": 3077,
      "Title": "یوں تڑپتے ہوئے نوشادؔ وطن سے نکلے",
      "FullUrl": "/p107/ghazal/sh3077"
    }
  ]
}
