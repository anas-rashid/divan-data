  "Poems": [
    {
      "Id": 3102,
      "Title": "جاؤں کیا منہ لے کے میں وہ بد گماں ہو جائے گا",
      "FullUrl": "/p112/ghazal/sh3102"
    },
    {
      "Id": 3099,
      "Title": "ازل کی یاد میں میں گرم آہ سرد ہوا",
      "FullUrl": "/p112/ghazal/sh3099"
    },
    {
      "Id": 3106,
      "Title": "واہ کیا عالم عجب ہے انتظار یار کا",
      "FullUrl": "/p112/ghazal/sh3106"
    },
    {
      "Id": 3104,
      "Title": "نا مناسب ہے خفا نالوں کو سن کر ہونا",
      "FullUrl": "/p112/ghazal/sh3104"
    },
    {
      "Id": 3101,
      "Title": "بے خودی ہے حسرتوں کی بھیڑ چھٹ جانے کے بعد",
      "FullUrl": "/p112/ghazal/sh3101"
    },
    {
      "Id": 3103,
      "Title": "دل ہے اپنا رنج فرقت میں شریک",
      "FullUrl": "/p112/ghazal/sh3103"
    },
    {
      "Id": 3098,
      "Title": "آدمی آدمی سے ملتے ہیں",
      "FullUrl": "/p112/ghazal/sh3098"
    },
    {
      "Id": 3100,
      "Title": "ان سے دل ملتے ہی فرقت کی بلا بھی آئی",
      "FullUrl": "/p112/ghazal/sh3100"
    },
    {
      "Id": 3105,
      "Title": "نہیں ہے امن کا دنیا میں اب مقام کوئی",
      "FullUrl": "/p112/ghazal/sh3105"
    }
  ]
}
