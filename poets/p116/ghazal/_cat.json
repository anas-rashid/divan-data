  "Poems": [
    {
      "Id": 3167,
      "Title": "ان کی خلوت میں رساؔ بھی ہوگا",
      "FullUrl": "/p116/ghazal/sh3167",
      "RadifLetter": "ا"
    },
    {
      "Id": 3173,
      "Title": "ساقی جو دیئے جائے یہ کہہ کر کہ پئے جا",
      "FullUrl": "/p116/ghazal/sh3173",
      "RadifLetter": "ا"
    },
    {
      "Id": 3171,
      "Title": "راس آیا ہے مجھے وحشت میں مر جانا مرا",
      "FullUrl": "/p116/ghazal/sh3171",
      "RadifLetter": "ا"
    },
    {
      "Id": 3178,
      "Title": "کون سا عشق بتاں میں ہمیں صدمہ نہ ہوا",
      "FullUrl": "/p116/ghazal/sh3178",
      "RadifLetter": "ا"
    },
    {
      "Id": 3175,
      "Title": "نیچی نظروں سے نہ دیکھو سر محشر دیکھو",
      "FullUrl": "/p116/ghazal/sh3175",
      "RadifLetter": "و"
    },
    {
      "Id": 3168,
      "Title": "جی چاہا جدھر چھوڑ دیا تیر ادا کو",
      "FullUrl": "/p116/ghazal/sh3168",
      "RadifLetter": "و"
    },
    {
      "Id": 3176,
      "Title": "وہ خوش کسی کے ساتھ ہیں ناخوش کسی کے ساتھ",
      "FullUrl": "/p116/ghazal/sh3176",
      "RadifLetter": "ھ"
    },
    {
      "Id": 3169,
      "Title": "دشمن کی بات جب تری محفل میں رہ گئی",
      "FullUrl": "/p116/ghazal/sh3169",
      "RadifLetter": "ی"
    },
    {
      "Id": 3172,
      "Title": "رساؔ کو دل میں رکھتے ہیں رساؔ کے جاننے والے",
      "FullUrl": "/p116/ghazal/sh3172",
      "RadifLetter": "ے"
    },
    {
      "Id": 3177,
      "Title": "پی کے کر لیتا ہوں توبہ جب سے یہ دستور ہے",
      "FullUrl": "/p116/ghazal/sh3177",
      "RadifLetter": "ے"
    },
    {
      "Id": 3170,
      "Title": "دل میں کسی کو رکھو دل میں رہو کسی کے",
      "FullUrl": "/p116/ghazal/sh3170",
      "RadifLetter": "ے"
    },
    {
      "Id": 3174,
      "Title": "عاشق کو تیرے لاکھ کوئی رہنما ملے",
      "FullUrl": "/p116/ghazal/sh3174",
      "RadifLetter": "ے"
    },
    {
      "Id": 3166,
      "Title": "آنے کو نظر میں مری سو فتنہ گر آئے",
      "FullUrl": "/p116/ghazal/sh3166",
      "RadifLetter": "ے"
    },
    {
      "Id": 3165,
      "Title": "آئینہ خود نمائی ان کو سکھا رہا ہے",
      "FullUrl": "/p116/ghazal/sh3165",
      "RadifLetter": "ے"
    }
  ]
}
