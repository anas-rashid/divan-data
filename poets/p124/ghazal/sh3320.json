    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "پہنچ جائیں یوں ہی ہم آستاں تک",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "معاصی کے سوا دو دو فرشتے",
      "CoupletIndex": 17,
      "SectionIndex1": 0
