      "Text": "مری فریاد سن کر چپ رہیں گے",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "اسے پہنچائیں گے وہ آسماں تک",
      "CoupletIndex": 12,
