      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دم وعدہ انہیں ہے بار ہاں تک",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
