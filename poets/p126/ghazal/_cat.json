  "Poems": [
    {
      "Id": 3464,
      "Title": "ہر چند کہ اب مجھ سے ستم اٹھ نہیں سکتا",
      "FullUrl": "/p126/ghazal/sh3464"
    },
    {
      "Id": 3441,
      "Title": "اچھا ہوا کہ دم شب ہجراں نکل گیا",
      "FullUrl": "/p126/ghazal/sh3441"
    },
    {
      "Id": 3439,
      "Title": "اس پہ کرنا مرے نالوں نے اثر چھوڑ دیا",
      "FullUrl": "/p126/ghazal/sh3439"
    },
    {
      "Id": 3448,
      "Title": "زور پر آہ تھی اور نالۂ شب گیر بھی تھا",
      "FullUrl": "/p126/ghazal/sh3448"
    },
    {
      "Id": 3455,
      "Title": "ناتوانی میں پلک کو بھی ہلایا نہ گیا",
      "FullUrl": "/p126/ghazal/sh3455"
    },
    {
      "Id": 3457,
      "Title": "نہ پردہ کھولیو اے عشق غم میں تو میرا",
      "FullUrl": "/p126/ghazal/sh3457"
    },
    {
      "Id": 3456,
      "Title": "نہ آئے سامنے میرے اگر نہیں آتا",
      "FullUrl": "/p126/ghazal/sh3456"
    },
    {
      "Id": 3461,
      "Title": "کیا کرے گی یہ تری کاکل پیماں میرا",
      "FullUrl": "/p126/ghazal/sh3461"
    },
    {
      "Id": 3446,
      "Title": "رات یاد نگہ یار نے سونے نہ دیا",
      "FullUrl": "/p126/ghazal/sh3446"
    },
    {
      "Id": 3463,
      "Title": "کیوں آئینے میں دیکھا تو نے جمال اپنا",
      "FullUrl": "/p126/ghazal/sh3463"
    },
    {
      "Id": 3466,
      "Title": "ہم کو اس شوخ نے کل در تلک آنے نہ دیا",
      "FullUrl": "/p126/ghazal/sh3466"
    },
    {
      "Id": 3469,
      "Title": "یاں چلا آئے جو وہ سیم بدن آپ سے آپ",
      "FullUrl": "/p126/ghazal/sh3469"
    },
    {
      "Id": 3447,
      "Title": "رخ پر رہی وہ زلف معنبر تمام رات",
      "FullUrl": "/p126/ghazal/sh3447"
    },
    {
      "Id": 3458,
      "Title": "وحشت میں یاد آئے ہے زنجیر دیکھ کر",
      "FullUrl": "/p126/ghazal/sh3458"
    },
    {
      "Id": 3459,
      "Title": "کچھ چپ ہیں آئنہ جو وہ ہر بار دیکھ کر",
      "FullUrl": "/p126/ghazal/sh3459"
    },
    {
      "Id": 3445,
      "Title": "در پہ رہے یہ دیدۂ گریاں تمام عمر",
      "FullUrl": "/p126/ghazal/sh3445"
    },
    {
      "Id": 3467,
      "Title": "ہوویں برعکس بھلا کیوں نہ وہ اغیار سے خوش",
      "FullUrl": "/p126/ghazal/sh3467"
    },
    {
      "Id": 3443,
      "Title": "تم جو کہتے ہو کہ آویں گے ترے ہاں کل تک",
      "FullUrl": "/p126/ghazal/sh3443"
    },
    {
      "Id": 3452,
      "Title": "قائل بھلا ہوں نامہ بری میں صبا کے خاک",
      "FullUrl": "/p126/ghazal/sh3452"
    },
    {
      "Id": 3451,
      "Title": "سچ ہے کہ آہ سرد مری بے اثر نہیں",
      "FullUrl": "/p126/ghazal/sh3451"
    },
    {
      "Id": 3465,
      "Title": "ہر گھڑی چلتی ہے تلوار ترے کوچے میں",
      "FullUrl": "/p126/ghazal/sh3465"
    },
    {
      "Id": 3449,
      "Title": "سب سے بہتر ہے کہ مجھ پر مہرباں کوئی نہ ہو",
      "FullUrl": "/p126/ghazal/sh3449"
    },
    {
      "Id": 3450,
      "Title": "سر جو رہتا ہے مرا رونے سے اکثر بھاری",
      "FullUrl": "/p126/ghazal/sh3450"
    },
    {
      "Id": 3442,
      "Title": "تدبیر میں یارو نہیں تقصیر تمہاری",
      "FullUrl": "/p126/ghazal/sh3442"
    },
    {
      "Id": 3437,
      "Title": "آہ کو جو کہوں برائی کی",
      "FullUrl": "/p126/ghazal/sh3437"
    },
    {
      "Id": 3440,
      "Title": "ان کی اور میری کسی روز لڑائی نہ گئی",
      "FullUrl": "/p126/ghazal/sh3440"
    },
    {
      "Id": 3444,
      "Title": "جہاں سے دوش عزیزاں پہ بار ہو کے چلے",
      "FullUrl": "/p126/ghazal/sh3444"
    },
    {
      "Id": 3453,
      "Title": "مر جائیں گے لیکن کبھی الفت نہ کریں گے",
      "FullUrl": "/p126/ghazal/sh3453"
    },
    {
      "Id": 3468,
      "Title": "ہیں ہم بھی خوب چاہ کا ساماں کیے ہوئے",
      "FullUrl": "/p126/ghazal/sh3468"
    },
    {
      "Id": 3454,
      "Title": "میرے دل کو بٹھا دیا کس نے",
      "FullUrl": "/p126/ghazal/sh3454"
    },
    {
      "Id": 3460,
      "Title": "کی میرے تڑپنے کی نہ تدبیر کسی نے",
      "FullUrl": "/p126/ghazal/sh3460"
    },
    {
      "Id": 3438,
      "Title": "اس در پہ مجھے یار مچلنے نہیں دیتے",
      "FullUrl": "/p126/ghazal/sh3438"
    },
    {
      "Id": 3462,
      "Title": "کیا کہیں ہم تھے کہ یا دیدۂ تر بیٹھ گئے",
      "FullUrl": "/p126/ghazal/sh3462"
    }
