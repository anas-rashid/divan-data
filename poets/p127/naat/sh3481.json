    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کب تک دل بیتاب کہے ہائے مدینہ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "مر جاوں مدینے میں، مدینے میں لحد ہو",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "لے جاوں لحد میں، میں تمنائے مدینہ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "آ بیٹھو مرے دل میں کہ دل عرش بریں ہے",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تم جاہو تو سینہ مرا بن جائے مدینہ",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "یا رب مرے دل میں رہے یثرب کی تمنا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "یا رب مرے سر میں رہے سودائے مدینہ",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "اے چشم تصور تجھے اتنا ہی بہت ہے",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
