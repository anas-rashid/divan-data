      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "محرم دل ہوا وو صحرا وا\r\nکر کہ معلوم والہ و رسوا\r\nسوچ کر آہ درد کوں آرام\r\nدل ہمارا ہوا درس کا گدا\r\nمہر کر مہر موم دل ہو کر\r\nکر عطا دل کا مدعا سارا\r\nدرد کا گھر ہوا ہمارا دل\r\nہار گل کا ہوا گل سودا\r\nدل کہا لاالہ الا اللہ\r\nورد اسم رسول کر کے سدا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 5
    }
  ],
