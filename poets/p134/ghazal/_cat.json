  "Poems": [
    {
      "Id": 3718,
      "Title": "آ کدھر ہے تو ساقیٔ مخمور",
      "FullUrl": "/p134/ghazal/sh3718"
    },
    {
      "Id": 3719,
      "Title": "الٰہی خیر ہو وہ آج کیوں کر تن کے بیٹھے ہیں",
      "FullUrl": "/p134/ghazal/sh3719"
    },
    {
      "Id": 3720,
      "Title": "ان بتوں سے ربط توڑا چاہئے",
      "FullUrl": "/p134/ghazal/sh3720"
    },
    {
      "Id": 3721,
      "Title": "اگر الٹی بھی ہو اے مشرقیؔ تدبیر سیدھی ہو",
      "FullUrl": "/p134/ghazal/sh3721"
    },
    {
      "Id": 3722,
      "Title": "بجز سایہ تن لاغر کو میرے کوئی کیا سمجھے",
      "FullUrl": "/p134/ghazal/sh3722"
    },
    {
      "Id": 3723,
      "Title": "بوسہ دیتے ہو اگر تم مجھ کو دو دو سب کے دو",
      "FullUrl": "/p134/ghazal/sh3723"
    },
    {
      "Id": 3724,
      "Title": "تمہیں شب وعدہ درد سر تھا یہ سب ہیں بے اعتبار باتیں",
      "FullUrl": "/p134/ghazal/sh3724"
    },
    {
      "Id": 3725,
      "Title": "تیری محفل میں جتنے اے ستم گر جانے والے ہیں",
      "FullUrl": "/p134/ghazal/sh3725"
    },
    {
      "Id": 3726,
      "Title": "جس کا راہب شیخ ہو بت خانہ ایسا چاہیے",
      "FullUrl": "/p134/ghazal/sh3726"
    },
    {
      "Id": 3727,
      "Title": "جو تمہیں یاد کیا کرتے ہیں",
      "FullUrl": "/p134/ghazal/sh3727"
    },
    {
      "Id": 3728,
      "Title": "دیکھا کسی کا ہم نے نہ ایسا سنا دماغ",
      "FullUrl": "/p134/ghazal/sh3728"
    },
    {
      "Id": 3729,
      "Title": "رونق عہد جوانی الوداع",
      "FullUrl": "/p134/ghazal/sh3729"
    },
    {
      "Id": 3730,
      "Title": "رہ کر مکان میں مرے مہمان جائیے",
      "FullUrl": "/p134/ghazal/sh3730"
    },
    {
      "Id": 3731,
      "Title": "رہتا ہے کب اک روش پر آسماں",
      "FullUrl": "/p134/ghazal/sh3731"
    },
    {
      "Id": 3732,
      "Title": "مرا یہ زخم سینہ کا کہیں بھرتا ہے سینے سے",
      "FullUrl": "/p134/ghazal/sh3732"
    },
    {
      "Id": 3733,
      "Title": "میں وہ آتش‌ نفس ہوں آگ ابھی",
      "FullUrl": "/p134/ghazal/sh3733"
    },
    {
      "Id": 3734,
      "Title": "ناصحا آیا نصیحت ہے سنانے کے لیے",
      "FullUrl": "/p134/ghazal/sh3734"
    },
    {
      "Id": 3735,
      "Title": "نالہ شب فراق جو کوئی نکل گیا",
      "FullUrl": "/p134/ghazal/sh3735"
    },
    {
      "Id": 3736,
      "Title": "وسعت بحر عشق کیا کہیے",
      "FullUrl": "/p134/ghazal/sh3736"
    },
    {
      "Id": 3737,
      "Title": "کالی کالی گھٹا برستی ہے",
      "FullUrl": "/p134/ghazal/sh3737"
    },
    {
      "Id": 3738,
      "Title": "کالی گھٹا کب آئے گی فصل بہار میں",
      "FullUrl": "/p134/ghazal/sh3738"
    },
    {
      "Id": 3739,
      "Title": "کوئی اس سے نہیں کہتا کہ یہ کیا بے وفائی ہے",
      "FullUrl": "/p134/ghazal/sh3739"
    },
    {
      "Id": 3740,
      "Title": "کچھ بدگمانیاں ہیں کچھ بد زبانیاں ہیں",
      "FullUrl": "/p134/ghazal/sh3740"
    },
    {
      "Id": 3741,
      "Title": "کی مے سے ہزار بار توبہ",
      "FullUrl": "/p134/ghazal/sh3741"
    },
    {
      "Id": 3742,
      "Title": "ہیں بہت دیکھے چاہنے والے",
      "FullUrl": "/p134/ghazal/sh3742"
    }
  ]
}
