    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کوہ تو تیشہ سے ٹوٹا کوہ کن",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "کوشک خسرو بھی توڑا چاہئے",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "پڑ گئی چکر میں کشتی نا خدا",
      "CoupletIndex": 15,
