      "Position": "Left",
      "Text": "گنج پر کالوں کا جوڑا چاہئے",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "باد پا ہے ابلق چشم سیاہ",
      "CoupletIndex": 20,
      "SectionIndex1": 0
