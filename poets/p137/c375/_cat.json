  "ParentId": 374,
  "Title": "ریختی",
  "FullUrl": "/p137/c375",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 3953,
      "Title": "اب میری دوگانا کو مرا دھیان ہے کیا خاک",
      "FullUrl": "/p137/c375/sh3953"
    },
    {
      "Id": 3957,
      "Title": "جدا اس سے بھلا کب تک رہوں میں",
      "FullUrl": "/p137/c375/sh3957"
    },
    {
      "Id": 3958,
      "Title": "رشتۂ الفت کو توڑوں کس طرح",
      "FullUrl": "/p137/c375/sh3958"
    },
    {
      "Id": 3962,
      "Title": "میری طرف سے کچھ تو ترے دل میں چور ہے",
      "FullUrl": "/p137/c375/sh3962"
    },
    {
      "Id": 3963,
      "Title": "میرے گھر میں زناخی آئی کب",
      "FullUrl": "/p137/c375/sh3963"
    },
    {
      "Id": 3964,
      "Title": "میں تو کچھ کہتی نہیں شوق سے سو باری چیخ",
      "FullUrl": "/p137/c375/sh3964"
    },
    {
      "Id": 3965,
      "Title": "نیند آتی نہیں کم بخت دوانی آ جا",
      "FullUrl": "/p137/c375/sh3965"
    },
    {
      "Id": 3966,
      "Title": "ٹیس پیڑو میں اٹھی اوہی مری جان گئی",
      "FullUrl": "/p137/c375/sh3966"
    },
    {
      "Id": 3969,
      "Title": "کروں میں کہاں تک مدارات روز",
      "FullUrl": "/p137/c375/sh3969"
    },
    {
      "Id": 3970,
      "Title": "کس سے گرمی کا رکھا جائے یہ بھاری روزہ",
      "FullUrl": "/p137/c375/sh3970"
    },
    {
      "Id": 3971,
      "Title": "کشتی میں کپی تیل کی انا انڈیل ڈال",
      "FullUrl": "/p137/c375/sh3971"
    },
    {
      "Id": 3975,
      "Title": "یوں ہے اس دل کو دوگانا کی نشانی کی ہوس",
      "FullUrl": "/p137/c375/sh3975"
    },
    {
      "Id": 3976,
      "Title": "یہ میرے یار نے کیا مجھ سے بے وفائی کی",
      "FullUrl": "/p137/c375/sh3976"
    }
  ]
}
