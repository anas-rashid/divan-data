    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "دوڑی لینے کو میں اسے کس دم",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "پانوں میں میرے موچ آئی کب",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "کھانا کھایا تھا میں نے اس نے کہاں",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "اور منگوائی تھی ملائی کب",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "کی تھی شب میں نے کس جگہ کنگھی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "آرسی اس نے تھی دکھائی کب",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "ہرگز آتی نہیں ہے سانچ کو آنچ",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
