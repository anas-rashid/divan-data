  "Poems": [
    {
      "Id": 3955,
      "Title": "تا حشر رہے یہ داغ دل کا",
      "FullUrl": "/p137/ghazal/sh3955",
      "RadifLetter": "ا"
    },
    {
      "Id": 3973,
      "Title": "ہم جوں چکور غش ہیں اجی ایک یار پر",
      "FullUrl": "/p137/ghazal/sh3973",
      "RadifLetter": "ر"
    },
    {
      "Id": 3961,
      "Title": "میری ایذا میں خوشی جب آپ کی پاتے ہیں لوگ",
      "FullUrl": "/p137/ghazal/sh3961",
      "RadifLetter": "گ"
    },
    {
      "Id": 3959,
      "Title": "عشق سے بچ کے کدھر جائیں گے ہم",
      "FullUrl": "/p137/ghazal/sh3959",
      "RadifLetter": "م"
    },
    {
      "Id": 3967,
      "Title": "پھر بہار آئی مرے صیاد کو پروا نہیں",
      "FullUrl": "/p137/ghazal/sh3967",
      "RadifLetter": "ن"
    },
    {
      "Id": 3974,
      "Title": "ہمدمو کیا مجھ کو تم ان سے ملا سکتے نہیں",
      "FullUrl": "/p137/ghazal/sh3974",
      "RadifLetter": "ن"
    },
    {
      "Id": 3972,
      "Title": "گرم ان روزوں میں کچھ عشق کا بازار نہیں",
      "FullUrl": "/p137/ghazal/sh3972",
      "RadifLetter": "ن"
    },
    {
      "Id": 3956,
      "Title": "تجھ کو آتی ہے دلاسے کی نہیں بات کوئی",
      "FullUrl": "/p137/ghazal/sh3956",
      "RadifLetter": "ی"
    },
    {
      "Id": 3954,
      "Title": "اس کے کوچے میں بہت رہتے ہیں دیوانے پڑے",
      "FullUrl": "/p137/ghazal/sh3954",
      "RadifLetter": "ے"
    },
    {
      "Id": 3960,
      "Title": "غیر کی خاطر سے تم یاروں کو دھمکانے لگے",
      "FullUrl": "/p137/ghazal/sh3960",
      "RadifLetter": "ے"
    },
    {
      "Id": 3968,
      "Title": "چاہ کر ہم اس پری رو کو جو دیوانے ہوئے",
      "FullUrl": "/p137/ghazal/sh3968",
      "RadifLetter": "ے"
    }
  ]
