    },
    {
      "Id": 237,
      "Title": "تمہاری لن ترانی کے کرشمے دیکھے بھالے ہیں",
      "FullUrl": "/p14/ghazal/sh237"
    },
    {
      "Id": 244,
      "Title": "قاصد نئی ادا سے ادائے پیام ہو",
      "FullUrl": "/p14/ghazal/sh244"
