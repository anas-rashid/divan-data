      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "فخر بے جا نہیں سیادت کا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بدرؔ مرحوم کو خدا بخشے",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
