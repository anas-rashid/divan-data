  "Poems": [
    {
      "Id": 4047,
      "Title": "دولت نہیں جب تک یہ زبوں رہتے ہیں",
      "FullUrl": "/p146/rubai/sh4047"
    },
    {
      "Id": 4056,
      "Title": "ہے جس کی سرشت میں سفاہت کا میل",
      "FullUrl": "/p146/rubai/sh4056"
    },
    {
      "Id": 4045,
      "Title": "تن عیش کا گھر ہے اس کا اسباب ہے روح",
      "FullUrl": "/p146/rubai/sh4045"
    },
    {
      "Id": 4055,
      "Title": "کہتے ہو کہ کر لیں گے ہم اس کام کو کل",
      "FullUrl": "/p146/rubai/sh4055"
    },
    {
      "Id": 4042,
      "Title": "ایرانی فصاحت اور حجازی غیرت",
      "FullUrl": "/p146/rubai/sh4042"
    },
    {
      "Id": 4039,
      "Title": "اخلاق کے عنصر ہوں اگر اصل مزاج",
      "FullUrl": "/p146/rubai/sh4039"
    },
    {
      "Id": 4058,
      "Title": "یہ بات عجیب نگاہ میں آئی ہے",
      "FullUrl": "/p146/rubai/sh4058"
    },
    {
      "Id": 4048,
      "Title": "دولت کے بھروسے پہ نہ ہونا غافل",
      "FullUrl": "/p146/rubai/sh4048"
    },
    {
      "Id": 4053,
      "Title": "پاتا نہیں موت پر کوئی شخص ظفر",
      "FullUrl": "/p146/rubai/sh4053"
    },
    {
      "Id": 4049,
      "Title": "غیرت میں سیاست میں شجاعت میں ہو مرد",
      "FullUrl": "/p146/rubai/sh4049"
    },
    {
      "Id": 4050,
      "Title": "لازم نہیں اس دولت فانی پہ دماغ",
      "FullUrl": "/p146/rubai/sh4050"
    },
    {
      "Id": 4051,
      "Title": "مرغوب ہو گر تم کو عمومی شاباش",
      "FullUrl": "/p146/rubai/sh4051"
    },
    {
      "Id": 4040,
      "Title": "اس سے کہ کہیں کے شاہ ہو سکتے ہم",
      "FullUrl": "/p146/rubai/sh4040"
    },
    {
      "Id": 4046,
      "Title": "جس علم سے اچھوں کی ہو خوبی ظاہر",
      "FullUrl": "/p146/rubai/sh4046"
    },
    {
      "Id": 4044,
      "Title": "تعلیم کی میزان میں ہیں تلتے جاتے",
      "FullUrl": "/p146/rubai/sh4044"
    }
  ]
}
