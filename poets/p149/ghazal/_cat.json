  "Poems": [
    {
      "Id": 4078,
      "Title": "اس توقع پہ کہ دیکھوں کبھی آتے جاتے",
      "FullUrl": "/p149/ghazal/sh4078"
    },
    {
      "Id": 4081,
      "Title": "اپنا اپنا رنگ دکھلاتی ہیں جانی چوڑیاں",
      "FullUrl": "/p149/ghazal/sh4081"
    },
    {
      "Id": 4084,
      "Title": "بر سر لطف آج چشم دل ربا تھی میں نہ تھا",
      "FullUrl": "/p149/ghazal/sh4084"
    },
    {
      "Id": 4085,
      "Title": "بے دیے لے اڑا کبوتر خط",
      "FullUrl": "/p149/ghazal/sh4085"
    },
    {
      "Id": 4086,
      "Title": "تھی آسماں پہ میری چڑھائی تمام رات",
      "FullUrl": "/p149/ghazal/sh4086"
    },
    {
      "Id": 4087,
      "Title": "تیرے در سے میں اٹھا لیکن نہ میرا دل اٹھا",
      "FullUrl": "/p149/ghazal/sh4087"
    },
    {
      "Id": 4089,
      "Title": "جاں فشانی کا واں حساب عبث",
      "FullUrl": "/p149/ghazal/sh4089"
    },
    {
      "Id": 4090,
      "Title": "جب کہو کیوں ہو خفا کیا باعث",
      "FullUrl": "/p149/ghazal/sh4090"
    },
    {
      "Id": 4091,
      "Title": "دل میں اتری ہے نگہ رہ گئیں باہر پلکیں",
      "FullUrl": "/p149/ghazal/sh4091"
    },
    {
      "Id": 4092,
      "Title": "رونے کی یہ شدت ہے کہ گھبرا گئیں آنکھیں",
      "FullUrl": "/p149/ghazal/sh4092"
    },
    {
      "Id": 4097,
      "Title": "عاشق‌ حق ہیں ہمیں شکوۂ تقدیر نہیں",
      "FullUrl": "/p149/ghazal/sh4097"
    },
    {
      "Id": 4098,
      "Title": "قاضی کے منہ پہ ماری ہے بوتل شراب کی",
      "FullUrl": "/p149/ghazal/sh4098"
    },
    {
      "Id": 4099,
      "Title": "لے کے اپنی زلف کو وہ پیارے پیارے ہاتھ میں",
      "FullUrl": "/p149/ghazal/sh4099"
    },
    {
      "Id": 4100,
      "Title": "محتاج نہیں قافلہ آواز درا کا",
      "FullUrl": "/p149/ghazal/sh4100"
    },
    {
      "Id": 4101,
      "Title": "مل جائیں ازدحام میں ہم ہی یہ ہم سے دور",
      "FullUrl": "/p149/ghazal/sh4101"
    },
    {
      "Id": 4102,
      "Title": "میں نے کہا کہ دعوی‌ٔ الفت مگر غلط",
      "FullUrl": "/p149/ghazal/sh4102"
    },
    {
      "Id": 4105,
      "Title": "وہ جب آپ سے اپنا پردا کریں",
      "FullUrl": "/p149/ghazal/sh4105"
    },
    {
      "Id": 4107,
      "Title": "وہی گل ہے گلستاں میں وہی ہے شمع محفل میں",
      "FullUrl": "/p149/ghazal/sh4107"
    },
    {
      "Id": 4109,
      "Title": "کبھی خوں ہوتی ہوئے اور کبھی جلتے دیکھا",
      "FullUrl": "/p149/ghazal/sh4109"
    },
    {
      "Id": 4110,
      "Title": "کلام سخت کہہ کہہ کر وہ کیا ہم پر برستے ہیں",
      "FullUrl": "/p149/ghazal/sh4110"
    },
    {
      "Id": 4111,
      "Title": "کہاں ہے تو کہاں ہے اور میں ہوں",
      "FullUrl": "/p149/ghazal/sh4111"
    },
    {
      "Id": 4118,
      "Title": "ہم ان کی نظر میں سمانے لگے",
      "FullUrl": "/p149/ghazal/sh4118"
    },
    {
      "Id": 4119,
      "Title": "ہم نے سو سو طرح بنائی بات",
      "FullUrl": "/p149/ghazal/sh4119"
    },
    {
      "Id": 4120,
      "Title": "ہم کو ہوس جلوہ گاہ طور نہیں ہے",
      "FullUrl": "/p149/ghazal/sh4120"
    },
    {
      "Id": 4122,
      "Title": "ہے آئینہ خانے میں ترا ذوق فزا رقص",
      "FullUrl": "/p149/ghazal/sh4122"
    }
  ]
}
