  "Poems": [
    {
      "Id": 4095,
      "Title": "ظاہر میں اگرچہ یار غم خوار نہیں",
      "FullUrl": "/p149/rubai/sh4095"
    },
    {
      "Id": 4123,
      "Title": "یہ بندۂ خاکسار یعنی ناظمؔ",
      "FullUrl": "/p149/rubai/sh4123"
    },
    {
      "Id": 4124,
      "Title": "یہاں کال سے ہے طرح طرح کی تکلیف",
      "FullUrl": "/p149/rubai/sh4124"
    },
    {
      "Id": 4106,
      "Title": "وہ چشمہ دلا کہاں سے پیدا ہوگا",
      "FullUrl": "/p149/rubai/sh4106"
    },
    {
      "Id": 4079,
      "Title": "الجھے جو رقیب سے وہ کل پی کے شراب",
      "FullUrl": "/p149/rubai/sh4079"
    },
    {
      "Id": 4094,
      "Title": "صورت وہ پہلی کہ ہو مگر ماہ تمام",
      "FullUrl": "/p149/rubai/sh4094"
    },
    {
      "Id": 4093,
      "Title": "سجادہ ہے میرا فلک نیلی فام",
      "FullUrl": "/p149/rubai/sh4093"
    },
    {
      "Id": 4108,
      "Title": "پھیلا کے تصور کے اثر کو میں نے",
      "FullUrl": "/p149/rubai/sh4108"
    },
    {
      "Id": 4103,
      "Title": "ناظمؔ اسے خط میں کہتے ہو کیا لکھیے",
      "FullUrl": "/p149/rubai/sh4103"
    },
    {
      "Id": 4104,
      "Title": "ناگاہ مجھے دکھا کے تاب رخسار",
      "FullUrl": "/p149/rubai/sh4104"
    },
    {
      "Id": 4112,
      "Title": "کیا بات ہے کارساز تیری میں کون",
      "FullUrl": "/p149/rubai/sh4112"
    },
    {
      "Id": 4088,
      "Title": "جاناں کو سر مہر و وفا ہے جھوٹ سب",
      "FullUrl": "/p149/rubai/sh4088"
    },
    {
      "Id": 4077,
      "Title": "اخلاص کی دھوکے پر ہوں مائل تیرا",
      "FullUrl": "/p149/rubai/sh4077"
    },
    {
      "Id": 4121,
      "Title": "ہو ہند کا مدح خواں برس میں دو بار",
      "FullUrl": "/p149/rubai/sh4121"
    },
    {
      "Id": 4117,
      "Title": "ہر چند لطف و مہربانی پیش آئے",
      "FullUrl": "/p149/rubai/sh4117"
    },
    {
      "Id": 4115,
      "Title": "گو اس کی نہیں لطف و عنایت باقی",
      "FullUrl": "/p149/rubai/sh4115"
    },
    {
      "Id": 4116,
      "Title": "گو کچھ بھی وہ منہ سے نہیں فرماتے ہیں",
      "FullUrl": "/p149/rubai/sh4116"
    },
    {
      "Id": 4114,
      "Title": "گر کہے حلول ہے وہ اک امر قبیح",
      "FullUrl": "/p149/rubai/sh4114"
    },
    {
      "Id": 4113,
      "Title": "گر عقل و شعور کی رسائی ہوتی",
      "FullUrl": "/p149/rubai/sh4113"
    },
    {
      "Id": 4083,
      "Title": "باقی نہ رہی ہاتھ میں جب قوت و زور",
      "FullUrl": "/p149/rubai/sh4083"
    },
    {
      "Id": 4080,
      "Title": "انداز و ادا سے کچھ اگر پہچانوں",
      "FullUrl": "/p149/rubai/sh4080"
    },
    {
      "Id": 4082,
      "Title": "اے نوش لب و ماہ رخ و زہرہ جبیں",
      "FullUrl": "/p149/rubai/sh4082"
    },
    {
      "Id": 4096,
      "Title": "عاشق جو ہوا ہے تو کسی پر ناگاہ",
      "FullUrl": "/p149/rubai/sh4096"
    },
    {
      "Id": 4076,
      "Title": "آ جائے اگر حکم فلک سے ناظمؔ",
      "FullUrl": "/p149/rubai/sh4076"
    }
  ]
}
