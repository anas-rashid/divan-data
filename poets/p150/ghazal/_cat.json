    },
    {
      "Id": 4157,
      "Title": "خود اٹھ کے ہاتھ میرے گریباں میں آ گئے",
      "FullUrl": "/p150/ghazal/sh4157"
    },
    {
      "Id": 4186,
      "Title": "وسعتیں محدود ہیں ادراک انساں کے لئے",
      "FullUrl": "/p150/ghazal/sh4186"
    },
    {
      "Id": 4129,
      "Title": "اب اے بے درد کیا اس کے لئے ارشاد ہوتا ہے",
      "FullUrl": "/p150/ghazal/sh4129"
    },
    {
      "Id": 4188,
      "Title": "وہ جب رنگ پریشانی کو خلوت گیر دیکھیں گے",
      "FullUrl": "/p150/ghazal/sh4188"
    },
    {
      "Id": 4148,
      "Title": "جو انساں باریاب پردۂ اسرار ہو جائے",
      "FullUrl": "/p150/ghazal/sh4148"
    },
    {
      "Id": 4156,
      "Title": "ختم اس طرح نزاع حق و باطل ہو جائے",
