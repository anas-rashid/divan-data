  "Poems": [
    {
      "Id": 4130,
      "Title": "اب کیا بتاؤں میں ترے ملنے سے کیا ملا",
      "FullUrl": "/p150/ghazal/sh4130"
    },
    {
      "Id": 4128,
      "Title": "آنکھ سے ٹپکا جو آنسو وہ ستارا ہو گیا",
      "FullUrl": "/p150/ghazal/sh4128"
    },
    {
      "Id": 4138,
      "Title": "بقدر شوق اقرار وفا کیا",
      "FullUrl": "/p150/ghazal/sh4138"
    },
    {
      "Id": 4171,
      "Title": "شکریہ ہستی کا! لیکن تم نے یہ کیا کر دیا",
      "FullUrl": "/p150/ghazal/sh4171"
    },
    {
      "Id": 4179,
      "Title": "مرتب ہو کے اک محشر غبار دل سے نکلے گا",
      "FullUrl": "/p150/ghazal/sh4179"
    },
    {
      "Id": 4142,
      "Title": "تقدیر میں اضافۂ سوز وفا ہوا",
      "FullUrl": "/p150/ghazal/sh4142"
    },
    {
      "Id": 4162,
      "Title": "روز فراق ہر طرف اک انتشار تھا",
      "FullUrl": "/p150/ghazal/sh4162"
    },
    {
      "Id": 4195,
      "Title": "ہم ہیں سر تا بہ پا تمنا",
      "FullUrl": "/p150/ghazal/sh4195"
    },
    {
      "Id": 4147,
      "Title": "جلوہ گاہ دل میں مرتے ہی اندھیرا ہو گیا",
      "FullUrl": "/p150/ghazal/sh4147"
    },
    {
      "Id": 4143,
      "Title": "جاگ اور دیکھ ذرا عالم ویراں میرا",
      "FullUrl": "/p150/ghazal/sh4143"
    },
    {
      "Id": 4163,
      "Title": "زندان کائنات میں محصور کر دیا",
      "FullUrl": "/p150/ghazal/sh4163"
    },
    {
      "Id": 4151,
      "Title": "جو میرے تنگنائے دل میں تجھ کو جلوہ گر دیکھا",
      "FullUrl": "/p150/ghazal/sh4151"
    },
    {
      "Id": 4144,
      "Title": "جب تک غم الفت کا عنصر نہ ملا ہوگا",
      "FullUrl": "/p150/ghazal/sh4144"
    },
    {
      "Id": 4166,
      "Title": "سکوں پذیر جنون شباب ہو نہ سکا",
      "FullUrl": "/p150/ghazal/sh4166"
    },
    {
      "Id": 4174,
      "Title": "عشق خود مائل حجاب ہے آج",
      "FullUrl": "/p150/ghazal/sh4174"
    },
    {
      "Id": 4149,
      "Title": "جو سالک ہے تو اپنے نفس کا عرفان پیدا کر",
      "FullUrl": "/p150/ghazal/sh4149"
    },
    {
      "Id": 4126,
      "Title": "آ کہ ہستی بے لب و بے گوش ہے تیرے بغیر",
      "FullUrl": "/p150/ghazal/sh4126"
    },
    {
      "Id": 4177,
      "Title": "مجھے فکر و سر وفا ہے ہنوز",
      "FullUrl": "/p150/ghazal/sh4177"
    },
    {
      "Id": 4172,
      "Title": "ضبط سے نا آشنا ہم صبر سے بیگانہ ہم",
      "FullUrl": "/p150/ghazal/sh4172"
    },
    {
      "Id": 4160,
      "Title": "دل کی بساط کیا تھی نگاہ جمال میں",
      "FullUrl": "/p150/ghazal/sh4160"
    },
    {
      "Id": 4169,
      "Title": "شاید جگہ نصیب ہو اس گل کے ہار میں",
      "FullUrl": "/p150/ghazal/sh4169"
    },
    {
      "Id": 4178,
      "Title": "محفل عشق میں جب نام ترا لیتے ہیں",
      "FullUrl": "/p150/ghazal/sh4178"
    },
    {
      "Id": 4131,
      "Title": "اجازت دے کہ اپنی داستان غم بیاں کر لیں",
      "FullUrl": "/p150/ghazal/sh4131"
    },
    {
      "Id": 4150,
      "Title": "جو عمر تیری طلب میں گنوائے جاتے ہیں",
      "FullUrl": "/p150/ghazal/sh4150"
    },
    {
      "Id": 4146,
      "Title": "جس جگہ جمع ترے خاک نشیں ہوتے ہیں",
      "FullUrl": "/p150/ghazal/sh4146"
    },
    {
      "Id": 4192,
      "Title": "کھو کر تری گلی میں دل بے خبر کو میں",
      "FullUrl": "/p150/ghazal/sh4192"
    },
    {
      "Id": 4181,
      "Title": "میری رفعت پر جو حیراں ہے تو حیرانی نہیں",
      "FullUrl": "/p150/ghazal/sh4181"
    },
    {
      "Id": 4154,
      "Title": "حد ہو کوئی تو صبر ترے ہجر پر کریں",
      "FullUrl": "/p150/ghazal/sh4154"
    },
    {
      "Id": 4127,
      "Title": "آؤ پھر گرمی دیار عشق میں پیدا کریں",
      "FullUrl": "/p150/ghazal/sh4127"
    },
    {
      "Id": 4173,
      "Title": "عزم فریاد! انہیں اے دل ناشاد نہیں",
      "FullUrl": "/p150/ghazal/sh4173"
    },
    {
      "Id": 4161,
      "Title": "رسماً ہی ان کو نالۂ دل کی خبر تو ہو",
      "FullUrl": "/p150/ghazal/sh4161"
    },
    {
      "Id": 4184,
      "Title": "نسیم صبح گلشن میں گلوں سے کھیلتی ہوگی",
      "FullUrl": "/p150/ghazal/sh4184"
    },
    {
      "Id": 4197,
      "Title": "یہ کس نے شاخ گل لا کر قریب آشیاں رکھ دی",
      "FullUrl": "/p150/ghazal/sh4197"
    },
    {
      "Id": 4164,
      "Title": "سبو پر جام پر شیشے پہ پیمانے پہ کیا گزری",
      "FullUrl": "/p150/ghazal/sh4164"
    },
    {
      "Id": 4139,
      "Title": "بقید وقت یہ مژدہ سنا رہا ہے کوئی",
      "FullUrl": "/p150/ghazal/sh4139"
    },
    {
      "Id": 4133,
      "Title": "افسوس گزر گئی جوانی",
      "FullUrl": "/p150/ghazal/sh4133"
    },
    {
      "Id": 4183,
      "Title": "ناحق شکایت غم دنیا کرے کوئی",
      "FullUrl": "/p150/ghazal/sh4183"
    },
    {
      "Id": 4141,
      "Title": "بڑی دلچسپیوں سے صبح شام زندگی ہوگی",
      "FullUrl": "/p150/ghazal/sh4141"
    },
    {
      "Id": 4190,
      "Title": "چھپاتا ہوں مگر چھپتا نہیں درد نہاں پھر بھی",
      "FullUrl": "/p150/ghazal/sh4190"
    },
    {
      "Id": 4145,
      "Title": "جرس ہے کاروان اہل عالم میں فغاں میری",
      "FullUrl": "/p150/ghazal/sh4145"
    },
    {
      "Id": 4175,
      "Title": "غم مجھے حسرت مجھے وحشت مجھے سودا مجھے",
      "FullUrl": "/p150/ghazal/sh4175"
    },
    {
      "Id": 4125,
      "Title": "آ اپنے دل میں میری تمنا لیے ہوئے",
      "FullUrl": "/p150/ghazal/sh4125"
    },
    {
      "Id": 4189,
      "Title": "چمک جگنو کی برق بے اماں معلوم ہوتی ہے",
      "FullUrl": "/p150/ghazal/sh4189"
    },
    {
      "Id": 4132,
      "Title": "ادراک خود آشنا نہیں ہے",
      "FullUrl": "/p150/ghazal/sh4132"
    },
    {
      "Id": 4135,
      "Title": "بدن سے روح رخصت ہو رہی ہے",
      "FullUrl": "/p150/ghazal/sh4135"
    },
    {
      "Id": 4194,
      "Title": "ہستی کو مری مستئ پیمانہ بنا دے",
      "FullUrl": "/p150/ghazal/sh4194"
    },
    {
      "Id": 4191,
      "Title": "کمال علم و تحقیق مکمل کا یہ حاصل ہے",
      "FullUrl": "/p150/ghazal/sh4191"
    },
    {
