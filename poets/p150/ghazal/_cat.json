    },
    {
      "Id": 4185,
      "Title": "نہ وہ فریاد کا مطلب نہ منشائے فغاں سمجھے",
      "FullUrl": "/p150/ghazal/sh4185"
    },
    {
      "Id": 4159,
      "Title": "دل تیرے تغافل سے خبردار نہ ہو جائے",
      "FullUrl": "/p150/ghazal/sh4159"
    },
    {
      "Id": 4155,
      "Title": "حسن کے دل میں جگہ پاتے ہی دیوانہ بنے",
      "FullUrl": "/p150/ghazal/sh4155"
    },
    {
      "Id": 4167,
      "Title": "شام فرقت انتہائے گردش ایام ہے",
      "FullUrl": "/p150/ghazal/sh4167"
    },
    {
      "Id": 4134,
      "Title": "انجام ہر اک شے کا بجز خاک نہیں ہے",
      "FullUrl": "/p150/ghazal/sh4134"
    },
    {
      "Id": 4153,
      "Title": "جہان رنگ و بو میں مستقل تخلیق مستی ہے",
