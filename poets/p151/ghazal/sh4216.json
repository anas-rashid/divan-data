      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تھا اجل کا میں اجل کا ہو گیا\r\nبیچ میں چونکا تو تھا پھر سو گیا\r\nلطف تو یہ ہے کہ آپ اپنا نہیں\r\nجو ہوا تیرا وہ تیرا ہو گیا\r\nکاٹے کھاتی ہے مجھے ویرانگی\r\nکون اس مدفن پہ آ کر رو گیا\r\nبحر ہستی کے عمق کو کیا بتاؤں\r\nڈوب کر میں شادؔ اس میں کھو گیا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
