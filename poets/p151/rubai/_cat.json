    {
      "Id": 4200,
      "Title": "اخلاق سے جہل علم و فن سے غافل",
      "FullUrl": "/p151/rubai/sh4200"
    },
    {
      "Id": 4201,
      "Title": "ارباب قیود تجھ کو کیا دیکھیں گے",
      "FullUrl": "/p151/rubai/sh4201"
    },
    {
      "Id": 4202,
      "Title": "اس سلسلۂ شہود کو توڑ دیا",
      "FullUrl": "/p151/rubai/sh4202"
    },
    {
      "Id": 4206,
      "Title": "بدلے نہ صداقت کا نشاں ایک رہے",
      "FullUrl": "/p151/rubai/sh4206"
    },
    {
      "Id": 4207,
      "Title": "بعض اہل وطن سے اب بھی دکھ پاتا ہوں",
      "FullUrl": "/p151/rubai/sh4207"
    },
    {
      "Id": 4212,
      "Title": "تعریف بتاؤں شعر کی کیا کیا ہے",
      "FullUrl": "/p151/rubai/sh4212"
    },
    {
      "Id": 4215,
      "Title": "تنہا ہے چراغ دور پروانے ہیں",
      "FullUrl": "/p151/rubai/sh4215"
    },
    {
      "Id": 4219,
      "Title": "جس دل میں غبار ہو وہ دل صاف کہاں",
      "FullUrl": "/p151/rubai/sh4219"
    },
    {
      "Id": 4220,
      "Title": "جس وقت کا ڈر تھا وہ شباب آ پہنچا",
      "FullUrl": "/p151/rubai/sh4220"
    },
    {
      "Id": 4223,
      "Title": "جو چاہئے دیکھنا نہ دیکھا میں نے",
      "FullUrl": "/p151/rubai/sh4223"
    },
    {
      "Id": 4226,
      "Title": "حقا کہ وہ جادۂ وفا سے بھی پھرا",
      "FullUrl": "/p151/rubai/sh4226"
    },
    {
      "Id": 4229,
      "Title": "دل مورد ایذا و بلا ہوتا ہے",
      "FullUrl": "/p151/rubai/sh4229"
    },
    {
      "Id": 4230,
      "Title": "روشن ہے کہ شاد سخن آرا میں ہوں",
      "FullUrl": "/p151/rubai/sh4230"
    },
    {
      "Id": 4231,
      "Title": "ساقی کے کرم سے فیض یہ جاری ہے",
      "FullUrl": "/p151/rubai/sh4231"
    },
    {
      "Id": 4232,
      "Title": "سو طرح کا میرے لیے سامان کیا",
      "FullUrl": "/p151/rubai/sh4232"
    },
    {
      "Id": 4235,
      "Title": "شہروں میں پھرے نہ سوئے صحرا نکلے",
      "FullUrl": "/p151/rubai/sh4235"
    },
    {
      "Id": 4244,
      "Title": "مضموں میرے دل میں بے طلب آتے ہیں",
      "FullUrl": "/p151/rubai/sh4244"
    },
    {
      "Id": 4251,
      "Title": "چالاک ہیں سب کے سب بڑھتے جاتے ہیں",
      "FullUrl": "/p151/rubai/sh4251"
    },
    {
      "Id": 4262,
      "Title": "کیا مفت زاہدوں نے الزام لیا",
      "FullUrl": "/p151/rubai/sh4262"
    },
    {
      "Id": 4263,
      "Title": "کیوں بات چھپاؤں رند مے نوش ہوں میں",
      "FullUrl": "/p151/rubai/sh4263"
    },
    {
      "Id": 4264,
      "Title": "کیوں کر نہ رہے غم نہانی تیرا",
      "FullUrl": "/p151/rubai/sh4264"
    },
    {
      "Id": 4266,
      "Title": "ہادی ہوں میں کام ہے ہدایت میرا",
      "FullUrl": "/p151/rubai/sh4266"
    },
    {
      "Id": 4267,
      "Title": "ہر حال میں آبروئے فن لازم ہے",
      "FullUrl": "/p151/rubai/sh4267"
    },
    {
      "Id": 4268,
      "Title": "ہر طرح کی دل میں چاہ کر کے چھوڑے",
      "FullUrl": "/p151/rubai/sh4268"
    }
  ]
