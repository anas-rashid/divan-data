      "Id": 4336,
      "Title": "بے خودی میں عجب مزا دیکھا",
      "FullUrl": "/p154/ghazal/c419/sh4336"
    },
    {
      "Id": 4330,
      "Title": "اس دل میں اگر جلوۂ دل دار نہ ہوتا",
      "FullUrl": "/p154/ghazal/c419/sh4330"
    },
    {
      "Id": 4345,
      "Title": "مجھے ساقیٔ چشم یار نے عجب ایک جام پلا دیا",
      "FullUrl": "/p154/ghazal/c419/sh4345"
    },
    {
      "Id": 4344,
      "Title": "لشکر عشق آ پڑا ہے ملک دل پر ٹوٹ ٹوٹ",
      "FullUrl": "/p154/ghazal/c419/sh4344"
    },
    {
      "Id": 4338,
      "Title": "سن لیوے اگر تو مری دل دار کی آواز",
      "FullUrl": "/p154/ghazal/c419/sh4338"
    },
    {
      "Id": 4349,
      "Title": "ہے دل کو میرے عارض جاناں سے ارتباط",
      "FullUrl": "/p154/ghazal/c419/sh4349"
    },
    {
      "Id": 4337,
      "Title": "دستیاب اس کو ہوا جب سے ہے گلدستۂ داغ",
      "FullUrl": "/p154/ghazal/c419/sh4337"
    },
    {
      "Id": 4351,
      "Title": "ہے فنا بسم اللہ دیوان عشق",
      "FullUrl": "/p154/ghazal/c419/sh4351"
    },
    {
      "Id": 4346,
      "Title": "کوئی دم تھمتا نہیں باران اشک",
      "FullUrl": "/p154/ghazal/c419/sh4346"
    },
    {
      "Id": 4333,
      "Title": "اٹھی ہے جب سے دل میں مرے عشق کی ترنگ",
      "FullUrl": "/p154/ghazal/c419/sh4333"
    },
    {
      "Id": 4339,
      "Title": "شکل جانانہ جا بجا ہیں ہم",
      "FullUrl": "/p154/ghazal/c419/sh4339"
    },
    {
      "Id": 4347,
      "Title": "کون و مکاں میں یارو آباد ہیں تو ہم ہیں",
      "FullUrl": "/p154/ghazal/c419/sh4347"
    },
    {
      "Id": 4334,
      "Title": "بندۂ عشق ہوں جز یار مجھے کام نہیں",
      "FullUrl": "/p154/ghazal/c419/sh4334"
    },
    {
      "Id": 4348,
      "Title": "کیا کہوں تم سے میں یارو کون ہوں",
      "FullUrl": "/p154/ghazal/c419/sh4348"
    },
    {
      "Id": 4335,
      "Title": "بہ چشم حقیقت جہاں دیکھتا ہوں",
      "FullUrl": "/p154/ghazal/c419/sh4335"
    },
    {
      "Id": 4343,
      "Title": "قید دل سے ہے مری کاکل پیچاں نازاں",
      "FullUrl": "/p154/ghazal/c419/sh4343"
    },
    {
      "Id": 4340,
      "Title": "عاشق زار ہوں جز عشق مجھے کام نہیں",
      "FullUrl": "/p154/ghazal/c419/sh4340"
    },
    {
      "Id": 4350,
      "Title": "ہے عیاں روئے یار آنکھوں میں",
      "FullUrl": "/p154/ghazal/c419/sh4350"
    },
    {
      "Id": 4332,
      "Title": "افسانہ مرے دل کا دل آزار سے کہہ دو",
      "FullUrl": "/p154/ghazal/c419/sh4332"
    },
    {
      "Id": 4341,
      "Title": "عجب تو نے جلوہ دکھایا مجھے",
