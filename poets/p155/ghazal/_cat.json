  "Poems": [
    {
      "Id": 4352,
      "Title": "ان پہ رشک آتا ہے یہ لوگ ہیں قسمت والے",
      "FullUrl": "/p155/ghazal/sh4352"
    },
    {
      "Id": 4353,
      "Title": "اے صنم مجھ کو کسی سے بھی سروکار نہیں بخدا تیرے سوا",
      "FullUrl": "/p155/ghazal/sh4353"
    },
    {
      "Id": 4354,
      "Title": "ترک کی جائے گی مدت کی رفاقت کیسے",
      "FullUrl": "/p155/ghazal/sh4354"
    },
    {
      "Id": 4355,
      "Title": "تو نے خنجر مری گردن پہ نہ پھیرا اچھا",
      "FullUrl": "/p155/ghazal/sh4355"
    },
    {
      "Id": 4356,
      "Title": "جاگا وہاں نصیب عدو کا تمام رات",
      "FullUrl": "/p155/ghazal/sh4356"
    },
    {
      "Id": 4357,
      "Title": "جب یاد کیا اس نے پھر کس کی فراموشی",
      "FullUrl": "/p155/ghazal/sh4357"
    },
    {
      "Id": 4358,
      "Title": "جو بنے آئنہ وہ تیرا تماشہ دیکھے",
      "FullUrl": "/p155/ghazal/sh4358"
    },
    {
      "Id": 4359,
      "Title": "خوں کے پیاسے ہیں وہاں ابروئے خم دار جدا",
      "FullUrl": "/p155/ghazal/sh4359"
    },
    {
      "Id": 4360,
      "Title": "خیمہ ڈالے ہوئے رہرو ہے پڑا ایک سے ایک",
      "FullUrl": "/p155/ghazal/sh4360"
    },
    {
      "Id": 4361,
      "Title": "دنیا دیکھی زمانہ دیکھا",
      "FullUrl": "/p155/ghazal/sh4361"
    },
    {
      "Id": 4362,
      "Title": "رقیب جوڑ چلا تم ملال کر بیٹھے",
      "FullUrl": "/p155/ghazal/sh4362"
    },
    {
      "Id": 4363,
      "Title": "سرسری بھی ہے کارگر بھی ہے",
      "FullUrl": "/p155/ghazal/sh4363"
    },
    {
      "Id": 4364,
      "Title": "سرمہ جو زیب چشم سیہ فام ہو گیا",
      "FullUrl": "/p155/ghazal/sh4364"
    },
    {
      "Id": 4365,
      "Title": "شکل جب بس گئی آنکھوں میں تو چھپنا کیسا",
      "FullUrl": "/p155/ghazal/sh4365"
    },
    {
      "Id": 4366,
      "Title": "عاشق دعا کرے تو یہی اک دعا کرے",
      "FullUrl": "/p155/ghazal/sh4366"
    },
    {
      "Id": 4367,
      "Title": "عاشقو پاؤں نہ اکھڑے وہیں ٹھہرے رہنا",
      "FullUrl": "/p155/ghazal/sh4367"
    },
    {
      "Id": 4368,
      "Title": "مجھ سے دل آپ کا مکدر ہے",
      "FullUrl": "/p155/ghazal/sh4368"
    },
    {
      "Id": 4369,
      "Title": "محو ایسا تری صورت میں ہے شیدا تیرا",
      "FullUrl": "/p155/ghazal/sh4369"
    },
    {
      "Id": 4370,
      "Title": "موسیٰ ہیں ہمیں جلوۂ دیدار ہمیں ہیں",
      "FullUrl": "/p155/ghazal/sh4370"
    },
    {
      "Id": 4371,
      "Title": "نکلی جو روح جسم سے پھر ہے بدن میں کیا",
      "FullUrl": "/p155/ghazal/sh4371"
    },
    {
      "Id": 4372,
      "Title": "واہ کس رنگ پہ ہے رنگ بہار عارض",
      "FullUrl": "/p155/ghazal/sh4372"
    },
    {
      "Id": 4373,
      "Title": "پھونکی تپ فراق نے یہ تن بدن میں آگ",
      "FullUrl": "/p155/ghazal/sh4373"
    },
    {
      "Id": 4374,
      "Title": "ڈھونڈ لیتا جو انہیں ڈھونڈھنے والا ہوتا",
      "FullUrl": "/p155/ghazal/sh4374"
    },
    {
      "Id": 4375,
      "Title": "کس قدر دھیان ہے اے کاکل پیچاں تیرا",
      "FullUrl": "/p155/ghazal/sh4375"
    },
    {
      "Id": 4376,
      "Title": "کوئی ارمان مرے دل کا نکلنے نہ دیا",
      "FullUrl": "/p155/ghazal/sh4376"
    },
    {
      "Id": 4377,
      "Title": "ہزاروں راز نہاں ہیں دہن کے پردے میں",
      "FullUrl": "/p155/ghazal/sh4377"
    },
    {
      "Id": 4378,
      "Title": "ہوں وہ مومن جسے ایماں سے سروکار نہیں",
      "FullUrl": "/p155/ghazal/sh4378"
    }
  ]
