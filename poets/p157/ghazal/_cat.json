  "Poems": [
    {
      "Id": 4383,
      "Title": "آج یاروں کو مبارک ہو کہ صبح عید ہے",
      "FullUrl": "/p157/ghazal/sh4383"
    },
    {
      "Id": 4384,
      "Title": "آشنائی بزور نہیں ہوتی",
      "FullUrl": "/p157/ghazal/sh4384"
    },
    {
      "Id": 4385,
      "Title": "آیا ہے صبح نیند سوں اٹھ رسمسا ہوا",
      "FullUrl": "/p157/ghazal/sh4385"
    },
    {
      "Id": 4386,
      "Title": "اس زلف جاں کوں صنم کی بلا کہو",
      "FullUrl": "/p157/ghazal/sh4386"
    },
    {
      "Id": 4387,
      "Title": "اس زلف جاں گزا کوں صنم کی بلا کہو",
      "FullUrl": "/p157/ghazal/sh4387"
    },
    {
      "Id": 4388,
      "Title": "انسان ہے تو کبر سیں کہتا ہے کیوں انا",
      "FullUrl": "/p157/ghazal/sh4388"
    },
    {
      "Id": 4389,
      "Title": "اور واعظ کے ساتھ مل لے شیخ",
      "FullUrl": "/p157/ghazal/sh4389"
    },
    {
      "Id": 4390,
      "Title": "اگر انکھیوں سیں انکھیوں کو ملاؤ گے تو کیا ہوگا",
      "FullUrl": "/p157/ghazal/sh4390"
    },
    {
      "Id": 4391,
      "Title": "اگر دل عشق سیں غافل رہا ہے",
      "FullUrl": "/p157/ghazal/sh4391"
    },
    {
      "Id": 4392,
      "Title": "بڑھے ہے دن بدن تجھ مکھ کی تاب آہستہ آہستہ",
      "FullUrl": "/p157/ghazal/sh4392"
    },
    {
      "Id": 4393,
      "Title": "بہار آئی گلی کی طرح دل کھول",
      "FullUrl": "/p157/ghazal/sh4393"
    },
    {
      "Id": 4394,
      "Title": "تمہاری جب سیں آئی ہیں سجن دکھنے کو لال انکھیاں",
      "FullUrl": "/p157/ghazal/sh4394"
    },
    {
      "Id": 4395,
      "Title": "تمہارے لوگ کہتے ہیں کمر ہے",
      "FullUrl": "/p157/ghazal/sh4395"
    },
    {
      "Id": 4396,
      "Title": "تیرہ رنگوں کے ہوا حق میں یہ تپ کرنا دوا",
      "FullUrl": "/p157/ghazal/sh4396"
    },
    {
      "Id": 4397,
      "Title": "جال میں جس کے شوق آئی ہے",
      "FullUrl": "/p157/ghazal/sh4397"
    },
    {
      "Id": 4398,
      "Title": "جلتے تھے تم کوں دیکھ کے غیر انجمن میں ہم",
      "FullUrl": "/p157/ghazal/sh4398"
    },
    {
      "Id": 4399,
      "Title": "جلتے ہیں اور ہم سیں جب مانگتے ہو پیالہ",
      "FullUrl": "/p157/ghazal/sh4399"
    },
    {
      "Id": 4400,
      "Title": "حسن پر ہے خوب رویاں میں وفا کی خو نہیں",
      "FullUrl": "/p157/ghazal/sh4400"
    },
    {
      "Id": 4401,
      "Title": "خدا کے واسطے اے یار ہم سیں آ مل جا",
      "FullUrl": "/p157/ghazal/sh4401"
    },
    {
      "Id": 4402,
      "Title": "خورشید رو کے آگے ہو نور کا سوالی",
      "FullUrl": "/p157/ghazal/sh4402"
    },
    {
      "Id": 4403,
      "Title": "دشمن جاں ہے تشنۂ خوں ہے",
