    },
    {
      "Id": 4407,
      "Title": "دیکھ تو بے رحم عاشق نیں تجھے چھوڑا نہیں",
      "FullUrl": "/p157/ghazal/sh4407"
    },
    {
      "Id": 4408,
      "Title": "دیکھو تو جان تم کوں مناتے ہیں کب سیتی",
      "FullUrl": "/p157/ghazal/sh4408"
    },
    {
      "Id": 4409,
      "Title": "رتا ہے ابرواں پر ہاتھ اکثر لاوبالی کا",
      "FullUrl": "/p157/ghazal/sh4409"
    },
    {
      "Id": 4410,
      "Title": "رکھے کوئی اس طرح کے لالچی کو کب تلک بہلا",
      "FullUrl": "/p157/ghazal/sh4410"
    },
    {
      "Id": 4411,
      "Title": "زندگانی سراب کی سی طرح",
      "FullUrl": "/p157/ghazal/sh4411"
    },
    {
      "Id": 4412,
      "Title": "سانپ سر مار اگر جو جاوے مر",
