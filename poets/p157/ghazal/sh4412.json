      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "سانپ سر مار اگر جو جاوے مر\r\nنہ کرے زلف کے تری سر بر\r\nنام لیلیٰ کا دم بدم لے لے\r\nمارتا ہے جنگل میں مجنوں بڑ\r\nعاشقاں دیکھ تیری سنگ دلی\r\nجان دیتے ہیں دم بدم مر مر\r\nآبروؔ جیو ڈوب جاتا ہے\r\nبے خودی کی جب آوتی ہے لہر",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
