      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "طوفاں ہے شیخ قہریا ہے\r\nجو حرف ہے تس کے تہریا ہے\r\nدل کیوں نہ بھنور ہو آج میرا\r\nچیرا ترے سر پے لہریا ہے\r\nتجھ حسن کے باغ میں سریجن\r\nخورشید گل دوپہریا ہے\r\nاب دین ہوا زمانہ سازی\r\nآفاق تمام دہریا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
