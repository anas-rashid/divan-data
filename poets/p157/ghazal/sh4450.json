      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ہے ہمن کا شام کوئی لے جا\r\nکہ مجھے آ کے ٹک درس دے جا\r\nبو الہوس کوں ہوا ہے تب سیں مغز\r\nجب سیں تم نے اسے بلا بھیجا\r\nتم سوا ہم کوں اور جاگہ نہیں\r\nاے سجن ہم سیں مت لڑو بے جا\r\nآبروؔ چاہتا ہے تو مت اڑ\r\nبو الہوس اس گلی سیں سن بے جا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
