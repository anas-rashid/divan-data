  "Poems": [
    {
      "Id": 4457,
      "Title": "ادھر ابر لے چشم نم کو چلا",
      "FullUrl": "/p158/ghazal/sh4457"
    },
    {
      "Id": 4458,
      "Title": "اس دل کو ہمکنار کیا ہم نے کیا کیا",
      "FullUrl": "/p158/ghazal/sh4458"
    },
    {
      "Id": 4459,
      "Title": "اس کاکل پر خم کا خلل جائے تو اچھا",
      "FullUrl": "/p158/ghazal/sh4459"
    },
    {
      "Id": 4460,
      "Title": "اٹھتی گھٹا ہے کس طرح بولے وہ زلف اٹھا کہ یوں",
      "FullUrl": "/p158/ghazal/sh4460"
    },
    {
      "Id": 4461,
      "Title": "اک قافلہ ہے بن ترے ہمراہ سفر میں",
      "FullUrl": "/p158/ghazal/sh4461"
    },
    {
      "Id": 4462,
      "Title": "بادہ کشی کے سکھلاتے ہیں کیا ہی قرینے ساون بھادوں",
      "FullUrl": "/p158/ghazal/sh4462"
    },
    {
      "Id": 4463,
      "Title": "بعد مجنوں کیوں نہ ہوں میں کار فرمائے جنوں",
      "FullUrl": "/p158/ghazal/sh4463"
    },
    {
      "Id": 4464,
      "Title": "بیاباں مرگ ہے مجنون خاک آلودہ تن کس کا",
      "FullUrl": "/p158/ghazal/sh4464"
    },
    {
      "Id": 4465,
      "Title": "بے سبب ہاتھ کٹاری کو لگانا کیا تھا",
      "FullUrl": "/p158/ghazal/sh4465"
    },
    {
      "Id": 4466,
      "Title": "بے مہر و وفا ہے وہ دل آرام ہمارا",
      "FullUrl": "/p158/ghazal/sh4466"
    },
    {
      "Id": 4467,
      "Title": "ترے دانت سارے سفید ہیں پئے زیب پان سے مل کر آ",
      "FullUrl": "/p158/ghazal/sh4467"
    },
    {
      "Id": 4468,
      "Title": "ترے ہے زلف و رخ کی دید صبح و شام عاشق کا",
      "FullUrl": "/p158/ghazal/sh4468"
    },
    {
      "Id": 4469,
      "Title": "تو ضد سے شب وصل نہ آیا تو ہوا کیا",
      "FullUrl": "/p158/ghazal/sh4469"
    },
    {
      "Id": 4470,
      "Title": "جب تلک چرب نہ جوں شمع زباں کیجئے گا",
      "FullUrl": "/p158/ghazal/sh4470"
    },
    {
      "Id": 4471,
      "Title": "جدا نہیں ہے ہر اک موج دیکھ آب کے بیچ",
      "FullUrl": "/p158/ghazal/sh4471"
    },
    {
      "Id": 4472,
      "Title": "جسم اس کے غم میں زرد از ناتوانی ہو گیا",
      "FullUrl": "/p158/ghazal/sh4472"
    },
    {
      "Id": 4473,
      "Title": "جو رقیبوں نے کہا تو وہی بد ظن سمجھا",
      "FullUrl": "/p158/ghazal/sh4473"
    },
    {
      "Id": 4474,
      "Title": "جو عین وصل میں آرام سے نہیں واقف",
      "FullUrl": "/p158/ghazal/sh4474"
    },
    {
      "Id": 4475,
      "Title": "جو گزرے ہے بر عاشق کامل نہیں معلوم",
      "FullUrl": "/p158/ghazal/sh4475"
    },
    {
      "Id": 4476,
      "Title": "جوں ذرہ نہیں ایک جگہ خاک نشیں ہم",
      "FullUrl": "/p158/ghazal/sh4476"
    },
    {
      "Id": 4477,
      "Title": "جگر کا جوں شمع کاش یارب ہو داغ روشن مراد حاصل",
      "FullUrl": "/p158/ghazal/sh4477"
    },
    {
      "Id": 4478,
      "Title": "حرم کو شیخ مت جا ہے بت دل خواہ صورت میں",
      "FullUrl": "/p158/ghazal/sh4478"
    },
    {
      "Id": 4479,
      "Title": "خال رخ اس نے دکھایا نہ دوبارا اپنا",
      "FullUrl": "/p158/ghazal/sh4479"
    },
    {
      "Id": 4480,
      "Title": "خال مشاطہ بنا کاجل کا چشم یار پر",
      "FullUrl": "/p158/ghazal/sh4480"
    },
    {
      "Id": 4481,
      "Title": "خاندان قیس کا میں تو سدا سے پیر ہوں",
      "FullUrl": "/p158/ghazal/sh4481"
    },
    {
      "Id": 4482,
      "Title": "خدا کے واسطے چہرے سے ٹک نقاب اٹھا",
      "FullUrl": "/p158/ghazal/sh4482"
    },
    {
      "Id": 4483,
      "Title": "دل جلوہ گاہ صورت جانانہ ہو گیا",
      "FullUrl": "/p158/ghazal/sh4483"
    },
    {
      "Id": 4484,
      "Title": "دل عشق خوش قداں میں جو خواہان نالہ تھا",
      "FullUrl": "/p158/ghazal/sh4484"
    },
    {
      "Id": 4485,
      "Title": "دل میں ہے کیا جانئے کس کا خیال نقش پا",
      "FullUrl": "/p158/ghazal/sh4485"
    },
    {
      "Id": 4486,
      "Title": "دل کو کس صورت سے کیجے چشم دلبر سے جدا",
      "FullUrl": "/p158/ghazal/sh4486"
    },
    {
      "Id": 4487,
      "Title": "دم لے اے کوہ کن اب تیشہ زنی خوب نہیں",
      "FullUrl": "/p158/ghazal/sh4487"
    },
    {
      "Id": 4488,
      "Title": "دکھا دو گر مانگ اپنی شب کو تو حشر برپا ہو کہکشاں پر",
      "FullUrl": "/p158/ghazal/sh4488"
    },
    {
      "Id": 4489,
      "Title": "دیکھ تو یار بادہ کش! میں نے بھی کام کیا کیا",
      "FullUrl": "/p158/ghazal/sh4489"
    },
    {
      "Id": 4490,
      "Title": "رنگ میلا نہ ہوا جامۂ عریانی کا",
      "FullUrl": "/p158/ghazal/sh4490"
    },
    {
      "Id": 4491,
      "Title": "زلف چھٹتی ترے رخ پر تو دل اپنا پھرتا",
      "FullUrl": "/p158/ghazal/sh4491"
    },
    {
      "Id": 4492,
      "Title": "زلف کا کیا اس کی چٹکا لگ گیا",
      "FullUrl": "/p158/ghazal/sh4492"
    },
    {
      "Id": 4493,
      "Title": "سدا ہے اس آہ و چشم تر سے فلک پہ بجلی زمیں پہ باراں",
      "FullUrl": "/p158/ghazal/sh4493"
    },
    {
      "Id": 4494,
      "Title": "سرزمین زلف میں کیا دل ٹھکانے لگ گیا",
      "FullUrl": "/p158/ghazal/sh4494"
    },
    {
      "Id": 4495,
      "Title": "شب جو رخ پر خال سے وہ برقعہ کو اتارے سوتے ہیں",
      "FullUrl": "/p158/ghazal/sh4495"
    },
    {
      "Id": 4496,
      "Title": "شمیم زلف معنبر جو روئے یار سے لوں",
      "FullUrl": "/p158/ghazal/sh4496"
    },
    {
      "Id": 4497,
      "Title": "صبح گلشن میں ہو گر وہ گل خنداں پیدا",
      "FullUrl": "/p158/ghazal/sh4497"
    },
    {
      "Id": 4498,
      "Title": "طلب میں بوسے کی کیا ہے حجت سوال دیگر جواب دیگر",
      "FullUrl": "/p158/ghazal/sh4498"
    },
    {
      "Id": 4499,
      "Title": "غرق نہ کر دکھلا کر دل کو کان کا بالا زلف کا حلقہ",
      "FullUrl": "/p158/ghazal/sh4499"
    },
    {
      "Id": 4500,
      "Title": "فرصت ایک دم کی ہے جوں حباب پانی یاں",
      "FullUrl": "/p158/ghazal/sh4500"
    },
    {
      "Id": 4501,
      "Title": "قدم نہ رکھ مری چشم پرآب کے گھر میں",
      "FullUrl": "/p158/ghazal/sh4501"
    },
    {
      "Id": 4502,
      "Title": "لگا جب عکس ابرو دیکھنے دل دار پانی میں",
      "FullUrl": "/p158/ghazal/sh4502"
    },
    {
      "Id": 4503,
      "Title": "لیا نہ ہاتھ سے جس نے سلام عاشق کا",
      "FullUrl": "/p158/ghazal/sh4503"
    },
    {
      "Id": 4504,
      "Title": "مل بیٹھنے یہ دے ہے فلک ایک دم کہاں",
      "FullUrl": "/p158/ghazal/sh4504"
    },
    {
      "Id": 4505,
      "Title": "میری تربت پر چڑھانے ڈھونڈتا ہے کس کے پھول",
      "FullUrl": "/p158/ghazal/sh4505"
    },
    {
      "Id": 4506,
      "Title": "میں ضعف سے جوں نقش قدم اٹھ نہیں سکتا",
      "FullUrl": "/p158/ghazal/sh4506"
    },
    {
      "Id": 4507,
      "Title": "میں نے بٹھلا کے جو پاس اس کو کھلایا بیڑا",
      "FullUrl": "/p158/ghazal/sh4507"
    },
    {
      "Id": 4508,
      "Title": "نکہت گل ہیں یا صبا ہیں ہم",
      "FullUrl": "/p158/ghazal/sh4508"
    },
    {
      "Id": 4509,
      "Title": "نہ دکھائیو ہجر کا درد و الم تجھے دیتا ہوں چرخ خدا کی قسم",
      "FullUrl": "/p158/ghazal/sh4509"
    },
    {
      "Id": 4510,
      "Title": "نہ ذکر آشنا نے قصۂ بیگانہ رکھتے ہیں",
      "FullUrl": "/p158/ghazal/sh4510"
    },
    {
      "Id": 4511,
      "Title": "نہ کیوں کہ اشک مسلسل ہو رہنما دل کا",
      "FullUrl": "/p158/ghazal/sh4511"
    },
    {
      "Id": 4512,
      "Title": "واں کمر باندھے ہیں مژگاں قتل پر دونوں طرف",
      "FullUrl": "/p158/ghazal/sh4512"
    },
    {
      "Id": 4513,
      "Title": "ٹانکوں سے زخم پہلو لگتا ہے کنکھجورا",
      "FullUrl": "/p158/ghazal/sh4513"
    },
    {
      "Id": 4514,
      "Title": "پامال راہ عشق ہیں خلقت کی کھا ٹھوکر بھی ہم",
      "FullUrl": "/p158/ghazal/sh4514"
    },
    {
      "Id": 4515,
      "Title": "چشم میں کب اشک بھر لاتے ہیں ہم",
      "FullUrl": "/p158/ghazal/sh4515"
    },
    {
      "Id": 4516,
      "Title": "چھوڑا نہ تجھے نے رام کیا یہ بھی نہ ہوا وہ بھی نہ ہوا",
      "FullUrl": "/p158/ghazal/sh4516"
    },
    {
      "Id": 4517,
      "Title": "کبھو نہ اس رخ روشن پہ چھائیاں دیکھیں",
      "FullUrl": "/p158/ghazal/sh4517"
    },
    {
      "Id": 4518,
      "Title": "کر کے آزاد ہر اک شہپر بلبل کترا",
      "FullUrl": "/p158/ghazal/sh4518"
    },
    {
      "Id": 4519,
      "Title": "کچھ سرگزشت کہہ نہ سکے روبرو قلم",
      "FullUrl": "/p158/ghazal/sh4519"
    },
    {
      "Id": 4520,
      "Title": "کیوں نہ کہیں بشر کو ہم آتش و آب و خاک و باد",
      "FullUrl": "/p158/ghazal/sh4520"
    },
    {
      "Id": 4521,
      "Title": "گو سیہ بخت ہوں پر یار لبھا لیتا ہے",
      "FullUrl": "/p158/ghazal/sh4521"
    },
    {
      "Id": 4522,
      "Title": "ہاتھوں کو اٹھا جان سے آخر کو رہوں گا",
      "FullUrl": "/p158/ghazal/sh4522"
    },
    {
      "Id": 4523,
      "Title": "ہار بنا ان پارۂ دل کا مانگ نہ گجرا پھولوں کا",
      "FullUrl": "/p158/ghazal/sh4523"
    },
    {
      "Id": 4524,
      "Title": "ہم پھڑک کر توڑتے ساری قفس کی تیلیاں",
      "FullUrl": "/p158/ghazal/sh4524"
    },
    {
      "Id": 4525,
      "Title": "ہو چکی باغ میں بہار افسوس",
      "FullUrl": "/p158/ghazal/sh4525"
    },
    {
      "Id": 4526,
      "Title": "ہوا اشک گلگوں بہار گریباں",
      "FullUrl": "/p158/ghazal/sh4526"
    },
    {
      "Id": 4527,
      "Title": "یارو نہیں اتنا مجھے قاتل نے ستایا",
      "FullUrl": "/p158/ghazal/sh4527"
    },
    {
      "Id": 4528,
      "Title": "یاں سے دیں گے نہ تم کو جانے آج",
      "FullUrl": "/p158/ghazal/sh4528"
    }
  ]
