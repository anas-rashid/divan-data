      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ہم کو یاں در در پھرایا یار نے\r\nلا مکاں میں گھر بنایا یار نے\r\nآپ اپنے دیکھنے کے واسطے\r\nہم کو آئینہ بنایا یار نے\r\nاپنے اک ادنیٰ تماشے کے لئے\r\nہم کو سولی پر چڑھایا یار نے\r\nآپ چھپ کے ہم کو کر کے روبرو\r\nخوب ہی رسوا کرایا یار نے\r\nآپ تو بت بن کے کی جلوہ گری\r\nاور ہمیں کافر بنایا یار نے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 5
    }
