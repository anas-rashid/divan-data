      "Title": "آفتاب آئے چمک کر جو سر جام شراب",
      "FullUrl": "/p16/ghazal/sh255"
    },
    {
      "Id": 261,
      "Title": "جنبش میں زلف پر شکن ایک اس طرف ایک اس طرف",
      "FullUrl": "/p16/ghazal/sh261"
    },
    {
      "Id": 262,
      "Title": "روئے تاباں مانگ موئے سر دھواں بتی چراغ",
      "FullUrl": "/p16/ghazal/sh262"
    },
    {
      "Id": 263,
      "Title": "زمزمہ نالۂ بلبل ٹھہرے",
      "FullUrl": "/p16/ghazal/sh263"
    },
    {
      "Id": 264,
      "Title": "سمجھ کے حور بڑے ناز سے لگائی چوٹ",
      "FullUrl": "/p16/ghazal/sh264"
    },
    {
      "Id": 265,
      "Title": "شب ماہ میں جو پلنگ پر مرے ساتھ سوئے تو کیا ہوئے",
      "FullUrl": "/p16/ghazal/sh265"
    },
    {
      "Id": 267,
      "Title": "قبلۂ آب و گل تمہیں تو ہو",
      "FullUrl": "/p16/ghazal/sh267"
    },
    {
      "Id": 269,
      "Title": "محشر میں چلتے چلتے کروں گا ادا نماز",
      "FullUrl": "/p16/ghazal/sh269"
    },
    {
      "Id": 272,
      "Title": "میں ہی مطلوب خود ہوں تو ہے عبث",
      "FullUrl": "/p16/ghazal/sh272"
    },
    {
      "Id": 274,
      "Title": "نکلی جو روح ہو گئے اجزائے‌ تن خراب",
      "FullUrl": "/p16/ghazal/sh274"
    },
    {
      "Id": 275,
      "Title": "وہ بت پری ہے نکالیں نہ بال و پر تعویذ",
      "FullUrl": "/p16/ghazal/sh275"
    },
    {
      "Id": 276,
      "Title": "وہ پارہ ہوں میں جو آگ میں ہوں وہ برق ہوں جو سحاب میں ہوں",
      "FullUrl": "/p16/ghazal/sh276"
    },
    {
      "Id": 277,
      "Title": "پیار اپنے پہ جو آتا ہے تو کیا کرتے ہیں",
      "FullUrl": "/p16/ghazal/sh277"
    },
    {
      "Id": 280,
      "Title": "چوری سے دو گھڑی جو نظارے ہوئے تو کیا",
      "FullUrl": "/p16/ghazal/sh280"
    },
    {
      "Id": 281,
      "Title": "کوئی حسین ہے مختار کار خانۂ عشق",
      "FullUrl": "/p16/ghazal/sh281"
    },
    {
      "Id": 283,
      "Title": "کھڑے ہیں موسیٰ اٹھاؤ پردا دکھاؤ تم آب و تاب عارض",
      "FullUrl": "/p16/ghazal/sh283"
    },
    {
      "Id": 285,
      "Title": "کیا روز حشر دوں تجھے اے داد گر جواب",
      "FullUrl": "/p16/ghazal/sh285"
    },
    {
      "Id": 286,
      "Title": "کیوں شوق بڑھ گیا رمضاں میں سنگار کا",
      "FullUrl": "/p16/ghazal/sh286"
    },
    {
      "Id": 288,
      "Title": "ہو گئے مضطر دیکھتے ہی وہ ہلتی زلفیں پھرتی نظر ہم",
      "FullUrl": "/p16/ghazal/sh288"
    }
  ]
