      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "خداوند کہ این اشیا چگونہ است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "کہ درچشم تو اکنون باژگونہ است",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "ہرچیز کہ پیداست، نمودست نہ بود",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "بعد ست کبود ییکہ بینی، نہ سما",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "نیست را بنمود ہست آن محتمم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "ہست رابنمود بر شکل عدم",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "بحر را پوشید وکف کرد آشکار",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "باد را پوشیدو بنمودت غبار",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "چوں منارہ، خاک ِپیچاں در ہوا",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "خاک از خود چوں برآید برعلا",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "خاک را بینی بہ بالا ای علیل",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "باد رانہ، جز بہ تعریف و دلیل",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "کف ہمی بینی روانہ ہرطرف",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "کف پی دریا نہ دارد منصرف",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "کف بہ حس بینی و دریا از دلیل",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "فکر پنہاں، آشکار اقال و قیل",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "نفی را اثبات می پندا شیتم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "دیدہ معدوم بینی داشتیم",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "این عدم را چوں نشانداندر نظر",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "چون نہاں کرد آں حقیقت او بصر",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "ایں جہان نیست بس ہستاں شدہ",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "واں جہان ہست بس پنہاں شدہ",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "رہ روان راخستگی راہ نیست",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "عشق خود راہ است و ہم خود منزل است",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "ہمچو آں ابلہ کہ تاب آفتاب",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "دید بر دیوار وحیران شد شتاب",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "عاشق دیوار رشد کا یں باضیافت",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "بے خبر کایں عکس خورشید سماست",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "چوں بہ اصل خویش پیوست آں ضیا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "دید دیوار سیہ ماندہ بہ جا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Right",
      "Text": "اوبماندہ دوراز مطلوب خویش",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Left",
      "Text": "سعی ضائع، رنج باطل پای ریش",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Right",
      "Text": "گرچہ آہن سرخ شد، او سرخ نیست",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Left",
      "Text": "پر تو عاریت آتش زنیست",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Right",
      "Text": "گرشود پرنور روزن یا سرا",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Left",
      "Text": "تو مدان روشن، مگر خورشید را",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Right",
      "Text": "ورد ددیوار گوید رو شنم",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Left",
      "Text": "پر توِ غیری ندارم، ایں منم",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Right",
      "Text": "پس بگوید آفتاب ای نارشید",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Left",
      "Text": "چونکہ من عائب شوم آید پدید",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Right",
      "Text": "سبز ہا گویند ما سبزاز خودیم",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Left",
      "Text": "شادو خندانیم وبس زیبا خدیم",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "فصل تابستان بگوید ای امم",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "خویش رابینید چوں من بگزرم",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "تن ہمی ناز دبہ خوبی وجمال",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "روح پنہاں کردہ فر پرو بال",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "گویدش، ای مزبلہ تو کیستی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "یک دو روز از پرتوِمن زیستی",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "غنج ونازت می نہ گنجددر جہاں",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "باش کہ تامن شوم از تونہاں",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "پر توروح ست نطق چشم وگوش",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "پرتو آتش بود درآب جوش",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "آں شعاعی بود بر دیوار شان",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "جانب خورشید وارفت آں نشان",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "بر ہر آں چیزی کہ افتد آں شعاع",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "تو برآں ہم عاشق آئی اے شجاع",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "عشق تو بر ہرچہ آں موجود بود",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "آں زوصف حق چوز راندود بود",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "چوں زری با اصل رفت و مس بماند",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "از زری خویشتن مفلس بماند",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "طبع سیر آمد طلاق او بخواند",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "پشت بروی کردو دست از وی فشاند",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "از زراندود صفاتش پا بکش",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "از جہالت قلب را کم گوی خوش",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "کان خوشی در قلب ہا عاریتی ست",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "زیر زینت مایہ بی زینتی ست",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "زر زروی قلب درکان می رود",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "سوی آں کان تو برو، کان میرود",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "نو راز دیوار تا خور می رود",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "تو بدان خور روکہ در خورمی رود",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "زاں سپس بستان تو آب آز آسماں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "چوں ندیدی تو وفادر ناوداں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "ابر را تابی اگرہست از مہ است",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "ہر کہ مہ خواند ابر را او گمرہ است",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "نور مہ برابر چوں منزل شدہ است",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "روی تاریکش زمہ مبدل شدہ است",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "گرچہ ہمرنگ مہ است و دولت ست",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "اندر ابرآں نورمہ عاریت ست",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "دایہ عاریت بود روزی دوچار",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "مادرا! مارا تو گیر اندر کنار",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "من نخواہم دایہ، مادر خوش تر است",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "موسیم من، دایہ من مادر است",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "من نخواہم لطف حق از واسطہ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "کہ ہلاک خلق شد ایں رابطہ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    }
  ]
}
