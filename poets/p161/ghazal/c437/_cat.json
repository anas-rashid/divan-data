  "Poems": [
    {
      "Id": 4557,
      "Title": "تڑپ کے لوٹ کے آنسو بہا کے دیکھ لیا",
      "FullUrl": "/p161/ghazal/c437/sh4557",
      "RadifLetter": "ا"
    },
    {
      "Id": 4561,
      "Title": "ظرف تو دیکھیے میرے دل شیدائی کا",
      "FullUrl": "/p161/ghazal/c437/sh4561",
      "RadifLetter": "ا"
    },
    {
      "Id": 4558,
      "Title": "دل کو یوں لے جانے والا کون تھا",
      "FullUrl": "/p161/ghazal/c437/sh4558",
      "RadifLetter": "ا"
    },
    {
      "Id": 4567,
      "Title": "گریباں چاک مجنوں بن سے نکلا",
      "FullUrl": "/p161/ghazal/c437/sh4567",
      "RadifLetter": "ا"
    },
    {
      "Id": 4553,
      "Title": "آنکھوں کو سوجھتا ہی نہیں کچھ سوائے دوست",
      "FullUrl": "/p161/ghazal/c437/sh4553",
      "RadifLetter": "ت"
    },
    {
      "Id": 4568,
      "Title": "ہر جفا ان کی ہوئی ہم کو وفا سے بڑھ کر",
      "FullUrl": "/p161/ghazal/c437/sh4568",
      "RadifLetter": "ر"
    },
    {
      "Id": 4555,
      "Title": "اک خلق جو ہر سمت سے آئی ترے در پر",
      "FullUrl": "/p161/ghazal/c437/sh4555",
      "RadifLetter": "ر"
    },
    {
      "Id": 4563,
      "Title": "پڑیں یہ کس کے جلوے پر نگاہیں",
      "FullUrl": "/p161/ghazal/c437/sh4563",
      "RadifLetter": "ن"
    },
    {
      "Id": 4559,
      "Title": "دیکھ لو اک نظر میں کچھ بھی نہیں",
      "FullUrl": "/p161/ghazal/c437/sh4559",
      "RadifLetter": "ن"
    },
    {
      "Id": 4564,
      "Title": "چھوڑ کر مجھ کو چلی اے بے وفا میں بھی تو ہوں",
      "FullUrl": "/p161/ghazal/c437/sh4564",
      "RadifLetter": "ن"
    },
    {
      "Id": 4569,
      "Title": "ہے جو رنگ اس کی جلوہ گاہوں میں",
      "FullUrl": "/p161/ghazal/c437/sh4569",
      "RadifLetter": "ن"
    },
    {
      "Id": 4556,
      "Title": "تم نے پوچھا نہیں کبھی ہم کو",
      "FullUrl": "/p161/ghazal/c437/sh4556",
      "RadifLetter": "و"
    },
    {
      "Id": 4554,
      "Title": "اس نے مانگا جو دل دیے ہی بنی",
      "FullUrl": "/p161/ghazal/c437/sh4554",
      "RadifLetter": "ی"
    },
    {
      "Id": 4562,
      "Title": "نہ پوچھو شب وصل کیا ہو رہا ہے",
      "FullUrl": "/p161/ghazal/c437/sh4562",
      "RadifLetter": "ے"
    },
    {
      "Id": 4560,
      "Title": "روک دے موت کو بھی آنے سے",
      "FullUrl": "/p161/ghazal/c437/sh4560",
      "RadifLetter": "ے"
    },
    {
      "Id": 4566,
      "Title": "کیوں دیکھتے ہی نقش بہ دیوار بن گئے",
      "FullUrl": "/p161/ghazal/c437/sh4566",
      "RadifLetter": "ے"
    },
    {
      "Id": 4565,
      "Title": "کیا بتائیں تمہیں کہاں دل ہے",
      "FullUrl": "/p161/ghazal/c437/sh4565",
      "RadifLetter": "ے"
    }
  ]
}
