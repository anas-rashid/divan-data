      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کیا بتائیں تمہیں کہاں دل ہے\r\nرونگٹا رونگٹا یہاں دل ہے\r\nلے چکے دل تو ہنس کے فرمایا\r\nکہئے اب آج کل کہاں دل ہے\r\nایک غنچہ ہے دیکھنے میں مگر\r\nغور کیجئے تو گلستاں دل ہے\r\nہے وہ ناوک فگن شرف جس کے\r\nناوک آہ کی کماں دل ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
