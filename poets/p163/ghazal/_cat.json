  "Poems": [
    {
      "Id": 4571,
      "Title": "ابرو ہے کعبہ آج سے یہ نام رکھ دیا",
      "FullUrl": "/p163/ghazal/sh4571"
    },
    {
      "Id": 4572,
      "Title": "بھاگے اچھی شکلوں والے عشق ہے گویا کام برا",
      "FullUrl": "/p163/ghazal/sh4572"
    },
    {
      "Id": 4573,
      "Title": "تھا بند وہ در پھر بھی میں سو بار گیا تھا",
      "FullUrl": "/p163/ghazal/sh4573"
    },
    {
      "Id": 4574,
      "Title": "تیری سی بھی آفت کوئی اے سوزش تب ہے",
      "FullUrl": "/p163/ghazal/sh4574"
    },
    {
      "Id": 4575,
      "Title": "جفا پہ شکر کا امیدوار کیوں آیا",
      "FullUrl": "/p163/ghazal/sh4575"
    },
    {
      "Id": 4576,
      "Title": "دل مرا ٹوٹا تو اس کو کچھ ملال آ ہی گیا",
      "FullUrl": "/p163/ghazal/sh4576"
    },
    {
      "Id": 4577,
      "Title": "دل کھوٹا ہے ہم کو اس سے راز عشق نہ کہنا تھا",
      "FullUrl": "/p163/ghazal/sh4577"
    },
    {
      "Id": 4578,
      "Title": "روح کو آج ناز ہے اپنا وقار دیکھ کر",
      "FullUrl": "/p163/ghazal/sh4578"
    },
    {
      "Id": 4579,
      "Title": "فریاد اور تجھ کو ستم گر کہے بغیر",
      "FullUrl": "/p163/ghazal/sh4579"
    },
    {
      "Id": 4580,
      "Title": "لب چپ ہیں تو کیا دل گلہ پرداز نہیں ہے",
      "FullUrl": "/p163/ghazal/sh4580"
    },
    {
      "Id": 4581,
      "Title": "مارے غصے کے غضب کی تاب رخساروں میں ہے",
      "FullUrl": "/p163/ghazal/sh4581"
    },
    {
      "Id": 4582,
      "Title": "وہ لے کے دل کو یہ سوچی کہیں جگر بھی ہے",
      "FullUrl": "/p163/ghazal/sh4582"
    },
    {
      "Id": 4583,
      "Title": "ہوئی یا مجھ سے نفرت یا کچھ اس میں کبر و ناز آیا",
      "FullUrl": "/p163/ghazal/sh4583"
    }
  ]
}
