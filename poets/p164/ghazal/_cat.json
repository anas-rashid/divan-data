  "Title": "غزل",
  "FullUrl": "/p164/ghazal",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 4584,
      "Title": "آ کے پتھر تو مرے صحن میں دو چار گرے",
      "FullUrl": "/p164/ghazal/sh4584"
    },
    {
      "Id": 4585,
      "Title": "آگ کے درمیان سے نکلا",
      "FullUrl": "/p164/ghazal/sh4585"
    },
    {
      "Id": 4586,
      "Title": "آیا ہے ہر چڑھائی کے بعد اک اتار بھی",
      "FullUrl": "/p164/ghazal/sh4586"
    },
    {
      "Id": 4587,
      "Title": "اب آپ رہ دل جو کشادہ نہیں رکھتے",
      "FullUrl": "/p164/ghazal/sh4587"
    },
    {
      "Id": 4588,
      "Title": "اس بت کدے میں تو جو حسیں تر لگا مجھے",
      "FullUrl": "/p164/ghazal/sh4588"
    },
    {
      "Id": 4589,
      "Title": "اس خاکداں میں اب تک باقی ہیں کچھ شرر سے",
      "FullUrl": "/p164/ghazal/sh4589"
    },
    {
      "Id": 4592,
      "Title": "بجھے بجھے سے شرارے مجھے قبول نہیں",
      "FullUrl": "/p164/ghazal/sh4592"
    },
    {
      "Id": 4593,
      "Title": "بد قسمتی کو یہ بھی گوارا نہ ہو سکا",
      "FullUrl": "/p164/ghazal/sh4593"
    },
    {
      "Id": 4594,
      "Title": "بس اک شعاع نور سے سایہ سمٹ گیا",
      "FullUrl": "/p164/ghazal/sh4594"
    },
    {
      "Id": 4595,
      "Title": "بے جا نوازشات کا بار گراں نہیں",
      "FullUrl": "/p164/ghazal/sh4595"
    },
    {
      "Id": 4596,
      "Title": "تو نے کیا کیا نہ اے زندگی دشت و در میں پھرایا مجھے",
      "FullUrl": "/p164/ghazal/sh4596"
    },
    {
      "Id": 4597,
      "Title": "جاتی ہے دھوپ اجلے پروں کو سمیٹ کے",
      "FullUrl": "/p164/ghazal/sh4597"
    },
    {
      "Id": 4598,
      "Title": "جب تک غم جہاں کے حوالے ہوئے نہیں",
      "FullUrl": "/p164/ghazal/sh4598"
    },
    {
      "Id": 4599,
      "Title": "جس دم قفس میں موسم گل کی خبر گئی",
      "FullUrl": "/p164/ghazal/sh4599"
    },
    {
      "Id": 4601,
      "Title": "جہاں تلک بھی یہ صحرا دکھائی دیتا ہے",
      "FullUrl": "/p164/ghazal/sh4601"
    },
    {
      "Id": 4603,
      "Title": "خرد فریب نظاروں کی کوئی بات کرو",
      "FullUrl": "/p164/ghazal/sh4603"
    },
    {
      "Id": 4604,
      "Title": "خزاں کے چاند نے پوچھا یہ جھک کے کھڑکی میں",
      "FullUrl": "/p164/ghazal/sh4604"
    },
    {
      "Id": 4605,
      "Title": "خموشی بول اٹھے ہر نظر پیغام ہو جائے",
      "FullUrl": "/p164/ghazal/sh4605"
    },
    {
      "Id": 4606,
      "Title": "خواب گل رنگ کے انجام پہ رونا آیا",
      "FullUrl": "/p164/ghazal/sh4606"
    },
    {
      "Id": 4607,
      "Title": "درد کے موسم کا کیا ہوگا اثر انجان پر",
      "FullUrl": "/p164/ghazal/sh4607"
    },
    {
      "Id": 4608,
      "Title": "دشت و صحرا اگر بسائے ہیں",
      "FullUrl": "/p164/ghazal/sh4608"
    },
    {
      "Id": 4610,
      "Title": "دل کے ویرانے میں اک پھول کھلا رہتا ہے",
      "FullUrl": "/p164/ghazal/sh4610"
    },
    {
      "Id": 4611,
      "Title": "دنیا والوں نے چاہت کا مجھ کو صلہ انمول دیا",
      "FullUrl": "/p164/ghazal/sh4611"
    },
    {
      "Id": 4612,
      "Title": "دوستی کا فریب ہی کھائیں",
      "FullUrl": "/p164/ghazal/sh4612"
    },
    {
      "Id": 4614,
      "Title": "رخسار آج دھو کر شبنم نے پنکھڑی کے",
      "FullUrl": "/p164/ghazal/sh4614"
    },
    {
      "Id": 4615,
      "Title": "روشن ہیں دل کے داغ نہ آنکھوں کے شب چراغ",
      "FullUrl": "/p164/ghazal/sh4615"
    },
    {
      "Id": 4617,
      "Title": "ساحل تمام اشک ندامت سے اٹ گیا",
      "FullUrl": "/p164/ghazal/sh4617"
    },
    {
      "Id": 4618,
      "Title": "سر رہ اب نہ یوں مجھ کو پکارو تم ہی آ جاؤ",
      "FullUrl": "/p164/ghazal/sh4618"
    },
    {
      "Id": 4619,
      "Title": "سمجھ سکو تو یہ تشنہ لبی سمندر ہے",
      "FullUrl": "/p164/ghazal/sh4619"
    },
    {
      "Id": 4620,
      "Title": "شفق جو روئے سحر پر گلال ملنے لگی",
      "FullUrl": "/p164/ghazal/sh4620"
    },
    {
      "Id": 4621,
      "Title": "عشق کے غم گسار ہیں ہم لوگ",
      "FullUrl": "/p164/ghazal/sh4621"
    },
    {
      "Id": 4622,
      "Title": "غم الفت مرے چہرے سے عیاں کیوں نہ ہوا",
      "FullUrl": "/p164/ghazal/sh4622"
    },
    {
      "Id": 4623,
      "Title": "غم حیات کی لذت بدلتی رہتی ہے",
      "FullUrl": "/p164/ghazal/sh4623"
    },
    {
      "Id": 4624,
      "Title": "غم دل حیطۂ تحریر میں آتا ہی نہیں",
      "FullUrl": "/p164/ghazal/sh4624"
    },
    {
      "Id": 4628,
      "Title": "مجھ سے ملنے شب غم اور تو کون آئے گا",
      "FullUrl": "/p164/ghazal/sh4628"
    },
    {
      "Id": 4629,
      "Title": "مرجھا کے کالی جھیل میں گرتے ہوئے بھی دیکھ",
      "FullUrl": "/p164/ghazal/sh4629"
    },
    {
      "Id": 4630,
      "Title": "مریض غم کے سہارو کوئی تو بات کرو",
      "FullUrl": "/p164/ghazal/sh4630"
    },
    {
      "Id": 4631,
      "Title": "مرے خلوص کی شدت سے کوئی ڈر بھی گیا",
      "FullUrl": "/p164/ghazal/sh4631"
    },
    {
      "Id": 4632,
      "Title": "موج صبا رواں ہوئی رقص جنوں بھی چاہئے",
      "FullUrl": "/p164/ghazal/sh4632"
    },
    {
      "Id": 4633,
      "Title": "موج غم اس لیے شاید نہیں گزری سر سے",
      "FullUrl": "/p164/ghazal/sh4633"
    },
    {
      "Id": 4634,
      "Title": "میٹھے چشموں سے خنک چھاؤں سے دور",
      "FullUrl": "/p164/ghazal/sh4634"
    },
    {
      "Id": 4635,
      "Title": "میں شاخ سے اڑا تھا ستاروں کی آس میں",
      "FullUrl": "/p164/ghazal/sh4635"
    },
    {
      "Id": 4636,
      "Title": "نقاب رخ اٹھایا جا رہا ہے",
      "FullUrl": "/p164/ghazal/sh4636"
    },
    {
      "Id": 4637,
      "Title": "وہ سامنے تھا پھر بھی کہاں سامنا ہوا",
      "FullUrl": "/p164/ghazal/sh4637"
    },
    {
      "Id": 4638,
      "Title": "وہاں کی روشنیوں نے بھی ظلم ڈھائے بہت",
      "FullUrl": "/p164/ghazal/sh4638"
    },
    {
      "Id": 4639,
      "Title": "وہی جھکی ہوئی بیلیں وہی دریچہ تھا",
      "FullUrl": "/p164/ghazal/sh4639"
    },
    {
      "Id": 4641,
      "Title": "پردۂ شب کی اوٹ میں زہرہ جمال کھو گئے",
      "FullUrl": "/p164/ghazal/sh4641"
    },
    {
      "Id": 4642,
      "Title": "پھر سن رہا ہوں گزرے زمانے کی چاپ کو",
      "FullUrl": "/p164/ghazal/sh4642"
    },
    {
      "Id": 4644,
      "Title": "کنار آب کھڑا خود سے کہہ رہا ہے کوئی",
      "FullUrl": "/p164/ghazal/sh4644"
    },
    {
      "Id": 4645,
      "Title": "کوئی اس دل کا حال کیا جانے",
      "FullUrl": "/p164/ghazal/sh4645"
    },
    {
      "Id": 4646,
      "Title": "کہاں رکیں گے مسافر نئے زمانوں کے",
      "FullUrl": "/p164/ghazal/sh4646"
    },
    {
      "Id": 4647,
      "Title": "کیا جانیے منزل ہے کہاں جاتے ہیں کس سمت",
      "FullUrl": "/p164/ghazal/sh4647"
    },
    {
      "Id": 4648,
      "Title": "کیا چیز ہے یہ سعئ پیہم کیا جذبۂ کامل ہوتا ہے",
      "FullUrl": "/p164/ghazal/sh4648"
    },
    {
      "Id": 4649,
      "Title": "کیا کہیے کہ اب اس کی صدا تک نہیں آتی",
      "FullUrl": "/p164/ghazal/sh4649"
    },
    {
      "Id": 4651,
      "Title": "گلے ملا نہ کبھی چاند بخت ایسا تھا",
      "FullUrl": "/p164/ghazal/sh4651"
    },
    {
      "Id": 4652,
      "Title": "گونجتا ہے نالۂ مہتاب آدھی رات کو",
      "FullUrl": "/p164/ghazal/sh4652"
    },
    {
      "Id": 4653,
      "Title": "ہم جنس اگر ملے نہ کوئی آسمان پر",
      "FullUrl": "/p164/ghazal/sh4653"
    },
    {
      "Id": 4654,
      "Title": "ہوائے شب سے نہ بجھتے ہیں اور نہ جلتے ہیں",
      "FullUrl": "/p164/ghazal/sh4654"
    },
    {
      "Id": 4656,
      "Title": "یہ جلوہ گاہ ناز تماشائیوں سے ہے",
      "FullUrl": "/p164/ghazal/sh4656"
    }
  ]
}
