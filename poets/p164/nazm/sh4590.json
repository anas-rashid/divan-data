      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "شام کی سیڑھیاں کتنی کرنوں کا مقتل بنیں\r\nباد مسموم نے توڑ کر کتنے پتے سپرد خزاں کر دیے\r\nبہہ کے مشکیزۂ ابر سے کتنی بوندیں زمیں کی غذا بن گئیں\r\nغیرممکن تھا ان کا شمار\r\nتھک گئیں گننے والے ہر اک ہاتھ کی انگلیاں\r\nان گنت کہہ کے آگے بڑھا وقت کا کارواں\r\nان گنت تھے مرے زخم دل\r\nٹوٹی کرنوں، بکھرتے ہوئے زرد پتوں، برستی ہوئی بوندیوں کی طرح\r\nاور مرہم بھی ناپید تھا\r\nلیکن اس روز دیکھا جو اک طفل نو زائیدہ کا خندۂ زیر لب\r\nزخم دل مندمل ہو گئے سب کے سب!",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 11
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Single",
      "Text": "شام کی سیڑھیاں کتنی کرنوں کا مقتل بنیں",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Single",
      "Text": "باد مسموم نے توڑ کر کتنے پتے سپرد خزاں کر دیے",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Single",
      "Text": "بہہ کے مشکیزۂ ابر سے کتنی بوندیں زمیں کی غذا بن گئیں",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Single",
      "Text": "غیرممکن تھا ان کا شمار",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Single",
      "Text": "تھک گئیں گننے والے ہر اک ہاتھ کی انگلیاں",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Single",
      "Text": "ان گنت کہہ کے آگے بڑھا وقت کا کارواں",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Single",
      "Text": "ان گنت تھے مرے زخم دل",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Single",
      "Text": "ٹوٹی کرنوں، بکھرتے ہوئے زرد پتوں، برستی ہوئی بوندیوں کی طرح",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Single",
      "Text": "اور مرہم بھی ناپید تھا",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Single",
      "Text": "لیکن اس روز دیکھا جو اک طفل نو زائیدہ کا خندۂ زیر لب",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Single",
      "Text": "زخم دل مندمل ہو گئے سب کے سب!",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    }
  ]
}
