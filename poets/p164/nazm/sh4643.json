      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "میرا چہرہ آئینہ ہے\r\nآئینے پر داغ جو ہوتے\r\nلہو کی برکھا سے میں دھوتا\r\nاپنے اندر جھانک کے دیکھو\r\nدل کے پتھر میں کالک کی کتنی پرتیں جمی ہوئی ہیں\r\nجن سے ہر نتھرا ستھرا منظر کجلا سا گیا\r\nدریا سوکھ گئے ہیں شرم کے مارے\r\nکوئلے پر سے کالک کون اتارے!!",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 8
    }
