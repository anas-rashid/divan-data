      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "آئی عید و دل میں نہیں کچھ ہوائے عید\r\nاے کاش میرے پاس تو آتا بجائے عید\r\nقربان سو طرح سے کیا تجھ پر آپ کو\r\nتو بھی کبھو تو جان نہ آیا بجائے عید\r\nجتنے ہیں جامہ زیب جہاں میں سبھوں کے بیچ\r\nسجتی ہے تیرے بر میں سراپا قبائے عید",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
