    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "جس کو عرفان ہے سو تو گونگا ہے",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "جس نے پایا اسے سو ہے خاموش",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
