      "Text": "کب اسے زندگی کی پروا ہے",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "اس کو ہر آن ہر قدم ہر دم",
      "CoupletIndex": 19,
