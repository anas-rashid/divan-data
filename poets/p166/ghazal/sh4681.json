      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "وہ نہ سمجھے گا یہ سخن حاتمؔ",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "جس کو جہل اور خیال سودا ہے",
      "CoupletIndex": 21,
