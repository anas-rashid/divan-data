      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "عشق میں پاس جاں نہیں ہے درست\r\nاس سخن میں گماں نہیں ہے درست\r\nکسو مشرب میں اور مذہب میں\r\nظلم اے مہرباں نہیں ہے درست\r\nڈر نہ دشمن کوں کڑکڑانے میں\r\nبانگ مرغی کے یاں نہیں ہے درست\r\nکئی دیوان کہہ چکا حاتمؔ\r\nاب تلک پر زباں نہیں ہے درست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
