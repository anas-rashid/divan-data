    {
      "Id": 4769,
      "Title": "بتو یہ شیشۂ دل توڑ دو خدا کے لیے",
      "FullUrl": "/p168/ghazal/sh4769"
    },
    {
      "Id": 4770,
      "Title": "دخل ہر دل میں ترا مثل سویدا ہو گیا",
      "FullUrl": "/p168/ghazal/sh4770"
    },
    {
      "Id": 4771,
      "Title": "دم نہ نکلا یار کی نامہربانی دیکھ کر",
      "FullUrl": "/p168/ghazal/sh4771"
    },
    {
      "Id": 4772,
      "Title": "رنجش تری ہر دم کی گوارا نہ کریں گے",
      "FullUrl": "/p168/ghazal/sh4772"
    },
    {
      "Id": 4773,
      "Title": "فصل گل ساتھ لیے باغ میں کیا آتی ہے",
      "FullUrl": "/p168/ghazal/sh4773"
    },
    {
      "Id": 4774,
      "Title": "نہ کہو اعتبار ہے کس کا",
      "FullUrl": "/p168/ghazal/sh4774"
    },
    {
      "Id": 4775,
      "Title": "کون برہم ہے زلف جاناں سے",
      "FullUrl": "/p168/ghazal/sh4775"
    },
    {
      "Id": 4776,
      "Title": "کون دنیا سے بادہ خوار اٹھا",
      "FullUrl": "/p168/ghazal/sh4776"
    },
    {
      "Id": 4777,
      "Title": "کیا کیا نہ تیرے صدمہ سے باد خزاں گرا",
      "FullUrl": "/p168/ghazal/sh4777"
    }
  ]
