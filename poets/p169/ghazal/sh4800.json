      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کھڑا رہنے نہ دیں وو اب کہ جو شخص",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اٹھاتے تھے مزے ہم کو بٹھا کر",
