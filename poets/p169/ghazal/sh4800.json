      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بھلا دیکھیں یہ کن آنکھوں سے کیوں جی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
