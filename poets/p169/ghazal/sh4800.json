    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "نوشتہ خوب سمجھے ہم پڑھا کر",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "ابھی گھر سے نہیں نکلا وہ تس پر",
