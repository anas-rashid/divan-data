  "Poems": [
    {
      "Id": 4861,
      "Title": "دم اخیر بھی ہم نے زباں سے کچھ نہ کہا",
      "FullUrl": "/p170/ghazal/sh4861"
    },
    {
      "Id": 4858,
      "Title": "باتوں میں ڈھونڈتے ہیں وہ پہلو ملال کا",
      "FullUrl": "/p170/ghazal/sh4858"
    },
    {
      "Id": 4864,
      "Title": "شب فراق جو دل میں خیال یار رہا",
      "FullUrl": "/p170/ghazal/sh4864"
    },
    {
      "Id": 4871,
      "Title": "کیا خبر تھی کوئی رسوائے جہاں ہو جائے گا",
      "FullUrl": "/p170/ghazal/sh4871"
    },
    {
      "Id": 4865,
      "Title": "قلزم الفت میں وہ طوفان کا عالم ہوا",
      "FullUrl": "/p170/ghazal/sh4865"
    },
    {
      "Id": 4860,
      "Title": "دل دیا ہے ہم نے بھی وہ ماہ کامل دیکھ کر",
      "FullUrl": "/p170/ghazal/sh4860"
    },
    {
      "Id": 4867,
      "Title": "وہ جھنکار پیدا ہے تار نفس میں",
      "FullUrl": "/p170/ghazal/sh4867"
    },
    {
      "Id": 4868,
      "Title": "وہ حد سے دور ہوتے جا رہے ہیں",
      "FullUrl": "/p170/ghazal/sh4868"
    },
    {
      "Id": 4870,
      "Title": "کچھ اشارے وہ سر بزم جو کر جاتے ہیں",
      "FullUrl": "/p170/ghazal/sh4870"
    },
    {
      "Id": 4869,
      "Title": "کثرت وحدانیت میں حسن کی تنویر دیکھ",
      "FullUrl": "/p170/ghazal/sh4869"
    },
    {
      "Id": 4859,
      "Title": "حجاب راز فیض مرشد کامل سے اٹھتا ہے",
      "FullUrl": "/p170/ghazal/sh4859"
    },
    {
      "Id": 4863,
      "Title": "زندگی نام ہے جس چیز کا کیا ہوتی ہے",
      "FullUrl": "/p170/ghazal/sh4863"
    },
    {
      "Id": 4866,
      "Title": "وہ جب تک انجمن میں جلوہ فرمانے نہیں آتے",
      "FullUrl": "/p170/ghazal/sh4866"
    },
    {
      "Id": 4862,
      "Title": "زلف جاناں پہ طبیعت مری لہرائی ہے",
      "FullUrl": "/p170/ghazal/sh4862"
    }
  ]
}
