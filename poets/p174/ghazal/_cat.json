  "Poems": [
    {
      "Id": 4916,
      "Title": "اب ایک درد بھی دل میں نظر نہیں آتا",
      "FullUrl": "/p174/ghazal/sh4916"
    },
    {
      "Id": 4917,
      "Title": "اب نہ وہ ہم ہیں نہ وہ پیار کی صورت تیری",
      "FullUrl": "/p174/ghazal/sh4917"
    },
    {
      "Id": 4918,
      "Title": "اتنے تو ہم خیال دل مبتلا ہیں ہم",
      "FullUrl": "/p174/ghazal/sh4918"
    },
    {
      "Id": 4919,
      "Title": "اسے کیا رات دن جو طالب دیدار پھرتے ہیں",
      "FullUrl": "/p174/ghazal/sh4919"
    },
    {
      "Id": 4920,
      "Title": "اے دل نہ عقیدہ ہے دوا پر نہ دعا پر",
      "FullUrl": "/p174/ghazal/sh4920"
    },
    {
      "Id": 4921,
      "Title": "بد گماں کیا قبر میں ارماں ترے لے جائیں گے",
      "FullUrl": "/p174/ghazal/sh4921"
    },
    {
      "Id": 4922,
      "Title": "بنے ہو خاک سے تو خاکساری ہو طبیعت میں",
      "FullUrl": "/p174/ghazal/sh4922"
    },
    {
      "Id": 4923,
      "Title": "ترا بے مدعا مانگے دعا کیا",
      "FullUrl": "/p174/ghazal/sh4923"
    },
    {
      "Id": 4924,
      "Title": "تیرے قول و قرار کی باتیں",
      "FullUrl": "/p174/ghazal/sh4924"
    },
    {
      "Id": 4925,
      "Title": "جب ان سے دوستی نہ رہی دشمنی رہی",
      "FullUrl": "/p174/ghazal/sh4925"
    },
    {
      "Id": 4926,
      "Title": "جب ترا انتظار ہوتا ہے",
      "FullUrl": "/p174/ghazal/sh4926"
    },
    {
      "Id": 4927,
      "Title": "جو حسن و عشق سے امن و اماں میں رہتے ہیں",
      "FullUrl": "/p174/ghazal/sh4927"
    },
    {
      "Id": 4928,
      "Title": "خوب ہاتھوں ہاتھ بدلہ مل گیا بیداد کا",
      "FullUrl": "/p174/ghazal/sh4928"
    },
    {
      "Id": 4929,
      "Title": "خوش ہوں یا دوست سے خفا ہوں میں",
      "FullUrl": "/p174/ghazal/sh4929"
    },
    {
      "Id": 4930,
      "Title": "دام خیال زلف بتاں سے چھڑا لیا",
      "FullUrl": "/p174/ghazal/sh4930"
    },
    {
      "Id": 4931,
      "Title": "درد فرقت کو کیا کرے کوئی",
      "FullUrl": "/p174/ghazal/sh4931"
    },
    {
      "Id": 4932,
      "Title": "دل جب سے درد عشق کے قابل نہیں رہا",
      "FullUrl": "/p174/ghazal/sh4932"
    },
    {
      "Id": 4933,
      "Title": "دل عشق میں تباہ ہوا یا کہ جل گیا",
      "FullUrl": "/p174/ghazal/sh4933"
    },
    {
      "Id": 4934,
      "Title": "دوست خوش ہوتے ہیں جب دوست کا غم دیکھتے ہیں",
      "FullUrl": "/p174/ghazal/sh4934"
    },
    {
      "Id": 4935,
      "Title": "رنج ہے اس رنج سے ہم کو تو غم اس غم سے ہے",
      "FullUrl": "/p174/ghazal/sh4935"
    },
    {
      "Id": 4936,
      "Title": "سیر چمن ہے اور وہ گل رو کنار میں",
      "FullUrl": "/p174/ghazal/sh4936"
    },
    {
      "Id": 4937,
      "Title": "شب ہجر آہ کدھر گئی کہوں کس سے نالہ کدھر گیا",
      "FullUrl": "/p174/ghazal/sh4937"
    },
    {
      "Id": 4938,
      "Title": "شوق دربار میں ملتے رہے دربانوں سے",
      "FullUrl": "/p174/ghazal/sh4938"
    },
    {
      "Id": 4939,
      "Title": "عشق الزام بھی تو ہوتا ہے",
      "FullUrl": "/p174/ghazal/sh4939"
    },
    {
      "Id": 4940,
      "Title": "عشق ان سب سے الگ سب سے جدا ہوتا ہے",
      "FullUrl": "/p174/ghazal/sh4940"
    },
    {
      "Id": 4941,
      "Title": "نہ اپنے بس میں ہے رونا نہ ہائے ہنس دینا",
      "FullUrl": "/p174/ghazal/sh4941"
    },
    {
      "Id": 4942,
      "Title": "نہ روتا زار زار ایسا نہ کرتا شور و شر اتنا",
      "FullUrl": "/p174/ghazal/sh4942"
    },
    {
      "Id": 4943,
      "Title": "وہ واقعات کسے یاد اک زمانہ ہوا",
      "FullUrl": "/p174/ghazal/sh4943"
    },
    {
      "Id": 4944,
      "Title": "وہی ہوتا ہے جو محبوب کو منظور ہوتا ہے",
      "FullUrl": "/p174/ghazal/sh4944"
    },
    {
      "Id": 4945,
      "Title": "پوچھتے کیا ہو ترا یہ حال کیسا ہو گیا",
      "FullUrl": "/p174/ghazal/sh4945"
    },
    {
      "Id": 4946,
      "Title": "چھوڑ ہر ایک کو برا کہنا",
      "FullUrl": "/p174/ghazal/sh4946"
    },
    {
      "Id": 4947,
      "Title": "چھٹی امید تو میں حال دل کہنے سے کیوں ڈرتا",
      "FullUrl": "/p174/ghazal/sh4947"
    },
    {
