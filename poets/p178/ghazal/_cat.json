  "Poems": [
    {
      "Id": 4966,
      "Title": "بتوں کو بھول جاتے ہیں خدا کو یاد کرتے ہیں",
      "FullUrl": "/p178/ghazal/sh4966"
    },
    {
      "Id": 4967,
      "Title": "تمنا ہے کسی کی تیغ ہو اور اپنی گردن ہو",
      "FullUrl": "/p178/ghazal/sh4967"
    },
    {
      "Id": 4968,
      "Title": "تیرے رہنے کو مناسب تھا کہ چھپر ہوتا",
      "FullUrl": "/p178/ghazal/sh4968"
    },
    {
      "Id": 4975,
      "Title": "علم میں جھینگر سے بڑھ کر کامراں کوئی نہیں",
      "FullUrl": "/p178/ghazal/sh4975"
    },
    {
      "Id": 4976,
      "Title": "غنچہ دہن وہی ہے کہ گونگا کہیں جسے",
      "FullUrl": "/p178/ghazal/sh4976"
    },
    {
      "Id": 4977,
      "Title": "قیس کہتا تھا یہی فکر ہے دن رات مجھے",
      "FullUrl": "/p178/ghazal/sh4977"
    },
    {
      "Id": 4978,
      "Title": "مجنوں کا جو اے لیلیٰ جوتا نہ پھٹا ہوتا",
      "FullUrl": "/p178/ghazal/sh4978"
    },
    {
      "Id": 4979,
      "Title": "محشرستان جنوں میں دل ناکام آیا",
      "FullUrl": "/p178/ghazal/sh4979"
    },
    {
      "Id": 4980,
      "Title": "وحشت میں ہر اک نقشہ الٹا نظر آتا ہے",
      "FullUrl": "/p178/ghazal/sh4980"
    },
    {
      "Id": 4981,
      "Title": "وہ ہو کیسا ہی دبلا تار بستر ہو نہیں سکتا",
      "FullUrl": "/p178/ghazal/sh4981"
    },
    {
      "Id": 4982,
      "Title": "کریں گے سب یہ دعویٰ نقد دل جو ہار بیٹھے ہیں",
      "FullUrl": "/p178/ghazal/sh4982"
    }
  ]
