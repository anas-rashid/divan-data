      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مجلس اتحاد ملت کو\r\nلکھیے حبل المتین کلکتہ\r\nسارے ہندوستاں کی دولت کو\r\nکہئے ملک یمین کلکتہ\r\nکفر ہگلی میں جا کے ڈوب گیا\r\nدیں ہوا ہے مکین کلکتہ\r\nاثر سجدہ ہائے پیہم سے\r\nہوئی روشن جبین کلکتہ\r\nہر طرف پھر رہے ہیں نیلی پوش\r\nآسماں ہے زمین کلکتہ",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 5
    }
