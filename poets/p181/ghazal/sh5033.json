      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "وہ جو کچھ کچھ نگہ ملانے لگے\r\nہم ہر اک سے نظر چرانے لگے\r\nدیکھیے کیا ہو جور کا انجام\r\nوہ مرے حوصلے بڑھانے لگے\r\nیہ وہ کافر ہے عشق خانہ خراب\r\nتم مرے غم کدے میں آنے لگے\r\nکاوشوں میں بھی اب مزا نہ رہا\r\nہر کسی کو وہ جب ستانے لگے\r\nموت آئی ظہیرؔ کب ہم کو\r\nجب محبت کے لطف آنے لگے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
