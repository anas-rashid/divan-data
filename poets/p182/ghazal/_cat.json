  "Poems": [
    {
      "Id": 5076,
      "Title": "واعظ شہر خدا ہے مجھے معلوم نہ تھا",
      "FullUrl": "/p182/ghazal/sh5076"
    },
    {
      "Id": 5071,
      "Title": "غم دوراں غم جاناں کا نشاں ہے کہ جو تھا",
      "FullUrl": "/p182/ghazal/sh5071"
    },
    {
      "Id": 5072,
      "Title": "محفل فروز جلوۂ جانانہ ہو چکا",
      "FullUrl": "/p182/ghazal/sh5072"
    },
    {
      "Id": 5060,
      "Title": "دل ہے آئینۂ حیرت سے دو چار آج کی رات",
      "FullUrl": "/p182/ghazal/sh5060"
    },
    {
      "Id": 5080,
      "Title": "کسی کی عشوہ گری سے بہ غیر فصل بہار",
      "FullUrl": "/p182/ghazal/sh5080"
    },
    {
      "Id": 5079,
      "Title": "چین پڑتا ہے دل کو آج نہ کل",
      "FullUrl": "/p182/ghazal/sh5079"
    },
    {
      "Id": 5052,
      "Title": "آئی سحر قریب تو میں نے پڑھی غزل",
      "FullUrl": "/p182/ghazal/sh5052"
    },
    {
      "Id": 5053,
      "Title": "اپنی تجلیوں سے معمور ہو گئے ہم",
      "FullUrl": "/p182/ghazal/sh5053"
    },
    {
      "Id": 5078,
      "Title": "چاند ستاروں سے کیا پوچھوں کب دن میرے پھرتے ہیں",
      "FullUrl": "/p182/ghazal/sh5078"
    },
    {
      "Id": 5082,
      "Title": "کہو بتوں سے کہ ہم طبع سادہ رکھتے ہیں",
      "FullUrl": "/p182/ghazal/sh5082"
    },
    {
      "Id": 5086,
      "Title": "ہم بن غم یار بھی جئے ہیں",
      "FullUrl": "/p182/ghazal/sh5086"
    },
    {
      "Id": 5065,
      "Title": "سب کے جلوے نظر سے گزرے ہیں",
      "FullUrl": "/p182/ghazal/sh5065"
    },
    {
      "Id": 5067,
      "Title": "شوق سے خود جو مرے راہنما ہوتے ہیں",
      "FullUrl": "/p182/ghazal/sh5067"
    },
    {
      "Id": 5087,
      "Title": "یہ عرض شوق ہے آرائش بیاں بھی تو ہو",
      "FullUrl": "/p182/ghazal/sh5087"
    },
    {
      "Id": 5058,
      "Title": "دل کا معاملہ نگۂ آشنا کے ساتھ",
      "FullUrl": "/p182/ghazal/sh5058"
    },
    {
      "Id": 5085,
      "Title": "گلوں کی خوں شدگی کو شگفتگی نہ سمجھ",
      "FullUrl": "/p182/ghazal/sh5085"
    },
    {
      "Id": 5073,
      "Title": "مے ہو ساغر میں کہ خوں رات گزر جائے گی",
      "FullUrl": "/p182/ghazal/sh5073"
    },
    {
      "Id": 5083,
      "Title": "گردش جام نہیں رک سکتی",
      "FullUrl": "/p182/ghazal/sh5083"
    },
    {
      "Id": 5084,
      "Title": "گل کی خونیں جگری یاد آئی",
      "FullUrl": "/p182/ghazal/sh5084"
    },
    {
      "Id": 5088,
      "Title": "یہ کیا طلسم ہے دنیا پہ بار گزری ہے",
      "FullUrl": "/p182/ghazal/sh5088"
    },
    {
      "Id": 5069,
      "Title": "عام ہو فیض بہاراں تو مزا آ جائے",
