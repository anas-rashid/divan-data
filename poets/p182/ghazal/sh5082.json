      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کہو بتوں سے کہ ہم طبع سادہ رکھتے ہیں\r\nپھر ان سے عرض وفا کا ارادہ رکھتے ہیں\r\nیہی خطا ہے کہ اس گیر و دار میں ہم لوگ\r\nدل شگفتہ جبین کشادہ رکھتے ہیں\r\nخدا گواہ کہ اصنام سے ہے کم رغبت\r\nصنم گری کی تمنا زیادہ رکھتے ہیں\r\nدکان بادہ فروشاں کے صحن میں عابدؔ\r\nفرشتے خلد کا اک در کشادہ رکھتے ہیں",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
