  "Poems": [
    {
      "Id": 5090,
      "Title": "ان سے دو آنکھ سے آنسو بھی بہائے نہ گئے",
      "FullUrl": "/p183/ghazal/sh5090"
    },
    {
      "Id": 5091,
      "Title": "اے دل اس زلف کی رکھیو نہ تمنا باقی",
      "FullUrl": "/p183/ghazal/sh5091"
    },
    {
      "Id": 5092,
      "Title": "تجھ کو کس منہ سے بے وفا کہئے",
      "FullUrl": "/p183/ghazal/sh5092"
    },
    {
      "Id": 5093,
      "Title": "جو دل میں خون تمنا کیا نہ کرتے ہم",
      "FullUrl": "/p183/ghazal/sh5093"
    },
    {
      "Id": 5094,
      "Title": "داغوں سے دل و سینہ کے افروختہ جاں ہوں",
      "FullUrl": "/p183/ghazal/sh5094"
    },
    {
      "Id": 5095,
      "Title": "روز دینے لگے آزار یہ کیا",
      "FullUrl": "/p183/ghazal/sh5095"
    },
    {
      "Id": 5096,
      "Title": "رہی ان کی چین جبیں دیر تک",
      "FullUrl": "/p183/ghazal/sh5096"
    },
    {
      "Id": 5097,
      "Title": "ستم ہے وہ پھر بد گماں ہو رہا ہے",
      "FullUrl": "/p183/ghazal/sh5097"
    },
    {
      "Id": 5098,
      "Title": "فتنہ خو لے گئی دل چھین کے جھٹ پٹ ہم سے",
      "FullUrl": "/p183/ghazal/sh5098"
    },
    {
      "Id": 5099,
      "Title": "فلک چکر میں کیوں چونسٹھ گھڑی ہے",
      "FullUrl": "/p183/ghazal/sh5099"
    },
    {
      "Id": 5100,
      "Title": "لگائے بیٹھے ہیں مہندی جو میرے خوں سے پوروں میں",
      "FullUrl": "/p183/ghazal/sh5100"
    },
    {
      "Id": 5101,
      "Title": "نہ مانا میرا کہنا دل گیا کیوں داد خواہی کو",
      "FullUrl": "/p183/ghazal/sh5101"
    },
    {
      "Id": 5102,
      "Title": "وہ وہاں غیر کو مہمان کئے بیٹھے ہیں",
      "FullUrl": "/p183/ghazal/sh5102"
    },
    {
      "Id": 5103,
      "Title": "کون کہتا ہے کہ مرنا مرا اچھا نہ ہوا",
      "FullUrl": "/p183/ghazal/sh5103"
    },
    {
      "Id": 5104,
      "Title": "گردش دوراں سے یہاں کس کو فراغ آیا ہے ہاتھ",
      "FullUrl": "/p183/ghazal/sh5104"
    },
    {
      "Id": 5105,
      "Title": "گزرے وعدے کو وہ خود یاد دلا دیتے ہیں",
      "FullUrl": "/p183/ghazal/sh5105"
    },
    {
      "Id": 5106,
      "Title": "ہماری اس سے جو صورت ہوئی صفائی کی",
      "FullUrl": "/p183/ghazal/sh5106"
    },
    {
      "Id": 5107,
      "Title": "ہوس کیجے نہ عمر جاوداں کی",
      "FullUrl": "/p183/ghazal/sh5107"
    }
  ]
}
