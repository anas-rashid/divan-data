    {
      "Id": 5108,
      "Title": "عدو کی بزم میں اے بزمؔ یہ شب تو بسر کر لو",
      "FullUrl": "/p184/ghazal/c496/sh5108"
    },
    {
      "Id": 5109,
      "Title": "عمر گزری ان بتوں کے وصل کی تدبیر میں",
      "FullUrl": "/p184/ghazal/c496/sh5109"
    },
    {
      "Id": 5110,
      "Title": "مقتل میں آج حوصلہ دل کا نکل گیا",
      "FullUrl": "/p184/ghazal/c496/sh5110"
    },
    {
      "Id": 5111,
      "Title": "کل سے دل بیمار کی حالت نہیں اچھی",
      "FullUrl": "/p184/ghazal/c496/sh5111"
    },
    {
      "Id": 5112,
      "Title": "کوئی نادان نہ دانا اچھا",
      "FullUrl": "/p184/ghazal/c496/sh5112"
    },
    {
      "Id": 5113,
      "Title": "یوں تو میں نہیں ہوں ترے فرمان سے باہر",
      "FullUrl": "/p184/ghazal/c496/sh5113"
    },
    {
      "Id": 5114,
      "Title": "یہ کیا خبر ہے کہ وہ بے خبر نہیں آتا",
      "FullUrl": "/p184/ghazal/c496/sh5114"
    }
  ]
