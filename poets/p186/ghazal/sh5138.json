      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ظاہراً موت ہے قضا ہے عشق\r\nپر حقیقت میں جاں فزا ہے عشق\r\nدیتا ہے لاکھ طرح سے تسکین\r\nمرض ہجر میں دوا ہے عشق\r\nتا دم مرگ ساتھ دیتا ہے\r\nایک محبوب با وفا ہے عشق\r\nدیکھ نساخؔ گر نہ ہوتا کفر\r\nکہتے بے شبہ ہم خدا ہے عشق",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
