  "Poems": [
    {
      "Id": 5141,
      "Title": "جو مشت خاک ہو اس خاکداں کی بات کرو",
      "FullUrl": "/p187/ghazal/sh5141"
    },
    {
      "Id": 5142,
      "Title": "خرد میں مبتلا ہے سالکؔ دیوانہ برسوں سے",
      "FullUrl": "/p187/ghazal/sh5142"
    },
    {
      "Id": 5143,
      "Title": "غم کے ہاتھوں مرے دل پر جو سماں گزرا ہے",
      "FullUrl": "/p187/ghazal/sh5143"
    },
    {
      "Id": 5144,
      "Title": "مرے دل میں ہے کہ پوچھوں کبھی مرشد مغاں سے",
      "FullUrl": "/p187/ghazal/sh5144"
    },
    {
      "Id": 5145,
      "Title": "نہ محتسب کی نہ حور و جناں کی بات کرو",
      "FullUrl": "/p187/ghazal/sh5145"
    },
    {
      "Id": 5146,
      "Title": "وہ ہے حیرت فزائے چشم معنی سب نظاروں میں",
      "FullUrl": "/p187/ghazal/sh5146"
    },
    {
      "Id": 5147,
      "Title": "چراغ زندگی ہوگا فروزاں ہم نہیں ہوں گے",
      "FullUrl": "/p187/ghazal/sh5147"
    },
    {
      "Id": 5148,
      "Title": "ہم نفسو اجڑ گئیں مہر و وفا کی بستیاں",
      "FullUrl": "/p187/ghazal/sh5148"
    }
  ]
}
