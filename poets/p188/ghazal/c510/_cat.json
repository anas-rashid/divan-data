  "Poems": [
    {
      "Id": 5154,
      "Title": "نہ ہوا پر نہ ہوا وہ بت خود سر اپنا",
      "FullUrl": "/p188/ghazal/c510/sh5154",
      "RadifLetter": "ا"
    },
    {
      "Id": 5153,
      "Title": "دو جہاں کو نگہ عجز سے اکثر دیکھا",
      "FullUrl": "/p188/ghazal/c510/sh5153",
      "RadifLetter": "ا"
    },
    {
      "Id": 5155,
      "Title": "وہ ساغر شباب چھلکتا ہوا ہے کیا",
      "FullUrl": "/p188/ghazal/c510/sh5155",
      "RadifLetter": "ا"
    },
    {
      "Id": 5149,
      "Title": "بھول کر پہلوئے امید میں آیا نہ گیا",
      "FullUrl": "/p188/ghazal/c510/sh5149",
      "RadifLetter": "ا"
    },
    {
      "Id": 5161,
      "Title": "ہر ایک کو ہر مرتبہ حاصل نہیں ہوتا",
      "FullUrl": "/p188/ghazal/c510/sh5161",
      "RadifLetter": "ا"
    },
    {
      "Id": 5157,
      "Title": "پھر رگ شعلۂ جاں سوز میں نشتر گزرا",
      "FullUrl": "/p188/ghazal/c510/sh5157",
      "RadifLetter": "ا"
    },
    {
      "Id": 5158,
      "Title": "کام آساں نظر آیا مجھے مشکل ہو کر",
      "FullUrl": "/p188/ghazal/c510/sh5158",
      "RadifLetter": "ر"
    },
    {
      "Id": 5159,
      "Title": "کیا گزر کیجئے صیاد دل آزار کے پاس",
      "FullUrl": "/p188/ghazal/c510/sh5159",
      "RadifLetter": "س"
    },
    {
      "Id": 5160,
      "Title": "ہاں درد نہاں رنگ کی تعبیر سے پوچھو",
      "FullUrl": "/p188/ghazal/c510/sh5160",
      "RadifLetter": "و"
    },
    {
      "Id": 5151,
      "Title": "حیرت کو مژدہ گرم ہے بازار آئینہ",
      "FullUrl": "/p188/ghazal/c510/sh5151",
      "RadifLetter": "ہ"
    },
    {
      "Id": 5152,
      "Title": "دل میں رہ کر چھپا کرے کوئی",
      "FullUrl": "/p188/ghazal/c510/sh5152",
      "RadifLetter": "ی"
    },
    {
      "Id": 5156,
      "Title": "پھر حشر کے پردہ میں تقدیر نظر آئی",
      "FullUrl": "/p188/ghazal/c510/sh5156",
      "RadifLetter": "ی"
    },
    {
      "Id": 5150,
      "Title": "بے کسی نے گھر بنایا میرے گھر کے سامنے",
      "FullUrl": "/p188/ghazal/c510/sh5150",
      "RadifLetter": "ے"
    }
  ]
