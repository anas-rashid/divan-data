      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "جو اس محفل میں ہم جانے بھی پائے",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "پیا پے آنسو آنکھوں سے رواں تھے",
