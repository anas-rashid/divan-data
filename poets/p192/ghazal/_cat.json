  "Poems": [
    {
      "Id": 5219,
      "Title": "نہ دیکھوں گا حسینوں کو ارے توبہ نہ دیکھوں گا",
      "FullUrl": "/p192/ghazal/sh5219"
    },
    {
      "Id": 5221,
      "Title": "وہ مست ناز آتا ہے ذرا ہشیار ہو جانا",
      "FullUrl": "/p192/ghazal/sh5221"
    },
    {
      "Id": 5224,
      "Title": "ہر چیز میں عکس رخ زیبا نظر آیا",
      "FullUrl": "/p192/ghazal/sh5224"
    },
    {
      "Id": 5215,
      "Title": "ادا شناس ترا بے زباں نہیں ہوتا",
      "FullUrl": "/p192/ghazal/sh5215"
    },
    {
      "Id": 5216,
      "Title": "جلوہ فرما دیر تک دل بر رہا",
      "FullUrl": "/p192/ghazal/sh5216"
    },
    {
      "Id": 5222,
      "Title": "پس پردہ تجھے ہر بزم میں شامل سمجھتے ہیں",
      "FullUrl": "/p192/ghazal/sh5222"
    },
    {
      "Id": 5218,
      "Title": "نظارے ہوئے ہیں اشارے ہوئے ہیں",
      "FullUrl": "/p192/ghazal/sh5218"
    },
    {
      "Id": 5220,
      "Title": "وفا کر کے اس کا صلا چاہتا ہوں",
      "FullUrl": "/p192/ghazal/sh5220"
    },
    {
      "Id": 5223,
      "Title": "ہر تمنا دل سے رخصت ہو گئی",
      "FullUrl": "/p192/ghazal/sh5223"
    },
    {
      "Id": 5217,
      "Title": "دل ربا پہلو سے اب اٹھ کر جدا ہونے کو ہے",
      "FullUrl": "/p192/ghazal/sh5217"
    }
  ]
}
