  "Poems": [
    {
      "Id": 5232,
      "Title": "ان کی ٹھوکر میں شرارت ہوگی",
      "FullUrl": "/p194/ghazal/sh5232"
    },
    {
      "Id": 5233,
      "Title": "اٹھائیں ہجر کی شب دل نے آفتیں کیا کیا",
      "FullUrl": "/p194/ghazal/sh5233"
    },
    {
      "Id": 5234,
      "Title": "بڑھ گئیں گستاخیاں میری سزا کے ساتھ ساتھ",
      "FullUrl": "/p194/ghazal/sh5234"
    },
    {
      "Id": 5235,
      "Title": "جفا دیکھنی تھی ستم دیکھنا تھا",
      "FullUrl": "/p194/ghazal/sh5235"
    },
    {
      "Id": 5236,
      "Title": "درد جاتا نظر نہیں آتا",
      "FullUrl": "/p194/ghazal/sh5236"
    },
    {
      "Id": 5237,
      "Title": "زندگی نام ہے محبت کا",
      "FullUrl": "/p194/ghazal/sh5237"
    },
    {
      "Id": 5238,
      "Title": "شوخی اف رے تری نظر کی",
      "FullUrl": "/p194/ghazal/sh5238"
    },
    {
      "Id": 5239,
      "Title": "شوخی سے کشمکش نہیں اچھی حجاب کی",
      "FullUrl": "/p194/ghazal/sh5239"
    },
    {
      "Id": 5240,
      "Title": "ظالم ترے وعدوں نے دیوانہ بنا رکھا",
      "FullUrl": "/p194/ghazal/sh5240"
    },
    {
      "Id": 5241,
      "Title": "محبت کا مجھے دعویٰ ہی کیا ہے",
      "FullUrl": "/p194/ghazal/sh5241"
    },
    {
      "Id": 5242,
      "Title": "نازنینان جہاں شعبدہ گر پکے ہیں",
      "FullUrl": "/p194/ghazal/sh5242"
    },
    {
      "Id": 5243,
      "Title": "نالے دم لیتے نہیں یارب فغاں رکتی نہیں",
      "FullUrl": "/p194/ghazal/sh5243"
    },
    {
      "Id": 5244,
      "Title": "نعرۂ تکبیر بھی زاہد نثار نغمہ ہے",
      "FullUrl": "/p194/ghazal/sh5244"
    },
    {
      "Id": 5245,
      "Title": "نگاہ ناز میں حیا بھی ہے",
      "FullUrl": "/p194/ghazal/sh5245"
    },
    {
      "Id": 5246,
      "Title": "نہ بدلنا تھا نہ بدلا دل شیدا اپنا",
      "FullUrl": "/p194/ghazal/sh5246"
    },
    {
      "Id": 5247,
      "Title": "وحشت دل کا عجب رنگ نظر آتا ہے",
      "FullUrl": "/p194/ghazal/sh5247"
    },
    {
      "Id": 5248,
      "Title": "کوئی رسوا کوئی سودائی ہے",
      "FullUrl": "/p194/ghazal/sh5248"
    },
    {
      "Id": 5249,
      "Title": "کیوں خفا ہو کیوں ادھر آتے نہیں",
      "FullUrl": "/p194/ghazal/sh5249"
    }
  ]
}
