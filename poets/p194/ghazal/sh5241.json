    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "نشیمن میں مرے رکھا ہی کیا ہے",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "محبت میں جئے یا کوئی مر جائے",
