      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بلبل کہو گل کی کیا خبر ہے\r\nگلشن میں بہار کس قدر ہے\r\nمنظور نظر ہے جب سے خوش چشم\r\nاپنی نہ کسو طرف نظر ہے\r\nگر شیخ نے آہ کی تو مت بھول\r\nدل میں پتھر کے بھی شرر ہے\r\nنرگس جو کھڑی ہے عشقؔ حیران\r\nکس جانئے کس کی راہ پر ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
