      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بیتی ہے یہ سب دل پہ ہے سب دل کی زبانی\r\nہجراں کی جو دلبر سے میں کہتا ہوں کہانی\r\nتو یار عزیز آنکھوں میں ہے مہر وشوں کے\r\nنیں ہے مہ کنعاں بھی ترے حسن کے ثانی\r\nابرو کے ترے چین کے کیا وصف کہوں میں\r\nشمشیر میں جوہر سے ہے خوبی کی نشانی\r\nسر پر ہو سر بزم کہاں شمع میں ہے آب\r\nگر عشق کی آنکھیں جو کریں اشک فشانی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
