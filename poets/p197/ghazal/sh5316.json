      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "حیراں ہیں دیکھ تیری صورت کو یاں تلک ہم\r\nتصویر ساں اے پیارے مارے نہیں پلک ہم\r\nہوں باریاب کیوں کر خورشید رو تلک ہم\r\nاے کاش اس کی دیکھیں جیوں ذرہ اک جھلک ہم\r\nیہ فال آرزو ہے ایسا نہ بینو دیکھو\r\nدلبر کے پھر بھی ہوں گے وابستۂ الک ہم\r\nہر حال میں غرض عشقؔ داد جنوں ہے دینی\r\nسر پھوڑتے فلک سے ہوتے اگر ملک ہم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
