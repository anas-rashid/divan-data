      "RadifLetter": "ا"
    },
    {
      "Id": 338,
      "Title": "لٹاؤ جان تو بنتی ہے بات کس نے کہا",
      "FullUrl": "/p20/ghazal/sh338",
      "RadifLetter": "ا"
    },
    {
      "Id": 348,
      "Title": "یاروں کے اخلاص سے پہلے دل کا مرے یہ حال نہ تھا",
      "FullUrl": "/p20/ghazal/sh348",
      "RadifLetter": "ا"
    },
    {
      "Id": 330,
      "Title": "زبان بند رہی دل کا مدعا نہ کہا",
      "FullUrl": "/p20/ghazal/sh330",
      "RadifLetter": "ا"
    },
    {
      "Id": 345,
      "Title": "کون سنتا ہے صرف ذات کی بات",
