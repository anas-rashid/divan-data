  "Poems": [
    {
      "Id": 5379,
      "Title": "عشق صادق جو اسیر طمع خام نہ تھا",
      "FullUrl": "/p202/ghazal/c545/sh5379"
    },
    {
      "Id": 5371,
      "Title": "جب اپنے دل پہ اپنا کچھ اختیار دیکھا",
      "FullUrl": "/p202/ghazal/c545/sh5371"
    },
    {
      "Id": 5387,
      "Title": "پوچھو نہ کچھ ثبوت خرد میں نے کیا دیا",
      "FullUrl": "/p202/ghazal/c545/sh5387"
    },
    {
      "Id": 5374,
      "Title": "حسن کو سمجھتا ہے عشق ہم زباں اپنا",
      "FullUrl": "/p202/ghazal/c545/sh5374"
    },
    {
      "Id": 5367,
      "Title": "اک حسیں کو دل دے کر کیا بتائیں کیا پایا",
      "FullUrl": "/p202/ghazal/c545/sh5367"
    },
    {
      "Id": 5390,
      "Title": "گم انہیں میں ہوں ان کا دھیان کب نہیں آتا",
      "FullUrl": "/p202/ghazal/c545/sh5390"
    },
    {
      "Id": 5381,
      "Title": "فرق جب لذت احساس میں پایا نہ گیا",
      "FullUrl": "/p202/ghazal/c545/sh5381"
    },
    {
      "Id": 5377,
      "Title": "راز چشم مے گوں ہے کیف مدعا میرا",
      "FullUrl": "/p202/ghazal/c545/sh5377"
    },
    {
      "Id": 5369,
      "Title": "برہم کن دل یوں کبھی برہم نہ ہوا تھا",
      "FullUrl": "/p202/ghazal/c545/sh5369"
    },
    {
      "Id": 5380,
      "Title": "غم کا گماں یقین طرب سے بدل گیا",
      "FullUrl": "/p202/ghazal/c545/sh5380"
    },
    {
      "Id": 5382,
      "Title": "لائے گی رنگ آپ کی یہ دل لگی کچھ اور",
      "FullUrl": "/p202/ghazal/c545/sh5382"
    },
    {
      "Id": 5373,
      "Title": "حسن ان کا اپنے ذوق دید میں پاتا ہوں میں",
      "FullUrl": "/p202/ghazal/c545/sh5373"
    },
    {
      "Id": 5368,
      "Title": "اے کشمکش الفت جی سخت پریشاں ہے",
      "FullUrl": "/p202/ghazal/c545/sh5368"
    },
    {
      "Id": 5372,
      "Title": "جس کے ایماں پر بت کافر ہنسے",
      "FullUrl": "/p202/ghazal/c545/sh5372"
    },
    {
      "Id": 5385,
      "Title": "ناز بت مہوش پر قربان دل و جاں ہے",
      "FullUrl": "/p202/ghazal/c545/sh5385"
    }
  ]
}
