  "Poems": [
    {
      "Id": 5440,
      "Title": "شور اب عالم میں ہے اس شعبدہ پرداز کا",
      "FullUrl": "/p205/ghazal/sh5440",
      "RadifLetter": "ا"
    },
    {
      "Id": 5437,
      "Title": "جس دل میں تری زلف کا سودا نہیں ہوتا",
      "FullUrl": "/p205/ghazal/sh5437",
      "RadifLetter": "ا"
    },
    {
      "Id": 5441,
      "Title": "عاشقوں کو اے فلک دیوے گا تو آزار کیا",
      "FullUrl": "/p205/ghazal/sh5441",
      "RadifLetter": "ا"
    },
    {
      "Id": 5444,
      "Title": "نہ چھوڑی غم نے مرے اک جگر میں خون کی بوند",
      "FullUrl": "/p205/ghazal/sh5444",
      "RadifLetter": "ر"
    },
    {
      "Id": 5438,
      "Title": "جو ہوتا آہ تری آہ بے اثر میں اثر",
      "FullUrl": "/p205/ghazal/sh5438",
      "RadifLetter": "ر"
    },
    {
      "Id": 5448,
      "Title": "کچھ کم نہیں ہیں شمع سے دل کی لگن میں ہم",
      "FullUrl": "/p205/ghazal/sh5448",
      "RadifLetter": "م"
    },
    {
      "Id": 5442,
      "Title": "میرا شکوہ تری محفل میں عدو کرتے ہیں",
      "FullUrl": "/p205/ghazal/sh5442",
      "RadifLetter": "ن"
    },
    {
      "Id": 5439,
      "Title": "دوست جب دل سا آشنا ہی نہیں",
      "FullUrl": "/p205/ghazal/sh5439",
      "RadifLetter": "ن"
    },
    {
      "Id": 5445,
      "Title": "پھرا کسی کا الٰہی کسی سے یار نہ ہو",
      "FullUrl": "/p205/ghazal/sh5445",
      "RadifLetter": "و"
    },
    {
      "Id": 5443,
      "Title": "میں برا ہی سہی بھلا نہ سہی",
      "FullUrl": "/p205/ghazal/sh5443",
      "RadifLetter": "ی"
    },
    {
      "Id": 5447,
      "Title": "کسی کی نیک ہو یا بد جہاں میں خو نہیں چھپتی",
      "FullUrl": "/p205/ghazal/sh5447",
      "RadifLetter": "ی"
    },
    {
      "Id": 5435,
      "Title": "تو ہی انصاف سے کہہ جس کا خفا یار رہے",
      "FullUrl": "/p205/ghazal/sh5435",
      "RadifLetter": "ے"
    },
    {
      "Id": 5446,
      "Title": "پھول اللہ نے بنائے ہیں مہکنے کے لیے",
      "FullUrl": "/p205/ghazal/sh5446",
      "RadifLetter": "ے"
    },
    {
      "Id": 5449,
      "Title": "کیا ہوئے عاشق اس شکر لب کے",
      "FullUrl": "/p205/ghazal/sh5449",
      "RadifLetter": "ے"
    },
    {
      "Id": 5436,
      "Title": "جرأت اے دل مے و مینا ہے وہ خود کام بھی ہے",
      "FullUrl": "/p205/ghazal/sh5436",
      "RadifLetter": "ے"
    },
    {
      "Id": 5434,
      "Title": "باتیں نہ کس نے ہم کو کہیں تیرے واسطے",
      "FullUrl": "/p205/ghazal/sh5434",
      "RadifLetter": "ے"
    }
  ]
}
