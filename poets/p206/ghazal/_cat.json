    {
      "Id": 5452,
      "Title": "مرے پہلو سے جو نکلے وہ مری جاں ہو کر",
      "FullUrl": "/p206/ghazal/sh5452",
      "RadifLetter": "ر"
    },
    {
      "Id": 5455,
      "Title": "کبھی صورت جو مجھے آ کے دکھا جاتے ہو",
      "FullUrl": "/p206/ghazal/sh5455",
      "RadifLetter": "و"
    },
    {
      "Id": 5454,
      "Title": "پھر وہی ہم ہیں خیال رخ زیبا ہے وہی",
      "FullUrl": "/p206/ghazal/sh5454",
      "RadifLetter": "ی"
    },
    {
      "Id": 5457,
      "Title": "کٹ گئی بے مدعا ساری کی ساری زندگی",
      "FullUrl": "/p206/ghazal/sh5457",
      "RadifLetter": "ی"
    },
    {
      "Id": 5458,
      "Title": "کہتے ہیں عید ہے آج اپنی بھی عید ہوتی",
      "FullUrl": "/p206/ghazal/sh5458",
      "RadifLetter": "ی"
    },
    {
      "Id": 5456,
      "Title": "کس طرح واقف ہوں حال عاشق جاں باز سے",
      "FullUrl": "/p206/ghazal/sh5456",
      "RadifLetter": "ے"
    },
    {
      "Id": 5451,
      "Title": "اک ہجوم غم و کلفت ہے خدا خیر کرے",
