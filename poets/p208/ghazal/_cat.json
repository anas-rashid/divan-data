  "ChildCats": [],
  "Poems": [
    {
      "Id": 5460,
      "Title": "آئے ہو تو یہ حجاب کیا ہے",
      "FullUrl": "/p208/ghazal/sh5460"
    },
    {
      "Id": 5461,
      "Title": "آتا ہے کس انداز سے ٹک ناز تو دیکھو",
      "FullUrl": "/p208/ghazal/sh5461"
    },
    {
      "Id": 5462,
      "Title": "آتا ہے یہی جی میں فریاد کروں روؤں",
      "FullUrl": "/p208/ghazal/sh5462"
    },
    {
      "Id": 5463,
      "Title": "آتش غم میں بس کہ جلتے ہیں",
      "FullUrl": "/p208/ghazal/sh5463"
    },
    {
      "Id": 5464,
      "Title": "آج خوں ہو کے ٹپک پڑنے کے نزدیک ہے دل",
      "FullUrl": "/p208/ghazal/sh5464"
    },
    {
      "Id": 5465,
      "Title": "آج پلکوں کو جاتے ہیں آنسو",
      "FullUrl": "/p208/ghazal/sh5465"
    },
    {
      "Id": 5466,
      "Title": "آساں نہیں ہے تنہا در اس کا باز کرنا",
      "FullUrl": "/p208/ghazal/sh5466"
    },
    {
      "Id": 5467,
      "Title": "آنا ہے یوں محال تو اک شب بہ خواب آ",
      "FullUrl": "/p208/ghazal/sh5467"
    },
    {
      "Id": 5468,
      "Title": "آنکھوں کو پھوڑ ڈالوں یا دل کو توڑ ڈالوں",
      "FullUrl": "/p208/ghazal/sh5468"
    },
    {
      "Id": 5469,
      "Title": "آنکھیں ہیں جوش اشک سے پنگھٹ",
      "FullUrl": "/p208/ghazal/sh5469"
    },
    {
      "Id": 5470,
      "Title": "آہ دیکھی تھی میں جس گھر میں پری کی صورت",
      "FullUrl": "/p208/ghazal/sh5470"
    },
    {
      "Id": 5471,
      "Title": "آہ ہم راز کون ہے اپنا",
      "FullUrl": "/p208/ghazal/sh5471"
    },
    {
      "Id": 5472,
      "Title": "اب مجھ کو گلے لگاؤ صاحب",
      "FullUrl": "/p208/ghazal/sh5472"
    },
    {
      "Id": 5473,
      "Title": "ابھی اپنے مرتبۂ حسن سے میاں با خبر تو ہوا نہیں",
      "FullUrl": "/p208/ghazal/sh5473"
    },
    {
      "Id": 5474,
      "Title": "ادھر سے جھانکتے ہیں گہہ ادھر سے دیکھ لیتے ہیں",
      "FullUrl": "/p208/ghazal/sh5474"
    },
    {
      "Id": 5475,
      "Title": "از بس بھلا لگے ہے تو میرے یار مجھ کو",
      "FullUrl": "/p208/ghazal/sh5475"
    },
    {
      "Id": 5476,
      "Title": "ازبسکہ جی ہے تجھ بن بیزار زندگی سے",
      "FullUrl": "/p208/ghazal/sh5476"
    },
    {
      "Id": 5477,
      "Title": "اس بت کو نہیں ہے ڈر خدا سے",
      "FullUrl": "/p208/ghazal/sh5477"
    },
    {
      "Id": 5478,
      "Title": "اس رشک مہ کی یاد دلاتی ہے چاندنی",
      "FullUrl": "/p208/ghazal/sh5478"
    },
    {
      "Id": 5479,
      "Title": "اس عشق و جنوں میں نہ گریبان کا ڈر ہے",
      "FullUrl": "/p208/ghazal/sh5479"
    },
    {
      "Id": 5480,
      "Title": "اس قدر بھی تو مری جان نہ ترسایا کر",
      "FullUrl": "/p208/ghazal/sh5480"
    },
    {
      "Id": 5481,
      "Title": "اس مرگ کو کب نہیں میں سمجھا",
      "FullUrl": "/p208/ghazal/sh5481"
    },
    {
      "Id": 5482,
      "Title": "اس نازنیں کی باتیں کیا پیاری پیاریاں ہیں",
      "FullUrl": "/p208/ghazal/sh5482"
    },
    {
      "Id": 5483,
      "Title": "اس نے کر وسمہ جو فندق پہ جمائی مہندی",
      "FullUrl": "/p208/ghazal/sh5483"
    },
    {
      "Id": 5484,
      "Title": "اس کے خط میں جو لکھا غیر کا میں نام الٹا",
      "FullUrl": "/p208/ghazal/sh5484"
    },
    {
      "Id": 5485,
      "Title": "اس کے کوچے کی طرف تھا شب جو دنگا آگ کا",
      "FullUrl": "/p208/ghazal/sh5485"
    },
    {
      "Id": 5486,
      "Title": "اس گلشن پر خار سے مانند صبا بھاگ",
      "FullUrl": "/p208/ghazal/sh5486"
    },
    {
      "Id": 5487,
      "Title": "اس گلی میں جو ہم کو لائے قدم",
      "FullUrl": "/p208/ghazal/sh5487"
    },
    {
      "Id": 5488,
      "Title": "اس گوشۂ عزلت میں تنہائی ہے اور میں ہوں",
      "FullUrl": "/p208/ghazal/sh5488"
    },
    {
      "Id": 5489,
      "Title": "ان آنکھوں سے آب کچھ نہ نکلا",
      "FullUrl": "/p208/ghazal/sh5489"
    },
    {
      "Id": 5490,
      "Title": "او میاں بانکے ہے کہاں کی چال",
      "FullUrl": "/p208/ghazal/sh5490"
    },
    {
      "Id": 5491,
      "Title": "اول تو ترے کوچے میں آنا نہیں ملتا",
      "FullUrl": "/p208/ghazal/sh5491"
    },
    {
      "Id": 5492,
      "Title": "اول تو یہ دھج اور یہ رفتار غضب ہے",
      "FullUrl": "/p208/ghazal/sh5492"
    },
    {
      "Id": 5493,
      "Title": "اپنا رفیق و آشنا غیر خدا کوئی نہیں",
      "FullUrl": "/p208/ghazal/sh5493"
    },
    {
      "Id": 5494,
      "Title": "اک حرف کن میں جس نے کون و مکاں بنایا",
      "FullUrl": "/p208/ghazal/sh5494"
    },
    {
      "Id": 5495,
      "Title": "اہل دل گر جہاں سے اٹھتا ہے",
      "FullUrl": "/p208/ghazal/sh5495"
    },
    {
      "Id": 5496,
      "Title": "ایسا بھی کوئی کرے ہے خلل ملک دیں میں بت",
      "FullUrl": "/p208/ghazal/sh5496"
    },
    {
      "Id": 5497,
      "Title": "ایسے ڈرے ہیں کس کی نگاہ غضب سے ہم",
      "FullUrl": "/p208/ghazal/sh5497"
    },
    {
      "Id": 5498,
      "Title": "ایک تو بیٹھے ہو دل کو مرے کھو اور سنو",
      "FullUrl": "/p208/ghazal/sh5498"
    },
    {
      "Id": 5499,
      "Title": "اے شب ہجر کہیں تیری سحر ہے کہ نہیں",
      "FullUrl": "/p208/ghazal/sh5499"
    },
    {
      "Id": 5500,
      "Title": "اے عشق تیری اب کے وہ تاثیر کیا ہوئی",
      "FullUrl": "/p208/ghazal/sh5500"
    },
    {
      "Id": 5501,
      "Title": "اے غم زدہ ضبط کر کے چلنا",
      "FullUrl": "/p208/ghazal/sh5501"
    },
    {
      "Id": 5502,
      "Title": "بات کو میری الگ ہو کے نہ شرماؤ سنو",
      "FullUrl": "/p208/ghazal/sh5502"
    },
    {
      "Id": 5503,
      "Title": "باغ تھا اس میں آشیاں بھی تھا",
      "FullUrl": "/p208/ghazal/sh5503"
    },
    {
      "Id": 5504,
      "Title": "بحث اس کی میری وقت ملاقات بڑھ گئی",
      "FullUrl": "/p208/ghazal/sh5504"
    },
    {
      "Id": 5505,
      "Title": "برق رخسار یار پھر چمکی",
      "FullUrl": "/p208/ghazal/sh5505"
    },
    {
      "Id": 5506,
      "Title": "بزم سرود خوباں میں گو مردنگیں شاہین بجیں",
      "FullUrl": "/p208/ghazal/sh5506"
    },
    {
      "Id": 5507,
      "Title": "بس ہم ہیں شب اور کراہنا ہے",
      "FullUrl": "/p208/ghazal/sh5507"
    },
    {
      "Id": 5508,
      "Title": "بعد مردن کی بھی تدبیر کیے جاتا ہوں",
      "FullUrl": "/p208/ghazal/sh5508"
    },
    {
      "Id": 5509,
      "Title": "بلبلو باغباں کو کیوں چھیڑا",
      "FullUrl": "/p208/ghazal/sh5509"
    },
    {
      "Id": 5510,
      "Title": "بنایا ایک کافر کے تئیں اس دم میں دو کافر",
      "FullUrl": "/p208/ghazal/sh5510"
    },
    {
      "Id": 5511,
      "Title": "بند بھی آنکھوں کو ذری کیجیے",
      "FullUrl": "/p208/ghazal/sh5511"
    },
    {
      "Id": 5512,
      "Title": "بوئیے مزرع دل میں جو عنایات کے بیج",
      "FullUrl": "/p208/ghazal/sh5512"
    },
    {
      "Id": 5513,
      "Title": "بچا گر ناز سے تو اس کو پھر انداز سے مارا",
      "FullUrl": "/p208/ghazal/sh5513"
    },
    {
      "Id": 5514,
      "Title": "بکتے ہیں شہر میں گل بے خار ہر طرف",
      "FullUrl": "/p208/ghazal/sh5514"
    },
    {
      "Id": 5515,
      "Title": "بھری آتی ہیں ہر گھڑی آنکھیں",
      "FullUrl": "/p208/ghazal/sh5515"
    },
    {
      "Id": 5516,
      "Title": "بیٹھے بیٹھے جو ہم اے یار ہنسے اور روئے",
      "FullUrl": "/p208/ghazal/sh5516"
    },
    {
      "Id": 5517,
      "Title": "بے لاگ ہیں ہم ہم کو رکاوٹ نہیں آتی",
      "FullUrl": "/p208/ghazal/sh5517"
    },
    {
      "Id": 5518,
      "Title": "تجھ بن تو کبھی گل کے تئیں بو نہ کروں میں",
      "FullUrl": "/p208/ghazal/sh5518"
    },
    {
      "Id": 5519,
      "Title": "تجھ سے گر وہ دلا نہیں ملتا",
      "FullUrl": "/p208/ghazal/sh5519"
    },
    {
      "Id": 5520,
      "Title": "تختۂ آب چمن کیوں نہ نظر آوے سپاٹ",
      "FullUrl": "/p208/ghazal/sh5520"
    },
    {
      "Id": 5521,
      "Title": "ترا شوق دیدار پیدا ہوا ہے",
      "FullUrl": "/p208/ghazal/sh5521"
    },
    {
      "Id": 5522,
      "Title": "ترسا نہ مجھ کو کھینچ کے تلوار مار ڈال",
      "FullUrl": "/p208/ghazal/sh5522"
    },
    {
      "Id": 5523,
      "Title": "ترے منہ چھپاتے ہی پھر مجھے خبر اپنی کچھ نہ ذری رہی",
      "FullUrl": "/p208/ghazal/sh5523"
    },
    {
      "Id": 5524,
      "Title": "تصور تیری صورت کا مجھے ہر شب ستاتا ہے",
      "FullUrl": "/p208/ghazal/sh5524"
    },
    {
      "Id": 5525,
      "Title": "تم بانکپن یہ اپنا دکھاتے ہو ہم کو کیا",
      "FullUrl": "/p208/ghazal/sh5525"
    },
    {
      "Id": 5526,
      "Title": "تم بھی آؤگے مرے گھر جو صنم کیا ہوگا",
      "FullUrl": "/p208/ghazal/sh5526"
    },
    {
      "Id": 5527,
      "Title": "تم گرم ملے ہم سے نہ سرما کے دنوں میں",
      "FullUrl": "/p208/ghazal/sh5527"
    },
    {
      "Id": 5528,
      "Title": "تمہاری اور مری کج ادائیاں ہی رہیں",
      "FullUrl": "/p208/ghazal/sh5528"
    },
    {
      "Id": 5529,
      "Title": "تو دیکھے تو اک نظر بہت ہے",
      "FullUrl": "/p208/ghazal/sh5529"
    },
    {
      "Id": 5530,
      "Title": "تھا جو شعر راست سرو بوستان ریختہ",
      "FullUrl": "/p208/ghazal/sh5530"
    },
    {
      "Id": 5531,
      "Title": "جاتے جاتے راہ میں اس نے منہ سے اٹھایا جوں ہی پردا",
      "FullUrl": "/p208/ghazal/sh5531"
    },
    {
      "Id": 5532,
      "Title": "جانے دے ٹک چمن میں مجھے اے صبا سرک",
      "FullUrl": "/p208/ghazal/sh5532"
    },
    {
      "Id": 5533,
      "Title": "جب تک کہ تری گالیاں کھانے کے نہیں ہم",
      "FullUrl": "/p208/ghazal/sh5533"
    },
    {
      "Id": 5534,
      "Title": "جب تک یہ محبت میں بد نام نہیں ہوتا",
      "FullUrl": "/p208/ghazal/sh5534"
    },
    {
      "Id": 5535,
      "Title": "جب سے صانع نے بنایا ہے جہاں کا بہروپ",
      "FullUrl": "/p208/ghazal/sh5535"
    },
    {
      "Id": 5536,
      "Title": "جب نبی صاحب میں کوہ و دشت سے آئی بسنت",
      "FullUrl": "/p208/ghazal/sh5536"
    },
    {
      "Id": 5537,
      "Title": "جب کہ بے پردہ تو ہوا ہوگا",
      "FullUrl": "/p208/ghazal/sh5537"
    },
    {
      "Id": 5538,
      "Title": "جب گھر سے وہ بعد ماہ نکلے",
      "FullUrl": "/p208/ghazal/sh5538"
    },
    {
      "Id": 5539,
      "Title": "جلتا ہے جگر تو چشم نم ہے",
      "FullUrl": "/p208/ghazal/sh5539"
    },
    {
      "Id": 5540,
      "Title": "جلوہ گر اس کا سراپا ہے بدن آئنے میں",
      "FullUrl": "/p208/ghazal/sh5540"
    },
    {
      "Id": 5541,
      "Title": "جمنا میں کل نہا کر جب اس نے بال باندھے",
      "FullUrl": "/p208/ghazal/sh5541"
    },
    {
      "Id": 5542,
      "Title": "جو دم حقے کا دوں بولے کہ ”میں حقا نہیں پیتا”",
      "FullUrl": "/p208/ghazal/sh5542"
    },
    {
      "Id": 5543,
      "Title": "جو پری بھی روبرو ہو تو پری کو میں نہ دیکھوں",
      "FullUrl": "/p208/ghazal/sh5543"
    },
    {
      "Id": 5544,
      "Title": "جوں ہی زنجیر کے پاس آئے پاؤں",
      "FullUrl": "/p208/ghazal/sh5544"
    },
    {
      "Id": 5545,
      "Title": "جُو پھرا کہ اس نے منہ کو بہ قفا نقاب الٹا",
      "FullUrl": "/p208/ghazal/sh5545"
    },
    {
      "Id": 5546,
      "Title": "جی سے مجھے چاہ ہے کسی کی",
      "FullUrl": "/p208/ghazal/sh5546"
    },
    {
      "Id": 5547,
      "Title": "جیتا رہوں کہ ہجر میں مر جاؤں کیا کروں",
      "FullUrl": "/p208/ghazal/sh5547"
    },
    {
      "Id": 5548,
      "Title": "حال دل بے قرار ہے اور",
      "FullUrl": "/p208/ghazal/sh5548"
    },
    {
      "Id": 5549,
      "Title": "خدا کی قسم پھر تو کیا خیر ہووے",
      "FullUrl": "/p208/ghazal/sh5549"
    },
    {
      "Id": 5550,
      "Title": "خریدار اپنا ہم کو جانتے ہو",
      "FullUrl": "/p208/ghazal/sh5550"
    },
    {
      "Id": 5551,
      "Title": "خواب تھا یا خیال تھا کیا تھا",
      "FullUrl": "/p208/ghazal/sh5551"
    },
    {
      "Id": 5552,
      "Title": "خواریاں بدنامیاں رسوائیاں",
      "FullUrl": "/p208/ghazal/sh5552"
    },
    {
      "Id": 5553,
      "Title": "خوش طالعی میں شمس و قمر دونوں ایک ہیں",
      "FullUrl": "/p208/ghazal/sh5553"
    },
    {
      "Id": 5554,
      "Title": "در تلک آ کے ٹک آواز سنا جاؤ جی",
      "FullUrl": "/p208/ghazal/sh5554"
    },
    {
      "Id": 5555,
      "Title": "در تلک جانے کی ہے اس کے مناہی ہم کو",
      "FullUrl": "/p208/ghazal/sh5555"
    },
    {
      "Id": 5556,
      "Title": "دریاے عاشقی میں جو تھے گھاٹ گھاٹ سانپ",
      "FullUrl": "/p208/ghazal/sh5556"
    },
    {
      "Id": 5557,
      "Title": "دل خوش نہ ہوا زلف پریشاں سے نکل کر",
      "FullUrl": "/p208/ghazal/sh5557"
    },
    {
      "Id": 5558,
      "Title": "دل سینے میں بیتاب ہے دل دار کدھر ہے",
      "FullUrl": "/p208/ghazal/sh5558"
    },
    {
      "Id": 5559,
      "Title": "دل میں مرغان چمن کے تو گماں اور ہی ہے",
      "FullUrl": "/p208/ghazal/sh5559"
    },
    {
      "Id": 5560,
      "Title": "دل میں ہے اس کے مدعی کا عشق",
      "FullUrl": "/p208/ghazal/sh5560"
    },
    {
      "Id": 5561,
      "Title": "دل چرانا یہ کام ہے تیرا",
      "FullUrl": "/p208/ghazal/sh5561"
    },
    {
      "Id": 5562,
      "Title": "دل کو یہ اضطرار کیسا ہے",
      "FullUrl": "/p208/ghazal/sh5562"
    },
    {
      "Id": 5563,
      "Title": "دل کے نگر میں چار طرف جب غم کی دہائی بیٹھ گئی",
      "FullUrl": "/p208/ghazal/sh5563"
    },
    {
      "Id": 5564,
      "Title": "دلبر کی تمنائے بر دوش میں مر جائے",
      "FullUrl": "/p208/ghazal/sh5564"
    },
    {
      "Id": 5565,
      "Title": "دلی ہوئی ہے ویراں سونے کھنڈر پڑے ہیں",
      "FullUrl": "/p208/ghazal/sh5565"
    },
