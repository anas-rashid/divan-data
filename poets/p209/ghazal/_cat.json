  "Poems": [
    {
      "Id": 5747,
      "Title": "یہ دل ہی جلوہ گاہ ہے اس خوش خرام کا",
      "FullUrl": "/p209/ghazal/sh5747",
      "RadifLetter": "ا"
    },
    {
      "Id": 5731,
      "Title": "اشک آنکھوں کے اندر نہ رہا ہے نہ رہے گا",
      "FullUrl": "/p209/ghazal/sh5731",
      "RadifLetter": "ا"
    },
    {
      "Id": 5741,
      "Title": "محزوں نہ ہو حضورؔ اب آتا ہے یار اپنا",
      "FullUrl": "/p209/ghazal/sh5741",
      "RadifLetter": "ا"
    },
    {
      "Id": 5730,
      "Title": "اس شوخ سے کیا کیجئے اظہار تمنا",
      "FullUrl": "/p209/ghazal/sh5730",
      "RadifLetter": "ا"
    },
    {
      "Id": 5737,
      "Title": "شجر باغ جہاں کا تھا جہاں تک سب ثمر لایا",
      "FullUrl": "/p209/ghazal/sh5737",
      "RadifLetter": "ا"
    },
    {
      "Id": 5732,
      "Title": "بعد مکیں مکاں کا گر بام رہا تو کیا ہوا",
      "FullUrl": "/p209/ghazal/sh5732",
      "RadifLetter": "ا"
    },
    {
      "Id": 5729,
      "Title": "آنکھوں کا خدا ہی ہے یہ آنسو کی ہے گر موج",
      "FullUrl": "/p209/ghazal/sh5729",
      "RadifLetter": "ج"
    },
    {
      "Id": 5745,
      "Title": "ہر شجر کے تئیں ہوتا ہے ثمر سے پیوند",
      "FullUrl": "/p209/ghazal/sh5745",
      "RadifLetter": "د"
    },
    {
      "Id": 5743,
      "Title": "کیا رفو کرنے لگا ہے جا بھی ناداں یک طرف",
      "FullUrl": "/p209/ghazal/sh5743",
      "RadifLetter": "ف"
    },
    {
      "Id": 5744,
      "Title": "گلعذار اور بھی یوں رکھتے ہیں رنگ اور نمک",
      "FullUrl": "/p209/ghazal/sh5744",
      "RadifLetter": "ک"
    },
    {
      "Id": 5738,
      "Title": "عمر گئی الفت زر جی سے الٰہی نہ گئی",
      "FullUrl": "/p209/ghazal/sh5738",
      "RadifLetter": "ی"
    },
    {
      "Id": 5733,
      "Title": "جب سے گیا ہے وہ مرا ایمان زندگی",
      "FullUrl": "/p209/ghazal/sh5733",
      "RadifLetter": "ی"
    },
    {
      "Id": 5728,
      "Title": "آبرو الفت میں اگر چاہئے",
      "FullUrl": "/p209/ghazal/sh5728",
      "RadifLetter": "ے"
    },
    {
      "Id": 5734,
      "Title": "جو یوں آپ بیرون در جائیں گے",
      "FullUrl": "/p209/ghazal/sh5734",
      "RadifLetter": "ے"
    },
    {
      "Id": 5742,
      "Title": "ٹک دیکھیو یہ ابروئے خم دار وہی ہے",
      "FullUrl": "/p209/ghazal/sh5742",
      "RadifLetter": "ے"
    },
    {
      "Id": 5727,
      "Title": "آئنہ ہے یہ جہاں اس میں جمال اپنا ہے",
      "FullUrl": "/p209/ghazal/sh5727",
      "RadifLetter": "ے"
    },
    {
      "Id": 5735,
      "Title": "جہاں میں کہاں باہم الفت رہی ہے",
      "FullUrl": "/p209/ghazal/sh5735",
      "RadifLetter": "ے"
    },
    {
      "Id": 5736,
      "Title": "دل بہ از کعبہ ہے یاراں جبہ سائی چاہیے",
      "FullUrl": "/p209/ghazal/sh5736",
      "RadifLetter": "ے"
    },
    {
      "Id": 5746,
      "Title": "یوں تو دل ہر کدام رکھتا ہے",
      "FullUrl": "/p209/ghazal/sh5746",
      "RadifLetter": "ے"
    },
    {
      "Id": 5740,
      "Title": "مجھ سے مڑنے کی نیں کسی رو سے",
      "FullUrl": "/p209/ghazal/sh5740",
      "RadifLetter": "ے"
    },
    {
      "Id": 5739,
      "Title": "غیر آئے پیچھے پا گئے مجرے کا بار پہلے",
