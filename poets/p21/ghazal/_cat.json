    },
    {
      "Id": 406,
      "Title": "مجھے اپنی پستی کی شرم ہے تری رفعتوں کا خیال ہے",
      "FullUrl": "/p21/ghazal/sh406"
    },
    {
      "Id": 420,
      "Title": "نہ چھیڑ زاہد ناداں شراب پینے دے",
      "FullUrl": "/p21/ghazal/sh420"
    },
    {
      "Id": 385,
      "Title": "خیالستان ہستی میں اگر غم ہے خوشی بھی ہے",
