  "Poems": [
    {
      "Id": 431,
      "Title": "کچھ تو تنہائی کی راتوں میں سہارا ہوتا",
      "FullUrl": "/p21/ghazal/sh431"
    },
    {
      "Id": 353,
      "Title": "آرزو وصل کی رکھتی ہے پریشاں کیا کیا",
      "FullUrl": "/p21/ghazal/sh353"
    },
    {
      "Id": 417,
      "Title": "نہ تمہارا حسن جواں رہا نہ ہمارا عشق جواں رہا",
      "FullUrl": "/p21/ghazal/sh417"
    },
    {
      "Id": 421,
      "Title": "وعدہ اس ماہرو کے آنے کا",
      "FullUrl": "/p21/ghazal/sh421"
    },
    {
      "Id": 371,
      "Title": "بجھا سا رہتا ہے دل جب سے ہیں وطن سے جدا",
      "FullUrl": "/p21/ghazal/sh371"
    },
    {
      "Id": 390,
      "Title": "دل میں خیال نرگس جانانہ آ گیا",
      "FullUrl": "/p21/ghazal/sh390"
    },
    {
      "Id": 389,
      "Title": "دل مہجور کو تسکین کا ساماں نہ ملا",
      "FullUrl": "/p21/ghazal/sh389"
    },
    {
      "Id": 388,
      "Title": "دل شکستہ حریف شباب ہو نہ سکا",
      "FullUrl": "/p21/ghazal/sh388"
    },
    {
      "Id": 415,
      "Title": "نکہت زلف سے نیندوں کو بسا دے آ کر",
      "FullUrl": "/p21/ghazal/sh415"
    },
    {
      "Id": 402,
      "Title": "غم خانۂ ہستی میں ہے مہماں کوئی دن اور",
      "FullUrl": "/p21/ghazal/sh402"
    },
    {
      "Id": 384,
      "Title": "حزیں ہے بیکس و رنجور ہے دل",
      "FullUrl": "/p21/ghazal/sh384"
    },
    {
      "Id": 352,
      "Title": "آؤ بے پردہ تمہیں جلوۂ پنہاں کی قسم",
      "FullUrl": "/p21/ghazal/sh352"
    },
    {
      "Id": 435,
      "Title": "گلزار جہاں میں گل کی طرح گو شاد ہیں ہم شاداب ہیں ہم",
      "FullUrl": "/p21/ghazal/sh435"
    },
    {
      "Id": 427,
      "Title": "کام آ سکیں نہ اپنی وفائیں تو کیا کریں",
      "FullUrl": "/p21/ghazal/sh427"
    },
    {
      "Id": 408,
      "Title": "محبت کی دنیا میں مشہور کر دوں",
      "FullUrl": "/p21/ghazal/sh408"
    },
    {
      "Id": 359,
      "Title": "ان کو بلائیں اور وہ نہ آئیں تو کیا کریں",
      "FullUrl": "/p21/ghazal/sh359"
    },
    {
      "Id": 378,
      "Title": "تمناؤں کو زندہ آرزوؤں کو جواں کر لوں",
      "FullUrl": "/p21/ghazal/sh378"
    },
    {
      "Id": 424,
      "Title": "وہ کہتے ہیں رنجش کی باتیں بھلا دیں",
      "FullUrl": "/p21/ghazal/sh424"
    },
    {
      "Id": 440,
      "Title": "یارو کوئے یار کی باتیں کریں",
      "FullUrl": "/p21/ghazal/sh440"
    },
    {
      "Id": 429,
      "Title": "کس کی آنکھوں کا لیے دل پہ اثر جاتے ہیں",
      "FullUrl": "/p21/ghazal/sh429"
    },
    {
      "Id": 404,
      "Title": "لا پلا ساقی شراب ارغوانی پھر کہاں",
      "FullUrl": "/p21/ghazal/sh404"
    },
    {
      "Id": 410,
      "Title": "مری شام غم کو وہ بہلا رہے ہیں",
      "FullUrl": "/p21/ghazal/sh410"
    },
    {
      "Id": 441,
      "Title": "یقین وعدہ نہیں تاب انتظار نہیں",
      "FullUrl": "/p21/ghazal/sh441"
    },
    {
      "Id": 400,
      "Title": "عمر بھر کی تلخ بیداری کا ساماں ہو گئیں",
      "FullUrl": "/p21/ghazal/sh400"
    },
    {
      "Id": 438,
      "Title": "ہمارے ہاتھ میں کب ساغر شراب نہیں",
      "FullUrl": "/p21/ghazal/sh438"
    },
    {
      "Id": 387,
      "Title": "دل دیوانہ و انداز بیباکانہ رکھتے ہیں",
      "FullUrl": "/p21/ghazal/sh387"
    },
    {
      "Id": 362,
      "Title": "اگر اے نسیم سحر ترا ہو گزر دیار حجاز میں",
      "FullUrl": "/p21/ghazal/sh362"
    },
    {
      "Id": 411,
      "Title": "میں آرزوئے جاں لکھوں یا جان آرزو!",
      "FullUrl": "/p21/ghazal/sh411"
    },
    {
      "Id": 439,
      "Title": "یاد آؤ مجھے للہ نہ تم یاد کرو",
      "FullUrl": "/p21/ghazal/sh439"
    },
    {
      "Id": 442,
      "Title": "یوں تو کس پھول سے رنگت نہ گئی بو نہ گئی",
      "FullUrl": "/p21/ghazal/sh442"
    },
    {
      "Id": 356,
      "Title": "اس مہ جبیں سے آج ملاقات ہو گئی",
      "FullUrl": "/p21/ghazal/sh356"
    },
    {
      "Id": 357,
      "Title": "اشک باری نہ مٹی سینہ فگاری نہ گئی",
      "FullUrl": "/p21/ghazal/sh357"
    },
    {
      "Id": 382,
      "Title": "جھوم کر بدلی اٹھی اور چھا گئی",
      "FullUrl": "/p21/ghazal/sh382"
    },
    {
      "Id": 403,
      "Title": "غم زمانہ نہیں اک عذاب ہے ساقی",
      "FullUrl": "/p21/ghazal/sh403"
    },
    {
      "Id": 419,
      "Title": "نہ وہ خزاں رہی باقی نہ وہ بہار رہی",
      "FullUrl": "/p21/ghazal/sh419"
    },
    {
      "Id": 418,
      "Title": "نہ ساز و مطرب نہ جام و ساقی نہ وہ بہار چمن ہے باقی",
      "FullUrl": "/p21/ghazal/sh418"
    },
    {
      "Id": 367,
      "Title": "اے دل وہ عاشقی کے فسانے کدھر گئے",
      "FullUrl": "/p21/ghazal/sh367"
    },
    {
      "Id": 433,
      "Title": "کیا کہہ گئی کسی کی نظر کچھ نہ پوچھئے",
      "FullUrl": "/p21/ghazal/sh433"
    },
    {
      "Id": 423,
      "Title": "وہ کبھی مل جائیں تو کیا کیجئے",
      "FullUrl": "/p21/ghazal/sh423"
    },
    {
      "Id": 428,
      "Title": "کس کو دیکھا ہے یہ ہوا کیا ہے",
      "FullUrl": "/p21/ghazal/sh428"
    },
    {
      "Id": 416,
      "Title": "نہ بھول کر بھی تمنائے رنگ و بو کرتے",
      "FullUrl": "/p21/ghazal/sh416"
    },
    {
      "Id": 363,
      "Title": "اگر وہ اپنے حسین چہرے کو بھول کر بے نقاب کر دے",
      "FullUrl": "/p21/ghazal/sh363"
    },
    {
      "Id": 358,
      "Title": "ان رس بھری آنکھوں میں حیا کھیل رہی ہے",
      "FullUrl": "/p21/ghazal/sh358"
    },
    {
      "Id": 354,
      "Title": "آشنا ہو کر تغافل آشنا کیوں ہو گئے",
