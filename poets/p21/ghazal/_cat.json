    },
    {
      "Id": 376,
      "Title": "بہار آئی ہے مستانہ گھٹا کچھ اور کہتی ہے",
      "FullUrl": "/p21/ghazal/sh376"
    },
    {
      "Id": 396,
      "Title": "سوئے کلکتہ جو ہم بہ دل دیوانہ چلے",
      "FullUrl": "/p21/ghazal/sh396"
    },
    {
      "Id": 393,
      "Title": "زمان ہجر مٹے دور وصل یار آئے",
      "FullUrl": "/p21/ghazal/sh393"
    },
    {
      "Id": 436,
      "Title": "ہر ایک جلوۂ رنگیں مری نگاہ میں ہے",
      "FullUrl": "/p21/ghazal/sh436"
    },
    {
      "Id": 395,
      "Title": "سما کر دل میں نظروں سے نہاں ہے",
      "FullUrl": "/p21/ghazal/sh395"
    },
    {
      "Id": 370,
      "Title": "بجا کہ ہے پاس حشر ہم کو کریں گے پاس شباب پہلے",
