      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ہر ایک جلوۂ رنگیں مری نگاہ میں ہے\r\nغم فراق کی دنیا دل تباہ میں ہے\r\nکسی کی یاد کرم اف ارے معاذ اللہ\r\nتباہ ہو کے بھی ظالم دل تباہ میں ہے\r\nہزار پردوں میں او چھپنے والے یہ سن لے\r\nترا جمال مرے دامن نگاہ میں ہے\r\nجہاں میں مجھ سے بھی ناکام آرزو کم ہیں\r\nنہ رنگ آہ میں ہے اور نہ سوز آہ میں ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
