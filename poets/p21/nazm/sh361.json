      "VOrder": 219,
      "Position": "Right",
      "Text": "تاریخ کی عبرت طاری ہے",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 220,
      "Position": "Left",
      "Text": "ان پورنا کے اجڑے مندر پر",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 221,
      "Position": "Right",
      "Text": "مایوسی و حسرت طاری ہے",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 222,
      "Position": "Left",
      "Text": "سنسان گھروں پر چھاؤنی کے",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 223,
      "Position": "Right",
      "Text": "ویرانی و رقت طاری ہے",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 224,
      "Position": "Left",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 225,
      "Position": "Right",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 226,
      "Position": "Left",
      "Text": "آخر میں یہ حسرت ہے کہ بتا",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 227,
      "Position": "Right",
      "Text": "وہ غارت ایماں کیسی ہے",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 228,
      "Position": "Left",
      "Text": "بچپن میں جو آفت ڈھاتی تھی",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 229,
      "Position": "Right",
      "Text": "وہ آفت دوراں کیسی ہے",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 230,
      "Position": "Left",
      "Text": "ہم دونوں تھے جس کے پروانے",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 231,
      "Position": "Right",
      "Text": "وہ شمع شبستاں کیسی ہے",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 232,
      "Position": "Left",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 233,
      "Position": "Right",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 234,
      "Position": "Left",
      "Text": "مرجانا تھا جس کا نام بتا",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 235,
      "Position": "Right",
      "Text": "وہ غنچہ دہن کس حال میں ہے",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 236,
      "Position": "Left",
      "Text": "جس پر تھے فدا طفلان وطن",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 237,
      "Position": "Right",
      "Text": "وہ جان وطن کس حال میں ہے",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 238,
      "Position": "Left",
      "Text": "وہ سرو چمن وہ رشک سمن",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 239,
      "Position": "Right",
      "Text": "وہ سیم بدن کس حال میں ہے",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 240,
      "Position": "Left",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 241,
      "Position": "Right",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 242,
      "Position": "Left",
      "Text": "کیا اب بھی رخ گلرنگ پہ وہ",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 243,
      "Position": "Right",
      "Text": "جنت کے نظارے روشن ہیں",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 244,
      "Position": "Left",
      "Text": "کیا اب بھی رسیلی آنکھوں میں",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 245,
      "Position": "Right",
      "Text": "ساون کے ستارے روشن ہیں",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 246,
      "Position": "Left",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 247,
      "Position": "Right",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 248,
      "Position": "Left",
      "Text": "کیا اب بھی شہابی عارض پر",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 249,
      "Position": "Right",
      "Text": "گیسوئے سیہ بل کھاتے ہیں",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 250,
      "Position": "Left",
      "Text": "یا بحر شفق کی موجوں پر",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 251,
      "Position": "Right",
      "Text": "دو ناگ پڑے لہراتے ہیں",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 252,
      "Position": "Left",
      "Text": "اور جن کی جھلک سے ساون کی",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 253,
      "Position": "Right",
      "Text": "راتوں کے سپنے آتے ہیں",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 254,
      "Position": "Left",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 255,
      "Position": "Right",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 256,
      "Position": "Left",
      "Text": "اب نام خدا ہوگی وہ جواں",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 257,
      "Position": "Right",
      "Text": "میکے میں ہے یا سسرال گئی",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 258,
      "Position": "Left",
      "Text": "دوشیزہ ہے یا آفت میں اسے",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 259,
      "Position": "Right",
      "Text": "کمبخت جوانی ڈال گئی",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 260,
      "Position": "Left",
      "Text": "گھر پر ہی رہی یا گھر سے گئی",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 261,
      "Position": "Right",
      "Text": "خوش حال رہی خوش حال گئی",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 262,
      "Position": "Left",
      "Text": "او دیس سے آنے والے بتا",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    }
  ]
}
