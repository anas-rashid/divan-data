  "Title": "غزل",
  "FullUrl": "/p210/ghazal",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 5748,
      "Title": "اس شعلہ رو سے جب سے مری آنکھ جا لگی",
      "FullUrl": "/p210/ghazal/sh5748"
    },
    {
      "Id": 5749,
      "Title": "اس کی صورت کا تصور دل میں جب لاتے ہیں ہم",
      "FullUrl": "/p210/ghazal/sh5749"
    },
    {
      "Id": 5750,
      "Title": "اس کے کوچہ میں گیا میں سو پھر آیا نہ گیا",
      "FullUrl": "/p210/ghazal/sh5750"
    },
    {
      "Id": 5751,
      "Title": "جو نہ وہم و گمان میں آوے",
      "FullUrl": "/p210/ghazal/sh5751"
    },
    {
      "Id": 5752,
      "Title": "شمع رو عاشق کو اپنے یوں جلانا چاہیئے",
      "FullUrl": "/p210/ghazal/sh5752"
    },
    {
      "Id": 5753,
      "Title": "مجھ سے آزردہ جو اس گل رو کو اب پاتے ہیں لوگ",
      "FullUrl": "/p210/ghazal/sh5753"
    },
    {
      "Id": 5754,
      "Title": "مرا اس کے پس دیوار گھر ہوتا تو کیا ہوتا",
      "FullUrl": "/p210/ghazal/sh5754"
    },
    {
      "Id": 5755,
      "Title": "مکھڑا وہ بت جدھر کرے گا",
      "FullUrl": "/p210/ghazal/sh5755"
    },
    {
      "Id": 5756,
      "Title": "میں نے ہر چند کہ اس کوچے میں جانا چھوڑا",
      "FullUrl": "/p210/ghazal/sh5756"
    },
    {
      "Id": 5757,
      "Title": "نہ پوچھ ہجر میں جو حال اب ہمارا ہے",
      "FullUrl": "/p210/ghazal/sh5757"
    }
  ]
}
