  "Poems": [
    {
      "Id": 5758,
      "Title": "ابرو نے ترے کھینچی کماں جور و جفا پر",
      "FullUrl": "/p211/ghazal/sh5758"
    },
    {
      "Id": 5759,
      "Title": "ایک پل جا نہ کہوں نین سوں اے نور بصر",
      "FullUrl": "/p211/ghazal/sh5759"
    },
    {
      "Id": 5760,
      "Title": "اے جان شب ہجراں تری سخت بڑی ہے",
      "FullUrl": "/p211/ghazal/sh5760"
    },
    {
      "Id": 5761,
      "Title": "اے خوب رو فرشتہ سیر انجمن میں آ",
      "FullUrl": "/p211/ghazal/sh5761"
    },
    {
      "Id": 5762,
      "Title": "اے سجن وقت جاں گدازی ہے",
      "FullUrl": "/p211/ghazal/sh5762"
    },
    {
      "Id": 5763,
      "Title": "اے یار نصیحت کو اگر گوش کرے تو",
      "FullUrl": "/p211/ghazal/sh5763"
    },
    {
      "Id": 5764,
      "Title": "بے سبب ہم سے جدائی نہ کرو",
      "FullUrl": "/p211/ghazal/sh5764"
    },
    {
      "Id": 5765,
      "Title": "تجھ بدن پر جو لال ساری ہے",
      "FullUrl": "/p211/ghazal/sh5765"
    },
    {
      "Id": 5766,
      "Title": "تجھ بنا دل کو بے قراری ہے",
      "FullUrl": "/p211/ghazal/sh5766"
    },
    {
      "Id": 5767,
      "Title": "تری گالی مجھ دل کو پیاری لگے",
      "FullUrl": "/p211/ghazal/sh5767"
    },
    {
      "Id": 5768,
      "Title": "جان ایام دلبری ہے یاد",
      "FullUrl": "/p211/ghazal/sh5768"
    },
    {
      "Id": 5769,
      "Title": "جاگیر اگر بہت نہ ملی ہم کوں غم نہیں",
      "FullUrl": "/p211/ghazal/sh5769"
    },
    {
      "Id": 5770,
      "Title": "جب سجیلے خرام کرتے ہیں",
      "FullUrl": "/p211/ghazal/sh5770"
    },
    {
      "Id": 5771,
      "Title": "خوباں کے بیچ جاناں ممتاز ہے سراپا",
      "FullUrl": "/p211/ghazal/sh5771"
    },
    {
      "Id": 5772,
      "Title": "دھوپ سا یو کپول ناری ہے",
      "FullUrl": "/p211/ghazal/sh5772"
    },
    {
      "Id": 5773,
      "Title": "راست اگر سرو سی قامت کرے",
      "FullUrl": "/p211/ghazal/sh5773"
    },
    {
      "Id": 5774,
      "Title": "زلف تیری ہوئی کمند مجھے",
      "FullUrl": "/p211/ghazal/sh5774"
    },
    {
      "Id": 5775,
      "Title": "سجن مجھ پر بہت نا مہرباں ہے",
      "FullUrl": "/p211/ghazal/sh5775"
    },
    {
      "Id": 5776,
      "Title": "مجھ پاس کبھی وو قد شمشاد نہ آیا",
      "FullUrl": "/p211/ghazal/sh5776"
    },
    {
      "Id": 5777,
      "Title": "مرا محبوب سب کا من ہرن ہے",
      "FullUrl": "/p211/ghazal/sh5777"
    },
    {
      "Id": 5778,
      "Title": "مرے دل بیچ نقش نازنیں ہے",
      "FullUrl": "/p211/ghazal/sh5778"
    },
    {
      "Id": 5779,
      "Title": "مستمنداں کو ستایا نہ کرو",
      "FullUrl": "/p211/ghazal/sh5779"
    },
    {
      "Id": 5780,
      "Title": "منہ پھول سے رنگیں تھا و ساری تھی اس ہری",
      "FullUrl": "/p211/ghazal/sh5780"
    },
    {
      "Id": 5781,
      "Title": "میری جاں وہ بادہ خواری یاد ہے",
      "FullUrl": "/p211/ghazal/sh5781"
    },
    {
      "Id": 5782,
      "Title": "پیچ بھایا مجھ کو تجھ دستار کا",
      "FullUrl": "/p211/ghazal/sh5782"
    },
    {
      "Id": 5783,
      "Title": "چودہواں اس چندر کا سال ہوا",
      "FullUrl": "/p211/ghazal/sh5783"
    },
    {
      "Id": 5784,
      "Title": "گل ترے مکھ کی فکر میں بیمار",
      "FullUrl": "/p211/ghazal/sh5784"
    },
    {
      "Id": 5785,
      "Title": "ہر آشنا سے اس بن بیگانہ ہو رہا ہوں",
      "FullUrl": "/p211/ghazal/sh5785"
    },
    {
      "Id": 5787,
      "Title": "یار میرا میان گلشن ہے",
      "FullUrl": "/p211/ghazal/sh5787"
    }
  ]
