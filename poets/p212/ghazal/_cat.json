    },
    {
      "Id": 5822,
      "Title": "دل اور دل میں یاد کسی خوش خرام کی",
      "FullUrl": "/p212/ghazal/sh5822"
    },
    {
      "Id": 5823,
      "Title": "دل کی طرف حجاب تکلف اٹھا کے دیکھ",
