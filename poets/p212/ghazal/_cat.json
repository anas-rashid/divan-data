      "FullUrl": "/p212/ghazal/sh5797"
    },
    {
      "Id": 5798,
      "Title": "اک فسانہ سن گئے اک کہہ گئے",
      "FullUrl": "/p212/ghazal/sh5798"
    },
    {
      "Id": 5799,
      "Title": "اے اجل اے جان فانیؔ تو نے یہ کیا کر دیا",
      "FullUrl": "/p212/ghazal/sh5799"
    },
    {
      "Id": 5800,
      "Title": "اے موت تجھ پہ عمر ابد کا مدار ہے",
      "FullUrl": "/p212/ghazal/sh5800"
    },
    {
      "Id": 5801,
      "Title": "بجلیاں ٹوٹ پڑیں جب وہ مقابل سے اٹھا",
      "FullUrl": "/p212/ghazal/sh5801"
    },
    {
      "Id": 5802,
      "Title": "بیداد کے خوگر تھے فریاد تو کیا کرتے",
      "FullUrl": "/p212/ghazal/sh5802"
    },
    {
      "Id": 5803,
      "Title": "بے اجل کام نہ اپنا کسی عنواں نکلا",
      "FullUrl": "/p212/ghazal/sh5803"
    },
    {
      "Id": 5804,
      "Title": "بے خودی پہ تھا فانیؔ کچھ نہ اختیار اپنا",
      "FullUrl": "/p212/ghazal/sh5804"
    },
    {
      "Id": 5805,
      "Title": "بے ذوق نظر بزم تماشا نہ رہے گی",
      "FullUrl": "/p212/ghazal/sh5805"
    },
    {
      "Id": 5806,
      "Title": "تاکید ہے کہ دیدۂ دل وا کرے کوئی",
      "FullUrl": "/p212/ghazal/sh5806"
    },
    {
      "Id": 5807,
      "Title": "تری ترچھی نظر کا تیر ہے مشکل سے نکلے گا",
      "FullUrl": "/p212/ghazal/sh5807"
    },
    {
      "Id": 5808,
      "Title": "تیرا نگاہ شوق کوئی راز داں نہ تھا",
      "FullUrl": "/p212/ghazal/sh5808"
    },
    {
      "Id": 5809,
      "Title": "جب دل میں ترے غم نے حسرت کی بنا ڈالی",
      "FullUrl": "/p212/ghazal/sh5809"
    },
    {
      "Id": 5810,
      "Title": "جب پرسش حال وہ فرماتے ہیں جانیے کیا ہو جاتا ہے",
      "FullUrl": "/p212/ghazal/sh5810"
    },
    {
      "Id": 5811,
      "Title": "جذب دل جب بروئے کار آیا",
      "FullUrl": "/p212/ghazal/sh5811"
    },
    {
      "Id": 5812,
      "Title": "جستجوئے نشاط مبہم کیا",
      "FullUrl": "/p212/ghazal/sh5812"
    },
    {
      "Id": 5813,
      "Title": "جلوۂ عشق حقیقت تھی حسن مجاز بہانہ تھا",
      "FullUrl": "/p212/ghazal/sh5813"
    },
    {
      "Id": 5814,
      "Title": "جن خاک کے ذروں پر وہ سایۂ محمل تھا",
