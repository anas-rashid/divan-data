  "Poems": [
    {
      "Id": 5886,
      "Title": "آنکھوں میں بسے ہو تم آنکھوں میں عیاں ہو کر",
      "FullUrl": "/p213/ghazal/sh5886"
    },
    {
      "Id": 5888,
      "Title": "اک خلش سی ہے مجھے تقدیر سے",
      "FullUrl": "/p213/ghazal/sh5888"
    },
    {
      "Id": 5889,
      "Title": "ترا جلوہ شام و سحر دیکھتے ہیں",
      "FullUrl": "/p213/ghazal/sh5889"
    },
    {
      "Id": 5890,
      "Title": "جو کچھ بھی ہے نظر میں سو وہم نمود ہے",
      "FullUrl": "/p213/ghazal/sh5890"
    },
    {
      "Id": 5891,
      "Title": "منہ بولا بول جگت کا ہے جو من میں رہے سو اپنا ہے",
      "FullUrl": "/p213/ghazal/sh5891"
    },
    {
      "Id": 5892,
      "Title": "میرا دل ناشاد جو ناشاد رہے گا",
      "FullUrl": "/p213/ghazal/sh5892"
    },
    {
      "Id": 5893,
      "Title": "وصل کے لمحے کہانی ہو گئے",
      "FullUrl": "/p213/ghazal/sh5893"
    },
    {
      "Id": 5894,
      "Title": "وہ بہکی نگاہیں کیا کہیے وہ مہکی جوانی کیا کہیے",
      "FullUrl": "/p213/ghazal/sh5894"
    },
    {
      "Id": 5895,
      "Title": "کوئی بھی ہم سفر نہیں ہوتا",
      "FullUrl": "/p213/ghazal/sh5895"
    },
    {
      "Id": 5896,
      "Title": "کچھ تو وفور شوق میں باعث امتیاز ہو",
      "FullUrl": "/p213/ghazal/sh5896"
    }
  ]
}
