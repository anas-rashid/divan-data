  "Poems": [
    {
      "Id": 5904,
      "Title": "وار اور پھر وار کس کا آپ کی تلوار کا",
      "FullUrl": "/p214/ghazal/sh5904",
      "RadifLetter": "ا"
    },
    {
      "Id": 5898,
      "Title": "اس قدر محو تصور ہوں ستم گر تیرا",
      "FullUrl": "/p214/ghazal/sh5898",
      "RadifLetter": "ا"
    },
    {
      "Id": 5901,
      "Title": "رنگ دیکھا تری طبیعت کا",
      "FullUrl": "/p214/ghazal/sh5901",
      "RadifLetter": "ا"
    },
    {
      "Id": 5903,
      "Title": "مچلتی ہے مرے سینے میں تیری آرزو کیا کیا",
      "FullUrl": "/p214/ghazal/sh5903",
      "RadifLetter": "ا"
    },
    {
      "Id": 5900,
      "Title": "دل نہیں ملنے کا پھر میرا ستم گر ٹوٹ کر",
      "FullUrl": "/p214/ghazal/sh5900",
      "RadifLetter": "ر"
    },
    {
      "Id": 5902,
      "Title": "غبار خاطر ناشاد ہوں میں",
      "FullUrl": "/p214/ghazal/sh5902",
      "RadifLetter": "ن"
    },
    {
      "Id": 5899,
      "Title": "تعلق مدتوں کا ترک اس سے ہو تو کیونکر ہو",
      "FullUrl": "/p214/ghazal/sh5899",
      "RadifLetter": "و"
    },
    {
      "Id": 5906,
      "Title": "ہو ترقی پر مرا درد جدائی اور بھی",
      "FullUrl": "/p214/ghazal/sh5906",
      "RadifLetter": "ی"
    },
    {
      "Id": 5905,
      "Title": "کسی صورت عدو کی ترک الفت ہو نہیں سکتی",
      "FullUrl": "/p214/ghazal/sh5905",
      "RadifLetter": "ی"
    }
  ]
}
