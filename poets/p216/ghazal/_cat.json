  "Poems": [
    {
      "Id": 5995,
      "Title": "اب یہ عالم ہے کہ غم کی بھی خبر ہوتی نہیں",
      "FullUrl": "/p216/ghazal/sh5995"
    },
    {
      "Id": 5996,
      "Title": "اشکوں میں حسن دوست دکھاتی ہے چاندنی",
      "FullUrl": "/p216/ghazal/sh5996"
    },
    {
      "Id": 5997,
      "Title": "بقدر جوش جنوں تار تار بھی نہ کیا",
      "FullUrl": "/p216/ghazal/sh5997"
    },
    {
      "Id": 5998,
      "Title": "تضاد جذبات میں یہ نازک مقام آیا تو کیا کرو گے",
      "FullUrl": "/p216/ghazal/sh5998"
    },
    {
      "Id": 5999,
      "Title": "تم نہ مانو مگر حقیقت ہے",
      "FullUrl": "/p216/ghazal/sh5999"
    },
    {
      "Id": 6000,
      "Title": "تمہیں جو میرے غم دل سے آگہی ہو جائے",
      "FullUrl": "/p216/ghazal/sh6000"
    },
    {
      "Id": 6001,
      "Title": "جہان آرزو آواز ہی آواز ہوتا ہے",
      "FullUrl": "/p216/ghazal/sh6001"
    },
    {
      "Id": 6002,
      "Title": "حادثے زیست کی توقیر بڑھا دیتے ہیں",
      "FullUrl": "/p216/ghazal/sh6002"
    },
    {
      "Id": 6003,
      "Title": "حوادث ہم سفر اپنے تلاطم ہم عناں اپنا",
      "FullUrl": "/p216/ghazal/sh6003"
    },
    {
      "Id": 6004,
      "Title": "حیرتوں کے سلسلے سوز نہاں تک آ گئے",
      "FullUrl": "/p216/ghazal/sh6004"
    },
    {
      "Id": 6005,
      "Title": "دل دیوانہ عرض حال پر مائل تو کیا ہوگا",
      "FullUrl": "/p216/ghazal/sh6005"
    },
    {
      "Id": 6006,
      "Title": "دن چھپا اور غم کے سائے ڈھلے",
      "FullUrl": "/p216/ghazal/sh6006"
    },
    {
      "Id": 6007,
      "Title": "صراحی کا بھرم کھلتا نہ میری تشنگی ہوتی",
      "FullUrl": "/p216/ghazal/sh6007"
    },
    {
      "Id": 6008,
      "Title": "طلب کی آگ کسی شعلہ رو سے روشن ہے",
      "FullUrl": "/p216/ghazal/sh6008"
    },
    {
      "Id": 6009,
      "Title": "عالم سوز تمنا بے کراں کرتے چلو",
      "FullUrl": "/p216/ghazal/sh6009"
    },
    {
      "Id": 6010,
      "Title": "غم چھیڑتا ہے ساز رگ جاں کبھی کبھی",
      "FullUrl": "/p216/ghazal/sh6010"
    },
    {
      "Id": 6011,
      "Title": "مدتوں ہم نے غم سنبھالے ہیں",
      "FullUrl": "/p216/ghazal/sh6011"
    },
    {
      "Id": 6012,
      "Title": "وہ کب آئیں خدا جانے ستارو تم تو سو جاؤ",
      "FullUrl": "/p216/ghazal/sh6012"
    },
    {
      "Id": 6013,
      "Title": "وہ ہر مقام سے پہلے وہ ہر مقام کے بعد",
      "FullUrl": "/p216/ghazal/sh6013"
    },
    {
      "Id": 6014,
      "Title": "ہستی کو اپنی شعلہ بداماں کریں گے ہم",
      "FullUrl": "/p216/ghazal/sh6014"
    },
    {
      "Id": 6015,
      "Title": "ہونٹوں پہ ہنسی آنکھ میں تاروں کی لڑی ہے",
      "FullUrl": "/p216/ghazal/sh6015"
    }
  ]
}
