  "Poems": [
    {
      "Id": 6047,
      "Title": "یہ مشت خاک اپنے کو جہاں چاہے تہاں لے جا",
      "FullUrl": "/p217/ghazal/sh6047"
    },
    {
      "Id": 6038,
      "Title": "پانچ دن کو جو یہاں پر آ گیا",
      "FullUrl": "/p217/ghazal/sh6038"
    },
    {
      "Id": 6021,
      "Title": "بندہ پرور جو نہ پچھتائیے گا",
      "FullUrl": "/p217/ghazal/sh6021"
    },
    {
      "Id": 6020,
      "Title": "اے دل اب عشق کی لے گوئی اور چوگان میں آ",
      "FullUrl": "/p217/ghazal/sh6020"
    },
    {
      "Id": 6032,
      "Title": "فاسق جو اگر عاشق دیوانہ ہوا تو کیا",
      "FullUrl": "/p217/ghazal/sh6032"
    },
    {
      "Id": 6044,
      "Title": "کیا فروغ بزم اس مہ رو کا شب صد رنگ تھا",
      "FullUrl": "/p217/ghazal/sh6044"
    },
    {
      "Id": 6039,
      "Title": "پھیر روز فراق یار آیا",
      "FullUrl": "/p217/ghazal/sh6039"
    },
    {
      "Id": 6042,
      "Title": "کچھ اپنے کام نہیں آوے جام جم کی کتاب",
      "FullUrl": "/p217/ghazal/sh6042"
    },
    {
      "Id": 6034,
      "Title": "مثل سرمد طالب حق بیں اگر سرداد داد",
      "FullUrl": "/p217/ghazal/sh6034"
    },
    {
      "Id": 6018,
      "Title": "اپنے جانان کو اے جان اسی جان میں ڈھونڈ",
      "FullUrl": "/p217/ghazal/sh6018"
    },
    {
      "Id": 6037,
      "Title": "پارسا تو پارسائی پر نہ کر اتنا غرور",
      "FullUrl": "/p217/ghazal/sh6037"
    },
    {
      "Id": 6028,
      "Title": "درد دل کا کسے کروں اظہار",
      "FullUrl": "/p217/ghazal/sh6028"
    },
    {
      "Id": 6026,
      "Title": "جی رہے یا نہ رہے ہر قدم یار نہ چھوڑ",
      "FullUrl": "/p217/ghazal/sh6026"
    },
    {
      "Id": 6031,
      "Title": "عشق کی کوئی اگر سیکھ لے گر مجھ سے تمیز",
      "FullUrl": "/p217/ghazal/sh6031"
    },
    {
      "Id": 6043,
      "Title": "کہاں کا ننگ رہا اور اور کہاں رہا ناموس",
      "FullUrl": "/p217/ghazal/sh6043"
    },
    {
      "Id": 6023,
      "Title": "جتا نہ میرے تئیں اپنا تو ہنر واعظ",
      "FullUrl": "/p217/ghazal/sh6023"
    },
    {
      "Id": 6030,
      "Title": "عاشق سوختہ دل خط صنم دونوں ایک",
      "FullUrl": "/p217/ghazal/sh6030"
    },
    {
      "Id": 6033,
      "Title": "ماتم رنج و الم غم ہیں بہم چاروں ایک",
      "FullUrl": "/p217/ghazal/sh6033"
    },
    {
      "Id": 6041,
      "Title": "کفر عشق آیا بدل مجھ مومن دیں دار تک",
      "FullUrl": "/p217/ghazal/sh6041"
    },
    {
      "Id": 6019,
      "Title": "اگر شمع ہوئے تو گل گئے ہم",
      "FullUrl": "/p217/ghazal/sh6019"
    },
    {
      "Id": 6016,
      "Title": "ابر ساں ہر چند رکھا چشم کو پر آب ہم",
      "FullUrl": "/p217/ghazal/sh6016"
    },
    {
      "Id": 6017,
      "Title": "اس ارض کے تختہ پر سنسار ہے اور میں ہوں",
      "FullUrl": "/p217/ghazal/sh6017"
    },
    {
      "Id": 6036,
      "Title": "محبت ماسوا کی جس نے کی گوری کلوٹی کی",
      "FullUrl": "/p217/ghazal/sh6036"
    },
    {
      "Id": 6022,
      "Title": "جب کسی نے آن کر دل سے مرے پرخاش کی",
      "FullUrl": "/p217/ghazal/sh6022"
    },
    {
      "Id": 6046,
      "Title": "ہم نے تو اجاڑ اور بستی دیکھی",
      "FullUrl": "/p217/ghazal/sh6046"
    },
    {
      "Id": 6025,
      "Title": "جو میرا لے گیا دل کون وہ انسان ہے کیا ہے",
      "FullUrl": "/p217/ghazal/sh6025"
    },
    {
      "Id": 6045,
      "Title": "ہم نہ محظوظ ہوئے ہیں کسی شے سے ایسے",
      "FullUrl": "/p217/ghazal/sh6045"
    }
  ]
}
