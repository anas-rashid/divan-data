    {
      "Id": 6055,
      "Title": "بڑے نازوں سے دل میں جلوۂ جانانہ آتا ہے",
      "FullUrl": "/p219/ghazal/sh6055"
    },
    {
      "Id": 6056,
      "Title": "جب آنکھ بند ہوگی دیدار دیکھ لیں گے",
      "FullUrl": "/p219/ghazal/sh6056"
    },
    {
      "Id": 6057,
      "Title": "جب ذرا نغموں سے بلبل گل فشاں ہو جائے گا",
      "FullUrl": "/p219/ghazal/sh6057"
    },
    {
      "Id": 6058,
      "Title": "جو داغ ہے عشق دل نشیں کا جو دل نشیں ہیں دل حزیں کا",
      "FullUrl": "/p219/ghazal/sh6058"
    },
    {
      "Id": 6059,
      "Title": "جو عضو باطن خدا بناتا تو ہم دل بے قرار ہوتے",
      "FullUrl": "/p219/ghazal/sh6059"
    },
    {
      "Id": 6060,
      "Title": "جو ہے عرش پر وہی فرش پر کوئی خاص اس کا مکاں نہیں",
      "FullUrl": "/p219/ghazal/sh6060"
    },
    {
      "Id": 6061,
      "Title": "شب غم میں چھائی گھٹا کالی کالی",
      "FullUrl": "/p219/ghazal/sh6061"
    },
    {
      "Id": 6062,
      "Title": "غنچے چٹک گئے چمن روزگار کے",
      "FullUrl": "/p219/ghazal/sh6062"
    },
    {
      "Id": 6063,
      "Title": "لا کے دنیا میں ہمیں زہر فنا دیتے ہیں",
      "FullUrl": "/p219/ghazal/sh6063"
    },
    {
      "Id": 6064,
      "Title": "منکر ہوتے ہیں ہنر والے",
      "FullUrl": "/p219/ghazal/sh6064"
    },
    {
      "Id": 6065,
      "Title": "پڑ گئی آپ پر نظر ہی تو ہے",
      "FullUrl": "/p219/ghazal/sh6065"
    },
    {
      "Id": 6066,
      "Title": "گردن شیشہ جھکا دے مرے پیمانے پر",
      "FullUrl": "/p219/ghazal/sh6066"
    },
    {
      "Id": 6067,
      "Title": "ہو گیا ابرو کی سفاکی سے شہرا یار کا",
      "FullUrl": "/p219/ghazal/sh6067"
    },
    {
      "Id": 6068,
      "Title": "ہوئی ہے ہم میں اور اس گل میں کیا کیا مار پھولوں کی",
      "FullUrl": "/p219/ghazal/sh6068"
    },
