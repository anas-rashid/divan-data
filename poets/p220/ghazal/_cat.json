  "Poems": [
    {
      "Id": 6102,
      "Title": "ہزار وعدے کیے ہیں تم نے کبھی کسی کو وفا نہ کرنا",
      "FullUrl": "/p220/ghazal/sh6102",
      "RadifLetter": "ا"
    },
    {
      "Id": 6097,
      "Title": "چاک جگر و دل کا جب شکوہ بجا ہوتا",
      "FullUrl": "/p220/ghazal/sh6097",
      "RadifLetter": "ا"
    },
    {
      "Id": 6077,
      "Title": "بھول کر بھی ادھر نہیں آتا",
      "FullUrl": "/p220/ghazal/sh6077",
      "RadifLetter": "ا"
    },
    {
      "Id": 6078,
      "Title": "جس قدر ضبط کیا اور بھی رونا آیا",
      "FullUrl": "/p220/ghazal/sh6078",
      "RadifLetter": "ا"
    },
    {
      "Id": 6083,
      "Title": "دل محبت مکان ہے گویا",
      "FullUrl": "/p220/ghazal/sh6083",
      "RadifLetter": "ا"
    },
    {
      "Id": 6104,
      "Title": "یہ کیا لطف شور فغاں رہ گیا",
      "FullUrl": "/p220/ghazal/sh6104",
      "RadifLetter": "ا"
    },
    {
      "Id": 6100,
      "Title": "گرہ لب پہ جو مدعا ہو گیا",
      "FullUrl": "/p220/ghazal/sh6100",
      "RadifLetter": "ا"
    },
    {
      "Id": 6081,
      "Title": "خیال گزرے کہاں کہاں کا ارادہ ان کو ہو گر یہیں کا",
      "FullUrl": "/p220/ghazal/sh6081",
      "RadifLetter": "ا"
    },
    {
      "Id": 6074,
      "Title": "انسان ہوس پیشہ سے کیا ہو نہیں سکتا",
      "FullUrl": "/p220/ghazal/sh6074",
      "RadifLetter": "ا"
    },
    {
      "Id": 6088,
      "Title": "لطف میں واں ڈھنگ ہے بیداد کا",
      "FullUrl": "/p220/ghazal/sh6088",
      "RadifLetter": "ا"
    },
    {
      "Id": 6095,
      "Title": "واعظ ملے گی خلد میں کب اس قدر شراب",
      "FullUrl": "/p220/ghazal/sh6095",
      "RadifLetter": "ب"
    },
    {
      "Id": 6099,
      "Title": "کچھ مجھے کہہ کے نہ کہوائیے آپ",
      "FullUrl": "/p220/ghazal/sh6099",
      "RadifLetter": "پ"
    },
    {
      "Id": 6094,
      "Title": "نالاں نہیں کچھ ترے ستم پر",
      "FullUrl": "/p220/ghazal/sh6094",
      "RadifLetter": "ر"
    },
    {
      "Id": 6080,
      "Title": "جی ہیچ جان ہیچ نہ دل نے جگر عزیز",
      "FullUrl": "/p220/ghazal/sh6080",
      "RadifLetter": "ز"
    },
    {
      "Id": 6093,
      "Title": "میں ہوا زینت مکان قفس",
      "FullUrl": "/p220/ghazal/sh6093",
      "RadifLetter": "س"
    },
    {
      "Id": 6092,
      "Title": "ملی نہ فرصت جہاں ہو غش سے اٹھی جو کچھ بھی نقاب عارض",
      "FullUrl": "/p220/ghazal/sh6092",
      "RadifLetter": "ض"
    },
    {
      "Id": 6103,
      "Title": "یوں عیاں تجھ کو دیکھتے ہیں ہم",
      "FullUrl": "/p220/ghazal/sh6103",
      "RadifLetter": "م"
    },
    {
      "Id": 6082,
      "Title": "دل جہاں سے اٹھائے بیٹھے ہیں",
      "FullUrl": "/p220/ghazal/sh6082",
      "RadifLetter": "ن"
    },
    {
      "Id": 6085,
      "Title": "دل پہ آفت آئی اب اک آن میں",
      "FullUrl": "/p220/ghazal/sh6085",
      "RadifLetter": "ن"
    },
    {
      "Id": 6071,
      "Title": "آں سے ظالم کا امتحاں اور میں",
      "FullUrl": "/p220/ghazal/sh6071",
      "RadifLetter": "ن"
    },
    {
      "Id": 6084,
      "Title": "دل وہ شے ہے کہ جو دیکھے تو کھچے یار کے ساتھ",
      "FullUrl": "/p220/ghazal/sh6084",
      "RadifLetter": "ھ"
    },
    {
      "Id": 6076,
      "Title": "اچھی نبھی بتان ستم آشنا کے ساتھ",
      "FullUrl": "/p220/ghazal/sh6076",
      "RadifLetter": "ھ"
    },
    {
      "Id": 6073,
      "Title": "انتہا صبر آزمائی کی",
      "FullUrl": "/p220/ghazal/sh6073",
      "RadifLetter": "ی"
    },
    {
      "Id": 6089,
      "Title": "مجھ پر ایسی جفا کی کثرت کی",
      "FullUrl": "/p220/ghazal/sh6089",
      "RadifLetter": "ی"
    },
    {
      "Id": 6079,
      "Title": "جو بھر لیں ایک چٹکی صاحب تاثیر مٹی کی",
      "FullUrl": "/p220/ghazal/sh6079",
      "RadifLetter": "ی"
    },
    {
      "Id": 6072,
      "Title": "اب تو لب سے نہ جائے گا آگے",
      "FullUrl": "/p220/ghazal/sh6072",
      "RadifLetter": "ے"
    },
    {
      "Id": 6091,
      "Title": "مضطرب ہوں اب یہ جی کی بات ہے",
      "FullUrl": "/p220/ghazal/sh6091",
      "RadifLetter": "ے"
    },
    {
      "Id": 6101,
      "Title": "ہاتھ میں لے کے نہ خنجر بیٹھیے",
      "FullUrl": "/p220/ghazal/sh6101",
      "RadifLetter": "ے"
    },
    {
      "Id": 6075,
      "Title": "اٹھے آج ان سے فیصلہ کر کے",
      "FullUrl": "/p220/ghazal/sh6075",
      "RadifLetter": "ے"
    },
    {
      "Id": 6087,
      "Title": "رکھو وہ شیوہ نہ مد نظر نظر میں رہے",
      "FullUrl": "/p220/ghazal/sh6087",
      "RadifLetter": "ے"
    },
    {
      "Id": 6096,
      "Title": "وہ زیب شبستاں ہوا چاہتا ہے",
      "FullUrl": "/p220/ghazal/sh6096",
      "RadifLetter": "ے"
    },
    {
      "Id": 6098,
      "Title": "کب ہے منظور کہ یوں جنس دل زار بکے",
      "FullUrl": "/p220/ghazal/sh6098",
      "RadifLetter": "ے"
    },
    {
      "Id": 6086,
      "Title": "دیر و کعبہ کو رہ گزر سمجھے",
      "FullUrl": "/p220/ghazal/sh6086",
      "RadifLetter": "ے"
    },
    {
      "Id": 6090,
      "Title": "مری خاطر میں ساقی کب ترا پیمانہ آتا ہے",
      "FullUrl": "/p220/ghazal/sh6090",
      "RadifLetter": "ے"
    }
  ]
