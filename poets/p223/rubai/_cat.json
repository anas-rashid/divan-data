  "Poems": [
    {
      "Id": 6113,
      "Title": "آلودہ خیالات میں تیرے ہوں مدام",
      "FullUrl": "/p223/rubai/sh6113"
    },
    {
      "Id": 6115,
      "Title": "اس بزم سے میدان میں جانا ہوگا",
      "FullUrl": "/p223/rubai/sh6115"
    },
    {
      "Id": 6116,
      "Title": "اس خطے کی جا عالم بالا میں نہیں",
      "FullUrl": "/p223/rubai/sh6116"
    },
    {
      "Id": 6117,
      "Title": "اس عہد میں احتساب ایمانی کیا",
      "FullUrl": "/p223/rubai/sh6117"
    },
    {
      "Id": 6118,
      "Title": "اس وقت زمانے میں بہم ایسے ہیں",
      "FullUrl": "/p223/rubai/sh6118"
    },
    {
      "Id": 6119,
      "Title": "افسانۂ یار بہر وصلت ہے لذیذ",
      "FullUrl": "/p223/rubai/sh6119"
    },
    {
      "Id": 6120,
      "Title": "افسوس تری وضع پہ آتا ہے قلقؔ",
      "FullUrl": "/p223/rubai/sh6120"
    },
    {
      "Id": 6124,
      "Title": "اے ابر کہاں تک ترے رستے دیکھیں",
      "FullUrl": "/p223/rubai/sh6124"
    },
    {
      "Id": 6127,
      "Title": "اے پردہ نشیں سہل ہوا یہ اشکال",
      "FullUrl": "/p223/rubai/sh6127"
    },
    {
      "Id": 6128,
      "Title": "اے چشم غمیں تیرے عوض روئے کون",
      "FullUrl": "/p223/rubai/sh6128"
    },
    {
      "Id": 6129,
      "Title": "بانو نے کہا قطرہ نہیں شیر کا ہے",
      "FullUrl": "/p223/rubai/sh6129"
    },
    {
      "Id": 6131,
      "Title": "بے برگ و نوا کی شعر خوانی معلوم",
      "FullUrl": "/p223/rubai/sh6131"
    },
    {
      "Id": 6132,
      "Title": "تا ماہ صیام ہوئے باب امید",
      "FullUrl": "/p223/rubai/sh6132"
    },
    {
      "Id": 6134,
      "Title": "تھا آدم خاکی غضب بے زنہار",
      "FullUrl": "/p223/rubai/sh6134"
    },
    {
      "Id": 6138,
      "Title": "جاں جائے پر امید نہ جائے گی کبھی",
      "FullUrl": "/p223/rubai/sh6138"
    },
    {
      "Id": 6139,
      "Title": "جاہل کی ہے میراث قلقؔ تخت و تاج",
      "FullUrl": "/p223/rubai/sh6139"
    },
    {
      "Id": 6140,
      "Title": "جب باپ موا تو پھر ہے بیٹا کیا شے",
      "FullUrl": "/p223/rubai/sh6140"
    },
    {
      "Id": 6141,
      "Title": "جو جا کے نہ آئے پھر جوانی ہے یہ شے",
      "FullUrl": "/p223/rubai/sh6141"
    },
    {
      "Id": 6145,
      "Title": "خود رفتہ ہو بدمست ہو کیسا ہے مزاج",
      "FullUrl": "/p223/rubai/sh6145"
    },
    {
      "Id": 6146,
      "Title": "خورشید پہ جس وقت زوال آتا ہے",
      "FullUrl": "/p223/rubai/sh6146"
    },
    {
      "Id": 6148,
      "Title": "دامن سے گل تازہ مہکتے نکلے",
      "FullUrl": "/p223/rubai/sh6148"
    },
    {
      "Id": 6149,
      "Title": "دروازے پہ تیرے ہی مروں گا یارب",
      "FullUrl": "/p223/rubai/sh6149"
    },
    {
      "Id": 6150,
      "Title": "دل جوش معاصی سے نہ کیوں خوں ہو جائے",
      "FullUrl": "/p223/rubai/sh6150"
    },
    {
      "Id": 6151,
      "Title": "دل دیر گزاری سے ہے آوند نمک",
      "FullUrl": "/p223/rubai/sh6151"
    },
    {
      "Id": 6152,
      "Title": "دل سے مجھے آنے کی ہے آن کی آہٹ",
      "FullUrl": "/p223/rubai/sh6152"
    },
    {
      "Id": 6154,
      "Title": "دنیا میں قلقؔ کیا ہے سراسر ہے خاک",
      "FullUrl": "/p223/rubai/sh6154"
    },
    {
      "Id": 6155,
      "Title": "دنیا کا تمام کارخانہ ہے عبث",
      "FullUrl": "/p223/rubai/sh6155"
    },
    {
      "Id": 6156,
      "Title": "دنیا کا عجب رنگ سے دیکھا انگیز",
      "FullUrl": "/p223/rubai/sh6156"
    },
    {
      "Id": 6157,
      "Title": "دنیا ہے عجب بو قلموں ضد آموز",
      "FullUrl": "/p223/rubai/sh6157"
    },
    {
      "Id": 6161,
      "Title": "دیں ہی بے ہوش ہے نہ دنیا بے ہوش",
      "FullUrl": "/p223/rubai/sh6161"
    },
    {
      "Id": 6165,
      "Title": "زہاد کا غفلت سے ہے اوراد و سجود",
      "FullUrl": "/p223/rubai/sh6165"
    },
    {
      "Id": 6166,
      "Title": "شہہ کہتے تھے افسوس نہ کہنا مانے",
      "FullUrl": "/p223/rubai/sh6166"
    },
    {
      "Id": 6167,
      "Title": "صد حیف کہ مے نوش ہوئے ہم کیسے",
      "FullUrl": "/p223/rubai/sh6167"
    },
    {
      "Id": 6169,
      "Title": "غیروں کو شب وصل بلانے سے غرض",
      "FullUrl": "/p223/rubai/sh6169"
    },
    {
      "Id": 6170,
      "Title": "فانی کے ہے نزدیک بقا کو بھی فنا",
      "FullUrl": "/p223/rubai/sh6170"
    },
    {
      "Id": 6171,
      "Title": "لازم ہے کہ فکر رخ دلبر چھوڑوں",
      "FullUrl": "/p223/rubai/sh6171"
    },
    {
      "Id": 6172,
      "Title": "لو جائیے بس خدا ہمارا حافظ",
      "FullUrl": "/p223/rubai/sh6172"
    },
    {
      "Id": 6174,
      "Title": "محراب و مصلیٰ اور زاہد بھی وہی",
      "FullUrl": "/p223/rubai/sh6174"
    },
    {
      "Id": 6175,
      "Title": "مرمر کے پئے رنج و بلا جیتے ہیں",
      "FullUrl": "/p223/rubai/sh6175"
    },
    {
      "Id": 6176,
      "Title": "مسجد میں نہ جا واں نہیں ہونے کا نباہ",
      "FullUrl": "/p223/rubai/sh6176"
    },
    {
      "Id": 6177,
      "Title": "مسجد کو دیا چھوڑ ریا کی خاطر",
      "FullUrl": "/p223/rubai/sh6177"
    },
    {
      "Id": 6178,
      "Title": "منہ گیسوئے پر خم سے نہ موڑوں کب تک",
      "FullUrl": "/p223/rubai/sh6178"
    },
    {
      "Id": 6179,
      "Title": "ناحق تھا قلقؔ مجھے غرور اسلام",
      "FullUrl": "/p223/rubai/sh6179"
    },
    {
      "Id": 6180,
      "Title": "ناصح کی شکایت وہی زخم جاں ہے",
      "FullUrl": "/p223/rubai/sh6180"
    },
    {
      "Id": 6185,
      "Title": "وہ وقت شباب وہ زمانہ نہ رہا",
      "FullUrl": "/p223/rubai/sh6185"
    },
    {
      "Id": 6189,
      "Title": "ژولیدہ معما ہے جہان پر پیچ",
      "FullUrl": "/p223/rubai/sh6189"
    },
    {
      "Id": 6190,
      "Title": "کس طرح سے گریہ کو نہ ہو طغیانی",
      "FullUrl": "/p223/rubai/sh6190"
    },
    {
      "Id": 6191,
      "Title": "کس طرح کہوں آ بھی کہیں عذر نہ کر",
      "FullUrl": "/p223/rubai/sh6191"
    },
    {
      "Id": 6193,
      "Title": "کس واسطے دی تھیں ہمیں یارب آنکھیں",
      "FullUrl": "/p223/rubai/sh6193"
    },
    {
      "Id": 6194,
      "Title": "کل تک تھی خلد خانہ زاد دہلی",
      "FullUrl": "/p223/rubai/sh6194"
    },
    {
      "Id": 6196,
      "Title": "کہتا ہوں خدا لگتی عقیدے کے خلاف",
      "FullUrl": "/p223/rubai/sh6196"
    },
    {
      "Id": 6199,
      "Title": "کیا جانیے الفت کا ہے کس سے آغاز",
      "FullUrl": "/p223/rubai/sh6199"
    },
    {
      "Id": 6200,
      "Title": "کیا ذکر وفا جفا کسی سے نہ بنی",
      "FullUrl": "/p223/rubai/sh6200"
    },
    {
      "Id": 6201,
      "Title": "کیا لینے سوئے جاہ و حشم جائیں گے",
      "FullUrl": "/p223/rubai/sh6201"
    },
    {
      "Id": 6203,
      "Title": "گاہے تو کرم ہم پہ بھی فرمائیں آپ",
      "FullUrl": "/p223/rubai/sh6203"
    },
    {
      "Id": 6204,
      "Title": "گردن کو جھکا دیتا ہے ادنیٰ احسان",
      "FullUrl": "/p223/rubai/sh6204"
    },
    {
      "Id": 6205,
      "Title": "ہر روز خوشی ہے شب غم سے پامال",
      "FullUrl": "/p223/rubai/sh6205"
    },
    {
      "Id": 6206,
      "Title": "ہر زخم جگر کھایا ہے دل پر تن کر",
      "FullUrl": "/p223/rubai/sh6206"
    },
    {
      "Id": 6207,
      "Title": "ہر طرح سے ضائع ہے یہاں ہر اوقات",
      "FullUrl": "/p223/rubai/sh6207"
    },
    {
      "Id": 6209,
      "Title": "ہر فصل میں ہوتے ہیں جواں سارے شجر",
      "FullUrl": "/p223/rubai/sh6209"
    },
    {
      "Id": 6211,
      "Title": "ہم کون ہیں اہتمام کرنے والے",
      "FullUrl": "/p223/rubai/sh6211"
    },
    {
      "Id": 6213,
      "Title": "ہے بس کہ جوانی میں بڑھاپے کا غم",
      "FullUrl": "/p223/rubai/sh6213"
    },
    {
      "Id": 6215,
      "Title": "ہے دوستیٔ آل عبا رونے سے",
      "FullUrl": "/p223/rubai/sh6215"
    },
    {
      "Id": 6216,
      "Title": "ہے مہر کرم گناہ گاری میری",
      "FullUrl": "/p223/rubai/sh6216"
    },
    {
      "Id": 6217,
      "Title": "یارب تجھے فکر پائے بندی کیا ہے",
      "FullUrl": "/p223/rubai/sh6217"
    },
    {
      "Id": 6218,
      "Title": "یاں نفس کی شوخی سے ہے مجنوں لیلیٰ",
      "FullUrl": "/p223/rubai/sh6218"
    },
    {
      "Id": 6219,
      "Title": "یاں ہم کو دیا کیا جو وہاں پر ہو نگاہ",
      "FullUrl": "/p223/rubai/sh6219"
    },
    {
      "Id": 6220,
      "Title": "یہ شہر بلند عالم بالا سے تھا",
      "FullUrl": "/p223/rubai/sh6220"
    },
    {
      "Id": 6221,
      "Title": "یہ وہم دوئی دل سے جدا کرنا تھا",
      "FullUrl": "/p223/rubai/sh6221"
    }
  ]
