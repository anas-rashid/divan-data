      "RadifLetter": "ا"
    },
    {
      "Id": 6251,
      "Title": "روز کہتے تھے کبھی غیر کے گھر دیکھ لیا",
      "FullUrl": "/p225/ghazal/sh6251",
      "RadifLetter": "ا"
    },
    {
      "Id": 6259,
      "Title": "کنج قفس سے پہلے گھر اپنا کہاں نہ تھا",
