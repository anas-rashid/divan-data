    },
    {
      "Id": 6258,
      "Title": "کسی کو لاکھ الم ہو ذرا ملال نہیں",
      "FullUrl": "/p225/ghazal/sh6258"
    },
    {
      "Id": 6237,
      "Title": "بوئے گل سونگھ کر بگڑتے ہیں",
      "FullUrl": "/p225/ghazal/sh6237"
    },
    {
      "Id": 6231,
      "Title": "آؤ بیٹھو ہنسو مزا ہو",
