      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دل کو کوسو جو چاہتا ہے\r\nمیں نے کیا آپ کا لیا ہے\r\nکیا ہنستے ہو میرے رونے پر تم\r\nدل کا آنا بری بلا ہے\r\nجتنا چاہو جلاؤ ہم کو\r\nتم بھی کتنے ہو دیکھنا ہے\r\nمعشوق منائیں تم کو جوہرؔ\r\nیہ بھی اک قدرت خدا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
