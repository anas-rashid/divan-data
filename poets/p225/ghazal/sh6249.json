      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دیں جسے چاہیں دل ہمارا ہے\r\nاس میں کیا آپ کا اجارا ہے\r\nبہکی بہکی جو کرتے ہو تقریر\r\nسچ کہو دل کہاں تمہارا ہے\r\nجان دیتے ہیں صبر کرتے ہیں\r\nواہ کیا حوصلہ ہمارا ہے\r\nسینے سے لپٹو یا گلا کاٹو\r\nہم تمہارے ہیں دل تمہارا ہے\r\nپانی تلوار کا نہ پینے دیا\r\nسوکھے گھاٹ آپ نے اتارا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
