      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "فریاد کرے کس سے گنہ گار تمہارا\r\nاللہ بھی حاکم بھی طرف دار تمہارا\r\nکعبہ کی تو کیا اصل ہے اس کوچے سے آگے\r\nجنت ہو تو جائے نہ گنہ گار تمہارا\r\nدرد دل عاشق کی دوا کون کرے گا\r\nسنتے ہیں مسیحا بھی ہے بیمار تمہارا\r\nجوہرؔ تمہیں نفرت ہے بہت بادہ کشی سے\r\nبرسات میں دیکھیں گے ہم انکار تمہارا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
