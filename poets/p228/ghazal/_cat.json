      "Id": 6289,
      "Title": "عاشق ہے جو تمہارے رخ سرخ رنگ کا",
      "FullUrl": "/p228/ghazal/sh6289"
    },
    {
      "Id": 6286,
      "Title": "تندرستوں میں نہ بیماروں کے بیچ",
      "FullUrl": "/p228/ghazal/sh6286"
    },
    {
      "Id": 6283,
      "Title": "الا یا شاہ خوباں کیجیے شاد",
      "FullUrl": "/p228/ghazal/sh6283"
    },
    {
      "Id": 6284,
      "Title": "اے دل زار لکھو جانب جاناں کاغذ",
      "FullUrl": "/p228/ghazal/sh6284"
    },
    {
      "Id": 6288,
      "Title": "شعلوں سے محبت کی مری جاں میں لگی آگ",
      "FullUrl": "/p228/ghazal/sh6288"
    },
    {
      "Id": 6287,
      "Title": "دودمان درد کی شادی ہیں ہم",
      "FullUrl": "/p228/ghazal/sh6287"
    },
    {
      "Id": 6285,
      "Title": "بس تمنا ہے عشق مولیٰ میں",
      "FullUrl": "/p228/ghazal/sh6285"
    },
    {
      "Id": 6290,
      "Title": "نہ ملا ہوں نہ مفتی ہوں نہ واعظ ہوں نہ قاضی ہوں",
      "FullUrl": "/p228/ghazal/sh6290"
    },
    {
      "Id": 6291,
      "Title": "نے امیروں میں نے وزیروں میں",
      "FullUrl": "/p228/ghazal/sh6291"
    }
