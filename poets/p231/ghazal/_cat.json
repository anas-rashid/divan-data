  "Poems": [
    {
      "Id": 6314,
      "Title": "بسنت آئی ہے موج رنگ گل ہے جوش صہبا ہے",
      "FullUrl": "/p231/ghazal/sh6314"
    },
    {
      "Id": 6315,
      "Title": "تم منہ لگا کے غیروں کو مغرور مت کرو",
      "FullUrl": "/p231/ghazal/sh6315"
    },
    {
      "Id": 6316,
      "Title": "دل میں میرے پھر خیال آتا ہے آج",
      "FullUrl": "/p231/ghazal/sh6316"
    },
    {
      "Id": 6317,
      "Title": "دل ہو گیا ہے غم سے ترے داغ دار خوب",
      "FullUrl": "/p231/ghazal/sh6317"
    },
    {
      "Id": 6318,
      "Title": "رکھتے ہیں میرے اشک سے یہ دیدۂ تر فیض",
      "FullUrl": "/p231/ghazal/sh6318"
    },
    {
      "Id": 6319,
      "Title": "رہے رقیب سے باہم وہ سیم بر محظوظ",
      "FullUrl": "/p231/ghazal/sh6319"
    },
    {
      "Id": 6320,
      "Title": "رہے نو روز عشرت آفریں جوش بہار افزا",
      "FullUrl": "/p231/ghazal/sh6320"
    },
    {
      "Id": 6321,
      "Title": "ساقی ہے گرچہ بے شمار شراب",
      "FullUrl": "/p231/ghazal/sh6321"
    },
    {
      "Id": 6322,
      "Title": "عالم تری نگہ سے ہے سرشار دیکھنا",
      "FullUrl": "/p231/ghazal/sh6322"
    },
    {
      "Id": 6323,
      "Title": "نہ گل سے ہے غرض تیرے نہ ہے گلزار سے مطلب",
      "FullUrl": "/p231/ghazal/sh6323"
    },
    {
      "Id": 6324,
      "Title": "گرچہ گل کی سیج ہو تس پر بھی اڑ جاتی ہے نیند",
      "FullUrl": "/p231/ghazal/sh6324"
    },
    {
      "Id": 6325,
      "Title": "گل کے ہونے کی توقع پہ جئے بیٹھی ہے",
      "FullUrl": "/p231/ghazal/sh6325"
    },
    {
      "Id": 6326,
      "Title": "ہوئے جناب میں اب تک نہ تیرے ہم گستاخ",
      "FullUrl": "/p231/ghazal/sh6326"
    }
  ]
}
