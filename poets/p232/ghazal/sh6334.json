      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تازہ آزار کا ارمان کہاں جاتا ہے\r\nپھر ستا لے ترے قربان کہاں جاتا ہے\r\nکس پہ دل آیا کہاں آیا بتا اے ناصح\r\nتو مری طرح پریشان کہاں جاتا ہے\r\nخانقاہوں پہ ہوا پیر مغاں کا قبضہ\r\nآج مے خانے کا سامان کہاں جاتا ہے\r\nدل سلامت نہیں آنے کا مبارکؔ بخدا\r\nارے نادان کہا مان کہاں جاتا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
