      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ستم کرو نہ کرو اختیار باقی ہے\r\nجو ہم نہیں تو ہمارا مزار باقی ہے\r\nگئی بہار مگر اپنی بے خودی ہے وہی\r\nسمجھ رہا ہوں کہ اب تک بہار باقی ہے\r\nہزار مرحلۂ انتظار طے بھی ہوئے\r\nہزار مرحلۂ انتظار باقی ہے\r\nشکست توبہ ہے ایسی ثواب میں داخل\r\nابھی سے توبہ مبارکؔ بہار باقی ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
