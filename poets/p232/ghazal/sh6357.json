      "VOrder": 1,
      "Position": "Right",
      "Text": "کہتے ہیں کہ دے میری بلا داد کسی کی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "کانوں کو مزہ دیتی ہے فریاد کسی کی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "رونا ہے ترا کام مگر دیدۂ تر دیکھ",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تصویر خیالی نہ ہو برباد کسی کی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "کرتا ہوں گلہ ان سے جو ویرانئ دل کا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کہتے ہیں یہ بستی نہیں آباد کسی کی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "آباد خدا رکھے تجھے کوئے محبت",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "مٹی نہیں ہوتی یہاں برباد کسی کی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "کچھ اور تو ہم پاس مبارکؔ نہیں رکھتے",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
