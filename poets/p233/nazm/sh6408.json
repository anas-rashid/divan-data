      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "حسن اک کیف جاودانی ہے\r\nاور جو چیز ہے وہ فانی ہے\r\nحسن کے دن بھی کیف پرور ہیں\r\nحسن کی رات بھی سہانی ہے\r\nحسن کی صبح اک شکست جمیل\r\nحسن کی شام کامرانی ہے\r\nیہ کچھ افسانۂ تخیل ہے\r\nکچھ حقیقت کی ترجمانی ہے\r\nکچھ ترے حسن کا کرشمہ ہے\r\nکچھ مری طبع کی روانی ہے",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur",
      "CoupletsCount": 5
    }
