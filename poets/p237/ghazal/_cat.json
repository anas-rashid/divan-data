  "Poems": [
    {
      "Id": 6480,
      "Title": "آتے ہی تو نے گھر کے پھر جانے کی سنائی",
      "FullUrl": "/p237/ghazal/sh6480"
    },
    {
      "Id": 6481,
      "Title": "آنکھ اس پرجفا سے لڑتی ہے",
      "FullUrl": "/p237/ghazal/sh6481"
    },
    {
      "Id": 6482,
      "Title": "آنکھیں مری تلووں سے وہ مل جائے تو اچھا",
      "FullUrl": "/p237/ghazal/sh6482"
    },
    {
      "Id": 6483,
      "Title": "اب تو گھبرا کے یہ کہتے ہیں کہ مر جائیں گے",
      "FullUrl": "/p237/ghazal/sh6483"
    },
    {
      "Id": 6484,
      "Title": "اس سنگ آستاں پہ جبین نیاز ہے",
      "FullUrl": "/p237/ghazal/sh6484"
    },
    {
      "Id": 6485,
      "Title": "اک صدمہ درد دل سے مری جان پر تو ہے",
      "FullUrl": "/p237/ghazal/sh6485"
    },
    {
      "Id": 6486,
      "Title": "اے ذوقؔ وقت نالے کے رکھ لے جگر پہ ہاتھ",
      "FullUrl": "/p237/ghazal/sh6486"
    },
    {
      "Id": 6487,
      "Title": "بادام دو جو بھیجے ہیں بٹوے میں ڈال کر",
      "FullUrl": "/p237/ghazal/sh6487"
    },
    {
      "Id": 6488,
      "Title": "باغ عالم میں جہاں نخل حنا لگتا ہے",
      "FullUrl": "/p237/ghazal/sh6488"
    },
    {
      "Id": 6489,
      "Title": "برق میرا آشیاں کب کا جلا کر لے گئی",
      "FullUrl": "/p237/ghazal/sh6489"
    },
    {
      "Id": 6490,
      "Title": "بزم میں ذکر مرا لب پہ وہ لائے تو سہی",
      "FullUrl": "/p237/ghazal/sh6490"
    },
    {
      "Id": 6491,
      "Title": "بلائیں آنکھوں سے ان کی مدام لیتے ہیں",
      "FullUrl": "/p237/ghazal/sh6491"
    },
    {
      "Id": 6493,
      "Title": "تیرے آفت زدہ جن دشتوں میں اڑ جاتے ہیں",
      "FullUrl": "/p237/ghazal/sh6493"
    },
    {
      "Id": 6494,
      "Title": "جب چلا وہ مجھ کو بسمل خوں میں غلطاں چھوڑ کر",
      "FullUrl": "/p237/ghazal/sh6494"
    },
    {
      "Id": 6495,
      "Title": "جدا ہوں یار سے ہم اور نہ ہو رقیب جدا",
      "FullUrl": "/p237/ghazal/sh6495"
    },
    {
      "Id": 6497,
      "Title": "جو کچھ کہ ہے دنیا میں وہ انساں کے لیے ہے",
      "FullUrl": "/p237/ghazal/sh6497"
    },
    {
      "Id": 6498,
      "Title": "خط بڑھا کاکل بڑھے زلفیں بڑھیں گیسو بڑھے",
      "FullUrl": "/p237/ghazal/sh6498"
    },
    {
      "Id": 6499,
      "Title": "خوب روکا شکایتوں سے مجھے",
      "FullUrl": "/p237/ghazal/sh6499"
    },
    {
      "Id": 6500,
      "Title": "دریائے اشک چشم سے جس آن بہہ گیا",
      "FullUrl": "/p237/ghazal/sh6500"
    },
    {
      "Id": 6501,
      "Title": "دل بچے کیونکر بتوں کی چشم شوخ و شنگ سے",
      "FullUrl": "/p237/ghazal/sh6501"
    },
    {
      "Id": 6503,
      "Title": "دود دل سے ہے یہ تاریکی مرے غم خانہ میں",
      "FullUrl": "/p237/ghazal/sh6503"
    },
    {
      "Id": 6504,
      "Title": "دکھلا نہ خال ناف تو اے گل بدن مجھے",
      "FullUrl": "/p237/ghazal/sh6504"
    },
    {
      "Id": 6505,
      "Title": "رند خراب حال کو زاہد نہ چھیڑ تو",
      "FullUrl": "/p237/ghazal/sh6505"
    },
    {
      "Id": 6506,
      "Title": "زخمی ہوں ترے ناوک دزدیدہ نظر سے",
      "FullUrl": "/p237/ghazal/sh6506"
    },
    {
      "Id": 6507,
      "Title": "سب کو دنیا کی ہوس خوار لیے پھرتی ہے",
      "FullUrl": "/p237/ghazal/sh6507"
    },
    {
      "Id": 6508,
      "Title": "عزیزو اس کو نہ گھڑیال کی صدا سمجھو",
      "FullUrl": "/p237/ghazal/sh6508"
    },
    {
      "Id": 6509,
      "Title": "قصد جب تیری زیارت کا کبھو کرتے ہیں",
      "FullUrl": "/p237/ghazal/sh6509"
    },
    {
      "Id": 6510,
      "Title": "قفل صد خانۂ دل آیا جو تو ٹوٹ گئے",
      "FullUrl": "/p237/ghazal/sh6510"
    },
    {
      "Id": 6511,
      "Title": "لائی حیات آئے قضا لے چلی چلے",
      "FullUrl": "/p237/ghazal/sh6511"
    },
    {
      "Id": 6512,
      "Title": "لیتے ہی دل جو عاشق دل سوز کا چلے",
      "FullUrl": "/p237/ghazal/sh6512"
    },
    {
      "Id": 6513,
      "Title": "مار کر تیر جو وہ دلبر جانی مانگے",
      "FullUrl": "/p237/ghazal/sh6513"
    },
    {
      "Id": 6514,
      "Title": "محفل میں شور قلقل مینائے مل ہوا",
      "FullUrl": "/p237/ghazal/sh6514"
    },
    {
      "Id": 6515,
      "Title": "مرض عشق جسے ہو اسے کیا یاد رہے",
      "FullUrl": "/p237/ghazal/sh6515"
    },
    {
      "Id": 6516,
      "Title": "مرے سینے سے تیرا تیر جب اے جنگجو نکلا",
      "FullUrl": "/p237/ghazal/sh6516"
    },
    {
      "Id": 6517,
      "Title": "مزہ تھا ہم کو جو لیلیٰ سے دو بہ دو کرتے",
      "FullUrl": "/p237/ghazal/sh6517"
    },
    {
      "Id": 6518,
      "Title": "نالہ اس شور سے کیوں میرا دہائی دیتا",
      "FullUrl": "/p237/ghazal/sh6518"
    },
    {
      "Id": 6520,
      "Title": "نگہ کا وار تھا دل پر پھڑکنے جان لگی",
      "FullUrl": "/p237/ghazal/sh6520"
    },
    {
      "Id": 6521,
      "Title": "نہ کرتا ضبط میں نالہ تو پھر ایسا دھواں ہوتا",
      "FullUrl": "/p237/ghazal/sh6521"
    },
    {
      "Id": 6522,
      "Title": "نہ کھینچو عاشق تشنہ جگر کے تیر پہلو سے",
      "FullUrl": "/p237/ghazal/sh6522"
    },
    {
      "Id": 6523,
      "Title": "نہیں ثبات بلندی عز و شاں کے لیے",
      "FullUrl": "/p237/ghazal/sh6523"
    },
    {
      "Id": 6524,
      "Title": "نیمچہ یار نے جس وقت بغل میں مارا",
      "FullUrl": "/p237/ghazal/sh6524"
    },
    {
      "Id": 6525,
      "Title": "وقت پیری شباب کی باتیں",
      "FullUrl": "/p237/ghazal/sh6525"
    },
    {
      "Id": 6526,
      "Title": "وہ کون ہے جو مجھ پہ تأسف نہیں کرتا",
      "FullUrl": "/p237/ghazal/sh6526"
    },
    {
      "Id": 6527,
      "Title": "چشم قاتل ہمیں کیونکر نہ بھلا یاد رہے",
      "FullUrl": "/p237/ghazal/sh6527"
    },
    {
      "Id": 6528,
      "Title": "چپکے چپکے غم کا کھانا کوئی ہم سے سیکھ جائے",
      "FullUrl": "/p237/ghazal/sh6528"
    },
    {
      "Id": 6529,
      "Title": "کب حق پرست زاہد جنت پرست ہے",
      "FullUrl": "/p237/ghazal/sh6529"
    },
    {
      "Id": 6530,
      "Title": "کسی بیکس کو اے بیداد گر مارا تو کیا مارا",
      "FullUrl": "/p237/ghazal/sh6530"
    },
    {
      "Id": 6531,
      "Title": "کل گئے تھے تم جسے بیمار ہجراں چھوڑ کر",
      "FullUrl": "/p237/ghazal/sh6531"
    },
    {
      "Id": 6532,
      "Title": "کوئی ان تنگ دہانوں سے محبت نہ کرے",
      "FullUrl": "/p237/ghazal/sh6532"
    },
    {
      "Id": 6533,
      "Title": "کوئی کمر کو تری کچھ جو ہو کمر تو کہے",
      "FullUrl": "/p237/ghazal/sh6533"
    },
    {
      "Id": 6534,
      "Title": "کون وقت اے وائے گزرا جی کو گھبراتے ہوئے",
      "FullUrl": "/p237/ghazal/sh6534"
    },
    {
      "Id": 6535,
      "Title": "کہاں تلک کہوں ساقی کہ لا شراب تو دے",
      "FullUrl": "/p237/ghazal/sh6535"
    },
    {
      "Id": 6536,
      "Title": "کیا آئے تم جو آئے گھڑی دو گھڑی کے بعد",
      "FullUrl": "/p237/ghazal/sh6536"
    },
    {
      "Id": 6537,
      "Title": "کیا غرض لاکھ خدائی میں ہوں دولت والے",
      "FullUrl": "/p237/ghazal/sh6537"
    },
    {
      "Id": 6538,
      "Title": "گئیں یاروں سے وہ اگلی ملاقاتوں کی سب رسمیں",
      "FullUrl": "/p237/ghazal/sh6538"
    },
    {
      "Id": 6539,
      "Title": "گہر کو جوہری صراف زر کو دیکھتے ہیں",
      "FullUrl": "/p237/ghazal/sh6539"
    },
    {
      "Id": 6540,
      "Title": "ہاتھ سینہ پہ مرے رکھ کے کدھر دیکھتے ہو",
      "FullUrl": "/p237/ghazal/sh6540"
    },
    {
      "Id": 6541,
      "Title": "ہم ہیں اور شغل عشق بازی ہے",
      "FullUrl": "/p237/ghazal/sh6541"
    },
    {
      "Id": 6542,
      "Title": "ہنگامہ گرم ہستئ نا پائیدار کا",
      "FullUrl": "/p237/ghazal/sh6542"
    },
    {
      "Id": 6543,
      "Title": "ہوئے کیوں اس پہ عاشق ہم ابھی سے",
      "FullUrl": "/p237/ghazal/sh6543"
    },
    {
      "Id": 6544,
      "Title": "ہیں دہن غنچوں کے وا کیا جانے کیا کہنے کو ہیں",
      "FullUrl": "/p237/ghazal/sh6544"
    },
    {
      "Id": 6545,
      "Title": "یہ اقامت ہمیں پیغام سفر دیتی ہے",
      "FullUrl": "/p237/ghazal/sh6545"
    }
  ]
