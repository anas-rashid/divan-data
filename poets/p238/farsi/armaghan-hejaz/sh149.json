  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "به نور تو برافروزم نگه را",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "که بینم اندرون مهر و مه را",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "چو می‌گویم مسلمانم، بلرزم",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "که دانم مشکلات «لا اله» را",
