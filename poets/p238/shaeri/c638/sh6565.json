      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Right",
      "Text": "یورپ کے کرگسوں کو نہیں ہے ابھی خبر",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Left",
      "Text": "ہے کتنی زہر ناک ابی سِینیا کی لاش",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Single",
      "Text": "ہونے کو ہے یہ مُردۂ دیرینہ قاش قاش!",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تہذیب کا کمال شرافت کا ہے زوال",
      "CoupletIndex": 3,
