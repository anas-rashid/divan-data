      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Single",
      "Text": "ہر گُرگ کو ہے برّۂ معصوم کی تلاش!",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
