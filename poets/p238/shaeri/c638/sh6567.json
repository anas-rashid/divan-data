      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "پابندیِ تقدیر کہ پابندیِ احکام!\r\nیہ مسئلہ مشکل نہیں اے مردِ خرد مند\r\nاک آن میں سَو بار بدل جاتی ہے تقدیر\r\nہے اس کا مُقلِّد ابھی ناخوش، ابھی خُورسند\r\nتقدیر کے پابند نباتات و جمادات\r\nمومن فقط احکامِ الٰہی کا ہے پابند",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "پابندیِ تقدیر کہ پابندیِ احکام!",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یہ مسئلہ مشکل نہیں اے مردِ خرد مند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "اک آن میں سَو بار بدل جاتی ہے تقدیر",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ہے اس کا مُقلِّد ابھی ناخوش، ابھی خُورسند",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تقدیر کے پابند نباتات و جمادات",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مومن فقط احکامِ الٰہی کا ہے پابند",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    }
  ]
