      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نااہل کو حاصل ہے کبھی قُوّت و جبروت\r\nہے خوار زمانے میں کبھی جوہرِ ذاتی\r\nشاید کوئی منطق ہو نہاں اس کے عمل میں\r\nتقدیر نہیں تابعِ منطق نظر آتی\r\nہاں، ایک حقیقت ہے کہ معلوم ہے سب کو\r\nتاریخِ اُمَم جس کو نہیں ہم سے چھُپاتی\r\n’ہر لحظہ ہے قوموں کے عمل پر نظر اس کی\r\nبُرّاں صفَتِ تیغِ دو پیکر نظر اس کی!‘",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نااہل کو حاصل ہے کبھی قُوّت و جبروت",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "ہے خوار زمانے میں کبھی جوہرِ ذاتی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "شاید کوئی منطق ہو نہاں اس کے عمل میں",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "تقدیر نہیں تابعِ منطق نظر آتی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ہاں، ایک حقیقت ہے کہ معلوم ہے سب کو",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تاریخِ اُمَم جس کو نہیں ہم سے چھُپاتی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "’ہر لحظہ ہے قوموں کے عمل پر نظر اس کی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
