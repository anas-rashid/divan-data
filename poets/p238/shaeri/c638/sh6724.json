      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "وہ صاحبِ ’تُحفۃالعراقَین،\r\nاربابِ نظر کا قُرّۃالعَین\r\nہے پردہ شگاف اُس کا اِدراک\r\nپردے ہیں تمام چاک در چاک\r\nخاموش ہے عالَمِ معانی\r\nکہتا نہیں حرفِ ’لن ترانی‘!\r\nپُوچھ اس سے یہ خاک داں ہے کیا چیز\r\nہنگامۂ این و آں ہے کیا چیز\r\nوہ محرمِ عالَمِ مکافات\r\nاک بات میں کہہ گیا ہے سَو بات\r\n“خود بوے چنیں جہاں تواں برُد\r\nکابلیس بماند و بوالبشر مُرد!”",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 6
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "وہ صاحبِ ’تُحفۃالعراقَین،",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "اربابِ نظر کا قُرّۃالعَین",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ہے پردہ شگاف اُس کا اِدراک",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "پردے ہیں تمام چاک در چاک",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "خاموش ہے عالَمِ معانی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کہتا نہیں حرفِ ’لن ترانی‘!",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "پُوچھ اس سے یہ خاک داں ہے کیا چیز",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ہنگامۂ این و آں ہے کیا چیز",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "وہ محرمِ عالَمِ مکافات",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "اک بات میں کہہ گیا ہے سَو بات",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "“خود بوے چنیں جہاں تواں برُد",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
