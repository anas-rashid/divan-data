      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "اُمید کیا ہے سیاست کے پیشواؤں سے\r\nیہ خاک باز ہیں، رکھتے ہیں خاک سے پیوند\r\nہمیشہ مور و مگس پر نگاہ ہے ان کی\r\nجہاں میں ہے صفَتِ عنکبوت ان کی کمند\r\nخوشا وہ قافلہ، جس کے امیر کی ہے متاع\r\nتخیّلِ ملکوتی و جذبہ ہائے بلند!",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "اُمید کیا ہے سیاست کے پیشواؤں سے",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یہ خاک باز ہیں، رکھتے ہیں خاک سے پیوند",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ہمیشہ مور و مگس پر نگاہ ہے ان کی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جہاں میں ہے صفَتِ عنکبوت ان کی کمند",
