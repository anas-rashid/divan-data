      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ہے شعرِ عجَم گرچہ طرب ناک و دل آویز\r\nاس شعر سے ہوتی نہیں شمشیرِ خودی تیز\r\nافسُردہ اگر اس کی نَوا سے ہو گُلستاں\r\nبہتر ہے کہ خاموش رہے مُرغِ سحَر خیز\r\nوہ ضرب اگر کوہ شکن بھی ہو تو کیا ہے\r\nجس سے مُتزلزل نہ ہُوئی دولتِ پرویز\r\nاقبالؔ یہ ہے خارہ تراشی کا زمانہ\r\n’از ہر چہ بآئینہ نمایند بہ پرہیز‘",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur",
      "CoupletsCount": 4
    }
