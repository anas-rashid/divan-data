      "RhymeLetters": null,
      "PlainText": "فطرت کے مقاصد کی کرتا ہے نِگہبانی\r\nیا بندۂ صحرائی یا مردِ کُہستانی\r\nدنیا میں مُحاسب ہے تہذیبِ فُسوں گر کا\r\nہے اس کی فقیری میں سرمایۂ سُلطانی\r\nیہ حُسن و لطافت کیوں؟ وہ قُوّت و شوکت کیوں\r\nبُلبل چمَنِستانی، شہباز بیابانی!\r\nاے شیخ! بہت اچھّی مکتب کی فضا، لیکن\r\nبنتی ہے بیاباں میں فاروقی و سلمانی\r\nصدیوں میں کہیں پیدا ہوتا ہے حریف اس کا\r\nتلوار ہے تیزی میں صہبائے مسلمانی!",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur",
      "CoupletsCount": 5
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "فطرت کے مقاصد کی کرتا ہے نِگہبانی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "یا بندۂ صحرائی یا مردِ کُہستانی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دنیا میں مُحاسب ہے تہذیبِ فُسوں گر کا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ہے اس کی فقیری میں سرمایۂ سُلطانی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "یہ حُسن و لطافت کیوں؟ وہ قُوّت و شوکت کیوں",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "بُلبل چمَنِستانی، شہباز بیابانی!",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "اے شیخ! بہت اچھّی مکتب کی فضا، لیکن",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "بنتی ہے بیاباں میں فاروقی و سلمانی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "صدیوں میں کہیں پیدا ہوتا ہے حریف اس کا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تلوار ہے تیزی میں صہبائے مسلمانی!",
