      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کل ساحلِ دریا پہ کہا مجھ سے خضَر نے\r\nتُو ڈھُونڈ رہا ہے سمِ افرنگ کا تریاق؟\r\nاک نکتہ مرے پاس ہے شمشیر کی مانند\r\nبُرّندہ و صَیقل زدہ و روشن و بَرّاق\r\nکافر کی یہ پہچان کہ آفاق میں گُم ہے\r\nمومن کی یہ پہچان کہ گُم اس میں ہیں آفاق!",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کل ساحلِ دریا پہ کہا مجھ سے خضَر نے",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "تُو ڈھُونڈ رہا ہے سمِ افرنگ کا تریاق؟",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "اک نکتہ مرے پاس ہے شمشیر کی مانند",
