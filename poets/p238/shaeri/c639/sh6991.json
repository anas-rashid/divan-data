      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ہو مبارک اُس شہنشاہِ نِکو فرجام کو\r\nجس کی قربانی سے اسرار ملوکیّت ہیں فاش\r\n’شاہ‘ ہے برطانوی مندر میں اک مٹّی کا بُت\r\nجس کو کر سکتے ہیں، جب چاہیں پُجاری پاش پاش\r\nہے یہ مُشک آمیز افیوں ہم غلاموں کے لیے\r\nساحرِ انگلیس! مارا خواجۂ دیگر تراش",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "ہو مبارک اُس شہنشاہِ نِکو فرجام کو",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "جس کی قربانی سے اسرار ملوکیّت ہیں فاش",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "’شاہ‘ ہے برطانوی مندر میں اک مٹّی کا بُت",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "جس کو کر سکتے ہیں، جب چاہیں پُجاری پاش پاش",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "ہے یہ مُشک آمیز افیوں ہم غلاموں کے لیے",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ساحرِ انگلیس! مارا خواجۂ دیگر تراش",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    }
  ]
