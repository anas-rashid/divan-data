      "RhymeLetters": null,
      "PlainText": "کلیِسا کی بُنیاد رُہبانیت تھی\r\nسماتی کہاں اس فقیری میں مِیری\r\nخصومت تھی سُلطانی و راہبی میں\r\nکہ وہ سربلندی ہے یہ سربزیری\r\nسیاست نے مذہب سے پِیچھا چھُٹرایا\r\nچلی کچھ نہ پِیرِ کلیسا کی پیری\r\nہُوئی دِین و دولت میں جس دم جُدائی\r\nہوَس کی امیریِ، ہوَس کی وزیری\r\nدُوئی ملک و دِیں کے لیے نامرادی\r\nدوئی چشمِ تہذیب کی نابصیری\r\nیہ اعجاز ہے ایک صحرا نشیں کا\r\nبشیری ہے آئینہ دارِ نذیری!\r\nاسی میں حفاظت ہے انسانیت کی\r\nکہ ہوں ایک جُنیّدی و اردشیری",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 7
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کلیِسا کی بُنیاد رُہبانیت تھی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "سماتی کہاں اس فقیری میں مِیری",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "خصومت تھی سُلطانی و راہبی میں",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کہ وہ سربلندی ہے یہ سربزیری",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "سیاست نے مذہب سے پِیچھا چھُٹرایا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "چلی کچھ نہ پِیرِ کلیسا کی پیری",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ہُوئی دِین و دولت میں جس دم جُدائی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ہوَس کی امیریِ، ہوَس کی وزیری",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دُوئی ملک و دِیں کے لیے نامرادی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دوئی چشمِ تہذیب کی نابصیری",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یہ اعجاز ہے ایک صحرا نشیں کا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "بشیری ہے آئینہ دارِ نذیری!",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "اسی میں حفاظت ہے انسانیت کی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "کہ ہوں ایک جُنیّدی و اردشیری",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ]
}
