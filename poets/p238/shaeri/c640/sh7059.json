      "RhymeLetters": null,
      "PlainText": "نے مُہرہ باقی، نے مُہرہ بازی\r\nجیتا ہے رومیؔ، ہارا ہے رازیؔ\r\nروشن ہے جامِ جمشید اب تک\r\nشاہی نہیں ہے بے شیشہ بازی\r\nدل ہے مسلماں میرا نہ تیرا\r\nتُو بھی نمازی، میں بھی نمازی!\r\nمیں جانتا ہوں انجام اُس کا\r\nجس معرکے میں مُلّا ہوں غازی\r\nتُرکی بھی شیریں، تازی بھی شیریں\r\nحرفِ محبّت تُرکی نہ تازی\r\nآزر کا پیشہ خارا تراشی\r\nکارِ خلیلاں خارا گدازی\r\nتُو زندگی ہے، پائندگی ہے\r\nباقی ہے جو کچھ، سب خاک‌بازی",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur-PK",
      "CoupletsCount": 7
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "نے مُہرہ باقی، نے مُہرہ بازی",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "جیتا ہے رومیؔ، ہارا ہے رازیؔ",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "روشن ہے جامِ جمشید اب تک",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "شاہی نہیں ہے بے شیشہ بازی",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دل ہے مسلماں میرا نہ تیرا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "تُو بھی نمازی، میں بھی نمازی!",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "میں جانتا ہوں انجام اُس کا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "جس معرکے میں مُلّا ہوں غازی",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "تُرکی بھی شیریں، تازی بھی شیریں",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "حرفِ محبّت تُرکی نہ تازی",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "آزر کا پیشہ خارا تراشی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "کارِ خلیلاں خارا گدازی",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "تُو زندگی ہے، پائندگی ہے",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "باقی ہے جو کچھ، سب خاک‌بازی",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ]
