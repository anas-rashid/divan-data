    },
    {
      "VOrder": 49,
      "Position": "Single",
      "Text": "قلب پہلو می زند با زر بشب",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Single",
      "Text": "انتظارِ روز می دارد ذہب",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "مریدِہندی",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Single",
      "Text": "سِرِّ آدم سے مجھے آگاہ کر",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Single",
      "Text": "خاک کے ذرّے کو مہر و ماہ کر!",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Single",
      "Text": "ظاہرش را پشۂ آرد بچرخ",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Single",
      "Text": "باطنش آمد محیطِ ہفت چرخ",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Single",
      "Text": "خاک تیرے نُور سے روشن بصر",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Single",
      "Text": "غایتِ آدم خبر ہے یا نظر؟",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "آدمی دید است، باقی پوست است",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "دید آں باشد کہ دیدِ دوست است",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "زندہ ہے مشرق تری گُفتار سے",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Single",
      "Text": "اُمتّیں مرتی ہیں کس آزار سے؟",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Single",
      "Text": "پیرِ رومی",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Single",
      "Text": "ہر ہلاکِ اُمّت پیشیں کہ بود",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Single",
      "Text": "زانکہ بر جندل گماں بردند عود",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Single",
      "Text": "اب مسلماں میں نہیں وہ رنگ و بُو",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Single",
      "Text": "سرد کیونکر ہو گیا اس کا لہُو؟",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Single",
      "Text": "تا دلِ صاحبدلے نامد بہ درد",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Single",
      "Text": "ہیچ قومے را خدا رُسوا نہ کرد",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Single",
      "Text": "گرچہ بے رونق ہے بازارِ وجود",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Single",
      "Text": "کون سے سودے میں ہے مَردوں کا سُود؟",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Single",
      "Text": "زیرکی بفروش و حیرانی بخر",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Single",
      "Text": "زیرکی ظنّ است و حیرانی نظر",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Single",
      "Text": "ہم نفَس میرے سلاطیں کے ندیم",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Single",
      "Text": "مَیں فقیرِ بے کلاہ و بے گِلیم!",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Single",
      "Text": "پیرِ رومی",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Single",
      "Text": "بندۂ یک مردِ روشن دل شوی",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Single",
      "Text": "بہ کہ بر فرقِ سرِ شاہاں روی",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Single",
      "Text": "اے شریکِ مستیِ خاصانِ بدر",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Single",
      "Text": "مَیں نہیں سمجھا حدیثِ جبر و قدر!",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Single",
      "Text": "پیررومی",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Single",
      "Text": "بال بازاں را سوے سُلطاں برد",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Single",
      "Text": "بال زاغاں را بگورستاں برد",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Single",
      "Text": "کاروبارِ خسروی یا راہبی",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Single",
      "Text": "کیا ہے آخر غایتِ دینِ نبیؐ؟",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Single",
      "Text": "مصلحت در دینِ ما جنگ و شکوہ",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Single",
      "Text": "مصلحت در دینِ عیسیٰؑ غار و کوہ",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Single",
      "Text": "کس طرح قابُو میں آئے آب و گل",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Single",
      "Text": "کس طرح بیدار ہو سِینے میں دل؟",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Single",
      "Text": "بندہ باش و بر زمیں رو چوں سمند",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Single",
      "Text": "چوں جنازہ نے کہ بر گردن برند",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Single",
      "Text": "سَرِّ دیں ادراک میں آتا نہیں",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Single",
      "Text": "کس طرح آئے قیامت کا یقیں؟",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Single",
      "Text": "پیرِ رومی",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Single",
      "Text": "پس قیامت شو قیامت را ببیں",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Single",
      "Text": "دیدنِ ہر چیز را شرط است ایں",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Single",
      "Text": "آسماں میں راہ کرتی ہے خودی",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Single",
      "Text": "صیدِ مہر و ماہ کرتی ہے خودی",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Single",
      "Text": "بے حضور و بافروغ و بے فراغ",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Single",
      "Text": "اپنے نخچیروں کے ہاتھوں داغ داغ!",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Single",
      "Text": "آں کہ ارزد صید را عشق است و بس",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Single",
      "Text": "لیکن او کے گُنجد اندر دامِ کس!",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Single",
      "Text": "تجھ پہ روشن ہے ضمیرِ کائنات",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Single",
      "Text": "کس طرح مُحکم ہو ملّت کی حیات؟",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Single",
      "Text": "پیرِ رومی",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Single",
      "Text": "دانہ باشی مُرغکانت برچنند",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Single",
      "Text": "غنچہ باشی کود کانت برکنند",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Single",
      "Text": "دانہ پنہاں کن سراپا دام شو",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Single",
      "Text": "غنچہ پنہاں کن گیاہِ بام شو",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Single",
      "Text": "تُو یہ کہتا ہے کہ دل کی کر تلاش",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Single",
      "Text": "’طالبِ دل باش و در پیکار باش‘",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Single",
      "Text": "جو مِرا دل ہے، مرے سینے میں ہے",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Single",
      "Text": "میرا جوہر میرے آئینے میں ہے",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 131,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Single",
      "Text": "تُو ہمی گوئی مرا دل نیز ہست",
      "CoupletIndex": 132,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Single",
      "Text": "دل فرازِ عرش باشد نے بہ پست",
      "CoupletIndex": 133,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Single",
      "Text": "تُو دلِ خود را دلے پنداشتی",
      "CoupletIndex": 134,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Single",
      "Text": "جُستجوے اہلِ دل بگذاشتی",
      "CoupletIndex": 135,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 136,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Single",
      "Text": "آسمانوں پر مرا فکرِ بلند",
      "CoupletIndex": 137,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Single",
      "Text": "مَیں زمیں پر خوار و زار و دردمند",
      "CoupletIndex": 138,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Single",
      "Text": "کارِ دنیا میں رہا جاتا ہوں مَیں",
      "CoupletIndex": 139,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Single",
      "Text": "ٹھوکریں اس راہ میں کھاتا ہوں مَیں",
      "CoupletIndex": 140,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Single",
      "Text": "کیوں مرے بس کا نہیں کارِ زمیں",
      "CoupletIndex": 141,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Single",
      "Text": "ابلہِ دنیا ہے کیوں دانائے دِیں؟",
      "CoupletIndex": 142,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 143,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Single",
      "Text": "آں کہ بر افلاک رفتارش بود",
      "CoupletIndex": 144,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Single",
      "Text": "بر زمیں رفتن چہ دشوارش بود",
      "CoupletIndex": 145,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 146,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Single",
      "Text": "علم و حکمت کا مِلے کیونکر سُراغ",
      "CoupletIndex": 147,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Single",
      "Text": "کس طرح ہاتھ آئے سوز و درد و داغ",
      "CoupletIndex": 148,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Single",
      "Text": "پیرِرومی",
      "CoupletIndex": 149,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Single",
      "Text": "علم و حکمت زاید از نانِ حلال",
      "CoupletIndex": 150,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Single",
      "Text": "عشق و رِقّت آید از نانِ حلال",
      "CoupletIndex": 151,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Single",
      "Text": "مریدِ ہندی",
      "CoupletIndex": 152,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Single",
      "Text": "ہے زمانے کا تقاضا انجمن",
      "CoupletIndex": 153,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Single",
      "Text": "اور بے خلوَت نہیں سوزِ سخن!",
      "CoupletIndex": 154,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Single",
      "Text": "پیرِ رومی",
      "CoupletIndex": 155,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Single",
      "Text": "خلوَت از اغیار باید، نے ز یار",
