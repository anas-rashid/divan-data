      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "قوم گویا جسم ہے، افراد ہیں اعضائے قوم\r\nمنزلِ صنعت کے رہ پیما ہیں دست و پائے قوم\r\nمحفلِ نظمِ حکومت، چہرۂ زیبائے قوم\r\nشاعر رنگیں نوا ہے دیدۂ بینائے قوم\r\nمبتلائے درد کوئی عُضو ہو روتی ہے آنکھ\r\nکس قدر ہمدرد سارے جسم کی ہوتی ہے آنکھ",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur",
      "CoupletsCount": 3
    }
