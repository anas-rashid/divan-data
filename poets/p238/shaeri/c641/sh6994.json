      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ممبری امپِیریَل کونسل کی کچھ مشکل نہیں\r\nووٹ تو مِل جائیں گے، پیسے بھی دِلوائیں گے کیا؟\r\nمیرزا غالبؔ خُدا بخشے، بجا فرما گئے\r\n“ہم نے یہ ماناکہ دِلّی میں رہیں، کھائیں گے کیا؟”",
      "HtmlText": null,
      "PoemFormat": null,
      "Language": "ur",
      "CoupletsCount": 2
    }
