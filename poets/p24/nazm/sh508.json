      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "مہربانی تھی سب، نہ تھا یہ ستم",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    }
  ]
