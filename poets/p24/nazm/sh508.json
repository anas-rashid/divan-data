      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "یہی سورج زمیں تھے ماں باوا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
