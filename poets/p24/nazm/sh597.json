    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "بیٹھ جاتا تھا وہ دامن کو سمیٹ",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
