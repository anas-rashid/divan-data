      "RadifLetter": "و"
    },
    {
      "Id": 7287,
      "Title": "قید اور قید بھی تنہائی کی",
      "FullUrl": "/p245/ghazal/sh7287",
      "RadifLetter": "ی"
    },
    {
      "Id": 7283,
      "Title": "خوگر جور پہ تھوڑی سی جفا اور سہی",
