      "RadifLetter": "ے"
    },
    {
      "Id": 7290,
      "Title": "گلہ اے دل ابھی سے کرتا ہے",
      "FullUrl": "/p245/ghazal/sh7290",
      "RadifLetter": "ے"
    },
    {
      "Id": 7284,
      "Title": "دل کو ہلاک جلوۂ جاناں بنائیے",
