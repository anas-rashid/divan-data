      "RadifLetter": "ا"
    },
    {
      "Id": 7288,
      "Title": "ڈر نہیں مجھ کو گناہوں کی گراں باری کا",
      "FullUrl": "/p245/ghazal/sh7288",
      "RadifLetter": "ا"
    },
    {
      "Id": 7291,
      "Title": "ہم معنی ہوس نہیں اے دل ہوائے دوست",
      "FullUrl": "/p245/ghazal/sh7291",
      "RadifLetter": "ت"
    },
    {
      "Id": 7285,
      "Title": "دور حیات آئے گا قاتل قضا کے بعد",
