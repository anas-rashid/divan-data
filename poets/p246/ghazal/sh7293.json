      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "غصہ آتا ہے پیار آتا ہے\r\nغیر کے گھر سے یار آتا ہے\r\nمے پلانی اگر نہیں منظور\r\nابر کیوں بار بار آتا ہے\r\nتیرے رونے سے اب مجھے بھی خوف\r\nدیدۂ اشک بار آتا ہے\r\nدرد دل کیا بیاں کروں رشکیؔ\r\nاس کو کب اعتبار آتا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
