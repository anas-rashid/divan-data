    {
      "Id": 617,
      "Title": "خون آنکھوں سے نکلتا ہی رہا",
      "FullUrl": "/p25/ghazal/sh617",
      "RadifLetter": "ا"
    },
    {
      "Id": 624,
      "Title": "ہرگز مرا وحشی نہ ہوا رام کسی کا",
      "FullUrl": "/p25/ghazal/sh624",
      "RadifLetter": "ا"
    },
    {
      "Id": 618,
      "Title": "دل دھڑکتا ہے کہ تو یار ہے سودائی کا",
      "FullUrl": "/p25/ghazal/sh618",
      "RadifLetter": "ا"
    },
    {
      "Id": 615,
      "Title": "بہار آئی ہے سوتے کو ٹک جگا دینا",
      "FullUrl": "/p25/ghazal/sh615",
      "RadifLetter": "ا"
    },
    {
      "Id": 613,
      "Title": "اے تجلی کیا ہوا شیوہ تری تکرار کا",
      "FullUrl": "/p25/ghazal/sh613",
      "RadifLetter": "ا"
    },
    {
      "Id": 612,
      "Title": "اگر عاشق کوئی پیدا نہ ہوتا",
      "FullUrl": "/p25/ghazal/sh612",
      "RadifLetter": "ا"
    },
    {
      "Id": 620,
      "Title": "عالم میں اگر عشق کا بازار نہ ہوتا",
      "FullUrl": "/p25/ghazal/sh620",
      "RadifLetter": "ا"
    },
    {
      "Id": 619,
      "Title": "دیکھیے خاک میں مجنوں کی اثر ہے کہ نہیں",
      "FullUrl": "/p25/ghazal/sh619",
      "RadifLetter": "ن"
    },
    {
      "Id": 616,
      "Title": "حیف دل میں ترے وفا نہ ہوئی",
      "FullUrl": "/p25/ghazal/sh616",
      "RadifLetter": "ی"
    },
    {
      "Id": 611,
      "Title": "اٹھ چکا دل مرا زمانے سے",
      "FullUrl": "/p25/ghazal/sh611",
      "RadifLetter": "ے"
    },
    {
      "Id": 610,
      "Title": "اس جور و جفا سے ترے زنہار نہ ٹوٹے",
      "FullUrl": "/p25/ghazal/sh610",
      "RadifLetter": "ے"
    },
    {
      "Id": 623,
      "Title": "ڈرتا ہوں محبت میں مرا نام نہ ہووے",
      "FullUrl": "/p25/ghazal/sh623",
      "RadifLetter": "ے"
    },
    {
      "Id": 614,
      "Title": "بسکہ دیدار ترا جلوۂ قدوسی ہے",
      "FullUrl": "/p25/ghazal/sh614",
      "RadifLetter": "ے"
    },
    {
      "Id": 622,
      "Title": "عکس بھی کب شب ہجراں کا تماشائی ہے",
      "FullUrl": "/p25/ghazal/sh622",
      "RadifLetter": "ے"
    },
    {
      "Id": 621,
      "Title": "عبث عبث تجھے مجھ سے حجاب آتا ہے",
