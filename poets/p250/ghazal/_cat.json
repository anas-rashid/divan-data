  "Poems": [
    {
      "Id": 7325,
      "Title": "مجھے پہلے تم اک نظر دیکھ لینا",
      "FullUrl": "/p250/ghazal/sh7325",
      "RadifLetter": "ا"
    },
    {
      "Id": 7319,
      "Title": "جہاں نہ دوست نہ گلچیں نہ باغباں میرا",
      "FullUrl": "/p250/ghazal/sh7319",
      "RadifLetter": "ا"
    },
    {
      "Id": 7322,
      "Title": "ظاہر فریب نرگس مستانہ ہو گیا",
      "FullUrl": "/p250/ghazal/sh7322",
      "RadifLetter": "ا"
    },
    {
      "Id": 7323,
      "Title": "غم فرقت سہا نہیں جاتا",
      "FullUrl": "/p250/ghazal/sh7323",
      "RadifLetter": "ا"
    },
    {
      "Id": 7317,
      "Title": "جب ہوا وعدہ اور وفا نہ ہوا",
      "FullUrl": "/p250/ghazal/sh7317",
      "RadifLetter": "ا"
    },
    {
      "Id": 7327,
      "Title": "وہ بھی کیا دن تھے کہ الفت کا سبق یاد نہ تھا",
      "FullUrl": "/p250/ghazal/sh7327",
      "RadifLetter": "ا"
    },
    {
      "Id": 7328,
      "Title": "گھر میں نظر آتی نہیں غم خوار کی صورت",
      "FullUrl": "/p250/ghazal/sh7328",
      "RadifLetter": "ت"
    },
    {
      "Id": 7324,
      "Title": "مانا کہ سخت ہوتی ہے تیر و تبر کی چوٹ",
      "FullUrl": "/p250/ghazal/sh7324",
      "RadifLetter": "ٹ"
    },
    {
      "Id": 7321,
      "Title": "دل سوز غم سے جلتا ہے لب پر فغاں نہیں",
      "FullUrl": "/p250/ghazal/sh7321",
      "RadifLetter": "ن"
    },
    {
      "Id": 7329,
      "Title": "یہ سچ ہے ہر جگہ تم جلوہ گر ہو",
      "FullUrl": "/p250/ghazal/sh7329",
      "RadifLetter": "و"
    },
    {
      "Id": 7320,
      "Title": "خدا کی شان ہے ان میں اگر مہر و وفا ہوتی",
      "FullUrl": "/p250/ghazal/sh7320",
      "RadifLetter": "ی"
    },
    {
      "Id": 7318,
      "Title": "جور کب تک سہا کرے کوئی",
      "FullUrl": "/p250/ghazal/sh7318",
      "RadifLetter": "ی"
    },
    {
      "Id": 7326,
      "Title": "نیک و بد عشق میں جو ہے مری تقدیر میں ہے",
      "FullUrl": "/p250/ghazal/sh7326",
      "RadifLetter": "ے"
    }
