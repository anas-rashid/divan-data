  "Poems": [
    {
      "Id": 7346,
      "Title": "پھر بہار آئی ہے پھر جوش میں سودا ہوگا",
      "FullUrl": "/p252/ghazal/sh7346",
      "RadifLetter": "ا"
    },
    {
      "Id": 7332,
      "Title": "آخر دل کی پرانی لگن کر کے ہی رہے گی فقیر ہمیں",
      "FullUrl": "/p252/ghazal/sh7332",
      "RadifLetter": "ن"
    },
    {
      "Id": 7336,
      "Title": "دھیان کی موج کو پھر آئنہ سیما کر لیں",
      "FullUrl": "/p252/ghazal/sh7336",
      "RadifLetter": "ن"
    },
    {
      "Id": 7342,
      "Title": "موت کو زیست ترستی ہے یہاں",
      "FullUrl": "/p252/ghazal/sh7342",
      "RadifLetter": "ن"
    },
    {
      "Id": 7338,
      "Title": "رات کے بعد وہ صبح کہاں ہے دن کے بعد وہ شام کہاں",
      "FullUrl": "/p252/ghazal/sh7338",
      "RadifLetter": "ن"
    },
    {
      "Id": 7343,
      "Title": "نور سحر کہاں ہے اگر شام غم گئی",
      "FullUrl": "/p252/ghazal/sh7343",
      "RadifLetter": "ی"
    },
    {
      "Id": 7333,
      "Title": "بستیاں کیسے نہ ممنون ہوں دیوانوں کی",
      "FullUrl": "/p252/ghazal/sh7333",
      "RadifLetter": "ی"
    },
    {
      "Id": 7334,
      "Title": "ترے جلوے تیرے حجاب کو میری حیرتوں سے نمو ملی",
      "FullUrl": "/p252/ghazal/sh7334",
      "RadifLetter": "ی"
    },
    {
      "Id": 7335,
      "Title": "تھی تو سہی پر آج سے پہلے ایسی حقیر فقیر نہ تھی",
      "FullUrl": "/p252/ghazal/sh7335",
      "RadifLetter": "ی"
    },
    {
      "Id": 7348,
      "Title": "کی شب حشر مری شام جوانی تم نے",
      "FullUrl": "/p252/ghazal/sh7348",
      "RadifLetter": "ے"
    },
    {
      "Id": 7344,
      "Title": "وہی اک پکار وہی فغاں مری مہر دیدہ و لب میں ہے",
      "FullUrl": "/p252/ghazal/sh7344",
      "RadifLetter": "ے"
    },
    {
      "Id": 7340,
      "Title": "شوخ تھے رنگ ہر اک دور میں افسانوں کے",
      "FullUrl": "/p252/ghazal/sh7340",
      "RadifLetter": "ے"
    }
  ]
}
