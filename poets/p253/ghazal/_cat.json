  "Poems": [
    {
      "Id": 7349,
      "Title": "تم سے وابستہ ہے میری موت میری زندگی",
      "FullUrl": "/p253/ghazal/sh7349"
    },
    {
      "Id": 7350,
      "Title": "خدا جب تک نہ چاہے آدمی سے کچھ نہیں ہوتا",
      "FullUrl": "/p253/ghazal/sh7350"
    },
    {
      "Id": 7351,
      "Title": "دلائل سے خدا تک عقل انسانی نہیں جاتی",
      "FullUrl": "/p253/ghazal/sh7351"
    },
    {
      "Id": 7352,
      "Title": "دوئی کا تذکرہ توحید میں پایا نہیں جاتا",
      "FullUrl": "/p253/ghazal/sh7352"
    },
    {
      "Id": 7353,
      "Title": "رخ ہر اک تیر نظر کا ہے مرے دل کی طرف",
      "FullUrl": "/p253/ghazal/sh7353"
    },
    {
      "Id": 7354,
      "Title": "کسے اپنا بنائیں کوئی اس قابل نہیں ملتا",
      "FullUrl": "/p253/ghazal/sh7354"
    },
    {
      "Id": 7355,
      "Title": "ہزار رنج ہو دل لاکھ درد مند رہے",
      "FullUrl": "/p253/ghazal/sh7355"
    },
    {
      "Id": 7356,
      "Title": "یہ تجھ سے آشنا دنیا سے بیگانے کہاں جاتے",
      "FullUrl": "/p253/ghazal/sh7356"
    }
  ]
}
