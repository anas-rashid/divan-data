  "ChildCats": [],
  "Poems": [
    {
      "Id": 7357,
      "Title": "آنکھوں میں مری پھرتی ہے تصویر کسی کی",
      "FullUrl": "/p254/ghazal/c688/sh7357"
    },
    {
      "Id": 7358,
      "Title": "اے رشک قمر آگے ترے شمس و قمر کیا",
      "FullUrl": "/p254/ghazal/c688/sh7358"
    },
    {
      "Id": 7359,
      "Title": "تو ہی ہے مری یہ بود و بقا تو اور نہیں میں اور نہیں",
      "FullUrl": "/p254/ghazal/c688/sh7359"
    },
    {
      "Id": 7360,
      "Title": "جشن تجھ کو مرے نو شاہ مبارک ہوئے",
      "FullUrl": "/p254/ghazal/c688/sh7360"
    },
    {
      "Id": 7361,
      "Title": "جو یہ جسم سر تا قدم دیکھتے ہیں",
      "FullUrl": "/p254/ghazal/c688/sh7361"
    },
    {
      "Id": 7362,
      "Title": "دل ہے روشن کہ ہے دل میں رخ روشن ان کا",
      "FullUrl": "/p254/ghazal/c688/sh7362"
    },
    {
      "Id": 7363,
      "Title": "لاکھ دیکھوں تجھے پھرتی نہیں نیت میری",
      "FullUrl": "/p254/ghazal/c688/sh7363"
    },
    {
      "Id": 7364,
      "Title": "مری صورت میں مرا یار ہے اللہ اللہ",
      "FullUrl": "/p254/ghazal/c688/sh7364"
    },
    {
      "Id": 7365,
      "Title": "میرے مرشد ہو پیشوا ہو تم",
      "FullUrl": "/p254/ghazal/c688/sh7365"
    },
    {
      "Id": 7366,
      "Title": "نہ گل سے کام ہے ہم کو نہ کچھ گلزار سے مطلب",
      "FullUrl": "/p254/ghazal/c688/sh7366"
    },
    {
      "Id": 7367,
      "Title": "کام اتنا میرے پیارے چرخ کہن سے نکلے",
      "FullUrl": "/p254/ghazal/c688/sh7367"
    }
  ]
}
