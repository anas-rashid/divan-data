      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "جشن تجھ کو مرے نو شاہ مبارک ہوئے\r\nبزم عشرت تری دل خواہ مبارک ہوئے\r\nشادماں باپ ہو اور بزم کے حاضر سب لوگ\r\nتجھ کو ثروت مرے جم جاہ مبارک ہوئے\r\nہویں فرزند سعید اور نشاطیں پیہم\r\nفرخ ہر سال ہو ہر ماہ مبارک ہوئے\r\nہم تو شادی کی مناتے ہیں ہمیشہ گھڑیاں\r\nدولہا دلہن تجھے ذی جاہ مبارک ہوئے\r\nدامن جامہ ہے پابوس ترا اے مرداںؔ\r\nجامہ زیبی تری نو شاہ مبارک ہوئے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
