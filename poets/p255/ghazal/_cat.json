  "Title": "غزل",
  "FullUrl": "/p255/ghazal",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 7377,
      "Title": "گئی جو طفلی تو پھر عالم شباب آیا",
      "FullUrl": "/p255/ghazal/sh7377"
    },
    {
      "Id": 7373,
      "Title": "وہ مسیحا قبر پر آتا رہا",
      "FullUrl": "/p255/ghazal/sh7373"
    },
    {
      "Id": 7375,
      "Title": "کر دیا زار غم عشق نے ایسا مجھ کو",
      "FullUrl": "/p255/ghazal/sh7375"
    },
    {
      "Id": 7369,
      "Title": "تیغ نگہ دیدۂ خوں خار نکالی",
      "FullUrl": "/p255/ghazal/sh7369"
    },
    {
      "Id": 7374,
      "Title": "پسے ہیں دل زیادہ تر حنا سے",
      "FullUrl": "/p255/ghazal/sh7374"
    },
    {
      "Id": 7370,
      "Title": "جس کو سب کہتے ہیں سمندر ہے",
      "FullUrl": "/p255/ghazal/sh7370"
    },
    {
      "Id": 7368,
      "Title": "باشندے حقیقت میں ہیں ہم ملک بقا کے",
      "FullUrl": "/p255/ghazal/sh7368"
    },
    {
      "Id": 7371,
      "Title": "لے قضا احسان تجھ پر کر چلے",
      "FullUrl": "/p255/ghazal/sh7371"
    },
    {
      "Id": 7376,
      "Title": "کر چکا قید سے جس وقت کہ آزاد مجھے",
      "FullUrl": "/p255/ghazal/sh7376"
    },
    {
      "Id": 7378,
      "Title": "گئی فصل بہار گلشن سے",
      "FullUrl": "/p255/ghazal/sh7378"
    },
    {
      "Id": 7372,
      "Title": "واہ کیا حسن کیسا جوبن ہے",
      "FullUrl": "/p255/ghazal/sh7372"
    },
    {
      "Id": 7379,
      "Title": "ہجر جاناں میں جی سے جانا ہے",
      "FullUrl": "/p255/ghazal/sh7379"
    }
  ]
}
