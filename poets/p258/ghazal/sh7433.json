      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تجھ میں جس دم دھیان جاتا ہے\r\nہوش آیا اس آن جاتا ہے\r\nدل مرا گم ہوا صنم اللہ\r\nتجھ پہ میرا گمان جانا ہے\r\nتیرے مژگاں کی کیا کروں تعریف\r\nتیر یہ بے کمان جاتا ہے\r\nہائے ظالم ہوں نیم جاں ٹک دیکھ\r\nہاتھ سے اک جوان جاتا ہے\r\nسج مرے شوخ کی ذرا دیکھو\r\nجیسے بانکا پٹھان جاتا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 5
    }
