  "ChildCats": [],
  "Poems": [
    {
      "Id": 7461,
      "Title": "اس وقت بارے کچھ تو کرم بخشی کیجئے",
      "FullUrl": "/p259/ghazal/sh7461"
    },
    {
      "Id": 7462,
      "Title": "اے ظالم ترے جب سے پالے پڑے",
      "FullUrl": "/p259/ghazal/sh7462"
    },
    {
      "Id": 7463,
      "Title": "تجھ بے وفا کی آہ کوئی چاہ کیا کرے",
      "FullUrl": "/p259/ghazal/sh7463"
    },
    {
      "Id": 7464,
      "Title": "جب آفتاب ہو طالع سریر حشمت پر",
      "FullUrl": "/p259/ghazal/sh7464"
    },
    {
      "Id": 7465,
      "Title": "جس کو کہ دسترس ہوئی دامان یار تک",
      "FullUrl": "/p259/ghazal/sh7465"
    },
    {
      "Id": 7466,
      "Title": "جو مر گئے تری چشم سیاہ کے مارے",
      "FullUrl": "/p259/ghazal/sh7466"
    },
    {
      "Id": 7467,
      "Title": "جو کچھ کہ تو نے سر پہ مرے دل ربا کیا",
      "FullUrl": "/p259/ghazal/sh7467"
    },
    {
      "Id": 7468,
      "Title": "جو کچھ کیا سو ہم نے کیا اپنی چاہ سے",
      "FullUrl": "/p259/ghazal/sh7468"
    },
    {
      "Id": 7469,
      "Title": "جی بھرا آتا ہے خالی مے کا پیالہ دے گیا",
      "FullUrl": "/p259/ghazal/sh7469"
    },
    {
      "Id": 7470,
      "Title": "در پہ تیرے پکار کی فریاد",
      "FullUrl": "/p259/ghazal/sh7470"
    },
    {
      "Id": 7471,
      "Title": "دل پر خوں جو جام ہے میرا",
      "FullUrl": "/p259/ghazal/sh7471"
    },
    {
      "Id": 7472,
      "Title": "دل پرستار ہیں سب خلق کے مورت کی تری",
      "FullUrl": "/p259/ghazal/sh7472"
    },
    {
      "Id": 7473,
      "Title": "دنیا میں کوئی دل کا خریدار نہ پایا",
      "FullUrl": "/p259/ghazal/sh7473"
    },
    {
      "Id": 7474,
      "Title": "دیکھ تیرا جمال کچھ کا کچھ",
      "FullUrl": "/p259/ghazal/sh7474"
    },
    {
      "Id": 7475,
      "Title": "دیکھو تو میرے نالہ و آہ و فغاں کی اور",
      "FullUrl": "/p259/ghazal/sh7475"
    },
    {
      "Id": 7476,
      "Title": "سنتا نہیں کسو ہی کی وہ یار دیکھنا",
      "FullUrl": "/p259/ghazal/sh7476"
    },
    {
      "Id": 7477,
      "Title": "سینۂ پر سوز یکسو چشم گریاں یک طرف",
      "FullUrl": "/p259/ghazal/sh7477"
    },
    {
      "Id": 7478,
      "Title": "قسمت کو اپنے لکھے کے تئیں کون دھو سکے",
      "FullUrl": "/p259/ghazal/sh7478"
    },
    {
      "Id": 7479,
      "Title": "مت بولیو تو اوس سے جہاں دارؔ دیکھنا",
      "FullUrl": "/p259/ghazal/sh7479"
    },
    {
      "Id": 7480,
      "Title": "مجھ سے عاشق کے تئیں مار کے کیا پاوے گا",
      "FullUrl": "/p259/ghazal/sh7480"
    },
    {
      "Id": 7481,
      "Title": "میں تو سو بار ترے ملنے کو آیا تنہا",
      "FullUrl": "/p259/ghazal/sh7481"
    },
    {
      "Id": 7482,
      "Title": "نالہ جدھر میرا گزر کر گیا",
      "FullUrl": "/p259/ghazal/sh7482"
    },
    {
      "Id": 7483,
      "Title": "کل تک اس کی وہ مہربانی تھی",
      "FullUrl": "/p259/ghazal/sh7483"
    },
    {
      "Id": 7484,
      "Title": "کوئی کر سکتا ہے یارو جیسا میں نے کام کیا",
      "FullUrl": "/p259/ghazal/sh7484"
    },
    {
      "Id": 7485,
      "Title": "کون سی بات تری ہم سے اٹھائی نہ گئی",
      "FullUrl": "/p259/ghazal/sh7485"
    },
    {
      "Id": 7486,
      "Title": "یار جب ہم کنار ہووے گا",
      "FullUrl": "/p259/ghazal/sh7486"
    },
    {
      "Id": 7487,
      "Title": "یار کے بن بہار کیا کیجے",
      "FullUrl": "/p259/ghazal/sh7487"
    },
    {
      "Id": 7488,
      "Title": "یک دو جام اور بھی دے تو ساقی",
      "FullUrl": "/p259/ghazal/sh7488"
    }
  ]
}
