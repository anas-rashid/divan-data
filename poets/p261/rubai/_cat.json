  "Poems": [
    {
      "Id": 7493,
      "Title": "آفاق سے استاد یگانہ اٹھا",
      "FullUrl": "/p261/rubai/sh7493"
    },
    {
      "Id": 7494,
      "Title": "آہوں سے عیاں برق فشانی ہو جائے",
      "FullUrl": "/p261/rubai/sh7494"
    },
    {
      "Id": 7495,
      "Title": "ادنیٰ سے جو سر جھکائے اعلیٰ وہ ہے",
      "FullUrl": "/p261/rubai/sh7495"
    },
    {
      "Id": 7496,
      "Title": "اس بزم میں ارباب شعور آئے ہیں",
      "FullUrl": "/p261/rubai/sh7496"
    },
    {
      "Id": 7497,
      "Title": "اس بزم کو جنت سے جو خوش پاتے ہیں",
      "FullUrl": "/p261/rubai/sh7497"
    },
    {
      "Id": 7498,
      "Title": "اس در پہ ہر ایک شادماں رہتا ہے",
      "FullUrl": "/p261/rubai/sh7498"
    },
    {
      "Id": 7499,
      "Title": "اعدا کو ادھر حرام کا مال ملا",
      "FullUrl": "/p261/rubai/sh7499"
    },
    {
      "Id": 7500,
      "Title": "اے خضر کے رہبر مجھے گمراہ نہ کر",
      "FullUrl": "/p261/rubai/sh7500"
    },
    {
      "Id": 7503,
      "Title": "درگاہ علم دار سے بہبودی ہے",
      "FullUrl": "/p261/rubai/sh7503"
    },
    {
      "Id": 7505,
      "Title": "صغریٰ کا مرض کم نہ ہوا درماں سے",
      "FullUrl": "/p261/rubai/sh7505"
    },
    {
      "Id": 7506,
      "Title": "فرمان علی لوح و قلم تک پہنچا",
      "FullUrl": "/p261/rubai/sh7506"
    },
    {
      "Id": 7507,
      "Title": "مشہور جہاں ہے داستان شیریں",
      "FullUrl": "/p261/rubai/sh7507"
    },
    {
      "Id": 7508,
      "Title": "پروانے کو دھن شمع کو لو تیری ہے",
      "FullUrl": "/p261/rubai/sh7508"
    },
    {
      "Id": 7509,
      "Title": "پھر چرخ پر آسمان پیر آیا ہے",
      "FullUrl": "/p261/rubai/sh7509"
    },
    {
      "Id": 7512,
      "Title": "کیا قامت احمد نے ضیا پائی ہے",
      "FullUrl": "/p261/rubai/sh7512"
    },
    {
      "Id": 7513,
      "Title": "ہر چشم سے چشمے کی روانی ہو جائے",
      "FullUrl": "/p261/rubai/sh7513"
    },
    {
      "Id": 7514,
      "Title": "ہم شان نجف نہ عرش انور ٹھہرا",
      "FullUrl": "/p261/rubai/sh7514"
    },
    {
      "Id": 7515,
      "Title": "ہے رزم سراپا تو زباں اور ہی ہے",
      "FullUrl": "/p261/rubai/sh7515"
    },
    {
      "Id": 7516,
      "Title": "یا شاہ نجف تھام لو اس کشور کو",
      "FullUrl": "/p261/rubai/sh7516"
    }
  ]
}
