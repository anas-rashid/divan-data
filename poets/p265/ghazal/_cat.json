  "Poems": [
    {
      "Id": 7556,
      "Title": "کس کو بہلاتے ہو شیشہ کا گلو ٹوٹ گیا",
      "FullUrl": "/p265/ghazal/sh7556"
    },
    {
      "Id": 7546,
      "Title": "تیرے آگے یار نو یار کہن دونوں ہیں ایک",
      "FullUrl": "/p265/ghazal/sh7546"
    },
    {
      "Id": 7553,
      "Title": "شمع نازاں ہے فقط سر سے بھڑک جانے میں آگ",
      "FullUrl": "/p265/ghazal/sh7553"
    },
    {
      "Id": 7545,
      "Title": "تم ہو بزم عیش ہے واں اور صحبت داریاں",
      "FullUrl": "/p265/ghazal/sh7545"
    },
    {
      "Id": 7555,
      "Title": "وہ صفائی کبھی جو ہم سے ملاقات میں تھی",
      "FullUrl": "/p265/ghazal/sh7555"
    },
    {
      "Id": 7550,
      "Title": "دیکھنا جن صورتوں کا شکل تھی آرام کی",
      "FullUrl": "/p265/ghazal/sh7550"
    },
    {
      "Id": 7554,
      "Title": "نہ اتنا کیجے طلب گار کون آپ کا ہے",
      "FullUrl": "/p265/ghazal/sh7554"
    },
    {
      "Id": 7547,
      "Title": "جس دن سے ہم جنوں کے ہیں داماں لگے ہوئے",
      "FullUrl": "/p265/ghazal/sh7547"
    },
    {
      "Id": 7552,
      "Title": "سینکڑوں گل ہوئے خوش رنگ چمن میں کھل کے",
      "FullUrl": "/p265/ghazal/sh7552"
    },
    {
      "Id": 7549,
      "Title": "خوبی کا تیری بسکہ اک عالم گواہ ہے",
      "FullUrl": "/p265/ghazal/sh7549"
    }
  ]
}
