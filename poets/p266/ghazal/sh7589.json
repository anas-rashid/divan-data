      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "برشکالِ گریۂ عاشق ہے دیکھا چاہیے\r\nکھِل گئی مانندِ گُل سَو جا سے دیوارِ چمن\r\nاُلفتِ گل سے غلط ہے دعوئی وارستگی\r\nسرو ہے با وصفِ آزادی گرفتارِ چمن\r\nہے نزاکت بس کہ فصلِ گل میں معمارِ چمن\r\nقالبِ گل میں ڈھلی ہے خشتِ دیوارِ چمن",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 3
    }
