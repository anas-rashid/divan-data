      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بہ نالہ حاصل دل بستگی فراہم کر\r\nمتاع خانۂ زنجیر جز صدا معلوم\r\nبہ قدر حوصلۂ عشق جلوہ ریزی ہے\r\nوگرنہ خانۂ آئینہ کی فضا معلوم\r\nاسدؔ فریفتۂ انتخاب طرز جفا\r\nوگرنہ دلبری وعدۂ وفا معلوم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 3
    }
