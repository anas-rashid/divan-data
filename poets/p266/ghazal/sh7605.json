      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تغافل دوست ہوں میرا دماغ عجز عالی ہے\r\nاگر پہلو تہی کیجے تو جا میری بھی خالی ہے\r\nرہا آباد عالم اہل ہمت کے نہ ہونے سے\r\nبھرے ہیں جس قدر جام و سبو مے خانہ خالی ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 2
    }
