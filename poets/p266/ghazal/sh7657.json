      "RhymeLetters": null,
      "PlainText": "دھمکی میں مر گیا، جو نہ بابِ نبرد تھا\r\n“عشقِ نبرد پیشہ” طلبگارِ مرد تھا\r\nتھا زندگی میں مرگ کا کھٹکا لگا ہوا\r\nاڑنے سے پیشتر بھی، مرا رنگ زرد تھا\r\nتالیفِ نسخہ ہائے وفا کر رہا تھا میں\r\nمجموعۂ خیال ابھی فرد فرد تھا\r\nدل تا جگر، کہ ساحلِ دریائے خوں ہے اب\r\nاس رہ گزر میں جلوۂ گل، آگے گرد تھا\r\nجاتی ہے کوئی کشمکش اندوہِ عشق کی!\r\nدل بھی اگر گیا، تو وُہی دل کا درد تھا\r\nاحباب چارہ سازیِ وحشت نہ کر سکے\r\nزنداں میں بھی خیال، بیاباں نورد تھا\r\nیہ لاشِ بے کفن اسدؔ خستہ جاں کی ہے\r\nحق مغفرت کرے عجب آزاد مرد تھا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 7
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "دھمکی میں مر گیا، جو نہ بابِ نبرد تھا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "“عشقِ نبرد پیشہ” طلبگارِ مرد تھا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "تھا زندگی میں مرگ کا کھٹکا لگا ہوا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "اڑنے سے پیشتر بھی، مرا رنگ زرد تھا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "تالیفِ نسخہ ہائے وفا کر رہا تھا میں",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "مجموعۂ خیال ابھی فرد فرد تھا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دل تا جگر، کہ ساحلِ دریائے خوں ہے اب",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "اس رہ گزر میں جلوۂ گل، آگے گرد تھا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "جاتی ہے کوئی کشمکش اندوہِ عشق کی!",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "دل بھی اگر گیا، تو وُہی دل کا درد تھا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "احباب چارہ سازیِ وحشت نہ کر سکے",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "زنداں میں بھی خیال، بیاباں نورد تھا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "یہ لاشِ بے کفن اسدؔ خستہ جاں کی ہے",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "حق مغفرت کرے عجب آزاد مرد تھا",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    }
  ]
}
