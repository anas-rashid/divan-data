      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "رہا گر کوئی تا قیامت سلامت\r\nپھر اک روز مرنا ہے حضرت سلامت\r\nجگر کو مرے عشقِ خوں نابہ مشرب\r\nلکھے ہے “خداوندِ نعمت سلامت”\r\nعلی اللّرغمِ دشمن، شہیدِ وفا ہوں\r\nمبارک مبارک سلامت سلامت\r\nنہیں گر سر و برگِ ادراک معنی\r\nتماشائے نیرنگ صورت سلامت",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
