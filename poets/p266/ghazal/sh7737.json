    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "آئینے کے پایاب سے اتری ہیں سپاہیں",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "دیر و حرم آئینۂ تکرار تمنا",
