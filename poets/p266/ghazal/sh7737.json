      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "جوں مردمک چشم سے ہوں جمع نگاہیں",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "خوابیدہ بہ حیرت کدۂ داغ ہیں آہیں",
