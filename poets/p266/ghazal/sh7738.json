      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مجھ کو دیار غیر میں مارا وطن سے دور\r\nرکھ لی مرے خدا نے مری بیکسی کی شرم\r\nوہ حلقہ ‌ہاۓ زلف کمیں میں ہیں یا خدا\r\nرکھ لیجو میرے دعوی وارستگی کی شرم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 2
    }
