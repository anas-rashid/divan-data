      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مستی بہ ذوق غفلت ساقی ہلاک ہے\r\nموج شراب یک مژۂ خواب ناک ہے\r\nجز زخم تیغ ناز نہیں دل میں آرزو\r\nجیب خیال بھی ترے ہاتھوں سے چاک ہے\r\nجوش جنوں سے کچھ نظر آتا نہیں اسدؔ\r\nصحرا ہماری آنکھ میں یک مشت خاک ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
