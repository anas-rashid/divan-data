      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نقشِ نازِ بتِ طنّاز بہ آغوشِ رقیب\r\nپائے طاؤس پئے خامۂ مانی مانگے\r\nتو وہ بد خو کہ تحیّر کو تماشا جانے\r\nغم وہ افسانہ کہ آشفتہ بیانی مانگے\r\nوہ تبِ عشق تمنّا ہے کہ پھر صورتِ شمع\r\nشعلہ تا نبضِ جگر ریشہ دوانی مانگے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 3
    }
  ],
