      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "چشمِ خوباں خامشی میں بھی نوا پرداز ہے\r\nسرمہ تو کہوے کہ دودِ شعلہ آواز ہے\r\nپیکرِ عشّاق سازِ طالعِ نا ساز ہے\r\nنالہ گویا گردشِ سیّارہ کی آواز ہے\r\nدست گاہِ دیدۂ خوں بارِ مجنوں دیکھنا\r\nیک بیاباں جلوۂ گل فرشِ پا انداز ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
