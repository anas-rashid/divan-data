      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کہتے ہو نہ دیں گے ہم دل اگر پڑا پایا\r\nدل کہاں کہ گم کیجے؟ ہم نے مدعا پایا\r\nہے کہاں تمنّا کا دوسرا قدم یا رب\r\nہم نے دشتِ امکاں کو ایک نقشِ پا پایا\r\nبے دماغِ خجلت ہوں رشکِ امتحاں تا کے\r\nایک بے کسی تجھ کو عالم آشنا پایا\r\nسادگی و پرکاری، بے خودی و ہشیاری\r\nحسن کو تغافل میں جرأت آزما پایا\r\nخاکبازیِ امید، کارخانۂ طفلی\r\nیاس کو دو عالم سے لب بخندہ وا پایا\r\nکیوں نہ وحشتِ غالبؔ باج خواہِ تسکیں ہو\r\nکشتۂ تغافل کو خصمِ خوں بہا پایا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 6
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "کہتے ہو نہ دیں گے ہم دل اگر پڑا پایا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "دل کہاں کہ گم کیجے؟ ہم نے مدعا پایا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "ہے کہاں تمنّا کا دوسرا قدم یا رب",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "ہم نے دشتِ امکاں کو ایک نقشِ پا پایا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "بے دماغِ خجلت ہوں رشکِ امتحاں تا کے",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ایک بے کسی تجھ کو عالم آشنا پایا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "سادگی و پرکاری، بے خودی و ہشیاری",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "حسن کو تغافل میں جرأت آزما پایا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "خاکبازیِ امید، کارخانۂ طفلی",
