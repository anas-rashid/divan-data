      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "گلشن کو تری صحبت از بس کہ خوش آئی ہے\r\nہر غنچے کا گل ہونا آغوش کشائی ہے\r\nواں کنگر استغنا ہر دم ہے بلندی پر\r\nیاں نالے کو اور الٹا دعواۓ رسائی ہے\r\nاز بس کہ سکھاتا ہے غم ضبط کے اندازے\r\nجو داغ نظر آیا اک چشم نمائی ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
