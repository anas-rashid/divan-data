  "Poems": [
    {
      "Id": 7868,
      "Title": "یاران نبی میں تھی لڑائی کس میں",
      "FullUrl": "/p266/rubai/sh7868"
    },
    {
      "Id": 7867,
      "Title": "یاران نبی سے رکھ تولّا باللہ",
      "FullUrl": "/p266/rubai/sh7867"
    },
    {
      "Id": 7866,
      "Title": "یاران رسول یعنی اصحاب کبار",
      "FullUrl": "/p266/rubai/sh7866"
    },
    {
      "Id": 7860,
      "Title": "ہے خلق حسد قماش لڑنے کے لیے",
      "FullUrl": "/p266/rubai/sh7860"
    },
    {
      "Id": 7855,
      "Title": "ہیں شہ میں صفات ذوالجلالی باہم",
      "FullUrl": "/p266/rubai/sh7855"
    },
    {
      "Id": 7847,
      "Title": "ہم گرچہ بنے سلام کرنے والے",
      "FullUrl": "/p266/rubai/sh7847"
    },
    {
      "Id": 7840,
      "Title": "ہر چند کہ دوستی میں کامل ہونا",
      "FullUrl": "/p266/rubai/sh7840"
    },
    {
      "Id": 7809,
      "Title": "کہتے ہیں کہ اب وہ مردم آزار نہیں",
      "FullUrl": "/p266/rubai/sh7809"
    },
    {
      "Id": 7747,
      "Title": "مشکل ہے زبس کلام میرا اے دل",
      "FullUrl": "/p266/rubai/sh7747"
    },
    {
      "Id": 7823,
      "Title": "گلخن شرر اہتمام بستر ہے آج",
      "FullUrl": "/p266/rubai/sh7823"
    },
    {
      "Id": 7819,
      "Title": "گر جوہر امتیاز ہوتا ہم میں",
      "FullUrl": "/p266/rubai/sh7819"
    },
    {
      "Id": 7699,
      "Title": "شب زلف و رخ عرق فشاں کا غم تھا",
      "FullUrl": "/p266/rubai/sh7699"
    },
    {
      "Id": 7685,
      "Title": "سامان ہزار جستجو یعنی دل",
      "FullUrl": "/p266/rubai/sh7685"
    },
    {
      "Id": 7684,
      "Title": "سامان خور و خواب کہاں سے لاؤں",
      "FullUrl": "/p266/rubai/sh7684"
    },
    {
      "Id": 7673,
      "Title": "رقعے کا جواب کیوں نہ بھیجا تم نے",
      "FullUrl": "/p266/rubai/sh7673"
    },
    {
      "Id": 7663,
      "Title": "دیکھ وہ برق تبسم بس کہ دل بیتاب ہے",
      "FullUrl": "/p266/rubai/sh7663"
    },
    {
      "Id": 7656,
      "Title": "دکھ جی کے پسند ہو گیا ہے غالبؔ",
      "FullUrl": "/p266/rubai/sh7656"
    },
    {
      "Id": 7648,
      "Title": "دل سوز جنوں سے جلوہ منظر ہے آج",
      "FullUrl": "/p266/rubai/sh7648"
    },
    {
      "Id": 7647,
      "Title": "دل سخت نژند ہوگیا ہے گویا",
      "FullUrl": "/p266/rubai/sh7647"
    },
    {
      "Id": 7646,
      "Title": "دل تھا کہ جو جان درد تمہید سہی",
      "FullUrl": "/p266/rubai/sh7646"
    },
    {
      "Id": 7633,
      "Title": "حق شہ کی بقا سے خلق کو شاد کرے",
      "FullUrl": "/p266/rubai/sh7633"
    },
    {
      "Id": 7620,
      "Title": "جن لوگوں کو ہے مجھ سے عداوت گہری",
      "FullUrl": "/p266/rubai/sh7620"
    },
    {
      "Id": 7602,
      "Title": "بے گریہ کمال ترجبینی ہے مجھے",
      "FullUrl": "/p266/rubai/sh7602"
    },
    {
      "Id": 7596,
      "Title": "بھیجی ہے جو مجھ کو شاہ جمجاہ نے دال",
      "FullUrl": "/p266/rubai/sh7596"
    },
    {
      "Id": 7594,
      "Title": "بعد از اتمام بزم عید اطفال",
      "FullUrl": "/p266/rubai/sh7594"
    },
    {
      "Id": 7586,
      "Title": "اے کثرت فہم بے شمار اندیشہ",
      "FullUrl": "/p266/rubai/sh7586"
    },
    {
      "Id": 7585,
      "Title": "اے کاش بتاں کا خنجر سینہ شگاف",
      "FullUrl": "/p266/rubai/sh7585"
    },
    {
      "Id": 7584,
      "Title": "اے منشی خیرہ سر سخن ساز نہ ہو",
      "FullUrl": "/p266/rubai/sh7584"
    },
    {
      "Id": 7581,
      "Title": "اے روشنی دیدہ شہاب الدین خاں",
      "FullUrl": "/p266/rubai/sh7581"
    },
    {
      "Id": 7575,
      "Title": "اک گرم آہ کی تو ہزاروں کے گھر جلے",
      "FullUrl": "/p266/rubai/sh7575"
    },
    {
      "Id": 7574,
      "Title": "ان سیم کے بیجوں کو کوئی کیا جانے",
      "FullUrl": "/p266/rubai/sh7574"
    },
    {
      "Id": 7571,
      "Title": "اصحاب کو جو کہ ناسزا کہتے ہیں",
      "FullUrl": "/p266/rubai/sh7571"
    },
    {
      "Id": 7568,
      "Title": "اس رشتے میں لاکھ تار ہوں بلکہ سوا",
      "FullUrl": "/p266/rubai/sh7568"
    },
    {
      "Id": 7561,
      "Title": "آتش بازی ہے جیسے شغل اطفال",
      "FullUrl": "/p266/rubai/sh7561"
    }
  ]
