  "Poems": [
    {
      "Id": 7904,
      "Title": "واعظ پئے ہوئے ہوں خدا کے لئے نہ چھیڑ",
      "FullUrl": "/p268/ghazal/sh7904",
      "RadifLetter": "ا"
    },
    {
      "Id": 7901,
      "Title": "تم لے کے اپنے ہاتھ میں خنجر نہ دیکھنا",
      "FullUrl": "/p268/ghazal/sh7901",
      "RadifLetter": "ا"
    },
    {
      "Id": 7900,
      "Title": "تم خوب اڑاتے رہو خاکہ مرے دل کا",
      "FullUrl": "/p268/ghazal/sh7900",
      "RadifLetter": "ا"
    },
    {
      "Id": 7902,
      "Title": "شکر اس نے کیا لب پہ مگر نام نہ آیا",
      "FullUrl": "/p268/ghazal/sh7902",
      "RadifLetter": "ا"
    },
    {
      "Id": 7905,
      "Title": "پھر آ گئی اک بت پہ طبیعت کو ہوا کیا",
      "FullUrl": "/p268/ghazal/sh7905",
      "RadifLetter": "ا"
    },
    {
      "Id": 7898,
      "Title": "باتیں ہیں واعظوں کی عذاب و ثواب کیا",
      "FullUrl": "/p268/ghazal/sh7898",
      "RadifLetter": "ا"
    },
    {
      "Id": 7895,
      "Title": "اشک گلگوں کو نہ خون شہدا کو دیکھا",
      "FullUrl": "/p268/ghazal/sh7895",
      "RadifLetter": "ا"
    },
    {
      "Id": 7897,
      "Title": "اے ستم گر نہیں دیکھا جاتا",
      "FullUrl": "/p268/ghazal/sh7897",
      "RadifLetter": "ا"
    },
    {
      "Id": 7907,
      "Title": "کس منہ سے کروں میں تن عریاں کی شکایت",
      "FullUrl": "/p268/ghazal/sh7907",
      "RadifLetter": "ت"
    },
    {
      "Id": 7899,
      "Title": "بن بن کے بگڑ جائے گی تدبیر کہاں تک",
      "FullUrl": "/p268/ghazal/sh7899",
      "RadifLetter": "ک"
    },
    {
      "Id": 7903,
      "Title": "نہ ہو شباب تو کیفیت شراب کہاں",
      "FullUrl": "/p268/ghazal/sh7903",
      "RadifLetter": "ن"
    },
    {
      "Id": 7906,
      "Title": "ڈوبا ہوا اٹھوں دم محشر شراب میں",
      "FullUrl": "/p268/ghazal/sh7906",
      "RadifLetter": "ن"
    },
    {
      "Id": 7896,
      "Title": "ایسی کیا تھیں عتاب کی باتیں",
      "FullUrl": "/p268/ghazal/sh7896",
      "RadifLetter": "ن"
    },
    {
      "Id": 7894,
      "Title": "آپ کیا ایک ستم گار بنے بیٹھے ہیں",
      "FullUrl": "/p268/ghazal/sh7894",
      "RadifLetter": "ن"
    }
  ]
