  "Poems": [
    {
      "Id": 7908,
      "Title": "اس پری رو نے نہ مجھ سے ہے نباہی کیا کروں",
      "FullUrl": "/p269/ghazal/sh7908"
    },
    {
      "Id": 7909,
      "Title": "بے وجہ نہیں گرد پریشاں پس محفل",
      "FullUrl": "/p269/ghazal/sh7909"
    },
    {
      "Id": 7910,
      "Title": "تو جو پڑا پھرتا ہے آج کہیں کل کہیں",
      "FullUrl": "/p269/ghazal/sh7910"
    },
    {
      "Id": 7911,
      "Title": "جنگلوں میں جستجوئے قیس صحرائی کروں",
      "FullUrl": "/p269/ghazal/sh7911"
    },
    {
      "Id": 7912,
      "Title": "جوانی یاد ہم کو اپنی پھر بے اختیار آئی",
      "FullUrl": "/p269/ghazal/sh7912"
    },
    {
      "Id": 7913,
      "Title": "دیکھیں کیا اب کے اسیری ہمیں دکھلاتی ہے",
      "FullUrl": "/p269/ghazal/sh7913"
    },
    {
      "Id": 7914,
      "Title": "رنگ‌ گل شگفتہ ہوں آب رخ چمن ہوں میں",
      "FullUrl": "/p269/ghazal/sh7914"
    },
    {
      "Id": 7915,
      "Title": "شوق خراش خار مرے دل میں رہ گیا",
      "FullUrl": "/p269/ghazal/sh7915"
    },
    {
      "Id": 7916,
      "Title": "ماتھے پہ لگا صندل وہ ہار پہن نکلے",
      "FullUrl": "/p269/ghazal/sh7916"
    },
    {
      "Id": 7917,
      "Title": "مژدہ یہ صبا اس بت بے باک کو پہنچا",
      "FullUrl": "/p269/ghazal/sh7917"
    },
    {
      "Id": 7918,
      "Title": "میں نہ سمجھا بلبل بے بال و پر نے کیا کہا",
      "FullUrl": "/p269/ghazal/sh7918"
    },
    {
      "Id": 7919,
      "Title": "میں کہا بولنا شب غیر سے تھا تم کو کیا",
      "FullUrl": "/p269/ghazal/sh7919"
    },
    {
      "Id": 7920,
      "Title": "نت جی ہی جی میں عشق کے صدمے اٹھائیو",
      "FullUrl": "/p269/ghazal/sh7920"
    },
    {
      "Id": 7921,
      "Title": "نہ پایا کھوج برسوں نقش پائے رفتگاں ڈھونڈھے",
      "FullUrl": "/p269/ghazal/sh7921"
    },
    {
      "Id": 7922,
      "Title": "کیا دن تھے جب چھپ چھپ کر تم پاس ہمارے آتے تھے",
      "FullUrl": "/p269/ghazal/sh7922"
    },
    {
      "Id": 7923,
      "Title": "کیا مزا ہو جو کسی سے تجھے الفت ہو جائے",
      "FullUrl": "/p269/ghazal/sh7923"
    },
    {
      "Id": 7924,
      "Title": "ہرگز نہ مرے محرم ہمراز ہوئے تم",
      "FullUrl": "/p269/ghazal/sh7924"
    },
    {
      "Id": 7925,
      "Title": "ہم سے وارفتہ الفت ہیں بہت کم پیدا",
      "FullUrl": "/p269/ghazal/sh7925"
    },
    {
      "Id": 7926,
      "Title": "ہنستے تھے مرے حال کو جو یار دیکھ کر",
      "FullUrl": "/p269/ghazal/sh7926"
    },
    {
      "Id": 7927,
      "Title": "ہوئے آج بوڑھے جوانی میں کیا تھے",
      "FullUrl": "/p269/ghazal/sh7927"
    },
    {
      "Id": 7928,
      "Title": "ہوئے عازم ملک عدم جو ہوسؔ تو خوشی یہ ہوئی تھی کہ غم سے چھٹے",
      "FullUrl": "/p269/ghazal/sh7928"
    },
    {
      "Id": 7929,
      "Title": "یہی کہتی لیلیٔ سوختہ جاں نہیں کھاتی ادب سے خدا کی قسم",
      "FullUrl": "/p269/ghazal/sh7929"
    }
  ]
}
