  "Poems": [
    {
      "Id": 639,
      "Title": "ذوق سرمستی کو محو روئے جاناں کر دیا",
      "FullUrl": "/p27/ghazal/sh639",
      "RadifLetter": "ا"
    },
    {
      "Id": 665,
      "Title": "یہ کیا کہا کہ غم عشق ناگوار ہوا",
      "FullUrl": "/p27/ghazal/sh665",
      "RadifLetter": "ا"
    },
    {
      "Id": 649,
      "Title": "مستی میں فروغ رخ جاناں نہیں دیکھا",
      "FullUrl": "/p27/ghazal/sh649",
      "RadifLetter": "ا"
    },
    {
      "Id": 651,
      "Title": "مے بے رنگ کا سو رنگ سے رسوا ہونا",
      "FullUrl": "/p27/ghazal/sh651",
      "RadifLetter": "ا"
    },
    {
      "Id": 658,
      "Title": "کون تھا اس کے ہوا خواہوں میں جو شامل نہ تھا",
      "FullUrl": "/p27/ghazal/sh658",
      "RadifLetter": "ا"
    },
    {
      "Id": 637,
      "Title": "حسن کو وسعتیں جو دیں عشق کو حوصلہ دیا",
