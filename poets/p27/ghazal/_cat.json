  "ChildCats": [],
  "Poems": [
    {
      "Id": 627,
      "Title": "آشوب حسن کی بھی کوئی داستاں رہے",
      "FullUrl": "/p27/ghazal/sh627"
    },
    {
      "Id": 628,
      "Title": "آلام روزگار کو آساں بنا دیا",
      "FullUrl": "/p27/ghazal/sh628"
    },
    {
      "Id": 629,
      "Title": "اسرار عشق ہے دل مضطر لیے ہوئے",
      "FullUrl": "/p27/ghazal/sh629"
    },
    {
      "Id": 630,
      "Title": "اک عالم حیرت ہے فنا ہے نہ بقا ہے",
      "FullUrl": "/p27/ghazal/sh630"
    },
    {
      "Id": 631,
      "Title": "ایک ایسی بھی تجلی آج مے خانے میں ہے",
      "FullUrl": "/p27/ghazal/sh631"
    },
    {
      "Id": 632,
      "Title": "ترے جلووں کے آگے ہمت شرح و بیاں رکھ دی",
      "FullUrl": "/p27/ghazal/sh632"
    },
    {
      "Id": 633,
      "Title": "تو ایک نام ہے مگر صدائے خواب کی طرح",
      "FullUrl": "/p27/ghazal/sh633"
    },
    {
      "Id": 634,
      "Title": "جان نشاط حسن کی دنیا کہیں جسے",
      "FullUrl": "/p27/ghazal/sh634"
    },
    {
      "Id": 635,
      "Title": "جو نقش ہے ہستی کا دھوکا نظر آتا ہے",
      "FullUrl": "/p27/ghazal/sh635"
    },
    {
      "Id": 636,
      "Title": "جینے کا نہ کچھ ہوش نہ مرنے کی خبر ہے",
      "FullUrl": "/p27/ghazal/sh636"
    },
    {
      "Id": 637,
      "Title": "حسن کو وسعتیں جو دیں عشق کو حوصلہ دیا",
      "FullUrl": "/p27/ghazal/sh637"
    },
    {
      "Id": 638,
      "Title": "خدا جانے کہاں ہے اصغرؔ دیوانہ برسوں سے",
      "FullUrl": "/p27/ghazal/sh638"
    },
    {
      "Id": 639,
      "Title": "ذوق سرمستی کو محو روئے جاناں کر دیا",
      "FullUrl": "/p27/ghazal/sh639"
    },
    {
      "Id": 640,
      "Title": "رقص مستی دیکھتے جوش تمنا دیکھتے",
      "FullUrl": "/p27/ghazal/sh640"
    },
    {
      "Id": 641,
      "Title": "سامنے ان کے تڑپ کر اس طرح فریاد کی",
      "FullUrl": "/p27/ghazal/sh641"
    },
    {
      "Id": 642,
      "Title": "شکوہ نہ چاہیئے کہ تقاضا نہ چاہیئے",
      "FullUrl": "/p27/ghazal/sh642"
    },
    {
      "Id": 643,
      "Title": "صرف اک سوز تو مجھ میں ہے مگر ساز نہیں",
      "FullUrl": "/p27/ghazal/sh643"
    },
    {
      "Id": 644,
      "Title": "عشق ہے اک کیف پنہانی مگر رنجور ہے",
      "FullUrl": "/p27/ghazal/sh644"
    },
    {
      "Id": 645,
      "Title": "عشوؤں کی ہے نہ اس نگہ فتنہ زا کی ہے",
      "FullUrl": "/p27/ghazal/sh645"
    },
    {
      "Id": 646,
      "Title": "عکس کس چیز کا آئینۂ حیرت میں نہیں",
      "FullUrl": "/p27/ghazal/sh646"
    },
    {
      "Id": 647,
      "Title": "متاع زیست کیا ہم زیست کا حاصل سمجھتے ہیں",
      "FullUrl": "/p27/ghazal/sh647"
    },
    {
      "Id": 648,
      "Title": "مجاز کیسا کہاں حقیقت ابھی تجھے کچھ خبر نہیں ہے",
      "FullUrl": "/p27/ghazal/sh648"
    },
    {
      "Id": 649,
      "Title": "مستی میں فروغ رخ جاناں نہیں دیکھا",
      "FullUrl": "/p27/ghazal/sh649"
    },
    {
      "Id": 650,
      "Title": "موجوں کا عکس ہے خط جام شراب میں",
      "FullUrl": "/p27/ghazal/sh650"
    },
    {
      "Id": 651,
      "Title": "مے بے رنگ کا سو رنگ سے رسوا ہونا",
      "FullUrl": "/p27/ghazal/sh651"
    },
    {
      "Id": 652,
      "Title": "نہ کھلے عقد ہائے ناز و نیاز",
      "FullUrl": "/p27/ghazal/sh652"
    },
    {
      "Id": 653,
      "Title": "نہ یہ شیشہ نہ یہ ساغر نہ یہ پیمانہ بنے",
      "FullUrl": "/p27/ghazal/sh653"
    },
    {
      "Id": 654,
      "Title": "وہ نغمہ بلبل رنگیں نوا اک بار ہو جائے",
      "FullUrl": "/p27/ghazal/sh654"
    },
    {
      "Id": 655,
      "Title": "پاتا نہیں جو لذت آہ سحر کو میں",
      "FullUrl": "/p27/ghazal/sh655"
    },
    {
      "Id": 656,
      "Title": "پاس ادب میں جوش تمنا لئے ہوئے",
      "FullUrl": "/p27/ghazal/sh656"
    },
    {
      "Id": 657,
      "Title": "کوئی محمل نشیں کیوں شاد یا ناشاد ہوتا ہے",
      "FullUrl": "/p27/ghazal/sh657"
    },
    {
      "Id": 658,
      "Title": "کون تھا اس کے ہوا خواہوں میں جو شامل نہ تھا",
      "FullUrl": "/p27/ghazal/sh658"
    },
    {
      "Id": 659,
      "Title": "گرم تلاش و جستجو اب ہے تری نظر کہاں",
      "FullUrl": "/p27/ghazal/sh659"
    },
    {
      "Id": 660,
      "Title": "گم کر دیا ہے دید نے یوں سر بہ سر مجھے",
      "FullUrl": "/p27/ghazal/sh660"
    },
    {
      "Id": 661,
      "Title": "ہے دل ناکام عاشق میں تمہاری یاد بھی",
      "FullUrl": "/p27/ghazal/sh661"
    },
    {
      "Id": 662,
      "Title": "یوں نہ مایوس ہو اے شورش ناکام ابھی",
      "FullUrl": "/p27/ghazal/sh662"
    },
    {
      "Id": 663,
      "Title": "یہ عشق نے دیکھا ہے یہ عقل سے پنہاں ہے",
      "FullUrl": "/p27/ghazal/sh663"
    },
    {
      "Id": 664,
      "Title": "یہ ننگ عاشقی ہے سود و حاصل دیکھنے والے",
      "FullUrl": "/p27/ghazal/sh664"
    },
    {
      "Id": 665,
      "Title": "یہ کیا کہا کہ غم عشق ناگوار ہوا",
      "FullUrl": "/p27/ghazal/sh665"
    }
  ]
}
