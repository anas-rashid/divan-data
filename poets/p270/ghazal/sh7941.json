      "RhymeLetters": null,
      "PlainText": "بہار باغ ہو مینا ہو جام صہبا ہو\r\nہوا ہو ابر ہو ساقی ہو اور دریا ہو\r\nروا ہے کہہ تو بھلا اے سپہر نا انصاف\r\nریائے زہد چھپے راز عشق رسوا ہو\r\nبھرا ہے اس قدر اے ابر دل ہمارا بھی\r\nکہ ایک لہر میں روئے زمین دریا ہو\r\nجو مہرباں ہیں وہ سوداؔ کو مغتنم جانیں\r\nسپاہی زادوں سے ملتا ہے دیکھیے کیا ہو",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
