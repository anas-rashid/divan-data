  "Poems": [
    {
      "Id": 8025,
      "Title": "زیر زمیں ہوں تشنۂ دیدار یار کا",
      "FullUrl": "/p273/ghazal/sh8025"
    },
    {
      "Id": 8037,
      "Title": "پردہ الٹ کے اس نے جو چہرا دکھا دیا",
      "FullUrl": "/p273/ghazal/sh8037"
    },
    {
      "Id": 8034,
      "Title": "نہ کوئی ان کے سوا اور جان جاں دیکھا",
      "FullUrl": "/p273/ghazal/sh8034"
    },
    {
      "Id": 8030,
      "Title": "مثال تار نظر کیا نظر نہیں آتا",
      "FullUrl": "/p273/ghazal/sh8030"
    },
    {
      "Id": 8031,
      "Title": "مطلب نہ کعبہ سے نہ ارادہ کنشت کا",
      "FullUrl": "/p273/ghazal/sh8031"
    },
    {
      "Id": 8028,
      "Title": "لاکھ پردے سے رخ انور عیاں ہو جائے گا",
      "FullUrl": "/p273/ghazal/sh8028"
    },
    {
      "Id": 8029,
      "Title": "لب رنگیں سے اگر تو گہر افشاں ہوتا",
      "FullUrl": "/p273/ghazal/sh8029"
    },
    {
      "Id": 8039,
      "Title": "کس طرح ملیں کوئی بہانا نہیں ملتا",
      "FullUrl": "/p273/ghazal/sh8039"
    },
    {
      "Id": 8040,
      "Title": "گیا شباب نہ پیغام وصل یار آیا",
      "FullUrl": "/p273/ghazal/sh8040"
    },
    {
      "Id": 8038,
      "Title": "چاند سا چہرہ جو اس کا آشکارا ہو گیا",
      "FullUrl": "/p273/ghazal/sh8038"
    },
    {
      "Id": 8019,
      "Title": "اثر زلف کا برملا ہو گیا",
      "FullUrl": "/p273/ghazal/sh8019"
    },
    {
      "Id": 8036,
      "Title": "وہ شاہ حسن جو بے مثل ہے حسینوں میں",
      "FullUrl": "/p273/ghazal/sh8036"
    },
    {
      "Id": 8021,
      "Title": "بے بلائے ہوئے جانا مجھے منظور نہیں",
      "FullUrl": "/p273/ghazal/sh8021"
    },
    {
      "Id": 8023,
      "Title": "دیکھی جو زلف یار طبیعت سنبھل گئی",
      "FullUrl": "/p273/ghazal/sh8023"
    },
    {
      "Id": 8035,
      "Title": "وحشت میں بھی رخ جانب صحرا نہ کریں گے",
      "FullUrl": "/p273/ghazal/sh8035"
    },
    {
      "Id": 8026,
      "Title": "شمع بھی اس صفا سے جلتی ہے",
      "FullUrl": "/p273/ghazal/sh8026"
    },
    {
      "Id": 8024,
      "Title": "رنگ سے پیرہن سادہ حنائی ہو جائے",
      "FullUrl": "/p273/ghazal/sh8024"
    },
    {
      "Id": 8027,
      "Title": "قمر کی وہ خورشید تصویر ہے",
      "FullUrl": "/p273/ghazal/sh8027"
    },
    {
      "Id": 8033,
      "Title": "نہ رہے نامہ و پیغام کے لانے والے",
      "FullUrl": "/p273/ghazal/sh8033"
    },
    {
      "Id": 8032,
      "Title": "میں اگر رونے لگوں رتبۂ والا بڑھ جائے",
      "FullUrl": "/p273/ghazal/sh8032"
    },
    {
      "Id": 8022,
      "Title": "جب عیاں صبح کو وہ نور مجسم ہو جائے",
      "FullUrl": "/p273/ghazal/sh8022"
    },
    {
      "Id": 8020,
      "Title": "اے صنم وصل کی تدبیروں سے کیا ہوتا ہے",
      "FullUrl": "/p273/ghazal/sh8020"
    }
  ]
}
