      "RhymeLetters": null,
      "PlainText": "مطلب نہ کعبہ سے نہ ارادہ کنشت کا\r\nپابند یہ فقیر نہیں سنگ و خشت کا\r\nسر سبز ہوں جو آپ دکھا دیجے خط سبز\r\nکشتوں کو کھیت میں ابھی عالم ہو کشت کا\r\nاس حور کی جو گلشن عارض کی یاد تھی\r\nدیکھا کیا فراق میں عالم بہشت کا\r\nکیا منشی ازل کی یہ صنعت ہے دیکھنا\r\nماہر نہیں کسی کی کوئی سر نوشت کا\r\nنادان اعتراض ہے صانع پہ غور کر\r\nبے جا ہے امتیاز یہاں خوب و زشت کا\r\nاے برقؔ سیر کرتے ہیں ہم تو جہان کی\r\nہر کوچۂ صنم ہے نمونہ بہشت کا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 6
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "مطلب نہ کعبہ سے نہ ارادہ کنشت کا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "پابند یہ فقیر نہیں سنگ و خشت کا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "سر سبز ہوں جو آپ دکھا دیجے خط سبز",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "کشتوں کو کھیت میں ابھی عالم ہو کشت کا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اس حور کی جو گلشن عارض کی یاد تھی",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "دیکھا کیا فراق میں عالم بہشت کا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کیا منشی ازل کی یہ صنعت ہے دیکھنا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "ماہر نہیں کسی کی کوئی سر نوشت کا",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "نادان اعتراض ہے صانع پہ غور کر",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "بے جا ہے امتیاز یہاں خوب و زشت کا",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
