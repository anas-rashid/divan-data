  "Poems": [
    {
      "Id": 8148,
      "Title": "آندھی چلی تو نقش کف پا نہیں ملا",
      "FullUrl": "/p276/ghazal/sh8148"
    },
    {
      "Id": 8150,
      "Title": "اب جی حدود سود و زیاں سے گزر گیا",
      "FullUrl": "/p276/ghazal/sh8150"
    },
    {
      "Id": 8152,
      "Title": "اس قدر اب غم دوراں کی فراوانی ہے",
      "FullUrl": "/p276/ghazal/sh8152"
    },
    {
      "Id": 8159,
      "Title": "بجھ گئی شمع حرم باب کلیسا نہ کھلا",
      "FullUrl": "/p276/ghazal/sh8159"
    },
    {
      "Id": 8161,
      "Title": "بزرگو، ناصحو، فرماں رواؤ",
      "FullUrl": "/p276/ghazal/sh8161"
    },
    {
      "Id": 8162,
      "Title": "بیٹھا ہوں سیہ بخت و مکدر اسی گھر میں",
      "FullUrl": "/p276/ghazal/sh8162"
    },
    {
      "Id": 8164,
      "Title": "تری تلاش میں ہر رہنما سے باتیں کیں",
      "FullUrl": "/p276/ghazal/sh8164"
    },
    {
      "Id": 8168,
      "Title": "تیرے چہرے کی طرح اور مرے سینے کی طرح",
      "FullUrl": "/p276/ghazal/sh8168"
    },
    {
      "Id": 8169,
      "Title": "جب ہوا شب کو بدلتی ہوئی پہلو آئی",
      "FullUrl": "/p276/ghazal/sh8169"
    },
    {
      "Id": 8171,
      "Title": "جس دن سے اپنا طرز فقیرانہ چھٹ گیا",
      "FullUrl": "/p276/ghazal/sh8171"
    },
    {
      "Id": 8172,
      "Title": "درد دل بھی غم دوراں کے برابر سے اٹھا",
      "FullUrl": "/p276/ghazal/sh8172"
    },
    {
      "Id": 8178,
      "Title": "روکتا ہے غم اظہار سے پندار مجھے",
      "FullUrl": "/p276/ghazal/sh8178"
    },
    {
      "Id": 8181,
      "Title": "زبان غیر سے کیا شرح آرزو کرتے",
      "FullUrl": "/p276/ghazal/sh8181"
    },
    {
      "Id": 8182,
      "Title": "سحر جیتے گی یا شام غریباں دیکھتے رہنا",
      "FullUrl": "/p276/ghazal/sh8182"
    },
    {
      "Id": 8186,
      "Title": "سینے میں خزاں آنکھوں میں برسات رہی ہے",
      "FullUrl": "/p276/ghazal/sh8186"
    },
    {
      "Id": 8188,
      "Title": "غم دوراں نے بھی سیکھے غم جاناں کے چلن",
      "FullUrl": "/p276/ghazal/sh8188"
    },
    {
      "Id": 8191,
      "Title": "فن کار خود نہ تھی مرے فن کی شریک تھی",
      "FullUrl": "/p276/ghazal/sh8191"
    },
    {
      "Id": 8192,
      "Title": "قدم قدم پہ تمنائے التفات تو دیکھ",
      "FullUrl": "/p276/ghazal/sh8192"
    },
    {
      "Id": 8193,
      "Title": "لوگوں کی ملامت بھی ہے خود درد سری بھی",
      "FullUrl": "/p276/ghazal/sh8193"
    },
    {
      "Id": 8201,
      "Title": "نگر نگر میلے کو گئے کون سنے گا تیری پکار",
      "FullUrl": "/p276/ghazal/sh8201"
    },
    {
      "Id": 8206,
      "Title": "وہ عہد عہد ہی کیا ہے جسے نبھاؤ بھی",
      "FullUrl": "/p276/ghazal/sh8206"
    },
    {
      "Id": 8209,
      "Title": "چلے تو کٹ ہی جائے گا سفر آہستہ آہستہ",
      "FullUrl": "/p276/ghazal/sh8209"
    },
    {
      "Id": 8211,
      "Title": "کبھی جھڑکی سے کبھی پیار سے سمجھاتے رہے",
      "FullUrl": "/p276/ghazal/sh8211"
    },
    {
      "Id": 8213,
      "Title": "کسی اور غم میں اتنی خلش نہاں نہیں ہے",
      "FullUrl": "/p276/ghazal/sh8213"
    },
    {
      "Id": 8214,
      "Title": "کسی تو کام زمانے کے سوگوار آئے",
      "FullUrl": "/p276/ghazal/sh8214"
    },
    {
      "Id": 8215,
      "Title": "کف مومن سے نہ دروازۂ دوراں سے ملا",
      "FullUrl": "/p276/ghazal/sh8215"
    },
    {
      "Id": 8216,
      "Title": "کوئی رفیق بہم ہی نہ ہو تو کیا کیجے",
      "FullUrl": "/p276/ghazal/sh8216"
    },
    {
      "Id": 8218,
      "Title": "کیا کیا نظر کو شوق ہوس دیکھنے میں تھا",
      "FullUrl": "/p276/ghazal/sh8218"
    },
    {
      "Id": 8219,
      "Title": "گریہ تو اکثر رہا پیہم رہا",
      "FullUrl": "/p276/ghazal/sh8219"
    },
    {
      "Id": 8222,
      "Title": "ہر اک نے کہا کیوں تجھے آرام نہ آیا",
      "FullUrl": "/p276/ghazal/sh8222"
    },
    {
      "Id": 8223,
      "Title": "ہر طرف انبساط ہے اے دل",
      "FullUrl": "/p276/ghazal/sh8223"
    },
    {
      "Id": 8225,
      "Title": "ہوئی ایجاد نئی طرز خوشامد کہ نہیں",
      "FullUrl": "/p276/ghazal/sh8225"
    },
    {
      "Id": 8228,
      "Title": "یوں تو وہ ہر کسی سے ملتی ہے",
      "FullUrl": "/p276/ghazal/sh8228"
    }
  ]
}
