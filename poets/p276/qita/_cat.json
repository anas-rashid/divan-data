    {
      "Id": 8196,
      "Title": "مدتوں کور نگاہی دل کی",
      "FullUrl": "/p276/qita/sh8196"
    },
    {
      "Id": 8210,
      "Title": "کاش ہم لوگ لڑ گئے ہوتے",
      "FullUrl": "/p276/qita/sh8210"
    },
    {
      "Id": 8154,
      "Title": "اس کے چہرے کا عکس پڑتا ہے",
      "FullUrl": "/p276/qita/sh8154"
    },
    {
      "Id": 8195,
      "Title": "مجھ کو چپ چاپ اس طرح مت دیکھ",
      "FullUrl": "/p276/qita/sh8195"
    },
    {
      "Id": 8184,
      "Title": "سن کے لوگوں کے زہر سے فقرے",
      "FullUrl": "/p276/qita/sh8184"
    },
    {
      "Id": 8205,
      "Title": "وقت کے ساتھ لوگ کہتے تھے",
      "FullUrl": "/p276/qita/sh8205"
    },
    {
      "Id": 8227,
      "Title": "یوں تو اکثر خیال آتا تھا",
      "FullUrl": "/p276/qita/sh8227"
    },
    {
      "Id": 8187,
      "Title": "صرف کہہ دوں کہ ناؤ ڈوب گئی",
      "FullUrl": "/p276/qita/sh8187"
    },
    {
      "Id": 8155,
      "Title": "اللہ اللہ یہ لرزش مژگاں",
      "FullUrl": "/p276/qita/sh8155"
    },
    {
      "Id": 8200,
      "Title": "میری آنکھوں میں نیند چبھتی ہے",
      "FullUrl": "/p276/qita/sh8200"
    },
    {
      "Id": 8153,
      "Title": "اس کو کرنوں نے دی ہے تابانی",
      "FullUrl": "/p276/qita/sh8153"
    }
  ]
