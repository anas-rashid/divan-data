  "Poems": [
    {
      "Id": 8229,
      "Title": "آتش حسن سے اک آب ہے رخساروں میں",
      "FullUrl": "/p277/ghazal/sh8229"
    },
    {
      "Id": 8230,
      "Title": "آرزو دل میں بنائے ہوئے گھر ہے بھی تو کیا",
      "FullUrl": "/p277/ghazal/sh8230"
    },
    {
      "Id": 8231,
      "Title": "آپ کیوں بیٹھے ہیں غصے میں مری جان بھرے",
      "FullUrl": "/p277/ghazal/sh8231"
    },
    {
      "Id": 8232,
      "Title": "اب اس سے بڑھ کے کیا ناکامیاں ہوں گی مقدر میں",
      "FullUrl": "/p277/ghazal/sh8232"
    },
    {
      "Id": 8233,
      "Title": "اتنے اچھے ہو کہ بس توبہ بھلی",
      "FullUrl": "/p277/ghazal/sh8233"
    },
    {
      "Id": 8234,
      "Title": "اس بات کا ملال نہیں ہے کہ دل گیا",
      "FullUrl": "/p277/ghazal/sh8234"
    },
    {
      "Id": 8235,
      "Title": "اس سے کہہ دو کہ وہ جفا نہ کرے",
      "FullUrl": "/p277/ghazal/sh8235"
    },
    {
      "Id": 8236,
      "Title": "اسیر پنجۂ عہد شباب کر کے مجھے",
      "FullUrl": "/p277/ghazal/sh8236"
    },
    {
      "Id": 8237,
      "Title": "انہوں نے کیا نہ کیا اور کیا نہیں کرتے",
      "FullUrl": "/p277/ghazal/sh8237"
    },
    {
      "Id": 8238,
      "Title": "انہیں لوگوں کی بدولت یہ حسیں اچھے ہیں",
      "FullUrl": "/p277/ghazal/sh8238"
    },
    {
      "Id": 8239,
      "Title": "اپنے عہد وفا کو بھول گئے",
      "FullUrl": "/p277/ghazal/sh8239"
    },
    {
      "Id": 8240,
      "Title": "اک نقش خیال رو بہ رو ہے",
      "FullUrl": "/p277/ghazal/sh8240"
    },
    {
      "Id": 8241,
      "Title": "اک پردہ نشیں کی آرزو ہے",
      "FullUrl": "/p277/ghazal/sh8241"
    },
    {
      "Id": 8242,
      "Title": "اگر تم دل ہمارا لے کے پچھتائے تو رہنے دو",
      "FullUrl": "/p277/ghazal/sh8242"
    },
    {
      "Id": 8243,
      "Title": "بیٹھے ہوئے ہیں ہم خود آنکھوں میں دھول ڈالے",
      "FullUrl": "/p277/ghazal/sh8243"
    },
    {
      "Id": 8244,
      "Title": "تو مجھے کس کے بنانے کو مٹا بیٹھا ہے",
      "FullUrl": "/p277/ghazal/sh8244"
    },
    {
      "Id": 8245,
      "Title": "تیری رنگت بہار سے نکلی",
      "FullUrl": "/p277/ghazal/sh8245"
    },
    {
      "Id": 8246,
      "Title": "جان یہ کہہ کے بت ہوش ربا نے لے لی",
      "FullUrl": "/p277/ghazal/sh8246"
    },
    {
      "Id": 8247,
      "Title": "جب کہا تیر تری آنکھ نے اکثر مارا",
      "FullUrl": "/p277/ghazal/sh8247"
    },
    {
      "Id": 8248,
      "Title": "جب کہا میں نے کہ مر مر کے بچے ہجر میں ہم",
      "FullUrl": "/p277/ghazal/sh8248"
    },
    {
      "Id": 8249,
      "Title": "جب کہا میں ہوں ترے عشق میں بدنام کہ تو",
      "FullUrl": "/p277/ghazal/sh8249"
    },
    {
      "Id": 8250,
      "Title": "جدائی مجھ کو مارے ڈالتی ہے",
      "FullUrl": "/p277/ghazal/sh8250"
    },
    {
      "Id": 8251,
      "Title": "جفا سے وفا مسترد ہو گئی",
      "FullUrl": "/p277/ghazal/sh8251"
    },
    {
      "Id": 8252,
      "Title": "جنوں کے جوش میں انسان رسوا ہو ہی جاتا ہے",
      "FullUrl": "/p277/ghazal/sh8252"
    },
    {
      "Id": 8253,
      "Title": "جو مے دل سے پئے کوئی تو پھر رخنے نہیں رہتے",
      "FullUrl": "/p277/ghazal/sh8253"
    },
    {
      "Id": 8254,
      "Title": "جو پوچھا منہ دکھانے آپ کب چلمن سے نکلیں گے",
      "FullUrl": "/p277/ghazal/sh8254"
    },
    {
      "Id": 8255,
      "Title": "حوصلہ امتحان سے نکلا",
      "FullUrl": "/p277/ghazal/sh8255"
    },
    {
      "Id": 8256,
      "Title": "دعا سے کچھ نہ ہوا التجا سے کچھ نہ ہوا",
      "FullUrl": "/p277/ghazal/sh8256"
    },
    {
      "Id": 8257,
      "Title": "دل دادگان حسن سے پردا نہ چاہئے",
      "FullUrl": "/p277/ghazal/sh8257"
    },
    {
      "Id": 8258,
      "Title": "دل لے کے حسینوں نے یہ دستور نکالا",
      "FullUrl": "/p277/ghazal/sh8258"
    },
    {
      "Id": 8259,
      "Title": "دل کا معاملہ جو سپرد نظر ہوا",
      "FullUrl": "/p277/ghazal/sh8259"
    },
    {
      "Id": 8260,
      "Title": "دم آخر مصیبت کاٹ دو بہر خدا میری",
      "FullUrl": "/p277/ghazal/sh8260"
    },
    {
      "Id": 8261,
      "Title": "دور کیوں جاؤں یہیں جلوہ نما بیٹھا ہے",
      "FullUrl": "/p277/ghazal/sh8261"
    },
    {
      "Id": 8262,
      "Title": "رخ کسی کا نظر نہیں آتا",
      "FullUrl": "/p277/ghazal/sh8262"
    },
    {
      "Id": 8263,
      "Title": "رواں رہتا ہے کس کی موج میں دن رات تو پانی",
      "FullUrl": "/p277/ghazal/sh8263"
    },
    {
      "Id": 8264,
      "Title": "رہ کے پردے میں رخ پر نور کی باتیں نہ کر",
      "FullUrl": "/p277/ghazal/sh8264"
    },
    {
      "Id": 8265,
      "Title": "زیر زمیں رہوں کہ تہہ آسماں رہوں",
      "FullUrl": "/p277/ghazal/sh8265"
    },
    {
      "Id": 8266,
      "Title": "سب شریک صدمہ و آزار کچھ یوں ہی سے ہیں",
      "FullUrl": "/p277/ghazal/sh8266"
    },
    {
      "Id": 8267,
      "Title": "سہیں کب تک جفائیں بے وفائی دیکھنے والے",
      "FullUrl": "/p277/ghazal/sh8267"
    },
    {
      "Id": 8268,
      "Title": "علاج درد دل تم سے مسیحا ہو نہیں سکتا",
      "FullUrl": "/p277/ghazal/sh8268"
    },
    {
      "Id": 8269,
      "Title": "عمر کاٹی بتوں کی آڑوں میں",
      "FullUrl": "/p277/ghazal/sh8269"
    },
    {
      "Id": 8270,
      "Title": "عیش کے رنگ ملالوں سے دبے جاتے ہیں",
      "FullUrl": "/p277/ghazal/sh8270"
    },
    {
      "Id": 8271,
      "Title": "غرور الفت کی طرز نازش عجب کرشمے دکھا رہی ہے",
      "FullUrl": "/p277/ghazal/sh8271"
    },
    {
      "Id": 8272,
      "Title": "فصل گل بھی ترس کے کاٹی ہے",
      "FullUrl": "/p277/ghazal/sh8272"
    },
    {
      "Id": 8273,
      "Title": "مائل صحبت اغیار تو ہم ہیں تم کون",
      "FullUrl": "/p277/ghazal/sh8273"
    },
    {
      "Id": 8274,
      "Title": "محبت ابتدا میں کچھ نہیں معلوم ہوتی ہے",
      "FullUrl": "/p277/ghazal/sh8274"
    },
    {
      "Id": 8275,
      "Title": "محبت باعث نا مہربانی ہوتی جاتی ہے",
      "FullUrl": "/p277/ghazal/sh8275"
    },
    {
      "Id": 8276,
      "Title": "محبت غیر سے کی ہے تو میرا مدعا لے لو",
      "FullUrl": "/p277/ghazal/sh8276"
    },
    {
      "Id": 8277,
      "Title": "محبت کر کے لاکھوں رنج جھیلے بیکلی پائی",
      "FullUrl": "/p277/ghazal/sh8277"
    },
    {
      "Id": 8278,
      "Title": "محبت کو کہتے ہو برتی بھی تھی",
      "FullUrl": "/p277/ghazal/sh8278"
    },
    {
      "Id": 8279,
      "Title": "مخالف ہے صبائے نامہ بر کچھ اور کہتی ہے",
      "FullUrl": "/p277/ghazal/sh8279"
    },
    {
      "Id": 8280,
      "Title": "مرے ارمان مایوسی کے پالے پڑتے جاتے ہیں",
      "FullUrl": "/p277/ghazal/sh8280"
    },
    {
      "Id": 8281,
      "Title": "مکتب کی عاشقی بھی تاریخ زندگی تھی",
      "FullUrl": "/p277/ghazal/sh8281"
    },
    {
      "Id": 8282,
      "Title": "میرے ارماں وہ سدھارے یوں کے یونہیں رہ گئے",
      "FullUrl": "/p277/ghazal/sh8282"
    },
    {
      "Id": 8283,
      "Title": "میرے محبوب تم ہو یار تم ہو دل ربا تم ہو",
      "FullUrl": "/p277/ghazal/sh8283"
    },
    {
      "Id": 8284,
      "Title": "نہ بلوایا نہ آئے روز وعدہ کر کے دن کاٹے",
      "FullUrl": "/p277/ghazal/sh8284"
    },
    {
      "Id": 8285,
      "Title": "نہ کسی کی آنکھ کا نور ہوں نہ کسی کے دل کا قرار ہوں",
      "FullUrl": "/p277/ghazal/sh8285"
    },
    {
      "Id": 8286,
      "Title": "وفا کیا کر نہیں سکتے ہیں وہ لیکن نہیں کرتے",
      "FullUrl": "/p277/ghazal/sh8286"
    },
    {
      "Id": 8287,
      "Title": "وقت آخر یاد ہے ساقی کی مہمانی مجھے",
      "FullUrl": "/p277/ghazal/sh8287"
    },
    {
      "Id": 8288,
      "Title": "وہ قضا کے رنج میں جان دیں کہ نماز جن کی قضا ہوئی",
      "FullUrl": "/p277/ghazal/sh8288"
    },
    {
      "Id": 8289,
      "Title": "پردۂ درد میں آرام بٹا کرتے ہیں",
      "FullUrl": "/p277/ghazal/sh8289"
    },
    {
      "Id": 8290,
      "Title": "پوچھا کہ وجہ زندگی بولے کہ دل داری مری",
      "FullUrl": "/p277/ghazal/sh8290"
    },
    {
      "Id": 8291,
      "Title": "چاہت کی نظر آپ سے ڈالی بھی گئی ہے",
      "FullUrl": "/p277/ghazal/sh8291"
    },
    {
      "Id": 8292,
      "Title": "کسی بت کی ادا نے مار ڈالا",
      "FullUrl": "/p277/ghazal/sh8292"
    },
    {
      "Id": 8293,
      "Title": "کسی کے سنگ در سے اپنی میت لے کے اٹھیں گے",
      "FullUrl": "/p277/ghazal/sh8293"
    },
    {
      "Id": 8294,
      "Title": "کیا کہوں حسرت دیدار نے کیا کیا کھینچا",
      "FullUrl": "/p277/ghazal/sh8294"
    },
    {
      "Id": 8295,
      "Title": "کیسے دل لگتا حرم میں دور پیمانہ نہ تھا",
      "FullUrl": "/p277/ghazal/sh8295"
    },
    {
      "Id": 8296,
      "Title": "گواہ وصل عدو سر جھکا کے دیکھ نہ لو",
      "FullUrl": "/p277/ghazal/sh8296"
    },
    {
      "Id": 8297,
      "Title": "ہجر میں ہو گیا وصال کا کیا",
      "FullUrl": "/p277/ghazal/sh8297"
    },
    {
      "Id": 8298,
      "Title": "ہم عمر کے ساتھ ہیں سفر میں",
      "FullUrl": "/p277/ghazal/sh8298"
    },
    {
      "Id": 8299,
      "Title": "ہم نے پائی لذت دیدار لیکن دور سے",
      "FullUrl": "/p277/ghazal/sh8299"
    },
    {
      "Id": 8300,
      "Title": "ہم وفا کرتے ہیں ہم پر جور کوئی کیوں کرے",
      "FullUrl": "/p277/ghazal/sh8300"
    },
    {
      "Id": 8301,
      "Title": "یہ تم بے وقت کیسے آج آ نکلے سبب کیا ہے",
      "FullUrl": "/p277/ghazal/sh8301"
    }
  ]
