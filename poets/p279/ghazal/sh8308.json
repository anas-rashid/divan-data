      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نہ تو ملنے کے اب قابل رہا ہے\r\nنہ مج کو وہ دماغ و دل رہا ہے\r\nیہ دل کب عشق کے قابل رہا ہے\r\nکہاں اس کو دماغ و دل رہا ہے\r\nخدا کے واسطے اس کو نہ ٹوکو\r\nیہی اک شہر میں قاتل رہا ہے\r\nنہیں آتا اسے تکیہ پہ آرام\r\nیہ سر پاؤں سے تیرے ہل رہا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
