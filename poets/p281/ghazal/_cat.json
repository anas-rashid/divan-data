  "Poems": [
    {
      "Id": 8324,
      "Title": "تجھے نقش ہستی مٹایا تو دیکھا",
      "FullUrl": "/p281/ghazal/sh8324"
    },
    {
      "Id": 8325,
      "Title": "تجھے کچھ یاد ہے پہلا وہ عالم عشق پنہاں کا",
      "FullUrl": "/p281/ghazal/sh8325"
    },
    {
      "Id": 8326,
      "Title": "ترے بیمار کی شاید وداع جان ہے تن سے",
      "FullUrl": "/p281/ghazal/sh8326"
    },
    {
      "Id": 8327,
      "Title": "جو بعد مرگ بھی دل کو رہی کنار میں جا",
      "FullUrl": "/p281/ghazal/sh8327"
    },
    {
      "Id": 8328,
      "Title": "جھکی نگہ میں ہے ڈھب پرسش نہانی کا",
      "FullUrl": "/p281/ghazal/sh8328"
    },
    {
      "Id": 8329,
      "Title": "رکھے ہے رنگ کچھ ساقی شراب ناب آتش کا",
      "FullUrl": "/p281/ghazal/sh8329"
    },
    {
      "Id": 8330,
      "Title": "رہے ہے روکش نشتر ہر آبلہ دل کا",
      "FullUrl": "/p281/ghazal/sh8330"
    },
    {
      "Id": 8331,
      "Title": "نور مہ کو شب تہ ابر تنک کیا لاف تھا",
      "FullUrl": "/p281/ghazal/sh8331"
    },
    {
      "Id": 8332,
      "Title": "کب گل ہے ہوا خواہ صبا اپنے چمن کا",
      "FullUrl": "/p281/ghazal/sh8332"
    },
    {
      "Id": 8333,
      "Title": "کل وصل میں بھی نیند نہ آئی تمام شب",
      "FullUrl": "/p281/ghazal/sh8333"
    },
    {
      "Id": 8334,
      "Title": "کوئی ہمدرد نہ ہمدم نہ یگانہ اپنا",
      "FullUrl": "/p281/ghazal/sh8334"
    },
    {
      "Id": 8335,
      "Title": "کھا کے کل ہو پیچ و تاب اٹھا جو دل سے نالہ تھا",
      "FullUrl": "/p281/ghazal/sh8335"
    },
    {
      "Id": 8336,
      "Title": "گماں نہ کیونکہ کروں تجھ پہ دل چرانے کا",
      "FullUrl": "/p281/ghazal/sh8336"
    },
    {
      "Id": 8337,
      "Title": "ہر حرف آرزو پہ کرے تھا وہ یار بحث",
      "FullUrl": "/p281/ghazal/sh8337"
    }
  ]
}
