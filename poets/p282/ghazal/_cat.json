  "Poems": [
    {
      "Id": 8342,
      "Title": "دل کسو سے تو کیا لگانا تھا",
      "FullUrl": "/p282/ghazal/sh8342",
      "RadifLetter": "ا"
    },
    {
      "Id": 8350,
      "Title": "یار سے دست و گریباں نہ ہوا تھا سو ہوا",
      "FullUrl": "/p282/ghazal/sh8350",
      "RadifLetter": "ا"
    },
    {
      "Id": 8346,
      "Title": "عمر بھر اس پہ میں مرا ہی کیا",
      "FullUrl": "/p282/ghazal/sh8346",
      "RadifLetter": "ا"
    },
    {
      "Id": 8341,
      "Title": "خفا ہم سے وہ بے سبب ہو گیا",
      "FullUrl": "/p282/ghazal/sh8341",
      "RadifLetter": "ا"
    },
    {
      "Id": 8351,
      "Title": "یک بیک جاتا رہا دلبر جو گھر آیا ہوا",
      "FullUrl": "/p282/ghazal/sh8351",
      "RadifLetter": "ا"
    },
    {
      "Id": 8347,
      "Title": "وہ ان زلفوں کا عالم ابتری کا",
      "FullUrl": "/p282/ghazal/sh8347",
      "RadifLetter": "ا"
    },
    {
      "Id": 8343,
      "Title": "دیدہ ہے کہیں دل کہیں اور جان کہیں اور",
      "FullUrl": "/p282/ghazal/sh8343",
      "RadifLetter": "ر"
    },
    {
      "Id": 8349,
      "Title": "یادگار زمانہ ہیں ہم لوگ",
      "FullUrl": "/p282/ghazal/sh8349",
      "RadifLetter": "گ"
    },
    {
      "Id": 8344,
      "Title": "دیکھ کر یہ چلن تمہارے ہم",
      "FullUrl": "/p282/ghazal/sh8344",
      "RadifLetter": "م"
    },
    {
      "Id": 8345,
      "Title": "عاشق زار ہوں دیوانہ ہوں",
      "FullUrl": "/p282/ghazal/sh8345",
      "RadifLetter": "ن"
    },
    {
      "Id": 8348,
      "Title": "ہم نہ وحشت کے مارے مرتے ہیں",
      "FullUrl": "/p282/ghazal/sh8348",
      "RadifLetter": "ن"
    },
    {
      "Id": 8338,
      "Title": "اس شوخ کے انداز کو دیکھا تو غضب ہے",
      "FullUrl": "/p282/ghazal/sh8338",
      "RadifLetter": "ے"
    },
    {
      "Id": 8340,
      "Title": "جس کی بخدا اس بت کافر پہ نظر ہے",
      "FullUrl": "/p282/ghazal/sh8340",
      "RadifLetter": "ے"
    },
    {
      "Id": 8339,
      "Title": "امید ہے کہ مجھ کو خدا آدمی کرے",
      "FullUrl": "/p282/ghazal/sh8339",
      "RadifLetter": "ے"
    }
  ]
