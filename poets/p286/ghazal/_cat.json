    {
      "Id": 8362,
      "Title": "اس بت کو دل دکھا کے کلیجہ دکھا دیا",
      "FullUrl": "/p286/ghazal/sh8362"
    },
    {
      "Id": 8365,
      "Title": "مضمون عشق ذہن ستم گر میں آ گیا",
      "FullUrl": "/p286/ghazal/sh8365"
    },
    {
      "Id": 8364,
      "Title": "مصرعے پہ ان کے مصرعۂ قد کا گماں ہوا",
      "FullUrl": "/p286/ghazal/sh8364"
    },
    {
      "Id": 8363,
      "Title": "دکھا اے ناخن غم لطف باہم ایسے ساماں پر",
      "FullUrl": "/p286/ghazal/sh8363"
    },
    {
      "Id": 8367,
      "Title": "گر تعلی پر ہے وہم امتحان مے فروش",
      "FullUrl": "/p286/ghazal/sh8367"
    },
    {
      "Id": 8368,
      "Title": "ہو اگر مد نظر گلشن میں اے گلفام رقص",
      "FullUrl": "/p286/ghazal/sh8368"
    },
    {
      "Id": 8366,
      "Title": "نیم جاں ہوں زندگی دود چراغ کشتہ ہے",
      "FullUrl": "/p286/ghazal/sh8366"
    }
  ]
