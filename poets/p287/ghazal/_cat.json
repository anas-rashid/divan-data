  "Poems": [
    {
      "Id": 8376,
      "Title": "پھل ہے اس بت کی آشنائی کا",
      "FullUrl": "/p287/ghazal/sh8376",
      "RadifLetter": "ا"
    },
    {
      "Id": 8371,
      "Title": "زینت عنواں ہے مضموں عالم توحید کا",
      "FullUrl": "/p287/ghazal/sh8371",
      "RadifLetter": "ا"
    },
    {
      "Id": 8375,
      "Title": "وصل سے تب بھرے ہمارا پیٹ",
      "FullUrl": "/p287/ghazal/sh8375",
      "RadifLetter": "ٹ"
    },
    {
      "Id": 8377,
      "Title": "کچھ غرض وجہ مدعا باعث",
      "FullUrl": "/p287/ghazal/sh8377",
      "RadifLetter": "ث"
    },
    {
      "Id": 8370,
      "Title": "دل تنگ اس میں رنج و الم شور و شر ہوں جمع",
      "FullUrl": "/p287/ghazal/sh8370",
      "RadifLetter": "ع"
    },
    {
      "Id": 8378,
      "Title": "کہیں کیا کہ کیا کیا ستم دیکھتے ہیں",
      "FullUrl": "/p287/ghazal/sh8378",
      "RadifLetter": "ن"
    },
    {
      "Id": 8379,
      "Title": "ہوش و شکیب و تاب و صبر و قرار پانچوں",
      "FullUrl": "/p287/ghazal/sh8379",
      "RadifLetter": "ن"
    },
    {
      "Id": 8374,
      "Title": "قاتل کے کوچہ میں ہمہ تن جاؤں بن کے پاؤں",
      "FullUrl": "/p287/ghazal/sh8374",
      "RadifLetter": "ن"
    },
    {
      "Id": 8369,
      "Title": "ایجاد غم ہوا دل مضطر کے واسطے",
      "FullUrl": "/p287/ghazal/sh8369",
      "RadifLetter": "ے"
    },
    {
      "Id": 8372,
      "Title": "سبحہ سے مطلب نہ کچھ زنار سے",
      "FullUrl": "/p287/ghazal/sh8372",
      "RadifLetter": "ے"
    },
    {
      "Id": 8373,
      "Title": "سر ملا ہے عشق کا سودا سمانے کے لئے",
      "FullUrl": "/p287/ghazal/sh8373",
      "RadifLetter": "ے"
    }
  ]
