  "Poems": [
    {
      "Id": 8380,
      "Title": "آہ میں کچھ نظر آئی نہ اثر کی صورت",
      "FullUrl": "/p288/ghazal/c781/sh8380"
    },
    {
      "Id": 8381,
      "Title": "اس سنگ دل کے دل میں محبت نے گھر کیا",
      "FullUrl": "/p288/ghazal/c781/sh8381"
    },
    {
      "Id": 8382,
      "Title": "جان جاتی ہے مری ان کو خبر کچھ بھی نہیں",
      "FullUrl": "/p288/ghazal/c781/sh8382"
    },
    {
      "Id": 8383,
      "Title": "جھڑکی نہیں دیتے ہیں کہ غصہ نہیں ہوتا",
      "FullUrl": "/p288/ghazal/c781/sh8383"
    },
    {
      "Id": 8384,
      "Title": "دل میں اس بانیٔ بیداد کے گھر ہونے دو",
      "FullUrl": "/p288/ghazal/c781/sh8384"
    },
    {
      "Id": 8385,
      "Title": "سمایا جب سے ہے وہ گلعذار آنکھوں میں",
      "FullUrl": "/p288/ghazal/c781/sh8385"
    },
    {
      "Id": 8386,
      "Title": "شب فراق میں رویا کیا سحر کے لئے",
      "FullUrl": "/p288/ghazal/c781/sh8386"
    },
    {
      "Id": 8387,
      "Title": "شب وصل انہیں ضد اگر ہو گئی",
      "FullUrl": "/p288/ghazal/c781/sh8387"
    },
    {
      "Id": 8388,
      "Title": "عشق ابرو کا ہوا زلف رسا سے پہلے",
      "FullUrl": "/p288/ghazal/c781/sh8388"
    },
    {
      "Id": 8389,
      "Title": "عشق صادق نے دکھایا یہ اثر آپ سے آپ",
      "FullUrl": "/p288/ghazal/c781/sh8389"
    },
    {
      "Id": 8390,
      "Title": "غم فراق کا کھٹکا وصال یار میں ہے",
      "FullUrl": "/p288/ghazal/c781/sh8390"
    },
    {
      "Id": 8391,
      "Title": "نخل امید میں ثمر آیا",
      "FullUrl": "/p288/ghazal/c781/sh8391"
    },
    {
      "Id": 8392,
      "Title": "ہو نہ رسوائے زمانہ مہ کامل کی طرح",
      "FullUrl": "/p288/ghazal/c781/sh8392"
    },
    {
      "Id": 8393,
      "Title": "ہوں دفن مر کے کوچۂ جاناں کے سامنے",
      "FullUrl": "/p288/ghazal/c781/sh8393"
    }
