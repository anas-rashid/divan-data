  "Poems": [
    {
      "Id": 8394,
      "Title": "اس نے مے پی کے سر بزم جو ساغر الٹا",
      "FullUrl": "/p289/ghazal/sh8394",
      "RadifLetter": "ا"
    },
    {
      "Id": 8400,
      "Title": "خوگر لذت ہوں میں کس شوخ کی تعزیر کا",
      "FullUrl": "/p289/ghazal/sh8400",
      "RadifLetter": "ا"
    },
    {
      "Id": 8406,
      "Title": "مجسم داغ حسرت ہوں سراپا نقش عبرت کا",
      "FullUrl": "/p289/ghazal/sh8406",
      "RadifLetter": "ا"
    },
    {
      "Id": 8397,
      "Title": "بعد مدت جو میں اے چرخ کہن یاد آیا",
      "FullUrl": "/p289/ghazal/sh8397",
      "RadifLetter": "ا"
    },
    {
      "Id": 8398,
      "Title": "ترے وعدے کا ہر اک کو اگر اعتبار ہوتا",
      "FullUrl": "/p289/ghazal/sh8398",
      "RadifLetter": "ا"
    },
    {
      "Id": 8402,
      "Title": "سارے عالم سے مرے غم کا ہے افسانہ جدا",
      "FullUrl": "/p289/ghazal/sh8402",
      "RadifLetter": "ا"
    },
    {
      "Id": 8416,
      "Title": "کیوں کہتے ہو کیا میری جفا کو نہیں دیکھا",
      "FullUrl": "/p289/ghazal/sh8416",
      "RadifLetter": "ا"
    },
    {
      "Id": 8418,
      "Title": "ہجر میں ناشاد دنیا سے دل مضطر گیا",
      "FullUrl": "/p289/ghazal/sh8418",
      "RadifLetter": "ا"
    },
    {
      "Id": 8407,
      "Title": "معنی طراز عشق ہر اک بادہ خوار تھا",
      "FullUrl": "/p289/ghazal/sh8407",
      "RadifLetter": "ا"
    },
    {
      "Id": 8408,
      "Title": "وہ تغافل کو علاج غم پنہاں سمجھا",
      "FullUrl": "/p289/ghazal/sh8408",
      "RadifLetter": "ا"
    },
    {
      "Id": 8412,
      "Title": "کوئی ارماں تلاش دوست کا کیوں دل میں رہ جاتا",
      "FullUrl": "/p289/ghazal/sh8412",
      "RadifLetter": "ا"
    },
    {
      "Id": 8399,
      "Title": "جو مدتوں میں کسی شوخ کا شباب آیا",
      "FullUrl": "/p289/ghazal/sh8399",
      "RadifLetter": "ا"
    },
    {
      "Id": 8404,
      "Title": "صبح کو حشر بھی ہے کٹ گئی گر آج کی رات",
      "FullUrl": "/p289/ghazal/sh8404",
      "RadifLetter": "ت"
    },
    {
      "Id": 8403,
      "Title": "شوق دل فکر دہن میں ہے جو رہبر کی طرح",
      "FullUrl": "/p289/ghazal/sh8403",
      "RadifLetter": "ح"
    },
    {
      "Id": 8395,
      "Title": "ان کی رخصت اک قیامت تھی دم اظہار صبح",
      "FullUrl": "/p289/ghazal/sh8395",
      "RadifLetter": "ح"
    },
    {
      "Id": 8401,
      "Title": "رہا کرتے ہیں مے خانوں میں ہم پیر مغاں ہو کر",
