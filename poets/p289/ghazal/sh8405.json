      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ضبط سے دل نزار رہتا ہے\r\nاندرونی بخار رہتا ہے\r\nیوں تو دل کو کبھی قرار نہ تھا\r\nاب بہت بے قرار رہتا ہے\r\nقطع امید ہو تو صبر آئے\r\nروز اک انتظار رہتا ہے\r\nمایۂ زندگی سخن ہے نظرؔ\r\nشعر ہی یادگار رہتا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
  ],
