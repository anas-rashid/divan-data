      "RhymeLetters": null,
      "PlainText": "یاس ہے حسرت ہے غم ہے اور شب دیجور ہے\r\nاتنے ساتھی ہیں مگر تنہا دل رنجور ہے\r\nتیرا جانا تھا کہ غم خانے پہ وحشت چھا گئی\r\nمیں یہ سمجھا تھا مرے گھر سے بیاباں دور ہے\r\nشب کی خاموشی میں ہے تیرا تصور تیری یاد\r\nہائے کیا سامان تسکین دل رنجور ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 3
    }
