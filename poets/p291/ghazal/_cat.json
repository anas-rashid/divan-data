    {
      "Id": 8433,
      "Title": "اب زندگی میں ہوش کا امکان تو گیا",
      "FullUrl": "/p291/ghazal/sh8433"
    },
    {
      "Id": 8434,
      "Title": "ادب سے شکوۂ غم ہو رہا ہے",
      "FullUrl": "/p291/ghazal/sh8434"
    },
    {
      "Id": 8435,
      "Title": "بخت کو رویا کئے اور آشیاں دیکھا کئے",
      "FullUrl": "/p291/ghazal/sh8435"
    },
    {
      "Id": 8436,
      "Title": "بیان سن نہ سکا جب کوئی بیاں کی طرح",
      "FullUrl": "/p291/ghazal/sh8436"
    },
    {
      "Id": 8437,
      "Title": "بے نیاز ہر تمنا ہو گیا",
      "FullUrl": "/p291/ghazal/sh8437"
    },
    {
      "Id": 8438,
      "Title": "تاب دیدار لا نہیں سکتے",
      "FullUrl": "/p291/ghazal/sh8438"
    },
    {
      "Id": 8439,
      "Title": "جب برق پاش جلوۂ جانانہ بن گیا",
      "FullUrl": "/p291/ghazal/sh8439"
    },
    {
      "Id": 8440,
      "Title": "خوشی کی حد غموں کی انتہا معلوم ہوتی ہے",
      "FullUrl": "/p291/ghazal/sh8440"
    },
    {
      "Id": 8441,
      "Title": "دل میں ہجوم شوق و تمنا لیے ہوئے",
      "FullUrl": "/p291/ghazal/sh8441"
    },
    {
      "Id": 8442,
      "Title": "زمانہ میں فسانہ بن گئی دیوانگی میری",
      "FullUrl": "/p291/ghazal/sh8442"
    },
    {
      "Id": 8443,
      "Title": "ساز دل تشنۂ مضراب تمنا نہ رہا",
      "FullUrl": "/p291/ghazal/sh8443"
    },
    {
      "Id": 8444,
      "Title": "طور بن کر جل گیا یا شوق موسیٰ ہو گیا",
      "FullUrl": "/p291/ghazal/sh8444"
    },
    {
      "Id": 8445,
      "Title": "مآل جور سمجھے اور نہ انجام وفا سمجھے",
      "FullUrl": "/p291/ghazal/sh8445"
    },
    {
      "Id": 8446,
      "Title": "محبت ابتدا ہے ہر خبر کی",
      "FullUrl": "/p291/ghazal/sh8446"
    },
    {
      "Id": 8447,
      "Title": "محبت میں اک ایسا بھی مقام آتا ہے مشکل کا",
      "FullUrl": "/p291/ghazal/sh8447"
    },
    {
      "Id": 8448,
      "Title": "محبت ہے تو پھر اندازۂ شوق وفا کیوں ہو",
      "FullUrl": "/p291/ghazal/sh8448"
    },
    {
      "Id": 8449,
      "Title": "نہ ابتدا ہوں کسی کی نہ انتہا ہوں میں",
      "FullUrl": "/p291/ghazal/sh8449"
    },
    {
      "Id": 8450,
      "Title": "وہ محبت وہ دل وہ خو ہی نہیں",
      "FullUrl": "/p291/ghazal/sh8450"
    },
    {
      "Id": 8451,
      "Title": "ڈھونڈ لیں ہم کو ہماری جو خبر رکھتے ہیں",
      "FullUrl": "/p291/ghazal/sh8451"
    },
    {
      "Id": 8452,
      "Title": "کن الجھنوں میں چھوڑ گئی جستجو مجھے",
      "FullUrl": "/p291/ghazal/sh8452"
    },
    {
      "Id": 8453,
      "Title": "ہر مصیبت بھی شادمانی تھی",
      "FullUrl": "/p291/ghazal/sh8453"
    },
    {
      "Id": 8454,
      "Title": "ہمارا جذب صادق شوق کامل دیکھتے جاؤ",
      "FullUrl": "/p291/ghazal/sh8454"
    },
    {
      "Id": 8455,
      "Title": "ہوتی ہے طبیعت ہی خدا داد کسی کی",
      "FullUrl": "/p291/ghazal/sh8455"
    },
    {
      "Id": 8456,
      "Title": "یہی ہیں برق کی جولانیاں تو آشیاں کب تک",
      "FullUrl": "/p291/ghazal/sh8456"
    }
  ]
