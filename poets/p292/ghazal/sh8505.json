      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "میں روتا ہوں آہ رسا بند ہے\r\nبرستا ہے پانی ہوا بند ہے\r\nنہیں مرغ جان جسم صد چاک میں\r\nہمارے قفس میں ہما بند ہے\r\nکہاں قافلہ تک رسائی مجھے\r\nمیں ہوں لنگ شور درا بند ہے\r\nدل وحشی اپنا چھٹے کس طرح\r\nکہ زنجیر گیسو کا پابند ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
  ],
