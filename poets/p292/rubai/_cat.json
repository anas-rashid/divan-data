      "Title": "اپنے آقا کی ہر گھڑی یاد میں ہوں",
      "FullUrl": "/p292/rubai/sh8464"
    },
    {
      "Id": 8469,
      "Title": "بے فائدہ رکھتا نہیں سر ہاتھوں پر",
      "FullUrl": "/p292/rubai/sh8469"
    },
    {
      "Id": 8478,
      "Title": "جراح کے سامنے کھولا پھوڑا",
      "FullUrl": "/p292/rubai/sh8478"
    },
    {
      "Id": 8495,
      "Title": "عاشق ہی فقط نہیں ہے جنجالوں میں",
      "FullUrl": "/p292/rubai/sh8495"
    },
    {
      "Id": 8503,
      "Title": "مضمون اگر راہ میں ہاتھ آتا ہے",
      "FullUrl": "/p292/rubai/sh8503"
    },
    {
      "Id": 8508,
      "Title": "وہ بحر کرم جو مہرباں ہو جائے",
      "FullUrl": "/p292/rubai/sh8508"
    },
    {
      "Id": 8510,
      "Title": "پھوڑے نے سفر میں سخت گھبرایا ہے",
      "FullUrl": "/p292/rubai/sh8510"
    },
    {
      "Id": 8515,
      "Title": "کلکتہ کو ڈاک میں چلا ہوں جو میں آہ",
      "FullUrl": "/p292/rubai/sh8515"
    },
    {
      "Id": 8519,
      "Title": "ہر چند گناہوں سے ہوں میں نامہ سیاہ",
      "FullUrl": "/p292/rubai/sh8519"
    }
