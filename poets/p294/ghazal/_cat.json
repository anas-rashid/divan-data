  "Poems": [
    {
      "Id": 8539,
      "Title": "آگ اشک گرم کو لگے جی کیا ہی جل گیا",
      "FullUrl": "/p294/ghazal/sh8539",
      "RadifLetter": "ا"
    },
    {
      "Id": 8540,
      "Title": "اثر اس کو ذرا نہیں ہوتا",
      "FullUrl": "/p294/ghazal/sh8540",
      "RadifLetter": "ا"
    },
    {
      "Id": 8583,
      "Title": "ڈر تو مجھے کس کا ہے کہ میں کچھ نہیں کہتا",
      "FullUrl": "/p294/ghazal/sh8583",
      "RadifLetter": "ا"
    },
    {
      "Id": 8569,
      "Title": "غیروں پہ کھل نہ جائے کہیں راز دیکھنا",
      "FullUrl": "/p294/ghazal/sh8569",
      "RadifLetter": "ا"
    },
    {
      "Id": 8572,
      "Title": "محشر میں پاس کیوں دم فریاد آ گیا",
      "FullUrl": "/p294/ghazal/sh8572",
      "RadifLetter": "ا"
    },
    {
      "Id": 8567,
      "Title": "عدم میں رہتے تو شاد رہتے اسے بھی فکر ستم نہ ہوتا",
      "FullUrl": "/p294/ghazal/sh8567",
      "RadifLetter": "ا"
    },
    {
      "Id": 8547,
      "Title": "اے آرزوئے قتل ذرا دل کو تھامنا",
      "FullUrl": "/p294/ghazal/sh8547",
      "RadifLetter": "ا"
    },
    {
      "Id": 8568,
      "Title": "غصہ بیگانہ وار ہونا تھا",
      "FullUrl": "/p294/ghazal/sh8568",
      "RadifLetter": "ا"
    },
    {
      "Id": 8557,
      "Title": "دل قابل محبت جاناں نہیں رہا",
      "FullUrl": "/p294/ghazal/sh8557",
      "RadifLetter": "ا"
    },
    {
      "Id": 8541,
      "Title": "اس وسعت کلام سے جی تنگ آ گیا",
      "FullUrl": "/p294/ghazal/sh8541",
      "RadifLetter": "ا"
    },
    {
      "Id": 8559,
      "Title": "دیدۂ حیراں نے تماشا کیا",
      "FullUrl": "/p294/ghazal/sh8559",
      "RadifLetter": "ا"
    },
    {
      "Id": 8577,
      "Title": "وعدۂ وصلت سے دل ہو شاد کیا",
      "FullUrl": "/p294/ghazal/sh8577",
      "RadifLetter": "ا"
    },
    {
      "Id": 8593,
      "Title": "یہ عذر امتحان جذب دل کیسا نکل آیا",
      "FullUrl": "/p294/ghazal/sh8593",
      "RadifLetter": "ا"
    },
    {
      "Id": 8554,
      "Title": "جوں نکہت گل جنبش ہے جی کا نکل جانا",
      "FullUrl": "/p294/ghazal/sh8554",
      "RadifLetter": "ا"
    },
    {
      "Id": 8565,
      "Title": "شوخ کہتا ہے بے حیا جانا",
      "FullUrl": "/p294/ghazal/sh8565",
      "RadifLetter": "ا"
    },
    {
      "Id": 8560,
      "Title": "دیکھ لو شوق نا تمام مرا",
      "FullUrl": "/p294/ghazal/sh8560",
      "RadifLetter": "ا"
    },
    {
      "Id": 8587,
      "Title": "ہم رنگ لاغری سے ہوں گل کی شمیم کا",
      "FullUrl": "/p294/ghazal/sh8587",
      "RadifLetter": "ا"
    },
    {
      "Id": 8561,
      "Title": "راز نہاں زبان اغیار تک نہ پہنچا",
      "FullUrl": "/p294/ghazal/sh8561",
      "RadifLetter": "ا"
    },
    {
      "Id": 8571,
      "Title": "لگے خدنگ جب اس نالۂ سحر کا سا",
      "FullUrl": "/p294/ghazal/sh8571",
      "RadifLetter": "ا"
    },
    {
      "Id": 8586,
      "Title": "گر غیر کے گھر سے نہ دل آرام نکلتا",
      "FullUrl": "/p294/ghazal/sh8586",
      "RadifLetter": "ا"
    },
    {
      "Id": 8578,
      "Title": "وعدے کی جو ساعت دم کشتن ہے ہمارا",
      "FullUrl": "/p294/ghazal/sh8578",
      "RadifLetter": "ا"
    },
    {
      "Id": 8551,
      "Title": "تھی وصل میں بھی فکر جدائی تمام شب",
      "FullUrl": "/p294/ghazal/sh8551",
      "RadifLetter": "ب"
    },
    {
      "Id": 8550,
      "Title": "تم بھی رہنے لگے خفا صاحب",
      "FullUrl": "/p294/ghazal/sh8550",
      "RadifLetter": "ب"
    },
    {
      "Id": 8563,
      "Title": "سودا تھا بلائے جوش پر رات",
      "FullUrl": "/p294/ghazal/sh8563",
      "RadifLetter": "ت"
    },
    {
      "Id": 8589,
      "Title": "ہو نہ بیتاب ادا تمہاری آج",
      "FullUrl": "/p294/ghazal/sh8589",
      "RadifLetter": "ج"
    },
    {
      "Id": 8562,
      "Title": "رویا کریں گے آپ بھی پہروں اسی طرح",
      "FullUrl": "/p294/ghazal/sh8562",
      "RadifLetter": "ح"
    },
    {
      "Id": 8574,
      "Title": "مومنؔ خدا کے واسطے ایسا مکاں نہ چھوڑ",
      "FullUrl": "/p294/ghazal/sh8574",
      "RadifLetter": "ڑ"
    },
    {
      "Id": 8570,
      "Title": "قہر ہے موت ہے قضا ہے عشق",
      "FullUrl": "/p294/ghazal/sh8570",
      "RadifLetter": "ق"
    },
    {
      "Id": 8545,
      "Title": "امتحاں کے لیے جفا کب تک",
      "FullUrl": "/p294/ghazal/sh8545",
      "RadifLetter": "ک"
    },
    {
      "Id": 8581,
      "Title": "ٹھانی تھی دل میں اب نہ ملیں گے کسی سے ہم",
      "FullUrl": "/p294/ghazal/sh8581",
      "RadifLetter": "م"
    },
    {
      "Id": 8549,
      "Title": "تاثیر صبر میں نہ اثر اضطراب میں",
      "FullUrl": "/p294/ghazal/sh8549",
      "RadifLetter": "ن"
    },
    {
      "Id": 8552,
      "Title": "جلتا ہوں ہجر شاہد و یاد شراب میں",
      "FullUrl": "/p294/ghazal/sh8552",
      "RadifLetter": "ن"
    },
    {
      "Id": 8548,
      "Title": "تا نہ پڑے خلل کہیں آپ کے خواب ناز میں",
      "FullUrl": "/p294/ghazal/sh8548",
      "RadifLetter": "ن"
    },
    {
      "Id": 8579,
      "Title": "وہ جو ہم میں تم میں قرار تھا تمہیں یاد ہو کہ نہ یاد ہو",
      "FullUrl": "/p294/ghazal/sh8579",
      "RadifLetter": "و"
    },
    {
      "Id": 8538,
      "Title": "آنکھوں سے حیا ٹپکے ہے انداز تو دیکھو",
      "FullUrl": "/p294/ghazal/sh8538",
      "RadifLetter": "و"
    },
    {
      "Id": 8542,
      "Title": "اعجاز جاں دہی ہے ہمارے کلام کو",
      "FullUrl": "/p294/ghazal/sh8542",
      "RadifLetter": "و"
    },
    {
      "Id": 8588,
      "Title": "ہم سمجھتے ہیں آزمانے کو",
      "FullUrl": "/p294/ghazal/sh8588",
      "RadifLetter": "و"
    },
    {
      "Id": 8582,
      "Title": "چل پرے ہٹ مجھے نہ دکھلا منہ",
      "FullUrl": "/p294/ghazal/sh8582",
      "RadifLetter": "ہ"
    },
    {
      "Id": 8553,
      "Title": "جو تیرے منہ سے نہ ہو شرمسار آئینہ",
      "FullUrl": "/p294/ghazal/sh8553",
      "RadifLetter": "ہ"
    },
    {
      "Id": 8556,
      "Title": "دل بستگی سی ہے کسی زلف دوتا کے ساتھ",
      "FullUrl": "/p294/ghazal/sh8556",
      "RadifLetter": "ھ"
    },
    {
      "Id": 8544,
      "Title": "الٹے وہ شکوے کرتے ہیں اور کس ادا کے ساتھ",
      "FullUrl": "/p294/ghazal/sh8544",
      "RadifLetter": "ھ"
    },
    {
      "Id": 8546,
      "Title": "اگر غفلت سے باز آیا جفا کی",
      "FullUrl": "/p294/ghazal/sh8546",
      "RadifLetter": "ی"
    },
    {
      "Id": 8576,
      "Title": "نہ انتظار میں یاں آنکھ ایک آن لگی",
      "FullUrl": "/p294/ghazal/sh8576",
      "RadifLetter": "ی"
    },
    {
      "Id": 8558,
      "Title": "دل میں اس شوخ کے جو راہ نہ کی",
      "FullUrl": "/p294/ghazal/sh8558",
      "RadifLetter": "ی"
    },
    {
      "Id": 8590,
      "Title": "ہوئی تاثیر آہ و زاری کی",
      "FullUrl": "/p294/ghazal/sh8590",
      "RadifLetter": "ی"
    },
    {
      "Id": 8555,
      "Title": "دفن جب خاک میں ہم سوختہ ساماں ہوں گے",
      "FullUrl": "/p294/ghazal/sh8555",
      "RadifLetter": "ے"
    },
    {
      "Id": 8580,
      "Title": "وہ کہاں ساتھ سلاتے ہیں مجھے",
      "FullUrl": "/p294/ghazal/sh8580",
      "RadifLetter": "ے"
    },
    {
      "Id": 8584,
      "Title": "کرتا ہے قتل عام وہ اغیار کے لیے",
      "FullUrl": "/p294/ghazal/sh8584",
      "RadifLetter": "ے"
    },
    {
      "Id": 8591,
      "Title": "ہے دل میں غبار اس کے گھر اپنا نہ کریں گے",
      "FullUrl": "/p294/ghazal/sh8591",
      "RadifLetter": "ے"
    },
    {
      "Id": 8566,
      "Title": "صبر وحشت اثر نہ ہو جائے",
      "FullUrl": "/p294/ghazal/sh8566",
      "RadifLetter": "ے"
    },
    {
      "Id": 8575,
      "Title": "میں اگر آپ سے جاؤں تو قرار آ جائے",
      "FullUrl": "/p294/ghazal/sh8575",
      "RadifLetter": "ے"
    },
    {
      "Id": 8564,
      "Title": "شب تم جو بزم غیر میں آنکھیں چرا گئے",
      "FullUrl": "/p294/ghazal/sh8564",
      "RadifLetter": "ے"
    }
  ]
