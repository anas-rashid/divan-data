      "RadifLetter": "ا"
    },
    {
      "Id": 8613,
      "Title": "جب سے دیکھا ہے بنا گوش قمر میں تنکا",
      "FullUrl": "/p297/ghazal/sh8613",
      "RadifLetter": "ا"
    },
    {
      "Id": 8611,
      "Title": "اپنے ہی دم سے ہے چرچا کفر اور اسلام کا",
      "FullUrl": "/p297/ghazal/sh8611",
      "RadifLetter": "ا"
    },
    {
      "Id": 8618,
      "Title": "ہے دل کو اس طرح سے مرے یار کی تلاش",
      "FullUrl": "/p297/ghazal/sh8618",
      "RadifLetter": "ش"
    },
    {
      "Id": 8615,
      "Title": "نہیں ملتا دلا ہم کو نشاں تک",
      "FullUrl": "/p297/ghazal/sh8615",
      "RadifLetter": "ک"
    },
    {
      "Id": 8614,
      "Title": "قیس جنگل میں اکیلا ہے مجھے جانے دو",
