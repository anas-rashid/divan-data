      "FullUrl": "/p298/ghazal/sh8642",
      "RadifLetter": "ا"
    },
    {
      "Id": 8646,
      "Title": "کبھو ہم سے بھی وفا کیجئے گا",
      "FullUrl": "/p298/ghazal/sh8646",
      "RadifLetter": "ا"
    },
    {
      "Id": 8649,
      "Title": "کہوں کیا دل اڑانے کا ترا کچھ ڈھب نرالا تھا",
      "FullUrl": "/p298/ghazal/sh8649",
      "RadifLetter": "ا"
    },
    {
      "Id": 8640,
      "Title": "مرض عشق دل کو زور لگا",
      "FullUrl": "/p298/ghazal/sh8640",
      "RadifLetter": "ا"
    },
    {
      "Id": 8636,
      "Title": "زیست ہونی تعجبات ہے اب",
      "FullUrl": "/p298/ghazal/sh8636",
      "RadifLetter": "ب"
    },
    {
      "Id": 8635,
      "Title": "دیکھ کر دل کو پیچ و تاب کے بیچ",
      "FullUrl": "/p298/ghazal/sh8635",
      "RadifLetter": "چ"
    },
    {
      "Id": 8631,
      "Title": "جوں گل تو ہنسے ہے کھل کھلا کر",
      "FullUrl": "/p298/ghazal/sh8631",
      "RadifLetter": "ر"
    },
    {
      "Id": 8624,
      "Title": "بے وفا تجھ سے کچھ گلا ہی نہیں",
      "FullUrl": "/p298/ghazal/sh8624",
      "RadifLetter": "ن"
    },
    {
      "Id": 8633,
      "Title": "دل میں سو آرمان رکھتا ہوں",
      "FullUrl": "/p298/ghazal/sh8633",
      "RadifLetter": "ن"
    },
    {
      "Id": 8647,
      "Title": "کر کے دل کو شکار آنکھوں میں",
      "FullUrl": "/p298/ghazal/sh8647",
      "RadifLetter": "ن"
    },
    {
      "Id": 8654,
      "Title": "ہم ہیں بے دل دل اپنے پاس نہیں",
      "FullUrl": "/p298/ghazal/sh8654",
      "RadifLetter": "ن"
    },
    {
      "Id": 8643,
      "Title": "نہ برق نہ شعلہ نے شرر ہوں",
      "FullUrl": "/p298/ghazal/sh8643",
      "RadifLetter": "ن"
    },
    {
      "Id": 8644,
      "Title": "نہ لگا لے گئے جہاں دل کو",
      "FullUrl": "/p298/ghazal/sh8644",
      "RadifLetter": "و"
    },
    {
      "Id": 8623,
      "Title": "ایک تنہا خاطر محزوں جسے افکار سو",
      "FullUrl": "/p298/ghazal/sh8623",
      "RadifLetter": "و"
    },
    {
      "Id": 8652,
      "Title": "گرچہ دل میں ہی سدا جان جہاں رہتے ہو",
      "FullUrl": "/p298/ghazal/sh8652",
      "RadifLetter": "و"
    },
    {
      "Id": 8626,
      "Title": "تو مری جان گر نہیں آتی",
      "FullUrl": "/p298/ghazal/sh8626",
      "RadifLetter": "ی"
    },
    {
      "Id": 8620,
      "Title": "اب غیر سے بھی تیری ملاقات رہ گئی",
