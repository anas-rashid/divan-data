  "Poems": [
    {
      "Id": 8619,
      "Title": "آشنا جو مزہ کا ہوتا ہے",
      "FullUrl": "/p298/ghazal/sh8619"
    },
    {
      "Id": 8620,
      "Title": "اب غیر سے بھی تیری ملاقات رہ گئی",
      "FullUrl": "/p298/ghazal/sh8620"
    },
    {
      "Id": 8621,
      "Title": "اثرؔ اب تک فریب کھاتا ہے",
      "FullUrl": "/p298/ghazal/sh8621"
    },
    {
      "Id": 8622,
      "Title": "اثرؔ کیجئے کیا کدھر جائیے",
      "FullUrl": "/p298/ghazal/sh8622"
    },
    {
      "Id": 8623,
      "Title": "ایک تنہا خاطر محزوں جسے افکار سو",
      "FullUrl": "/p298/ghazal/sh8623"
    },
    {
      "Id": 8624,
      "Title": "بے وفا تجھ سے کچھ گلا ہی نہیں",
      "FullUrl": "/p298/ghazal/sh8624"
    },
    {
      "Id": 8625,
      "Title": "بے کسی میں اثر یگانہ ہے",
      "FullUrl": "/p298/ghazal/sh8625"
    },
    {
      "Id": 8626,
      "Title": "تو مری جان گر نہیں آتی",
      "FullUrl": "/p298/ghazal/sh8626"
    },
    {
      "Id": 8627,
      "Title": "تیرے آنے کا احتمال رہا",
      "FullUrl": "/p298/ghazal/sh8627"
    },
    {
      "Id": 8628,
      "Title": "تیرے وعدوں کا اعتبار کسے",
      "FullUrl": "/p298/ghazal/sh8628"
    },
    {
      "Id": 8629,
      "Title": "جب کہ ایدھر تری نگاہ پڑی",
      "FullUrl": "/p298/ghazal/sh8629"
    },
    {
      "Id": 8630,
      "Title": "جو بات ہے تیری سو نرالی",
      "FullUrl": "/p298/ghazal/sh8630"
    },
    {
      "Id": 8631,
      "Title": "جوں گل تو ہنسے ہے کھل کھلا کر",
      "FullUrl": "/p298/ghazal/sh8631"
    },
    {
      "Id": 8632,
      "Title": "خفا اس سے کیوں تو مری جان ہے",
      "FullUrl": "/p298/ghazal/sh8632"
    },
    {
      "Id": 8633,
      "Title": "دل میں سو آرمان رکھتا ہوں",
      "FullUrl": "/p298/ghazal/sh8633"
    },
    {
      "Id": 8634,
      "Title": "دیجئے رخصت بوسہ نہیں لے بیٹھیں گے",
      "FullUrl": "/p298/ghazal/sh8634"
    },
    {
      "Id": 8635,
      "Title": "دیکھ کر دل کو پیچ و تاب کے بیچ",
      "FullUrl": "/p298/ghazal/sh8635"
    },
    {
      "Id": 8636,
      "Title": "زیست ہونی تعجبات ہے اب",
      "FullUrl": "/p298/ghazal/sh8636"
    },
    {
      "Id": 8637,
      "Title": "صرف غم ہم نے نوجوانی کی",
      "FullUrl": "/p298/ghazal/sh8637"
    },
    {
      "Id": 8638,
      "Title": "غم کو باہم بہم نہ کیجے",
      "FullUrl": "/p298/ghazal/sh8638"
    },
    {
      "Id": 8639,
      "Title": "لوگ کہتے ہیں یار آتا ہے",
      "FullUrl": "/p298/ghazal/sh8639"
    },
    {
      "Id": 8640,
      "Title": "مرض عشق دل کو زور لگا",
      "FullUrl": "/p298/ghazal/sh8640"
    },
    {
      "Id": 8641,
      "Title": "میں تجھے واہ کیا تماشا ہے",
      "FullUrl": "/p298/ghazal/sh8641"
    },
    {
      "Id": 8642,
      "Title": "نالہ کرنا کہ آہ کرنا",
      "FullUrl": "/p298/ghazal/sh8642"
    },
    {
      "Id": 8643,
      "Title": "نہ برق نہ شعلہ نے شرر ہوں",
      "FullUrl": "/p298/ghazal/sh8643"
    },
    {
      "Id": 8644,
      "Title": "نہ لگا لے گئے جہاں دل کو",
      "FullUrl": "/p298/ghazal/sh8644"
    },
    {
      "Id": 8645,
      "Title": "وحشت زدہ دل تو جوں شرر ہے",
      "FullUrl": "/p298/ghazal/sh8645"
    },
    {
      "Id": 8646,
      "Title": "کبھو ہم سے بھی وفا کیجئے گا",
      "FullUrl": "/p298/ghazal/sh8646"
    },
    {
      "Id": 8647,
      "Title": "کر کے دل کو شکار آنکھوں میں",
      "FullUrl": "/p298/ghazal/sh8647"
    },
    {
      "Id": 8648,
      "Title": "کسو کو مجھ سے نے مجھ کو کسو سے کام رہتا ہے",
      "FullUrl": "/p298/ghazal/sh8648"
    },
    {
      "Id": 8649,
      "Title": "کہوں کیا دل اڑانے کا ترا کچھ ڈھب نرالا تھا",
      "FullUrl": "/p298/ghazal/sh8649"
    },
    {
      "Id": 8650,
      "Title": "کہیں ظاہر یہ تیری چاہ نہ کی",
      "FullUrl": "/p298/ghazal/sh8650"
    },
    {
      "Id": 8651,
      "Title": "کیدھر کی خوشی کہاں کی شادی",
      "FullUrl": "/p298/ghazal/sh8651"
    },
    {
      "Id": 8652,
      "Title": "گرچہ دل میں ہی سدا جان جہاں رہتے ہو",
      "FullUrl": "/p298/ghazal/sh8652"
    },
    {
      "Id": 8653,
      "Title": "ہم غلط احتمال رکھتے تھے",
      "FullUrl": "/p298/ghazal/sh8653"
    },
    {
      "Id": 8654,
      "Title": "ہم ہیں بے دل دل اپنے پاس نہیں",
      "FullUrl": "/p298/ghazal/sh8654"
    }
  ]
