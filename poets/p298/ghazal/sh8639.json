      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "لوگ کہتے ہیں یار آتا ہے\r\nدل تجھے اعتبار آتا ہے\r\nدوست ہوتا جو وہ تو کیا ہوتا\r\nدشمنی پر تو پیار آتا ہے\r\nتیرے کوچہ میں بے قرار ترا\r\nہر گھڑی بار بار آتا ہے\r\nزیر دیوار تو سنے نہ سنے\r\nنام تیرا پکار آتا ہے\r\nحال اپنے پہ مجھ کو آپ اثرؔ\r\nرحم بے اختیار آتا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 5
    }
