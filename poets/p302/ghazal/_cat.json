  "Title": "غزل",
  "FullUrl": "/p302/ghazal",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 8756,
      "Title": "اس کو میں ہوئے ہم وہ لب بام نہ آیا",
      "FullUrl": "/p302/ghazal/sh8756"
    },
    {
      "Id": 8757,
      "Title": "بے مہر کہتے ہو اسے جو بے وفا نہیں",
      "FullUrl": "/p302/ghazal/sh8757"
    },
    {
      "Id": 8758,
      "Title": "تم غیر سے ملو نہ ملو میں تو چھوڑ دوں",
      "FullUrl": "/p302/ghazal/sh8758"
    },
    {
      "Id": 8759,
      "Title": "تو کیوں پاس سے اٹھ چلا بیٹھے بیٹھے",
      "FullUrl": "/p302/ghazal/sh8759"
    },
    {
      "Id": 8760,
      "Title": "دل کس کی تیغ ناز سے لذت چشیدہ ہے",
      "FullUrl": "/p302/ghazal/sh8760"
    },
    {
      "Id": 8761,
      "Title": "رہنے والوں کو ترے کوچے کے یہ کیا ہو گیا",
      "FullUrl": "/p302/ghazal/sh8761"
    },
    {
      "Id": 8762,
      "Title": "فرق کچھ تو چاہیئے اغیار سے",
      "FullUrl": "/p302/ghazal/sh8762"
    },
    {
      "Id": 8763,
      "Title": "نام لو گے جو یاں سے جانے کا",
      "FullUrl": "/p302/ghazal/sh8763"
    },
    {
      "Id": 8764,
      "Title": "کر سکے دفن نہ اس کوچہ میں احباب مجھے",
      "FullUrl": "/p302/ghazal/sh8764"
    },
    {
      "Id": 8765,
      "Title": "کیا کیا مزے سے رات کی عہد شباب میں",
      "FullUrl": "/p302/ghazal/sh8765"
    },
    {
      "Id": 8766,
      "Title": "گر میرے بیٹھنے سے وہ آزار کھینچتے",
      "FullUrl": "/p302/ghazal/sh8766"
    },
    {
      "Id": 8767,
      "Title": "ہوئے تھے بھاگ کے پردے میں تم نہاں کیونکر",
      "FullUrl": "/p302/ghazal/sh8767"
    }
  ]
}
