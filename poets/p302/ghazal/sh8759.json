      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "مرا کام ہی ہو گیا بیٹھے بیٹھے",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "اٹھاتے ہو کیوں اپنی محفل سے مجھ کو",
