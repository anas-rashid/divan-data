    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "کرے سعی کچھ اٹھ کے اس کو سے اے دل",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
