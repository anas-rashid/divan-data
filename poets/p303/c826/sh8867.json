      "VOrder": 22,
      "Position": "Left",
      "Text": "ہوویں یاور جو طالع ناساز",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "رو علی کی طرف ہی رکھ اس میں",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "در فردوس منھ پہ ہوگا باز",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "ہوسکے تو علی پرستی کر",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "تو ہو اسلامیوں میں تو ممتاز",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ہے علی وہ کہ چرخ و ماہ و مہر",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اس کی قدرت پہ سب کریں ہیں ناز",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "محو یاد علی ہیں جو ان کو",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "نے سر سجدہ نے دماغ نماز",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "ہیں علی سے علی طلب شب و روز",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "دوستی کشتگان قلب گداز",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "قبلہ کعبہ خدا رسول علی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "گفتگو شوق کی بہت ہے دراز",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ہے علی جانشیں پیمبرؐ کا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "زیب مسجد ہے حسن منبر کا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "زور بازو سے اس کے کیا کہیے",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ہے زباں زد فسانہ خیبر کا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "کر گیا گم بڑوں بڑوں کے حواس",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "چیرنا کودکی میں اژدر کا",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "جذب خورشید کس طرح سے کیا",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "وقت کم تھا نماز دیگر کا",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "سرکشان جہاں نے جھاڑے کان",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "سن کے احوال عمرو و عنتر کا",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "تیغ اس کی تھی برق ابر بہار",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کٹ گیا جس سے رنگ اکثر کا",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "بارش ابر لطف بن اس کے",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "رفع کیا ہو غبار دل پر کا",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "کیا ہمارا شعور جو سمجھیں",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "مرتبہ اس سبھوں سے برتر کا",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "عقل کل پر بھی کرنا مشکل ہے",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "فرق ظاہر سے ایسے مظہر کا",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ذات پاک اس کی ہے خدا کی ذات",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "جمع واجب کے اس میں سب ہیں صفات",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "علم و قدرت نہ بابت مذکور",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "دم زدن یہ نہ جاے حلم و ثبات",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "وہ نہ ہوتا سبب تو پھر کیا تھا",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "کیسے ہم تم کہاں کے موجودات",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "نہ تو دس عقل و نہ فلک ہوتے",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "نہ ستارے نمود کرتے سات",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "حال روشن نہ روز کا ہوتا",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "رہتی تاریکی عدم سے رات",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "اس کے مقدم سے نور ہے ورنہ",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "سوجھتا کس کو ہاتھ سے پھر ہات",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "وہ مقوم سبھوں کا وہ سب کچھ",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "یہی کہنے کی ایک ہے گی بات",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ہے مسبب کہیں کہیں ہے سبب",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "ہے وہی لطف بے نہایت اب",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "ہے علی قابل پرستیدن",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "ہے علی مظہر ہزار عجب",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "عشق ہے ہم جو لیتے ہیں یوں نام",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "ورنہ سجدہ بھی یاں ہے ترک ادب",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "دم الطاف سبز روے زمیں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "جگر چرخ چاک وقت غضب",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "داب یکبارگی لیے دشمن",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "دب کیا تونے جس گھڑی مرکب",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "تو بنا پاے خاک میداں پر",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "استخوان مزار کا مطلب",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "بارہا اے سوار شائستہ",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "ابلق چرخ نکلا تجھ سے دب",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "ہے تو بندہ تو اے مرے معبود",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "پر خدا کے سے ہیں ترے سب ڈھب",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "ہے تفنن کے طور پر یہ شعر",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "آشنا اپنے لب سے روز و شب",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "ہے علی حامی و مقوم دیں",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "ہے علی پیشواے اہل یقیں",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "ہے علی برگزیدۂ عالم",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "ہے علی اشرف زمان و زمیں",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "اس کی ہمت سے اس گلستاں میں",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "جیسے شبنم پڑے ہیں در ثمیں",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "اس کی جرأت سے قشعریرہ ہے",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "ان کو جو ہیں گے شیر بیشۂ کیں",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "خوبی اس کی کہاں تلک کہیے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "خوب جانے جسے رسول امیں",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "اللہ اللہ تیری عزت و قدر",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "مجلس انبیا کا صدر نشیں",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "جیتے جیتے ہمارے قلب پر اب",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "نام اس کا ہے جیسے نقش نگیں",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "کبریا اس کی ہے وراے قیاس",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "وہم اپنا گیا کہیں سے کہیں",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "مانو یہ بات اس کی قدرت سے",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "نہیں بالقوۃ آدمی کا نہیں",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "سجدہ کرنے کے ہے علی قابل",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "قبلہ اپنا ہے اس طرف مائل",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "مرگ ہے مصلحت سے دشمن کو",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "بے ولا اس کے زیست کیا حاصل",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "درس میں تیرے اے شہ علام",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "پیر عقل ایک کودک جاہل",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "تیری ہمت قبول یہ نہ کرے",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "کہ مکرر ہلے لب سائل",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "اصل مطلب کو دوستی تیری",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "راہ مطلوب کو ہے یہ واصل",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "دست بخشش سحاب بارندہ",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "کف ہمت محیط بے ساحل",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "سیر کر مجمع کمال تجھے",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "دیکھ کر تیری قدرت کامل",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "طفل و برنا و پیر سارے مقر",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "عقل و ادراک و فہم سب قائل",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "یہ عقیدہ نہیں ہے اپنا ہی",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "کہتے ہیں سارے بالغ و عاقل",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "ہے علی سایہ گستر دوجہاں",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "دیوے خورشید حشر سے وہ اماں",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "صورت ظاہر علی پہ نہ جا",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "ہے علی خلوتی راز نہاں",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "وہ علی کی ہے ذات پاک جسے",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "جپتے رہتے ہیں اہل عالم جاں",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "کیا کریمی کی ہے صفت اللہ",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "نہیں ہے یہ نہیں یہی ہے یاں",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "شان ارفع ہے اپنے صاحب کی",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "کام کرتے نہیں قیاس و گماں",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "ہے جہاں رتبۂ وجوب اس کا",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "عقل کا درک وھاں ہے کیا امکاں",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "خوگر اس نام لینے سے جو نہیں",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "حیف صد حیف وہ دہان و زباں",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "دونوں یکتا ہیں ذوالفقار و علی",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "ایسی شمشیر ہے نہ ایسا جواں",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "سب ہیں حیران منزلت اس کے",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "قدر اس کی کہاں سپہر کہاں",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "ہے علی مدعا علی مقصود",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "وہی مشہود ہے وہی موجود",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "ہے علی وہ کہ سارے صاحب دل",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "لیتے نام اس کا بھیجتے ہیں درود",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "کیا زمیں کیا سپہر کیا مہ و مہر",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "کی علی کے لیے سبھوں نے نمود",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "جمع رکھ دل علی سبب ہوگا",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "کیا ہے اسباب اگر ہوئے مفقود",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "بندگی کے مقام ہیں معلوم",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "ہے یہ صاحب ہمارا تو معبود",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "مصطفےٰ مرتضےٰ خدا ہے ایک",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 164,
      "Position": "Left",
      "Text": "لیک آگاہ راز ہیں معدود",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 165,
      "Position": "Right",
      "Text": "جھک ہی جاتے ہیں سر سن اس کا نام",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "یعنی سب اس کو جانے ہیں مسجود",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "حشر ہوگا علی کے ساتھ اپنا",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "کیا ہے واں کا ہمیں غم بہبود",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 169,
      "Position": "Right",
      "Text": "عندیہ اپنا اپنا ہے اے شیخ",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 170,
      "Position": "Left",
      "Text": "گوش کر اس کو تو اچھل یا کود",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 171,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 172,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 173,
      "Position": "Right",
      "Text": "گاہ بے گاہ کر علی خوانی",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 174,
      "Position": "Left",
      "Text": "ہے علی دانی ہی خدا دانی",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 175,
      "Position": "Right",
      "Text": "مہر کا اس کی رہ سرآشفتہ",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 176,
      "Position": "Left",
      "Text": "ہے ولاے علی مسلمانی",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 177,
      "Position": "Right",
      "Text": "فرش راہ علی کر آنکھوں کو",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 178,
      "Position": "Left",
      "Text": "یوں بچھا تو بساط ایمانی",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 179,
      "Position": "Right",
      "Text": "مور بے زور ہو علی کا تو",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 180,
      "Position": "Left",
      "Text": "کہ جہاں میں کرے سلیمانی",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 181,
      "Position": "Right",
      "Text": "چاہ میں اس کی آپ کو گم کر",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 182,
      "Position": "Left",
      "Text": "تا کہیں تجھ کو ماہ کنعانی",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 183,
      "Position": "Right",
      "Text": "ہے وہی مہر چرخ عرفاں کا",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 184,
      "Position": "Left",
      "Text": "ہے وہی شاہ ظل سبحانی",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 185,
      "Position": "Right",
      "Text": "قامت آراے کبریا حق کا",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 186,
      "Position": "Left",
      "Text": "چہرہ پرداز نور یزدانی",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 187,
      "Position": "Right",
      "Text": "ہاتھ اس کا وہی خدا کا ہاتھ",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 188,
      "Position": "Left",
      "Text": "بات اس کی کلام ربانی",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 189,
      "Position": "Right",
      "Text": "شوق مفرط سے ہے یہ طرز سخن",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 190,
      "Position": "Left",
      "Text": "گو برا مانے کوئی مروانی",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 191,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 192,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 193,
      "Position": "Right",
      "Text": "ہے علی یاں کا مالک و مختار",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 194,
      "Position": "Left",
      "Text": "آگہ کار واقف اسرار",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 195,
      "Position": "Right",
      "Text": "ہے علی آفتاب سا روشن",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 196,
      "Position": "Left",
      "Text": "کچھ چھپا ہو تو کیجیے اظہار",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 197,
      "Position": "Right",
      "Text": "ہے علی بہترین خلق خدا",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 198,
      "Position": "Left",
      "Text": "ہے علی خویش سید ابرار",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 199,
      "Position": "Right",
      "Text": "کون اس کا مقر جود نہیں",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 200,
      "Position": "Left",
      "Text": "اس کی جرأت کا کس کو ہے انکار",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 201,
      "Position": "Right",
      "Text": "یہ شرف کس میں جمع ہوتے ہیں",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 202,
      "Position": "Left",
      "Text": "اشرف و حر و سید و سردار",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 203,
      "Position": "Right",
      "Text": "عہد کا فخر وقت کا سلطاں",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 204,
      "Position": "Left",
      "Text": "خوبی بزم و گرمی مضمار",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 205,
      "Position": "Right",
      "Text": "تیغ برکف اگر نمود کرے",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 206,
      "Position": "Left",
      "Text": "وہی قہار ہے وہی جبار",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 207,
      "Position": "Right",
      "Text": "حکم کے مرتبے میں ہو تو وہی",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 208,
      "Position": "Left",
      "Text": "پردہ پوش و غفور ہے ستار",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 209,
      "Position": "Right",
      "Text": "عشق پیشوں کو اس کے کیا وسواس",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 210,
      "Position": "Left",
      "Text": "کہتے ہیں اور پھر کہیں سو بار",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 211,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 212,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 213,
      "Position": "Right",
      "Text": "ہے علی وہ بلندقدر امیر",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 214,
      "Position": "Left",
      "Text": "دے دے ڈالے ہیں جس نے تاج و سریر",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 215,
      "Position": "Right",
      "Text": "اس کی یکتائی میں تردد کیا",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 216,
      "Position": "Left",
      "Text": "جس کا نکلا نہیں عدم سے نظیر",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 217,
      "Position": "Right",
      "Text": "خاک در ہو شہ ولایت کا",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 218,
      "Position": "Left",
      "Text": "شاہیاں لے گئے ہیں یاں سے فقیر",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 219,
      "Position": "Right",
      "Text": "یوں ہے درریز دست جود اس کا",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 220,
      "Position": "Left",
      "Text": "جیسے برسے ہے کوئی ابر مطیر",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 221,
      "Position": "Right",
      "Text": "صاحب ایسا ہی ہو تو صاحب ہے",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 222,
      "Position": "Left",
      "Text": "گنہ آمرز اور عذر پذیر",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 223,
      "Position": "Right",
      "Text": "ہم سے بندوں کی ورنہ کیونکے نبھے",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 224,
      "Position": "Left",
      "Text": "دم بہ دم جن سے ہوتی ہے تقصیر",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 225,
      "Position": "Right",
      "Text": "کچھ محبوں کا معتقد مت پوچھ",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 226,
      "Position": "Left",
      "Text": "ہے علی ہی ہوالعلی کبیر",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 227,
      "Position": "Right",
      "Text": "شان سے کہتے ہیں محیط کل",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 228,
      "Position": "Left",
      "Text": "قدر سے قادر و خداے قدیر",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 229,
      "Position": "Right",
      "Text": "تو موالی علی پرست نصیر",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 230,
      "Position": "Left",
      "Text": "چاہے سو ہم کو کہہ لے اب اے میرؔ",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 231,
      "Position": "Right",
      "Text": "ہم علی کو خدا نہیں جانا",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 232,
      "Position": "Left",
      "Text": "پر خدا سے جدا نہیں جانا",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    }
  ]
}
