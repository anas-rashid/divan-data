      "Text": "جو کہے سو یہ کچھ کرے سو یہ",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Single",
      "Text": "ہر نفس لب پہ گفتگو اس کی",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Single",
      "Text": "ہر زماں جی کو جستجو اس کی",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Single",
      "Text": "پوچھ مت کچھ ولا سے تو اس کی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Single",
      "Text": "خواہش اس کی ہے آرزو اس کی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Single",
      "Text": "مطلب و مدعا و مقصد وہ",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Single",
      "Text": "شان ارفع تری فلک کردار",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Single",
      "Text": "ایک ہے تو برابر دو ہزار",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Single",
      "Text": "اللہ اللہ ترا ثبات و قرار",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Single",
      "Text": "حلم سے تیرے کہتے تھے کہسار",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Single",
      "Text": "سن کے کبک دری ہنسے قہ قہ",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "دیکھے سب لوگ پھر کے چاروں دانگ",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Single",
      "Text": "مردمی یاں کی ہے عجائب سوانگ",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Single",
      "Text": "شخص ہمت کے ان کے ہاتھ نہ مانگ",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Single",
      "Text": "مانگے ہے تو جو کچھ خدا سے مانگ",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Single",
      "Text": "جو کہے ہے سو تو علی سے کہہ",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Single",
      "Text": "شاد اس نام سے جو خوگر ہے",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Single",
      "Text": "اسم اعظم یہی مقرر ہے",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Single",
      "Text": "انس کرنا اسی سے بہتر ہے",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Single",
      "Text": "یہی جنت یہی تو کوثر ہے",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Single",
      "Text": "اس میں تو پھر بگاہ یا بیگہ",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "خلق سب دیکھے اس کے ہاتھ کی اور",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Single",
      "Text": "لے سلیماں سے مفتقر تا مور",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Single",
      "Text": "کف ہمت کی اس کے دھوم ہے زور",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Single",
      "Text": "ظرف ہوتا تو یوں نہ کرتے شور",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Single",
      "Text": "بحر و عماں نکل گئے بے تہ",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Single",
      "Text": "ہے وہ امیدگاہ خلق خدا",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Single",
      "Text": "روز محشر اسی سے سب کو رجا",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Single",
      "Text": "وہ مروت شعار و جملہ حیا",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Single",
      "Text": "بحر ذخار جود و کان عطا",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Single",
      "Text": "اس سے نفع گدا تمتع شہ",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Single",
      "Text": "مرتبہ کچھ نہ پوچھو اس گھر کا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Single",
      "Text": "بندگی یاں کی فخر قیصر کا",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Single",
      "Text": "شاہ چیں پیش دست قنبر کا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Single",
      "Text": "آسماں ہے گدا اسی در کا",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Single",
      "Text": "دیکھتے ہیں ادھر ہی مہر و مہ",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Single",
      "Text": "اس کی ہمت اسی کو بن آوے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Single",
      "Text": "دولت اس کی جہان سب کھاوے",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Single",
      "Text": "بار اس در پہ جو گدا پاوے",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Single",
      "Text": "ایک آواز کرکے لے جاوے",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Single",
      "Text": "مال و اسباب و ملک و تاج و کلہ",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Single",
      "Text": "میرؔ عازم ہوئے ہو کیدھر کے",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Single",
      "Text": "جو تلاشی ہو یار و یاور کے",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Single",
      "Text": "رہگرے دوستی حیدر کے",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Single",
      "Text": "نہیں محتاج ہوتے رہبر کے",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "ہے اسی راہ میں خدا ہمرہ",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    }
  ]
