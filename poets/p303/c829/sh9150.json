    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "غم کہہ کے رلاتا ہوں میں سب کو",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "تجھ غم میں ہوا ہوں روضہ خواں میں",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "پائی نہ وفا کسی میں دیکھا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "غربال تمام کر جہاں میں",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بارے میں یہ سب دیار دیکھا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ہر کوچے کو بار بار دیکھا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "شب ہی عالم میں ہوگئی تھی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "اپنے دل کا غبار دیکھا",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "آنکھیں گئیں روتے روتے لیکن",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "تونے نہ ادھر کو یار دیکھا",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "اب وعدہ نہ کر زیادہ بس ہم",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "جاناں ترا اعتبار دیکھا",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "کہتے تھے یہ ہم نہ کر تمنا",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "اے جان امیدوار دیکھا",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "دامن میں گرا ہو ٹکڑے ٹکڑے",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "ہم نے جی کو فگار دیکھا",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "آنکھوں سے اٹھایا آبلوں کے",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "صحرا میں جدھر کو خار دیکھا",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "پوچھا نہ ہمارے بعد ہم کو",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "یارو یہ جہاں کا پیار دیکھا",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "مدت تئیں دید کر جہاں کا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "طرز و وضع و شعار دیکھا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "دیکھا تو ملا نہ کوئی ہم فن",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "دیکھے یہاں شیخ اور برہمن",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "عقل اول کو اک سنا تھا",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "نکلا سو معارضے میں کودن",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آنکھوں میں ٹھہر رہے ہیں آنسو",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "ہونٹھوں پہ دھرا رہے ہے شیون",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "شیوہ ہے ہمارا نالہ کرنا",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "یاں سے کچھ سیکھ مرغ گلشن",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "تجھ بن نہیں سانس اور کچھ ہے",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "چبھتا ہے جگر میں ہو کے سوزن",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "اے برق ادھر نہ آ ہمارے",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "ہر خوشے میں شعلوں کے ہیں خرمن",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "ہم وے ہیں کہ باغ کر دکھائیں",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "اشک گل گوں سے طرف دامن",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "سختی ایام کی جو کہیے",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "ہوویں ابھی موم سنگ و آہن",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "کیا تجھ سے سپہ گری جتاویں",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "گر خود و زرہ نہ ہو نہ جوشن",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "مجروح یہ ہیں گے ہم جو اڑ جائیں",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "بھاگے ابھی جان لے تہمتن",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "ایسے تو ہیں پر وفا میں ویسے",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "خوباں تم ہو جفا میں جیسے",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "پھر جاتے ہیں غیر اس سے ملنے",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "آتے نہیں باز ایسے تیسے",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "ہم رستم عشق ہیں گے کیونکر",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "منھ موڑیں ہزار پانسے سے",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "سرکش نہ ہو زیر چرخ ان نے",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "پامال کیے ہیں کیسے کیسے",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "ہے بندہ نواز ظلم مجھ پر",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "ہم نالہ نہ کر تو مجھ کو نے سے",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "گو موسم دے خنک ہو مجھ سے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "دل گرمی ہے مجھ کو زور مے سے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "ٹک دیکھ فلک نے شاہ خوباں",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "کیا کچھ کیا خاندان کے سے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "سر بیچے سو عشق میں رکھے پا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "واقف نہیں دل تو یاں کی رے سے",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "ہاتھوں میں مرے ہیں داغ خوباں",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "کہتے ہیں کہ اس کنے ہیں پیسے",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "کیا تجھ سے کہوں معاش اپنی",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "بارے گذرے ہے جیسے تیسے",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "رہتا ہے غرض ہمیشہ سودا",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "کوچہ کوچہ ہوا ہوں رسوا",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "وہ تشنہ دہن ہوں دل جلا ہوں",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "لب چش جس کا نہ ہووے دریا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "کہتے ہو جسے فلک ہوا ہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "میرے ہی غبار دل سے پیدا",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "کھلتا تو سہی کبھی بلا سے",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "دل میرا ہی کاش غنچہ ہوتا",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "اب جان سے جانا آرہا ہے",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "موقوف اشارۂ تقاضا",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "ہو جس کی خراب عاقبت بھی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "وہ میں ہوں کہ دین ہے نہ دنیا",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "میں ہوں کہ سرآمد جنوں ہوں",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "مجنوں کو خلیفہ میں کیا تھا",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "وہ خستہ ہوں میں ہی جس کو کہیے",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "رونق افزاے کوہ و صحرا",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "یہ کچھ جو کہہ گیا بتاں میں",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "خاطر میں تمھاری بھی کچھ آیا",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "یا یوں ہی بکا میں کچھ تو بولو",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "خواہاں ہو تو خامشی ہے یہ کیا",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "سودا نہیں کچھ وگرنہ مجھ کو",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "کرتا ہے کوئی زیان جی کا",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "گر اتنے پہ دل برا ہے میرا",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "موقوف کرو خدا ہے میرا",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "تم کو تو ہے کیا مرے ملے سے",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "پر اس میں بتاں بھلا ہے میرا",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "مرنے سے ڈرا نہ مجھ کو قاتل",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "جی دینا تو مدعا ہے میرا",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "زنہار حنا کہ اس کے پا پر",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "مدت سے یہ سر لگا ہے میرا",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "سودا بہ رضا ہے مل ہر اک سے",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "لگتا صنم اس میں کیا ہے میرا",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "یک نیم نگہ سے مول لے چک",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "ٹک دیکھ کہ یہ بہا ہے میرا",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "میں ہوں کہ ہلاہل الم سے",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "کٹ کٹ کے جگر گرا ہے میرا",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "جاؤ کہ رہو یہ جی جفا سے",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "کچھ ہو شیوہ وفا ہے میرا",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "کاکل کو نہ کھول الجھنے کو",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "دل زور ہی منچلا ہے میرا",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "جوں توں کرکے طپش سے شب کو",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "مژگاں پہ جگر رہا ہے میرا",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "کل تک تو مرا یہ دل بجا تھا",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "اپنا دلخواہ مدعا تھا",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "تھے جن و ملک جلو میں میری",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "اقبال مرا کوئی بلا تھا",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "تھا روے زمیں پہ شاد و خرم",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "کیا جانوں فلک کے جی میں کیا تھا",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "ایسا ہی نہ تھا بتو میں آگے",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "آخر کوئی میرا بھی خدا تھا",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "ہوتے جو شہید یک تمنا",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "سو سو طرفوں سے خوں بہا تھا",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "اک روز چنانچہ ہول دل سے",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "اندوہ تنک مجھے ہوا تھا",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "لوہو دیا اپنا دوستوں نے",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "جس جاگہ مرا عرق گرا تھا",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "ہوں اب جو بلا میں مبتلا میں",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "بیگانہ ہے جوکہ آشنا تھا",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "یہ رنج و بلا و درد و محنت",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "اے واے حواس و صبر و طاقت",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "ایدھر بھی کبھو ٹک ایک چشمک",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "ہم سے بھی ضرور ہے مروت",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "مت فرصت وقت سے ہو غافل",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "آخر کو نہ کھینچے تا خجالت",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "ہر آن میں اپنی تربیت کر",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "دیتا ہے زمانہ کس کو فرصت",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "غیروں کے رہوگے دیر تک تم",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 164,
      "Position": "Left",
      "Text": "ہم کو تو سویرے کرکے رخصت",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 165,
      "Position": "Right",
      "Text": "کیا تم سے کہیں سلوک ہجراں",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "دل میں نہ رکھی ہمارے حسرت",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "قطرہ تو ہے پر نہ ہاتھ اٹھاؤ",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "دریا کو کرے ہے یہ کفایت",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 169,
      "Position": "Right",
      "Text": "خالی دل پر کو ہم بھی کرتے",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 170,
      "Position": "Left",
      "Text": "افسوس نہ دی اجل نے فرصت",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 171,
      "Position": "Right",
      "Text": "بس میرا ہو تو کروں منادی",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 172,
      "Position": "Left",
      "Text": "کوئی نہ کرے کہیں محبت",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 173,
      "Position": "Right",
      "Text": "گردن ماریں شتابی اس کو",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 174,
      "Position": "Left",
      "Text": "رکھے جو کسی سے میرؔ الفت",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    }
  ]
}
