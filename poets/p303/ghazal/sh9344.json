      "RhymeLetters": null,
      "PlainText": "یار میرا بہت ہے یار فریب\r\nمکر ہے عہد سب قرار فریب\r\nراہ رکھتے ہیں اس کے دام سے صید\r\nہے بلا کوئی وہ شکار فریب\r\nعہدے سے نکلیں کس طرح عاشق\r\nایک ادا اس کی ہے ہزار فریب\r\nالتفات زمانہ پر مت جا\r\nمیرؔ دیتا ہے روزگار فریب",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
