      "Position": "Single",
      "Text": "رہا عابد سو اس پر یہ مصیبت",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "بدن میں زور تپ سے کچھ نہ طاقت",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "نگہ میں ناامیدی تنگ حالت",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "لبوں پر صدہزار افسوس و حسرت",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Single",
      "Text": "کہو کس کس کا اس کے نام لیجے",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Single",
      "Text": "موئے سب بھانجے بھائی بھتیجے",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Single",
      "Text": "رہا تھا یہ سو اس کو بندی کیجے",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Single",
      "Text": "بندھے وے ہاتھ جن پر بوسہ دیجے",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Single",
      "Text": "مہار اونٹوں کی اس کے ہاتھ میں تھی",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Single",
      "Text": "گلے میں طوق جس سے تھی غشی سی",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Single",
      "Text": "قدم رکھتا تو جاتا تھا چلا جی",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Single",
      "Text": "جگر اس کا ہی تھا چھاتی اسی کی",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Single",
      "Text": "اسیر و خستہ دل بے زور و زر تھا",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Single",
      "Text": "کٹا سر باپ کا پیش نظر تھا",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Single",
      "Text": "نہ یاور تھا نہ داور تھا نہ گھر تھا",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Single",
      "Text": "قیامت تھی غضب تھا شور و شر تھا",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Single",
      "Text": "کھنچا آیا پدرمردہ ستم کش",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Single",
      "Text": "ضعیف و ناتواں صدگونہ غم کش",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Single",
      "Text": "یتیم و بیکس و حیراں الم کش",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Single",
      "Text": "یہی کہتا تھا ہوتا بھی جو دم کش",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Single",
      "Text": "ادھر کلثوم کا نالیدن زار",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Single",
      "Text": "ادھر زینب کی غم سے چشم خونبار",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Single",
      "Text": "سکینہ باپ کو روتی تھی ہر بار",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Single",
      "Text": "کرے کیا لاعلاجی اور بیمار",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Single",
      "Text": "ہوا لاشے پہ شہ کے جو گذارا",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Single",
      "Text": "تن بے سر زمیں پر کر نظارہ",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Single",
      "Text": "کرے کیا قافلہ ناچار سارا",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Single",
      "Text": "کہا سب نے نہان و آشکارا",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Single",
      "Text": "نہ لکھ بس میرؔ بے طوری ایام",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Single",
      "Text": "سر اس صبح سعادت کا چلا شام",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Single",
      "Text": "گیا وہ جمع بھی ناچار ناکام",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Single",
      "Text": "نظر کر کہتے تھے سو بار ہر گام",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Single",
      "Text": "فآہا ثم آہا ثم آہا",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    }
  ]
}
