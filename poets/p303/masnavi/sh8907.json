      "VOrder": 49,
      "Position": "Right",
      "Text": "غارت ازبسکہ لشکری لائے",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "نعشوں سے اشرفی روپئے پائے",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "وہ جو بھاگا تھا معرکہ سے رئیس",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "بھاگا یوں جیسے پیش اسپ سئیس",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "ہوتے جو ہیں روہیلے ظلم شعار",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "لٹتے جاتے تھے شہر راہگذار",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "رام پور میں بھی آکے رہ نہ سکا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "وہ خداگیر بات کہہ نہ سکا",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "بھاگا واں سے ہے لے کے کچھ اسباب",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کہ لگا آیا لشکر نواب",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "لی پناہ ان نے جا کے زیر کوہ",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "واں بھی تھا ساتھ کوہ کوہ انبوہ",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "تھا پہاڑی کے آگے جنگل بھی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "وہیں ناکہ پہ تھا یہ دنگل بھی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "وھاں روہیلے ہوئے اکٹھے سب",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "بعد دو چار پنج روز و شب",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "عجز کی راہ سے کیا پیغام",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "ہم ہیں نواب کے کمینے غلام",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "بندے رہتے ہیں باوجود خطا",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "تم سے صاحب امیدوار عطا",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "لطف کریے امیدواروں پر",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "رحم کریے گناہگاروں پر",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ہم غلامی میں ہوتے ہیں حاضر",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "اب نہ خدمت سے ہوویں گے قاصر",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "کسو صاحب کو ہو حضور سے حکم",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "موجب طوع وہ ہے دور سے حکم",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "کہ مجھے اپنے ہاتھ لے جاوے",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "پاؤں کتنے کے عاجز آ پاوے",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "ذات نواب ہے کرم سیرت",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "کہا صاحب کو تم بصد عزت",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "معرفت اپنے جا کے لاؤ اسے",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "پاس خیمے میں لا بٹھاؤ اسے",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "یاکہ خیمہ جدا کرو استاد",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "ہم اسے وقت پر کریں گے یاد",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "لایا صاحب چنانچہ خود جاکر",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "پاس کرنا ہے تا نفر چاکر",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "سر میں اس کے خیال باطل تھا",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "آپ بھی وہ جوان جاہل تھا",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "گفتگو میں کجی لگا کرنے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "ہوا موجود مارنے مرنے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "چاہتا تھا کہ آپ کو مارے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "بارے ہتھیار چھن گئے سارے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "رفقا کے تئیں نکال دیا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "رنجہ کر ٹہلوؤں کو ٹال دیا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "اٹھ گئے جو حرام زادے تھے",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "ہو چکے دل میں جو ارادے تھے",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "عاقبت اس کو باندھ کر بھیجا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "کہا پلٹن سے لکھنؤ لے جا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "جمع تھے لوگ سو پریشاں ہیں",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "رہ گئے ہیں سو عجز کیشاں ہیں",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "جنگ کی صبح کے تئیں ہے نہ شام",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "آشتی کے ہیں اب پیام و سلام",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "غالباً صبح آج کل ہووے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "برطرف جملگی خلل ہووے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "لے کے اب ملک و مال سب نواب",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "راہ لیتے ہیں لکھنؤ کی شتاب",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "سال تاریخ کا تھا مجھ کو خیال",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "لطف کے رو سے کی ملک نے مقال",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "کاے سخن گستر و جہاں استاد",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "فتح نواب سے کر اب دل شاد",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "میرؔ کوئی غزل کہو اب تم",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "لذت شعر میں رہو خود گم",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Single",
      "Text": "غزل",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Right",
      "Text": "گرد سر پھر کے کرتے پہروں پاس",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Left",
      "Text": "سو تو ہم لوگ اس کے آس نہ پاس",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Right",
      "Text": "خط پہ خط بھیجتا تھا لکھوا کر",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "جب تلک یار تھا نہ حرف شناس",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Right",
      "Text": "دل نہ باہم ملے تو ہجراں ہے",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Left",
      "Text": "ہم وے رہتے ہیں گو کہ پاس ہی پاس",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Right",
      "Text": "عرش و دل میں رہے مگر برسوں",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "وہم ہے پر کہیں کہیں ہے قیاس",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Right",
      "Text": "ہے چلا جب سے وہ پریشاں ربط",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Left",
      "Text": "جمع اک دم رہے نہ میرے حواس",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Right",
      "Text": "ناامیدی بھی حد رکھتی ہے",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "جیتا کب تک رہے گا کوئی نراس",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Right",
      "Text": "جز خدا ہم کسو سے ڈرتے نہیں",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Left",
      "Text": "گھر ہمارا ہے واں جہاں ہے ہراس",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Right",
      "Text": "میں تو حیران کار ہوں بے ہوش",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Left",
      "Text": "کیونکے نکلے گی میرے دل کی بھڑاس",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Right",
      "Text": "میرؔ وحشی کا دل ہے بے طاقت",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Left",
      "Text": "چلتا پھرتا ہے پر اداس اداس",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Single",
      "Text": "غزل",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "رہے عمر بھر دیکھتے سادگاں کو",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "یہ جینے نہیں دیتے دل دادگاں کو",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "خبر قاصدوں کو نہیں اپنی شاید",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "بہت دور بھیجا فرستادگاں کو",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "عجب سادگاں میں ہے قشقوں کی خوبی",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "نہ ہو عجب کیوں برہمن زادگاں کو",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "نہال اور سرو اس کے حیراں کھڑے ہیں",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "کیا پاے گیر ان نے آزادگاں کو",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "رہے زیر دیوار ہم میرؔ برسوں",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "نہ پوچھا کبھی خاک افتادگاں کو",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    }
  ]
}
