    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "نے ثنا سے بطیں ہی ہیں تر لب",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "مرغ عیسیٰ ہیں مدح خواں ہر شب",
