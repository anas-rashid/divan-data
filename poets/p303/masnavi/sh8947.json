    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "ٹینی کے سر پہ آج ٹیکا ہے",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "اس کے آگے کنیل پھیکا ہے",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "کیا عجب ان کی رہگذر کا فرش",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "ہوں پرافشاں تو ہو خروس عرش",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "اڑ گیا حلق کا جو لڑتے پوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "کی صدا مرغ دوست نے ہے دوست",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "کیس اس رنگ ہوتے ہیں محسوس",
      "CoupletIndex": 16,
