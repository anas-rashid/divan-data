      "Text": "شیشہ شیشہ شراب ہے درکار",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "صحبت عیش کو چھکا یک بار",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "لالہ رنگ رخ نکویاں کو",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "مایۂ ناز خوب رویاں کو",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اس پری کو نکال شیشے سے",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "رنگ مجلس میں ڈال شیشے سے",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "ہوئے سرمست ہو تماشائی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "حکم کش ہے سپہر مینائی",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "چھوڑ آئین بردباری کا",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "سیر کرلے تزک سواری کا",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "چل گلابی کو ہاتھ میں لے لے",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "ایک دم جام متصل دے لے",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "ہے سواری کے فیل کی وہ دھوم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "جیسے ابر بہار آوے جھوم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "آئے دولت سرا سے ہو کے سوار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "لعل ناب و گہر ہیں صرف نثار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "اک مہابت کے ساتھ فیل نشاں",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "آگے مانند کوہ زر کے رواں",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "اور ہاتھی ہیں جھومتے جاتے",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "جیسے آویں جوان مدھ ماتے",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "جل زربفت کی ہے ساری شب",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "روکش انجم فلک ہیں سب",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "پلٹنیں جاتی ہیں برابر یوں",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "صف ہو مژگان دلبروں کی جوں",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "بال بستہ رکاب میں ہیں سرنگ",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "جن کے دیکھے کمیت چرخ ہے دنگ",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "خوش سواری و خوش جلو خوش راہ",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "باگ اچکی تو پھر نہ ٹھہری نگاہ",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "گردنوں میں پڑی حمائل گل",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "ہے جلو میں بصد شمائل گل",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "تھا بہت تیزگام اسپ خیال",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "رہ گیا دیکھ کر انھوں کی چال",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "تھے پری زاد چھیڑے اڑ جاویں",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "آنکھ پھیرو تو کل سے مڑ جاویں",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "کسمسانے میں باؤ سے آگے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "ہاں کہے جیسے وہم جا لاگے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "نوبتی اب طبیعتوں کو رجھاؤ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "چل سواری کا ٹک اصول بجاؤ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "چوب نقارے پر لگا اس ڈھب",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "کہ رکھیں گوش اس صدا پر سب",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "ایک دو دم بجائے جاؤ یوں ہی",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "دل کش آواز گائے جاؤ یوں ہی",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "پھینکتے ہیں جو دستہ دستہ گل",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "رہگذر میں ہیں رستہ رستہ گل",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "وہ جو دیوے تو کیا لیا جاوے",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "خوشہ خوشہ گہر دیا جاوے",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "ساقیا دے وہ مے جو باقی ہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "شادی ایسی بھی اتفاقی ہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "ہو مبارک یہ جشن خوش انجام",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "دور گردوں بہ کام عیش مدام",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "آ مغنی غزل سرائی کر",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "کچھ مزے سے بھی آشنائی کر",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "پڑھ غزل میرؔ کی جو ہووے یاد",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "ان کو تو اس میں کہتے ہیں استاد",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Single",
      "Text": "غزل",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Right",
      "Text": "موسم ابر ہو سبو بھی ہو",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Left",
      "Text": "گل ہو گلشن ہو اور تو بھی ہو",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Right",
      "Text": "کب تک آئینے کا یہ حسن قبول",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Left",
      "Text": "منھ ترا اس طرف کبھو بھی ہو",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Right",
      "Text": "ہو جو تیرا سا رنگ گل گاہے",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "ریجھیں ہم تب جب ایسی بو بھی ہو",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Right",
      "Text": "ہے غرض عشق صرف ہے لیکن",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Left",
      "Text": "شرط یہ ہے کہ جستجو بھی ہو",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Right",
      "Text": "سرکشی گل کی خوش نہیں آتی",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "ناز کرنے کو ویسا رو بھی ہو",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Right",
      "Text": "کس کو بلبل ہے دم کشی کا دماغ",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Left",
      "Text": "ہو تو گل ہی کی گفتگو بھی ہو",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Right",
      "Text": "دل تمناکدہ تو ہے پر میرؔ",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "ہو تو اس کی ہی آرزو بھی ہو",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    }
  ]
}
