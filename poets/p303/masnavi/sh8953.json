      "Position": "Single",
      "Text": "ہم بہت غم میں تیرے روویں گے",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Single",
      "Text": "بل کے بل اب خراب ہوویں گے",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "فخر ہے اپنی نسل کا یہ شیر",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Single",
      "Text": "جن نے گھونسوں کے کر دکھائے ڈھیر",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Single",
      "Text": "سنا ہے موش گربہ کا قصہ",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Single",
      "Text": "وہ جو ہے گا عبید کا حصہ",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Single",
      "Text": "جس کو باندھا عبید زاکانی",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Single",
      "Text": "لگتی تھی اس کی وہ سگی نانی",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Single",
      "Text": "گربہ تا بود فاسق و فاجر",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Single",
      "Text": "ق صید او یک بدے بہ سالانہ",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Single",
      "Text": "ایں زماں پنج پنج می گیرد",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Single",
      "Text": "کہ شدہ مومن و مسلمانا",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Single",
      "Text": "در تعریف مادۂ سگ",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "ہے جو وہ مادہ سگ تماشا ہے",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "دوڑ پڑنے کے وقت باشا ہے",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "کسی کے لقمے پر نہ منھ ڈالا",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "سگ اصحاب کہف کی خالہ",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "نہیں کتوں سی خوار یاں کے یہ",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "ہے سگوں میں عزیز خاں کے یہ",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "دے ہرن کو بھی جلدی میں بتا",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "ہے گا یاں سگ لوند کیا کتا",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "اڑتی چڑیا انھیں نے ماری ہے",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "استخوان سگ شکاری ہے",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "یہ جو غصے میں آوے تو ہے غضب",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "اس کے مارے ہوئے ہیں ہارے سب",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "منھ میں دیتے ہیں اس کے جب مشعل",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "طرفہ دم لابہ کرتی ہے اچپل",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "منھ میں اپنے لیے فتیلے سے",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "سگ لیلیٰ کے ہے قبیلے سے",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "باہم اس کتے بلی کا یہ ربط",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "کوئی دیکھے نہ ہووے اس سے ضبط",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Right",
      "Text": "کبھو جاتا جو ہے یہ کوٹھے پر",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "لگی رہتی ہے اس کی چھت سے نظر",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Right",
      "Text": "اور سے دشمنی جانی ہے",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Left",
      "Text": "اس کی یہ باؤلی دوانی ہے",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Right",
      "Text": "دونوں شوخی سے مار سہتے ہیں",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "سگ و گربہ کی چال رہتے ہیں",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    }
  ]
}
