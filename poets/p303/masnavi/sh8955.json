      "VOrder": 47,
      "Position": "Left",
      "Text": "دے بہار گذشتہ کو آواز",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Right",
      "Text": "گل و لالہ پہ چشم باز کرے",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Left",
      "Text": "رنگ صحبت کو دیکھ ناز کرے",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Right",
      "Text": "چھیڑ ساز طرب نوا کے تئیں",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Left",
      "Text": "باندھ آواز سے ہوا کے تئیں",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Right",
      "Text": "وجد میں لاؤ مے پرستوں کو",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Left",
      "Text": "یاد دے ٹک سرودمستوں کو",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Right",
      "Text": "آؤ ساقی کہ روشنی ہے خوب",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Left",
      "Text": "گرم عشرت ہیں ہر طرف محبوب",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Right",
      "Text": "نار مشعل نے نائرہ کھینچا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Left",
      "Text": "نور کو مہ نے دائرہ کھینچا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Right",
      "Text": "کثرت روشنی سے شب ہے روز",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Left",
      "Text": "خشت سیمیں ہے ماہ دل افروز",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Right",
      "Text": "صبح صادق کے منھ پہ کب ہے فروغ",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Left",
      "Text": "اس کو دعویٰ جو تھا وہ سب ہے دروغ",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "اب تو شیشہ شراب لا ساقی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "صحبت عیش کو چھکا ساقی",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "لاؤ رنگ رخ نکویاں کو",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "مایۂ ناز خوب رویاں کو",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "چاہیے ہے گلابی مئے ناب",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "جام ہے چشم روشنی کا باب",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "اس پری کو نکال شیشہ سے",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "رنگ مجلس میں ڈال شیشہ سے",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "لطف کر ٹک وہ دل کی آسائش",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "تا نظر آوے لطف آرائش",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "آؤ ساقی کہ ہوں تماشائی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "گرم خدمت ہے چرخ مینائی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "چل ہوائی سے شعلہ خیزی دیکھ",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "آسماں کی ستارہ ریزی دیکھ",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "متصل چھوٹتے جو ہیں گے انار",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "راہ و رستے ہوئے ہیں باغ و بہار",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "عشق ہے تازہ کار آتش باز",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "پھول گل میں ہے رنگ رنگ اعجاز",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "دیکھ صنعت گری صنعت گر",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "گل کاغذ ہے غیرت گل تر",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "دیکھ ساقی تزک سواری کا",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "چھوڑ آئین بردباری کا",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "چل گلابی کو ہاتھ میں لے لے",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "ایک دو جام متصل دے لے",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "فیل یوں ہیں گے جھومتے جاتے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "جیسے آویں جوان مدھ ماتے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "نوبتی اپنی اپنی نوبت ہے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "صرف کر جو ہنر کی طاقت ہے",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Right",
      "Text": "دور ہے اب سپہر کا دلخواہ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "ہیں وضیع و شریف سب ہمراہ",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Right",
      "Text": "آ سواری کا ٹک اصول بجاؤ",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Left",
      "Text": "طبع موزون اہتزاز میں لاؤ",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Right",
      "Text": "ساتھ راجا سوار ہوتا ہے",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "شہر باغ و بہار ہوتا ہے",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Right",
      "Text": "جل زربفت سے ہے فیل و نشاں",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Left",
      "Text": "آگے مانند کوہ زر کے رواں",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Right",
      "Text": "زور گوہر نثار کرتے ہیں",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "خلق کو مایہ دار کرتے ہیں",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Right",
      "Text": "دیوے راجا تو کیا لیا چاہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Left",
      "Text": "خوشہ خوشہ گہر دیا چاہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Right",
      "Text": "پھینکتے ہیں جو دستہ دستہ گل",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Left",
      "Text": "رہگذر میں ہیں رستہ رستہ گل",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Right",
      "Text": "برق پارہ جو جستہ جستہ ہیں",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Left",
      "Text": "سینکڑوں ویسے بال بستہ ہیں",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Right",
      "Text": "گردنوں میں پڑیں حمائل گل",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Left",
      "Text": "ہیں جلو میں بصد شمائل گل",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Right",
      "Text": "لاؤ ساقی گل گلاب شراب",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Left",
      "Text": "دے مجھے اب کہیں شتاب شراب",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Right",
      "Text": "ہے شگفتہ دماغ دل وا ہے",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Left",
      "Text": "نشہ اس عیش کا دوبالا ہے",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Right",
      "Text": "رائے صاحب لباس زر در بر",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Left",
      "Text": "نشۂ عیش و دلکشی در سر",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Right",
      "Text": "زیر راں ایک اسپ خوش رفتار",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "گرم رفتن ہو تو ہے برق شعار",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Right",
      "Text": "خوش سواری و خوش جلو خوش راہ",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Left",
      "Text": "چھیڑ دیجے تو پھر نہ ٹھہرے نگاہ",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Right",
      "Text": "کسمسانے میں ران کے اڑ جائے",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "ہاتھ ہلتے میں جیسے کل مڑ جائے",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Right",
      "Text": "ہے تو گلگوں بہار کا خوش رنگ",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Left",
      "Text": "کام ہے اس پہ اس کے حسن سے تنگ",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Right",
      "Text": "دوردو ہے اگرچہ اسپ خیال",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "بھول جاتا ہے اس کے آگے چال",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Right",
      "Text": "ہیں مرصع جو اس کی زین و لگام",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Left",
      "Text": "چشم کرتی ہے خیرگی ہر گام",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Right",
      "Text": "باگ اس کی جو ٹک اچک جائے",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Left",
      "Text": "پارۂ برق سا چمک جائے",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Right",
      "Text": "دے نہ وہ شیشہ اب جو باقی ہے",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Left",
      "Text": "حسن ایسا بھی اتفاقی ہے",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Right",
      "Text": "جب سے ہے اس جہاں کی آبادی",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Left",
      "Text": "تب سے ایسی نہیں ہوئی شادی",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Right",
      "Text": "ہو مبارک یہ جشن خوش انجام",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Left",
      "Text": "دور گردوں بہ کام عیش مدام",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Right",
      "Text": "آؤ ساقی پڑھیں غزل کوئی",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Left",
      "Text": "درمیاں اب نہیں خلل کوئی",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Single",
      "Text": "غزل",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "موسم ابر ہے سبو بھی ہو",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "گل ہو گلشن ہو ایک تو بھی ہو",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "کب تک آئینہ کا یہ حسن قبول",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "منھ ترا اس طرف کبھو بھی ہو",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "کس کو بلبل ہے دم کشی کا دماغ",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "ہو تو گل ہی کی گفتگو بھی ہو",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "ہے غرض عشق صرف ہے لیکن",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "شرط ہے یہ کہ جستجو بھی ہو",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "ہو جو تیرا سا رنگ گل گاہے",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "ریجھیں ہم تب جب ایسی بو بھی ہو",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "دل تمناکدہ تو ہے پر یھاں",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "ہو تو تیری ہی آرزو بھی ہو",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "سرکشی گل کی خوش نہیں آتی",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "ناز کرنے کو ویسا رو بھی ہو",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "پا سکے اس کمر کو دست شوق",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "جو نمایاں بقدر مو بھی ہو",
      "CoupletIndex": 76,
