      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "شادیاں بے شگوں سراسر ہیں",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "کوچے سو شہر کے برابر ہیں",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "دست دستور ہے جو زرافشاں",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "پھر جہان کہن ہوا ہے جواں",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Right",
      "Text": "دونوں رستے عمارت خوش ہے",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Left",
      "Text": "تازہ کاری شہر دلکش ہے",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "اور بازاری رنگ لائے ہیں",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "سارے رنگیں ستوں لگائے ہیں",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Right",
      "Text": "جس طرف دیکھو معرکہ سا ہے",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Left",
      "Text": "شہر ہے یا کوئی تماشا ہے",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Right",
      "Text": "چشم بد دور ایسی بستی سے",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Left",
      "Text": "یہی مقصد ہے ملک ہستی سے",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Right",
      "Text": "لکھنؤ دلی سے بھی بہتر ہے",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Left",
      "Text": "کہ کسو دل کی لاگ ایدھر ہے",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Right",
      "Text": "آئیں بستہ ہوا ہے سارا شہر",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Left",
      "Text": "کاغذیں گل سے گلستاں ہے دہر",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Right",
      "Text": "ایسے گل پھول ہیں جو صرف کار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Left",
      "Text": "راہ رستے ہوئے ہیں باغ و بہار",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Right",
      "Text": "بستہ آئیں دکانیں ہیں یکسر",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Left",
      "Text": "جن میں سستی متاع لعل و گہر",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Right",
      "Text": "میوۂ نورس و رسیدہ بہت",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Left",
      "Text": "گل خوش رنگ و بوے چیدہ بہت",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "شب شادی کو لڑکے ہوں جو سوار",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "لیں صغیر و کبیر بہر نثار",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "تخت بہر زنان رقص کناں",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "چنے رستوں میں بے چنیں و چناں",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "گل کاغذ سے شہر ہے گلزار",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "توکہے آئی ہے بہار اے یار",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "ساقیا عیش کا ہو بزم آرا",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "سارے لوگوں میں جام مے کو پھرا",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "جس میں تہ پاوے اس پری کو دے",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "ورنہ شیشے کی شیشے میں رکھ لے",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "ہوگی مجلس جو مست آسائش",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "کون دیکھے گا لطف آرائش",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "آؤ ساقی قرار ہے باہم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "کہ تماشاکناں پھریں خرم",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "زن رقاص پر نگاہ کریں",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "کسو سادے سے چل کے راہ کریں",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "کسو دلبر کے کھینچ لیویں ہاتھ",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "کسو محبوب کو اٹھالیں ساتھ",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "کسو خوش رو کے منھ پہ منھ رکھ لیں",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کنج لب کا کہیں مزہ چکھ لیں",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "خوش تنوں سے کریں ہم آغوشی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "کسو نازک بدن سے ہم دوشی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "کہیں دو جام مے سے ہوں سرمست",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "جائیں گے تھوڑی دور دست بہ دست",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "مچلے بن جائیں گے کسو کو دیکھ",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "پھر منیں گے کسو کے رو کو دیکھ",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "اب گلابی کو لیں گے بھر بھر ہم",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "باقی ساقی پئیں گے پھر کر ہم",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "کہیں آرائش آ کے دیکھیں گے",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "کاغذیں باغ جا کے دیکھیں گے",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "کسو مہوش سے ہوویں گے گل باز",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "کھینچیں گے ایک دو دم اس کے ناز",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "آؤ ساقی مئے دوآتشہ دے",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "اسی مے کا بغل میں شیشہ لے",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "گرم ہو جو دماغ انساں کا",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "لطف آوے نظر چراغاں کا",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "جس طرف دیکھیے چراغاں ہے",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "شیشہ و شمع ہی نمایاں ہے",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "باغ سے روشنی ہوئی ہے زیاد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "ہے یہ ہنگامہ تا جلال آباد",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "شمع و فانوس کا بہت ہے ہجوم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "شمعی رنگوں نے کر رکھی ہے دھوم",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "لوٹیے ان گلوں کی اب تو بہار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "گو کسو کے گلے کا ہوجیے ہار",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "اب تو اودھم ہی مچ گیا ہر سو",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "دارو پی کر پھریں چلیں ہم تو",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "تارے سے ہیں چراغ چار طرف",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "آسماں پر زمیں رکھے ہے شرف",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "غنچہ غنچہ دیوں کو دیکھیں جہاں",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "کسو نوگل سے رکھیں صحبت واں",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "کہیں نوبت کو چل کے سنیے گا",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "نے کے بجنے پہ سر کو دھنیے گا",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "نوبتی خوش سلیقے سارے ہیں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "نے نوازوں نے جان مارے ہیں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "آج نوبت کے بجنے پر ہے رنگ",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "عقل ہوتی ہے سن ٹکورے دنگ",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "جھانجھ کے سننے کی رہی ہے جھانجھ",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "صبح جوں توں کے ہم کریں ہیں سانجھ",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "بیچ میں ہولی آئی ہے ساقی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "پھیرے سرخوش ہیں تابکے ساقی",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "شیشہ شیشہ شراب اب پیجے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "بلکہ خم منھ لگا کے سب پیجے",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "سیر کریے کنار نہر و گشت",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "لالہ و گل کھلے ہیں تا سر دشت",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "انھیں پھولوں کے انعکاس سے آب",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "توکہے لالہ رنگ سب ہے شراب",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "سبد گل ہوئی ہے ہر کیاری",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "ایک ہے گل زمیں زمیں ساری",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "درمیاں اک شجر نہیں بدبرگ",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "ہے ہزارہ کہ لالۂ صدبرگ",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "جوش لالہ سے تا النگ و سنگ",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "شفقی ہوگیا ہوا کا رنگ",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "تخت کیونکر نہ ہو دماغ خاک",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "دشت در دشت ہے گل تریاک",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "پھر لبالب ہیں آب گیر رنگ",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "اور اڑے ہے گلال کس کس ڈھنگ",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "پاس آتے ہیں مرغ گلشن بھول",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "تھے وے دلبر گلاب کے سے پھول",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "زعفرانی لباس تھے سب کے",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "رسمسے آئے صبح کو شب کے",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "پگڑیاں جامے بھیگے سو سو ہیں",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "ان کو گل ہاے تر کہیں تو ہیں",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "چھڑیاں پھولوں کی دلبروں کے ہاتھ",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "سیکڑوں پھولوں کی چھڑی سے ساتھ",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "قمقمے جو گلال کے مارے",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "مہوشاں لالہ رخ ہوئے سارے",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "خوان بھر بھر عبیر لاتے ہیں",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "گل کی پتی ملا اڑاتے ہیں",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "جشن نوروز ہند ہولی ہے",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "راگ رنگ اور بولی ٹھولی ہے",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "عشق ہے اے گروہ آتش زن",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "دونوں رستے چراغ ہیں روشن",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "ٹھاٹھ کیا روشنی کے باندھ دیے",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "شہر میں نام روشن اپنے کیے",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "دوردو تھے خیال و سوانگ آئے",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "گھوڑے دامن سوار کیا لائے",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "روشنی وار سے ہے پار تلک",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "گل کا کاغذ ہے فرق خار تلک",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "در دولت سے لے کے تا سر آب",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "ہے چراغ اور شمع ہی کی تاب",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "پھر سر پل سے تا عمارت نو",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "جلتے ہیں مجتمع دیے سو سو",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "ہاتھی رنگے گئے پڑی ہے دھوم",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "جیسے ابر سیاہ آئے جھوم",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "خیمہ استادہ کرچکے شب باز",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "پتلیوں نے کیا خرام ناز",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "یاں کی صحبت کا تھا نمونہ سب",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "شاہ دستور حکم و کار ادب",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "آئے شکلیں بنا کے صورت باز",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "ڈوم ڈھاڑی بنے بجا کر ساز",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "نقل معقول کی سو حاجی بنے",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "سج کے عمامے سر پہ کتنے جنے",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "کوئی جوگی کوئی فقیر بنا",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "کوئی ڈاڑھی لگا کے پیر بنا",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "کوئی بنیا بنا کوئی اوباش",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "نقل کرنی تھی ان سبھوں کی معاش",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "کوئی شاعر بنا نہ جس کی نظیر",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "جیسے مستغرق خیال تھا میرؔ",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "کچھ سپاہی بنے تھے کچھ تجار",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "کوئی زاہد ہوا کوئی خمار",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "جس کی تقلید کی سو ویسی طرح",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "اصل ہوتی نہیں ہے ایسی طرح",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "کرکے سعی و تلاش چاروں دانگ",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "خوب دیکھا تو ہے یہ عالم سوانگ",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "آؤ ساقی نہ رکھ خراب احوال",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "دیے جا جام بادہ مالامال",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "چل سواری کا سیر بھی ہے بڑا",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "ایک عالم ہے دونوں رستہ کھڑا",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "جل زربفت پوش فیل نشاں",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "کوہ زر سا ہے پیش پیش رواں",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "کدخدا ہونے کو چلا دولہ",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "یال گوپال عظم سے جوں شہ",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "گل کی پاکھر پڑی ہوئی یک بار",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "ہاتھی آیا بہ رنگ ابر بہار",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "زری پوشوں کا پیش و پس انبوہ",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "اللہ اللہ ری ان کی شان و شکوہ",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "قور میں کتنے سونے کے سے پہاڑ",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 164,
      "Position": "Left",
      "Text": "آگے روپے کے روشنی کے جھاڑ",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 165,
      "Position": "Right",
      "Text": "موتی کرتے تھے ہر طرف سے نثار",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "تھا مگر فیل ابر گوہربار",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "ہیں جلو میں زمینیاں حاضر",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "جاہ کے آسمانیاں حاضر",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 169,
      "Position": "Right",
      "Text": "عمدہ سب ساتھ ہیں وزیر سمیت",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 170,
      "Position": "Left",
      "Text": "شاعراں مدح خواں ہیں میرؔ سمیت",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 171,
      "Position": "Right",
      "Text": "تازی ترکی عراقی و عربی",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 172,
      "Position": "Left",
      "Text": "کوتل آگے تھے خوش جلو میں سبھی",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 173,
      "Position": "Right",
      "Text": "رہ میں رکھ لو جہاں کہ منھ کے نرم",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 174,
      "Position": "Left",
      "Text": "چھیڑے باد سموم سے ہوں گرم",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 175,
      "Position": "Right",
      "Text": "آؤ ساقی پلا شراب ہمیں",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 176,
      "Position": "Left",
      "Text": "روشنی کی نہیں ہے تاب ہمیں",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 177,
      "Position": "Right",
      "Text": "روشنی بھی ہے کوئی ہنگامہ",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 178,
      "Position": "Left",
      "Text": "سیر میں گرم ہوگیا جامہ",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 179,
      "Position": "Right",
      "Text": "گرمی سے مشعلوں کی آئے تنگ",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 180,
      "Position": "Left",
      "Text": "دود مشعل ہے جاے کاہی رنگ",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 181,
      "Position": "Right",
      "Text": "دو طرف سیم بندی کردی ہے",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 182,
      "Position": "Left",
      "Text": "سونے روپے سے راہ بھر دی ہے",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 183,
      "Position": "Right",
      "Text": "شمعیں لاکھوں کنول میں ہیں روشن",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 184,
      "Position": "Left",
      "Text": "زور پھولا ہے کاغذیں گلشن",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 185,
      "Position": "Right",
      "Text": "واہ آتش زنان آتش دست",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 186,
      "Position": "Left",
      "Text": "دارو پی کر پھرو ہو کیسے مست",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 187,
      "Position": "Right",
      "Text": "توپیں کیا ڈھالیں ہیں ستاروں کی",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 188,
      "Position": "Left",
      "Text": "کھوئی رونق فلک کے تاروں کی",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 189,
      "Position": "Right",
      "Text": "تارے موقوف کچھ سما پہ نہیں",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 190,
      "Position": "Left",
      "Text": "توپیں چھوٹیں مگر ہوا پہ نہیں",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 191,
      "Position": "Right",
      "Text": "ماہ بھی چشم روشنی کے لیے",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 192,
      "Position": "Left",
      "Text": "ہے چراغاں ستارگاں سے کیے",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 193,
      "Position": "Right",
      "Text": "گنج چھوٹے ہیں یاکہ باڑ جھڑی",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 194,
      "Position": "Left",
      "Text": "یا ہوائی ہے جگنیوں کی چھڑی",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 195,
      "Position": "Right",
      "Text": "گل فشاں ہیں پڑی جو پھل جھڑیاں",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 196,
      "Position": "Left",
      "Text": "کھلتیاں ہیں دلوں کی گل جھڑیاں",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 197,
      "Position": "Right",
      "Text": "چھوٹتے ہیں انار و مہتابی",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 198,
      "Position": "Left",
      "Text": "رنگ ہیں دلبروں کے مہتابی",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 199,
      "Position": "Right",
      "Text": "باؤ سے دو دیے ہوئے گر ماند",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 200,
      "Position": "Left",
      "Text": "دغیں مہتابیاں کہ نکلے چاند",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 201,
      "Position": "Right",
      "Text": "آؤ اے مطربان سیرآہنگ",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 202,
      "Position": "Left",
      "Text": "ساتھ اپنے لیے رباب و چنگ",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 203,
      "Position": "Right",
      "Text": "ہو غزل خوان بزم عیش و طرب",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 204,
      "Position": "Left",
      "Text": "پر نہ کریو خیال ترک ادب",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 205,
      "Position": "Right",
      "Text": "منعقد مجلس شہانہ ہے",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 206,
      "Position": "Left",
      "Text": "ادب آصف زمانہ ہے",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 207,
      "Position": "Right",
      "Text": "آؤ ساقی مجھے قرابہ دے",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 208,
      "Position": "Left",
      "Text": "در بغل شیشہ ساتھ اپنے لے",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 209,
      "Position": "Right",
      "Text": "بحر بخشش کی لہریں اب آئیں",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 210,
      "Position": "Left",
      "Text": "زر و گوہر کی کشتیاں لائیں",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 211,
      "Position": "Right",
      "Text": "ہے بلند اس کرم کا کیا پایہ",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 212,
      "Position": "Left",
      "Text": "دیتے ہیں خلعت گراں مایہ",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 213,
      "Position": "Right",
      "Text": "طرہ ہاے زری و بادلہ تاس",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 214,
      "Position": "Left",
      "Text": "تختہ ہاے دوشالہ تحفہ لباس",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 215,
      "Position": "Right",
      "Text": "بہت ان میں سیے بہت نہ سیے",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 216,
      "Position": "Left",
      "Text": "ایک دم میں سبھوں کو بخش دیے",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 217,
      "Position": "Right",
      "Text": "خاص ملبوس نوع نوع تمام",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 218,
      "Position": "Left",
      "Text": "لے گئے شاد بھر کے مردم عام",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 219,
      "Position": "Right",
      "Text": "کیا بچھا ہے فراخ دسترخوان",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 220,
      "Position": "Left",
      "Text": "جس پہ ہے خلق یک جہاں مہمان",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 221,
      "Position": "Right",
      "Text": "تورہ بندی ہوئی تکلف سے",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 222,
      "Position": "Left",
      "Text": "کھانے نکلے نئے تصرف سے",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 223,
      "Position": "Right",
      "Text": "لطف کے ساتھ نعمتوں کا وفور",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 224,
      "Position": "Left",
      "Text": "زیر ہر جعبہ قاب ہے پرنور",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 225,
      "Position": "Right",
      "Text": "عام تھا ان لطافتوں سے طعام",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 226,
      "Position": "Left",
      "Text": "دیتے لیتے تھے ہر سحر ہر شام",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 227,
      "Position": "Right",
      "Text": "کس کو اسباب یہ میسر ہیں",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 228,
      "Position": "Left",
      "Text": "ظرف سیمین جعبۂ زر ہیں",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 229,
      "Position": "Right",
      "Text": "ہیں جو مہمان پادشاہ و گدا",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 230,
      "Position": "Left",
      "Text": "حرص دونوں کی سیر ہے یکجا",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 231,
      "Position": "Right",
      "Text": "عمر و دولت ہو اس کی حد سے زیاد",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 232,
      "Position": "Left",
      "Text": "ہے اسی سے جہاں نشاط آباد",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 233,
      "Position": "Right",
      "Text": "آؤ ساقی غزل سرا بھی ہو",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 234,
      "Position": "Left",
      "Text": "لذت شعر سے مزہ بھی ہو",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 235,
      "Position": "Single",
      "Text": "غزل",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 236,
      "Position": "Right",
      "Text": "اب کی بہار کیا کیا دریا پہ رنگ لائی",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 237,
      "Position": "Left",
      "Text": "یک شہر نکلے لالہ پھر اس میں ہولی آئی",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 238,
      "Position": "Right",
      "Text": "کی فکر سال تاریخ آواز غیب آئی",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 239,
      "Position": "Left",
      "Text": "ہم نے کبھو ندیکھی اس رنگ کدخدائی",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 240,
      "Position": "Right",
      "Text": "آنکھوں کی روشنی تھی اپنی ہوئی دوچنداں",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 241,
      "Position": "Left",
      "Text": "طالع نے چاندنی میں کیا روشنی دکھائی",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 242,
      "Position": "Right",
      "Text": "ہو باد جس طرف کی آنکھیں ادھر ہیں اس کی",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 243,
      "Position": "Left",
      "Text": "نرگس کا اس ہوا میں دیدہ بھی ہے ہوائی",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 244,
      "Position": "Right",
      "Text": "بے گل رہے نہ یک دم بلبل کے آہ و نالے",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 245,
      "Position": "Left",
      "Text": "محبوب سے کسو کو یارب نہ ہو جدائی",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 246,
      "Position": "Right",
      "Text": "گل تک ہنسا نہ مجھ سے بلبل نہ بولی ہرگز",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 247,
      "Position": "Left",
      "Text": "کس کس کی بے دماغی بے یار میں اٹھائی",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 248,
      "Position": "Right",
      "Text": "ہم بھی رہے ہوا وہ جب تک جوان جاہل",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 249,
      "Position": "Left",
      "Text": "کی عمر رفتنی نے بارے نہ بے وفائی",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 250,
      "Position": "Right",
      "Text": "اخواں زمانہ کے تو کیا جانیں دل لگی کو",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 251,
      "Position": "Left",
      "Text": "لگتی ہے جس کے دل کو وہ جانتا ہے بھائی",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 252,
      "Position": "Right",
      "Text": "ہے دام گاہ دنیا ہر جا فریب اس میں",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 253,
      "Position": "Left",
      "Text": "دیتی نہیں دکھائی اپنی مجھے رہائی",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 254,
      "Position": "Right",
      "Text": "گذری جو کچھ سو گذری یاری میں دلبروں کی",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 255,
      "Position": "Left",
      "Text": "میرؔ اب کسو سے تم تو کریو نہ آشنائی",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    }
  ]
}
