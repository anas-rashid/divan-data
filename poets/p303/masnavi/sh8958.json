    {
      "VOrder": 27,
      "Position": "Right",
      "Text": "سنگ سے پھر لعل نکلا بے بہا",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Left",
      "Text": "یعنی وہ دل جملگی خوں ہوگیا",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
