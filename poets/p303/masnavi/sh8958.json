      "Position": "Left",
      "Text": "ست بمعنی استقامت واقعی",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "آگ میں جا بیٹھے زن کا ظرف کیا",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "عشق ہی کا جاذبہ دے ہے جلا",
