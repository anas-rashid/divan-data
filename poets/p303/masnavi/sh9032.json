      "VOrder": 28,
      "Position": "Left",
      "Text": "آتی ہے صدا اسی کی نے میں",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Right",
      "Text": "ہے جلوہ گری میں یاں بصد ناز",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "وہ مست گزارہ و سرانداز",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "سو رنگ ہیں اس کے یاد رکھ تو",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Left",
      "Text": "ہر جلوہ سے دل کو شاد رکھ تو",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Right",
      "Text": "عالم میں جو کچھ نمود میں ہے",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Left",
      "Text": "ہر لحظہ اسے سجود میں ہے",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Right",
      "Text": "کر یاد اسی کو اور مے پی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Left",
      "Text": "جیتا رہے کوئی دن تو خوش جی",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "اب روے سخن چمن کو کریے",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "میناے دل اور مے سے بھریے",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "آئی ہے بہار مے گساراں",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "پھولے ہیں چمن میں گل ہزاراں",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "آئی ہے بہار و ہر خیاباں",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "ہے لطف ہوا سے گل بہ داماں",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "آئی ہے بہار زہدکیشاں",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "ہے توبۂ بادہ دل پریشاں",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "آئی ہے بہار مرغ گلزار",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "کرتا ہے نواے سینہ افگار",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "لایا ہے بہ زور اس کا نالہ",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "مجھ کو بھی براے سیر لالہ",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "ساقی جو کروں میں بے ادائی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "معذور رکھ اب بہار آئی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "گل باد صبا کے تا کمر ہے",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "دامان بلند ابر تر ہے",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "غنچہ کی گلابیاں بھری ہیں",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "تکلیف کی منتظر دھری ہیں",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "ظالم مئے ناب دے ہوا ہے",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "یک جرعہ شراب دے ہوا ہے",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "ہر سر میں ہے شور فصل دے کا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "جھمکے ہے ہوا سے رنگ مے کا",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "اطراف چمن کھلا ہے لالہ",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "ہر پھول شراب کا ہے پیالہ",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "آیا ہے چمن پہ ابر جوشاں",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "آب رخ کار سبزپوشاں",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "تحریک نسیم دم بہ دم ہے",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "تکلیف ہواے گل ستم ہے",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "ابروں نے بھی کی ہے مے پرستی",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "اٹھتے ہیں بصد سیاہ مستی",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "بوندوں کا جو لگ رہا ہے جھمکا",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "رنگ گل و لالہ زور چمکا",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "ہے گل کی ہوا سبو کشی میں",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "بلبل کا دماغ بوکشی میں",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "ہر شاخ ہے شوخ جام در دست",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "نرگس ہے کسو کی نرگس مست",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ہے رنگ ہوا کا آفتابی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "جھومیں ہیں نہال جوں شرابی",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "ہے سرو جوان نشہ در سر",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "لوٹے ہے روش پہ سبزۂ تر",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "چشمک کرے ہے حباب جو کا",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "یعنی کہ ہے دور اب سبو کا",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "ساقی قدحے کہ ذوق مل ہے",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "مطرب غزلے کہ فصل گل ہے",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Single",
      "Text": "غزل",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "شب وہ جو پیے شراب نکلا",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "جانا یہ کہ آفتاب نکلا",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "قربان پیالۂ مئے ناب",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "جس سے کہ ترا حجاب نکلا",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "تجھ بن جو پیا تھا قرط مے کا",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "آنکھوں سے ہو خون ناب نکلا",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "مستی میں شراب کی جو دیکھا",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "عالم یہ تمام خواب نکلا",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Right",
      "Text": "شیخ آتے تو مے کدے میں آیا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "پر ہو کے بہت خراب نکلا",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Right",
      "Text": "یک جرعہ شراب ہی میں واعظ",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Left",
      "Text": "ہر مسخرگی کا باب نکلا",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Right",
      "Text": "تھا غیرت بادہ عکس گل سے",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "جس جوے چمن سے آب نکلا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Right",
      "Text": "ہو صرف شراب کاش ساقی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Left",
      "Text": "یہ شیشۂ عمر ہے جو باقی",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Right",
      "Text": "بے ساغر مے خنک ہے جینا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "رکھتا ہے شگوں شراب پینا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Right",
      "Text": "لا بادۂ کہنہ سال نو ہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Left",
      "Text": "سجادہ بھی بابت گرو ہے",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Right",
      "Text": "دروازۂ مے کدہ کھلا ہے",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Left",
      "Text": "ہر پیر و جواں کو الصلا ہے",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Right",
      "Text": "اینڈے ہے ہر ایک مست جوں تاک",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Left",
      "Text": "لیتے نہیں نام دامن پاک",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Right",
      "Text": "ہر مغبچہ فتنہ زیر سر ہے",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Left",
      "Text": "ہر گوشے میں عالم دگر ہے",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Right",
      "Text": "مستی نگاہ عقل دشمن",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Left",
      "Text": "خوبی خرام مرد افگن",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Right",
      "Text": "کہتے گئے صاحب کرامات",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Left",
      "Text": "ہم ہی نہیں قابل خرابات",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Right",
      "Text": "جو لوگ کہ اس جگہ سے اٹھے",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Left",
      "Text": "کب حلقہ و خانقہ سے اٹھے",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Right",
      "Text": "یاں پیتے ہیں جام بے خودی کا",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "ہے دور تمام بے خودی کا",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Right",
      "Text": "مستی سے ہر ایک صبح صد بار",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Left",
      "Text": "خورشید کا سر ہے اور دیوار",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Right",
      "Text": "ہے قابل سیر خرقہ پوشاں",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "دریا دلی شراب نوشاں",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Right",
      "Text": "ان لوگوں کی ہر کمینہ صف میں",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Left",
      "Text": "کشتی ہے شہ و گدا کی کف میں",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Right",
      "Text": "ہر کوچے میں رہتی تھی منادی",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "تا رسم خردوری اٹھا دی",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Right",
      "Text": "از خود شدن اک مقام ہے گا",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Left",
      "Text": "وہ مرتبہ یاں مدام ہے گا",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Right",
      "Text": "ہرچند ہے دور پر کہاں تک",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Left",
      "Text": "اک لغزش پا میں یاں سے واں تک",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Right",
      "Text": "بے خود ہو کہ یہ حجاب اٹھے",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Left",
      "Text": "دل یاں سے کہیں شتاب اٹھے",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Right",
      "Text": "پہنچیں ہیں فنا کو بے خودی سے",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Left",
      "Text": "پاتے ہیں خدا کو بے خودی سے",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Right",
      "Text": "پی جرعہ و ہوش کو دعا کہہ",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Left",
      "Text": "ہر بادہ فروش کو دعا کہہ",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Right",
      "Text": "وشش میں ہے بادۂ کہن سال",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Left",
      "Text": "عبرت ہو جسے خوش اس کا احوال",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Right",
      "Text": "اب دل میں مرے بھی جوش آیا",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Left",
      "Text": "اب وقت وداع ہوش آیا",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Right",
      "Text": "کھینچوں میں کہاں تلک دم سرد",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Left",
      "Text": "ساقی وہ شراب شعلہ پرورد",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Right",
      "Text": "وہ داروے درد بے حضوراں",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Left",
      "Text": "وہ مایۂ نور چشم کوراں",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Right",
      "Text": "سرمایۂ عمر جاودانی",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Left",
      "Text": "یعنی وہی آب زندگانی",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Right",
      "Text": "وہ میوۂ خوش رسیدہ بارے",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Left",
      "Text": "وہ عیش دل گزیدہ بارے",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Right",
      "Text": "آئینۂ حسن خودپسنداں",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Left",
      "Text": "زینت دہ عنبریں کمنداں",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Right",
      "Text": "وہ رنگ رخ بہار یعنی",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Left",
      "Text": "وہ بادۂ خوش گوار یعنی",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Right",
      "Text": "یاقوت گداز دادۂ عشق",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Left",
      "Text": "یعنی وہی جام بادۂ عشق",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Right",
      "Text": "وہ لطف ہوا وہ سیر مہتاب",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Left",
      "Text": "وہ شعلۂ غوطہ خورد در آب",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Right",
      "Text": "وہ کام دل سبو بدوشاں",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Left",
      "Text": "یعنی کہ وہی شراب جوشاں",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Right",
      "Text": "وہ موجب دل خوشی کہاں ہے",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Left",
      "Text": "وہ داروے بے ہشی کہاں ہے",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 158,
      "Position": "Right",
      "Text": "وہ جس کی طرف کو ہے تہ دل",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 159,
      "Position": "Left",
      "Text": "یعنی وہی ماہ شیشہ منزل",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 160,
      "Position": "Right",
      "Text": "وہ آتش تیز آب آمیز",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 161,
      "Position": "Left",
      "Text": "وہ عربدہ جو وہ فتنہ انگیز",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 162,
      "Position": "Right",
      "Text": "وہ مقصد جان ناامیداں",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 163,
      "Position": "Left",
      "Text": "وہ روسیہی روسفیداں",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 164,
      "Position": "Right",
      "Text": "وہ رونق کارگاہ شیشہ",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 165,
      "Position": "Left",
      "Text": "وہ شوکت بارگاہ شیشہ",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 166,
      "Position": "Right",
      "Text": "وہ جس سے ہے توبہ موپریشاں",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 167,
      "Position": "Left",
      "Text": "وہ جس سے ہو گفتگو پریشاں",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 168,
      "Position": "Right",
      "Text": "وہ دامن خشک جس سے جل جائے",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 169,
      "Position": "Left",
      "Text": "ثابت قدموں کا پاؤں چل جائے",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 170,
      "Position": "Right",
      "Text": "وہ سرخی چشم خوب رویاں",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 171,
      "Position": "Left",
      "Text": "اسباب خرابی نکویاں",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 172,
      "Position": "Right",
      "Text": "وہ دلبر خودسر و شلائیں",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 173,
      "Position": "Left",
      "Text": "وہ رہزن راہ دین و آئیں",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 174,
      "Position": "Right",
      "Text": "وہ جس سے غبار دل سے دھوؤں",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 175,
      "Position": "Left",
      "Text": "مینا کے گلے سے لگ کے روؤں",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 176,
      "Position": "Right",
      "Text": "مستی کی مجھے بھی خواہشیں ہیں",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 177,
      "Position": "Left",
      "Text": "اس عقل سے دل کو کاہشیں ہیں",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 178,
      "Position": "Right",
      "Text": "لا اس کو جو آستین جھاڑوں",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 179,
      "Position": "Left",
      "Text": "پھر ہاتھ چلے تو جیب پھاڑوں",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 180,
      "Position": "Right",
      "Text": "بے ہوش شراب ناب رہیے",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 181,
      "Position": "Left",
      "Text": "یوں تا بہ کجا کباب رہیے",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 182,
      "Position": "Right",
      "Text": "ہے مستی بے خودی ضروری",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 183,
      "Position": "Left",
      "Text": "کھل جائے مقام بے شعوری",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 184,
      "Position": "Right",
      "Text": "دل غم سے بھرا ہے زور میرا",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 185,
      "Position": "Left",
      "Text": "تا عرش گیا ہے شور میرا",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 186,
      "Position": "Right",
      "Text": "ہے دل میں کہ گل کی اور رو ہو",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 187,
      "Position": "Left",
      "Text": "شیشہ ہو بغل میں اور تو ہو",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 188,
      "Position": "Right",
      "Text": "ہر گام پہ لغزش قدم ہو",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 189,
      "Position": "Left",
      "Text": "تکلیف شراب دم بہ دم ہو",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 190,
      "Position": "Right",
      "Text": "جب سجدہ کناں ہوں صبح خیزاں",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 191,
      "Position": "Left",
      "Text": "جب کاکل صبح ہو پریشاں",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 192,
      "Position": "Right",
      "Text": "جب نکلے ستارۂ سحرگہ",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 193,
      "Position": "Left",
      "Text": "کر نعرۂ الصبوح یک رہ",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 194,
      "Position": "Right",
      "Text": "ہے ذوق شراب صبح گاہی",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 195,
      "Position": "Left",
      "Text": "بے لطف نہیں ہے روسیاہی",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 196,
      "Position": "Right",
      "Text": "جب ہووے نشہ ترنگ آوے",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 197,
      "Position": "Left",
      "Text": "مستی مجھے باغ میں لٹاوے",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 198,
      "Position": "Right",
      "Text": "شیشہ مرے منھ کو تو لگاوے",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 199,
      "Position": "Left",
      "Text": "کر ایسی نگاہ جو چھکاوے",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 200,
      "Position": "Right",
      "Text": "جب بے خودی تمام آوے",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 201,
      "Position": "Left",
      "Text": "سر پر مرے ہوش رو کے جاوے",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 202,
      "Position": "Right",
      "Text": "رخصت ہے تجھے کہ میں نہ ہوں گا",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 203,
      "Position": "Left",
      "Text": "بے ہوش و خرد ہی پھر رہوں گا",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 204,
      "Position": "Right",
      "Text": "بیٹھا تو کروں گا شکر تیرا",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 205,
      "Position": "Left",
      "Text": "ہو ورنہ قبول عذر میرا",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 206,
      "Position": "Single",
      "Text": "مقولۂ شاعر",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 207,
      "Position": "Right",
      "Text": "کیا میرؔ شراب تونے پی ہے",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 208,
      "Position": "Left",
      "Text": "بیہودہ یہ گفتگو جو کی ہے",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 209,
      "Position": "Right",
      "Text": "یا آب سیہ ترے قلم نے",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 210,
      "Position": "Left",
      "Text": "یہ تجھ سے عجب کیا ہے ہم نے",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 211,
      "Position": "Right",
      "Text": "تو کاہے کو اتنا ہرزہ گو تھا",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 212,
      "Position": "Left",
      "Text": "کب در گرو شراب تو تھا",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 213,
      "Position": "Right",
      "Text": "بس مے سے زباں کو اب نہ تر کر",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 214,
      "Position": "Left",
      "Text": "مستی سخن پہ ٹک نظر کر",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 215,
      "Position": "Right",
      "Text": "ہے نشۂ سامعہ دوبالا",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 216,
      "Position": "Left",
      "Text": "پھر حرف نہ جائے گا سنبھالا",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    }
  ]
}
