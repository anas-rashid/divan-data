      "VOrder": 69,
      "Position": "Left",
      "Text": "یا لکھوں پاکیزہ اس صحبت کا داب",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "نکلی مستعمل نہایت ورنہ شب",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "چاندنی کی جاے بچھتی ماہتاب",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "گر نہ ہو ممدوح علم ظاہری",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "پر نہیں ہوتی ہے یہ رائے صواب",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "جو کہے تو چاہیے وہ لکھ رکھیں",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "حرف ہر یک تیرے منھ کا ہے کتاب",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "کر دعا پر میرؔ اب ختم سخن",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "تو کہے جو کچھ کرے حق مستجاب",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "زیردست اس کے رہیں گردن کشاں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "تا قیامت وہ رہے مالک رقاب",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "دوست اس کے جوش زن جیسے محیط",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "خاک بر سر مدعی جیسے سراب",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    }
  ]
}
