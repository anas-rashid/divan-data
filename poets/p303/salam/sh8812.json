      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Right",
      "Text": "مر گئے پر اب نہ تربت نے کفن",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Left",
      "Text": "السلام اے کشتۂ تیغ جفا",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
