      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بس دل کا غبار دھو چکے ہم\r\nرونا تھا جو کچھ سو رو چکے ہم\r\nتم خواب میں بھی نہ آئے پھر ہائے\r\nکیا خواب میں عمر کھو چکے ہم\r\nہونے کی رکھیں توقع اب خاک\r\nہونا تھا جو کچھ سو ہو چکے ہم\r\nکہسار پہ چل کے روئیے اب\r\nصحرا تو بہت ڈبو چکے ہم\r\nپھر چھیڑا حسنؔ نے اپنا قصہ\r\nبس آج کی شب بھی سو چکے ہم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
