  "Poems": [
    {
      "Id": 9456,
      "Title": "آہ میں بے قرار کس کا ہوں",
      "FullUrl": "/p306/ghazal/sh9456"
    },
    {
      "Id": 9457,
      "Title": "اپنے نالے میں گر اثر ہوتا",
      "FullUrl": "/p306/ghazal/sh9457"
    },
    {
      "Id": 9458,
      "Title": "اگر میں جانتا ہے عشق میں دھڑکا جدائی کا",
      "FullUrl": "/p306/ghazal/sh9458"
    },
    {
      "Id": 9459,
      "Title": "ترا ہم نے جس کو طلب گار دیکھا",
      "FullUrl": "/p306/ghazal/sh9459"
    },
    {
      "Id": 9460,
      "Title": "تو ہم سے جو ہم شراب ہوگا",
      "FullUrl": "/p306/ghazal/sh9460"
    },
    {
      "Id": 9461,
      "Title": "جتنا کوئی تجھ سے یار ہوگا",
      "FullUrl": "/p306/ghazal/sh9461"
    },
    {
      "Id": 9462,
      "Title": "جس کا تجھ سا حبیب ہووے گا",
      "FullUrl": "/p306/ghazal/sh9462"
    },
    {
      "Id": 9463,
      "Title": "جو ہم سے تو ملا کرے گا",
      "FullUrl": "/p306/ghazal/sh9463"
    },
    {
      "Id": 9464,
      "Title": "حسن کی گر زکوٰۃ پاؤں میں",
      "FullUrl": "/p306/ghazal/sh9464"
    },
    {
      "Id": 9465,
      "Title": "عشاق تیرے سب تھے پر زار تھا سو میں تھا",
      "FullUrl": "/p306/ghazal/sh9465"
    },
    {
      "Id": 9466,
      "Title": "غمزۂ چشم شرمسار کہاں",
      "FullUrl": "/p306/ghazal/sh9466"
    },
    {
      "Id": 9467,
      "Title": "محبت منہ پہ کرنا اور دل میں بے وفائی ہے",
      "FullUrl": "/p306/ghazal/sh9467"
    },
    {
      "Id": 9468,
      "Title": "ناصحو دل کس کنے ہے کس کو سمجھاتے ہو تم",
      "FullUrl": "/p306/ghazal/sh9468"
    },
    {
      "Id": 9469,
      "Title": "پاس رہ کر دیکھنا تیرا بڑا ارمان ہے",
      "FullUrl": "/p306/ghazal/sh9469"
    },
    {
      "Id": 9470,
      "Title": "کعبے ہی کا اب قصد یہ گمراہ کرے گا",
      "FullUrl": "/p306/ghazal/sh9470"
    },
    {
      "Id": 9471,
      "Title": "ہمیں کون پوچھے ہے صاحبو نہ سوال میں نہ جواب میں",
      "FullUrl": "/p306/ghazal/sh9471"
    },
    {
      "Id": 9472,
      "Title": "یہ تیرا عشق کب کا آشنا تھا",
      "FullUrl": "/p306/ghazal/sh9472"
    }
  ]
}
