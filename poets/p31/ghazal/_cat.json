  "Poems": [
    {
      "Id": 717,
      "Title": "جو تصور سے ماورا نہ ہوا",
      "FullUrl": "/p31/ghazal/sh717"
    },
    {
      "Id": 713,
      "Title": "اب دل کو ہم نے بندۂ جاناں بنا دیا",
      "FullUrl": "/p31/ghazal/sh713"
    },
    {
      "Id": 714,
      "Title": "اسیروں میں بھی ہو جائیں جو کچھ آشفتہ سر پیدا",
      "FullUrl": "/p31/ghazal/sh714"
    },
    {
      "Id": 715,
      "Title": "اف کیا مزا ملا ستم روزگار میں",
      "FullUrl": "/p31/ghazal/sh715"
    },
    {
      "Id": 720,
      "Title": "زنداں نصیب ہوں مرے قابو میں سر نہیں",
      "FullUrl": "/p31/ghazal/sh720"
    },
    {
      "Id": 722,
      "Title": "نہ رہا ذوق رنگ و بو مجھ کو",
      "FullUrl": "/p31/ghazal/sh722"
    },
    {
      "Id": 725,
      "Title": "کہاں طاقت یہ روسی کو کہاں ہمت یہ جرمن کو",
      "FullUrl": "/p31/ghazal/sh725"
    },
    {
      "Id": 727,
      "Title": "یہ عطر بیزیاں نہیں نسیم نوبہار کی",
      "FullUrl": "/p31/ghazal/sh727"
    },
    {
      "Id": 719,
      "Title": "زبانوں پر نہیں اب طور کا فسانہ برسوں سے",
      "FullUrl": "/p31/ghazal/sh719"
    },
    {
      "Id": 716,
      "Title": "انجام وفا بھی دیکھ لیا اب کس لیے سر خم ہوتا ہے",
      "FullUrl": "/p31/ghazal/sh716"
    },
    {
      "Id": 724,
      "Title": "پیغام رہائی دیا ہر چند قضا نے",
      "FullUrl": "/p31/ghazal/sh724"
    },
    {
      "Id": 723,
      "Title": "وہ سامنے جب آ جاتے ہیں سکتے کا سا عالم ہوتا ہے",
      "FullUrl": "/p31/ghazal/sh723"
    },
    {
      "Id": 718,
      "Title": "حسن فطرت کی آبرو مجھ سے",
      "FullUrl": "/p31/ghazal/sh718"
    },
    {
      "Id": 721,
      "Title": "صدا فریاد کی آئے کہیں سے",
      "FullUrl": "/p31/ghazal/sh721"
    }
  ]
}
