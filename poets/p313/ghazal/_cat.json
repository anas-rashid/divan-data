    },
    {
      "Id": 9549,
      "Title": "مے و ساقی ہیں سب یکجا اَہاہاہا اَہاہاہا",
      "FullUrl": "/p313/ghazal/sh9549"
    },
    {
      "Id": 9550,
      "Title": "مے پئے مست ہے سرشار کہاں جاتا ہے",
      "FullUrl": "/p313/ghazal/sh9550"
    },
    {
      "Id": 9551,
      "Title": "مے کدے میں جو ترے حسن کا مذکور ہوا",
