  "Poems": [
    {
      "Id": 9486,
      "Title": "آ تیری گلی میں مر گئے ہم",
      "FullUrl": "/p313/ghazal/sh9486"
    },
    {
      "Id": 9487,
      "Title": "آنے دو اپنے پاس مجھ کو",
      "FullUrl": "/p313/ghazal/sh9487"
    },
    {
      "Id": 9488,
      "Title": "آہ اے یار کیا کروں تجھ بن",
      "FullUrl": "/p313/ghazal/sh9488"
    },
    {
      "Id": 9489,
      "Title": "آہ ملتے ہی پھر جدائی کی",
      "FullUrl": "/p313/ghazal/sh9489"
    },
    {
      "Id": 9490,
      "Title": "اب تک مرے احوال سے واں بے خبری ہے",
      "FullUrl": "/p313/ghazal/sh9490"
    },
    {
      "Id": 9491,
      "Title": "اس ستم گر سے جو ملا ہوگا",
      "FullUrl": "/p313/ghazal/sh9491"
    },
    {
      "Id": 9492,
      "Title": "انجمن ساز عیش تو ہے یہاں",
      "FullUrl": "/p313/ghazal/sh9492"
    },
    {
      "Id": 9493,
      "Title": "اوروں کی بات یاں بہت کم ہے",
      "FullUrl": "/p313/ghazal/sh9493"
    },
    {
      "Id": 9494,
      "Title": "اٹھ کے لوگوں سے کنارے آئیے",
      "FullUrl": "/p313/ghazal/sh9494"
    },
    {
      "Id": 9495,
      "Title": "ایک دن مدتوں میں آئے ہو",
      "FullUrl": "/p313/ghazal/sh9495"
    },
    {
      "Id": 9496,
      "Title": "ایک دن وصل سے اپنے مجھے تم شاد کرو",
      "FullUrl": "/p313/ghazal/sh9496"
    },
    {
      "Id": 9497,
      "Title": "اے شمع دل افروز شب تار محبت",
      "FullUrl": "/p313/ghazal/sh9497"
    },
    {
      "Id": 9498,
      "Title": "بھرے موتی ہیں گویا تجھ دہن میں",
      "FullUrl": "/p313/ghazal/sh9498"
    },
    {
      "Id": 9499,
      "Title": "بہار گلشن ایام ہوں میں",
      "FullUrl": "/p313/ghazal/sh9499"
    },
    {
      "Id": 9500,
      "Title": "بیدارؔ کروں کس سے میں اظہار محبت",
      "FullUrl": "/p313/ghazal/sh9500"
    },
    {
      "Id": 9501,
      "Title": "بے مروت بے وفا نامہرباں نا آشنا",
      "FullUrl": "/p313/ghazal/sh9501"
    },
    {
      "Id": 9502,
      "Title": "تجھ بن آرام جاں کہاں ہے مجھے",
      "FullUrl": "/p313/ghazal/sh9502"
    },
    {
      "Id": 9503,
      "Title": "تجھ بن سرشک خوں کا ہے آنکھوں سے طغیاں اس قدر",
      "FullUrl": "/p313/ghazal/sh9503"
    },
    {
      "Id": 9504,
      "Title": "تم کو کہتے ہیں کہ عاشق کی فغاں سنتے ہو",
      "FullUrl": "/p313/ghazal/sh9504"
    },
    {
      "Id": 9505,
      "Title": "تنہا نہ دل ہی لشکر غم دیکھ ٹل گیا",
      "FullUrl": "/p313/ghazal/sh9505"
    },
    {
      "Id": 9506,
      "Title": "تو نے جو کچھ کہ کیا میرے دل زار کے ساتھ",
      "FullUrl": "/p313/ghazal/sh9506"
    },
    {
      "Id": 9507,
      "Title": "تیرے حیرت زدگاں اور کہاں جاتے ہیں",
      "FullUrl": "/p313/ghazal/sh9507"
    },
    {
      "Id": 9508,
      "Title": "تیرے مژگاں ہی نہ پہلو مارتے ہیں تیرے",
      "FullUrl": "/p313/ghazal/sh9508"
    },
    {
      "Id": 9509,
      "Title": "تیرے کوچہ سے نہ یہ شیفتگاں جاتے ہیں",
      "FullUrl": "/p313/ghazal/sh9509"
    },
    {
      "Id": 9510,
      "Title": "جاتا ہے مرے گھر سے دل دار خدا حافظ",
      "FullUrl": "/p313/ghazal/sh9510"
    },
    {
      "Id": 9511,
      "Title": "جانوں میں نہ جبکہ نام اس کا",
      "FullUrl": "/p313/ghazal/sh9511"
    },
    {
      "Id": 9512,
      "Title": "جب تک کہ دل نہ لاگا ان بے مروتوں سے",
      "FullUrl": "/p313/ghazal/sh9512"
    },
    {
      "Id": 9513,
      "Title": "جس دن تم آ کے ہم سے ہم آغوش ہو گئے",
      "FullUrl": "/p313/ghazal/sh9513"
    },
    {
      "Id": 9514,
      "Title": "جس وقت تو بے نقاب آوے",
      "FullUrl": "/p313/ghazal/sh9514"
    },
    {
      "Id": 9515,
      "Title": "جلوہ دکھا کے گزرا وہ نور دیدگاں کا",
      "FullUrl": "/p313/ghazal/sh9515"
    },
    {
      "Id": 9516,
      "Title": "جو تو ہو پاس تو دیکھوں بہار آنکھوں سے",
      "FullUrl": "/p313/ghazal/sh9516"
    },
    {
      "Id": 9517,
      "Title": "جو وہ بہار عذار خوبی چمن میں آتا خرام کرتا",
      "FullUrl": "/p313/ghazal/sh9517"
    },
    {
      "Id": 9518,
      "Title": "جو کچھ کہ تھا وظائف و اوراد رہ گیا",
      "FullUrl": "/p313/ghazal/sh9518"
    },
    {
      "Id": 9519,
      "Title": "جو ہوئی سو ہوئی جانے دو ملو بسم اللہ",
      "FullUrl": "/p313/ghazal/sh9519"
    },
    {
      "Id": 9520,
      "Title": "حسن سرشار ترا داروۓ بے ہوشی ہے",
      "FullUrl": "/p313/ghazal/sh9520"
    },
    {
      "Id": 9521,
      "Title": "حسن ہر نونہال رکھتا ہے",
      "FullUrl": "/p313/ghazal/sh9521"
    },
    {
      "Id": 9522,
      "Title": "حصول فقر گر چاہے تو چھوڑ اسباب دنیا کو",
      "FullUrl": "/p313/ghazal/sh9522"
    },
    {
      "Id": 9523,
      "Title": "حیف ہے ایسی زندگانی پر",
      "FullUrl": "/p313/ghazal/sh9523"
    },
    {
      "Id": 9524,
      "Title": "خاک عاشق ہے جو ہووے ہے نثار دامن",
      "FullUrl": "/p313/ghazal/sh9524"
    },
    {
      "Id": 9525,
      "Title": "خرقہ رہن شراب کرتا ہوں",
      "FullUrl": "/p313/ghazal/sh9525"
    },
    {
      "Id": 9526,
      "Title": "دل سلامت اگر اپنا ہے تو دل دار بہت",
      "FullUrl": "/p313/ghazal/sh9526"
    },
    {
      "Id": 9527,
      "Title": "دل سے پوچھا تو کہاں ہے تو کہا تجھ کو کیا",
      "FullUrl": "/p313/ghazal/sh9527"
    },
    {
      "Id": 9528,
      "Title": "دل کو میں آج ناصحاں اس کو دیا جو ہو سو ہو",
      "FullUrl": "/p313/ghazal/sh9528"
    },
    {
      "Id": 9529,
      "Title": "دور سے بات خوش نہیں آتی",
      "FullUrl": "/p313/ghazal/sh9529"
    },
    {
      "Id": 9530,
      "Title": "دیتا نہیں دل لے کے وہ مغرور کسی کا",
      "FullUrl": "/p313/ghazal/sh9530"
    },
    {
      "Id": 9531,
      "Title": "دیکھ اس پری سے کیجئے کیا اب تو جا لگی",
      "FullUrl": "/p313/ghazal/sh9531"
    },
    {
      "Id": 9532,
      "Title": "زاہد اس راہ نہ آ مست ہیں مے خوار کئی",
      "FullUrl": "/p313/ghazal/sh9532"
    },
    {
      "Id": 9533,
      "Title": "سبھوں سے یوں تو ہے دل آپ کا خوش",
      "FullUrl": "/p313/ghazal/sh9533"
    },
    {
      "Id": 9534,
      "Title": "شبنم تو باغ میں ہے نہ یوں چشم تر کہ ہم",
