    },
    {
      "Id": 9552,
      "Title": "نشہ میں جی چاہتا ہے بوسہ بازی کیجئے",
      "FullUrl": "/p313/ghazal/sh9552"
    },
    {
      "Id": 9553,
      "Title": "نہ دیا اس کوں یا دیا قاصد",
      "FullUrl": "/p313/ghazal/sh9553"
    },
    {
      "Id": 9554,
      "Title": "نہ غم دل نہ فکر جاں ہے یاد",
