    },
    {
      "Id": 9536,
      "Title": "عاشق نہ اگر وفا کرے گا",
      "FullUrl": "/p313/ghazal/sh9536"
    },
    {
      "Id": 9537,
      "Title": "غم جگر شکن و درد جاں ستاں دیکھا",
      "FullUrl": "/p313/ghazal/sh9537"
    },
    {
      "Id": 9538,
      "Title": "فقط قضیہ یہی ہے فن طبعی اور الٰہی میں",
      "FullUrl": "/p313/ghazal/sh9538"
    },
    {
      "Id": 9539,
      "Title": "قاصد اس کا پیام کچھ بھی ہے",
