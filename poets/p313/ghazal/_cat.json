      "Title": "گیا ہے جب سے دکھا جلوہ وہ پری رخسار",
      "FullUrl": "/p313/ghazal/sh9571"
    },
    {
      "Id": 9572,
      "Title": "ہم تری خاطر نازک سے خطر کرتے ہیں",
      "FullUrl": "/p313/ghazal/sh9572"
    },
    {
      "Id": 9573,
      "Title": "ہم پہ سو ظلم و ستم کیجئے گا",
      "FullUrl": "/p313/ghazal/sh9573"
    },
    {
      "Id": 9574,
      "Title": "ہم ہی تنہا نہ تری چشم کے بیمار ہوئے",
      "FullUrl": "/p313/ghazal/sh9574"
    },
    {
      "Id": 9575,
      "Title": "یا رب جو خار غم ہیں جلا دے انہوں کے تئیں",
      "FullUrl": "/p313/ghazal/sh9575"
    },
    {
      "Id": 9576,
      "Title": "یوں مجھ پہ جفا ہزار کیجو",
      "FullUrl": "/p313/ghazal/sh9576"
    },
    {
      "Id": 9577,
      "Title": "یہ بھی کوئی وضع آنے کی ہے جو آتے ہو تم",
      "FullUrl": "/p313/ghazal/sh9577"
    }
  ]
