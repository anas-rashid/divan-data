    },
    {
      "Id": 9559,
      "Title": "چمن لالہ یہ الفت تری دکھلاتی ہے",
      "FullUrl": "/p313/ghazal/sh9559"
    },
    {
      "Id": 9560,
      "Title": "کل وہ جو پئے شکار نکلا",
      "FullUrl": "/p313/ghazal/sh9560"
    },
    {
      "Id": 9561,
      "Title": "کوئی کس طرح تم سے سر بر ہو",
