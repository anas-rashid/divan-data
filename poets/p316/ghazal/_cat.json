  "Poems": [
    {
      "Id": 9603,
      "Title": "غیروں کو بھلا سمجھے اور مجھ کو برا جانا",
      "FullUrl": "/p316/ghazal/sh9603",
      "RadifLetter": "ا"
    },
    {
      "Id": 9612,
      "Title": "کل نشے میں تھا وہ بت مسجد میں گر آ جاتا",
      "FullUrl": "/p316/ghazal/sh9612",
      "RadifLetter": "ا"
    },
    {
      "Id": 9592,
      "Title": "اس کے جو جو کہ فوائد ہیں خود دیکھتے جاؤ",
      "FullUrl": "/p316/ghazal/sh9592",
      "RadifLetter": "ا"
    },
    {
      "Id": 9607,
      "Title": "نہ وہ نالوں کی شورش ہے نہ غل ہے آہ و زاری کا",
      "FullUrl": "/p316/ghazal/sh9607",
      "RadifLetter": "ا"
    },
    {
      "Id": 9593,
      "Title": "اس کے نبھنے کے کچھ نہیں اسباب",
      "FullUrl": "/p316/ghazal/sh9593",
      "RadifLetter": "ب"
    },
    {
      "Id": 9604,
      "Title": "مانگیں نہ ہم بہشت نہ ہو واں اگر شراب",
      "FullUrl": "/p316/ghazal/sh9604",
      "RadifLetter": "ب"
    },
    {
      "Id": 9594,
      "Title": "ایک سے ربط ایک سے ہے بگاڑ",
      "FullUrl": "/p316/ghazal/sh9594",
      "RadifLetter": "ڑ"
    },
    {
      "Id": 9598,
      "Title": "حرف تم اپنی نزاکت پہ نہ لانا ہرگز",
      "FullUrl": "/p316/ghazal/sh9598",
      "RadifLetter": "ز"
    },
    {
      "Id": 9591,
      "Title": "اثر آہ کا گر دکھائیں گے ہم",
      "FullUrl": "/p316/ghazal/sh9591",
      "RadifLetter": "م"
    },
    {
      "Id": 9605,
      "Title": "میرے دل میں تو ہر زماں ہو تم",
      "FullUrl": "/p316/ghazal/sh9605",
      "RadifLetter": "م"
    },
    {
      "Id": 9616,
      "Title": "یہ جو چپکے سے آئے بیٹھے ہیں",
      "FullUrl": "/p316/ghazal/sh9616",
      "RadifLetter": "ن"
    },
    {
      "Id": 9595,
      "Title": "بس کہ اک جنس رائیگاں ہوں میں",
      "FullUrl": "/p316/ghazal/sh9595",
      "RadifLetter": "ن"
    },
    {
      "Id": 9599,
      "Title": "خانماں سوز ماسوا ہوں میں",
      "FullUrl": "/p316/ghazal/sh9599",
      "RadifLetter": "ن"
    },
    {
      "Id": 9613,
      "Title": "گریباں چاک ہیں گل بوستاں میں",
      "FullUrl": "/p316/ghazal/sh9613",
      "RadifLetter": "ن"
    },
    {
      "Id": 9610,
      "Title": "وہ کہاں جلوۂ جاں بخش بتان دہلی",
      "FullUrl": "/p316/ghazal/sh9610",
      "RadifLetter": "ی"
    },
    {
      "Id": 9614,
      "Title": "ہم اپنا جو قصہ سنانے لگے",
      "FullUrl": "/p316/ghazal/sh9614",
      "RadifLetter": "ے"
    },
    {
      "Id": 9609,
      "Title": "نیچی نظروں کے وار آنے لگے",
      "FullUrl": "/p316/ghazal/sh9609",
      "RadifLetter": "ے"
    },
    {
      "Id": 9608,
      "Title": "نہ کیوں تیر نظر گزرے جگر سے",
      "FullUrl": "/p316/ghazal/sh9608",
      "RadifLetter": "ے"
    },
    {
      "Id": 9602,
      "Title": "سر کو تن سے مرے جدا کیجے",
      "FullUrl": "/p316/ghazal/sh9602",
      "RadifLetter": "ے"
    }
  ]
}
