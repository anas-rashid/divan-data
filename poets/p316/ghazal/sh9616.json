      "VOrder": 37,
      "Position": "Right",
      "Text": "طور جس آگ نے جلایا تھا",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "ہم وہ دل میں چھپائے بیٹھے ہیں",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "چشمکیں غیر سے دکھا دیں گے",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "ہم بھی آنکھیں لڑائے بیٹھے ہیں",
