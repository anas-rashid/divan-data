    {
      "VOrder": 30,
      "Position": "Left",
      "Text": "وہ بھی محفل میں آئے بیٹھے ہیں",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Right",
      "Text": "شوخیاں خود ہیں پردہ در ان کی",
