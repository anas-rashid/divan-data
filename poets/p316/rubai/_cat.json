      "Id": 9601,
      "Title": "زوروں پہ ہے روز ناتوانی میری",
      "FullUrl": "/p316/rubai/sh9601"
    },
    {
      "Id": 9600,
      "Title": "رہبان کا قیس کا محبوب ہے تو",
      "FullUrl": "/p316/rubai/sh9600"
    },
    {
      "Id": 9606,
      "Title": "میں خاک تھا آدمی بنایا تو نے",
      "FullUrl": "/p316/rubai/sh9606"
    },
    {
      "Id": 9596,
      "Title": "جو نخل ہو خشک اس کا پھلنا کیا ہے",
      "FullUrl": "/p316/rubai/sh9596"
    },
    {
      "Id": 9597,
      "Title": "جو ہے سو پست سب سے عالی تو ہے",
      "FullUrl": "/p316/rubai/sh9597"
    },
    {
      "Id": 9615,
      "Title": "ہے ان کی نزاکتوں کا پانا مشکل کیا کیجے بیاں",
      "FullUrl": "/p316/rubai/sh9615"
    },
    {
      "Id": 9611,
      "Title": "چلنے کا تو ہو گیا بہانہ تم کو",
      "FullUrl": "/p316/rubai/sh9611"
    }
