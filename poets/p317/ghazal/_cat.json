  "Poems": [
    {
      "Id": 9643,
      "Title": "ہر غم میں کریم ہے ہمارا",
      "FullUrl": "/p317/ghazal/sh9643"
    },
    {
      "Id": 9620,
      "Title": "بے قراروں کو کب قرار آیا",
      "FullUrl": "/p317/ghazal/sh9620"
    },
    {
      "Id": 9618,
      "Title": "اثر ایسا ہے تپ غم میں دوا کا الٹا",
      "FullUrl": "/p317/ghazal/sh9618"
    },
    {
      "Id": 9635,
      "Title": "نظر کسی کو وہ موئے کمر نہیں آتا",
      "FullUrl": "/p317/ghazal/sh9635"
    },
    {
      "Id": 9636,
      "Title": "نہ جنوں جائے گا کبھی میرا",
      "FullUrl": "/p317/ghazal/sh9636"
    },
    {
      "Id": 9627,
      "Title": "سن کے فرقت چپ ہوا ایسا کہ مردا ہو گیا",
      "FullUrl": "/p317/ghazal/sh9627"
    },
    {
      "Id": 9624,
      "Title": "درویش قید غم میں دل زار ہو گیا",
      "FullUrl": "/p317/ghazal/sh9624"
    },
    {
      "Id": 9641,
      "Title": "کھلے گا ناخن شمشیر سے عقدہ مرے دل کا",
      "FullUrl": "/p317/ghazal/sh9641"
    },
    {
      "Id": 9640,
      "Title": "کون آئے گا جو تو بے سر و ساماں ہوگا",
      "FullUrl": "/p317/ghazal/sh9640"
    },
    {
      "Id": 9639,
      "Title": "وفور ضعف سے دل یار پر نہیں آتا",
      "FullUrl": "/p317/ghazal/sh9639"
    },
    {
      "Id": 9631,
      "Title": "مجھ کو مسند پہ قلمداں بخشا",
      "FullUrl": "/p317/ghazal/sh9631"
    },
    {
      "Id": 9617,
      "Title": "آنسو تھمے جو رخ پہ وہ گیسو بکھر گیا",
      "FullUrl": "/p317/ghazal/sh9617"
    },
    {
      "Id": 9622,
      "Title": "تھا نجم بخت تیرہ مقابل تمام رات",
      "FullUrl": "/p317/ghazal/sh9622"
    },
    {
      "Id": 9644,
      "Title": "ہم سے کرتا ہے عبث گفتار کج",
      "FullUrl": "/p317/ghazal/sh9644"
    },
    {
      "Id": 9623,
      "Title": "خوں بہانے کا بہانہ ہے بھلا میرے بعد",
      "FullUrl": "/p317/ghazal/sh9623"
    },
    {
      "Id": 9645,
      "Title": "ہے مرا تار نفس تار قفس",
      "FullUrl": "/p317/ghazal/sh9645"
    },
    {
      "Id": 9633,
      "Title": "موسم گل میں نہیں عزت و شان واعظ",
      "FullUrl": "/p317/ghazal/sh9633"
    },
    {
      "Id": 9634,
      "Title": "میں دریائے قناعت آشنا ہوں",
      "FullUrl": "/p317/ghazal/sh9634"
    },
    {
      "Id": 9632,
      "Title": "موت اپنی جان اے دل گردش افلاک کو",
      "FullUrl": "/p317/ghazal/sh9632"
    },
    {
      "Id": 9629,
      "Title": "شہرت ہے میری سخن وری کی",
      "FullUrl": "/p317/ghazal/sh9629"
    },
    {
      "Id": 9642,
      "Title": "گر ہو نہ خفا تو کہہ دوں جی کی",
      "FullUrl": "/p317/ghazal/sh9642"
    },
    {
      "Id": 9619,
      "Title": "اپنی پرسش جو ہو ارباب وفا سے پہلے",
      "FullUrl": "/p317/ghazal/sh9619"
    },
    {
      "Id": 9625,
      "Title": "دل آئنہ ہے جوہر عکس رو ہے",
      "FullUrl": "/p317/ghazal/sh9625"
    },
    {
      "Id": 9637,
      "Title": "نہ کچھ تکرار تم کو ہے نہ کچھ شکوہ ہمارا ہے",
      "FullUrl": "/p317/ghazal/sh9637"
    },
    {
      "Id": 9630,
      "Title": "غم میں عہد شباب جاتا ہے",
      "FullUrl": "/p317/ghazal/sh9630"
    },
    {
      "Id": 9628,
      "Title": "شب ہجراں میں دم نکلتا ہے",
      "FullUrl": "/p317/ghazal/sh9628"
    },
    {
      "Id": 9638,
      "Title": "نہ گل نہ سرو میان بہار ہوتا ہے",
      "FullUrl": "/p317/ghazal/sh9638"
    },
    {
      "Id": 9621,
      "Title": "تن سے جاں کا قدم نکلتا ہے",
      "FullUrl": "/p317/ghazal/sh9621"
    },
    {
      "Id": 9626,
      "Title": "رخ سے برقع جو الٹ دے وہ تو آفت ہو جائے",
      "FullUrl": "/p317/ghazal/sh9626"
    }
  ]
