    },
    {
      "Id": 9688,
      "Title": "ہنسو تو ساتھ ہنسے گی دنیا بیٹھ اکیلے رونا ہوگا",
      "FullUrl": "/p318/ghazal/sh9688",
      "RadifLetter": "ا"
    },
    {
      "Id": 9663,
      "Title": "دیدۂ اشک بار ہے اپنا",
      "FullUrl": "/p318/ghazal/sh9663",
      "RadifLetter": "ا"
    },
    {
      "Id": 9687,
      "Title": "گناہوں سے نشوونما پا گیا دل",
      "FullUrl": "/p318/ghazal/sh9687",
      "RadifLetter": "ل"
    },
    {
      "Id": 9682,
      "Title": "چاند ستارے قید ہیں سارے وقت کے بندی خانے میں",
