  "Poems": [
    {
      "Id": 783,
      "Title": "واں اگر جائیں تو لے کر جائیں کیا",
      "FullUrl": "/p32/ghazal/sh783"
    },
    {
      "Id": 756,
      "Title": "رنج اور رنج بھی تنہائی کا",
      "FullUrl": "/p32/ghazal/sh756"
    },
    {
      "Id": 752,
      "Title": "دل سے خیال دوست بھلایا نہ جائے گا",
      "FullUrl": "/p32/ghazal/sh752"
    },
    {
      "Id": 732,
      "Title": "اس کے جاتے ہی یہ کیا ہو گئی گھر کی صورت",
      "FullUrl": "/p32/ghazal/sh732"
    },
    {
      "Id": 794,
      "Title": "گو جوانی میں تھی کج رائی بہت",
      "FullUrl": "/p32/ghazal/sh794"
    },
    {
      "Id": 737,
      "Title": "بات کچھ ہم سے بن نہ آئی آج",
      "FullUrl": "/p32/ghazal/sh737"
    },
    {
      "Id": 797,
      "Title": "ہے یہ تکیہ تری عطاؤں پر",
      "FullUrl": "/p32/ghazal/sh797"
    },
    {
      "Id": 795,
      "Title": "گھر ہے وحشت خیز اور بستی اجاڑ",
      "FullUrl": "/p32/ghazal/sh795"
    },
    {
      "Id": 746,
      "Title": "جیتے جی موت کے تم منہ میں نہ جانا ہرگز",
      "FullUrl": "/p32/ghazal/sh746"
    },
    {
      "Id": 765,
      "Title": "عشق کو ترک جنوں سے کیا غرض",
      "FullUrl": "/p32/ghazal/sh765"
    },
    {
      "Id": 751,
      "Title": "خوبیاں اپنے میں گو بے انتہا پاتے ہیں ہم",
      "FullUrl": "/p32/ghazal/sh751"
    },
    {
      "Id": 729,
      "Title": "آگے بڑھے نہ قصۂ عشق بتاں سے ہم",
      "FullUrl": "/p32/ghazal/sh729"
    },
    {
      "Id": 780,
      "Title": "میں تو میں غیر کو مرنے سے اب انکار نہیں",
      "FullUrl": "/p32/ghazal/sh780"
    },
    {
      "Id": 790,
      "Title": "کوئی محرم نہیں ملتا جہاں میں",
      "FullUrl": "/p32/ghazal/sh790"
    },
    {
      "Id": 796,
      "Title": "ہے جستجو کہ خوب سے ہے خوب تر کہاں",
      "FullUrl": "/p32/ghazal/sh796"
    },
    {
      "Id": 766,
      "Title": "غم فرقت ہی میں مرنا ہو تو دشوار نہیں",
      "FullUrl": "/p32/ghazal/sh766"
    },
    {
      "Id": 730,
      "Title": "اب وہ اگلا سا التفات نہیں",
      "FullUrl": "/p32/ghazal/sh730"
    },
    {
      "Id": 750,
      "Title": "حقیقت محرم اسرار سے پوچھ",
      "FullUrl": "/p32/ghazal/sh750"
    },
    {
      "Id": 755,
      "Title": "دھوم تھی اپنی پارسائی کی",
      "FullUrl": "/p32/ghazal/sh755"
    },
    {
      "Id": 740,
      "Title": "بری اور بھلی سب گزر جائے گی",
      "FullUrl": "/p32/ghazal/sh740"
    },
    {
      "Id": 784,
      "Title": "وصل کا اس کے دل زار تمنائی ہے",
      "FullUrl": "/p32/ghazal/sh784"
    },
    {
      "Id": 788,
      "Title": "کر کے بیمار دی دوا تو نے",
      "FullUrl": "/p32/ghazal/sh788"
    },
    {
      "Id": 792,
      "Title": "کہہ دو کوئی ساقی سے کہ ہم مرتے ہیں پیاسے",
      "FullUrl": "/p32/ghazal/sh792"
    },
    {
      "Id": 787,
      "Title": "کبک و قمری میں ہے جھگڑا کہ چمن کس کا ہے",
      "FullUrl": "/p32/ghazal/sh787"
    },
    {
      "Id": 744,
      "Title": "جنوں کار فرما ہوا چاہتا ہے",
      "FullUrl": "/p32/ghazal/sh744"
    },
    {
      "Id": 748,
      "Title": "حشر تک یاں دل شکیبا چاہئے",
      "FullUrl": "/p32/ghazal/sh748"
    },
    {
      "Id": 749,
      "Title": "حق وفا کے جو ہم جتانے لگے",
      "FullUrl": "/p32/ghazal/sh749"
    },
    {
      "Id": 753,
      "Title": "دل کو درد آشنا کیا تو نے",
      "FullUrl": "/p32/ghazal/sh753"
    }
  ]
