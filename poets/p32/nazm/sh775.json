    {
      "VOrder": 5,
      "Position": "Left",
      "Text": "سارے تواناؤں سے توانا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Right",
      "Text": "اے بالا، ہر بالاتر سے",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Left",
      "Text": "چاند سے سورج سے امبر سے",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Right",
      "Text": "اے سمجھے بوجھے بن سوجھے",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 9,
      "Position": "Left",
      "Text": "جانے پہچانے بن بوجھے",
      "CoupletIndex": 4,
      "SectionIndex1": 0
    },
    {
      "VOrder": 10,
      "Position": "Right",
      "Text": "سب سے انوکھے سب سے نرالے",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Left",
      "Text": "آنکھ سے اوجھل دل کے اجالے",
      "CoupletIndex": 5,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Right",
      "Text": "اے اندھوں کی آنکھ کے تارے",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 13,
      "Position": "Left",
      "Text": "اے لنگڑے لولوں کے سہارے",
      "CoupletIndex": 6,
      "SectionIndex1": 0
    },
    {
      "VOrder": 14,
      "Position": "Right",
      "Text": "ناتیوں سے چھوٹوں کے ناتی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 15,
      "Position": "Left",
      "Text": "ساتھیوں سے بچھڑوں کے ساتھی",
      "CoupletIndex": 7,
      "SectionIndex1": 0
    },
    {
      "VOrder": 16,
      "Position": "Right",
      "Text": "ناؤ جہاں کی کھینے والے",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 17,
      "Position": "Left",
      "Text": "دکھ میں تسلی دینے والے",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 18,
      "Position": "Right",
      "Text": "جب اب تب تجھ سا نہیں کوئی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 19,
      "Position": "Left",
      "Text": "تجھ سے ہیں سب تجھ سا نہیں کوئی",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 20,
      "Position": "Right",
      "Text": "جوت ہے تیری جل اور تھل میں",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 21,
      "Position": "Left",
      "Text": "باس ہے تیری پھول اور پھل میں",
      "CoupletIndex": 10,
      "SectionIndex1": 0
    },
    {
      "VOrder": 22,
      "Position": "Right",
      "Text": "ہر دل میں ہے تیرا بسیرا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 23,
      "Position": "Left",
      "Text": "تو پاس اور گھر دور ہے تیرا",
      "CoupletIndex": 11,
      "SectionIndex1": 0
    },
    {
      "VOrder": 24,
      "Position": "Right",
      "Text": "راہ تری دشوار اور سکڑی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 25,
      "Position": "Left",
      "Text": "نام ترا رہ گیر کی لکڑی",
      "CoupletIndex": 12,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Right",
      "Text": "تو ہے ٹھکانا مسکینوں کا",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 27,
      "Position": "Left",
      "Text": "تو ہے سہارا غمگینوں کا",
      "CoupletIndex": 13,
      "SectionIndex1": 0
    },
    {
      "VOrder": 28,
      "Position": "Right",
      "Text": "تو ہے اکیلوں کا رکھوالا",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 29,
      "Position": "Left",
      "Text": "تو ہے اندھیرے گھر کا اجالا",
      "CoupletIndex": 14,
      "SectionIndex1": 0
    },
    {
      "VOrder": 30,
      "Position": "Right",
      "Text": "لاگو اچھے اور برے کا",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 31,
      "Position": "Left",
      "Text": "خواہاں کھوٹے اور کھرے کا",
      "CoupletIndex": 15,
      "SectionIndex1": 0
    },
    {
      "VOrder": 32,
      "Position": "Right",
      "Text": "بید نراسے بیماروں کا",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 33,
      "Position": "Left",
      "Text": "گاہک مندے بازاروں کا",
      "CoupletIndex": 16,
      "SectionIndex1": 0
    },
    {
      "VOrder": 34,
      "Position": "Right",
      "Text": "سوچ میں دل بہلانے والے",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 35,
      "Position": "Left",
      "Text": "بپتا میں یاد آنے والے",
      "CoupletIndex": 17,
      "SectionIndex1": 0
    },
    {
      "VOrder": 36,
      "Position": "Single",
      "Text": "(۲)",
      "CoupletIndex": 18,
      "SectionIndex1": 0
    },
    {
      "VOrder": 37,
      "Position": "Right",
      "Text": "اے بے وارث گھروں کے وارث",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 38,
      "Position": "Left",
      "Text": "بے بازو بے پروں کے وارث",
      "CoupletIndex": 19,
      "SectionIndex1": 0
    },
    {
      "VOrder": 39,
      "Position": "Right",
      "Text": "بے آسوں کی آس ہے تو ہی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 40,
      "Position": "Left",
      "Text": "جاگتے سوتے پاس ہے تو ہی",
      "CoupletIndex": 20,
      "SectionIndex1": 0
    },
    {
      "VOrder": 41,
      "Position": "Right",
      "Text": "بس والے ہیں یا بے بس ہیں",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 42,
      "Position": "Left",
      "Text": "تو نہیں جن کا وہ بے کس ہیں",
      "CoupletIndex": 21,
      "SectionIndex1": 0
    },
    {
      "VOrder": 43,
      "Position": "Right",
      "Text": "ساتھی جن کا دھیان ہے تیرا",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 44,
      "Position": "Left",
      "Text": "دسرایت کی وہاں نہیں پروا",
      "CoupletIndex": 22,
      "SectionIndex1": 0
    },
    {
      "VOrder": 45,
      "Position": "Right",
      "Text": "دل میں ہے جن کے تیری بڑائی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 46,
      "Position": "Left",
      "Text": "گنتے ہیں وہ پربت کو رائی",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 47,
      "Position": "Right",
      "Text": "بیکس کا غم خوار ہے تو ہی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 48,
      "Position": "Left",
      "Text": "بری بنی کا یار ہے تو ہی",
      "CoupletIndex": 24,
      "SectionIndex1": 0
    },
    {
      "VOrder": 49,
      "Position": "Right",
      "Text": "دکھیا دکھی یتیم اور بیوہ",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 50,
      "Position": "Left",
      "Text": "تیرے ہی ہاتھ ان سب کا ہے کھیوا",
      "CoupletIndex": 25,
      "SectionIndex1": 0
    },
    {
      "VOrder": 51,
      "Position": "Right",
      "Text": "تو ہی مرض دے تو ہی دوا دے",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 52,
      "Position": "Left",
      "Text": "تو ہی دوا دارو میں شفا دے",
      "CoupletIndex": 26,
      "SectionIndex1": 0
    },
    {
      "VOrder": 53,
      "Position": "Right",
      "Text": "تو ہی پلائے زہر کے پیالے",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 54,
      "Position": "Left",
      "Text": "تو ہی پھر امرت زہر میں ڈالے",
      "CoupletIndex": 27,
      "SectionIndex1": 0
    },
    {
      "VOrder": 55,
      "Position": "Right",
      "Text": "تو ہی دلوں میں آگ لگائے",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "تو ہی دلوں کی لگی بجھائے",
      "CoupletIndex": 28,
      "SectionIndex1": 0
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "چمکارے چمکار کے مارے",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "مارے مار کے پھر چمکارے",
      "CoupletIndex": 29,
      "SectionIndex1": 0
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "پیار کا تیرے پوچھنا کیا ہے",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "مار میں بھی اک تیری مزا ہے",
      "CoupletIndex": 30,
      "SectionIndex1": 0
    },
    {
      "VOrder": 61,
      "Position": "Single",
      "Text": "(۳)",
      "CoupletIndex": 31,
      "SectionIndex1": 0
    },
    {
      "VOrder": 62,
      "Position": "Right",
      "Text": "اے رحمت اور ہیبت والے",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 63,
      "Position": "Left",
      "Text": "شفقت اور دباغت والے",
      "CoupletIndex": 32,
      "SectionIndex1": 0
    },
    {
      "VOrder": 64,
      "Position": "Right",
      "Text": "اے اٹکل اور دھیان سے باہر",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 65,
      "Position": "Left",
      "Text": "جان سے اور پہچان سے باہر",
      "CoupletIndex": 33,
      "SectionIndex1": 0
    },
    {
      "VOrder": 66,
      "Position": "Right",
      "Text": "عقل سے کوئی پا نہیں سکتا",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 67,
      "Position": "Left",
      "Text": "بھید ترے حکموں میں ہیں کیا کیا",
      "CoupletIndex": 34,
      "SectionIndex1": 0
    },
    {
      "VOrder": 68,
      "Position": "Right",
      "Text": "ایک کو تو نے شاد کیا ہے",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 69,
      "Position": "Left",
      "Text": "ایک کے دل کو داغ دیا ہے",
      "CoupletIndex": 35,
      "SectionIndex1": 0
    },
    {
      "VOrder": 70,
      "Position": "Right",
      "Text": "اس سے نہ تیرا پیار کچھ ایسا",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 71,
      "Position": "Left",
      "Text": "اس سے نہ تو بیزار کچھ ایسا",
      "CoupletIndex": 36,
      "SectionIndex1": 0
    },
    {
      "VOrder": 72,
      "Position": "Right",
      "Text": "ہر دم تیری آن نئی ہے",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 73,
      "Position": "Left",
      "Text": "جب دیکھو تب شان نئی ہے",
      "CoupletIndex": 37,
      "SectionIndex1": 0
    },
    {
      "VOrder": 74,
      "Position": "Right",
      "Text": "یہاں پچھوا ہے وہاں پروا ہے",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 75,
      "Position": "Left",
      "Text": "گھر گھر تیرا حکم نیا ہے",
      "CoupletIndex": 38,
      "SectionIndex1": 0
    },
    {
      "VOrder": 76,
      "Position": "Right",
      "Text": "پھول کہیں کملائے ہوئے ہیں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 77,
      "Position": "Left",
      "Text": "اور کہیں پھل آئے ہوئے ہیں",
      "CoupletIndex": 39,
      "SectionIndex1": 0
    },
    {
      "VOrder": 78,
      "Position": "Right",
      "Text": "کھیتی ایک کی ہے لہراتی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 79,
      "Position": "Left",
      "Text": "ایک کا ہر دم خون سکھاتی",
      "CoupletIndex": 40,
      "SectionIndex1": 0
    },
    {
      "VOrder": 80,
      "Position": "Right",
      "Text": "ایک پڑے ہیں دھن کو ڈبوئے",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 81,
      "Position": "Left",
      "Text": "ایک ہیں گھوڑے بیچ کے سوئے",
      "CoupletIndex": 41,
      "SectionIndex1": 0
    },
    {
      "VOrder": 82,
      "Position": "Right",
      "Text": "ایک نے جب سے ہوش سنبھالا",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 83,
      "Position": "Left",
      "Text": "رنج سے اس کو پڑا نہ پالا",
      "CoupletIndex": 42,
      "SectionIndex1": 0
    },
    {
      "VOrder": 84,
      "Position": "Right",
      "Text": "ایک نے اس جنجال میں آ کر",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 85,
      "Position": "Left",
      "Text": "چین نہ دیکھا آنکھ اٹھا کر",
      "CoupletIndex": 43,
      "SectionIndex1": 0
    },
    {
      "VOrder": 86,
      "Position": "Right",
      "Text": "مینہ کہیں دولت کا ہے برستا",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 87,
      "Position": "Left",
      "Text": "ہے کوئی پانی تک کو ترستا",
      "CoupletIndex": 44,
      "SectionIndex1": 0
    },
    {
      "VOrder": 88,
      "Position": "Right",
      "Text": "ایک کو مرنے تک نہیں دیتے",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 89,
      "Position": "Left",
      "Text": "ایک اکتا گیا لیتے لیتے",
      "CoupletIndex": 45,
      "SectionIndex1": 0
    },
    {
      "VOrder": 90,
      "Position": "Right",
      "Text": "حال غرض دنیا کا یہی ہے",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 91,
      "Position": "Left",
      "Text": "غم پہلے اور بعد خوشی ہے",
      "CoupletIndex": 46,
      "SectionIndex1": 0
    },
    {
      "VOrder": 92,
      "Position": "Right",
      "Text": "رنج کا ہے دنیا کے گلا کیا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 93,
      "Position": "Left",
      "Text": "تحفہ یہی لے دے کے ہے یاں کا",
      "CoupletIndex": 47,
      "SectionIndex1": 0
    },
    {
      "VOrder": 94,
      "Position": "Right",
      "Text": "یہاں نہیں بنتی رنج سہے بن",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 95,
      "Position": "Left",
      "Text": "رنج نہیں سب ایک سے لیکن",
      "CoupletIndex": 48,
      "SectionIndex1": 0
    },
    {
      "VOrder": 96,
      "Position": "Right",
      "Text": "ایک سے یہاں رنج ایک ہے بالا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 97,
      "Position": "Left",
      "Text": "ایک سے ہے درد ایک نرالا",
      "CoupletIndex": 49,
      "SectionIndex1": 0
    },
    {
      "VOrder": 98,
      "Position": "Right",
      "Text": "گھاؤ ہے گو ناسور کی صورت",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 99,
      "Position": "Left",
      "Text": "پر اسے کیا ناسور سے نسبت",
      "CoupletIndex": 50,
      "SectionIndex1": 0
    },
    {
      "VOrder": 100,
      "Position": "Right",
      "Text": "تپ وہی دق کی شکل ہے لیکن",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 101,
      "Position": "Left",
      "Text": "دق نہیں رہتی جان لیے بن",
      "CoupletIndex": 51,
      "SectionIndex1": 0
    },
    {
      "VOrder": 102,
      "Position": "Right",
      "Text": "دق ہو وہ یا ناسور ہو کچھ ہو",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 103,
      "Position": "Left",
      "Text": "دے نہ جو اب امید کسی کو",
      "CoupletIndex": 52,
      "SectionIndex1": 0
    },
    {
      "VOrder": 104,
      "Position": "Right",
      "Text": "روز کا غم کیوں کر سہے کوئی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 105,
      "Position": "Left",
      "Text": "آس نہ جب باقی رہے کوئی",
      "CoupletIndex": 53,
      "SectionIndex1": 0
    },
    {
      "VOrder": 106,
      "Position": "Right",
      "Text": "تو ہی کر انصاف اے مرے مولا",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 107,
      "Position": "Left",
      "Text": "کون ہے جو بے آس ہے جیتا",
      "CoupletIndex": 54,
      "SectionIndex1": 0
    },
    {
      "VOrder": 108,
      "Position": "Right",
      "Text": "گو کہ بہت بندے ہیں پر ارماں",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 109,
      "Position": "Left",
      "Text": "کم ہیں مگر مایوس ہیں جو یاں",
      "CoupletIndex": 55,
      "SectionIndex1": 0
    },
    {
      "VOrder": 110,
      "Position": "Right",
      "Text": "خواہ دکھی ہے خواہ سکھی ہے",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 111,
      "Position": "Left",
      "Text": "جو ہے اک امید اس کو بندھی ہے",
      "CoupletIndex": 56,
      "SectionIndex1": 0
    },
    {
      "VOrder": 112,
      "Position": "Right",
      "Text": "کھیتیاں جن کی کھڑی ہیں سوکھی",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 113,
      "Position": "Left",
      "Text": "آس وہ باندھے بیٹھے ہیں مینہ کی",
      "CoupletIndex": 57,
      "SectionIndex1": 0
    },
    {
      "VOrder": 114,
      "Position": "Right",
      "Text": "گھٹا جن کی اساڑی میں ہے",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 115,
      "Position": "Left",
      "Text": "ساونی کی امید نہیں ہے",
      "CoupletIndex": 58,
      "SectionIndex1": 0
    },
    {
      "VOrder": 116,
      "Position": "Right",
      "Text": "ڈوب چکی ہے ان کی اگیتی",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 117,
      "Position": "Left",
      "Text": "دیتی ہے ڈھارس ان کو پچھیتی",
      "CoupletIndex": 59,
      "SectionIndex1": 0
    },
    {
      "VOrder": 118,
      "Position": "Right",
      "Text": "ایک ہے اس امید پہ جیتا",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 119,
      "Position": "Left",
      "Text": "اب ہوئی بیٹی اب ہوا بیٹا",
      "CoupletIndex": 60,
      "SectionIndex1": 0
    },
    {
      "VOrder": 120,
      "Position": "Right",
      "Text": "ایک کو جو اولاد ملی ہے",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 121,
      "Position": "Left",
      "Text": "اس کو امنگ شادیوں کی ہے",
      "CoupletIndex": 61,
      "SectionIndex1": 0
    },
    {
      "VOrder": 122,
      "Position": "Right",
      "Text": "رنج ہے یا قسمت میں خوشی ہے",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 123,
      "Position": "Left",
      "Text": "کچھ ہے مگر اک آس بندھی ہے",
      "CoupletIndex": 62,
      "SectionIndex1": 0
    },
    {
      "VOrder": 124,
      "Position": "Right",
      "Text": "غم نہیں ان کو غمگیں ہیں",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 125,
      "Position": "Left",
      "Text": "جو دل ناامید نہیں ہیں",
      "CoupletIndex": 63,
      "SectionIndex1": 0
    },
    {
      "VOrder": 126,
      "Position": "Right",
      "Text": "کال میں کچھ سختی نہیں ایسی",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 127,
      "Position": "Left",
      "Text": "کال میں ہے جب آس سمیں کی",
      "CoupletIndex": 64,
      "SectionIndex1": 0
    },
    {
      "VOrder": 128,
      "Position": "Right",
      "Text": "سہل ہے موجوں سے چھٹکارا",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 129,
      "Position": "Left",
      "Text": "جب کہ نظر آتا ہے کنارا",
      "CoupletIndex": 65,
      "SectionIndex1": 0
    },
    {
      "VOrder": 130,
      "Position": "Right",
      "Text": "پر نہیں اٹھ سکتی وہ مصیبت",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 131,
      "Position": "Left",
      "Text": "آئے گی جس کے بعد نہ راحت",
      "CoupletIndex": 66,
      "SectionIndex1": 0
    },
    {
      "VOrder": 132,
      "Position": "Right",
      "Text": "شاد ہو اس رہ گیر کا کیا دل؟",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 133,
      "Position": "Left",
      "Text": "مر کے کٹے گی جس کی منزل",
      "CoupletIndex": 67,
      "SectionIndex1": 0
    },
    {
      "VOrder": 134,
      "Position": "Right",
      "Text": "ان اجڑوں کو کل پڑے کیوں کر",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 135,
      "Position": "Left",
      "Text": "گھر نہ بسے گا جن کا جنم بھر",
      "CoupletIndex": 68,
      "SectionIndex1": 0
    },
    {
      "VOrder": 136,
      "Position": "Right",
      "Text": "ان بچھڑوں کا کیا ہے ٹھکانا؟",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 137,
      "Position": "Left",
      "Text": "جن کو نہ ملنے دے گا زمانہ",
      "CoupletIndex": 69,
      "SectionIndex1": 0
    },
    {
      "VOrder": 138,
      "Position": "Right",
      "Text": "اب یہ بلا ٹلتی نہیں ٹالی",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 139,
      "Position": "Left",
      "Text": "مجھ پہ ہے جو تقدیر نے ڈالی",
      "CoupletIndex": 70,
      "SectionIndex1": 0
    },
    {
      "VOrder": 140,
      "Position": "Right",
      "Text": "آئیں بہت دنیا میں بہاریں",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 141,
      "Position": "Left",
      "Text": "عیش کی گھر گھر پڑیں پکاریں",
      "CoupletIndex": 71,
      "SectionIndex1": 0
    },
    {
      "VOrder": 142,
      "Position": "Right",
      "Text": "پڑے بہت باغوں میں جھولے",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 143,
      "Position": "Left",
      "Text": "ڈھاک بہت جنگل میں پھولے",
      "CoupletIndex": 72,
      "SectionIndex1": 0
    },
    {
      "VOrder": 144,
      "Position": "Right",
      "Text": "گئیں اور آئیں چاندنی راتیں",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 145,
      "Position": "Left",
      "Text": "برسیں کھلیں بہت برساتیں",
      "CoupletIndex": 73,
      "SectionIndex1": 0
    },
    {
      "VOrder": 146,
      "Position": "Right",
      "Text": "پر نہ کھلی ہرگز نہ کھلے گی",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 147,
      "Position": "Left",
      "Text": "وہ جو کلی مرجھائی تھی دل کی",
      "CoupletIndex": 74,
      "SectionIndex1": 0
    },
    {
      "VOrder": 148,
      "Position": "Right",
      "Text": "آس ہی کا بس نام ہے دنیا",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 149,
      "Position": "Left",
      "Text": "جب نہ رہی یہی تو رہا کیا؟",
      "CoupletIndex": 75,
      "SectionIndex1": 0
    },
    {
      "VOrder": 150,
      "Position": "Right",
      "Text": "ایسے بدیسی کا نہیں غم کچھ",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 151,
      "Position": "Left",
      "Text": "جس کو نہ ہو ملنے کی قسم کچھ",
      "CoupletIndex": 76,
      "SectionIndex1": 0
    },
    {
      "VOrder": 152,
      "Position": "Right",
      "Text": "رونا ان بن باسیوں کا ہے",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 153,
      "Position": "Left",
      "Text": "دیس نکالا جن کو ملا ہے",
      "CoupletIndex": 77,
      "SectionIndex1": 0
    },
    {
      "VOrder": 154,
      "Position": "Right",
      "Text": "حکم سے تیرے پر نہیں چارہ",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 155,
      "Position": "Left",
      "Text": "کڑوی میٹھی سب ہے گوارا",
      "CoupletIndex": 78,
      "SectionIndex1": 0
    },
    {
      "VOrder": 156,
      "Position": "Right",
      "Text": "زور ہے کیا پتے کا ہوا پر",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 157,
      "Position": "Left",
      "Text": "چاہے جدھر لے جائے اڑا کر",
      "CoupletIndex": 79,
      "SectionIndex1": 0
    },
    {
      "VOrder": 158,
      "Position": "Right",
      "Text": "تنکا اک اور سات سمندر",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 159,
      "Position": "Left",
      "Text": "جائے کہاں موجوں سے نکل کر",
      "CoupletIndex": 80,
      "SectionIndex1": 0
    },
    {
      "VOrder": 160,
      "Position": "Right",
      "Text": "قسمت ہی میں جب تھی جدائی",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 161,
      "Position": "Left",
      "Text": "پھر ٹلتی کس طرح یہ آئی؟",
      "CoupletIndex": 81,
      "SectionIndex1": 0
    },
    {
      "VOrder": 162,
      "Position": "Right",
      "Text": "آج کی بگڑی ہو تو بنے بھی",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 163,
      "Position": "Left",
      "Text": "ازل کی بگڑی خاک بنے گی",
      "CoupletIndex": 82,
      "SectionIndex1": 0
    },
    {
      "VOrder": 164,
      "Position": "Right",
      "Text": "تو جو چاہے وہ نہیں ٹلتا",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 165,
      "Position": "Left",
      "Text": "بندے کا یاں بس نہیں چلتا",
      "CoupletIndex": 83,
      "SectionIndex1": 0
    },
    {
      "VOrder": 166,
      "Position": "Right",
      "Text": "مارے اور نہ دے تو رونے",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 167,
      "Position": "Left",
      "Text": "تھپکے اور نہ دے تو سونے",
      "CoupletIndex": 84,
      "SectionIndex1": 0
    },
    {
      "VOrder": 168,
      "Position": "Right",
      "Text": "ٹھہرے بن آتی ہے نہ بھاگے",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 169,
      "Position": "Left",
      "Text": "تیری زبردستی کے آگے",
      "CoupletIndex": 85,
      "SectionIndex1": 0
    },
    {
      "VOrder": 170,
      "Position": "Right",
      "Text": "تجھ سے کہیں گر بھاگنا چاہیں",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 171,
      "Position": "Left",
      "Text": "بند ہیں چاروں کھونٹ کی راہیں",
      "CoupletIndex": 86,
      "SectionIndex1": 0
    },
    {
      "VOrder": 172,
      "Position": "Right",
      "Text": "تو مارے اور خواہ نوازے",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 173,
      "Position": "Left",
      "Text": "پڑی ہوئی ہوں میں تیرے دروازے",
      "CoupletIndex": 87,
      "SectionIndex1": 0
    },
    {
      "VOrder": 174,
      "Position": "Right",
      "Text": "تجھ کو اپنا جانتی ہوں میں",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 175,
      "Position": "Left",
      "Text": "تجھ سے نہیں تو کس سے کہوں میں",
      "CoupletIndex": 88,
      "SectionIndex1": 0
    },
    {
      "VOrder": 176,
      "Position": "Right",
      "Text": "ماں ہی سدا بچہ کو مارے",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 177,
      "Position": "Left",
      "Text": "اور بچہ ماں ماں ہی پکارے",
      "CoupletIndex": 89,
      "SectionIndex1": 0
    },
    {
      "VOrder": 178,
      "Position": "Single",
      "Text": "(۴)",
      "CoupletIndex": 90,
      "SectionIndex1": 0
    },
    {
      "VOrder": 179,
      "Position": "Right",
      "Text": "اے مرے زور اور قدرت والے",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 180,
      "Position": "Left",
      "Text": "حکمت اور حکومت والے",
      "CoupletIndex": 91,
      "SectionIndex1": 0
    },
    {
      "VOrder": 181,
      "Position": "Right",
      "Text": "میں لونڈی تیری دکھیارے",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 182,
      "Position": "Left",
      "Text": "دروازے کی تیری بھکاری",
      "CoupletIndex": 92,
      "SectionIndex1": 0
    },
    {
      "VOrder": 183,
      "Position": "Right",
      "Text": "موت کی خواہاں جان کی دشمن",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 184,
      "Position": "Left",
      "Text": "جان اپنی ہے آپ اجیرن",
      "CoupletIndex": 93,
      "SectionIndex1": 0
    },
    {
      "VOrder": 185,
      "Position": "Right",
      "Text": "اپنے پرائے کی دھتکاری",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 186,
      "Position": "Left",
      "Text": "میکے اور سسرال پہ بھاری",
      "CoupletIndex": 94,
      "SectionIndex1": 0
    },
    {
      "VOrder": 187,
      "Position": "Right",
      "Text": "سہہ کے بہت آزار چلی ہوں",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 188,
      "Position": "Left",
      "Text": "دنیا سے بیزار چلی ہوں",
      "CoupletIndex": 95,
      "SectionIndex1": 0
    },
    {
      "VOrder": 189,
      "Position": "Right",
      "Text": "دل پر میرے داغ ہیں جتنے",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 190,
      "Position": "Left",
      "Text": "منہ میں بول نہیں ہیں اتنے",
      "CoupletIndex": 96,
      "SectionIndex1": 0
    },
    {
      "VOrder": 191,
      "Position": "Right",
      "Text": "دکھ دل کا کچھ کہہ نہیں سکتی",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 192,
      "Position": "Left",
      "Text": "اس کے سوا کچھ کہہ نہیں سکتی",
      "CoupletIndex": 97,
      "SectionIndex1": 0
    },
    {
      "VOrder": 193,
      "Position": "Right",
      "Text": "تجھ پہ ہے روشن سب دکھ دل کا",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 194,
      "Position": "Left",
      "Text": "تجھ سے حقیقت اپنی کہوں کیا",
      "CoupletIndex": 98,
      "SectionIndex1": 0
    },
    {
      "VOrder": 195,
      "Position": "Right",
      "Text": "بیاہ کے دم پائی تھی نہ لینے",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 196,
      "Position": "Left",
      "Text": "لینے کے یاں پڑ گئے دینے",
      "CoupletIndex": 99,
      "SectionIndex1": 0
    },
    {
      "VOrder": 197,
      "Position": "Right",
      "Text": "خوشی میں بھی دکھ ساتھ نہ آیا",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 198,
      "Position": "Left",
      "Text": "غم کے سوا کچھ ہات نہ آیا",
      "CoupletIndex": 100,
      "SectionIndex1": 0
    },
    {
      "VOrder": 199,
      "Position": "Right",
      "Text": "ایک خوشی نے غم یہ دکھائے",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 200,
      "Position": "Left",
      "Text": "ایک ہنسی نے گل ہی کھلائے",
      "CoupletIndex": 101,
      "SectionIndex1": 0
    },
    {
      "VOrder": 201,
      "Position": "Right",
      "Text": "کیسا تھا یہ بیاہ نناواں",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 202,
      "Position": "Left",
      "Text": "جوں ہی پڑا اس کا پرچھاواں",
      "CoupletIndex": 102,
      "SectionIndex1": 0
    },
    {
      "VOrder": 203,
      "Position": "Right",
      "Text": "چین سے رہنے دیا نہ جی کو",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 204,
      "Position": "Left",
      "Text": "کر دیا ملیامیٹ خوشی کو",
      "CoupletIndex": 103,
      "SectionIndex1": 0
    },
    {
      "VOrder": 205,
      "Position": "Right",
      "Text": "رو نہیں سکتی تنگ ہوں یاں تک",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 206,
      "Position": "Left",
      "Text": "اور روؤں تو روؤں کہاں تک",
      "CoupletIndex": 104,
      "SectionIndex1": 0
    },
    {
      "VOrder": 207,
      "Position": "Right",
      "Text": "ہنس ہنس دل بہلاؤں کیوں کر",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 208,
      "Position": "Left",
      "Text": "اوسوں پیاس بجھاؤں کیوں کر",
      "CoupletIndex": 105,
      "SectionIndex1": 0
    },
    {
      "VOrder": 209,
      "Position": "Right",
      "Text": "ایک کا کچھ جینا نہیں ہوتا",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 210,
      "Position": "Left",
      "Text": "ایک نہ ہنستا بھلا نہ روتا",
      "CoupletIndex": 106,
      "SectionIndex1": 0
    },
    {
      "VOrder": 211,
      "Position": "Right",
      "Text": "لیٹے گر سونے کے بہانے",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 212,
      "Position": "Left",
      "Text": "پائنتی کل ہے اور نہ سرہانے",
      "CoupletIndex": 107,
      "SectionIndex1": 0
    },
    {
      "VOrder": 213,
      "Position": "Right",
      "Text": "جاگیے تو بھی بن نہیں پڑتی",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 214,
      "Position": "Left",
      "Text": "جاگنے کی آخر کوئی حد بھی",
      "CoupletIndex": 108,
      "SectionIndex1": 0
    },
    {
      "VOrder": 215,
      "Position": "Right",
      "Text": "اب کل ہم کو پڑے گی مر کر",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 216,
      "Position": "Left",
      "Text": "گور ہے سونی سیج سے بہتر",
      "CoupletIndex": 109,
      "SectionIndex1": 0
    },
    {
      "VOrder": 217,
      "Position": "Right",
      "Text": "بات سے نفرت کام سے وحشت",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 218,
      "Position": "Left",
      "Text": "ٹوٹی آس اور بجھی طبیعت",
      "CoupletIndex": 110,
      "SectionIndex1": 0
    },
    {
      "VOrder": 219,
      "Position": "Right",
      "Text": "آبادی جنگل کا نمونہ",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 220,
      "Position": "Left",
      "Text": "دنیا سونی اور گھر سونا",
      "CoupletIndex": 111,
      "SectionIndex1": 0
    },
    {
      "VOrder": 221,
      "Position": "Right",
      "Text": "دن ہے بھیانک اور رات ڈرانی",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 222,
      "Position": "Left",
      "Text": "یوں گزری ساری یہ جوانی",
      "CoupletIndex": 112,
      "SectionIndex1": 0
    },
    {
      "VOrder": 223,
      "Position": "Right",
      "Text": "بہنیں اور بہنیلیاں میری",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 224,
      "Position": "Left",
      "Text": "ساتھ کی جو تھیں کھیلیاں میری",
      "CoupletIndex": 113,
      "SectionIndex1": 0
    },
    {
      "VOrder": 225,
      "Position": "Right",
      "Text": "مل نہ سکیں جی کھول کے مجھ سے",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 226,
      "Position": "Left",
      "Text": "خوش نہ ہوئیں ہنس بول کے مجھ سے",
      "CoupletIndex": 114,
      "SectionIndex1": 0
    },
    {
      "VOrder": 227,
      "Position": "Right",
      "Text": "جب آئیں رو دھو کے گئیں وہ",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 228,
      "Position": "Left",
      "Text": "جب گئیں بے کل ہو کے گئیں وہ",
      "CoupletIndex": 115,
      "SectionIndex1": 0
    },
    {
      "VOrder": 229,
      "Position": "Right",
      "Text": "کوئی نہیں دل کا بہلاوا",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 230,
      "Position": "Left",
      "Text": "آ نہیں چکتا میرا بلاوا",
      "CoupletIndex": 116,
      "SectionIndex1": 0
    },
    {
      "VOrder": 231,
      "Position": "Right",
      "Text": "آٹھ پہر کا ہے یہ جلاپا",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 232,
      "Position": "Left",
      "Text": "کاٹوں گی کس طرح رنڈاپا",
      "CoupletIndex": 117,
      "SectionIndex1": 0
    },
    {
      "VOrder": 233,
      "Position": "Right",
      "Text": "تھک گئی دکھ سہتے سہتے",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 234,
      "Position": "Left",
      "Text": "تھم گئے آنسو بہتے بہتے",
      "CoupletIndex": 118,
      "SectionIndex1": 0
    },
    {
      "VOrder": 235,
      "Position": "Right",
      "Text": "آگ کھلی دل کی نہ کسی پر",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 236,
      "Position": "Left",
      "Text": "گھل گئی جان اندر ہی اندر",
      "CoupletIndex": 119,
      "SectionIndex1": 0
    },
    {
      "VOrder": 237,
      "Position": "Right",
      "Text": "دیکھ کے چپ جانا نہ کسی نے",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 238,
      "Position": "Left",
      "Text": "جان کو پھونکا دل کی لگی نے",
      "CoupletIndex": 120,
      "SectionIndex1": 0
    },
    {
      "VOrder": 239,
      "Position": "Right",
      "Text": "دبی تھی بھوبھل میں چنگاری",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 240,
      "Position": "Left",
      "Text": "لی نہ کسی نے خبر ہماری",
      "CoupletIndex": 121,
      "SectionIndex1": 0
    },
    {
      "VOrder": 241,
      "Position": "Right",
      "Text": "قوم میں وہ خوشیاں بیاہوں کی",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 242,
      "Position": "Left",
      "Text": "شہر میں وہ دھوئیں ساہوں کی",
      "CoupletIndex": 122,
      "SectionIndex1": 0
    },
    {
      "VOrder": 243,
      "Position": "Right",
      "Text": "تہواروں کا آئے دن آنا",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 244,
      "Position": "Left",
      "Text": "اور سب کا تہوار منانا",
      "CoupletIndex": 123,
      "SectionIndex1": 0
    },
    {
      "VOrder": 245,
      "Position": "Right",
      "Text": "وہ چیت اور پھاگن کی ہوائیں",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 246,
      "Position": "Left",
      "Text": "وہ ساون بھادوں کی گھٹائیں",
      "CoupletIndex": 124,
      "SectionIndex1": 0
    },
    {
      "VOrder": 247,
      "Position": "Right",
      "Text": "وہ گرمی کی چاندنی راتیں",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 248,
      "Position": "Left",
      "Text": "وہ ارمان بھری برساتیں",
      "CoupletIndex": 125,
      "SectionIndex1": 0
    },
    {
      "VOrder": 249,
      "Position": "Right",
      "Text": "کس سے کہوں کس طور سے کاٹیں",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 250,
      "Position": "Left",
      "Text": "خیر کٹیں جس طور سے کاٹیں",
      "CoupletIndex": 126,
      "SectionIndex1": 0
    },
    {
      "VOrder": 251,
      "Position": "Right",
      "Text": "چاؤ کے اور خوشیوں کے سمے سب",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 252,
      "Position": "Left",
      "Text": "آتے ہیں خوش کل جان کو ہو جب",
      "CoupletIndex": 127,
      "SectionIndex1": 0
    },
    {
      "VOrder": 253,
      "Position": "Right",
      "Text": "رنج میں ہیں سامان خوشی کے",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 254,
      "Position": "Left",
      "Text": "اور جلانے والے ہی کے",
      "CoupletIndex": 128,
      "SectionIndex1": 0
    },
    {
      "VOrder": 255,
      "Position": "Right",
      "Text": "گھر برکھا اور پیا بدیسی",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 256,
      "Position": "Left",
      "Text": "آئیو برکھا کہیں نہ ایسی",
      "CoupletIndex": 129,
      "SectionIndex1": 0
    },
    {
      "VOrder": 257,
      "Position": "Right",
      "Text": "دن یہ جوانی کے کٹے ایسے",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 258,
      "Position": "Left",
      "Text": "باغ میں پنچھی قید ہو جیسے",
      "CoupletIndex": 130,
      "SectionIndex1": 0
    },
    {
      "VOrder": 259,
      "Position": "Right",
      "Text": "رت گئی ساری سر ٹکراتے",
      "CoupletIndex": 131,
      "SectionIndex1": 0
    },
    {
      "VOrder": 260,
      "Position": "Left",
      "Text": "اڑ نہ سکے پر ہوتے سارے",
      "CoupletIndex": 131,
      "SectionIndex1": 0
    },
    {
      "VOrder": 261,
      "Position": "Right",
      "Text": "کسی نے ہوگی کچھ کل پائی",
      "CoupletIndex": 132,
      "SectionIndex1": 0
    },
    {
      "VOrder": 262,
      "Position": "Left",
      "Text": "مجھے تو شادی راس نہ آئی",
      "CoupletIndex": 132,
      "SectionIndex1": 0
    },
    {
      "VOrder": 263,
      "Position": "Right",
      "Text": "آس بندھی لیکن نہ ملا کچھ",
      "CoupletIndex": 133,
      "SectionIndex1": 0
    },
    {
      "VOrder": 264,
      "Position": "Left",
      "Text": "پھول آیا اور پھل نہ لگا کچھ",
      "CoupletIndex": 133,
      "SectionIndex1": 0
    },
    {
      "VOrder": 265,
      "Position": "Right",
      "Text": "رہ گیا دے کر چاند دکھائی",
      "CoupletIndex": 134,
      "SectionIndex1": 0
    },
    {
      "VOrder": 266,
      "Position": "Left",
      "Text": "چاند ہوا پر عید نہ آئی",
      "CoupletIndex": 134,
      "SectionIndex1": 0
    },
    {
      "VOrder": 267,
      "Position": "Right",
      "Text": "پھل کی خاطر برچھی کھائی",
      "CoupletIndex": 135,
      "SectionIndex1": 0
    },
    {
      "VOrder": 268,
      "Position": "Left",
      "Text": "پھل نہ ملا اور جان گنوائی",
      "CoupletIndex": 135,
      "SectionIndex1": 0
    },
    {
      "VOrder": 269,
      "Position": "Right",
      "Text": "ریت میں ذرے دیکھ چمکتے",
      "CoupletIndex": 136,
      "SectionIndex1": 0
    },
    {
      "VOrder": 270,
      "Position": "Left",
      "Text": "دوڑ پڑی میں جھیل سمجھ کے",
      "CoupletIndex": 136,
      "SectionIndex1": 0
    },
    {
      "VOrder": 271,
      "Position": "Right",
      "Text": "چاروں کھونٹ نظر دوڑائی",
      "CoupletIndex": 137,
      "SectionIndex1": 0
    },
    {
      "VOrder": 272,
      "Position": "Left",
      "Text": "پر پانی کی بوند نہ پائی",
      "CoupletIndex": 137,
      "SectionIndex1": 0
    }
  ]
}
