  "Poems": [
    {
      "Id": 9698,
      "Title": "اچھا ہوا یہ وقت تو آنا ضرور تھا",
      "FullUrl": "/p320/ghazal/sh9698",
      "RadifLetter": "ا"
    },
    {
      "Id": 9706,
      "Title": "میان سے تیرا اگر خنجر نکل کر رہ گیا",
      "FullUrl": "/p320/ghazal/sh9706",
      "RadifLetter": "ا"
    },
    {
      "Id": 9699,
      "Title": "جور زمیں نہ تھا ستم آسماں نہ تھا",
      "FullUrl": "/p320/ghazal/sh9699",
      "RadifLetter": "ا"
    },
    {
      "Id": 9707,
      "Title": "میں شمع بزم عالم امکاں کیا گیا",
      "FullUrl": "/p320/ghazal/sh9707",
      "RadifLetter": "ا"
    },
    {
      "Id": 9697,
      "Title": "الفت عارض لیلیٰ میں پریشاں نکلا",
      "FullUrl": "/p320/ghazal/sh9697",
      "RadifLetter": "ا"
    },
    {
      "Id": 9715,
      "Title": "ہو چکا جو کہ مقدر میں تھا درماں ہونا",
      "FullUrl": "/p320/ghazal/sh9715",
      "RadifLetter": "ا"
    },
    {
      "Id": 9712,
      "Title": "کہنا نہ مانا کوچۂ قاتل میں رہ گیا",
      "FullUrl": "/p320/ghazal/sh9712",
      "RadifLetter": "ا"
    },
    {
      "Id": 9710,
      "Title": "نہ فلک ہوگا نہ یہ کوچۂ قاتل ہوگا",
      "FullUrl": "/p320/ghazal/sh9710",
      "RadifLetter": "ا"
    },
    {
      "Id": 9700,
      "Title": "ختم ہوگا اب سفر پیش نظر ہے روئے دوست",
      "FullUrl": "/p320/ghazal/sh9700",
      "RadifLetter": "ت"
    },
    {
      "Id": 9702,
      "Title": "دنیائے غم کو زیر و زبر کر سکے تو کر",
      "FullUrl": "/p320/ghazal/sh9702",
      "RadifLetter": "ر"
    },
    {
      "Id": 9705,
      "Title": "لیجئے ختم ہوا گردش تقدیر کا رنگ",
      "FullUrl": "/p320/ghazal/sh9705",
      "RadifLetter": "گ"
    },
    {
      "Id": 9696,
      "Title": "آپ دل کھول کر بیداد پہ بیداد کریں",
      "FullUrl": "/p320/ghazal/sh9696",
      "RadifLetter": "ن"
    },
    {
      "Id": 9713,
      "Title": "گھر کے گھبراتے نہ تھے ہجر کے آزاروں میں",
      "FullUrl": "/p320/ghazal/sh9713",
      "RadifLetter": "ن"
    },
    {
      "Id": 9703,
      "Title": "سر و گردن کی جدائی دیکھو",
      "FullUrl": "/p320/ghazal/sh9703",
      "RadifLetter": "و"
    },
    {
      "Id": 9695,
      "Title": "آخر نہ چلی کوئی بھی تدبیر ہماری",
      "FullUrl": "/p320/ghazal/sh9695",
      "RadifLetter": "ی"
    },
    {
      "Id": 9704,
      "Title": "شام تکلیف کی دنیا میں سحر ہو تو سہی",
      "FullUrl": "/p320/ghazal/sh9704",
      "RadifLetter": "ی"
    },
    {
      "Id": 9709,
      "Title": "نوح کا طوفان اک آنسو سے برپا کیجئے",
      "FullUrl": "/p320/ghazal/sh9709",
      "RadifLetter": "ے"
    },
    {
      "Id": 9701,
      "Title": "داد ملتی نظر اہل نظر سے پہلے",
      "FullUrl": "/p320/ghazal/sh9701",
      "RadifLetter": "ے"
    },
    {
      "Id": 9711,
      "Title": "کسی حسرت زدہ نے خود کشی منظور کی دل سے",
      "FullUrl": "/p320/ghazal/sh9711",
      "RadifLetter": "ے"
    }
  ]
