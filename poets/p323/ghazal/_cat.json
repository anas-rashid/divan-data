    {
      "Id": 9726,
      "Title": "ذکر ہر صبح و شام ہے تیرا",
      "FullUrl": "/p323/ghazal/sh9726"
    },
    {
      "Id": 9727,
      "Title": "لب شیریں ہے مصری یوسف ثانی ہے یہ لڑکا",
      "FullUrl": "/p323/ghazal/sh9727"
    },
    {
      "Id": 9724,
      "Title": "دیکھ موہن تری کمر کی طرف",
      "FullUrl": "/p323/ghazal/sh9724"
    },
    {
      "Id": 9730,
      "Title": "یہ دور گزرا کبھی نہ دیکھیں پیا کی انکھیاں خمار متیاں",
      "FullUrl": "/p323/ghazal/sh9730"
    },
    {
      "Id": 9721,
      "Title": "اے صبا کہہ بہار کی باتیں",
      "FullUrl": "/p323/ghazal/sh9721"
    },
    {
      "Id": 9725,
      "Title": "دیکھی بہار ہم نے کل زور مے کدے میں",
      "FullUrl": "/p323/ghazal/sh9725"
    },
    {
      "Id": 9723,
      "Title": "دل کا کھوج نہ پایا ہرگز دیکھا کھول جو قبروں کو",
      "FullUrl": "/p323/ghazal/sh9723"
    },
    {
      "Id": 9722,
      "Title": "تیرے بھائی کو چاہا اب تیری کرتا ہوں پا بوسی",
      "FullUrl": "/p323/ghazal/sh9722"
    },
    {
      "Id": 9729,
      "Title": "کمر کی بات سنتے ہیں یہ کچھ پائی نہیں جاتی",
      "FullUrl": "/p323/ghazal/sh9729"
    },
    {
      "Id": 9728,
      "Title": "مہ رخاں کی جو مہربانی ہے",
      "FullUrl": "/p323/ghazal/sh9728"
    }
  ]
}
