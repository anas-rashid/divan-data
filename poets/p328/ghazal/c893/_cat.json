  "Poems": [
    {
      "Id": 9769,
      "Title": "دیکھ تو فرقت میں کیا کیا حال دل پر غم ہوا",
      "FullUrl": "/p328/ghazal/c893/sh9769"
    },
    {
      "Id": 9762,
      "Title": "اس ستم گار نے سیکھا ہے خفا ہو جانا",
      "FullUrl": "/p328/ghazal/c893/sh9762"
    },
    {
      "Id": 9770,
      "Title": "قربان ہے سو جان سے تم پر گلہ کیسا",
      "FullUrl": "/p328/ghazal/c893/sh9770"
    },
    {
      "Id": 9764,
      "Title": "باتوں باتوں میں کیا خوں آج اک دلگیر کا",
      "FullUrl": "/p328/ghazal/c893/sh9764"
    },
    {
      "Id": 9767,
      "Title": "دلبر کا کیا گلہ کوئی غم خوار بھی نہیں",
      "FullUrl": "/p328/ghazal/c893/sh9767"
    },
    {
      "Id": 9775,
      "Title": "یوں مبتلا کسی پہ کوئی اے خدا نہ ہو",
      "FullUrl": "/p328/ghazal/c893/sh9775"
    },
    {
      "Id": 9773,
      "Title": "یاد آتی ہے مجھے جب خوش بیانی آپ کی",
      "FullUrl": "/p328/ghazal/c893/sh9773"
    },
    {
      "Id": 9766,
      "Title": "دل دھڑکنے لگا فریاد کی نوبت آئی",
      "FullUrl": "/p328/ghazal/c893/sh9766"
    },
    {
      "Id": 9774,
      "Title": "یاس و حسرت درد و غم ان سب کی منزل ایک ہے",
      "FullUrl": "/p328/ghazal/c893/sh9774"
    },
    {
      "Id": 9772,
      "Title": "کس طرح زخمی کیا تم نے نگاہ ناز سے",
      "FullUrl": "/p328/ghazal/c893/sh9772"
    },
    {
      "Id": 9768,
      "Title": "دوبارہ زیست کہیں غم میں مبتلا نہ کرے",
      "FullUrl": "/p328/ghazal/c893/sh9768"
    },
    {
      "Id": 9763,
      "Title": "اک قیامت ہے بپا شور دل دلگیر سے",
      "FullUrl": "/p328/ghazal/c893/sh9763"
    },
    {
      "Id": 9771,
      "Title": "میں تو عاجز ہوں تمہیں پوچھو دل ناکام سے",
      "FullUrl": "/p328/ghazal/c893/sh9771"
    },
    {
      "Id": 9765,
      "Title": "جاں اپنی وقف زحمت ہجراں کئے ہوئے",
      "FullUrl": "/p328/ghazal/c893/sh9765"
    }
  ]
}
