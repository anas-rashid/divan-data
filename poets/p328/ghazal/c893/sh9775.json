      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "یوں مبتلا کسی پہ کوئی اے خدا نہ ہو\r\nدل دے دیا ہو اور امید وفا نہ ہو\r\nتم بے نیاز ہو تو ہے قہر اس غریب پر\r\nجس کا بجز تمہارے کوئی آسرا نہ ہو\r\nمحو خرام آپ ہیں بے چین اہل قبر\r\nمجھ کو یہ خوف ہے کہ قیامت بپا نہ ہو\r\nصدمے اٹھائے ہیں تو دعا ہے یہ ناصریؔ\r\nان ظالموں پہ کوئی بشر مبتلا نہ ہو",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
