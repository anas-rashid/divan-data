      "Title": "دراز اتنا مری قید کا زمانہ تھا",
      "FullUrl": "/p329/ghazal/sh9784"
    },
    {
      "Id": 9796,
      "Title": "کبھی دامان دل پر داغ مایوسی نہیں آیا",
      "FullUrl": "/p329/ghazal/sh9796"
    },
    {
      "Id": 9788,
      "Title": "فروغ مہر سے رندوں کا آخر کام کیا ہوگا",
      "FullUrl": "/p329/ghazal/sh9788"
    },
    {
      "Id": 9785,
      "Title": "دوبارہ دل میں کوئی انقلاب ہو نہ سکا",
      "FullUrl": "/p329/ghazal/sh9785"
    },
    {
      "Id": 9791,
      "Title": "مرے مقدر میں جو لکھا تھا نصیب سے وہ پہنچ نہ پایا",
      "FullUrl": "/p329/ghazal/sh9791"
    },
    {
      "Id": 9790,
      "Title": "مجھ سے افسردہ نہ اے جوش بہاراں ہونا",
      "FullUrl": "/p329/ghazal/sh9790"
    },
    {
      "Id": 9782,
      "Title": "جو میرے دل میں سہو تری یاد سے ہوا",
      "FullUrl": "/p329/ghazal/sh9782"
    },
    {
      "Id": 9777,
      "Title": "ایک دنیا مست اک عالم خراب",
      "FullUrl": "/p329/ghazal/sh9777"
    },
    {
      "Id": 9778,
      "Title": "اے شمع تجھ پہ رات یہ بھاری ہے جس طرح",
      "FullUrl": "/p329/ghazal/sh9778"
    },
    {
      "Id": 9781,
      "Title": "جسے ڈھونڈا اسے پایا اسے تدبیر کہتے ہیں",
      "FullUrl": "/p329/ghazal/sh9781"
    },
    {
      "Id": 9792,
      "Title": "میں جو یہ آشیاں بناتا ہوں",
      "FullUrl": "/p329/ghazal/sh9792"
    },
    {
      "Id": 9798,
      "Title": "ہے وہی ناز آفریں آئینہ نیاز میں",
      "FullUrl": "/p329/ghazal/sh9798"
    },
    {
      "Id": 9793,
      "Title": "نہ قطرہ کم ہے نہ کافی تمام مے خانہ",
      "FullUrl": "/p329/ghazal/sh9793"
    },
    {
      "Id": 9779,
      "Title": "بے دلوں کی آبرو رہ جائے گی",
      "FullUrl": "/p329/ghazal/sh9779"
    },
    {
      "Id": 9786,
      "Title": "صدقے ترے ہوتے ہیں سورج بھی ستارے بھی",
      "FullUrl": "/p329/ghazal/sh9786"
    },
    {
      "Id": 9789,
      "Title": "قید میں بھی ہے جنوں دست و گریباں ہم سے",
      "FullUrl": "/p329/ghazal/sh9789"
    },
    {
      "Id": 9787,
      "Title": "فراق یار کا خطرہ وصال یار میں ہے",
      "FullUrl": "/p329/ghazal/sh9787"
    },
    {
      "Id": 9776,
      "Title": "آنسوؤں سے خون کے اجزا بدلتے جائیں گے",
      "FullUrl": "/p329/ghazal/sh9776"
    },
    {
      "Id": 9797,
      "Title": "کیا بتاؤں دل کہاں ہے اور کس جا درد ہے",
      "FullUrl": "/p329/ghazal/sh9797"
    },
    {
      "Id": 9780,
      "Title": "تیرے سوا نگاہوں میں اے یار کون ہے",
      "FullUrl": "/p329/ghazal/sh9780"
    },
    {
      "Id": 9783,
      "Title": "خون دل کا جو کچھ اشکوں سے پتہ ملتا ہے",
      "FullUrl": "/p329/ghazal/sh9783"
    },
    {
      "Id": 9794,
      "Title": "وقت رخصت چلتے چلتے کہہ گئے",
      "FullUrl": "/p329/ghazal/sh9794"
    },
    {
      "Id": 9795,
      "Title": "پرتو نور بھی ہے جوہر تنویر بھی ہے",
      "FullUrl": "/p329/ghazal/sh9795"
    },
    {
      "Id": 9799,
      "Title": "یہ دل نہیں نور کا ہے شعلہ کسی کو اس سے ضرر نہیں ہے",
      "FullUrl": "/p329/ghazal/sh9799"
    }
  ]
