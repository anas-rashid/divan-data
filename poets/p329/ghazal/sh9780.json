      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تیرے سوا نگاہوں میں اے یار کون ہے\r\nحیراں ہوں میں کہ طالب دیدار کون ہے\r\nہر قطرہ اشک شوق ہے ہر ذرہ چشم شوق\r\nکیا پوچھتے ہو طالب دیدار کون ہے\r\nسب حسرتوں کو راز محبت بنا چکا\r\nاب سوچتا ہوں لایق اظہار کون ہے\r\nناطقؔ کسی کو دے دو دل زار نذر میں\r\nاس جنس بے بہا کا خریدار کون ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
