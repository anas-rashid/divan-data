  "Poems": [
    {
      "Id": 798,
      "Title": "آغوش میں جو جلوہ گر اک نازنیں ہوا",
      "FullUrl": "/p33/ghazal/sh798"
    },
    {
      "Id": 799,
      "Title": "الجھا دل ستم زدہ زلف بتاں سے آج",
      "FullUrl": "/p33/ghazal/sh799"
    },
    {
      "Id": 800,
      "Title": "بانی جور و جفا ہیں ستم ایجاد ہیں سب",
      "FullUrl": "/p33/ghazal/sh800"
    },
    {
      "Id": 801,
      "Title": "بھولا ہوں میں عالم کو سرشار اسے کہتے ہیں",
      "FullUrl": "/p33/ghazal/sh801"
    },
    {
      "Id": 802,
      "Title": "خانۂ زنجیر کا پابند رہتا ہوں سدا",
      "FullUrl": "/p33/ghazal/sh802"
    },
    {
      "Id": 803,
      "Title": "دکھلائے خدا اس ستم ایجاد کی صورت",
      "FullUrl": "/p33/ghazal/sh803"
    },
    {
      "Id": 804,
      "Title": "رواں دواں نہیں یاں اشک چشم تر کی طرح",
      "FullUrl": "/p33/ghazal/sh804"
    },
    {
      "Id": 805,
      "Title": "روح کو راہ عدم میں مرا تن یاد آیا",
      "FullUrl": "/p33/ghazal/sh805"
    },
    {
      "Id": 806,
      "Title": "زمزمہ کس کی زباں پر بہ دل شاد آیا",
      "FullUrl": "/p33/ghazal/sh806"
    },
    {
      "Id": 807,
      "Title": "صبح وصال زیست کا نقشہ بدل گیا",
      "FullUrl": "/p33/ghazal/sh807"
    },
    {
      "Id": 808,
      "Title": "لطف اب زیست کا اے گردش ایام نہیں",
      "FullUrl": "/p33/ghazal/sh808"
    },
    {
      "Id": 809,
      "Title": "گر پڑے دانت ہوئے موئے سر اے یار سفید",
      "FullUrl": "/p33/ghazal/sh809"
    },
    {
      "Id": 810,
      "Title": "ہیں جلوۂ تن سے در و دیوار بسنتی",
      "FullUrl": "/p33/ghazal/sh810"
    }
  ]
