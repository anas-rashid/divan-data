    {
      "Id": 9803,
      "Title": "جس کو وہ نقش پا نہیں ملتا",
      "FullUrl": "/p330/ghazal/c898/sh9803",
      "RadifLetter": "ا"
    },
    {
      "Id": 9810,
      "Title": "پردہ میں سمت غرب کے مہتاب بھی گیا",
      "FullUrl": "/p330/ghazal/c898/sh9810",
      "RadifLetter": "ا"
    },
    {
      "Id": 9800,
      "Title": "اک کافر مغرور دل آرام ہے میرا",
      "FullUrl": "/p330/ghazal/c898/sh9800",
      "RadifLetter": "ا"
    },
    {
      "Id": 9805,
      "Title": "رحم کر ظالم مرا حال پریشاں دیکھ کر",
      "FullUrl": "/p330/ghazal/c898/sh9805",
      "RadifLetter": "ر"
    },
    {
      "Id": 9801,
      "Title": "اے ہم نشیں خدا کے لئے امتحاں نہ کر",
      "FullUrl": "/p330/ghazal/c898/sh9801",
      "RadifLetter": "ر"
    },
    {
      "Id": 9804,
      "Title": "دیواں وفور غم سے مرا رہ گیا غلط",
      "FullUrl": "/p330/ghazal/c898/sh9804",
      "RadifLetter": "ط"
    },
    {
      "Id": 9811,
      "Title": "ہے غلط گر عشق ہے یاری کا نام",
      "FullUrl": "/p330/ghazal/c898/sh9811",
      "RadifLetter": "م"
    },
    {
      "Id": 9802,
      "Title": "تپ الم کو جگر میں چھپا کے دیکھتے ہیں",
      "FullUrl": "/p330/ghazal/c898/sh9802",
      "RadifLetter": "ن"
    },
    {
      "Id": 9807,
      "Title": "سکھایا عقل نے برسوں ہمیں علم و ہنر سب کچھ",
      "FullUrl": "/p330/ghazal/c898/sh9807",
      "RadifLetter": "ھ"
    },
    {
      "Id": 9806,
      "Title": "سناتا کیا میں اسے طاقت بیان نہ تھی",
      "FullUrl": "/p330/ghazal/c898/sh9806",
      "RadifLetter": "ی"
    },
    {
      "Id": 9808,
      "Title": "لے گیا دل کون میرا سو بشر کے سامنے",
      "FullUrl": "/p330/ghazal/c898/sh9808",
      "RadifLetter": "ے"
    },
    {
      "Id": 9809,
      "Title": "وحشی ہوں میں کیا شے ہے بیاباں مرے آگے",
