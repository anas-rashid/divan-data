  "Poems": [
    {
      "Id": 9813,
      "Title": "آپ وہ سب کی جان لیتے ہیں",
      "FullUrl": "/p332/ghazal/sh9813"
    },
    {
      "Id": 9814,
      "Title": "ان کے پیکان پہ پیکان چلے آتے ہیں",
      "FullUrl": "/p332/ghazal/sh9814"
    },
    {
      "Id": 9815,
      "Title": "بہار آئی ہے پھر وحشت کے ساماں ہوتے جاتے ہیں",
      "FullUrl": "/p332/ghazal/sh9815"
    },
    {
      "Id": 9816,
      "Title": "بیتاب ہیں کسی کی نگاہیں نقاب میں",
      "FullUrl": "/p332/ghazal/sh9816"
    },
    {
      "Id": 9817,
      "Title": "جدھر دیکھ تمہاری بزم میں اغیار بیٹھے ہیں",
      "FullUrl": "/p332/ghazal/sh9817"
    },
    {
      "Id": 9818,
      "Title": "جور پیہم کی انتہا بھی ہے",
      "FullUrl": "/p332/ghazal/sh9818"
    },
    {
      "Id": 9819,
      "Title": "جہاں میں ابھی یوں تو کیا کیا نہ ہوگا",
      "FullUrl": "/p332/ghazal/sh9819"
    },
    {
      "Id": 9820,
      "Title": "دکھائے معجزے گر وہ بت عیار چٹکی میں",
      "FullUrl": "/p332/ghazal/sh9820"
    },
    {
      "Id": 9821,
      "Title": "دے دیں ابھی کرے جو کوئی خوب رو پسند",
      "FullUrl": "/p332/ghazal/sh9821"
    },
    {
      "Id": 9822,
      "Title": "ذکر ایفا کچھ نہیں وعدہ ہی وعدہ ہم سے ہے",
      "FullUrl": "/p332/ghazal/sh9822"
    },
    {
      "Id": 9823,
      "Title": "ذکر دشمن ہے ناگوار کسے",
      "FullUrl": "/p332/ghazal/sh9823"
    },
    {
      "Id": 9824,
      "Title": "رکھنا خم گیسو میں یا دل کو رہا کرنا",
      "FullUrl": "/p332/ghazal/sh9824"
    },
    {
      "Id": 9825,
      "Title": "سب لطف ہے خاک زندگی کا",
      "FullUrl": "/p332/ghazal/sh9825"
    },
    {
      "Id": 9826,
      "Title": "شب فرقت قضا نہیں آتی",
      "FullUrl": "/p332/ghazal/sh9826"
    },
    {
      "Id": 9827,
      "Title": "غیر کے گھر بن کے ڈالی جائے گی",
      "FullUrl": "/p332/ghazal/sh9827"
    },
    {
      "Id": 9828,
      "Title": "غیر کے گھر ہیں وہ مہمان بڑی مشکل ہے",
      "FullUrl": "/p332/ghazal/sh9828"
    },
    {
      "Id": 9829,
      "Title": "میرے تڑپنے نے تماشا کیا",
      "FullUrl": "/p332/ghazal/sh9829"
    },
    {
      "Id": 9830,
      "Title": "نالۂ دل کمال کا نکلا",
      "FullUrl": "/p332/ghazal/sh9830"
    },
    {
      "Id": 9831,
      "Title": "نہ مانی اس نے ایک بھی دل کی",
      "FullUrl": "/p332/ghazal/sh9831"
    },
    {
      "Id": 9832,
      "Title": "کیا خاک کہوں مطلب دل دار کے آگے",
      "FullUrl": "/p332/ghazal/sh9832"
    },
    {
      "Id": 9833,
      "Title": "ہجر میں جب خیال یار آیا",
      "FullUrl": "/p332/ghazal/sh9833"
    },
    {
      "Id": 9834,
      "Title": "ہم یار کی غیروں پہ نظر دیکھ رہے ہیں",
      "FullUrl": "/p332/ghazal/sh9834"
    },
    {
      "Id": 9835,
      "Title": "ہوں گے دل و جگر میں نشاں دیکھ لیجئے",
      "FullUrl": "/p332/ghazal/sh9835"
    },
    {
      "Id": 9836,
      "Title": "یوں ہی گر عدو کی غلامی کریں گے",
      "FullUrl": "/p332/ghazal/sh9836"
    }
  ]
}
