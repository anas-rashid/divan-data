  "Poems": [
    {
      "Id": 9890,
      "Title": "آئی بہار دور ہو ساقی شراب کا",
      "FullUrl": "/p334/ghazal/sh9890"
    },
    {
      "Id": 9891,
      "Title": "آج صیاد نے بھولے سے چمن دکھلایا",
      "FullUrl": "/p334/ghazal/sh9891"
    },
    {
      "Id": 9892,
      "Title": "تری گلی میں جو آئے وہ گھر نہیں جاتے",
      "FullUrl": "/p334/ghazal/sh9892"
    },
    {
      "Id": 9893,
      "Title": "جنبش ابروئے قاتل کبھی ایسی تو نہ تھی",
      "FullUrl": "/p334/ghazal/sh9893"
    },
    {
      "Id": 9894,
      "Title": "دریا و موج سا کبھی ہم سے جدا نہ ہو",
      "FullUrl": "/p334/ghazal/sh9894"
    },
    {
      "Id": 9895,
      "Title": "سبزۂ خط ہے پیمبر رخ ہے قرآن بہار",
      "FullUrl": "/p334/ghazal/sh9895"
    },
    {
      "Id": 9896,
      "Title": "سر کو نوشہ کے مرے شاہ نے باندھا سہرا",
      "FullUrl": "/p334/ghazal/sh9896"
    },
    {
      "Id": 9897,
      "Title": "قبول کیجیے انکار کا مقام نہیں",
      "FullUrl": "/p334/ghazal/sh9897"
    },
    {
      "Id": 9898,
      "Title": "ملے بے نشاں کے نشاں کیسے کیسے",
      "FullUrl": "/p334/ghazal/sh9898"
    },
    {
      "Id": 9899,
      "Title": "مہرباں مجھ پہ ہو اے رشک قمر آج کی رات",
      "FullUrl": "/p334/ghazal/sh9899"
    },
    {
      "Id": 9900,
      "Title": "میرے احوال کا افسانہ بنایا ہوتا",
      "FullUrl": "/p334/ghazal/sh9900"
    },
    {
      "Id": 9901,
      "Title": "میں نہ منت کش انگور ہوا خوب ہوا",
      "FullUrl": "/p334/ghazal/sh9901"
    },
    {
      "Id": 9902,
      "Title": "وہ بیکلی نہیں دل کو وہ اضطراب نہیں",
      "FullUrl": "/p334/ghazal/sh9902"
    }
  ]
}
