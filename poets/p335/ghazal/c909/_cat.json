  "Title": "دیوان نشتر (۱۹۳۰)",
  "FullUrl": "/p335/ghazal/c909",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 9909,
      "Title": "درد وہ تو نے دیا جس کا مداوا نہ ہوا",
      "FullUrl": "/p335/ghazal/c909/sh9909",
      "RadifLetter": "ا"
    },
    {
      "Id": 9914,
      "Title": "وہ بھی کیا دن تھے کہ جب چاہ نہ تھی پیار نہ تھا",
      "FullUrl": "/p335/ghazal/c909/sh9914",
      "RadifLetter": "ا"
    },
    {
      "Id": 9913,
      "Title": "نہ جس میں آرزو ہوتی نہ جس میں مدعا ہوتا",
      "FullUrl": "/p335/ghazal/c909/sh9913",
      "RadifLetter": "ا"
    },
    {
      "Id": 9905,
      "Title": "اک غیر کہ محفل سے اٹھایا نہیں جاتا",
      "FullUrl": "/p335/ghazal/c909/sh9905",
      "RadifLetter": "ا"
    },
    {
      "Id": 9908,
      "Title": "جب عشق کا جنوں مرے سر پر سوار تھا",
      "FullUrl": "/p335/ghazal/c909/sh9908",
      "RadifLetter": "ا"
    },
    {
      "Id": 9910,
      "Title": "عبث فکر دوا میں ہے پریشاں چارہ گر میرا",
      "FullUrl": "/p335/ghazal/c909/sh9910",
      "RadifLetter": "ا"
    },
    {
      "Id": 9904,
      "Title": "ان کی باتوں کو کچھ قیام نہیں",
      "FullUrl": "/p335/ghazal/c909/sh9904",
      "RadifLetter": "ن"
    },
    {
      "Id": 9911,
      "Title": "میں کیا کہوں کہ حال ہے کیا ہجر یار میں",
      "FullUrl": "/p335/ghazal/c909/sh9911",
      "RadifLetter": "ن"
    },
    {
      "Id": 9907,
      "Title": "تیر مژگاں کو تو پیکان قضا کہتے ہیں",
      "FullUrl": "/p335/ghazal/c909/sh9907",
      "RadifLetter": "ن"
    },
    {
      "Id": 9912,
      "Title": "نہ بکھرایا کرو تم بیٹھے بیٹھے زلف پیچاں کو",
      "FullUrl": "/p335/ghazal/c909/sh9912",
      "RadifLetter": "و"
    },
    {
      "Id": 9906,
      "Title": "تم ہجر کے جھگڑوں کو مٹا کیوں نہیں دیتے",
      "FullUrl": "/p335/ghazal/c909/sh9906",
      "RadifLetter": "ے"
    },
    {
      "Id": 9915,
      "Title": "کیا بچے دل جان لیوا اس کا ہر انداز ہے",
      "FullUrl": "/p335/ghazal/c909/sh9915",
      "RadifLetter": "ے"
    },
    {
      "Id": 9903,
      "Title": "آئے ہیں فاتحہ کو وہ گیسو سنوار کے",
      "FullUrl": "/p335/ghazal/c909/sh9903",
      "RadifLetter": "ے"
    }
  ]
}
