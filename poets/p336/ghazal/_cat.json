      "RadifLetter": "ا"
    },
    {
      "Id": 9938,
      "Title": "مجھ سے کیوں کہتے ہو مضموں غیر کی تحریر کا",
      "FullUrl": "/p336/ghazal/sh9938",
      "RadifLetter": "ا"
    },
    {
      "Id": 9951,
      "Title": "کہنے سے نہ منع کر کہوں گا",
      "FullUrl": "/p336/ghazal/sh9951",
      "RadifLetter": "ا"
    },
    {
      "Id": 9950,
      "Title": "کہتے ہیں سن کے ماجرا میرا",
      "FullUrl": "/p336/ghazal/sh9950",
      "RadifLetter": "ا"
    },
    {
      "Id": 9955,
      "Title": "گر دوستو تم نے اسے دیکھا نہیں ہوتا",
      "FullUrl": "/p336/ghazal/sh9955",
      "RadifLetter": "ا"
    },
    {
      "Id": 9960,
      "Title": "یاں کسے غم ہے جو گریہ نے اثر چھوڑ دیا",
