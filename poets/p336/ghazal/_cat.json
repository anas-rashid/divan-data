      "RadifLetter": "ا"
    },
    {
      "Id": 9933,
      "Title": "دیکھیے تو خیال خام مرا",
      "FullUrl": "/p336/ghazal/sh9933",
      "RadifLetter": "ا"
    },
    {
      "Id": 9956,
      "Title": "گر کہوں مطلب تمہارا کھل گیا",
      "FullUrl": "/p336/ghazal/sh9956",
      "RadifLetter": "ا"
    },
    {
      "Id": 9930,
      "Title": "دل لگے ہجر میں کیوں کر میرا",
      "FullUrl": "/p336/ghazal/sh9930",
      "RadifLetter": "ا"
    },
    {
