  "ChildCats": [],
  "Poems": [
    {
      "Id": 9991,
      "Title": "یہ ہوا مآل حباب کا جو ہوا میں بھر کے ابھر گیا",
      "FullUrl": "/p337/ghazal/sh9991",
      "RadifLetter": "ا"
    },
    {
      "Id": 9980,
      "Title": "پرسش جو ہوگی تجھ سے جلاد کیا کرے گا",
      "FullUrl": "/p337/ghazal/sh9980",
      "RadifLetter": "ا"
    },
    {
      "Id": 9963,
      "Title": "آ گیا پھر رمضاں کیا ہوگا",
      "FullUrl": "/p337/ghazal/sh9963",
      "RadifLetter": "ا"
    },
    {
      "Id": 9984,
      "Title": "کوئی مے دے یا نہ دے ہم رند بے پروا ہیں آپ",
      "FullUrl": "/p337/ghazal/sh9984",
      "RadifLetter": "پ"
    },
    {
      "Id": 9965,
      "Title": "اس مہینہ بھر کہاں تھا ساقیا اچھی طرح",
      "FullUrl": "/p337/ghazal/sh9965",
      "RadifLetter": "ح"
    },
    {
      "Id": 9970,
      "Title": "جنوں کے ولولے جب گھٹ گئے دل میں نہاں ہو کر",
      "FullUrl": "/p337/ghazal/sh9970",
      "RadifLetter": "ر"
    },
    {
      "Id": 9987,
      "Title": "ہنسی میں وہ بات میں نے کہہ دی کہ رہ گئے آپ دنگ ہو کر",
      "FullUrl": "/p337/ghazal/sh9987",
      "RadifLetter": "ر"
    },
    {
      "Id": 9964,
      "Title": "احسان لے نہ ہمت مردانہ چھوڑ کر",
      "FullUrl": "/p337/ghazal/sh9964",
      "RadifLetter": "ر"
    },
    {
      "Id": 9989,
      "Title": "یوں میں سیدھا گیا وحشت میں بیاباں کی طرف",
      "FullUrl": "/p337/ghazal/sh9989",
      "RadifLetter": "ف"
    },
    {
      "Id": 9981,
      "Title": "پھری ہوئی مری آنکھیں ہیں تیغ زن کی طرف",
      "FullUrl": "/p337/ghazal/sh9981",
      "RadifLetter": "ف"
    },
    {
      "Id": 9977,
      "Title": "مجھ کو سمجھو یادگار رفتگان لکھنؤ",
      "FullUrl": "/p337/ghazal/sh9977",
      "RadifLetter": "ن"
    },
    {
      "Id": 9966,
      "Title": "اس واسطے عدم کی منزل کو ڈھونڈتے ہیں",
      "FullUrl": "/p337/ghazal/sh9966",
      "RadifLetter": "ن"
    },
    {
      "Id": 9985,
      "Title": "کیا کاروان ہستی گزرا روا روی میں",
      "FullUrl": "/p337/ghazal/sh9985",
      "RadifLetter": "ن"
    },
    {
      "Id": 9974,
      "Title": "سنگ جفا کا غم نہیں دست طلب کا ڈر نہیں",
      "FullUrl": "/p337/ghazal/sh9974",
      "RadifLetter": "ن"
    },
    {
      "Id": 9983,
      "Title": "کسی سے بس کہ امید کشود کار نہیں",
      "FullUrl": "/p337/ghazal/sh9983",
      "RadifLetter": "ن"
    },
    {
      "Id": 9976,
      "Title": "عبث ہے ناز استغنا پہ کل کی کیا خبر کیا ہو",
      "FullUrl": "/p337/ghazal/sh9976",
      "RadifLetter": "و"
    },
    {
      "Id": 9990,
      "Title": "یہ آہ بے اثر کیا ہو یہ نخل بے ثمر کیا ہو",
      "FullUrl": "/p337/ghazal/sh9990",
      "RadifLetter": "و"
    },
    {
      "Id": 9978,
      "Title": "ندامت ہے بنا کر اس چمن میں آشیاں مجھ کو",
      "FullUrl": "/p337/ghazal/sh9978",
      "RadifLetter": "و"
    },
    {
      "Id": 9988,
      "Title": "یوں تو نہ تیرے جسم میں ہیں زینہار ہاتھ",
      "FullUrl": "/p337/ghazal/sh9988",
      "RadifLetter": "ھ"
    },
    {
      "Id": 9982,
      "Title": "کس لیے پھرتے ہیں یہ شمس و قمر دونوں ساتھ",
      "FullUrl": "/p337/ghazal/sh9982",
      "RadifLetter": "ھ"
    },
    {
      "Id": 9962,
      "Title": "آ کے مجھ تک کشتیٔ مے ساقیا الٹی پھری",
      "FullUrl": "/p337/ghazal/sh9962",
      "RadifLetter": "ی"
    },
    {
      "Id": 9973,
      "Title": "سبحہ ہے زنار کیوں کیسی کہی",
      "FullUrl": "/p337/ghazal/sh9973",
      "RadifLetter": "ی"
    },
    {
      "Id": 9969,
      "Title": "تنہا نہیں ہوں گر دل دیوانہ ساتھ ہے",
      "FullUrl": "/p337/ghazal/sh9969",
      "RadifLetter": "ے"
    },
    {
      "Id": 9967,
      "Title": "اڑا کر کاگ شیشہ سے مے گلگوں نکلتی ہے",
      "FullUrl": "/p337/ghazal/sh9967",
      "RadifLetter": "ے"
    },
    {
      "Id": 9968,
      "Title": "بدعت مسنون ہو گئی ہے",
      "FullUrl": "/p337/ghazal/sh9968",
      "RadifLetter": "ے"
    }
  ]
}
