      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "اے دل اپنی تو چاہ پر مت پھول\r\nدلبروں کی نگاہ پر مت پھول\r\nعشق کرتا ہے ہوش کو برباد\r\nعقل کی رسم و راہ پر مت پھول\r\nدام ہے وہ ارے کمند ہے وہ\r\nدیکھ زلف سیاہ پر مت پھول\r\nواہ کہہ کر جو ہے وہ ہنس دیتا\r\nآہ اس ڈھب کی واہ پر مت پھول\r\nگر پڑے گا نظیرؔ کی مانند\r\nتو زنخداں کی چاہ پر مت پھول",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
