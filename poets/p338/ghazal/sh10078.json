      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دل یار کی گلی میں کر آرام رہ گیا\r\nپایا جہاں فقیر نے بسرام رہ گیا\r\nکس کس نے اس کے عشق میں مارا نہ دم ولے\r\nسب چل بسے مگر وہ دل آرام رہ گیا\r\nجس کام کو جہاں میں تو آیا تھا اے نظیرؔ\r\nخانہ خراب تجھ سے وہی کام رہ گیا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
