  "Poems": [
    {
      "Id": 9992,
      "Title": "آئینہ جو ہاتھ اس کے نے تا دیر لیا",
      "FullUrl": "/p338/rubai/sh9992"
    },
    {
      "Id": 10003,
      "Title": "اس زلف نے ہم سے لے کے دل بستہ کیا",
      "FullUrl": "/p338/rubai/sh10003"
    },
    {
      "Id": 10004,
      "Title": "اس شوخ کو ہم نے جس گھڑی جا دیکھا",
      "FullUrl": "/p338/rubai/sh10004"
    },
    {
      "Id": 10016,
      "Title": "اے دل جو یہ آنکھ آج لڑائی اس نے",
      "FullUrl": "/p338/rubai/sh10016"
    },
    {
      "Id": 10071,
      "Title": "دل دیکھ اسے جس گھڑی بے تاب ہوا",
      "FullUrl": "/p338/rubai/sh10071"
    },
    {
      "Id": 10096,
      "Title": "رکھتی ہے جو خوش چاہ تمہاری ہم کو",
      "FullUrl": "/p338/rubai/sh10096"
    },
    {
      "Id": 10097,
      "Title": "رکھتے ہیں جو ہم چاہ تمہاری دل میں",
      "FullUrl": "/p338/rubai/sh10097"
    },
    {
      "Id": 10102,
      "Title": "ساقی سے جو ہم نے مے کا اک جام لیا",
      "FullUrl": "/p338/rubai/sh10102"
    },
    {
      "Id": 10138,
      "Title": "محبوب نے پیرہن میں جب عطر ملا",
      "FullUrl": "/p338/rubai/sh10138"
    },
    {
      "Id": 10148,
      "Title": "مکھڑے کو جو اس کے ہم نے جا کر دیکھا",
      "FullUrl": "/p338/rubai/sh10148"
    },
    {
      "Id": 10153,
      "Title": "ناصح نہ سنا سخن مجھے جس تس کے",
      "FullUrl": "/p338/rubai/sh10153"
    },
    {
      "Id": 10174,
      "Title": "پان اس کے لبوں پہ اس قدر ہے زیبا",
      "FullUrl": "/p338/rubai/sh10174"
    },
    {
      "Id": 10177,
      "Title": "پس اس کے گئے سپر جو ہم کر سینہ",
      "FullUrl": "/p338/rubai/sh10177"
    },
    {
      "Id": 10199,
      "Title": "کوچے میں تمہارے ہم جو ٹک آتے ہیں",
      "FullUrl": "/p338/rubai/sh10199"
    },
    {
      "Id": 10215,
      "Title": "کیا حال اب اس سے اپنے دل کا کہئے",
      "FullUrl": "/p338/rubai/sh10215"
    },
    {
      "Id": 10224,
      "Title": "گر یار سے ہر روز ملاقات نہیں",
      "FullUrl": "/p338/rubai/sh10224"
    },
    {
      "Id": 10229,
      "Title": "ہم اس کی جفا سے جی میں ہو کر دلگیر",
      "FullUrl": "/p338/rubai/sh10229"
    },
    {
      "Id": 10232,
      "Title": "ہم دل سے جو چاہتے ہیں اے جان تمہیں",
      "FullUrl": "/p338/rubai/sh10232"
    },
    {
      "Id": 10233,
      "Title": "ہم دیکھ کے تم سے رخ آرام میاں",
      "FullUrl": "/p338/rubai/sh10233"
    },
    {
      "Id": 10254,
      "Title": "ہوں کیوں نہ بتوں کی ہم کو دل سے چاہیں",
      "FullUrl": "/p338/rubai/sh10254"
    },
    {
      "Id": 10258,
      "Title": "ہے چاہ نے اس کی جب سے کی جا دل میں",
      "FullUrl": "/p338/rubai/sh10258"
    },
    {
      "Id": 10259,
      "Title": "یاد آتی ہیں جب ہمیں وہ پہلی چاہیں",
      "FullUrl": "/p338/rubai/sh10259"
    }
  ]
}
