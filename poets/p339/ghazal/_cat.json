  "Poems": [
    {
      "Id": 10271,
      "Title": "انداز کہیں دیکھا ہے مستانہ کسی کا",
      "FullUrl": "/p339/ghazal/sh10271",
      "RadifLetter": "ا"
    },
    {
      "Id": 10275,
      "Title": "سامنا ہے نگاہ قاتل کا",
      "FullUrl": "/p339/ghazal/sh10275",
      "RadifLetter": "ا"
    },
    {
      "Id": 10274,
      "Title": "خیال اتنا ستم ایجاد رکھنا",
      "FullUrl": "/p339/ghazal/sh10274",
      "RadifLetter": "ا"
    },
    {
      "Id": 10273,
      "Title": "اے دل ہوا ہے جیسے مرے دل کو تو پسند",
      "FullUrl": "/p339/ghazal/sh10273",
      "RadifLetter": "د"
    },
    {
      "Id": 10278,
      "Title": "گزارے ہجر میں برسوں ہی وصل یار کے بعد",
      "FullUrl": "/p339/ghazal/sh10278",
      "RadifLetter": "د"
    },
    {
      "Id": 10272,
      "Title": "ایسے حسیں کے عشق میں ہے بے قرار دل",
      "FullUrl": "/p339/ghazal/sh10272",
      "RadifLetter": "ل"
    },
    {
      "Id": 10270,
      "Title": "ان بتوں کی جو چاہ کرتے ہیں",
      "FullUrl": "/p339/ghazal/sh10270",
      "RadifLetter": "ن"
    },
    {
      "Id": 10277,
      "Title": "کیوں ہو نہ ہمیں عشق صنم اور زیادہ",
      "FullUrl": "/p339/ghazal/sh10277",
      "RadifLetter": "ہ"
    },
    {
      "Id": 10276,
      "Title": "چلتا ہے آفتاب کا دور اس قمر کے ساتھ",
      "FullUrl": "/p339/ghazal/sh10276",
      "RadifLetter": "ھ"
    }
  ]
}
