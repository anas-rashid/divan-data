  "Poems": [
    {
      "Id": 811,
      "Title": "اس جسم کی کیچلی میں اک ناگ بھی ہے",
      "FullUrl": "/p34/rubai/sh811"
    },
    {
      "Id": 812,
      "Title": "اصلیت اگر نہیں تو دھوکا ہی سہی",
      "FullUrl": "/p34/rubai/sh812"
    },
    {
      "Id": 813,
      "Title": "جو معنیٔ مضموں ہے وہی عنواں ہے",
      "FullUrl": "/p34/rubai/sh813"
    },
    {
      "Id": 814,
      "Title": "جو کچھ مصیبتیں ہیں تجھ پر کم ہیں",
      "FullUrl": "/p34/rubai/sh814"
    },
    {
      "Id": 815,
      "Title": "دنیا کے ہر ایک ذرے سے گھبراتا ہوں",
      "FullUrl": "/p34/rubai/sh815"
    },
    {
      "Id": 816,
      "Title": "سب کہتے ہیں مرکز بدی ہے دنیا",
      "FullUrl": "/p34/rubai/sh816"
    },
    {
      "Id": 817,
      "Title": "سرمایۂ علم و فضل کھویا میں نے",
      "FullUrl": "/p34/rubai/sh817"
    },
    {
      "Id": 818,
      "Title": "مر مر کے لحد میں میں نے جا پائی ہے",
      "FullUrl": "/p34/rubai/sh818"
    },
    {
      "Id": 820,
      "Title": "کم ظرف اگر دولت و زر پاتا ہے",
      "FullUrl": "/p34/rubai/sh820"
    },
    {
      "Id": 821,
      "Title": "کچھ وقت سے ایک بیج شجر ہوتا ہے",
      "FullUrl": "/p34/rubai/sh821"
    },
    {
      "Id": 822,
      "Title": "گرمی میں غم لبادہ نازیبا ہے",
      "FullUrl": "/p34/rubai/sh822"
    },
    {
      "Id": 823,
      "Title": "ہر ذرے پہ فضل کبریا ہوتا ہے",
      "FullUrl": "/p34/rubai/sh823"
    },
    {
      "Id": 824,
      "Title": "ہر قطرے میں بحر معرفت مضمر ہے",
      "FullUrl": "/p34/rubai/sh824"
    },
    {
      "Id": 825,
      "Title": "ہر محفل سے بہ حال خستہ نکلا",
      "FullUrl": "/p34/rubai/sh825"
    },
    {
      "Id": 826,
      "Title": "ہے ان کی یہی خوشی کہ ہم غم میں رہیں",
      "FullUrl": "/p34/rubai/sh826"
    },
    {
      "Id": 828,
      "Title": "یہ سنگ نشاں ہے منزل وحدت کا",
      "FullUrl": "/p34/rubai/sh828"
    }
  ]
}
