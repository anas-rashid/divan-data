      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دل ہماری طرف سے صاف کرو\r\nجو ہوا سو ہوا معاف کرو\r\nمجھ سے کہتی ہے اس کی شان کرم\r\nتم گناہوں کا اعتراف کرو\r\nحسن ان کو یہ رائے دیتا ہے\r\nکام امید کے خلاف کرو\r\nحضرت دل یہی ہے دیر و حرم\r\nخانۂ یار کا طواف کرو\r\nطور سینا کی سمت جائیں کلیم\r\nنوحؔ تم سیر کوہ قاف کرو",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
