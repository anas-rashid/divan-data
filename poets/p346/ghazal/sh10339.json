      "RhymeLetters": null,
      "PlainText": "رابطہ ہے مجھے شیشے سے نہ پیمانے سے\r\nپھر وہ کیا بات ہے منسوب ہوں مے خانے سے\r\nاہل مے خانہ سلیقے سے پئیں آب حیات\r\nورنہ پھر موت ہے چھلکے گی جو پیمانے سے\r\nایک عالم سے جدا مصلحتیں ہیں اس کی\r\nکون ہر بات پہ الجھے ترے دیوانے سے\r\nخرد آشوب ہے ہر نکتۂ عرفان حیات\r\nاور بڑھتا ہے جنوں عقل کے بڑھ جانے سے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
