  "Poems": [
    {
      "Id": 10354,
      "Title": "الفت نے تری ہم کو تو رکھا نہ کہیں کا",
      "FullUrl": "/p349/ghazal/sh10354"
    },
    {
      "Id": 10355,
      "Title": "اللہ اے بتو ہمیں دکھلائے لکھنؤ",
      "FullUrl": "/p349/ghazal/sh10355"
    },
    {
      "Id": 10356,
      "Title": "اے نسیم سحری ہم تو ہوا ہوتے ہیں",
      "FullUrl": "/p349/ghazal/sh10356"
    },
    {
      "Id": 10357,
      "Title": "بتو خدا سے ڈرو سنگ دل سوا نہ کرو",
      "FullUrl": "/p349/ghazal/sh10357"
    },
    {
      "Id": 10358,
      "Title": "برباد نہ کر اس کو ذرا ہاتھ پہ دھر لا",
      "FullUrl": "/p349/ghazal/sh10358"
    },
    {
      "Id": 10359,
      "Title": "جا بیٹھتے ہو غیروں میں غیرت نہیں آتی",
      "FullUrl": "/p349/ghazal/sh10359"
    },
    {
      "Id": 10360,
      "Title": "حال دل اے بتو خدا جانے",
      "FullUrl": "/p349/ghazal/sh10360"
    },
    {
      "Id": 10361,
      "Title": "دستار فقیرانہ اک تاج سے افزوں ہے",
      "FullUrl": "/p349/ghazal/sh10361"
    },
    {
      "Id": 10362,
      "Title": "دکھاتے ہیں جو یہ صنم دیکھتے ہیں",
      "FullUrl": "/p349/ghazal/sh10362"
    },
    {
      "Id": 10363,
      "Title": "زہرہ سہیل شمس خور بدر بہا تو کون ہے",
      "FullUrl": "/p349/ghazal/sh10363"
    },
    {
      "Id": 10364,
      "Title": "سن رکھو اسے دل کا لگانا نہیں اچھا",
      "FullUrl": "/p349/ghazal/sh10364"
    },
    {
      "Id": 10365,
      "Title": "سنا ہے کوچ تو ان کا پر اس کو کیا کہیے",
      "FullUrl": "/p349/ghazal/sh10365"
    },
    {
      "Id": 10366,
      "Title": "سہے غم پئے رفتگاں کیسے کیسے",
      "FullUrl": "/p349/ghazal/sh10366"
    },
    {
      "Id": 10367,
      "Title": "عشق سے کچھ کام نے کچھ کوئے جاناں سے غرض",
      "FullUrl": "/p349/ghazal/sh10367"
    },
    {
      "Id": 10368,
      "Title": "غنچۂ دل کھلے جو چاہو تم",
      "FullUrl": "/p349/ghazal/sh10368"
    },
    {
      "Id": 10369,
      "Title": "لبالب کر دے اے ساقی ہے خالی میرا پیمانہ",
      "FullUrl": "/p349/ghazal/sh10369"
    },
    {
      "Id": 10370,
      "Title": "لجیائی سے نازک ہے اے جان بدن تیرا",
      "FullUrl": "/p349/ghazal/sh10370"
    },
    {
      "Id": 10371,
      "Title": "محبت سے بندہ بنا لیجئے گا",
      "FullUrl": "/p349/ghazal/sh10371"
    },
    {
      "Id": 10372,
      "Title": "نایاب ہے سکون دل بے قرار میں",
      "FullUrl": "/p349/ghazal/sh10372"
    },
    {
      "Id": 10373,
      "Title": "پڑا ہے پاؤں میں اب سلسلہ محبت کا",
      "FullUrl": "/p349/ghazal/sh10373"
    },
    {
      "Id": 10374,
      "Title": "چاک چاک اپنا گریباں نہ ہوا تھا سو ہوا",
      "FullUrl": "/p349/ghazal/sh10374"
    },
    {
      "Id": 10375,
      "Title": "کبھی لطف زبان خوش بیاں تھے",
      "FullUrl": "/p349/ghazal/sh10375"
    },
    {
      "Id": 10376,
      "Title": "گرمیاں شوخیاں کس شان سے ہم دیکھتے ہیں",
      "FullUrl": "/p349/ghazal/sh10376"
    },
    {
      "Id": 10377,
      "Title": "یاد میں اپنے یار جانی کی",
      "FullUrl": "/p349/ghazal/sh10377"
    }
  ]
