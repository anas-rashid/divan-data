      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "یہی نہ سمجھو فقط اک خطاب ہیں ہم تم\r\nکوئی تو بات ہے جس کے جواب ہیں ہم تم\r\nابھی تو صورت موج و حباب ہیں ہم تم\r\nجب اس سے گزرے وہی ایک آب ہیں ہم تم\r\nجو وہ ملے کہیں آفت زدے تو کہتے ہیں\r\nزمانہ بھر ہے مزے میں خراب ہیں ہم تم\r\nنہ پوچھے جائیں گے گر حسن و عشق کے جھگڑے\r\nتو سب سے حشر کے دن بے حساب ہیں ہم تم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
