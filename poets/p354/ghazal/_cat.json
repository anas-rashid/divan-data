  "Poems": [
    {
      "Id": 10479,
      "Title": "واعظ کے میں ضرور ڈرانے سے ڈر گیا",
      "FullUrl": "/p354/ghazal/sh10479",
      "RadifLetter": "ا"
    },
    {
      "Id": 10458,
      "Title": "ان کی رفتار سے دل کا عجب احوال ہوا",
      "FullUrl": "/p354/ghazal/sh10458",
      "RadifLetter": "ا"
    },
    {
      "Id": 10476,
      "Title": "قبر پر باد فنا آئیے گا",
      "FullUrl": "/p354/ghazal/sh10476",
      "RadifLetter": "ا"
    },
    {
      "Id": 10468,
      "Title": "داغ جنوں دماغ پریشاں میں رہ گیا",
      "FullUrl": "/p354/ghazal/sh10468",
      "RadifLetter": "ا"
    },
    {
      "Id": 10464,
      "Title": "بچ کر کہاں میں ان کی نظر سے نکل گیا",
      "FullUrl": "/p354/ghazal/sh10464",
      "RadifLetter": "ا"
    },
    {
      "Id": 10457,
      "Title": "اشک افتادہ نظر آتے ہیں سارے دریا",
      "FullUrl": "/p354/ghazal/sh10457",
      "RadifLetter": "ا"
    },
    {
      "Id": 10459,
      "Title": "اے صبا جذب پہ جس دم دل ناشاد آیا",
      "FullUrl": "/p354/ghazal/sh10459",
      "RadifLetter": "ا"
    },
    {
      "Id": 10473,
      "Title": "عدوئے جاں بت بے باک نکلا",
      "FullUrl": "/p354/ghazal/sh10473",
      "RadifLetter": "ا"
    },
    {
      "Id": 10456,
      "Title": "آیا جو موسم گل تو یہ حساب ہوگا",
      "FullUrl": "/p354/ghazal/sh10456",
      "RadifLetter": "ا"
    },
    {
      "Id": 10454,
      "Title": "آئی اے گلعذار کیا کہنا",
      "FullUrl": "/p354/ghazal/sh10454",
      "RadifLetter": "ا"
    },
    {
      "Id": 10470,
      "Title": "دل ہے غذائے رنج جگر ہے غذائے رنج",
      "FullUrl": "/p354/ghazal/sh10470",
      "RadifLetter": "ج"
    },
    {
      "Id": 10465,
      "Title": "بے تابئ دل نے زار پا کر",
      "FullUrl": "/p354/ghazal/sh10465",
      "RadifLetter": "ر"
    },
    {
      "Id": 10461,
      "Title": "باغ عالم میں ہے بے رنگ بیان واعظ",
      "FullUrl": "/p354/ghazal/sh10461",
      "RadifLetter": "ظ"
    },
    {
      "Id": 10460,
      "Title": "اے صنم سب ہیں ترے ہاتھوں سے نالاں آج کل",
      "FullUrl": "/p354/ghazal/sh10460",
      "RadifLetter": "ل"
    },
    {
      "Id": 10472,
      "Title": "رنگ ہے اے ساقیٔ سرشار قیصر باغ میں",
      "FullUrl": "/p354/ghazal/sh10472",
      "RadifLetter": "ن"
    },
    {
      "Id": 10477,
      "Title": "محشر کا ہمیں کیا غم عصیاں کسے کہتے ہیں",
      "FullUrl": "/p354/ghazal/sh10477",
      "RadifLetter": "ن"
    },
    {
      "Id": 10480,
      "Title": "کس منہ سے کہیں گناہ کیا ہیں",
      "FullUrl": "/p354/ghazal/sh10480",
      "RadifLetter": "ن"
    },
    {
      "Id": 10474,
      "Title": "عشق کا اختتام کرتے ہیں",
      "FullUrl": "/p354/ghazal/sh10474",
      "RadifLetter": "ن"
    },
    {
      "Id": 10471,
      "Title": "دیکھ کر خوش رنگ اس گل پیرہن کے ہاتھ پاؤں",
      "FullUrl": "/p354/ghazal/sh10471",
      "RadifLetter": "ن"
    },
    {
      "Id": 10466,
      "Title": "تم ہر اک رنگ میں اے یار نظر آتے ہو",
      "FullUrl": "/p354/ghazal/sh10466",
      "RadifLetter": "و"
    },
    {
      "Id": 10481,
      "Title": "کوئی صورت سے گر صفا ہو",
      "FullUrl": "/p354/ghazal/sh10481",
      "RadifLetter": "و"
    },
    {
      "Id": 10467,
      "Title": "جو عدوئے باغ ہو برباد ہو",
      "FullUrl": "/p354/ghazal/sh10467",
      "RadifLetter": "و"
    },
    {
      "Id": 10475,
      "Title": "فکر رنج و راحت کیسی",
      "FullUrl": "/p354/ghazal/sh10475",
      "RadifLetter": "ی"
    },
    {
      "Id": 10462,
      "Title": "بت پرستی سے نہ طینت مری زنہار پھری",
      "FullUrl": "/p354/ghazal/sh10462",
      "RadifLetter": "ی"
    },
    {
      "Id": 10478,
      "Title": "نفس نمرود ہے کیا ہونا ہے",
      "FullUrl": "/p354/ghazal/sh10478",
      "RadifLetter": "ے"
    },
    {
      "Id": 10469,
      "Title": "دل پر داغ باغ کس کا ہے",
      "FullUrl": "/p354/ghazal/sh10469",
      "RadifLetter": "ے"
    },
    {
      "Id": 10463,
      "Title": "بندہ اب ناصبور ہوتا ہے",
      "FullUrl": "/p354/ghazal/sh10463",
      "RadifLetter": "ے"
    },
    {
      "Id": 10455,
      "Title": "آپ اپنی بے وفائی دیکھیے",
      "FullUrl": "/p354/ghazal/sh10455",
      "RadifLetter": "ے"
    }
  ]
}
