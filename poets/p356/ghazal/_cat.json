  "Poems": [
    {
      "Id": 10488,
      "Title": "آج دستا ہے حال کچھ کا کچھ",
      "FullUrl": "/p356/ghazal/sh10488"
    },
    {
      "Id": 10489,
      "Title": "آج سر سبز کوہ و صحرا ہے",
      "FullUrl": "/p356/ghazal/sh10489"
    },
    {
      "Id": 10490,
      "Title": "اگر گلشن طرف وو نو خط رنگیں ادا نکلے",
      "FullUrl": "/p356/ghazal/sh10490"
    },
    {
      "Id": 10491,
      "Title": "بھڑکے ہے دل کی آتش تجھ نیہ کی ہوا سوں",
      "FullUrl": "/p356/ghazal/sh10491"
    },
    {
      "Id": 10492,
      "Title": "تجھ لب کی صفت لعل بدخشاں سوں کہوں گا",
      "FullUrl": "/p356/ghazal/sh10492"
    },
    {
      "Id": 10493,
      "Title": "تخت جس بے خانماں کا دشت ویرانی ہوا",
      "FullUrl": "/p356/ghazal/sh10493"
    },
    {
      "Id": 10494,
      "Title": "ترا لب دیکھ حیواں یاد آوے",
      "FullUrl": "/p356/ghazal/sh10494"
    },
    {
      "Id": 10495,
      "Title": "ترا مجنوں ہوں صحرا کی قسم ہے",
      "FullUrl": "/p356/ghazal/sh10495"
    },
    {
      "Id": 10496,
      "Title": "جب تجھ عرق کے وصف میں جاری قلم ہوا",
      "FullUrl": "/p356/ghazal/sh10496"
    },
    {
      "Id": 10497,
      "Title": "جب صنم کوں خیال باغ ہوا",
      "FullUrl": "/p356/ghazal/sh10497"
    },
    {
      "Id": 10498,
      "Title": "جس دل ربا سوں دل کوں مرے اتحاد ہے",
      "FullUrl": "/p356/ghazal/sh10498"
    },
    {
      "Id": 10499,
      "Title": "جسے عشق کا تیر کاری لگے",
      "FullUrl": "/p356/ghazal/sh10499"
    },
    {
      "Id": 10500,
      "Title": "خوب رو خوب کام کرتے ہیں",
      "FullUrl": "/p356/ghazal/sh10500"
    },
    {
      "Id": 10501,
      "Title": "دل طلب گار ناز مہوش ہے",
      "FullUrl": "/p356/ghazal/sh10501"
    },
    {
      "Id": 10502,
      "Title": "دل کوں تجھ باج بے قراری ہے",
      "FullUrl": "/p356/ghazal/sh10502"
    },
    {
      "Id": 10503,
      "Title": "دل ہوا ہے مرا خراب‌ سخن",
      "FullUrl": "/p356/ghazal/sh10503"
    },
    {
      "Id": 10504,
      "Title": "دیکھنا ہر صبح تجھ رخسار کا",
      "FullUrl": "/p356/ghazal/sh10504"
    },
    {
      "Id": 10505,
      "Title": "سجن ٹک ناز سوں مجھ پاس آ آہستہ آہستہ",
      "FullUrl": "/p356/ghazal/sh10505"
    },
    {
      "Id": 10506,
      "Title": "شغل بہتر ہے عشق بازی کا",
      "FullUrl": "/p356/ghazal/sh10506"
    },
    {
      "Id": 10507,
      "Title": "صحبت غیر موں جایا نہ کرو",
      "FullUrl": "/p356/ghazal/sh10507"
    },
    {
      "Id": 10508,
      "Title": "عاشق کے مکھ پہ نین کے پانی کو دیکھ توں",
      "FullUrl": "/p356/ghazal/sh10508"
    },
    {
      "Id": 10509,
      "Title": "عشق بیتاب جاں گدازی ہے",
      "FullUrl": "/p356/ghazal/sh10509"
    },
    {
      "Id": 10510,
      "Title": "عشق میں صبر و رضا درکار ہے",
      "FullUrl": "/p356/ghazal/sh10510"
    },
    {
      "Id": 10511,
      "Title": "مت غصہ کے شعلے سوں جلتے کوں جلاتی جا",
      "FullUrl": "/p356/ghazal/sh10511"
    },
    {
      "Id": 10512,
      "Title": "مشتاق ہیں عشاق تری بانکی ادا کے",
      "FullUrl": "/p356/ghazal/sh10512"
    },
    {
      "Id": 10513,
      "Title": "مفلسی سب بہار کھوتی ہے",
      "FullUrl": "/p356/ghazal/sh10513"
    },
    {
      "Id": 10514,
      "Title": "میں عاشقی میں تب سوں افسانہ ہو رہا ہوں",
      "FullUrl": "/p356/ghazal/sh10514"
    },
    {
      "Id": 10515,
      "Title": "وہ نازنیں ادا میں اعجاز ہے سراپا",
      "FullUrl": "/p356/ghazal/sh10515"
    },
    {
      "Id": 10516,
      "Title": "چھپا ہوں میں صدائے بانسلی میں",
      "FullUrl": "/p356/ghazal/sh10516"
    },
    {
      "Id": 10517,
      "Title": "کمر اس دل ربا کی دل ربا ہے",
      "FullUrl": "/p356/ghazal/sh10517"
    },
    {
      "Id": 10518,
      "Title": "کیا مجھ عشق نے ظالم کوں آب آہستہ آہستہ",
      "FullUrl": "/p356/ghazal/sh10518"
    },
    {
      "Id": 10519,
      "Title": "ہوئے ہیں رام پیتم کے نین آہستہ آہستہ",
      "FullUrl": "/p356/ghazal/sh10519"
    },
    {
      "Id": 10520,
      "Title": "ہوا ظاہر خط روئے نگار آہستہ آہستہ",
      "FullUrl": "/p356/ghazal/sh10520"
    },
    {
      "Id": 10521,
      "Title": "یاد کرنا ہر گھڑی اس یار کا",
      "FullUrl": "/p356/ghazal/sh10521"
    }
  ]
