      "RadifLetter": "ا"
    },
    {
      "Id": 10497,
      "Title": "جب صنم کوں خیال باغ ہوا",
      "FullUrl": "/p356/ghazal/sh10497",
      "RadifLetter": "ا"
    },
    {
      "Id": 10504,
      "Title": "دیکھنا ہر صبح تجھ رخسار کا",
      "FullUrl": "/p356/ghazal/sh10504",
      "RadifLetter": "ا"
    },
    {
      "Id": 10514,
      "Title": "میں عاشقی میں تب سوں افسانہ ہو رہا ہوں",
