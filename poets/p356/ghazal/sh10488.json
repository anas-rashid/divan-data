      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "آج دستا ہے حال کچھ کا کچھ\r\nکیوں نہ گزرے خیال کچھ کا کچھ\r\nدل بے دل کوں آج کرتی ہے\r\nشوخ چنچل کی چال کچھ کا کچھ\r\nمجکو لگتا ہے اے پری پیکر\r\nآج تیرا جمال کچھ کا کچھ\r\nاثر بادۂ جوانی ہے\r\nکر گیا ہوں سوال کچھ کا کچھ\r\nاے ولیؔ دل کوں آج کرتی ہے\r\nبوئے باغ وصال کچھ کا کچھ",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
