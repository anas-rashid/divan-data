      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "غیر آہ سرد نہیں داغوں کے جانے کا علاج\r\nجز صبا کیا ہے چراغوں کے بجھانے کا علاج\r\nدل شکستوں کی دوا غیر از گداز عشق نہیں\r\nہے گلانا ٹوٹے شیشوں کے بنانے کا علاج\r\nجور سے نادم ہو لب کا کاٹنا قاتل کا ہے\r\nدل کے زخموں کو مرے بخیہ دلانے کا علاج",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 3
    }
