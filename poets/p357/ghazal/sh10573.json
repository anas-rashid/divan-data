      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "گر میرے لہو رونے کا باران بنے گا\r\nکوچہ ترا رشک چمنستان بنے گا\r\nگر اس قد موزوں کا تمنا میں اثر ہے\r\nبرجستہ مری باتوں کا دیوان بنے گا\r\nاس زلف کی گر لیل برات آوے مرے ہات\r\nدل کے مرے داغوں کا چراغان بنے گا\r\nعزلتؔ تو کر اس زلف پریشاں سے یہ دل جمع\r\nزنار کا شیرازۂ قرآن بنے گا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
