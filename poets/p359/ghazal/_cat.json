  "Poems": [
    {
      "Id": 10624,
      "Title": "اس شوخ دم شعار سے کہتا سلام شوق",
      "FullUrl": "/p359/ghazal/sh10624"
    },
    {
      "Id": 10625,
      "Title": "اشک آ آ کے مری آنکھوں میں تھم جاتے ہیں",
      "FullUrl": "/p359/ghazal/sh10625"
    },
    {
      "Id": 10627,
      "Title": "اگر اتنا نہ تو عیار ہوتا",
      "FullUrl": "/p359/ghazal/sh10627"
    },
    {
      "Id": 10628,
      "Title": "تجھے خلق کہتی ہے خود نما تجھے ہم سے کیوں یہ حجاب ہے",
      "FullUrl": "/p359/ghazal/sh10628"
    },
    {
      "Id": 10629,
      "Title": "تعین تسلسل ہے نقش بدن کا",
      "FullUrl": "/p359/ghazal/sh10629"
    },
    {
      "Id": 10630,
      "Title": "تلاش جس نور کی ہے تجھ کو چھپا ہے تیرے بدن کے اندر",
      "FullUrl": "/p359/ghazal/sh10630"
    },
    {
      "Id": 10631,
      "Title": "تم نے دیکھا ہی نہیں ہے وہ نظام مخصوص",
      "FullUrl": "/p359/ghazal/sh10631"
    },
    {
      "Id": 10633,
      "Title": "تو ہی انیس غم رہا نالۂ غمگسار شب",
      "FullUrl": "/p359/ghazal/sh10633"
    },
    {
      "Id": 10634,
      "Title": "جذبہ میں سلوک اور نفی میں ہے جو اثبات",
      "FullUrl": "/p359/ghazal/sh10634"
    },
    {
      "Id": 10636,
      "Title": "جلوۂ دیدار تو اک بات ہے",
      "FullUrl": "/p359/ghazal/sh10636"
    },
    {
      "Id": 10637,
      "Title": "جو بشر ہر وقت محو ذات ہے",
      "FullUrl": "/p359/ghazal/sh10637"
    },
    {
      "Id": 10638,
      "Title": "حریص ہو نہ جہاں میں نہ اپنا جی بھٹکا",
      "FullUrl": "/p359/ghazal/sh10638"
    },
    {
      "Id": 10639,
      "Title": "حسرت و امید کا ماتم رہا",
      "FullUrl": "/p359/ghazal/sh10639"
    },
    {
      "Id": 10640,
      "Title": "داغ غم فراق مٹایا نہ جائے گا",
      "FullUrl": "/p359/ghazal/sh10640"
    },
    {
      "Id": 10641,
      "Title": "دل زندہ خود رہنما ہو گیا",
      "FullUrl": "/p359/ghazal/sh10641"
    },
    {
      "Id": 10642,
      "Title": "دل سوختہ کو اپنے جلایا غضب کیا",
      "FullUrl": "/p359/ghazal/sh10642"
    },
    {
      "Id": 10643,
      "Title": "دل شہید ہوا ہے شہید حسن صفات",
      "FullUrl": "/p359/ghazal/sh10643"
    },
    {
      "Id": 10645,
      "Title": "شہید ارماں پڑے ہیں بسمل کھڑا وہ تلوار کا دھنی ہے",
      "FullUrl": "/p359/ghazal/sh10645"
    },
    {
      "Id": 10646,
      "Title": "طالب عشق ہے کیا سالک عریاں نہ ہوا",
      "FullUrl": "/p359/ghazal/sh10646"
    },
    {
      "Id": 10647,
      "Title": "عدوئے خیرہ سراب ہو گیا بڑا خرانٹ",
      "FullUrl": "/p359/ghazal/sh10647"
    },
    {
      "Id": 10649,
      "Title": "غضب کے طیش میں وہ شوخ دیدہ آیا تھا",
      "FullUrl": "/p359/ghazal/sh10649"
    },
    {
      "Id": 10650,
      "Title": "مجھ سے کہتے ہو کیا کہیں گے آپ",
      "FullUrl": "/p359/ghazal/sh10650"
    },
    {
      "Id": 10651,
      "Title": "ملتے نہیں ہو ہم سے یہ کیا ہوا وتیرا",
      "FullUrl": "/p359/ghazal/sh10651"
    },
    {
      "Id": 10652,
      "Title": "واہ کیا ہم کو بنایا اور بنا کر رہ گئے",
      "FullUrl": "/p359/ghazal/sh10652"
    },
    {
      "Id": 10653,
      "Title": "وہ آئے نگار میں نہ مانوں",
      "FullUrl": "/p359/ghazal/sh10653"
    },
    {
      "Id": 10654,
      "Title": "وہ رم شعار مرا شوخ دیدہ آیا تھا",
      "FullUrl": "/p359/ghazal/sh10654"
    },
    {
      "Id": 10655,
      "Title": "وہ پاس ہے تیرے دور نہیں تو واصل ہے مہجور نہیں",
      "FullUrl": "/p359/ghazal/sh10655"
    },
    {
      "Id": 10656,
      "Title": "وہی ضد ان کو ہے وہی ہے ہٹ",
      "FullUrl": "/p359/ghazal/sh10656"
    },
    {
      "Id": 10657,
      "Title": "کر سیر اپنے دل کی ہے نور کا تماشا",
      "FullUrl": "/p359/ghazal/sh10657"
    },
    {
      "Id": 10658,
      "Title": "کس رنگ میں بیان کریں ماجرائے قلب",
      "FullUrl": "/p359/ghazal/sh10658"
    },
    {
      "Id": 10659,
      "Title": "کہاں ہے وہ گل خنداں ہمیں نہیں معلوم",
      "FullUrl": "/p359/ghazal/sh10659"
    },
    {
      "Id": 10660,
      "Title": "کیوں آ گئے ہیں بزم ظہور و نمود میں",
      "FullUrl": "/p359/ghazal/sh10660"
    },
    {
      "Id": 10661,
      "Title": "گیا سب رنج و غم کنج قفس کا",
      "FullUrl": "/p359/ghazal/sh10661"
    },
    {
      "Id": 10662,
      "Title": "ہستیٔ نیست نما دیدۂ حیراں سمجھا",
      "FullUrl": "/p359/ghazal/sh10662"
    },
    {
      "Id": 10663,
      "Title": "ہم سے جو عہد تھا وہ عہد شکن بھول گیا",
      "FullUrl": "/p359/ghazal/sh10663"
    },
    {
      "Id": 10664,
      "Title": "ہمارا حسن تعلق وفا بنے نہ بنے",
      "FullUrl": "/p359/ghazal/sh10664"
    },
    {
      "Id": 10666,
      "Title": "یہی تمنائے دل ہے ان کی جدھر کو رخ ہو ادھر کو چلئے",
      "FullUrl": "/p359/ghazal/sh10666"
    }
  ]
}
