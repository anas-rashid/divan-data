  "Title": "غزل",
  "FullUrl": "/p360/ghazal",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 10690,
      "Title": "کون سی وہ شمع تھی جس کا میں پروانہ ہوا",
      "FullUrl": "/p360/ghazal/sh10690",
      "RadifLetter": "ا"
    },
    {
      "Id": 10679,
      "Title": "لا مکاں نام ہے اجڑے ہوئے ویرانے کا",
      "FullUrl": "/p360/ghazal/sh10679",
      "RadifLetter": "ا"
    },
    {
      "Id": 10673,
      "Title": "دل بہلنے کا جہاں میں کوئی ساماں نہ ہوا",
      "FullUrl": "/p360/ghazal/sh10673",
      "RadifLetter": "ا"
    },
    {
      "Id": 10687,
      "Title": "پھیر لیں آنکھیں مروت دیکھنا",
      "FullUrl": "/p360/ghazal/sh10687",
      "RadifLetter": "ا"
    },
    {
      "Id": 10683,
      "Title": "نہ اے دل صورت شیخ حرم دیوانہ بن جانا",
      "FullUrl": "/p360/ghazal/sh10683",
      "RadifLetter": "ا"
    },
    {
      "Id": 10685,
      "Title": "وفا شعار کو تو نے ذلیل و خوار کیا",
      "FullUrl": "/p360/ghazal/sh10685",
      "RadifLetter": "ا"
    },
    {
      "Id": 10680,
      "Title": "مرنا مریض عشق کے حق میں شفا ہوا",
      "FullUrl": "/p360/ghazal/sh10680",
      "RadifLetter": "ا"
    },
    {
      "Id": 10689,
      "Title": "کر کے قول و قرار کیا کہنا",
      "FullUrl": "/p360/ghazal/sh10689",
      "RadifLetter": "ا"
    },
    {
      "Id": 10676,
      "Title": "ستا کر ستم کش کو کیا پائیے گا",
      "FullUrl": "/p360/ghazal/sh10676",
      "RadifLetter": "ا"
    },
    {
      "Id": 10674,
      "Title": "دل سے پوچھو کیا ہوا تھا اور کیوں خاموش تھا",
      "FullUrl": "/p360/ghazal/sh10674",
      "RadifLetter": "ا"
    },
    {
      "Id": 10688,
      "Title": "چرا نہ آنکھ کو ساقی کہ بادہ نوش ہوں میں",
      "FullUrl": "/p360/ghazal/sh10688",
      "RadifLetter": "ر"
    },
    {
      "Id": 10668,
      "Title": "بتائیں کیا کہ آئے ہیں کہاں سے ہم کہاں ہو کر",
      "FullUrl": "/p360/ghazal/sh10668",
      "RadifLetter": "ر"
    },
    {
      "Id": 10669,
      "Title": "بچھڑے ہیں کب سے قافلۂ رفتگاں سے ہم",
      "FullUrl": "/p360/ghazal/sh10669",
      "RadifLetter": "م"
    },
    {
      "Id": 10692,
      "Title": "یہ کس کی جستجو ہے اور میں ہوں",
      "FullUrl": "/p360/ghazal/sh10692",
      "RadifLetter": "ن"
    },
    {
      "Id": 10672,
      "Title": "حریم ناز کہاں اور سر نیاز کہاں",
      "FullUrl": "/p360/ghazal/sh10672",
      "RadifLetter": "ن"
    },
    {
      "Id": 10671,
      "Title": "جو محبان وفا ہیں وہ وفا کرتے ہیں",
      "FullUrl": "/p360/ghazal/sh10671",
      "RadifLetter": "ن"
    },
    {
      "Id": 10677,
      "Title": "شرم آلود کہیں دیدۂ غماز نہ ہو",
      "FullUrl": "/p360/ghazal/sh10677",
      "RadifLetter": "و"
    },
    {
      "Id": 10682,
      "Title": "نو گرفتار محبت کبھی آزاد نہ ہو",
      "FullUrl": "/p360/ghazal/sh10682",
      "RadifLetter": "و"
    },
    {
      "Id": 10675,
      "Title": "دل میں اگر نہ عشق و محبت کی چاہ ہو",
      "FullUrl": "/p360/ghazal/sh10675",
      "RadifLetter": "و"
    },
    {
      "Id": 10684,
      "Title": "وحشت دل نے کہیں کا بھی نہ رکھا مجھ کو",
      "FullUrl": "/p360/ghazal/sh10684",
      "RadifLetter": "و"
    },
    {
      "Id": 10681,
      "Title": "مے کا یہ احترام ارے توبہ",
      "FullUrl": "/p360/ghazal/sh10681",
      "RadifLetter": "ہ"
    },
    {
      "Id": 10691,
      "Title": "کچھ تو ہو درد کی لذت ہی سہی",
      "FullUrl": "/p360/ghazal/sh10691",
      "RadifLetter": "ی"
    },
    {
      "Id": 10670,
      "Title": "تن بے جاں میں اب رہا کیا ہے",
      "FullUrl": "/p360/ghazal/sh10670",
      "RadifLetter": "ے"
    },
    {
      "Id": 10686,
      "Title": "وہ ہو علاج درد مداوا کہیں جسے",
      "FullUrl": "/p360/ghazal/sh10686",
      "RadifLetter": "ے"
    },
    {
      "Id": 10667,
      "Title": "آتش عشق بلا آگ لگائے نہ بنے",
      "FullUrl": "/p360/ghazal/sh10667",
      "RadifLetter": "ے"
    },
    {
      "Id": 10678,
      "Title": "عشق کا راز نہ کیوں دل سے نمایاں ہو جائے",
      "FullUrl": "/p360/ghazal/sh10678",
      "RadifLetter": "ے"
    }
  ]
}
