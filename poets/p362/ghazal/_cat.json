  "Poems": [
    {
      "Id": 10694,
      "Title": "ابھی تو یہی دیکھنا چاہتا ہوں",
      "FullUrl": "/p362/ghazal/sh10694"
    },
    {
      "Id": 10695,
      "Title": "امیدوں سے دل برباد کو آباد کرتا ہوں",
      "FullUrl": "/p362/ghazal/sh10695"
    },
    {
      "Id": 10696,
      "Title": "برا ہو گیا یا بھلا ہو گیا",
      "FullUrl": "/p362/ghazal/sh10696"
    },
    {
      "Id": 10697,
      "Title": "بے لوث محبت کی نظر ڈھونڈ رہا ہوں",
      "FullUrl": "/p362/ghazal/sh10697"
    },
    {
      "Id": 10698,
      "Title": "جس زمیں پر ترا نقش کف پا ہوتا ہے",
      "FullUrl": "/p362/ghazal/sh10698"
    },
    {
      "Id": 10699,
      "Title": "جمع ہیں سارے مسافر نا خدائے دل کے پاس",
      "FullUrl": "/p362/ghazal/sh10699"
    },
    {
      "Id": 10700,
      "Title": "جہاں تجھ کو بٹھا کر پوجتے ہیں پوجنے والے",
      "FullUrl": "/p362/ghazal/sh10700"
    },
    {
      "Id": 10701,
      "Title": "جی کو روگ لگا بیٹھا جی کے روگ سے مرتا ہوں",
      "FullUrl": "/p362/ghazal/sh10701"
    },
    {
      "Id": 10702,
      "Title": "رمز آشنا ملے کئی اہل نظر ملے",
      "FullUrl": "/p362/ghazal/sh10702"
    },
    {
      "Id": 10703,
      "Title": "زندگی بھر دہر کی نیرنگیاں دیکھا کئے",
      "FullUrl": "/p362/ghazal/sh10703"
    },
    {
      "Id": 10704,
      "Title": "سنا کر حال قسمت آزما کر لوٹ آئے ہیں",
      "FullUrl": "/p362/ghazal/sh10704"
    },
    {
      "Id": 10705,
      "Title": "سیر دنیا سے غرض تھی محو دنیا کر دیا",
      "FullUrl": "/p362/ghazal/sh10705"
    },
    {
      "Id": 10706,
      "Title": "شباب آیا کسی بت پر فدا ہونے کا وقت آیا",
      "FullUrl": "/p362/ghazal/sh10706"
    },
    {
      "Id": 10707,
      "Title": "شیخ و پنڈت دھرم اور اسلام کی باتیں کریں",
      "FullUrl": "/p362/ghazal/sh10707"
    },
    {
      "Id": 10708,
      "Title": "صورت سے وہ بیزار ہے معلوم نہیں کیوں",
      "FullUrl": "/p362/ghazal/sh10708"
    },
    {
      "Id": 10709,
      "Title": "غرور ضبط سے آہ و فغاں تک بات آ پہنچی",
      "FullUrl": "/p362/ghazal/sh10709"
    },
    {
      "Id": 10710,
      "Title": "فکر عقبیٰ ہے مجھے خواہش دنیا ہے مجھے",
      "FullUrl": "/p362/ghazal/sh10710"
    },
    {
      "Id": 10711,
      "Title": "محبت میں تپاک ظاہری سے کچھ نہیں ہوتا",
      "FullUrl": "/p362/ghazal/sh10711"
    },
    {
      "Id": 10712,
      "Title": "مرا مضموں سوار توسن طبع رواں ہو کر",
      "FullUrl": "/p362/ghazal/sh10712"
    },
    {
      "Id": 10713,
      "Title": "ملے گی شیخ کو جنت، ہمیں دوزخ عطا ہوگا",
      "FullUrl": "/p362/ghazal/sh10713"
    },
    {
      "Id": 10714,
      "Title": "میکدے میں بیٹھ کر ایمان کی پروا نہ کر",
      "FullUrl": "/p362/ghazal/sh10714"
    },
    {
      "Id": 10715,
      "Title": "چاہتا ہوں انتہائے درد دل",
      "FullUrl": "/p362/ghazal/sh10715"
    },
    {
      "Id": 10716,
      "Title": "کسی کے حسن عالم تاب کی تنویر کے صدقے",
      "FullUrl": "/p362/ghazal/sh10716"
    },
    {
      "Id": 10717,
      "Title": "کلیوں کا تبسم ہو، کہ تم ہو کہ صبا ہو",
      "FullUrl": "/p362/ghazal/sh10717"
    },
    {
      "Id": 10718,
      "Title": "ہمارا ذکر دشمن کی زبانی دیکھتے جاؤ",
      "FullUrl": "/p362/ghazal/sh10718"
    }
  ]
}
