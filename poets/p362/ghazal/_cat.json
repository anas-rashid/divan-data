  "Poems": [
    {
      "Id": 10713,
      "Title": "ملے گی شیخ کو جنت، ہمیں دوزخ عطا ہوگا",
      "FullUrl": "/p362/ghazal/sh10713",
      "RadifLetter": "ا"
    },
    {
      "Id": 10706,
      "Title": "شباب آیا کسی بت پر فدا ہونے کا وقت آیا",
      "FullUrl": "/p362/ghazal/sh10706",
      "RadifLetter": "ا"
    },
    {
      "Id": 10705,
      "Title": "سیر دنیا سے غرض تھی محو دنیا کر دیا",
      "FullUrl": "/p362/ghazal/sh10705",
      "RadifLetter": "ا"
    },
    {
      "Id": 10696,
      "Title": "برا ہو گیا یا بھلا ہو گیا",
      "FullUrl": "/p362/ghazal/sh10696",
      "RadifLetter": "ا"
    },
    {
      "Id": 10711,
      "Title": "محبت میں تپاک ظاہری سے کچھ نہیں ہوتا",
      "FullUrl": "/p362/ghazal/sh10711",
      "RadifLetter": "ا"
    },
    {
      "Id": 10718,
      "Title": "ہمارا ذکر دشمن کی زبانی دیکھتے جاؤ",
      "FullUrl": "/p362/ghazal/sh10718",
      "RadifLetter": "ا"
    },
    {
      "Id": 10714,
      "Title": "میکدے میں بیٹھ کر ایمان کی پروا نہ کر",
