      "RadifLetter": "ل"
    },
    {
      "Id": 10695,
      "Title": "امیدوں سے دل برباد کو آباد کرتا ہوں",
      "FullUrl": "/p362/ghazal/sh10695",
      "RadifLetter": "ن"
    },
    {
      "Id": 10701,
      "Title": "جی کو روگ لگا بیٹھا جی کے روگ سے مرتا ہوں",
      "FullUrl": "/p362/ghazal/sh10701",
      "RadifLetter": "ن"
    },
    {
      "Id": 10704,
      "Title": "سنا کر حال قسمت آزما کر لوٹ آئے ہیں",
      "FullUrl": "/p362/ghazal/sh10704",
      "RadifLetter": "ن"
    },
    {
      "Id": 10700,
      "Title": "جہاں تجھ کو بٹھا کر پوجتے ہیں پوجنے والے",
      "FullUrl": "/p362/ghazal/sh10700",
      "RadifLetter": "ن"
    },
    {
      "Id": 10694,
      "Title": "ابھی تو یہی دیکھنا چاہتا ہوں",
      "FullUrl": "/p362/ghazal/sh10694",
      "RadifLetter": "ن"
    },
    {
      "Id": 10708,
      "Title": "صورت سے وہ بیزار ہے معلوم نہیں کیوں",
