      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "برا ہو گیا یا بھلا ہو گیا\r\nمحبت میں جو ہو گیا ہو گیا\r\nنہ پوچھو سر حشر زاہد کا حال\r\nسمجھتے تھے کیا اور کیا ہو گیا\r\nیہیں ختم ہے بحث معیار حسن\r\nجو دل لے گیا دل ربا ہو گیا\r\nالٰہی ترا بندہ اور بت پرست\r\nمگر یہ کہ مجبور سا ہو گیا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
