  "Poems": [
    {
      "Id": 10738,
      "Title": "یارب غم ہجراں میں اتنا تو کیا ہوتا",
      "FullUrl": "/p365/shaeri/ghazal/sh10738",
      "RadifLetter": "ا"
    },
    {
      "Id": 10733,
      "Title": "جب سے تیرا کرم ہے بندہ نواز",
      "FullUrl": "/p365/shaeri/ghazal/sh10733",
      "RadifLetter": "ز"
    },
    {
      "Id": 10734,
      "Title": "دشمن جوانیوں کی یہ آشنائیاں ہیں",
      "FullUrl": "/p365/shaeri/ghazal/sh10734",
      "RadifLetter": "ن"
    },
    {
      "Id": 10731,
      "Title": "آؤ حسن یار کی باتیں کریں",
      "FullUrl": "/p365/shaeri/ghazal/sh10731",
      "RadifLetter": "ن"
    },
    {
      "Id": 10732,
      "Title": "اس طرح کر گیا دل کو مرے ویراں کوئی",
      "FullUrl": "/p365/shaeri/ghazal/sh10732",
      "RadifLetter": "ی"
    },
    {
      "Id": 10739,
      "Title": "یہ مایوسی کہیں وجہ سکون دل نہ بن جائے",
      "FullUrl": "/p365/shaeri/ghazal/sh10739",
      "RadifLetter": "ے"
    },
    {
      "Id": 10736,
      "Title": "محبت کس قدر یاس آفریں معلوم ہوتی ہے",
      "FullUrl": "/p365/shaeri/ghazal/sh10736",
      "RadifLetter": "ے"
    },
    {
      "Id": 10735,
      "Title": "دل بلا سے نثار ہو جائے",
      "FullUrl": "/p365/shaeri/ghazal/sh10735",
      "RadifLetter": "ے"
    }
  ]
