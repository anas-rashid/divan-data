  "Poems": [
    {
      "Id": 10752,
      "Title": "ہر آرزو میں رنگ ہے باغ و بہار کا",
      "FullUrl": "/p366/ghazal/sh10752",
      "RadifLetter": "ا"
    },
    {
      "Id": 10751,
      "Title": "کیا حسن ہے یوسف بھی خریدار ہے تیرا",
      "FullUrl": "/p366/ghazal/sh10751",
      "RadifLetter": "ا"
    },
    {
      "Id": 10748,
      "Title": "مجھ کو خاک در مے خانہ بنایا ہوتا",
      "FullUrl": "/p366/ghazal/sh10748",
      "RadifLetter": "ا"
    },
    {
      "Id": 10747,
      "Title": "لے اڑا رنگ فلک جلوۂ رعنائی کا",
      "FullUrl": "/p366/ghazal/sh10747",
      "RadifLetter": "ا"
    },
    {
      "Id": 10743,
      "Title": "دیتے ہیں میرے جام میں دیکھیں شراب کب",
      "FullUrl": "/p366/ghazal/sh10743",
      "RadifLetter": "ب"
    },
    {
      "Id": 10740,
      "Title": "جہاں رنگ و بو ہے اور میں ہوں",
      "FullUrl": "/p366/ghazal/sh10740",
      "RadifLetter": "ن"
    },
    {
      "Id": 10746,
      "Title": "فتنۂ روزگار کی باتیں",
      "FullUrl": "/p366/ghazal/sh10746",
      "RadifLetter": "ن"
    },
    {
      "Id": 10741,
      "Title": "دل کشی نام کو بھی عالم امکاں میں نہیں",
      "FullUrl": "/p366/ghazal/sh10741",
      "RadifLetter": "ن"
    },
    {
      "Id": 10742,
      "Title": "دور نگاہ ساقی مستانہ ایک ہے",
      "FullUrl": "/p366/ghazal/sh10742",
      "RadifLetter": "ے"
    }
  ]
}
