      "Title": "رہتا ہے میرے دل میں ترا نور رات دن",
      "FullUrl": "/p371/ghazal/c997/sh10834"
    },
    {
      "Id": 10835,
      "Title": "سوز سے ساز کیا چاہئے اب",
      "FullUrl": "/p371/ghazal/c997/sh10835"
    },
    {
      "Id": 10836,
      "Title": "سوز پروانہ نور دین شمع",
      "FullUrl": "/p371/ghazal/c997/sh10836"
    },
    {
      "Id": 10837,
      "Title": "شعرا میں نہ ہو کیوں شعر ہمارا اونچا",
      "FullUrl": "/p371/ghazal/c997/sh10837"
    },
    {
      "Id": 10838,
      "Title": "عارض سے ترے بہار مقصود",
      "FullUrl": "/p371/ghazal/c997/sh10838"
    },
    {
      "Id": 10839,
      "Title": "عاشق گیسو دوتا ہوں میں",
