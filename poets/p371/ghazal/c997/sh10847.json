      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "وہ بت بول اٹھے کسی بات میں\r\nخدا سے یہ مانگا مناجات میں\r\nٹپکتا بہت خانۂ چشم ہے\r\nمکاں بیٹھ جاتا ہے برسات میں\r\nچمن میں ہے گلچیں کا کھٹکا لگا\r\nنہ صیاد سا ہو کہیں گھات میں\r\nوہاں وعظ کا شور مسجد میں ہے\r\nیہاں ہا و ہو ہے خرابات میں\r\nیہ دعوت عداوت ہوئی اے وقارؔ\r\nکہ ہو غیر داخل مدارات میں",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 5
    }
