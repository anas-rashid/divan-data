    {
      "Id": 10874,
      "Title": "جو کچھ تھا مقدر میں گوارا تو نہیں تھا",
      "FullUrl": "/p373/ghazal/sh10874",
      "RadifLetter": "ا"
    },
    {
      "Id": 10870,
      "Title": "بے تاب پاس شمع کے پروانہ آ گیا",
      "FullUrl": "/p373/ghazal/sh10870",
      "RadifLetter": "ا"
    },
    {
      "Id": 10872,
      "Title": "تقدیر شمع جلوۂ جانانہ بن گیا",
      "FullUrl": "/p373/ghazal/sh10872",
      "RadifLetter": "ا"
    },
    {
      "Id": 10875,
      "Title": "حسن حجاب آشنا جانب بام آ گیا",
      "FullUrl": "/p373/ghazal/sh10875",
      "RadifLetter": "ا"
    },
    {
      "Id": 10873,
      "Title": "جس قدر ہیں حسن کی زیبائیاں",
      "FullUrl": "/p373/ghazal/sh10873",
      "RadifLetter": "ن"
    },
    {
      "Id": 10868,
      "Title": "اف مری زندگی کی رات اف مری زندگی کے دن",
      "FullUrl": "/p373/ghazal/sh10868",
      "RadifLetter": "ن"
    },
    {
      "Id": 10877,
      "Title": "سو داغ تمناؤں کے ہم کھائے ہوئے ہیں",
      "FullUrl": "/p373/ghazal/sh10877",
      "RadifLetter": "ن"
    },
    {
      "Id": 10879,
      "Title": "چاک سینے کا بہ انداز جگر ہو کہ نہ ہو",
      "FullUrl": "/p373/ghazal/sh10879",
      "RadifLetter": "و"
    },
    {
      "Id": 10881,
      "Title": "کہو دیر و حرم یا نام اپنا آستاں رکھ دو",
      "FullUrl": "/p373/ghazal/sh10881",
      "RadifLetter": "و"
    },
    {
      "Id": 10869,
      "Title": "اے اہل محبت کیا کہئے کیا چیز محبت ہوتی ہے",
      "FullUrl": "/p373/ghazal/sh10869",
      "RadifLetter": "ے"
    },
    {
      "Id": 10878,
      "Title": "عمر کار جہاں سے گزری ہے",
      "FullUrl": "/p373/ghazal/sh10878",
      "RadifLetter": "ے"
    },
    {
      "Id": 10883,
      "Title": "یہ دھوکا ہو نہ ہو امید ہی معلوم ہوتی ہے",
      "FullUrl": "/p373/ghazal/sh10883",
      "RadifLetter": "ے"
    },
    {
      "Id": 10871,
      "Title": "تاروں والی رات کا عالم پینے اور پلانے سے",
      "FullUrl": "/p373/ghazal/sh10871",
      "RadifLetter": "ے"
    },
    {
      "Id": 10880,
      "Title": "کر کے دل نالاں سے مرے ساز کسی نے",
      "FullUrl": "/p373/ghazal/sh10880",
      "RadifLetter": "ے"
    },
    {
      "Id": 10876,
      "Title": "زبان شمع کھلتی ہے نہ کچھ پروانہ کہتا ہے",
      "FullUrl": "/p373/ghazal/sh10876",
      "RadifLetter": "ے"
    },
    {
      "Id": 10882,
      "Title": "یہ دل کی بات ہے کس نے کہی ہے",
      "FullUrl": "/p373/ghazal/sh10882",
      "RadifLetter": "ے"
    }
