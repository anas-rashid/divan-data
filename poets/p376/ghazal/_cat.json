  "Poems": [
    {
      "Id": 10905,
      "Title": "کس ناز سے واہ ہم کو مارا",
      "FullUrl": "/p376/ghazal/sh10905",
      "RadifLetter": "ا"
    },
    {
      "Id": 10909,
      "Title": "ہاتھ سے کچھ نہ ترے اے مہ کنعاں ہوگا",
      "FullUrl": "/p376/ghazal/sh10909",
      "RadifLetter": "ا"
    },
    {
      "Id": 10907,
      "Title": "کیا ہیں شیدائے قد یار درخت",
      "FullUrl": "/p376/ghazal/sh10907",
      "RadifLetter": "ت"
    },
    {
      "Id": 10906,
      "Title": "کھول دی ہے زلف کس نے پھول سے رخسار پر",
      "FullUrl": "/p376/ghazal/sh10906",
      "RadifLetter": "ر"
    },
    {
      "Id": 10898,
      "Title": "دعائیں مانگیں ہیں مدتوں تک جھکا کے سر ہاتھ اٹھا اٹھا کر",
      "FullUrl": "/p376/ghazal/sh10898",
      "RadifLetter": "ر"
    },
    {
      "Id": 10893,
      "Title": "بھولا ہے بعد مرگ مجھے دوست یاں تلک",
      "FullUrl": "/p376/ghazal/sh10893",
      "RadifLetter": "ک"
    },
    {
      "Id": 10889,
      "Title": "اس کو غفلت‌ پیشہ کہہ آتے ہیں ہم",
      "FullUrl": "/p376/ghazal/sh10889",
      "RadifLetter": "م"
    },
    {
      "Id": 10899,
      "Title": "قتل عشاق کیا کرتے ہیں",
      "FullUrl": "/p376/ghazal/sh10899",
      "RadifLetter": "ن"
    },
    {
      "Id": 10901,
      "Title": "منہ ڈھانپ کے میں جو رو رہا ہوں",
      "FullUrl": "/p376/ghazal/sh10901",
      "RadifLetter": "ن"
    },
    {
      "Id": 10908,
      "Title": "کیوں کر نہ خوش ہو سر مرا لٹکا کے دار میں",
      "FullUrl": "/p376/ghazal/sh10908",
      "RadifLetter": "ن"
    },
    {
      "Id": 10903,
      "Title": "نیم بسمل کی کیا ادا ہے یہ",
      "FullUrl": "/p376/ghazal/sh10903",
      "RadifLetter": "ہ"
    },
    {
      "Id": 10891,
      "Title": "الفت یہ چھپائیں ہم کسی کی",
      "FullUrl": "/p376/ghazal/sh10891",
      "RadifLetter": "ی"
    },
    {
      "Id": 10895,
      "Title": "تکلم جو کوئی کرتا ہے فانی",
      "FullUrl": "/p376/ghazal/sh10895",
      "RadifLetter": "ی"
    },
    {
      "Id": 10910,
      "Title": "یہ اک تیرا جلوہ صنم چار سو ہے",
      "FullUrl": "/p376/ghazal/sh10910",
      "RadifLetter": "ے"
    },
    {
      "Id": 10890,
      "Title": "اس کو مجھ سے رُٹھا دیا کس نے",
      "FullUrl": "/p376/ghazal/sh10890",
      "RadifLetter": "ے"
    },
    {
      "Id": 10894,
      "Title": "تم وفا کا عوض جفا سمجھے",
      "FullUrl": "/p376/ghazal/sh10894",
      "RadifLetter": "ے"
    },
    {
      "Id": 10902,
      "Title": "نظارۂ رخ ساقی سے مجھ کو مستی ہے",
      "FullUrl": "/p376/ghazal/sh10902",
      "RadifLetter": "ے"
    },
    {
      "Id": 10900,
      "Title": "لب جاں بخش پہ دم اپنا فنا ہوتا ہے",
      "FullUrl": "/p376/ghazal/sh10900",
      "RadifLetter": "ے"
    },
    {
      "Id": 10904,
      "Title": "کس قدر مجھ کو ناتوانی ہے",
      "FullUrl": "/p376/ghazal/sh10904",
      "RadifLetter": "ے"
    },
    {
      "Id": 10896,
      "Title": "جو پنہاں تھا وہی ہر سو عیاں ہے",
      "FullUrl": "/p376/ghazal/sh10896",
      "RadifLetter": "ے"
    },
    {
      "Id": 10897,
      "Title": "حسرت اے جاں شب جدائی ہے",
      "FullUrl": "/p376/ghazal/sh10897",
      "RadifLetter": "ے"
    },
    {
      "Id": 10892,
      "Title": "اپنا ہر عضو چشم بینا ہے",
      "FullUrl": "/p376/ghazal/sh10892",
      "RadifLetter": "ے"
    }
  ]
}
