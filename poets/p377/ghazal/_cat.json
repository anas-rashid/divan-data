    {
      "Id": 10912,
      "Title": "الٹا اثر یہ شکوۂ بیداد سے ہوا",
      "FullUrl": "/p377/ghazal/sh10912"
    },
    {
      "Id": 10919,
      "Title": "کسی سے عشق دشمن کا گلہ کیا",
      "FullUrl": "/p377/ghazal/sh10919"
    },
    {
      "Id": 10914,
      "Title": "رہتا ہے ہمیشہ جو مری یار بغل میں",
      "FullUrl": "/p377/ghazal/sh10914"
    },
    {
      "Id": 10911,
      "Title": "ادائیں ہیں جو اس رشک پری میں",
      "FullUrl": "/p377/ghazal/sh10911"
    },
    {
      "Id": 10915,
      "Title": "سوائے عشق بتاں اور مجھ کو کام نہیں",
      "FullUrl": "/p377/ghazal/sh10915"
    },
    {
      "Id": 10917,
      "Title": "مانند شمع بزم پگھلنے کے واسطے",
      "FullUrl": "/p377/ghazal/sh10917"
    },
    {
      "Id": 10913,
      "Title": "رنج میں بھی شاد رہنا چاہئے",
      "FullUrl": "/p377/ghazal/sh10913"
    },
    {
      "Id": 10916,
      "Title": "عدو پر لطف ہے ہم پر جفا ہے",
      "FullUrl": "/p377/ghazal/sh10916"
    },
    {
      "Id": 10918,
      "Title": "نہیں غم گر خفا سارا جہاں ہے",
      "FullUrl": "/p377/ghazal/sh10918"
    }
  ]
