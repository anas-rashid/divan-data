  "Title": "غزل",
  "FullUrl": "/p378/ghazal",
  "Description": null,
  "DescriptionHtml": null,
  "BookName": null,
  "ChildCats": [],
  "Poems": [
    {
      "Id": 10929,
      "Title": "محو کمال آرزو مجھ کو بنا کے بھول جا",
      "FullUrl": "/p378/ghazal/sh10929"
    },
    {
      "Id": 10921,
      "Title": "اشک غم عقدہ کشائے خلش جاں نکلا",
      "FullUrl": "/p378/ghazal/sh10921"
    },
    {
      "Id": 10926,
      "Title": "درد سا اٹھ کے نہ رہ جائے کہیں دل کے قریب",
      "FullUrl": "/p378/ghazal/sh10926"
    },
    {
      "Id": 10923,
      "Title": "تم عزیز اور تمہارا غم بھی عزیز",
      "FullUrl": "/p378/ghazal/sh10923"
    },
    {
      "Id": 10931,
      "Title": "نظام طبیعت سے گھبرا گیا دل",
      "FullUrl": "/p378/ghazal/sh10931"
    },
    {
      "Id": 10925,
      "Title": "تو نہ ہو ہم نفس اگر جینے کا لطف ہی نہیں",
      "FullUrl": "/p378/ghazal/sh10925"
    },
    {
      "Id": 10932,
      "Title": "کھویا ہوا سا رہتا ہوں اکثر میں عشق میں",
      "FullUrl": "/p378/ghazal/sh10932"
    },
    {
      "Id": 10922,
      "Title": "اٹھنے کو تو اٹھا ہوں محفل سے تری لیکن",
      "FullUrl": "/p378/ghazal/sh10922"
    },
    {
      "Id": 10920,
      "Title": "اس بے وفا کی بزم سے چشم خیال میں",
      "FullUrl": "/p378/ghazal/sh10920"
    },
    {
      "Id": 10933,
      "Title": "ہزار خاک کے ذروں میں مل گیا ہوں میں",
      "FullUrl": "/p378/ghazal/sh10933"
    },
    {
      "Id": 10930,
      "Title": "میں کیا ہوں کون ہوں یہ بھی خبر نہیں مجھ کو",
      "FullUrl": "/p378/ghazal/sh10930"
    },
    {
      "Id": 10927,
      "Title": "دیکھ کر شمع کے آغوش میں پروانے کو",
      "FullUrl": "/p378/ghazal/sh10927"
    },
    {
      "Id": 10928,
      "Title": "زباں پہ حرف شکایت ارے معاذ اللہ",
      "FullUrl": "/p378/ghazal/sh10928"
    },
    {
      "Id": 10924,
      "Title": "تمہیں بھی معلوم ہو حقیقت کچھ اپنی رنگیں ادائیوں کی",
      "FullUrl": "/p378/ghazal/sh10924"
    }
  ]
}
