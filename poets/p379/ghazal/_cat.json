  "Poems": [
    {
      "Id": 10934,
      "Title": "تم بھی نگاہ میں ہو عدو بھی نظر میں ہے",
      "FullUrl": "/p379/ghazal/sh10934"
    },
    {
      "Id": 10935,
      "Title": "دل فرقت حبیب میں دیوانہ ہو گیا",
      "FullUrl": "/p379/ghazal/sh10935"
    },
    {
      "Id": 10936,
      "Title": "ستم تیر نگاہ دل ربا تھا",
      "FullUrl": "/p379/ghazal/sh10936"
    },
    {
      "Id": 10937,
      "Title": "شب فراق کچھ ایسا خیال یار رہا",
      "FullUrl": "/p379/ghazal/sh10937"
    },
    {
      "Id": 10938,
      "Title": "مجھے فریب وفا دے کے دم میں لانا تھا",
      "FullUrl": "/p379/ghazal/sh10938"
    },
    {
      "Id": 10939,
      "Title": "وہ شوخ بام پہ جب بے نقاب آئے گا",
      "FullUrl": "/p379/ghazal/sh10939"
    },
    {
      "Id": 10940,
      "Title": "وہ یہ کہتے ہیں زمانے کی تمنا میں ہوں",
      "FullUrl": "/p379/ghazal/sh10940"
    },
    {
      "Id": 10941,
      "Title": "کچھ محبت میں عجب شیوۂ دل دار رہا",
      "FullUrl": "/p379/ghazal/sh10941"
    }
  ]
}
