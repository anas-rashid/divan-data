      "Text": "وہ تو جہاں دیکھو مورے سنگ ہے ری",
      "CoupletIndex": 8,
      "SectionIndex1": 0
    },
    {
      "VOrder": 11,
      "Position": "Single",
      "Text": "ارے اے ری سکھی ری",
      "CoupletIndex": 9,
      "SectionIndex1": 0
    },
    {
      "VOrder": 12,
      "Position": "Single",
      "Text": "وہ تو جہاں دیکھو مورو بر سنگ ہے ری",
