      "Text": "آہے آہے آہے وا",
      "CoupletIndex": 23,
      "SectionIndex1": 0
    },
    {
      "VOrder": 26,
      "Position": "Single",
      "Text": "اے تورا رنگ من بھایو نجام الدین",
      "CoupletIndex": 24,
