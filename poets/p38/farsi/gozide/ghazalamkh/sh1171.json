      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "رغم آن دل که نگه دارندش\r\nزیر آن زلف سیه دارندش\r\nمشک بی‌زلف تو نتواند بود\r\nگر به شمشیر نگه دارندش\r\nبر رخ خوب تو ماند چیزی\r\nمه اگر زیر کله دارندش\r\nدر زمان سر بنهد بر پایت\r\nپایت ار بر سر مه دارندش\r\nچشم خسرو به گه آمدنت\r\nمنتظر بر سر ره دارندش",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
