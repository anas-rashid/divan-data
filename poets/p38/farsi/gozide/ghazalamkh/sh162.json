      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ندانستم که اهلیت گناهست\r\nایا این ره که می پویم چه راهست\r\nز جور روزگار و طعن دشمن\r\nجهان بیش جهان بینم سیاهت\r\nنه هر مردی تواند کرد مردی\r\nسوار شیر دل پشت سپاهست\r\nکسان را بر در هر کس پناهی\r\nمرا بر درگه لطفش پناهست\r\nاگر آهی کشم درهم کشد روی\r\nمگر آیینه را تندی ز آهست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
