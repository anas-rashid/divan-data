      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "چو بنمایی رخ گلنار گونه\r\nگل اندر خار غلتد خار گونه\r\nهمیشه چشم تو مست است، جانا\r\nولی در دلبری هشیار گونه\r\nشفا حاصل نشد درد دلم را\r\nمگر زان نرگش بیمار گونه\r\nخرد در صدر دیوانخانه عشق\r\nهمی گردد دل بیکار گونه\r\nچه غم، اینک پی تو می گذارم\r\nنفس پیمودن مکار گونه",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
