      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "لبت در سخن انگبین ریخته\r\nرخت مشک بر یاسمین ریخته\r\nاز آن روی و موی دلاویز تست\r\nدلم در شب و روز آویخته\r\nچو باد صبا دید رخسار تو\r\nبه گل گفت «کای روی تو ریخته\r\nبرانگیختی بر من اسپ جفا\r\nدگر تا چه ها باشد انگیخته؟»\r\nز خسرو گریزان مشو کو شده ست\r\nاسیر تو، وز خویش بگریخته",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
