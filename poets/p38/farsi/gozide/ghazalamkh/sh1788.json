      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مشک بر اطراف مه آورده ای\r\nتوبه به زیر گنه آورده ای\r\nبر رخ تو کآفت جان من است\r\nاز شب یلدا سپه آورده ای\r\nشانه کو گم کرده بر فرق تو ره\r\nمو کشانش رو به ره آورده ای\r\nداده ام از دیده خون، دل خسته ای\r\nخواستم یک بوسه، نه آورده ای\r\nرسم تو آزردن خسرو شده\r\nباز چه رسم تبه آورده ای؟",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
