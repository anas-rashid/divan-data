      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "هر شبم کآهم به عالم دم زدی\r\nآتش اندر خرمن عالم زدی\r\nسوخت جانم را غم و غم سوختی\r\nذره ای سوز من ار بر غم زدی\r\nگر دلم را دست بودی بر فلک\r\nدیده ای سقفش که چون برهم زدی\r\nزین زبان دانی اگر جم بودمی\r\nآسمانم بوسه بر خاتم زدی\r\nدر تن خاکی و سلطانی بدی\r\nخاک پایم آسمان را کم زدی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
