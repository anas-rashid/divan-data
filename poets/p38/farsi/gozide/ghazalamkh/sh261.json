      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "روی خوبت دلبری را پایه ای است\r\nآرزو را خوبتر پیرایه ایست\r\nچرخ با چندان ستم حسن تراست\r\nکه ز مادر مهربانتر دایه ای است\r\nچون به عهد دولت رخسار تو\r\nناله را از چرخ برتر پایه ای است\r\nلحظه ای با بنده بنشین کاین قدر\r\nزندگانی را عجب سرمایه ایست\r\nدر غمت از آه خسرو تا سحر\r\nشب نخسپد هر کجا همسایه ایست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
