    {
      "Index": 0,
      "Number": 1,
      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "رنگی از حسن تو در روی گل است\r\nوز لب لعلت خیالی در مل است\r\nاز خیال نرگس جادوی تو\r\nدر چمن ها چشم نرگس بر گل است\r\nاز نسیم صبح کی بیرون رود\r\nبوی گل کاندر دماغ بلبل است\r\nاز کمند عنبرین گیسوی تو\r\nملتهب کی دل شود، گر دلدل است\r\nرحم کن بر خسرو، ار بشنیده ای\r\nکز فغانش عالمی در غلغل است",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
