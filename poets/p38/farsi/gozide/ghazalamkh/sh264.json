      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ای نسیم صبحدم، یارم کجاست\r\nغم ز حد بگذشت، غمخوارم کجاست\r\nخواب در چشمم نمی آید به شب\r\nآن چراغ چشم بیدارم کجاست\r\nدوست گفت آشفته گرد و زار باش\r\nدوستان، آشفته و زارم، کجاست\r\nنیستم آسوده و کارش دمی\r\nیار، آن آسوده از کارم، کجاست\r\nتا به گوش او رسانم حال خویش\r\nناله های خسرو زارم کجاست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
