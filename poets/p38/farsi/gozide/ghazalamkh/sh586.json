      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "فریاد، ز غمزه تو فریاد\r\nکز وی شغبی به عالم افتاد\r\nفریاد رسی که رفت بر چرخ\r\nما را ز کرشمه تو فریاد\r\nتو مردم چشم ما و ما را\r\nبر گوشه دل نیاوردی یاد\r\nدریاب مرا که آهم از غم\r\nچون صور صدای حشر درداد\r\nگر واسطه وصال نبود\r\nآن کیست که نیست با غمت شاد؟",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
