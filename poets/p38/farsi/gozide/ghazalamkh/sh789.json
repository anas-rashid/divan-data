      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "آخر این دردم به درمان کی رسد\r\nنوبت دیدار جانان کی رسد\r\nاین دل سرگشته‌ی سودا زده\r\nاز وصال او به سامان کی رسد\r\nآدم آشفته دل در انتظار\r\nمانده تا پیغام رضوان کی رسد\r\nدیده یعقوب بر راه امید\r\nتا دگر یوسف به کنعان کی رسد!\r\nدل چو بلبل زار و نالان در فراق\r\nتا گل رویت به بستان کی رسد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
