      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "عاشق از سینه جان برون گیرد\r\nتا غمت را به جان درون گیرد\r\nروی او گر شود گرفته ببین\r\nگر نبینی که ماه چون گیرد\r\nدیگران از پری فسون گیرند\r\nاز دو چشمت پری فسون گیرند\r\nمحنت و غم حریف و مونس وی\r\nچون تواند که دل سکون گیرد\r\nبی تو این چشم خون گرفته بسی\r\nآخر این آب چند خون گیرد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
