      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "خدایا چون به منشور الهی\r\nرقم کردی سپیدی و سیاهی\r\nز باران عنایت گل سرشتی\r\nبرات مردمی بر وی نبشتی\r\nمثال هستی ما هم ز اول\r\nبه توقیع کرم کردی مسجل\r\nز گنج بخششم هر چیز دادی\r\nکلید گنج ایمان نیز دادی\r\nچراغم را چو خود بخشیده‌ای نور\r\nمکن بخشیدهٔ خود را ز من دور",
      "HtmlText": null,
      "PoemFormat": "Masnavi",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
