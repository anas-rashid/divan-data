      "Text": "وآن هم نفسی که داشتی، مرد",
      "CoupletIndex": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "یاری که نیایدت در آغوش",
      "CoupletIndex": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "آن به که ز دل کنی فراموش",
      "CoupletIndex": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "شاخی که برش نه زود باشد",
      "CoupletIndex": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "هیزم بود ار چه عود باشد",
      "CoupletIndex": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "بید، ار ندهد ز میوه مایه",
      "CoupletIndex": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "باری بودش فراخ سایه",
      "CoupletIndex": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "تو شاخ رسیده گشتی و تر",
      "CoupletIndex": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "نی سایه به مادهی و نی بر",
      "CoupletIndex": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "چون عشق بود به دل ، صوابست",
      "CoupletIndex": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "مه در شب تیره آفتابست",
      "CoupletIndex": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "نوفل که به مهر تست منسوب",
      "CoupletIndex": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "دارد پس پرده دختری خوب",
      "CoupletIndex": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "در گلشن حسن سرو چالاک",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "چون قطرهٔ آب آسمان پاک",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "خورشید رخی خدیجه نامش",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "پرورده به عصمتی تمامش",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "جویندش و نوفل، از تکبر،",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "در رشتهٔ کس، نه بندد آن در",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "زان رسم وفا که در تو دیده‌ست",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "پیوند ترا به جان خریده‌ست",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "در دل، همه صحبت تو جوید",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "وز شرم، بروی تو نگوید",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "پرسد خبر تو گاه و بی گاه",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "هم معتقدست و هم نکوخواه",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "گر سر به رضاء ما کنی راست",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "آن خواست از آنِ توست، بی‌خواست",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "هم مادر امید خاص یابد",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "هم جان پدر خلاص یابد",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "ور خود زنی از خلاف تیری،",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "بی جان شده گیر، زال و پیری",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "گفتیم به تو غم نهانی",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "از ما سخنی، دگر تو دانی!",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "دیوانه که این حدیث بشنید",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "دیوانگیش ز سر بجنبید",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "می‌خواست که از درون پر سوز",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "گردد، به خلاف، پاسخ اندوز",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "لیکن، چو فسون پیر بد چست",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "کرد از دم سخت دیوار سست",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "در پای پدر فتاد فرزند",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "گفت ای دم تو مرا زبان بند",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "با آنکه خرد ز من عنان تافت،",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "از رای تو، روی چون توان یافت؟",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "اینست چو خواهش الهی",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "تن در دادم بهر چه خواهی!",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "مادر پدر از چنان جوابی",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "بر آتش دل زدند آبی",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "رفتند ز خانه بامدادان",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "پیش پدر عروس شادان",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "بستند کمر بجست و جویی",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "کردند سپرده گفت و گویی",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "نوفل که بخاطر آن هوس داشت",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "پیش آمد و پاس آن نفس داشت",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "گشتند، دو دل، مبده، بی غم",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "رفتند بسوی خانه خرم",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "بردند ظرایف عروسی",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "بغدادی و مغربی و روسی",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "اسباب نشاط و مایهٔ سور",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "شهد و شکر و گلاب و کافور",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "بنشست فقیه عیسوی دم",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "بنیاد نکاح کرد محکم",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "شد جلوه نما بت حصاری",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "چون گل ز نسیم نوبهاری",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "نازک بدنی چو در مکنون",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "مجنون کن صد هزار مجنون",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "هر کس به هوس نگاه می‌کرد",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "مجنون می‌دید و آه می‌کرد",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "هر کس صفت جمال می‌گفت",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "مجنون سخن از خیال می‌گفت",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "هر کس گهری خریده می‌ریخت",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "مجنون ز سرشک دیده می‌ریخت",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "هر کس ز طرب به کار خود بود",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "مجنون به هوای یار خود بود",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "هر کس شمعی بسوز برداشت",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "مجنون همه سوز در جگر داشت",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "او قصهٔ جان ریش می‌خواند",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "و افسون خلاص خویش می‌خواند",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "می‌کرد به سینه یاد دل خواه",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "می‌شست به گریه دست از آن ماه",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "بیرون خوش و از درونه دل تنگ",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "تن حاضر و دل هزار فرسنگ",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "مطرب ز طرب ترانه می‌زد",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "او نالهٔ عاشقانه می‌زد",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "چون کرد عروس جلوهٔ حور",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "در پردهٔ مهد گشت مستور",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "چون شد، گهٔ آنکه، خرم و شاد",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "هم خوابه شوند سرو و شمشاد",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "دیوانه به درد خود گرفتار",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "حیران شده ماه نو در آن کار",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "نی او همه شب غنود از سوز",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "نی لعبت تو، ز بخت بد روز",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "بر بویی گلی که بود یارش",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "دامن نگرفت هیچ خارش",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "بر نجد شد و طواف می‌کرد",
      "CoupletIndex": 75
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "با خاطر خود مصاف می‌کرد",
      "CoupletIndex": 75
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "سوزان غزلی که دل کند ریش",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "می‌خواند به حسب حالت خویش",
      "CoupletIndex": 76
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "مادر که شنید قصهٔ دوش",
      "CoupletIndex": 77
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "سوی پدرش دوید بی‌هوش",
      "CoupletIndex": 77
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "ناخن زد و چهره غرق خون کرد",
      "CoupletIndex": 78
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "دامن ز سرشک لاله‌گون کرد",
      "CoupletIndex": 78
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "بی‌چاره پدر ز پا در افتاد",
      "CoupletIndex": 79
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "هم شیشه شکست و هم خر افتاد",
      "CoupletIndex": 79
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "گشتند موافقان و خویشان",
      "CoupletIndex": 80
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "زین واقعه جمله دل پریشان",
      "CoupletIndex": 80
    }
  ]
}
