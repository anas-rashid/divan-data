    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "جز در کف کودکان نوخیز",
      "CoupletIndex": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "که‌آموخته شد چو خرد، با سیم",
      "CoupletIndex": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "کالای بزرگ را بود بیم",
      "CoupletIndex": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "ور خود، به غلط، نعوذ بالله",
      "CoupletIndex": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "در سمت سیاقت، افتدت راه",
      "CoupletIndex": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "با آنکه شوی وزیر کشور",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "دزدی باشی، کلاه بر سر",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "دانی، ز قلم هنر چه جویی؟",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "از آب سیه، سپیدرویی؟",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "چون بر سر شغل و کام باشی",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "می‌کوش که نیک‌نام باشی",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "در هر چه تو‌را شمار باشد",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "آن کن که صلاح کار باشد",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "ناخن که سر خراش دارد",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "برند سرش، چو سر برآرد",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "ناکس که خراش چون خسان کرد",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "با او، آن کن، که با کسان کرد",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "بر خویشتن آنکه او نبخشود",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "بخشودن او خرد نفرمود",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "در جنبش فتنه، جا نگه دار",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "بر خار چه جُرم‌؟ پا نگه دار",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "شد چیره چو دشمن ستمکار",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "از وی نرهی، مگر به هنجار",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "مرغی که تپد به حلقهٔ دام",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "اندر خفه جان دهد سرانجام",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "چون کار فتاد با گرانان",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "با صرفه زنند کاردانان",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "مردم، چو دهد عنان به فرهنگ",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "از باد بگردد آسیا سنگ",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "بینایی عقل پیش می‌دار",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "بینا شو و پاس خویش می‌دار",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "ایمن منشین به عالم خس",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "کز چرخ نرست بی‌بلا کس",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "کنجد که ز کام آسیا جست",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "هم در لگد جو از شد پست",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "خواهی که نگردی آرزومند",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "می‌باش به‌هر‌چه هست خرسند",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "پویان حریص، روی زرد است",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "خرسندی دل صلاح مرد است",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "مردم چو ز زر عنان بتابد",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "همّت شرف کمال یابد",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "این سرخ‌گلی که خون‌فشان است",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "سُرخی‌ش ز خون سر‌کشان است",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "ایمن بود از شکنجه درویش",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "زر هر چه که بیشتر، بلا بیش",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "گشتی به سر و روی کُله‌دار",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "شو ساخته خدنگ‌ِ خون‌خوار",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "ور نیز شوی وزیر مقبل",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "از خامه‌زنان مباش غافل",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "چون در صف پردلان کنی جای",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "سر پیش نه اول، آنگهی پای",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "مردانه که کار مرد ورزد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "آن به که ز بیم جان نلرزد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "گیرم ز عدو عنان بتابد،",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "از مرگ کجا خلاص یابد؟",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "کار نظر است پیش دیدن",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "نتوان به قفای خویش دیدن",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "آن که‌ش مدد ضمیر باشد",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "پیلش به نظر حقیر باشد",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "باز آنکه دلش هراس‌پیشه‌ست",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "شیر نمدش چو شیر بیشه‌ست",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "لیکن سبکی مکن چنان هم",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "که‌ت دل برود ز دست و جان هم",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "در حمله مشو مبارز خام",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "هنجار ببین و پیش نه گام",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "ور بر تو عدو کند زبان تیز",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "چون مایهٔ کار هست مگریز",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "بر پُر‌هنر‌ست جور و بیداد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "کس را نبود ز بی‌هنر یاد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "چون رخت کلال خاک باشد",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "از نقب‌زنش چه باک باشد؟",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "گردیدهٔ ظاهرت گر دیدهٔ",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "در عیب کسان نظر مینداز",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "وریا و بی بینش یقینی",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "آن به که سوی خدای بینی",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "مپسند به هر‌چه رایت آسود",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "آن کن که بود خدای خشنود",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "می‌باش چو شاخ سبز دلکش",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "کاتش ز نی‌اش نگیرد آتش",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "بفروز چراغ پارسیایی",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "کاو‌راست سری به روشنایی",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "خواهی که رسی به چرخ گردان",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "مگذار عنان نیک‌مردان",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "شمعی که بود ز روشنی دور",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "ندهد به چراغ دیگران نور",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "دولت آن شد که دل فروزی",
      "CoupletIndex": 75
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "وز ترک امل کلاه دوزی",
      "CoupletIndex": 75
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "در دامن نیستی زنی دست",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "تا هست شوی به عالم هست",
      "CoupletIndex": 76
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "دانی که به‌خاطر هوسناک",
      "CoupletIndex": 77
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "هر کس نرسد به عالم پاک",
      "CoupletIndex": 77
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "با این همه هم ز جست و جویی",
      "CoupletIndex": 78
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "کاهل مشوی به هیچ سویی",
      "CoupletIndex": 78
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "خواهی شرف بزرگواری",
      "CoupletIndex": 79
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "می‌کوش به همّتی که داری",
      "CoupletIndex": 79
    }
  ]
}
