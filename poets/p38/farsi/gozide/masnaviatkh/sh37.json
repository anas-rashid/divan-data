      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مردم او جمله فرشته سرشت\r\nخوش دل و خوش خوی چو اهل بهشت\r\nهر چه ز صنعت به همه عالم است\r\nهست در ایشان و زیادت هم است\r\nبیشتراز علم و ادب بهره مند\r\nاهل سخن خود که شمارد که چند\r\nهر طرفی سحر بیانی نوست\r\nریزهٔ چین کمتر شان خسروست\r\nپنج هزار از ملک نامدار\r\nلشکر شان بیشتر از صد هزار",
      "HtmlText": null,
      "PoemFormat": "Masnavi",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
