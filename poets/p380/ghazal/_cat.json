  "Poems": [
    {
      "Id": 10953,
      "Title": "ہوشؔ اس پر کسی کا بس نہ چلا",
      "FullUrl": "/p380/ghazal/sh10953",
      "RadifLetter": "ا"
    },
    {
      "Id": 10946,
      "Title": "مآل کار نہ کچھ بھی ہوا تو کیا ہوگا",
      "FullUrl": "/p380/ghazal/sh10946",
      "RadifLetter": "ا"
    },
    {
      "Id": 10943,
      "Title": "جاوداں غم عہد عشرت تیز پا",
      "FullUrl": "/p380/ghazal/sh10943",
      "RadifLetter": "ا"
    },
    {
      "Id": 10951,
      "Title": "وہی صبح کا دھندھلکا وہی منزلیں وہی شب",
      "FullUrl": "/p380/ghazal/sh10951",
      "RadifLetter": "ب"
    },
    {
      "Id": 10949,
      "Title": "میں نے اب سمجھا ہے راز کائنات",
      "FullUrl": "/p380/ghazal/sh10949",
      "RadifLetter": "ت"
    },
    {
      "Id": 10950,
      "Title": "نہ کام فکر سے نکلا نہ چل سکی تدبیر",
      "FullUrl": "/p380/ghazal/sh10950",
      "RadifLetter": "ر"
    },
    {
      "Id": 10945,
      "Title": "فکر ہستی ہے نہ احساس اجل",
      "FullUrl": "/p380/ghazal/sh10945",
      "RadifLetter": "ل"
    },
    {
      "Id": 10942,
      "Title": "اب آؤ سرود غم سنائیں",
      "FullUrl": "/p380/ghazal/sh10942",
      "RadifLetter": "ن"
    },
    {
      "Id": 10952,
      "Title": "وہی میری نا مرادی وہی گردش زمانہ",
      "FullUrl": "/p380/ghazal/sh10952",
      "RadifLetter": "ہ"
    },
    {
      "Id": 10948,
      "Title": "محبت کی فطرت ہے یہ بے قراری",
      "FullUrl": "/p380/ghazal/sh10948",
      "RadifLetter": "ی"
    },
    {
      "Id": 10944,
      "Title": "سناؤں تمہیں زندگی کی کہانی",
      "FullUrl": "/p380/ghazal/sh10944",
      "RadifLetter": "ی"
    },
    {
      "Id": 10947,
      "Title": "مجھے یاد ہیں وہ دن جو تری بزم میں گزارے",
      "FullUrl": "/p380/ghazal/sh10947",
      "RadifLetter": "ے"
    }
  ]
}
