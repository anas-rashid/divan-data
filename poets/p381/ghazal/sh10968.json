    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "منزل قدم سے لپٹی ہے تقدیر دیکھنا",
      "CoupletIndex": 0,
      "SectionIndex1": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "آوازے مجھ پہ کستے ہیں پھر بندگان عشق",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 4,
      "Position": "Left",
      "Text": "پڑ جائے پھر نہ پاؤں میں زنجیر دیکھنا",
      "CoupletIndex": 1,
      "SectionIndex1": 0
    },
    {
      "VOrder": 5,
      "Position": "Right",
      "Text": "مردوں سے شرط باندھ کے سوئی ہے اپنی موت",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 6,
      "Position": "Left",
      "Text": "ہاں دیکھنا ذرا فلک پیر دیکھنا",
      "CoupletIndex": 2,
      "SectionIndex1": 0
    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ہوش اڑ نہ جائیں صنعت بہزاد دیکھ کر",
      "CoupletIndex": 3,
      "SectionIndex1": 0
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "آئینہ رکھ کے سامنے تصویر دیکھنا",
      "CoupletIndex": 3,
