  "Poems": [
    {
      "Id": 11066,
      "Title": "اے بے خبری جی کا یہ کیا حال ہے کل سے",
      "FullUrl": "/p383/ghazal/sh11066"
    },
    {
      "Id": 11067,
      "Title": "بے طلب ایک قدم گھر سے نہ باہر جاؤں",
      "FullUrl": "/p383/ghazal/sh11067"
    },
    {
      "Id": 11068,
      "Title": "تعمیر زندگی کو نمایاں کیا گیا",
      "FullUrl": "/p383/ghazal/sh11068"
    },
    {
      "Id": 11069,
      "Title": "جس کا بدن ہے خوشبو جیسا جس کی چال صبا سی ہے",
      "FullUrl": "/p383/ghazal/sh11069"
    },
    {
      "Id": 11070,
      "Title": "جو حروف لکھ گیا تھا مری آرزو کا بچپن",
      "FullUrl": "/p383/ghazal/sh11070"
    },
    {
      "Id": 11075,
      "Title": "شہر لگتا ہے بیابان مجھے",
      "FullUrl": "/p383/ghazal/sh11075"
    },
    {
      "Id": 11078,
      "Title": "میں لپٹتا رہا ہوں خاروں سے",
      "FullUrl": "/p383/ghazal/sh11078"
    },
    {
      "Id": 11079,
      "Title": "میں ہوں تیرے لیے بے نام و نشاں آوارہ",
      "FullUrl": "/p383/ghazal/sh11079"
    },
    {
      "Id": 11081,
      "Title": "وہ میری جان ہے دل سے کبھی جدا نہ ہوا",
      "FullUrl": "/p383/ghazal/sh11081"
    },
    {
      "Id": 11082,
      "Title": "پانی کو آگ کہہ کے مکر جانا چاہئے",
      "FullUrl": "/p383/ghazal/sh11082"
    },
    {
      "Id": 11083,
      "Title": "پکارتا ہوں کہ تم حاصل تمنا ہو",
      "FullUrl": "/p383/ghazal/sh11083"
    },
    {
      "Id": 11084,
      "Title": "کیا ڈھونڈنے آئے ہو نظر میں",
      "FullUrl": "/p383/ghazal/sh11084"
    },
    {
      "Id": 11085,
      "Title": "ہم گرچہ دل و جان سے بیزار ہوئے ہیں",
      "FullUrl": "/p383/ghazal/sh11085"
    },
    {
      "Id": 11086,
      "Title": "ہے گلو گیر بہت رات کی پہنائی بھی",
      "FullUrl": "/p383/ghazal/sh11086"
    },
    {
      "Id": 11087,
      "Title": "یارو ہر غم غم یاراں ہے قریب آ جاؤ",
      "FullUrl": "/p383/ghazal/sh11087"
    }
  ]
}
