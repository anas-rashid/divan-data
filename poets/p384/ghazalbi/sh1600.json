      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "چمن دلی ‌که به یاد تو آشنا گردید\r\nفلک سری ‌که به پای تو جبهه‌سا گردید\r\nکسی‌که دست به دامان التفات تو زد‌\r\nمقیم انجمن سایهٔ هما گردید\r\nحضو‌ر خاک جناب تو دارد اکسیری\r\nکه نقش پا ز خیالش جبین‌نما گردید\r\nچو بیدل آنکه غبار ره نیاز تو شد\r\nبه چشم هر دو جهان ناز توتیاگردید",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
