    {
      "Index": 0,
      "Number": 1,
      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نه اینجا سبحه ره دارد نه زنار\r\nتو دیرستان ناز خود پرستی\r\nتحیر چشم بند سحرکاری‌ست\r\nبهار بی‌نشانی گل به دستی\r\nدربغا رمز خورشیدت نشد فاش\r\nابد رفت و همان صبح الستی\r\nکسی دیگر چه اندیشد چه فهمد\r\nبه آیینی‌که نتوان یافت هستی\r\nبه معراج خیالات تو بیدل\r\nبلندیهاست سر در جیب پستی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
  ],
