      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "از نظر هرگز خیالش دور نیست\r\nیک نفس دریای ما بی شور نیست\r\nدر دهان اژدهای خم رود\r\nمست بی پرواتر از مخمور نیست\r\nخنده بر برق تجلی می زند\r\nخانه دل چون بنای طور نیست\r\nنیست در فرمان بدگویان زبان\r\nاختیار نیش با زنبور نیست\r\nگر ندارد سکته چین بر جبین\r\nبیت ابروی تو چون مشهور نیست؟",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
