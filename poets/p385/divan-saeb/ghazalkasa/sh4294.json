      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بی‌صحبت تو عیش میسر نمی‌شود\r\nرغبت به بوسه لب ساغر نمی‌شود\r\nیارب چه خاک بر سر بی‌طاقتی کنم\r\nدستم دچار دامن محشر نمی‌شود\r\nهر سطر کار شهپر جبریل می‌کند\r\nمکتوب ما وبال کبوتر نمی‌شود\r\nبال شکسته است کلید در قفس\r\nاین فتح بی‌شکستگی پر نمی‌شود\r\nصائب چه رفته‌ای، گلی از بوسه‌اش بچین\r\nدائم زمان وصل میسر نمی‌شود",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
