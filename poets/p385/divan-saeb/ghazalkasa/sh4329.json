    {
      "Index": 0,
      "Number": 1,
      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تا روشنی صدق به دل یار نگردد\r\nگفتار تو آیینه کردار نگردد\r\nکوته بود از سوختگان دست تعدی\r\nپروانه به شبگرد گرفتار نگردد\r\nدر ساغر چشم است می طفل مزاجی\r\nافسانه حریف دل بیدار نگردد\r\nرخساره گلرنگ تو هردم به هوایی است\r\nچون چشم گرانخواب تو بیمار نگردد\r\nتا صائب ما صفحه دیوان نگشاید\r\nگل پردگی رخنه دیوار نگردد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
  ],
