      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دارد سری به کاکل او هر سری که هست\r\nدربند اوست هر دل غم پروری که هست\r\nدر حلقه اطاعت حق پایدار باش\r\nتا بر رخت گشاده شود هر دری که هست\r\nدنیا کند به دل سیهان میل بیشتر\r\nاز شش جهت به هند رود هر زری که هست",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
  ],
