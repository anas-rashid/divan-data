      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تا چند ز رسوا شدن راز توان سوخت؟\r\nاز بی تهی اشک نظرباز توان سوخت\r\nمردیم درین خانه دلگیر قفس، چند\r\nاز شوق هم آغوشی پرواز توان سوخت؟\r\nواسوختگی شیوه ما نیست، وگرنه\r\nاز یک سخن سرد دل ناز توان سوخت\r\nگر در گذری از سر یک غنچه تبسم\r\nاز شعله غیرت دل اعجاز توان سوخت",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
