      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "زخم گستاخم لب تیغ شهادت می‌مکد\r\nشبنم من خون خورشید قیامت می‌مکد\r\nنقش شیرین شسته شد از لوح خارا و هنوز\r\nتیشهٔ فرهاد انگشت جلادت می‌مکد\r\nاز دهان خضر آب زندگانی می‌رود\r\nتیغ او از بس لبِ خود را به رغبت می‌مکد",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
