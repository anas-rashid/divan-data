      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "قانع به جرعه نیست لب میگسار ما\r\nمیخانه را به آب رساند خمار ما\r\nای جلوه نسیم ترحم چه کوتهی است\r\nدر غنچه زنگ بست گل اعتبار ما\r\nاز نخل موم صد گل رنگین شکفت و ریخت\r\nیک برگ سبز سر نزد از شاخسار ما\r\nامشب که آمده است به کف سیب آن ذقن\r\nخالی است جای شیشه می در کنار ما",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
