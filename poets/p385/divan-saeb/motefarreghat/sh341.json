      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مگر از ناله بلبل دل ما بگشاید\r\nورنه پیداست چه از باد صبا بگشاید\r\nمی تواند گره از غنچه پیکان وا کرد\r\nهر نسیمی که دل تنگ مرا بگشاید\r\nصبح را بخیه انجم نشود مهر دهن\r\nنتوان بست دری را که خدا بگشاید",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
