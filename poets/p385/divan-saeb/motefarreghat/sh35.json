      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تا کی به شعله ای نزند جوش داغ ما؟\r\nپیش از فتیله چند بسوزد چراغ ما؟\r\nای محتسب به توبه قسم می دهم ترا\r\nکاین موسم بهار مخور بر دماغ ما\r\n(حسرت به نور ذره و عمر شرر کشد\r\nیارب کسی مباد به روز چراغ ما)",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
