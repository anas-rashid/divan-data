      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "رخ تو روی نگاه از پری بگرداند\r\nعنان دل ز بت آزری بگرداند\r\nچو آفتاب، مرا چند دربدر غم عشق\r\nبه زیر خیمه نیلوفری بگرداند؟\r\nعلاقه هاست به من دام را، نه آن صیدم\r\nکه گرد خویش مرا سرسری بگرداند\r\nچو آفتاب ز سیمای گوهرم پیداست\r\nکه آب در نظر جوهری بگرداند",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
