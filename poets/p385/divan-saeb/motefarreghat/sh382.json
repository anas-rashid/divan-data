      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "باده ای را نپرستم که خرابم نکند\r\nگرد آن شمع نگردم که کبابم نکند\r\nخون منصورم و بیداردلی جوش من است\r\nمی طفل افکن افسانه به خوابم نکند\r\nآب گشته است دل یک چمن از خنده من\r\nمی شود حشر مکافات گلابم نکند؟",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
