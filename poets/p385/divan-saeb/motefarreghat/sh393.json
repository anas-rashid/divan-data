      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تا چند رخ ز باده کسی لاله گون کند؟\r\nتا کی کسی شناه به دریای خون کند؟\r\nهر کس ز عشق سایه دستی گرفته است\r\nچون تیشه دست در کمر بیستون کند\r\nروزی که چرخ پنبه گذارد به داغ ما\r\nخورشید سر ز روزن مغرب برون کند\r\nاول شکار لاغر آن صید پیشه ایم\r\nما را مگر شهید برای شگون کند",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
