      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تیر از فراق شست تو می کرد ناله دوش؟\r\nیا بال عندلیب پر این خدنگ بود\r\nاز آبیاری عرق شرم، روی او\r\nتا آفتاب زرد خزان لاله رنگ بود\r\nامشب که شوخی هوسش آرمیده بود\r\nجان شراب بر لب ساغر رسیده بود\r\nدرد طلب بلاست، وگرنه رفیق خضر\r\nلب تشنگی خویش در آیینه دیده بود",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
