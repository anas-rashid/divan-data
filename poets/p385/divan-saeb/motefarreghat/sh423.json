      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "جان چون کمال یافت به جانانه می رسد\r\nانگور چون رسید به میخانه می رسد\r\nطوفان کند شراب در آن سر که مغز نیست\r\nفیض بهار، بیش به دیوانه می رسد\r\nحسن غریب حوصله پرداز طاقت است\r\nکی آشنا به معنی بیگانه می رسد؟",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
