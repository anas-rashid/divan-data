      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "فضای چرخ تنگی می کند بر مغز پرشورم\r\nقبای دار کوتاه است بر بالای منصورم\r\nچنان باریک بین گردیده ام از عاقبت بینی\r\nکه جوی شهد آید در نظر چون نیش زنبورم\r\nز صحرای شکرریز قناعت گوشه ای دارم\r\nکه آید در نظر ملک سلیمان دیده مورم",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
