      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کمند زلف ترا چون به خویش رام کنیم؟\r\nبه راه دام تو در خاک چند دام کنیم؟\r\nسپهر تیغ مکافات بر کف استاده است\r\nچه لازم است که ما فکر انتقام کنیم؟\r\nاگر چه پختگیی نیست کارفرما را\r\nچه لازم است که ما کار خویش خام کنیم؟",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
