      "Position": "Right",
      "Text": "دودهای کلیسیای امید",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "بگلوی دعا فرستادی",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "هر کجا فوجی از تعلق بود",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "بس مدعا فرستادی",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "امر سهوی گر از کسی سرزد",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "بشمار خطا فرستادی",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "ناروایی که از تو صادر شد",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "بحساب قضا فرستادی",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "هر کجا کژدم نیازی بود",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "بگریبان ما فرستادی",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "پرتو نور صبح اول خیز",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "بچراغ قفا فرستادی",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "شمع ایمان خانه روشن کن",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "بحریم ریا فرستادی",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "تا بصید آمدت شهاب حیات",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "بعیان بر قفا فرستادی",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "اینک آب و هوای عاریتی",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "هم بر آب و هوا فرستادی",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "زان جواهر که داشت ارزشها",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "چه؟ بدارالبقا فرستادی",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "هرگزت دین نبودهان گر بود",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "گو: چه کردی؟ کجا فرستادی",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "نازم این نامه های ننگین را",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "که بروز جزا فرستادی",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "هان روان شو که پیشخانه عیش",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "خوش بساز و نوا فرستادی",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "گر دعایم کنی وگر نفرین",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "برگ دوزخ رسا فرستادی",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "دلی آخر ، اگر دلی این نام",
