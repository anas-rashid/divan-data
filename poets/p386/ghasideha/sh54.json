    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "علت انحنا فرستادی",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "ای که بردی بنزد مهرش دل",
