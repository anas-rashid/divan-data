    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "بلب مصطفی فرستادی",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "داوری کز لطافت نفسش",
