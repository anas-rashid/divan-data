    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "سوی تحت الثری فرستادی",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "ایکه وقت گزارش پیغام",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "صبح نزد عشا فرستادی",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "اینچنین قطعه ای بیک نفسم",
