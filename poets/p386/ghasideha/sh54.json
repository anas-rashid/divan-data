    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "مس بر کیمیا فرستادی",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "ایکه از مایه سعادت خویش",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "سایه بخش هما فرستادی",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "ایکه از همتت بشیر نعم",
