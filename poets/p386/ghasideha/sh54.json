    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "با مضی ما مضی فرستادی",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "بد نکردی شفاعت خود را",
