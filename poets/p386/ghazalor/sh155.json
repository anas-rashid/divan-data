      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نازنده جهان از تو به آلایش آفت\r\nای آفت آسایش و آسایش آفت\r\nتا دیده فلک شیوه ی آفت گری تو\r\nیک لحظه نپایید ز فرمایش آفت\r\nباید همه آفت شد اگر امت عشقی\r\nراضی نشود عشق یه آلایش آفت\r\nچندان که دلم آفت عشقت طلبد، نیست\r\nدر حوصله ی عشق تو گنجایش آفت\r\nآراسته از آفت نازت دل عرفی\r\nای ناز دل آرای تو آرایش آفت",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
