      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "هر که را نشأ غیرت به سلامت باید\r\nدر مصاف غم دل تاب اقامت باید\r\nهمت اندوده شدن باید ، اگر مرد غمی\r\nنه دعای غم و نفرین سلامت باید\r\nجگر تشنه و فرسودگی پای کجاست\r\nگر کنی طی ره عشق علامت باید\r\nتا نظر باز کنی جلوه کند دوست، ولی\r\nتا تو بیدار شوی صور قیامت باید",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
