      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "چون سنگ وفا به دست گیرد\r\nبس شیشهٔ دل شکست گیرد\r\nبد مست شدم ، مگو که واعظ\r\nآهنگ ترانه پست گیرد\r\nاز محتسب آمد این که در خلد\r\nمستم ز می الست گیرد\r\nما را چه زیان که بهر خود شیخ\r\nآن نامه که نیست هست گیرد\r\nمی داغ شود دمی که عرفی\r\nپیمانهٔ خود به دست گیرد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
