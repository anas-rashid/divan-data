    },
    {
      "VOrder": 7,
      "Position": "Right",
      "Text": "ورتوان دندان من چون آسمان قهرت شکست",
      "CoupletIndex": 3
    },
    {
      "VOrder": 8,
      "Position": "Left",
      "Text": "حاکمی اندیشه دندان شکن سنگی مکن",
