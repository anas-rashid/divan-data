      "Text": "بیع مکن با گهرش سود نیست",
      "CoupletIndex": 87
    },
    {
      "VOrder": 176,
      "Position": "Left",
      "Text": "حاصل این شمع بجز دود نیست",
      "CoupletIndex": 87
    },
    {
      "VOrder": 177,
      "Position": "Right",
      "Text": "زهر ازین ساغر بیرون دهند",
      "CoupletIndex": 88
    },
    {
      "VOrder": 178,
      "Position": "Left",
      "Text": "باده نمایند ولی خون دهند",
      "CoupletIndex": 88
    },
    {
      "VOrder": 179,
      "Position": "Right",
      "Text": "حرف مراد از ورقش برتراش",
      "CoupletIndex": 89
    },
    {
      "VOrder": 180,
      "Position": "Left",
      "Text": "مست ملامت شو و آسوده باش",
      "CoupletIndex": 89
    },
    {
      "VOrder": 181,
      "Position": "Right",
      "Text": "آن که بود نشاه می در سرش",
      "CoupletIndex": 90
    },
    {
      "VOrder": 182,
      "Position": "Left",
      "Text": "تلخی می شهد نماید برش",
      "CoupletIndex": 90
    },
    {
      "VOrder": 183,
      "Position": "Right",
      "Text": "طبع گر از تلخی زهر آشناست",
      "CoupletIndex": 91
    },
    {
      "VOrder": 184,
      "Position": "Left",
      "Text": "بیم زشیرینی قندش کجا است",
      "CoupletIndex": 91
    },
    {
      "VOrder": 185,
      "Position": "Right",
      "Text": "وانکه بود عادت طبعش بقند",
      "CoupletIndex": 92
    },
    {
      "VOrder": 186,
      "Position": "Left",
      "Text": "زهر فرستد بمزاجش گزند",
      "CoupletIndex": 92
    },
    {
      "VOrder": 187,
      "Position": "Right",
      "Text": "نغمه امید هزاران نفس",
      "CoupletIndex": 93
    },
    {
      "VOrder": 188,
      "Position": "Left",
      "Text": "فایده یاس ندارد بکس",
      "CoupletIndex": 93
    },
    {
      "VOrder": 189,
      "Position": "Right",
      "Text": "تلخ دهانی گله سازی مکن",
      "CoupletIndex": 94
    },
    {
      "VOrder": 190,
      "Position": "Left",
      "Text": "لب بگشا نغمه طرازی مکن",
      "CoupletIndex": 94
    },
    {
      "VOrder": 191,
      "Position": "Right",
      "Text": "من هم از این می قدحی میکشم",
      "CoupletIndex": 95
    },
    {
      "VOrder": 192,
      "Position": "Left",
      "Text": "وزمزه اش آب دهان می چشم",
      "CoupletIndex": 95
    },
    {
      "VOrder": 193,
      "Position": "Right",
      "Text": "نغمه کزو کام حلاوت برد",
      "CoupletIndex": 96
    },
    {
      "VOrder": 194,
      "Position": "Left",
      "Text": "ذوق مرا نزد ملامت برد",
      "CoupletIndex": 96
    },
    {
      "VOrder": 195,
      "Position": "Right",
      "Text": "می که برد بی غمی آمد حلال",
      "CoupletIndex": 97
    },
    {
      "VOrder": 196,
      "Position": "Left",
      "Text": "بر دل من چیده بساط ملال",
      "CoupletIndex": 97
    },
    {
      "VOrder": 197,
      "Position": "Right",
      "Text": "گر شود از تشنگیم دل کباب",
      "CoupletIndex": 98
    },
    {
      "VOrder": 198,
      "Position": "Left",
      "Text": "عهد رطوبت شکند طبع آب",
      "CoupletIndex": 98
    },
    {
      "VOrder": 199,
      "Position": "Right",
      "Text": "گل که بود نشاه ذوقش بلند",
      "CoupletIndex": 99
    },
    {
      "VOrder": 200,
      "Position": "Left",
      "Text": "می چکدش خون ز لب شیر خند",
      "CoupletIndex": 99
    },
    {
      "VOrder": 201,
      "Position": "Right",
      "Text": "برگ مرادش اگر آماده بود",
      "CoupletIndex": 100
    },
    {
      "VOrder": 202,
      "Position": "Left",
      "Text": "لوح وی از خون جگر ساده بود",
      "CoupletIndex": 100
    },
    {
      "VOrder": 203,
      "Position": "Right",
      "Text": "از لبت آلایش تلخی بشوی",
      "CoupletIndex": 101
    },
    {
      "VOrder": 204,
      "Position": "Left",
      "Text": "وانگه از او شهد تبسم بجوی",
      "CoupletIndex": 101
    },
    {
      "VOrder": 205,
      "Position": "Right",
      "Text": "چشمه کوثر که همه خنده است",
      "CoupletIndex": 102
    },
    {
      "VOrder": 206,
      "Position": "Left",
      "Text": "فرش بدارالفرج افکنده است",
      "CoupletIndex": 102
    },
    {
      "VOrder": 207,
      "Position": "Right",
      "Text": "یا بهل این غمکده نغمه سنج",
      "CoupletIndex": 103
    },
    {
      "VOrder": 208,
      "Position": "Left",
      "Text": "یا بکش این زهر وزتلخی مرنج",
      "CoupletIndex": 103
    },
    {
      "VOrder": 209,
      "Position": "Right",
      "Text": "این همه آرایش دامان دوست",
      "CoupletIndex": 104
    },
    {
      "VOrder": 210,
      "Position": "Left",
      "Text": "خیز و بشو چشمه تسنیم اوست",
      "CoupletIndex": 104
    },
    {
      "VOrder": 211,
      "Position": "Right",
      "Text": "آتش این سوختگی خامی است",
      "CoupletIndex": 105
    },
    {
      "VOrder": 212,
      "Position": "Left",
      "Text": "مرهم این داغ زناکامی است",
      "CoupletIndex": 105
    },
    {
      "VOrder": 213,
      "Position": "Right",
      "Text": "داغ رضانه بدل هر غمی",
      "CoupletIndex": 106
    },
    {
      "VOrder": 214,
      "Position": "Left",
      "Text": "ریش فروشوی زهر مرهمی",
      "CoupletIndex": 106
    },
    {
      "VOrder": 215,
      "Position": "Right",
      "Text": "درد بطنازی درمان فرست",
      "CoupletIndex": 107
    },
    {
      "VOrder": 216,
      "Position": "Left",
      "Text": "مرگ بسر چشمه حیوان فرست",
      "CoupletIndex": 107
    },
    {
      "VOrder": 217,
      "Position": "Right",
      "Text": "مرهم صد داغ کن این ریش را",
      "CoupletIndex": 108
    },
    {
      "VOrder": 218,
      "Position": "Left",
      "Text": "کز غم مرهم بستد خویش را",
      "CoupletIndex": 108
    },
    {
      "VOrder": 219,
      "Position": "Right",
      "Text": "من که دلم تازه کند زخم نیش",
      "CoupletIndex": 109
    },
    {
      "VOrder": 220,
      "Position": "Left",
      "Text": "مرهم ریشم چه بود باز ریش",
      "CoupletIndex": 109
    },
    {
      "VOrder": 221,
      "Position": "Right",
      "Text": "زنده درونی که بدرد آشناست",
      "CoupletIndex": 110
    },
    {
      "VOrder": 222,
      "Position": "Left",
      "Text": "مرهم کوید نمکش مدعاست",
      "CoupletIndex": 110
    },
    {
      "VOrder": 223,
      "Position": "Right",
      "Text": "ریش کزو خون نرود ریش نیست",
      "CoupletIndex": 111
    },
    {
      "VOrder": 224,
      "Position": "Left",
      "Text": "راحت از و نیم قدم پیش نیست",
      "CoupletIndex": 111
    },
    {
      "VOrder": 225,
      "Position": "Right",
      "Text": "آنکه ندارد سر این ماجرا",
      "CoupletIndex": 112
    },
    {
      "VOrder": 226,
      "Position": "Left",
      "Text": "بس بودش ننگ سلامت جزا",
      "CoupletIndex": 112
    },
    {
      "VOrder": 227,
      "Position": "Right",
      "Text": "ای بره تشنه لبی در شتاب",
      "CoupletIndex": 113
    },
    {
      "VOrder": 228,
      "Position": "Left",
      "Text": "تشنگی آموز مزاج سراب",
      "CoupletIndex": 113
    },
    {
      "VOrder": 229,
      "Position": "Right",
      "Text": "آب تو در چشمه ناکامی است",
      "CoupletIndex": 114
    },
    {
      "VOrder": 230,
      "Position": "Left",
      "Text": "صاف تو در جام تهی جامیست",
      "CoupletIndex": 114
    },
    {
      "VOrder": 231,
      "Position": "Right",
      "Text": "هان نچشی زین عسل اندیشه کن",
      "CoupletIndex": 115
    },
    {
      "VOrder": 232,
      "Position": "Left",
      "Text": "منع دل و منع هوس پیشه کن",
      "CoupletIndex": 115
    },
    {
      "VOrder": 233,
      "Position": "Right",
      "Text": "شهد بیفشان و مگس ران بگیر",
      "CoupletIndex": 116
    },
    {
      "VOrder": 234,
      "Position": "Left",
      "Text": "در جگر چشمه حیوان بمیر",
      "CoupletIndex": 116
    },
    {
      "VOrder": 235,
      "Position": "Right",
      "Text": "وانگه از این مرگ بزی جاودان",
      "CoupletIndex": 117
    },
    {
      "VOrder": 236,
      "Position": "Left",
      "Text": "یاد کن از عرفی معنی فشان",
      "CoupletIndex": 117
    }
  ]
}
