      "Text": "وهم درآمد که نشیند برین",
      "CoupletIndex": 91
    },
    {
      "VOrder": 184,
      "Position": "Left",
      "Text": "تیره شدش دیده نابود بین",
      "CoupletIndex": 91
    },
    {
      "VOrder": 185,
      "Position": "Right",
      "Text": "سرمه کش دیده ما اعمی است",
      "CoupletIndex": 92
    },
    {
      "VOrder": 186,
      "Position": "Left",
      "Text": "دیده همان در طلب سلمی است",
      "CoupletIndex": 92
    },
    {
      "VOrder": 187,
      "Position": "Right",
      "Text": "عقل که در وادی حیرت شتافت",
      "CoupletIndex": 93
    },
    {
      "VOrder": 188,
      "Position": "Left",
      "Text": "رو بحرم داشت ولی دیر یافت",
      "CoupletIndex": 93
    },
    {
      "VOrder": 189,
      "Position": "Right",
      "Text": "رهبر ما راه صوابش یکیست",
      "CoupletIndex": 94
    },
    {
      "VOrder": 190,
      "Position": "Left",
      "Text": "چهره نگویم که نقابش یکیست",
      "CoupletIndex": 94
    },
    {
      "VOrder": 191,
      "Position": "Right",
      "Text": "پای طلب سوده در اول قدم",
      "CoupletIndex": 95
    },
    {
      "VOrder": 192,
      "Position": "Left",
      "Text": "وه که نزد برتر از این کس قدم",
      "CoupletIndex": 95
    },
    {
      "VOrder": 193,
      "Position": "Right",
      "Text": "معرفتش زینت بیرون در",
      "CoupletIndex": 96
    },
    {
      "VOrder": 194,
      "Position": "Left",
      "Text": "نقش و نگاری است ز خون جگر",
      "CoupletIndex": 96
    },
    {
      "VOrder": 195,
      "Position": "Right",
      "Text": "طفل محبت که حرم زاد اوست",
      "CoupletIndex": 97
    },
    {
      "VOrder": 196,
      "Position": "Left",
      "Text": "هم بدرون نغمه دیدار اوست",
      "CoupletIndex": 97
    },
    {
      "VOrder": 197,
      "Position": "Right",
      "Text": "حسن که وی را بود آئینه دار",
      "CoupletIndex": 98
    },
    {
      "VOrder": 198,
      "Position": "Left",
      "Text": "دیده و دل صورت آینه دار",
      "CoupletIndex": 98
    },
    {
      "VOrder": 199,
      "Position": "Right",
      "Text": "حوصله وصل دلارام نیست",
      "CoupletIndex": 99
    },
    {
      "VOrder": 200,
      "Position": "Left",
      "Text": "باده باندازه نه و جام نیست",
      "CoupletIndex": 99
    },
    {
      "VOrder": 201,
      "Position": "Right",
      "Text": "ما که و اندازه دیدار دوست",
      "CoupletIndex": 100
    },
    {
      "VOrder": 202,
      "Position": "Left",
      "Text": "حسن تماشا و تماشای دوست",
      "CoupletIndex": 100
    },
    {
      "VOrder": 203,
      "Position": "Right",
      "Text": "کو دل اندازه نعمت شناس",
      "CoupletIndex": 101
    },
    {
      "VOrder": 204,
      "Position": "Left",
      "Text": "تا طلبم نعمت و دارم سپاس",
      "CoupletIndex": 101
    },
    {
      "VOrder": 205,
      "Position": "Right",
      "Text": "شمع طلب بر نفروزیم به",
      "CoupletIndex": 102
    },
    {
      "VOrder": 206,
      "Position": "Left",
      "Text": "در تب امید بسوزیم به",
      "CoupletIndex": 102
    },
    {
      "VOrder": 207,
      "Position": "Right",
      "Text": "دست بدامان طلب چون زنم",
      "CoupletIndex": 103
    },
    {
      "VOrder": 208,
      "Position": "Left",
      "Text": "ور بزنم لاف ادب چون زنم",
      "CoupletIndex": 103
    },
    {
      "VOrder": 209,
      "Position": "Right",
      "Text": "ور بمیان آوردم رو سفید",
      "CoupletIndex": 104
    },
    {
      "VOrder": 210,
      "Position": "Left",
      "Text": "بر در فردوس نویسم امید",
      "CoupletIndex": 104
    },
    {
      "VOrder": 211,
      "Position": "Right",
      "Text": "ور کند از راه عتابم دلیل",
      "CoupletIndex": 105
    },
    {
      "VOrder": 212,
      "Position": "Left",
      "Text": "شعله نپوشم نچشم سلسبیل",
      "CoupletIndex": 105
    },
    {
      "VOrder": 213,
      "Position": "Right",
      "Text": "عرفی اگر بلبل اگر زاغ اوست",
      "CoupletIndex": 106
    },
    {
      "VOrder": 214,
      "Position": "Left",
      "Text": "نغمه توحید زن باغ اوست",
      "CoupletIndex": 106
    }
  ]
}
