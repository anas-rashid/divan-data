      "Text": "ورنه کرا طاقت ایذای تست",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "نغمه بلبل چمن آرای باغ",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "گل به تبسم طلبد صوت زاغ",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "بلبل دستان زن باغت منم",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "زیب ده سینه بداغت منم",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "نغمه گشای چمنت صوت زاغ",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "عطسه زن بوی گلت هر دماغ",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "جلوه گه سبزه بخس داده",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "منصب طوبی بمگس داده",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "حسن در آغوش هوس تابکی",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "غیرت سیمرغ و مگس تابکی",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "گو چمنت صوت کلاغی بدار",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "باغ تو گو نغمه زاغی بدار",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "در چمن روضه خسی گو مباش",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "چند نمک بر جگر بیخراش",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "صد مگس شیفته انگبین",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "رم کند از جنبش یک آستین",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "آتش اگر شعله فروزد هزار",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "جوشش پروانه بود برقرار",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "مقصد پروانه هستی گداز",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "در قدم شمع بود سوز و ساز",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "شعله بوی در زدن از خامیست",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "زانکه مرادش همه ناکامیست",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "ور مگس آمد بر شمع از کمین",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "مست ز مومش طمع انگبین",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "در عرق الماس گذارم بقند",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "لیک بود شربت من نوشخند",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "این نفس بسته بناموس عهد",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "زهر نمائیست فروشنده شهد",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "وای که بس بیهده رنجیده",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "وین نفس تلخ پسندیده",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "تلخ دم من بمذاقت بسنج",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "گر نکنی آشتی از خود مرنج",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "تلخ سخن شو که دعا می کنیم",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "جنگ ترا صلح فدا می کنیم",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "حیف که هر خون که بود در دلم",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "چون حرم خاک شود منزلم",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "لاله که رنگ ورق از خون دهد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "از جگرم چیند و بیرون دهد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "زین سخنان ننگ غرض دور دار",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "بی ادبیهاست تو معذور دار",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "عرفی از این زمزه ات ننگ باد",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "عود مجازت عدم آهنگ باد",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "صورت آئینه پرستی که چه",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "بوی میت نازده مستی که چه",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "وای اگر چهره بود در نقاب",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "باز دهد آینه این رنگ و آب",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "هر چه در این دایره صورت پذیر",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "هر که در این مرحله آرام گیر",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "دل به کسی ده که به خود قائمست",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "جلوه معشوقی او دائمست",
      "CoupletIndex": 64
    }
  ]
}
