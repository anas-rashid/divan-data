    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "نعت تو از آینه ام ننگ برد",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "تا همه از دیده طبعم سترد",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "من کیم و جوهر طبعم کدام",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "تا برم از گوهر نعت تو نام",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "شوق من این بی ادبی می کند",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "دعوی چندین سببی می کند",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "عقل که باغ صفت آرای تست",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "تشنه زینت گری رای تست",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "قبض ترا نامیه مزد ورباد",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "باغ تو از فیض تو معمور باد",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "ای که دهی گنج عطارایگان",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "گوهر گنجینه بعرفی فشان",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "ور گهرش هست سزاوار گنج",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "لطف تو میداند و ایثار گنج",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "ای نگران خفته هشیار مست",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "شاهد معنی بعماری نشست",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "رقص کنان بهر وداع آمده",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "ناقه و محمل بسماع آمده",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "خیز و دو روزیش عنانگیر خیز",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "جمله خرابیم بتعمیر خیز",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "شرم ملامت برد از ننگ ما",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "گوهر ایمان شکند سنگ ما",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "هر دو از این صومعه رم کرده ایم",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "رو بحرمگاه عدم کرده ایم",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "ما سفری راهرنان در کمین",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "مایه ما گوهر ایمان ودین",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "خیز که ما را سر این کرد نیست",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "همره این غافله یک مرد نیست",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "جمله متاع از پی غارت بریم",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "جنس خرابی بعمارت بریم",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "ای تو عمارتگر مشتی خراب",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "وی زتو قارون زمین گنج یاب",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "مجلس ما تیره تر است از دماغ",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "نیست بگنجی نه روا شب چراغ",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "شرع تو آسوده در این دام چند",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "رنج محبت بوی آرام چند",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "این قمر از بهر چنین برج نیست",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "این گهر آرایش این درج نیست",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "محمل آرام بجمازه بند",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "زیور این مژده بآوازه بند",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "بسکه بره شمع دعا سوختم",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "گوشه محمل بنما سوختم",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "بسکه کنم یاد لبت گریه ناک",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "بی تو کشم جرعه روحی فداک",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "چشم من و چشمه حیوان یکی است",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "آب من و خون شهیدان یکی است",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "تا بکی از منبر ظلمت تصیب",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "نغمه تزویر برآرد خطیب",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "خیز و ترنم بپیش درفکن",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "وز نفست موج بگو هر فکن",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "صومعه آراسته اند از ریا",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "شرع نواست این بتماشا بیا",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "خیز و بر افکن ز جبینش نقاب",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "تا بشتاسیم شب از آفتاب",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "شرع تو را جمله در افزایشند",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "در صدد زینت و آرایشند",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "بسکه در افزوده در او برگ و ساز",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "گر بنمایم نشناسیش باز",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "گرچه از این طایفه پنهان به است",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "شرع تو چون تیغ تو عریان به است",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "این رربی غش که بر او نام توست",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "دست بدست آمدنش سکه شست",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "بر لب وی تازه کن این نام را",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "سکه نو زن زر اسلام را",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "ما همه رنجور و مسیحا توئی",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "داروی بیدردی دلها توئی",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "نیم دعا بهر دو عالم بس است",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "بل زتو آهنگ دعا هم بس است",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "با نفس نایب طوفان نوح",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "کین خس و خاشاک بروبد ز روح",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "با نفس مست می مرحمت",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "کز ره ما رفته شود معصیت",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "دست برآور که محل دعاست",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "بر نفست روح اجابت نواست",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "شستن آلایش مشت غبار",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "سهل بود بر تو چو ابر بهار",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "حاصل این باغ مسلم کراست",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "سود و زیانش که بر دغم کراست",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "گرچه به صد معصیت آلوده‌ایم",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "چون تو شفیعی چه غم آسوده ایم",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "سینه عرفی که غم اندیش توست",
      "CoupletIndex": 75
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "راحتی عز تو و ریش توست",
      "CoupletIndex": 75
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "ره شفا خانه رازش بده",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "مرهم ناسور نوازش بده",
      "CoupletIndex": 76
    }
  ]
}
