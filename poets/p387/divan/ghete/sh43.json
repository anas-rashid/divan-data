      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "داد ایزد بپادشاه جهان\r\nخلفی همچو مهر عالمتاب\r\nتاج صاحبقران ثانی را\r\nگوهر بحر ازو گرفته حساب\r\nنامش اورنگ زیب کرده فلک\r\nتخت ازین پایه گشته عرش جناب\r\nچون باین مژده آفتاب انداخت\r\nافسر خویش بر هوا چو حباب\r\nطبع دریافت سال تاریخش\r\nزد رقم (آفتاب عالمتاب)",
      "HtmlText": null,
      "PoemFormat": "Ghete",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
