    },
    {
      "VOrder": 173,
      "Position": "Right",
      "Text": "چنان داد همت در آفاق داد",
      "CoupletIndex": 86
    },
    {
      "VOrder": 174,
      "Position": "Left",
      "Text": "که دست طلب از گرفتن فتاد",
      "CoupletIndex": 86
    },
    {
      "VOrder": 175,
      "Position": "Right",
      "Text": "نیابد جز این کار از دست ما",
      "CoupletIndex": 87
    },
    {
      "VOrder": 176,
      "Position": "Left",
      "Text": "که داریم بهر دعا بر خدا",
      "CoupletIndex": 87
    },
    {
      "VOrder": 177,
      "Position": "Right",
      "Text": "همیشه بر اورنگ فرماندهی",
      "CoupletIndex": 88
    },
    {
      "VOrder": 178,
      "Position": "Left",
      "Text": "بماناد در فر ظل اللهی",
      "CoupletIndex": 88
    },
    {
      "VOrder": 179,
      "Position": "Right",
      "Text": "وزین چار شهزاده کامران",
      "CoupletIndex": 89
    },
    {
      "VOrder": 180,
      "Position": "Left",
      "Text": "مسخر کند چار رکن جهان",
