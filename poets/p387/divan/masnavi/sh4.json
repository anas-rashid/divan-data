    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "چو در اسب سامان جولان ندید",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "چو شهبازی از خانه زین پرید",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "هماندم که بر اسب پا را فشرد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "روان دست جرأت بشمشیر برد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "علم کرد شمشیر و بر وی درید",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "کز آن سوی فیل غنیمش دوید",
