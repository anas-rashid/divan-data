      "Text": "وزان جنگ بس حکمت آموختند",
      "CoupletIndex": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "گرفتند تعلیم از فیل مست",
      "CoupletIndex": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "بفوج غنیمان فکندن شکست",
      "CoupletIndex": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "وگر پایداری بروز مصاف",
      "CoupletIndex": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "اگر روبرو برخورد کوه قاف",
      "CoupletIndex": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "چو این جنگ از کینه پرمایه بود",
      "CoupletIndex": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "بساط جدل طی نمی گشت زود",
      "CoupletIndex": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "برآئینه خاطر شاه تافت",
      "CoupletIndex": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "که باید بآن عرصه خود هم شتافت",
      "CoupletIndex": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "مبادا که شهزاده های دلیر",
      "CoupletIndex": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "شمارند فیلان جنگی حقیر",
      "CoupletIndex": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "دلیرانه تازند بر فیل مست",
      "CoupletIndex": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "که با شیر این بیشه این نشئه هست",
      "CoupletIndex": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "جنیبت طلب کرد و از پای خاست",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "زمین و زمان گفتی از جای خاست",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "درآمد به تند اشهبی برق سیر",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "هما کرده از سایه اش کسب خیر",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "سراسر بزرگان و گردنکشان",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "دوان در رکاب سعادت نشان",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "سران در رکاب مبارک اثر",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "ندانسته از شوق پا را ز سر",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "بآن عرصه چون شاه والا رسید",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "زمانی عنان تکاور کشید",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "خبر چونکه از مقدم شاه یافت",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "بآوردن در بدریا شتافت",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "ز سنگینی سایه پادشاه",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "بدل شد بابرام جوش سپاه",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "چو کم گشت آشوب از آن رستخیز",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "بفیلان جنگی اثر کرد نیز",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "زمانی سر از جنگ برداشتند",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "ولی چشم بر یکدگر داشتند",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "در اینوقت شطرنجی روزگار",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "که منصوبه بین است و بازی شمار",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "بنوعی دگر فیل این عرصه راند",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "که از وحشتش عقلها مات ماند",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "دوید از قضا ز آن دو فیل مهیب",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "یکی سوی شهزاده اورنگ زیب",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "بخشمی که پیش آیدش کوه اگر",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "دگر تا قیامت نبندد کمر",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "چو چرخی که چرخ آمدی گر فرو",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "نگرداندیش از ره کینه رو",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "صف چاره خلق درهم درید",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "بشهزاده شیر صولت رسید",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "بمردی ز جا یکسر مو نشد",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "ز راه چنین سیل یکسو نشد",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "ز پیشش عنان تکاور نتافت",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "زبردستی آسمان بر نتافت",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "بتمکین سرشته ز بس جوهرش",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "نجنبید جز نبض از پیکرش",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "بچشم جهان دهر تاریک شد",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "بخورشید آن ابر نزدیک شد",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "چو زین بیشتر صبر را جا نبود",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "درآویخت مانند آتش بدود",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "یکی برجه ای برق سان تافته",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "نظر از رگ غیرتش یافته",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "زقدرت چنان زد به پیشانیش",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "که جست از قفا برق رخشانیش",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "زبس برجه در کله اش شد نهان",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "سرش گشت فانوس شمع سنان",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "از آن رخنه کز بر چه شد در سرش",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "برون رفت مستی که بد در سرش",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "در آن کوه پیکر نهان شد سنان",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "دگر باره در رفت آهن بکان",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "ز برق سنان آتش کین فزود",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "همه شعله گردید آن تیره روز",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "ز خرطوم انداخت پیچان کمند",
