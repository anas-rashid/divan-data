    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "فتاد اسب شهزاده در شهر بند",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "گرفت اسب و شهزاده بروی سوار",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "زبیم آب شد زهره روزگار",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "بیفشاند بر اسب دندان کین",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "برآمد خروش از زمان و زمین",
