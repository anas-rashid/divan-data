    },
    {
      "VOrder": 169,
      "Position": "Right",
      "Text": "چنان چشم حرص از گهر گشت پر",
      "CoupletIndex": 84
    },
    {
      "VOrder": 170,
      "Position": "Left",
      "Text": "که مژگانش چون رشته شد پر زدر",
