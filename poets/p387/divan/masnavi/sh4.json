    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "چو نبود پسندیده پردلان",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "که گیرد یکی را دو تن در میان",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "ز روی مروت از آن دست داشت",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "به پیکار فیل غنیمش گذاشت",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "بتکلیف فطرت دلیری نمود",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "به سنی که تکلیف بروی نبود",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "درین سن اگر بودی افراسیاب",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "همی گشتی از دیدن فیل آب",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "نیاورده خلاق بالا و پست",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "غنیمی درین عرصه چون فیل مست",
