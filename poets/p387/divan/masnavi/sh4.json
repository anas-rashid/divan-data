    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "جدل با چنین تند خصم درشت",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "بگردون ستیزه است و بر کوه مشت",
      "CoupletIndex": 76
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "در آغاز و انجام این کارزار",
      "CoupletIndex": 77
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "همی دید شاهنشه کامکار",
      "CoupletIndex": 77
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "از آن شیردل چون بدید این جگر",
      "CoupletIndex": 78
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "بفرقش بیفشاند گنج گهر",
      "CoupletIndex": 78
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "سرش را زعزت بگردون رساند",
      "CoupletIndex": 79
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "برو فیلبار جواهر فشاند",
      "CoupletIndex": 79
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "بزر وزن شهزاده نامجوی",
      "CoupletIndex": 80
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "نمودند وزین گشت زر سرخ روی",
      "CoupletIndex": 80
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "نظر کرده شاه آفاق شد",
