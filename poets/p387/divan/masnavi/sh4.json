    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "چو از جوش مستی نشد خشمگین",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "فشارد بر افلاک دندان کین",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "حذر کن زخرطوم آن پر جدل",
