    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "تصدق بدرویش و محتاج داد",
      "CoupletIndex": 82
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "گدائی که بود از طلب در تعب",
      "CoupletIndex": 83
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "بآب گهر شست دست از طلب",
