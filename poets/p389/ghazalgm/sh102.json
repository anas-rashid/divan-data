      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "خرم دلی که در خم زلف تو جا گرفت\r\nآسوده آنکه خانه به کوی بلا گرفت\r\nخاک درت ز رشک نهفتم به آب چشم\r\nتا چشم غیر، روشنی از توتیا گرفت\r\nتیر تو سر فرود نیارد به هیچ صید\r\nمرغ دلم خدنگ ترا در هوا گرفت\r\nخلقی اسیر تهمت و من مجرم وفا\r\nدر قید او نماند کسی، تا مرا گرفت",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
