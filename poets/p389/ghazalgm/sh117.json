      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ایام بهارست و هوای چمنم نیست\r\nشادم به غمت ذوق گل و یاسمنم نیست\r\nگر شور قیامت شود از خاک نخیزم\r\nچون غنچه سر نشو و نما در کفنم نیست\r\nچون گلشن تصویر، گلم بوی ندارد\r\nبا آنکه گل ساخته‌ای در چمنم نیست\r\nچون عکس در آیینه گهی، گاه در آبم\r\nبیرون ز دل صاف‌ضمیران وطنم نیست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
