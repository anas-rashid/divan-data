      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مرا به ناله شد آن سرو سیم‌تن باعث\r\nچنان که بلبل شوریده را چمن باعث\r\nتو خواستی ز برم تند بگذری ورنه\r\nبرای مکث توان کرد صد سخن باعث\r\nغزال قدس که دیدی اسیر دانه و دام؟\r\nاگر نمی‌شدی آن سرو سیم‌تن باعث\r\nهمیشه باعث عشق بتان دل قدسی‌ست\r\nچنان که سجده بت راست برهمن باعث",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
