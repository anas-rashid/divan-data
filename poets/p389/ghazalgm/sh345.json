      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "همه جانب قدم مرحله‌پیما دارم\r\nروشناس غم عشقم، همه‌جا جا دارم\r\nغیرتم با تو چنان است که شبها به خیال\r\nجنگ پهلوی تو با صورت دیبا دارم\r\nاز پی نقش پی ناقه نیم سرگردان\r\nداغی از لاله درین دشت، تمنا دارم\r\nنروم سوی وی آهسته ز ترسیدن جان\r\nحذر از همرهی آبله پا دارم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
