    {
      "Index": 0,
      "Number": 1,
      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "اگر دور از دلارای خود افتم\r\nبه دست طبع خودرای خود افتم\r\nز سودای دو عالم باز مانم\r\nزمانی گر به سودای خود افتم\r\nشبم گرم است جا بر آستانت\r\nمباد آن روز، کز جای خود افتم\r\nنگیرد دامنم گر خاک کویت\r\nشوم زنجیر و در پای خود افتم\r\nغریبان را دهم در دیده ماوا\r\nز غربت گر به ماوای خود افتم\r\nتمنای فلک آن است قدسی\r\nکه من دور از تمنای خود افتم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 6
    }
