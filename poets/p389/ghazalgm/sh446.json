      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تاوان قتل صید زبون نیست بر کسی\r\nمنت برای قطره خون نیست بر کسی\r\nکافی‌ست شوق کشته‌شدن خونبها مرا\r\nدر روز حشر، دعوی خون نیست بر کسی\r\nهرکس به قدر همت خود می‌کشد جفا\r\nهرگز ستم ز همت دون نیست بر کسی\r\nعاقل کسی بود که کند غربت اختیار\r\nاز کشوری که دست جنون نیست بر کسی\r\nای غم به خانه دل قدسی وطن مکن\r\nتعمیر این خرابه، شگون نیست بر کسی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
