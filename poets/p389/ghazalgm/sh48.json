      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نهادی بر سر شوریدگان داغ\r\nزدی بر سر گره سودای ما را\r\nدر این بزم از حریفان چشم داریم\r\nکه نگذارند خالی جای ما را\r\nنظر بر جامه از برگشتگی‌هاست\r\nکسی نشناسد از سر پای ما را\r\nدرین بستان‌سرا عنقای عشقیم\r\nنمی‌داند کسی ماوای ما را\r\nخدا را شیخ شهر ار پرده پوشی\r\nمکن امروز شب فردای ما را",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
