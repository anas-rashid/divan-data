      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "خطش را کس به جز من مبتلا نیست\r\nبه این خط چشم هرکس آشنا نیست\r\nچمن شد از هجوم گل چنان تنگ\r\nکه مرغان را برای ناله جا نیست\r\nبه من خوش می‌رسد لطف تو امروز\r\nمگر چشم بداندیش از قفا نیست؟\r\nچه شد بوی گل امید یا رب\r\nکه رفت از بوستان و با صبا نیست\r\nخموشی پیشه کن گر مرد عشقی\r\nکه مرغ این گلستان را نوا نیست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
