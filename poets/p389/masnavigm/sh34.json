      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "همه بی‌معنیان لفظ‌تراش",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "نقششان را خبر نه از نقاش",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "همه بی‌بادبان و بی‌لنگر",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "کشتی افکنده در محیط خطر",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "بس که از دستشان کشد آزار",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "نالد انگشتشان چو موسیقار",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "وقت جنگ و جدل، ز بس اعراض",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "تیغ‌ها جفت کرده چون مقراض",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "طلبد دوست چون نظاره پاک",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "دیده دوزند همچو دام به خاک",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "چشمشان از پی نگاه حرام",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "روزن‌آباد گشته چون بادام",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "بحر ایشان، سراب راست غدیر",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "علمشان پای جهل را زنجیر",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "شمر کم خوان بر این گروه دغل",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "گل نریزد کسی به فرق جعل",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "خورده بر گوششان ز شعر پر آب",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "حرف مشهور موشدان و گلاب",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "طینت بد، به مرگ پاک شود",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "هرچه را خاک خورد، خاک شود",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "با یکی زین گروه پر شر و شور",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "گر به بزمی رسی چو زنده به گور",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "لب مجنبان پی سوال و جواب",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "بی نفس زنده باش چون سیماب",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "گر بود نکته‌سنج باانصاف",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "خویش را در سخن مدار معاف",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "گل چو پاشی، به فرق مردم پاش",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "خویشتن بین و خودستای مباش",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "شعر بر غیر نکته‌دان خواندن",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "آب خضرست بر گل افشاندن",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "در همه فن تو راست دست بهی",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "گر ز انصاف پا برون ننهی",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "خیز چون صبح گل‌فشانی کن",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "دم ز پیری مزن، جوانی کن",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "هرچه پست و بلند اشعارست",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "همه در جای خویش در کارست",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "شمع باشد شب انجمن‌افروز",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "هنر سایبان نماند روز",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "صد خُم از دُرد و یک پیاله صاف",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "خرمنی علم و نیم‌جو انصاف",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "جام و می رازدار یکدگرند",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "عینک و دیده یار یکدیگرند",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "سخنم مغتنم بود چون دُر",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "زانکه لفظش کم است و معنی پر",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "فارغ از گفتگوی بسیارم",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "چون صدف، یک دهن گهر دارم",
      "CoupletIndex": 61
    }
  ]
}
