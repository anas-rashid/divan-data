      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "به غیر کار جفا آسمان نمی‌داند\r\nخموش باش که گردون زبان نمی‌داند\r\nبه تنگنای جهانم ملال و عیش یکی‌ست\r\nکه مرغ بیضه بهار و خزان نمی‌داند\r\nز لطف نیست مرا گر گذاشته‌ست به باغ\r\nکه آشیان مرا باغبان نمی‌داند\r\nهما سلیم مرا خشک و ناتوان دیده‌ست\r\nهنوز لذت این استخوان نمی‌داند",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
