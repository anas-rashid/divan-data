      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دهد مرغ دلم را عزم پرواز\r\nدرای ناقه همچون زنگ شهباز\r\nدلم وقت تپیدن های شوقت\r\nدهد همچون جرس از سینه آواز\r\nمجو ناسازی از ما، زان که باشد\r\nتن چون موی ما ابریشم ساز\r\nکند مرغ دلم از ناتوانی\r\nبه بال دیگران چون تیر پرواز\r\nمگر بر داغ دوری خراسان\r\nنهم مرهم سلیم از سیر شیراز",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
