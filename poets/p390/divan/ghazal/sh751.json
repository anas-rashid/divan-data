      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "هر قطره ی شبنم رخ گل\r\nسیلی ست به خانمان بلبل\r\nعمرم همه در خیال او رفت\r\nچون آب روان به سایه ی گل\r\nمغرور به حسن خویشتن بود\r\nزلف تو شکست شاخ سنبل\r\nاز شرم رخ تو گل گریزد\r\nهر لحظه به زیر بال بلبل\r\nاز بهر دلم سلیم، دایم\r\nخم در خم زلف کرده کاکل",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
