      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "به کوی عشق خوبان تا گذشتم\r\nز رفتن همچو نقش پا گذشتم\r\nنه گل بر سر، نه خاری در کف پا\r\nچو باد از باغ، بی پروا گذشتم\r\nدلی بی آتش عشقت ندیدم\r\nبه افسون در رگ خارا گذشتم\r\nبه امید وصال بی وفایی\r\nچو خورشید از سر دنیا گذشتم\r\nسلیم از عشق خوبان حاصلی نیست\r\nزیان دارد، ازین سودا گذشتم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
