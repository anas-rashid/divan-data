      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نهادی بر دلم ای نازنین دست\r\nازین دست است احوالم ازین دست\r\nسرت درد خمار می مبیناد\r\nمبادا تکیه گاه آن چنین دست\r\nبود چون غنچهٔ نارسته از شاخ\r\nترا پنهان میان آستین دست\r\nچه باشد دل گرم از سینه بربود\r\nبتابد پنجهٔ خورشید این دست\r\nبعینه پنجهٔ خورشید صبح است\r\nبرآرد چون زجیب آن نازنین است",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
