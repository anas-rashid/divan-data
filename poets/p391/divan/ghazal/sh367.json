      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "هر دلی کز دست شد پابست اوست\r\nپای بست حسن بالا دست اوست\r\nسوختن صد داغ بر دل در دمی\r\nکارهای عشق آتش دست اوست\r\nناوکش جست از دل و من بی خبر\r\nنقد جان مزد صفای شست اوست\r\nنه همین چرخ است ازو در وجد و حال\r\nکف به لب آورده دریا مست اوست\r\nهر که او جویا ز خود وحشت نکرد\r\nراه صحرا کوچهٔ بن بست اوست",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
