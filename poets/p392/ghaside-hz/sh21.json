      "VOrder": 63,
      "Position": "Right",
      "Text": "چون یکی ذره، همّتش گیتی",
      "CoupletIndex": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "پیش خورشید خاور اندازد",
      "CoupletIndex": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "گر بیابد شراک نعلش حور",
      "CoupletIndex": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "جای زلف معنبر اندازد",
      "CoupletIndex": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "رای او چون علم زند گردون",
      "CoupletIndex": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "پرده بر نور خاور اندازد",
      "CoupletIndex": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "گر کند تکیه بر حمایت او",
      "CoupletIndex": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "عرض از خویش جوهر اندازد",
      "CoupletIndex": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "غلغل ذکر زایران درش",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "لرزه بر قصر قیصر اندازد",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "چون لوای ظفر برافرازد",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "سایه بر هفت اختر اندازد",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "برق رُمحش به نیستان چو جهد",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "ناخن از کف غضنفر اندازد",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "در مصافی که باد حملهٔ او",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "از سر فتنه مغفر اندازد",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "زور سرپنجه ی ولایت او",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "رعشه، در حصن خیبر اندازد",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "آب بیلک شرار خرمن سوز",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "به نهنگ بلا در اندازد",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "خم گیسوی جوهر تیغش",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "گردنان را به چنبر اندازد",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "گرز یک لختیش به صدمه ز کار",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "یال و بُرز دو پیکر اندازد",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "لرزهٔ هیبتش چو موج از تن",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "جوشن سام صفدر اندازد",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "عکس تیغش کند چو جلوه گری",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "جسم آیینه جوهر اندازد",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "مدحتش ماهی زبان مرا",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "در شط می شناور اندازد",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "غیبتم سوخت قرب دوست، مگر",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "رسم هجر از میان بر اندازد",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "بنده پرور شها نثار رهت",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "خاطرم گنج گوهر اندازد",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "نه سواد است و نه صریر قلم",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "عطسهٔ خامه عنبر اندازد",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "چون نشینم خمش که مدحت تو",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "آتش شوق در سر اندازد؟",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "گردمی، نغمه درگلو شکنم",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "در گریبانم اخگر اندازد",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "چون شکیبد دلم که شعله کمند",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "درگلوی سمندر اندازد؟",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "خارخار ستایش تو مرا",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "بر رک و ریشه، نشتر ندازد",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "سایه چون مدحت افکند به ضمیر",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "خامه خورشید انور اندازد",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "گرم مدح تو چون شود نفسم",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "عود و عنبر به مجمر اندازد",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "برکشد زاغ خامه ام چو صفیر",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "شاهباز فلک پر اندازد",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "شاهد بی نیاز طبع مرا",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "بیند ار حور، زیور اندازد",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "گر به گلشن ز نظم من به میان",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "عندلیب نواگر اندازد",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "از سر شوق گل به دامانش",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "حلّه های معطّر اندازد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "صیت جاه من ازگدایی تو",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "نام جم از جهان بر اندازد",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "بر درت دست بی نیازی من",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "خاک درکاسه خور اندازد",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "جوهری چون تویی، سخن با من",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "کس نیارد، برابر اندازد",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "ناتراشیده خارهای بدل",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "کی شکستی به گوهر اندازد؟",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "نقش کلکم عطارد ار بیند",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "به خوی شرم، دفتر اندازد",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "نقطهٔ امتحان خامهٔ من",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "شور در مغز اختر اندازد",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "می دانش فزای فکرت من",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "هوش را نشئه در سر اندازد",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "بیند ار حلّهٔ بلاغت من",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "لفظ را معنی از بر اندازد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "فعلِ مشتق زشرم تقریرم",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "خوبش در صلب مصدر اندازد",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "جان فزا مدحتت که آب بقاست",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "موجه در جوی مسطر اندازد",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "شکر للّه، نشد که خامهٔ من",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "جز مدیحت به دفتر اندازد",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "نقص همّت نگر که خاقانی",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "زیر پای قزل سر اندازد",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "زیر پایم قضا به دولت تو",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "اطلس چرخ اخضر اندازد",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "سدِّ نظمی که در جهان بستم",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "ظلم یاجوج را بر اندازد",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "خامه یازم، چو در جهان گیری",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "علم ازکف سکندر اندازد",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "اژدها کلک کاویانی من",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "سر ضحاکِ اژدر اندازد",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "زین قلم حاسد است، زهره شکاف",
      "CoupletIndex": 75
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "نی به ناف بداختر اندازد",
      "CoupletIndex": 75
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "شرمگین از قصور خود نشوم",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "عفوت ار سایه بر سر اندازد",
      "CoupletIndex": 76
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "خاطرم طرح قصر شأن تو را",
      "CoupletIndex": 77
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "چون به فکر محقّر اندازد",
      "CoupletIndex": 77
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "تا خرامی به تارکش، خود را",
      "CoupletIndex": 78
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "سدره، در پای منبر اندازد",
      "CoupletIndex": 78
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "با ولای تو، جام تلخ اجل",
      "CoupletIndex": 79
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "کام جان را به شکر اندازد",
      "CoupletIndex": 79
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "تا ابدگوش اگر دهی به لبم",
      "CoupletIndex": 80
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "چه گهرهای بی مر اندازد",
      "CoupletIndex": 80
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "چشم دارم که خاک درگاهت",
      "CoupletIndex": 81
    },
    {
      "VOrder": 164,
      "Position": "Left",
      "Text": "سُرمه واری به منظر اندازد",
      "CoupletIndex": 81
    },
    {
      "VOrder": 165,
      "Position": "Right",
      "Text": "صلهٔ مدح، گوشهٔ نظری",
      "CoupletIndex": 82
    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "به حزین ثناگر اندازد",
      "CoupletIndex": 82
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "طمع دنیوی لبم نکند",
      "CoupletIndex": 83
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "حرف خواهش به محشر اندازد",
      "CoupletIndex": 83
    },
    {
      "VOrder": 169,
      "Position": "Right",
      "Text": "جرعه نوش زمانه نیست لبم",
      "CoupletIndex": 84
    },
    {
      "VOrder": 170,
      "Position": "Left",
      "Text": "تشنگی را به کوثر اندازد",
      "CoupletIndex": 84
    },
    {
      "VOrder": 171,
      "Position": "Right",
      "Text": "زر و سیم و گهر عنایت تو",
      "CoupletIndex": 85
    },
    {
      "VOrder": 172,
      "Position": "Left",
      "Text": "می نخواهم به چاکر اندازد",
      "CoupletIndex": 85
    }
  ]
}
