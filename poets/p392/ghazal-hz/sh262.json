      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "گل بی تو مرا به دیده خار است\r\nهر سبزه چو تیغ آب دار است\r\nاز نقش قدم بسی فزونتر\r\nدر راه تو چشم انتظار است\r\nچون لاله ز داغ دوری تو\r\nخون دل و دیده درکنار است\r\nدرمان هزار دردمند است\r\nدردت که به جان بی قرار است\r\nدریاب به پرسشی حزین را\r\nکز لعل لب تو در خمار است",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
