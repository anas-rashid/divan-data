      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ای درد تو یار جانی من\r\nاندوه تو شادمانی من\r\nپیرایه ی داغ توست چون شمع\r\nسرمایه ی زندگانی من\r\nبیماری من حلاوت آمیخت\r\nبا تلخی زندگانی من\r\nآهن موم است از تب گرم\r\nدر پنجهٔ ناتوانی من\r\nدشوار زمانه گشت آسان\r\nاز همّت سخت جانی من\r\nعنقا که شنیده ای ز افواه\r\nنامی ست ز بی نشانی من\r\nگویند حزین به داستان ها\r\nاز نغمهٔ باستانی من",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 7
    }
