      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "آزاده، از حیات خود آزار می‌کشد\r\nباری‌ست این، که دوش سبکبار می‌کشد\r\nبر خصم تندخوست دلم، کورهٔ گداز\r\nزین خون گرم، نیشتر آزار می‌کشد\r\nتنها نه کفر زلف تو زد راه تقویم\r\nزاهد به سبحه، رشتهٔ زنّار می‌کشد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
