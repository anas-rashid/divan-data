      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "یکایک از نظرم نور پیکران رفتند\r\nستاره های شب افروزم از میان رفتند\r\nبه زمهریر جهان، هم صفیر زاغانم\r\nخزان رسید و گل افسرد و بلبلان رفتند\r\nز خون دل شکنم بعد از این خمار، مگر\r\nبه سنگ، لاله قدح زد که می کشان رفتند",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
