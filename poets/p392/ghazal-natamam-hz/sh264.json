      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "زد نقش سخن سکهٔ جاوید به نامم\r\nاز صفحهٔ دلها نشود محو، کلامم\r\nنوری ست عیان، در نظر حرف شناسان\r\nهر مردمک نقطه ی خورشید، غلامم\r\nنظاره کن امروز، گلستان ارم را\r\nدر جلوه گه خامهٔ طاووس خرامم\r\nهر لفظ حزین خانهٔ صد شاهد معنی ست\r\nلیلی کده ها جلوه دهد طرف خیامم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
