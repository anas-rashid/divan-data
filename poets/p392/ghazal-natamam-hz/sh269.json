      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "جز وصل علاج دل بیچاره ندارم\r\nامّا چه کنم؟ طاقت نظّاره ندارم\r\nتا دسترسم بود، زدم چاک گریبان\r\nشرمندگی، از خرقهٔ صد پاره ندارم\r\nانصاف ده، ای شیشهٔ طاقت زده بر سنگ\r\nآخر به بغل دل بودم، خاره ندارم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
