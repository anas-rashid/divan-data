      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "به کف تیغ من اژدها پیکری ست\r\nاباصولت شیر و خشم پلنگ\r\nدر این کاخ ظلمت، درخشان چراغ\r\nبه دربای هیجا، تناور نهنگ\r\nز پاکی گوهر، لبالب ز آب\r\nز خون یلانش، به رخساره رنگ\r\nنماید ظفر را به ساغر شراب\r\nشکر را به کام مخالف، شرنگ\r\nمباد از رخش زلف جوهر، نهان\r\nز آیینهاش دور، آسیب زنگ",
      "HtmlText": null,
      "PoemFormat": "Ghete",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
