      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "شبی در نشابور مأوای من\r\nبه تقدیر فرمانده ذوالمنن\r\nسرتربت پاک عطار بود\r\nدلم آگه و دیده بیدار بود\r\nمراقب نشستم چو نیمی ز شب\r\nصفا یافت وقتم، صفایی عجب\r\nشنیدم که می گفت آن پیر راه\r\nاگر مرد عشقی، مرادی مخواه\r\nچو این حرف ازو گوهر گوش شد\r\nز گفتار لب بست و خاموش شد",
      "HtmlText": null,
      "PoemFormat": "Masnavi",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
