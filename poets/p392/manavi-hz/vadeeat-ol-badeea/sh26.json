      "Position": "Right",
      "Text": "طول ابعاد مرتفع گردد",
      "CoupletIndex": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "عرض احجام ممتنع گردد",
      "CoupletIndex": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "مُتعیّن ز بس که مدهوش است",
      "CoupletIndex": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "کوه خارا چو عهن منفوش است",
      "CoupletIndex": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "بحر و بر اتّصال درگیرد",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "فوق و تحت، امتیاز برگیرد",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "ستر برخیزد از حجاب اندیش",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "یوم تُبلی السرائر آید پیش",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "یوم مجموع و یوم مشهود است",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "قاع صفصف زمین ممدود است",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "قضی الامر بینهم بالحق",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "فتری کلَّ باطلٍ یزهق",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "موت عارف، قیامت است و قیام",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "بعد بعث از قبور، حشر عوام",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "پس حیات خواص متّصل است",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "در حقیقت ز موت منفصل است",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "زنده را موت و فوت هرگز نیست",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "حکم مردن به زنده جایز نیست",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "آنکه جایز بود ورا مردن",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "زندگی مرد راست جان کندن",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "عارف از موت اختیاری خویش",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "زندگی دید و پایداری خویش",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "او به دنیا در آخرت باشد",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "در میان کی مباعدت باشد؟",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "در خور این مفاخرت ماییم",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "می دنیا و آخرت ماییم",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "گفته مبعوث واجب الطّاعت",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "لاتفرق ببعث و الساعت",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "نک قیامت منم، جدایی نیست",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "جای تشکیک و سست رایی نیست",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "روح انسان مدبر صور است",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "خلع و تبدیل آن ز حد به در است",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "چه به دنیا چه آخرت چه مثال",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "حامل صورت است در هر حال",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "اولین صورتی که یافت حصول",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "کرد از برزخ مثال قبول",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "اخذ میثاق از او نمود خدای",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "پس از آن شد بشیر راهنمای",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "چون تعلق گرفت روح به تن",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "این دوم صورت است تا مردن",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "خلع اول نمود وشد محشور",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "از سرای غرور و ظلمت و نور",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "چون ز گرد بساط جسمانی",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "آمدش وقت دامن افشانی",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "کرد تحویل در سوم صورت",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "حشر میّت بود در آن کسوت",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "صورت آن است تا به وقت سوال",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "هم نماید بدل محوّل حال",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "تا که بعد از سوال هم گیرد",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "صورتی درکنار بپذیرد",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "مدتی برزخی بود محشور",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "تارسد وقت بعث ونفخهٔ صور",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "هم به کل از مفارق دنیا",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "می کند انتقال روز جزا",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "تا سؤالی اگر بود باقی",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "چون میش در قدح کند ساقی",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "ساقی و دُرد را ایاغ آید",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "همگی طی شود فراع آید",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "حشر در صورتی شود پس از آن",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "که بود در خور جحیم و جنان",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "اهل نازند جملگی مسؤول",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "به تقاضای شوم و طبع فضول",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "ور سؤالی نمانده روز جزا",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "حشر جنّت بود به او زیبا",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "زان سپس چونکه آیدش به نظر",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "شوق جنّت پر از متاع صُور",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "هرچه مستحسن آیدش زآنها",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "در همان حشر او شود پیدا",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "لایزال این بود به جنت کار",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "دائم الحشر در صور بسیار",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "چونکه تکرار در تجلّی نیست",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "هر یکی تازه در پی دگریست",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "متجلی الیه را هم باز",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "نسبتی بایدش نمودن ساز",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "تا شود مستعدّ هر یک از آن",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "متجدد شود صور به جنان",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "در صور حشر بی تناهی را",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "نسبت خاص دان تجلی را",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "اینهمه بسط ملک سلطانیست",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "اتّساع بساط رحمانی ست",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "ور تو را چشم تیزبین باشد",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "حالت اکنون هم اینچنین باشد",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "در تو هر حالتی که یافت ظهور",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "به همان وصف و صورتی محشور",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "رودت گر ز سر گران خوابی",
      "CoupletIndex": 75
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "هر تغیّر که در صفت یابی",
      "CoupletIndex": 75
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "حشر آن دم به صورت دگر است",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "که مناسب به حال ماظهر است",
      "CoupletIndex": 76
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "صورت شادی و غمت یک نیست",
      "CoupletIndex": 77
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "همچنین شهوت و غضب، شک نیست",
      "CoupletIndex": 77
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "باز هنگام طاعت و عصیان",
      "CoupletIndex": 78
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "در صور هم تجدد است عیان",
      "CoupletIndex": 78
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "وقت مستیّ و وقت مخموری",
      "CoupletIndex": 79
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "سحر وصل و شام مهجوری",
      "CoupletIndex": 79
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "در مقام رضا و تسلیم است",
      "CoupletIndex": 80
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "دم امّید و ساعت بیم است",
      "CoupletIndex": 80
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "هر نفس حشر مختلف داری",
      "CoupletIndex": 81
    },
    {
      "VOrder": 164,
      "Position": "Left",
      "Text": "هرچه صورت گرفت بگذاری",
      "CoupletIndex": 81
    },
    {
      "VOrder": 165,
      "Position": "Right",
      "Text": "لیک از آن غافلی که هوشت نیست",
      "CoupletIndex": 82
    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "کر و کوری، که چشم و گوشت نیست",
      "CoupletIndex": 82
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "غفلت آسوده داردت اکنون",
      "CoupletIndex": 83
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "کل حزبٍ بما لهم فرحون",
      "CoupletIndex": 83
    }
  ]
}
