      "VOrder": 75,
      "Position": "Right",
      "Text": "المی را که در جزا بیند",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "المی سخت و جانگزا بیند",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "عالم عقلیش اگر گفتم",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "حکمت مخفی، از تو ننهفتم",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "در تقابل به جنّت عقلی",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "از تشاکل به لذّت عقلی",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "الم و لذّت از مشاکلت است",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "نسبت عقل، از مقابلت است",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "چون الم، با عدم رجوع نمود",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "متصورعدم بود ز وجود",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "جنت و نار مکتسب باشد",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "صورت رحمت و غضب باشد",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "الم است آن ولی شعورش نه",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "خبری از خود و قصورش نه",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "این دو گر در هلاک، مشترک است",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "لیک آسوده، هر یکی ز یک است",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "آن بلاهت به از فطانت توست",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "وجع این به از امانت توست",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "وان دگر دوزخی که محسوس است",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "عالم حسرت است و افسوس است",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "در جدایی ز الفت دنیا",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "وز تعلّق به این فریب سرا",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "رنج فقدان او فروگیرد",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "که به هر دم، به صد الم میرد",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "ارتکاب قبایح اعمال",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "اعتیاد کواذب اقوال",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "ملکات ردیهٔ اخلاق",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "دل نهادن به خلق از خلّاق",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "انبعاث فساد شیطانی",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "احتلام نظام سلطانی",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "همه در نفس، مرتسخ گشته",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "به دو صد مار و مور آغشته",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "نفس چون گشته است کاسب آن",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "صُوَری برزند مناسب آن",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "متجسم شود در آن عالم",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "صور جمله بی زیاده وکم",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "هر که امروز، در مظالم مرد",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "رفت و با خویش دوزخی را برد",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "آنچه نفس غریزیش خوانی",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "آن چو افلاج دان و بی جانی",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "خود به خود برفروختی دوزخ",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "از هلاک و گناه یوم نفخ",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "این تمکن چو نقش پیدا کرد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "نتواند که ترک انشا کرد",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "هست پیوسته، تلخ، کام از وی",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "متأذّی بود مدام از وی",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "این چنان است، کاندرین مرصد",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "نفس را چون مصیبتی برسد",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "هر زمانی که آن خطور کند",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "سلب آسایش و سرورکند",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "متأذّی شود، غم آلوده",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "زهر جانکاه غصه پیموده",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "نتواندکه یاد آن نکند",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "دل از آن بار غم گران نکند",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "لیکن اندر شواغل دنیا",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "یاد از آن محنت آید، احیانا",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "شودش بعد یک دو لمحه، ذهول",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "دل به کار دگر کند مشغول",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "آخرت عکس این جهان باشد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "از شواغل، نه این، نه آن باشد",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "عدم شاغل و صفای محل",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "قوت نفس و اجتماع جُمل",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "ره ندارد در آن، فراموشی",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "نه خمار و نه خواب و بی هوشی",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "می نگنجد هُناک، راح به روح",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "نه سواد شب ونه فتق صبوح",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "لاجرم تلک اجتباهُ معک",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "آلم النفس قسط لاینفک",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "لیک از آنجا که نیست این شبهات",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "نفس را عین سنخ جوهر ذات",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "عقل، آزادی احتمال دهد",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "گر خدا خواهد، انفعال دهد",
      "CoupletIndex": 72
    }
  ]
}
