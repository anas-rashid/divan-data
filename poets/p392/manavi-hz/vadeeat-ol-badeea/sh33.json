      "VOrder": 55,
      "Position": "Right",
      "Text": "مفتیان و قضات باطن کور",
      "CoupletIndex": 27
    },
    {
      "VOrder": 56,
      "Position": "Left",
      "Text": "همه شب مست و هر سحر مخمور",
      "CoupletIndex": 27
    },
    {
      "VOrder": 57,
      "Position": "Right",
      "Text": "تا برآورد از آن گروه، دمار",
      "CoupletIndex": 28
    },
    {
      "VOrder": 58,
      "Position": "Left",
      "Text": "عاقبت تیغ آبدار تتار",
      "CoupletIndex": 28
    },
    {
      "VOrder": 59,
      "Position": "Right",
      "Text": "شد جهان شسته از بنی عباس",
      "CoupletIndex": 29
    },
    {
      "VOrder": 60,
      "Position": "Left",
      "Text": "دامن خاک، پاک از آن ارجاس",
      "CoupletIndex": 29
    },
    {
      "VOrder": 61,
      "Position": "Right",
      "Text": "کبریای جلال تیغ کشید",
      "CoupletIndex": 30
    },
    {
      "VOrder": 62,
      "Position": "Left",
      "Text": "همه را تیغ بی دربغ کشید",
      "CoupletIndex": 30
    },
    {
      "VOrder": 63,
      "Position": "Right",
      "Text": "هر که واقف ز کار ایشان است",
      "CoupletIndex": 31
    },
    {
      "VOrder": 64,
      "Position": "Left",
      "Text": "در شعار و دثار ایشان است",
      "CoupletIndex": 31
    },
    {
      "VOrder": 65,
      "Position": "Right",
      "Text": "بُود آگه که در بنی آدم",
      "CoupletIndex": 32
    },
    {
      "VOrder": 66,
      "Position": "Left",
      "Text": "کس نکرده ست این فساد و ستم",
      "CoupletIndex": 32
    },
    {
      "VOrder": 67,
      "Position": "Right",
      "Text": "ز آنچه کردند این گروه عنید",
      "CoupletIndex": 33
    },
    {
      "VOrder": 68,
      "Position": "Left",
      "Text": "شرمساری کشید، روح یزید",
      "CoupletIndex": 33
    },
    {
      "VOrder": 69,
      "Position": "Right",
      "Text": "این عبارت کلام مأمون است",
      "CoupletIndex": 34
    },
    {
      "VOrder": 70,
      "Position": "Left",
      "Text": "کافضل این جماعت دون است",
      "CoupletIndex": 34
    },
    {
      "VOrder": 71,
      "Position": "Right",
      "Text": "هر گَه، از خشم و کین برآشفتی",
      "CoupletIndex": 35
    },
    {
      "VOrder": 72,
      "Position": "Left",
      "Text": "رو به عبّاسیان همی گفتی",
      "CoupletIndex": 35
    },
    {
      "VOrder": 73,
      "Position": "Right",
      "Text": "که شمایید نطفه ی مستان",
      "CoupletIndex": 36
    },
    {
      "VOrder": 74,
      "Position": "Left",
      "Text": "زاده از فرج قحبه گان جهان",
      "CoupletIndex": 36
    },
    {
      "VOrder": 75,
      "Position": "Right",
      "Text": "پدر ارشد خلیفه، رشید",
      "CoupletIndex": 37
    },
    {
      "VOrder": 76,
      "Position": "Left",
      "Text": "پردهٔ محرمان خویش درید",
      "CoupletIndex": 37
    },
    {
      "VOrder": 77,
      "Position": "Right",
      "Text": "هر چه کشتید در کنار من است",
      "CoupletIndex": 38
    },
    {
      "VOrder": 78,
      "Position": "Left",
      "Text": "دودهٔ خویش، ننگ و عار من است",
      "CoupletIndex": 38
    },
    {
      "VOrder": 79,
      "Position": "Right",
      "Text": "ناقل این حدیث، بی کم و بیش",
      "CoupletIndex": 39
    },
    {
      "VOrder": 80,
      "Position": "Left",
      "Text": "سنیّانند از خلیفهٔ خویش",
      "CoupletIndex": 39
    },
    {
      "VOrder": 81,
      "Position": "Right",
      "Text": "یاد اینان کراهت انگیز است",
      "CoupletIndex": 40
    },
    {
      "VOrder": 82,
      "Position": "Left",
      "Text": "زنگ آیینه صفاخیز است",
      "CoupletIndex": 40
    },
    {
      "VOrder": 83,
      "Position": "Right",
      "Text": "شهرتِ کارِ این گروه خبیث",
      "CoupletIndex": 41
    },
    {
      "VOrder": 84,
      "Position": "Left",
      "Text": "بی نیاز است از بیان و حدیث",
      "CoupletIndex": 41
    },
    {
      "VOrder": 85,
      "Position": "Right",
      "Text": "مدّعا اینکه روزگار دراز",
      "CoupletIndex": 42
    },
    {
      "VOrder": 86,
      "Position": "Left",
      "Text": "دَرِ صد فتنه شد به خلق فراز",
      "CoupletIndex": 42
    },
    {
      "VOrder": 87,
      "Position": "Right",
      "Text": "خلفای زمانه یارانند",
      "CoupletIndex": 43
    },
    {
      "VOrder": 88,
      "Position": "Left",
      "Text": "دین و ایمان دگر چه سان مانند؟",
      "CoupletIndex": 43
    },
    {
      "VOrder": 89,
      "Position": "Right",
      "Text": "عرض تقلید، قاف تا قاف است",
      "CoupletIndex": 44
    },
    {
      "VOrder": 90,
      "Position": "Left",
      "Text": "کیش اسلام ارث اخلاف است",
      "CoupletIndex": 44
    },
    {
      "VOrder": 91,
      "Position": "Right",
      "Text": "ناقصان زمانه کور و کرند",
      "CoupletIndex": 45
    },
    {
      "VOrder": 92,
      "Position": "Left",
      "Text": "رهسپاران کوی دل دگرند",
      "CoupletIndex": 45
    },
    {
      "VOrder": 93,
      "Position": "Right",
      "Text": "تیره بختان بی صفایی چند",
      "CoupletIndex": 46
    },
    {
      "VOrder": 94,
      "Position": "Left",
      "Text": "روز کوران بی عصایی چند",
      "CoupletIndex": 46
    },
    {
      "VOrder": 95,
      "Position": "Right",
      "Text": "آن یکی را به یاری توفیق",
      "CoupletIndex": 47
    },
    {
      "VOrder": 96,
      "Position": "Left",
      "Text": "حَسَن بصری است، پیر طریق",
      "CoupletIndex": 47
    },
    {
      "VOrder": 97,
      "Position": "Right",
      "Text": "وان دگر، راه اعتزال رود",
      "CoupletIndex": 48
    },
    {
      "VOrder": 98,
      "Position": "Left",
      "Text": "به قفای رم غزال رود",
      "CoupletIndex": 48
    },
    {
      "VOrder": 99,
      "Position": "Right",
      "Text": "اشعری طعنه زن به معتزلی ست",
      "CoupletIndex": 49
    },
    {
      "VOrder": 100,
      "Position": "Left",
      "Text": "کاعتقادش ضلال و تیره دلی ست",
      "CoupletIndex": 49
    },
    {
      "VOrder": 101,
      "Position": "Right",
      "Text": "دیگری خصم جان، اشاعره را",
      "CoupletIndex": 50
    },
    {
      "VOrder": 102,
      "Position": "Left",
      "Text": "به از ایشان نهد، اباغره را",
      "CoupletIndex": 50
    },
    {
      "VOrder": 103,
      "Position": "Right",
      "Text": "یکی از هر دو بر کرانه رود",
      "CoupletIndex": 51
    },
    {
      "VOrder": 104,
      "Position": "Left",
      "Text": "پی کرامیان روانه شود",
      "CoupletIndex": 51
    },
    {
      "VOrder": 105,
      "Position": "Right",
      "Text": "وان سفیه دگر ز کون خری",
      "CoupletIndex": 52
    },
    {
      "VOrder": 106,
      "Position": "Left",
      "Text": "پی سفیان نموده ره سپری",
      "CoupletIndex": 52
    },
    {
      "VOrder": 107,
      "Position": "Right",
      "Text": "سجده بر راه فرض نوری را؟!",
      "CoupletIndex": 53
    },
    {
      "VOrder": 108,
      "Position": "Left",
      "Text": "سامری وار، عجل ثوری را",
      "CoupletIndex": 53
    },
    {
      "VOrder": 109,
      "Position": "Right",
      "Text": "وان دگر را خطاب، خطّابی ست",
      "CoupletIndex": 54
    },
    {
      "VOrder": 110,
      "Position": "Left",
      "Text": "سرمه دیده گرانخوابی ست",
      "CoupletIndex": 54
    },
    {
      "VOrder": 111,
      "Position": "Right",
      "Text": "جان نثار معلّل است یکی!؟",
      "CoupletIndex": 55
    },
    {
      "VOrder": 112,
      "Position": "Left",
      "Text": "توتیای یقین، غبار شکی",
      "CoupletIndex": 55
    },
    {
      "VOrder": 113,
      "Position": "Right",
      "Text": "دیگری در جهان بود کامش",
      "CoupletIndex": 56
    },
    {
      "VOrder": 114,
      "Position": "Left",
      "Text": "انتظام کلام نظامش",
      "CoupletIndex": 56
    },
    {
      "VOrder": 115,
      "Position": "Right",
      "Text": "وان دگر کامل از مریدی شد",
      "CoupletIndex": 57
    },
    {
      "VOrder": 116,
      "Position": "Left",
      "Text": "دم منصور ما تریدی شد",
      "CoupletIndex": 57
    },
    {
      "VOrder": 117,
      "Position": "Right",
      "Text": "کرده ابداع دین نو، مالک",
      "CoupletIndex": 58
    },
    {
      "VOrder": 118,
      "Position": "Left",
      "Text": "پی او گشته زمره ای هالک",
      "CoupletIndex": 58
    },
    {
      "VOrder": 119,
      "Position": "Right",
      "Text": "مرده شکلی که بوی جیفه دهد",
      "CoupletIndex": 59
    },
    {
      "VOrder": 120,
      "Position": "Left",
      "Text": "جان به فتوای بوحنیفه دهد",
      "CoupletIndex": 59
    },
    {
      "VOrder": 121,
      "Position": "Right",
      "Text": "شافعی گشته آشکار و خفی",
      "CoupletIndex": 60
    },
    {
      "VOrder": 122,
      "Position": "Left",
      "Text": "خصم ناموس سیرت حنفی",
      "CoupletIndex": 60
    },
    {
      "VOrder": 123,
      "Position": "Right",
      "Text": "حنبلی پیشوای مشتی خر",
      "CoupletIndex": 61
    },
    {
      "VOrder": 124,
      "Position": "Left",
      "Text": "نه خمش خر، خران دعوی گر",
      "CoupletIndex": 61
    },
    {
      "VOrder": 125,
      "Position": "Right",
      "Text": "گفته افسار گمرهی را دین",
      "CoupletIndex": 62
    },
    {
      "VOrder": 126,
      "Position": "Left",
      "Text": "قاف تقلید کرده داغ سرین",
      "CoupletIndex": 62
    },
    {
      "VOrder": 127,
      "Position": "Right",
      "Text": "درهم افتادگان به مشت و لگد",
      "CoupletIndex": 63
    },
    {
      "VOrder": 128,
      "Position": "Left",
      "Text": "از خری کرده در حماقت، کد",
      "CoupletIndex": 63
    },
    {
      "VOrder": 129,
      "Position": "Right",
      "Text": "شده زین زمرهٔ تعصب گر",
      "CoupletIndex": 64
    },
    {
      "VOrder": 130,
      "Position": "Left",
      "Text": "هر یکی، میخ مقعد دیگر",
      "CoupletIndex": 64
    },
    {
      "VOrder": 131,
      "Position": "Right",
      "Text": "تو ازین گیر و دار غصّه مخور",
      "CoupletIndex": 65
    },
    {
      "VOrder": 132,
      "Position": "Left",
      "Text": "سر خر راست، گوش خر در خور",
      "CoupletIndex": 65
    },
    {
      "VOrder": 133,
      "Position": "Right",
      "Text": "گر نباشد خر الحسب للذات",
      "CoupletIndex": 66
    },
    {
      "VOrder": 134,
      "Position": "Left",
      "Text": "که زند دم ز انکر الاصوات؟",
      "CoupletIndex": 66
    },
    {
      "VOrder": 135,
      "Position": "Right",
      "Text": "همگی راکبند و مرکوبند",
      "CoupletIndex": 67
    },
    {
      "VOrder": 136,
      "Position": "Left",
      "Text": "زیر و بالای یکدگر چوبند",
      "CoupletIndex": 67
    },
    {
      "VOrder": 137,
      "Position": "Right",
      "Text": "تا به کی از ملوک عباسی",
      "CoupletIndex": 68
    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "شهره ی عصر خود به نسناسی؟",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "چونکه ادراک این فضیحت کرد",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "خلق را منع و زجر و غلظت کرد",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "که دگر ترک اجتهادکنند",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "عرصه این است، تا گشاد کنند",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "هر چه بودند اگر فقیه و سفیه",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "مجتهد بس بود چهار فقیه",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "گر کسی خارج از چهار آرند",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "هر که باشد، به گیر و دار آرند",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "سنّیان را که بد هزاران کیش",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "ا سختا ننگ و بلایی آمد پیش",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "رفت اطناب و اختصار آمد",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "چاره ناچار تا چهار آمد",
      "CoupletIndex": 74
    },
    {
      "VOrder": 151,
      "Position": "Right",
      "Text": "بر مرور دهور مذهبها",
      "CoupletIndex": 75
    },
    {
      "VOrder": 152,
      "Position": "Left",
      "Text": "از میان رفت و چار ماند بجا",
      "CoupletIndex": 75
    },
    {
      "VOrder": 153,
      "Position": "Right",
      "Text": "کرد گرگ آشتی، چهار به هم",
      "CoupletIndex": 76
    },
    {
      "VOrder": 154,
      "Position": "Left",
      "Text": "لیک در فکر کارزار به هم",
      "CoupletIndex": 76
    },
    {
      "VOrder": 155,
      "Position": "Right",
      "Text": "فخر رازیّ و حجهٔ الاسلام",
      "CoupletIndex": 77
    },
    {
      "VOrder": 156,
      "Position": "Left",
      "Text": "قاضی ماضی مراغه، نظام",
      "CoupletIndex": 77
    },
    {
      "VOrder": 157,
      "Position": "Right",
      "Text": "حنفی را فضیحتی کردند",
      "CoupletIndex": 78
    },
    {
      "VOrder": 158,
      "Position": "Left",
      "Text": "مذهبش را به صورتی کردند",
      "CoupletIndex": 78
    },
    {
      "VOrder": 159,
      "Position": "Right",
      "Text": "که به کافر نکرده اند آن کار",
      "CoupletIndex": 79
    },
    {
      "VOrder": 160,
      "Position": "Left",
      "Text": "مرحبا دین و حبّذا پیکار",
      "CoupletIndex": 79
    },
    {
      "VOrder": 161,
      "Position": "Right",
      "Text": "هر که گردد ز جهل، یافه سرای",
      "CoupletIndex": 80
    },
    {
      "VOrder": 162,
      "Position": "Left",
      "Text": "خواهد آخر شنید، طعن بجای",
      "CoupletIndex": 80
    },
    {
      "VOrder": 163,
      "Position": "Right",
      "Text": "باشد اسلام اگر تعصب و جهل",
      "CoupletIndex": 81
    },
    {
      "VOrder": 164,
      "Position": "Left",
      "Text": "کیش حجّاج بهتر است از سهل",
      "CoupletIndex": 81
    },
    {
      "VOrder": 165,
      "Position": "Right",
      "Text": "گر مسلمانی این بود، صد بار",
      "CoupletIndex": 82
    },
    {
      "VOrder": 166,
      "Position": "Left",
      "Text": "کیش ملحد به است ازین پیکار",
      "CoupletIndex": 82
    },
    {
      "VOrder": 167,
      "Position": "Right",
      "Text": "ملحد آسوده فارغ البال است",
      "CoupletIndex": 83
    },
    {
      "VOrder": 168,
      "Position": "Left",
      "Text": "ای مسلمان، تو را چه احوال است؟",
      "CoupletIndex": 83
    },
    {
      "VOrder": 169,
      "Position": "Right",
      "Text": "باشد احمق سرشت، مسلم اگر",
      "CoupletIndex": 84
    },
    {
      "VOrder": 170,
      "Position": "Left",
      "Text": "خر ز خر باز هم، بود بهتر",
      "CoupletIndex": 84
    },
    {
      "VOrder": 171,
      "Position": "Right",
      "Text": "باشد اخلاق زشت اگر ایمان",
      "CoupletIndex": 85
    },
    {
      "VOrder": 172,
      "Position": "Left",
      "Text": "یک مسلمان مباد، گو به جهان",
      "CoupletIndex": 85
    },
    {
      "VOrder": 173,
      "Position": "Right",
      "Text": "شرط اسلام اگر بود این قید",
      "CoupletIndex": 86
    },
    {
      "VOrder": 174,
      "Position": "Left",
      "Text": "جحی افضل بود بسی ز جنید",
      "CoupletIndex": 86
    },
    {
      "VOrder": 175,
      "Position": "Right",
      "Text": "این بلایا که نزل جمهور است",
      "CoupletIndex": 87
    },
    {
      "VOrder": 176,
      "Position": "Left",
      "Text": "از خلاف رسول، مجبور است",
      "CoupletIndex": 87
    },
    {
      "VOrder": 177,
      "Position": "Right",
      "Text": "ترک نصّ و وصیّتش کردند",
      "CoupletIndex": 88
    },
    {
      "VOrder": 178,
      "Position": "Left",
      "Text": "عهد او را، پَسِ سر افکندند",
      "CoupletIndex": 88
    },
    {
      "VOrder": 179,
      "Position": "Right",
      "Text": "اوصیای وِی اند، شمع هدا",
      "CoupletIndex": 89
    },
    {
      "VOrder": 180,
      "Position": "Left",
      "Text": "رهنمایان سالکان خدا",
      "CoupletIndex": 89
    },
    {
      "VOrder": 181,
      "Position": "Right",
      "Text": "اُمنای حقایق ایشانند",
      "CoupletIndex": 90
    },
    {
      "VOrder": 182,
      "Position": "Left",
      "Text": "خلفا بر خلایق ایشانند",
      "CoupletIndex": 90
    },
    {
      "VOrder": 183,
      "Position": "Right",
      "Text": "اهل ذکرند و اهلبیت صفا",
      "CoupletIndex": 91
    },
    {
      "VOrder": 184,
      "Position": "Left",
      "Text": "هم اولی الامر و هم ذوی القربا",
      "CoupletIndex": 91
    },
    {
      "VOrder": 185,
