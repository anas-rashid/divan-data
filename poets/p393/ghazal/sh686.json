      "RhymeLetters": null,
      "PlainText": "خصم جانی منت شناخته‌ام\r\nای فلانی منت شناخته‌ام\r\nگرچه نامهربان به ما هستی\r\nمهربانی منت شناخته‌ام\r\nمردم و باورت نمی‌آید\r\nبدگمانی منت شناخته‌ام\r\nمکن ای عندلیب دعوای عشق\r\nقصه‌خوانی منت شناخته‌ام\r\nدلستانی و مانده جان آن نیز\r\nمی‌ستانی منت شناخته‌ام\r\nدرد واقف نمی‌شناسی حیف\r\nای فلانی منت شناخته‌ام",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 6
    }
