      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "مهربانی نشد دوچار به من\r\nقدردانی نشد دوچار به من\r\nمانده در پرده زور زاری من\r\nپهلوای نشد دوچار به من\r\nعمر شد صرف پاسبانی دل\r\nدلستانی نشد دوچار به من\r\nناتوان گشته‌ام ولی چون خود\r\nناتوانی نشد دوچار به من\r\nچو دل خود که جیب من بستست\r\nخسم جانی نشد دوچار به من\r\nماند ناگفته درد دل واقف\r\nهم‌زبانی نشد دوچار به من",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 6
    }
