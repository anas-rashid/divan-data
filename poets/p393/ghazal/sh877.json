      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "ای اشک به خون طپیده‌ای تو\r\nگویا پی دل دویده‌ای تو\r\nای ناوک یار از در دل\r\nمگذر که به جا رسیده‌ای تو\r\nبا عارض او زنی دم از رنگ\r\nای لاله چه داغ دیده‌ای تو\r\nای شوخ به قصد من ز ابرو\r\nپیوسته کمان کشیده‌ای تو\r\nگفتی سخنی ز قطع الفت\r\nواقف چه زبان بریده‌ای تو",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
