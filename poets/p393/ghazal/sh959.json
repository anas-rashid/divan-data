      "RhymeLetters": null,
      "PlainText": "ای ناله به گوش شنوایی نرسیدی\r\nرفتی همه‌جا لیک به جایی نرسیدی\r\nای گریه چو سیلاب به هر کوچه دویدی\r\nیک بار به دیوانه‌سرایی نرسیدی\r\nبی‌فایده رفت این همه صیقل‌گری من\r\nای آینهٔ دل به جلایی نرسیدی\r\nسیر و سفرت هیچ به جایی نرسانید\r\nای کوکب بختم به ضیایی نرسیدی\r\nبردم گله از دست تو در پیش مسیحا\r\nای درد محبت به دوایی نرسیدی\r\nصد حیف که واقف ز سر کوی نکویان\r\nبی‌برگ گذشتی به نوایی نرسیدی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 6
    }
