      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "از پا فکنده قامت رعنای او مرا\r\nبر سر چه آمده است ز بالای او مرا\r\nبی‌تاب می‌شوم چو نبینمش دمی (ایرداد وزنی)\r\nبا آنکه نیست تاب تماشای او مرا\r\nکرده است گرم مجلس اغیار شمع من\r\nداغم که سوخت گرمی بی‌جای او مرا\r\nهوشم تمام در سر زلفش به باد رفت\r\nسرمایه‌ای نماند ز سودای او مرا\r\nدل از کجای او بکنم آه چون کنم\r\nدلتنگی است با همه اعضای او مرا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
