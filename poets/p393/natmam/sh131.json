      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "آنچه با دل آن ستمگر می‌کند\r\nگفته گر آید که باور می‌کند\r\nگرد در کوی تو میدانی که چیست\r\nدادخواهی خاک بر سر می‌کند\r\nساقی دوران چو دور من رسید\r\nجای صهبا خون به ساغر می‌کند\r\nاز پی آن بت برهمن گشته‌ام\r\nآدمی را عشق کافر می‌کند\r\nیار خونین دست با دل آنچه کرد\r\nگر بگویم خون دل سر می‌کند",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
