      "RhymeLetters": null,
      "PlainText": "جان ضعیف من که به جانان نمی‌رسد\r\nموریست ناتوان به سلیمان نمی‌رسد\r\nدور از تو دل اگر نخورد خاک چون کند\r\nای وای قطره‌ای که به عمان نمی‌رسید\r\nیار است و گیسوی که به پایان رسیده است\r\nماییم و شکوه‌ای که به پایان نمی‌رسد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
  ],
  "Verses": [
    {
      "VOrder": 1,
      "Position": "Right",
      "Text": "جان ضعیف من که به جانان نمی‌رسد",
      "CoupletIndex": 0
    },
    {
      "VOrder": 2,
      "Position": "Left",
      "Text": "موریست ناتوان به سلیمان نمی‌رسد",
      "CoupletIndex": 0
    },
    {
      "VOrder": 3,
      "Position": "Right",
      "Text": "دور از تو دل اگر نخورد خاک چون کند",
