      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نه همین عالم ازین زلف دگرگون گردید\r\nعقل کل دید چو این سلسله مجنون گردید\r\nشد ترازو دو سه تیرم به دل از شست کسی\r\nمصرعی چند به این واسطه موزون گردید\r\nسرو گل رنگ قبایم ز کدامین چمنی\r\nبس که دنبال تو گردید دلم خون گردید",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
