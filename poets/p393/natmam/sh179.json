      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "غنچه‌سان تنگی دل از سر من وا نشد\r\nتا چو گل پیراهن من پاره از صد جا نشد\r\nقطرهٔ خود را گهر تا کردم از کسب صفا\r\nعقده‌ای افتاد در کارم که هرگز وا نشد\r\nکسب دانش داشت ما را بی‌نصیب از سوز عشق\r\nقطرهٔ کم بخت ما گوهر شد و دریا نشد",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
