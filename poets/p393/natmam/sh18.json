      "RhymeLetters": null,
      "PlainText": "مجمر داغ گشت سینهٔ ما\r\nنیست امروز کس قرینهٔ ما\r\nیافتم ای فلک ز منطقه‌ات\r\nکه کمر بسته‌ای به کینهٔ ما\r\nمی‌کشد سنگ را به ذوق شکست\r\nجانب خویش آبگینهٔ ما\r\nعشق آمد به یادگار نوشت\r\nغزلی چند در سفینهٔ ما",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
