      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "نماندیم در هجر او زنده بسیار\r\nنگشتیم صد شکر شرمنده بسیار\r\nتوان بست شیرازه از تار زلفی\r\nکه اوراق دل شد پراکنده بسیار\r\nچو گل در دهانت مگر زعفران است\r\nکه بر گریه‌ام می‌زنی خنده بسیار\r\nخدا را ز من دل مکن ای بت من\r\nکه این بنده بهر تو جان کنده بسیار",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
