      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "من کجا معتبرش می‌گردم\r\nگر غلام و نفرش می‌گردم\r\nچاره‌ای نیست چو از خاک شدن\r\nمی‌روم خاک درش می‌گردم\r\nهرقدر گرد دلم گردد یار\r\nآن‌قدر گرد سرش می‌گردم\r\nنیست بی‌هیچ که گردش گردم\r\nدر سراغ کمرش می‌گردم\r\nهر کجا خوش پسری می‌بینم\r\nآشنای پدرش می‌گردم",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
