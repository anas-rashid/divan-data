      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "من ز گیسوی کسی تاری به دست آورده‌ام\r\nبهر خود سررشتهٔ کاری به دست آورده‌ام\r\nطعمهٔ زاغ و زغن کرد او دلی کز من ربود\r\nمن به این خوشدل که دلداری به دست آورده‌ام\r\nیک‌دم ای شور جنون دست از گریبانم مدار\r\nبعد عمری سوزن و تاری به دست آورده‌ام",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
