      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "از درد نهان من چه پرسی\r\nای آفت جان من چه پرسی\r\nبی‌تاب و توان شدم ز دستت\r\nاز تاب و توان من چه پرسی\r\nسودا زده کرد زلف یارم\r\nاز سود و زبان من چه پرسی\r\nدلتنگ‌ترم ز غنچه بی‌تو\r\nای تنگ‌دهان من چه پرسی\r\nبی‌نام و نشان شدم ز دردت\r\nاز نام و نشان من چه پرسی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
