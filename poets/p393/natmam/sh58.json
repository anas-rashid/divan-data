      "RhymeLetters": null,
      "PlainText": "عاشقان را گزند بسیار است\r\nپند بسیار است بند بسیار است\r\nدل به آن زلف می‌کشد ما را\r\nورنه دام و کمند بسیار است\r\nکار هرکس به قدر طاقت اوست\r\nناله‌ای از سپند بسیار است\r\nبهر تصدیع دادن شهری\r\nیک دل دردمند بسیار است\r\nناله بی‌جا کمند می‌سازد\r\nاوج وصلش بلند بسیار است\r\nصبح و گل با لب تو می‌خندند\r\nدر جهان هرزه چند بسیار است",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 6
    }
