      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "شب جدایی آن رشک ماه در پیش است\r\nمرا ببین که چه روز سیاه در پیش است\r\nتو فارغی ز غم ای پند گو برو که مرا\r\nدو صد معامله با اشک و آه در پیش است\r\nفتاده در ذقنش دل اگرچه من او را\r\nهزار بار بگفتم که چاه در پیش است\r\nبه داد ما برس ای خضر وادی توفیق\r\nکه هیچ زاد نداریم و راه در پیش است",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
