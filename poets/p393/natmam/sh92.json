      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "از بس که گریه کردم م در جگر نمانده است\r\nوقت است اگر بیایی عمر این‌قدر نمانده است\r\nعشق تو کرد غارت اسباب عیش و راحت\r\nماییم و نیم‌جانی چیزی درک نمانده است\r\nمردند خستگانت بر خاک آستانت\r\nچون من به بستر غم یک محتضر نمانده است",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 3
    }
