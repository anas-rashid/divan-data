    },
    {
      "VOrder": 138,
      "Position": "Left",
      "Text": "کی دمد صبح این شب دیجور",
      "CoupletIndex": 68
    },
    {
      "VOrder": 139,
      "Position": "Right",
      "Text": "تا بود باغ و راغ را هر سال",
      "CoupletIndex": 69
    },
    {
      "VOrder": 140,
      "Position": "Left",
      "Text": "به ربیع و خریف زینت و حور",
      "CoupletIndex": 69
    },
    {
      "VOrder": 141,
      "Position": "Right",
      "Text": "زلف شاه اسپرغم و روی سمن",
      "CoupletIndex": 70
    },
    {
      "VOrder": 142,
      "Position": "Left",
      "Text": "چشمِ بادام و دیدهٔ انگور",
      "CoupletIndex": 70
    },
    {
      "VOrder": 143,
      "Position": "Right",
      "Text": "باد عیشت به خرمی موصوف",
      "CoupletIndex": 71
    },
    {
      "VOrder": 144,
      "Position": "Left",
      "Text": "باد روزت به فرخی مذکور",
      "CoupletIndex": 71
    },
    {
      "VOrder": 145,
      "Position": "Right",
      "Text": "روزگارت رهی و بخت غلام",
      "CoupletIndex": 72
    },
    {
      "VOrder": 146,
      "Position": "Left",
      "Text": "فلکت بنده و جهان مأمور",
      "CoupletIndex": 72
    },
    {
      "VOrder": 147,
      "Position": "Right",
      "Text": "از ازل دولت تو را توقیع",
      "CoupletIndex": 73
    },
    {
      "VOrder": 148,
      "Position": "Left",
      "Text": "به ابد نعمت تو را منشور",
      "CoupletIndex": 73
    },
    {
      "VOrder": 149,
      "Position": "Right",
      "Text": "تر و تازه خزان تو چو بهار",
      "CoupletIndex": 74
    },
    {
      "VOrder": 150,
      "Position": "Left",
      "Text": "خوی و خرم روان تو چو سُحور",
