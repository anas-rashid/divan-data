      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "با تو نکال از هجاست زیراک\r\nبه جلوه است آن تن تو و ایضا\r\nمست و خراب دوش بخفتی\r\nشد پاره دامن تو و ایضا\r\nواکنون دو رنگ بینم از هار\r\nریش ملون تو و ایضا\r\nهرگز فر حج ندیدم جز تو\r\nای روسپی زن تو و ایضا\r\nامروز از این حکایت عیشست\r\nدر کوی و برزن تو و ایضا",
      "HtmlText": null,
      "PoemFormat": "Ghete",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
