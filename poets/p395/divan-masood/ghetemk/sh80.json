      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "فلک اندر دمید پنداری\r\nباد در آستین ما در تیغ\r\nحکم اختر بدو مهابت از آنک\r\nهم به تیغ اندرست اختر تیغ\r\nبه همه حال ها اجل عرض است\r\nلیک قایم شده به جوهر تیغ\r\nبکند چشم تیغ اگر داری\r\nگوهر کلک را برابر تیغ",
      "HtmlText": null,
      "PoemFormat": "Ghete",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
