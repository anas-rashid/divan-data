      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "گر صبر کنم عمر همی باد شود\r\nور ناله کنم عدو همی شاد شود\r\nشادی عدو نجویم و صبر کنم\r\nشاید که فلک در این میان راد شود\r\nگفتم که چو از بند گشایش باشد\r\nزین بند مگر مرا رهایش باشد\r\nاکنون غم را همی فزایش باشد\r\nآری ملک آن کند که رایش باشد",
      "HtmlText": null,
      "PoemFormat": "Robaee",
      "Language": "fa-IR",
      "CoupletsCount": 4
    }
