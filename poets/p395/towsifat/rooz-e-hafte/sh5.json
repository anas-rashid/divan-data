      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "باشد ابروی و موی و خوی تو خوب\r\nپنجشنبه به مشتری منسوب\r\nباده در ده که عمر بی باده\r\nنیست نزدیک بخردان محسوب\r\nخاصه بر یاد آنکه کرد خدای\r\nاز پی عدل ملک او منصوب\r\nشه ملک ارسلان که دولت او\r\nغالبست و عدوی او مغلوب\r\nباد تا طالعی برآرد چرخ\r\nطالع ملک او بری ز غروب",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
