      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "آدینه مزاج زهره دارد\r\nچون آمد لهو و شادی آرد\r\nای زهره جمال باده درده\r\nکامروزم باده به گوارد\r\nبر یاد خدایگان عالم\r\nکو ملک جهان به عدل دارد\r\nسلطان ملک ارسلان که جودش\r\nچون چرخ همی زمین نگارد\r\nمهر ار نبود چو مهر تابد\r\nابر ار نبود چو ابر بارد",
      "HtmlText": null,
      "PoemFormat": "Generic",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
