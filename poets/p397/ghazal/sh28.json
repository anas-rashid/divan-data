      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "از خدا خواه هر چه خواهی یار\r\nزانکه او جمله را برآرد کار\r\nکیست کو غیر او که داند سوز\r\nبخدا گو که عالم الاسرار\r\nواحد لایزال حق موجود\r\nکل شی ء هلاک خواهی یار\r\nعارفان گفته اند در ره عشق\r\nصبر باید ترا دگر بگزار\r\nبگذر ای یار زین مقام فنا\r\nروی خود را تو در بقای بیار",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
