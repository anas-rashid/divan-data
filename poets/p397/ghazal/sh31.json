      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "وه چه نیکو روی جانان دلپذیر\r\nکس ندیدم مثل آن بدر منیر\r\nمن نه واقف بود می ای دوستان\r\nدل مرا دزدید برد آن بینظیر\r\nبیقرارم سوز در جانم رسید\r\nو هُو عالم بالیقین ما فی الضمیر\r\nدر فراقش سوزم، آرامی نماند\r\nمانده ام حیران چو اصحاب السعیر\r\nیار در غم عشق تو نالد بسی\r\nباید او را سخت ای جانان بگیر",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
