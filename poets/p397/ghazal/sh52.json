      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "کفر اول می شناسد هر کسی\r\nلیک ثانی کفر کی داند کسی\r\nغیر خاصان کس نداند کفر این\r\nمردمان دیدم در آن حیران بسی\r\nخوش بود این کفر از ایمان ما\r\nمن نه گفتم عارفان گفته بسی\r\nیار این کفرست ایمان الخواص\r\nغیر خاص الخاص چون داند کسی\r\nعین عارف گشت آن مرد خدا\r\nکفر ثالث نیک گرداند کسی",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
