      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بارها گفتم ترا دل بارها\r\nگرد این هرگز مگرد این کارها\r\nتو نه ء واقف ز درد دلبران\r\nعشق آسان نیست، مشکل کارها\r\nبوالهوس گر رو بر راهش آورد\r\nمی‌خلد در پای‌هایش خارها\r\nجای آسایش ندیدی ای دلا\r\nبالیقین دان شعله‌های نارها\r\nدم زدن در راه عشق یار نیست\r\nپاره شو در راه او صد پارها",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
