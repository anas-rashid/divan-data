    {
      "Index": 0,
      "Number": 1,
      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "تارها زلفش چو دیدم مارها\r\nپارها گشته دلم چون پارها\r\nکارهای جمله مشکل مانده است\r\nزارها باید دل خود زارها\r\nصورت حسنش مبین ای بی خبر\r\nنور ها این نیست جمله نارها\r\nیار با خوبان تو هرگز دل مده\r\nتا نباشی همچو ما غمخوارها\r\nدین ز دست خود چو ما بگذاشتیم\r\nتا چه کار آید مرا زنارها",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "fa-IR",
      "CoupletsCount": 5
    }
  ],
