  "Poems": [
    {
      "Id": 1152,
      "Title": "یوسف حسن کا حسن آپ خریدار رہا",
      "FullUrl": "/p44/ghazal/sh1152"
    },
    {
      "Id": 1150,
      "Title": "ہو رہا ہے ٹکڑے ٹکڑے دل میرے غم خوار کا",
      "FullUrl": "/p44/ghazal/sh1150"
    },
    {
      "Id": 1146,
      "Title": "دیکھا جو مرگ تو مرنا زیاں نہ تھا",
      "FullUrl": "/p44/ghazal/sh1146"
    },
    {
      "Id": 1144,
      "Title": "اشک بیتاب و نگہ بے باک و چشم تر خراب",
      "FullUrl": "/p44/ghazal/sh1144"
    },
    {
      "Id": 1148,
      "Title": "نظر آئے کیا مجھ سے فانی کی صورت",
      "FullUrl": "/p44/ghazal/sh1148"
    },
    {
      "Id": 1145,
      "Title": "ان سے ہم لو لگائے بیٹھے ہیں",
      "FullUrl": "/p44/ghazal/sh1145"
    },
    {
      "Id": 1147,
      "Title": "محبت ہو تو برق جسم و جاں ہو",
      "FullUrl": "/p44/ghazal/sh1147"
    },
    {
      "Id": 1142,
      "Title": "آنکھیں دکھائیں غیر کو میری خطا کے ساتھ",
      "FullUrl": "/p44/ghazal/sh1142"
    },
    {
      "Id": 1151,
      "Title": "ہے بھی اور پھر نظر نہیں آتی",
      "FullUrl": "/p44/ghazal/sh1151"
    },
    {
      "Id": 1149,
      "Title": "نہ میں سمجھا نہ آپ آئے کہیں سے",
      "FullUrl": "/p44/ghazal/sh1149"
    },
    {
      "Id": 1143,
      "Title": "اب اپنا حال ہم انہیں تحریر کر چکے",
      "FullUrl": "/p44/ghazal/sh1143"
    }
  ]
}
