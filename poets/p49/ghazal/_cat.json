    {
      "Id": 1323,
      "Title": "اگرچہ دل کو لے ساتھ اپنے آیا اشک مرا",
      "FullUrl": "/p49/ghazal/sh1323",
      "RadifLetter": "ا"
    },
    {
      "Id": 1329,
      "Title": "لب جاں بخش کے میٹھے کا تیرے جو مزہ پایا",
      "FullUrl": "/p49/ghazal/sh1329",
      "RadifLetter": "ا"
    },
    {
      "Id": 1326,
      "Title": "رہتا ہے زلف یار مرے من سے من لگا",
      "FullUrl": "/p49/ghazal/sh1326",
      "RadifLetter": "ا"
    },
    {
      "Id": 1328,
      "Title": "شاہد غیب ہویدا نہ ہوا تھا سو ہوا",
      "FullUrl": "/p49/ghazal/sh1328",
      "RadifLetter": "ا"
    },
    {
      "Id": 1324,
      "Title": "دل میں دل دار نہاں تھا مجھے معلوم نہ تھا",
      "FullUrl": "/p49/ghazal/sh1324",
      "RadifLetter": "ا"
    },
    {
      "Id": 1330,
      "Title": "محو فریاد ہو گیا ہے دل",
      "FullUrl": "/p49/ghazal/sh1330",
      "RadifLetter": "ل"
    },
    {
      "Id": 1331,
      "Title": "نہیں ہے اشک سے یہ خون ناب آنکھوں میں",
      "FullUrl": "/p49/ghazal/sh1331",
      "RadifLetter": "ن"
    },
    {
      "Id": 1332,
      "Title": "کیوں کر نہ ایسے جینے سے یا رب ملول ہوں",
      "FullUrl": "/p49/ghazal/sh1332",
      "RadifLetter": "ن"
    },
    {
      "Id": 1325,
      "Title": "دل کو لے جی کو اب لبھاتے ہو",
      "FullUrl": "/p49/ghazal/sh1325",
      "RadifLetter": "و"
    },
    {
      "Id": 1327,
      "Title": "زخم اس سوکے کی کاری ہے خدا خیر کرے",
