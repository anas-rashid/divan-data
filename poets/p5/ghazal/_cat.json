    },
    {
      "Id": 114,
      "Title": "نگاہوں میں اقرار سارے ہوئے ہیں",
      "FullUrl": "/p5/ghazal/sh114"
    },
    {
      "Id": 115,
      "Title": "نہیں ممکن کہ ترے حکم سے باہر میں ہوں",
      "FullUrl": "/p5/ghazal/sh115"
    },
    {
      "Id": 116,
      "Title": "وہ کہتے ہیں اٹھو سحر ہو گئی",
