    {
      "Id": 121,
      "Title": "ہمارے سامنے کچھ ذکر غیروں کا اگر ہوگا",
      "FullUrl": "/p5/ghazal/sh121",
      "RadifLetter": "ا"
    },
    {
      "Id": 109,
      "Title": "مداح ہوں میں دل سے محمد کی آل کا",
      "FullUrl": "/p5/ghazal/sh109",
      "RadifLetter": "ا"
    },
    {
      "Id": 100,
      "Title": "ترے جلال سے خورشید کو زوال ہوا",
      "FullUrl": "/p5/ghazal/sh100",
      "RadifLetter": "ا"
    },
    {
      "Id": 108,
      "Title": "شدت ذات نے یہ حال بنایا اپنا",
      "FullUrl": "/p5/ghazal/sh108",
      "RadifLetter": "ا"
    },
    {
      "Id": 106,
      "Title": "سرو قد لالہ رخ و غنچہ دہن یاد آیا",
      "FullUrl": "/p5/ghazal/sh106",
      "RadifLetter": "ا"
    },
    {
      "Id": 107,
      "Title": "سکۂ داغ جنوں ملتے جو دولت مانگتا",
      "FullUrl": "/p5/ghazal/sh107",
      "RadifLetter": "ا"
    },
    {
      "Id": 103,
      "Title": "خود مزے دار طبیعت ہے تو ساماں کیسا",
      "FullUrl": "/p5/ghazal/sh103",
      "RadifLetter": "ا"
    },
    {
      "Id": 117,
      "Title": "پاؤں پھر ہوویں گے اور دشت مغیلاں ہوگا",
      "FullUrl": "/p5/ghazal/sh117",
      "RadifLetter": "ا"
    },
    {
      "Id": 112,
      "Title": "ملتے ہیں ہاتھ، ہاتھ لگیں گے انار کب",
      "FullUrl": "/p5/ghazal/sh112",
      "RadifLetter": "ب"
    },
    {
      "Id": 105,
      "Title": "دور ساغر کا چلے ساقی دوبارا ایک اور",
      "FullUrl": "/p5/ghazal/sh105",
      "RadifLetter": "ر"
    },
    {
      "Id": 110,
      "Title": "مدت کے بعد اس نے لکھا میرے نام خط",
      "FullUrl": "/p5/ghazal/sh110",
      "RadifLetter": "ط"
    },
    {
      "Id": 99,
      "Title": "بت غنچہ دہن پہ نثار ہوں میں نہیں جھوٹ کچھ اس میں خدا کی قسم",
      "FullUrl": "/p5/ghazal/sh99",
      "RadifLetter": "م"
    },
    {
      "Id": 114,
      "Title": "نگاہوں میں اقرار سارے ہوئے ہیں",
      "FullUrl": "/p5/ghazal/sh114",
      "RadifLetter": "ن"
    },
    {
      "Id": 120,
      "Title": "ہزار جان سے صاحب نثار ہم بھی ہیں",
      "FullUrl": "/p5/ghazal/sh120",
      "RadifLetter": "ن"
    },
    {
      "Id": 113,
      "Title": "نماز کیسی کہاں کا روزہ ابھی میں شغل شراب میں ہوں",
      "FullUrl": "/p5/ghazal/sh113",
      "RadifLetter": "ن"
    },
    {
      "Id": 119,
      "Title": "کیا بنائے صانع قدرت نے پیارے ہاتھ پاؤں",
      "FullUrl": "/p5/ghazal/sh119",
      "RadifLetter": "ن"
    },
    {
      "Id": 115,
      "Title": "نہیں ممکن کہ ترے حکم سے باہر میں ہوں",
      "FullUrl": "/p5/ghazal/sh115",
      "RadifLetter": "ن"
    },
    {
      "Id": 101,
      "Title": "جا لڑی یار سے ہماری آنکھ",
