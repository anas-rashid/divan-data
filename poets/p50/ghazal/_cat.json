  "Poems": [
    {
      "Id": 1333,
      "Title": "آستیں میں سانپ اک پلتا رہا",
      "FullUrl": "/p50/ghazal/sh1333",
      "RadifLetter": "ا"
    },
    {
      "Id": 1338,
      "Title": "ایسا وار پڑا سر کا",
      "FullUrl": "/p50/ghazal/sh1338",
      "RadifLetter": "ا"
    },
    {
      "Id": 1356,
      "Title": "وہ مقام دل و جاں کیا ہوگا",
      "FullUrl": "/p50/ghazal/sh1356",
      "RadifLetter": "ا"
    },
    {
      "Id": 1348,
      "Title": "رنگ دل رنگ نظر یاد آیا",
      "FullUrl": "/p50/ghazal/sh1348",
      "RadifLetter": "ا"
    },
    {
      "Id": 1359,
      "Title": "کیا پتا ہم کو ملا ہے اپنا",
      "FullUrl": "/p50/ghazal/sh1359",
      "RadifLetter": "ا"
    },
    {
      "Id": 1334,
      "Title": "اس کار گہ رنگ میں ہم تنگ نہیں کیا",
      "FullUrl": "/p50/ghazal/sh1334",
      "RadifLetter": "ا"
    },
    {
      "Id": 1352,
      "Title": "ندی کے اس پار کھڑا اک پیڑ اکیلا",
      "FullUrl": "/p50/ghazal/sh1352",
      "RadifLetter": "ا"
    },
    {
      "Id": 1340,
      "Title": "تری نگاہ کا انداز کیا نظر آیا",
      "FullUrl": "/p50/ghazal/sh1340",
      "RadifLetter": "ا"
    },
    {
      "Id": 1350,
      "Title": "مرحلہ دل کا نہ تسخیر ہوا",
      "FullUrl": "/p50/ghazal/sh1350",
      "RadifLetter": "ا"
    },
    {
      "Id": 1360,
      "Title": "کیوں صبا کی نہ ہو رفتار غلط",
      "FullUrl": "/p50/ghazal/sh1360",
      "RadifLetter": "ط"
    },
    {
      "Id": 1337,
      "Title": "اپنی دھوپ میں بھی کچھ جل",
      "FullUrl": "/p50/ghazal/sh1337",
      "RadifLetter": "ل"
    },
    {
      "Id": 1355,
      "Title": "وہ اندھیرا ہے جدھر جاتے ہیں ہم",
      "FullUrl": "/p50/ghazal/sh1355",
      "RadifLetter": "م"
    },
    {
      "Id": 1364,
      "Title": "یوں بھی ہونے کا پتا دیتے ہیں",
      "FullUrl": "/p50/ghazal/sh1364",
      "RadifLetter": "ن"
    },
    {
      "Id": 1341,
      "Title": "تم کب تھے قریب اتنے میں کب دور رہا ہوں",
      "FullUrl": "/p50/ghazal/sh1341",
      "RadifLetter": "ن"
    },
    {
      "Id": 1343,
      "Title": "خبر کچھ ایسی اڑائی کسی نے گاؤں میں",
      "FullUrl": "/p50/ghazal/sh1343",
      "RadifLetter": "ن"
    },
    {
      "Id": 1354,
      "Title": "وقت رستے میں کھڑا ہے کہ نہیں",
      "FullUrl": "/p50/ghazal/sh1354",
      "RadifLetter": "ن"
    },
    {
      "Id": 1339,
      "Title": "تارے درد کے جھونکے بن کر آتے ہیں",
      "FullUrl": "/p50/ghazal/sh1339",
      "RadifLetter": "ن"
    },
    {
      "Id": 1336,
      "Title": "ان کا یا اپنا تماشا دیکھو",
      "FullUrl": "/p50/ghazal/sh1336",
      "RadifLetter": "و"
    },
    {
      "Id": 1349,
      "Title": "صبح کا بھید ملا کیا ہم کو",
      "FullUrl": "/p50/ghazal/sh1349",
      "RadifLetter": "و"
    },
    {
      "Id": 1358,
      "Title": "کہتا ہے ہر مکیں سے مکاں بولتے رہو",
      "FullUrl": "/p50/ghazal/sh1358",
      "RadifLetter": "و"
    },
    {
      "Id": 1346,
      "Title": "دل سے باہر ہیں خریدار ابھی",
      "FullUrl": "/p50/ghazal/sh1346",
      "RadifLetter": "ی"
    },
    {
      "Id": 1357,
      "Title": "وہ نظر آئینہ فطرت ہی سہی",
      "FullUrl": "/p50/ghazal/sh1357",
      "RadifLetter": "ی"
    },
    {
      "Id": 1344,
      "Title": "داغ دل ہم کو یاد آنے لگے",
      "FullUrl": "/p50/ghazal/sh1344",
      "RadifLetter": "ے"
    },
    {
      "Id": 1335,
      "Title": "اعتبار نظر کریں کیسے",
      "FullUrl": "/p50/ghazal/sh1335",
      "RadifLetter": "ے"
    },
    {
      "Id": 1353,
      "Title": "وفا کے زخم ہم دھونے نہ پائے",
      "FullUrl": "/p50/ghazal/sh1353",
      "RadifLetter": "ے"
    },
    {
      "Id": 1363,
      "Title": "ہم کہاں آئنہ لے کر آئے",
      "FullUrl": "/p50/ghazal/sh1363",
      "RadifLetter": "ے"
    },
    {
      "Id": 1361,
      "Title": "ہر طرف بکھرے ہیں رنگیں سائے",
      "FullUrl": "/p50/ghazal/sh1361",
      "RadifLetter": "ے"
    },
    {
      "Id": 1362,
      "Title": "ہم ذرے ہیں خاک رہ گزر کے",
      "FullUrl": "/p50/ghazal/sh1362",
      "RadifLetter": "ے"
    },
    {
      "Id": 1347,
      "Title": "رسم سجدہ بھی اٹھا دی ہم نے",
      "FullUrl": "/p50/ghazal/sh1347",
      "RadifLetter": "ے"
    },
    {
      "Id": 1345,
      "Title": "دل جنس محبت کا خریدار نہیں ہے",
      "FullUrl": "/p50/ghazal/sh1345",
      "RadifLetter": "ے"
    },
    {
      "Id": 1342,
      "Title": "جنوں کی راکھ سے منزل میں رنگ کیا آئے",
      "FullUrl": "/p50/ghazal/sh1342",
      "RadifLetter": "ے"
    },
    {
      "Id": 1351,
      "Title": "مرحلے زیست کے آسان ہوئے",
      "FullUrl": "/p50/ghazal/sh1351",
      "RadifLetter": "ے"
    }
  ]
