      "RhymeLetters": null,
      "PlainText": "ایسا وار پڑا سر کا\r\nبھول گئے رستہ گھر کا\r\nزیست چلی ہے کس جانب\r\nلے کاسہ کاسہ مر کا\r\nکیا کیا رنگ بدلتا ہے\r\nوحشی اپنے اندر کا\r\nدل سے نکل کر دیکھو تو\r\nکیا عالم ہے باہر کا\r\nسر پر ڈالی سرسوں کی\r\nپاؤں میں کانٹا کیکر کا\r\nکون صدف کی بات کرے\r\nنام بڑا ہے گوہر کا\r\nدن ہے سینے کا گھاؤ\r\nرات ہے کانٹا بستر کا\r\nاب تو وہ جی سکتا ہے\r\nجس کا دل ہو پتھر کا\r\nچھوڑو شعر اٹھو باقیؔ\r\nوقت ہوا ہے دفتر کا",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 9
    }
