  "Poems": [
    {
      "Id": 1415,
      "Title": "درد دل پاس وفا جذبۂ ایماں ہونا",
      "FullUrl": "/p52/ghazal/sh1415",
      "RadifLetter": "ا"
    },
    {
      "Id": 1420,
      "Title": "فنا کا ہوش آنا زندگی کا درد سر جانا",
      "FullUrl": "/p52/ghazal/sh1420",
      "RadifLetter": "ا"
    },
    {
      "Id": 1409,
      "Title": "اگر درد محبت سے نہ انساں آشنا ہوتا",
      "FullUrl": "/p52/ghazal/sh1409",
      "RadifLetter": "ا"
    },
    {
      "Id": 1425,
      "Title": "نہ کوئی دوست دشمن ہو شریک درد و غم میرا",
      "FullUrl": "/p52/ghazal/sh1425",
      "RadifLetter": "ا"
    },
    {
      "Id": 1423,
      "Title": "مری بے خودی ہے وہ بے خودی کہ خودی کا وہم و گماں نہیں",
      "FullUrl": "/p52/ghazal/sh1423",
      "RadifLetter": "ن"
    },
    {
      "Id": 1428,
      "Title": "کبھی تھا ناز زمانہ کو اپنے ہند پہ بھی",
      "FullUrl": "/p52/ghazal/sh1428",
      "RadifLetter": "ن"
    },
    {
      "Id": 1424,
      "Title": "نئے جھگڑے نرالی کاوشیں ایجاد کرتے ہیں",
      "FullUrl": "/p52/ghazal/sh1424",
      "RadifLetter": "ن"
    },
    {
      "Id": 1429,
      "Title": "کچھ ایسا پاس غیرت اٹھ گیا اس عہد پر فن میں",
      "FullUrl": "/p52/ghazal/sh1429",
      "RadifLetter": "ن"
    },
    {
      "Id": 1430,
      "Title": "ہم سوچتے ہیں رات میں تاروں کو دیکھ کر",
      "FullUrl": "/p52/ghazal/sh1430",
      "RadifLetter": "ن"
    },
    {
      "Id": 1418,
      "Title": "زباں کو بند کریں یا مجھے اسیر کریں",
      "FullUrl": "/p52/ghazal/sh1418",
      "RadifLetter": "ے"
    },
    {
      "Id": 1408,
      "Title": "انہیں یہ فکر ہے ہر دم نئی طرز جفا کیا ہے",
      "FullUrl": "/p52/ghazal/sh1408",
      "RadifLetter": "ے"
    },
    {
      "Id": 1419,
      "Title": "فنا نہیں ہے محبت کے رنگ و بو کے لئے",
      "FullUrl": "/p52/ghazal/sh1419",
      "RadifLetter": "ے"
    },
    {
      "Id": 1416,
      "Title": "دل کیے تسخیر بخشا فیض روحانی مجھے",
      "FullUrl": "/p52/ghazal/sh1416",
      "RadifLetter": "ے"
    }
  ]
}
