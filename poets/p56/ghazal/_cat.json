      "Id": 1489,
      "Title": "جب ملیں گے کہ اب ملیں گے آپ",
      "FullUrl": "/p56/ghazal/sh1489"
    },
    {
      "Id": 1490,
      "Title": "ذوق الفت اب بھی ہے راحت کا ارماں اب بھی ہے",
      "FullUrl": "/p56/ghazal/sh1490"
    },
    {
      "Id": 1491,
      "Title": "لڑ ہی جائے کسی نگار سے آنکھ",
      "FullUrl": "/p56/ghazal/sh1491"
    },
    {
      "Id": 1492,
      "Title": "وہ اپنے مطلب کی کہہ رہے ہیں زبان پر گو ہے بات میری",
      "FullUrl": "/p56/ghazal/sh1492"
    },
    {
      "Id": 1493,
      "Title": "پوچھتے ہیں وہ عشق کا مطلب",
      "FullUrl": "/p56/ghazal/sh1493"
    },
    {
      "Id": 1494,
      "Title": "چراغ اس نے بجھا بھی دیا جلا بھی دیا",
      "FullUrl": "/p56/ghazal/sh1494"
    },
    {
      "Id": 1495,
      "Title": "کون کہتا ہے نسیم سحری آتی ہے",
      "FullUrl": "/p56/ghazal/sh1495"
    },
    {
      "Id": 1496,
      "Title": "ہے دنیا میں زباں میری اگر بند",
      "FullUrl": "/p56/ghazal/sh1496"
    }
  ]
