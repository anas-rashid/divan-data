    {
      "Id": 1510,
      "Title": "کر سکی کچھ نہ تری زلف سیاہ فام مرا",
      "FullUrl": "/p57/ghazal/sh1510",
      "RadifLetter": "ا"
    },
    {
      "Id": 1505,
      "Title": "جوش پر یوں جذبۂ بے اختیار آ ہی گیا",
      "FullUrl": "/p57/ghazal/sh1505",
      "RadifLetter": "ا"
    },
    {
      "Id": 1504,
      "Title": "جو پوچھا کیا مریض غم کا درماں ہو نہیں سکتا",
      "FullUrl": "/p57/ghazal/sh1504",
      "RadifLetter": "ا"
    },
    {
      "Id": 1498,
      "Title": "اتش حسن بھری ہے تیرے رخساروں میں",
      "FullUrl": "/p57/ghazal/sh1498",
      "RadifLetter": "ن"
    },
    {
      "Id": 1497,
      "Title": "آدھا مزہ وصال کا پائے ہوئے تو ہوں",
      "FullUrl": "/p57/ghazal/sh1497",
      "RadifLetter": "ن"
    },
    {
      "Id": 1509,
      "Title": "نہ پوچھو تم کو اور دشمن کو دل میں کیا سمجھتا ہوں",
      "FullUrl": "/p57/ghazal/sh1509",
      "RadifLetter": "ن"
    },
    {
      "Id": 1507,
      "Title": "ظلم سالے نے کیا یہ دل دلگیر کے ساتھ",
      "FullUrl": "/p57/ghazal/sh1507",
      "RadifLetter": "ھ"
    },
    {
      "Id": 1502,
      "Title": "اگر دشمن کی تھوڑی سی مرمت اور ہو جاتی",
      "FullUrl": "/p57/ghazal/sh1502",
      "RadifLetter": "ی"
    },
    {
      "Id": 1499,
      "Title": "اس قدر بڑھ گئی وحشت ترے دیوانے کی",
      "FullUrl": "/p57/ghazal/sh1499",
      "RadifLetter": "ی"
    },
    {
      "Id": 1506,
      "Title": "شب وعدہ ادھر مجھ کو ہنسی سی آئی جاتی ہے",
      "FullUrl": "/p57/ghazal/sh1506",
      "RadifLetter": "ے"
    },
    {
      "Id": 1508,
      "Title": "عدو کی ان کے کوچہ میں مرمت ہونے والی ہے",
      "FullUrl": "/p57/ghazal/sh1508",
      "RadifLetter": "ے"
    },
    {
      "Id": 1500,
      "Title": "اللہ اللہ وصل کی شب اس قدر اعجاز ہے",
      "FullUrl": "/p57/ghazal/sh1500",
      "RadifLetter": "ے"
    },
    {
      "Id": 1503,
      "Title": "جب خزاں آئی چمن میں سب دغا دینے لگے",
      "FullUrl": "/p57/ghazal/sh1503",
      "RadifLetter": "ے"
    },
    {
      "Id": 1501,
      "Title": "اچھلتا کودتا ہے خوش دل دیوانہ ہوتا ہے",
