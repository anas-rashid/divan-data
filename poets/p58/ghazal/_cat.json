    },
    {
      "Id": 1515,
      "Title": "بت کافر جو تو مجھ سے خفا ہے",
      "FullUrl": "/p58/ghazal/sh1515"
    },
    {
      "Id": 1524,
      "Title": "رہے نہ ایک بھی بیداد گر ستم باقی",
      "FullUrl": "/p58/ghazal/sh1524"
    },
    {
      "Id": 1517,
      "Title": "بیٹھے جو شام سے ترے در پہ سحر ہوئی",
      "FullUrl": "/p58/ghazal/sh1517"
    },
    {
      "Id": 1514,
      "Title": "بال بکھیرے آج پری تربت پر میرے آئے گی",
      "FullUrl": "/p58/ghazal/sh1514"
    },
    {
