      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بلبل کا دل خزاں کے صدمے سے ہل رہا ہے\r\nگل زار کا مرقع مٹی میں مل رہا ہے\r\nعالم میں جس نے جس نے دیکھا ہے عالم ان کا\r\nکوئی تو ہم سے کہہ دے قابو میں دل رہا ہے\r\nرخصت بہار کی ہے کہرام ہے چمن میں\r\nغنچے سے غنچہ بلبل بلبل سے مل رہا ہے\r\nہرگز شباب پر تم نازاں شرفؔ نہ ہونا\r\nملنے کو خاک میں ہے جو پھول کھل رہا ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
