    {
      "Id": 1595,
      "Title": "یار کو ہم نے برملا دیکھا",
      "FullUrl": "/p60/ghazal/sh1595"
    },
    {
      "Id": 1590,
      "Title": "کب تصور یار گل رخسار کا فعل عبث",
      "FullUrl": "/p60/ghazal/sh1590"
    },
    {
      "Id": 1587,
      "Title": "دور ہو درد دل یہ اور درد جگر کسی طرح",
      "FullUrl": "/p60/ghazal/sh1587"
    },
    {
      "Id": 1592,
      "Title": "کیا ہے صندلیں رنگوں نے در بند",
      "FullUrl": "/p60/ghazal/sh1592"
    },
    {
      "Id": 1588,
      "Title": "رکھا سر پر جو آیا یار کا خط",
      "FullUrl": "/p60/ghazal/sh1588"
    },
    {
      "Id": 1594,
      "Title": "ہو چکا وعظ کا اثر واعظ",
      "FullUrl": "/p60/ghazal/sh1594"
    },
    {
      "Id": 1589,
      "Title": "غمگیں نہیں ہوں دہر میں تو شاد بھی نہیں",
      "FullUrl": "/p60/ghazal/sh1589"
    },
    {
      "Id": 1586,
      "Title": "دنیا میں عبادت کو تری آئے ہوئے ہیں",
      "FullUrl": "/p60/ghazal/sh1586"
    },
    {
      "Id": 1584,
      "Title": "بحث کیوں ہے کافر و دیں دار کی",
      "FullUrl": "/p60/ghazal/sh1584"
    },
    {
      "Id": 1591,
      "Title": "کفر ایک رنگ قدرت بے انتہا میں ہے",
      "FullUrl": "/p60/ghazal/sh1591"
    },
    {
      "Id": 1585,
      "Title": "جو ہے یاں آسائش رنج و محن میں مست ہے",
      "FullUrl": "/p60/ghazal/sh1585"
    },
    {
      "Id": 1593,
      "Title": "ہم نہ بت خانے میں نے مسجد ویراں میں رہے",
      "FullUrl": "/p60/ghazal/sh1593"
    }
  ]
