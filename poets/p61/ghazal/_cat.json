  "Poems": [
    {
      "Id": 1596,
      "Title": "آئیں گے گر انہیں غیرت ہوگی",
      "FullUrl": "/p61/ghazal/sh1596"
    },
    {
      "Id": 1600,
      "Title": "اے جنوں ہاتھ کے چلتے ہی مچل جاؤں گا",
      "FullUrl": "/p61/ghazal/sh1600"
    },
    {
      "Id": 1601,
      "Title": "بدلنے رنگ سکھلائے جہاں کو",
      "FullUrl": "/p61/ghazal/sh1601"
    },
    {
      "Id": 1604,
      "Title": "خاک کرتی ہے برنگ چرخ نیلی فام رقص",
      "FullUrl": "/p61/ghazal/sh1604"
    },
    {
      "Id": 1605,
      "Title": "خوں بہانے کے ہیں ہزار طریق",
      "FullUrl": "/p61/ghazal/sh1605"
    },
    {
      "Id": 1606,
      "Title": "سر شوریدہ پائے دشت پیما شام ہجراں تھا",
      "FullUrl": "/p61/ghazal/sh1606"
    },
    {
      "Id": 1608,
      "Title": "صبح قیامت آئے گی کوئی نہ کہہ سکا کہ یوں",
      "FullUrl": "/p61/ghazal/sh1608"
    },
    {
      "Id": 1609,
      "Title": "غمزۂ معشوق مشتاقوں کو دکھلاتی ہے تیغ",
      "FullUrl": "/p61/ghazal/sh1609"
    },
    {
      "Id": 1610,
      "Title": "فلک نے ابر مرے سینہ کا بخار کیا",
      "FullUrl": "/p61/ghazal/sh1610"
    },
    {
      "Id": 1611,
      "Title": "لہو ٹپکا کسی کی آرزو سے",
      "FullUrl": "/p61/ghazal/sh1611"
    },
    {
      "Id": 1612,
      "Title": "مثل حباب بحر نہ اتنا اچھل کے چل",
      "FullUrl": "/p61/ghazal/sh1612"
    },
    {
      "Id": 1613,
      "Title": "وہ دریا بار اشکوں کی جھڑی ہے",
      "FullUrl": "/p61/ghazal/sh1613"
    },
    {
      "Id": 1615,
      "Title": "چراغ حسن ہے روشن کسی کا",
      "FullUrl": "/p61/ghazal/sh1615"
    },
    {
      "Id": 1617,
      "Title": "کھلا ہے جلوۂ پنہاں سے از بس چاک وحشت کا",
      "FullUrl": "/p61/ghazal/sh1617"
    },
    {
      "Id": 1620,
      "Title": "یہ میں کہوں گا فلک پہ جا کر زمیں سے آیا ہوں تنگ آ کر",
      "FullUrl": "/p61/ghazal/sh1620"
    }
  ]
}
