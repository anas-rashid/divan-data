      "Title": "اسرار جہاں لطیفۂ غیبی ہیں",
      "FullUrl": "/p61/rubai/sh1598"
    },
    {
      "Id": 1619,
      "Title": "ہاں جہل تمہیں سے رنگ لایا پھر کیوں",
      "FullUrl": "/p61/rubai/sh1619"
    },
    {
      "Id": 1602,
      "Title": "بیدار نہیں کوئی جہاں خواب میں ہے",
      "FullUrl": "/p61/rubai/sh1602"
    },
    {
      "Id": 1614,
      "Title": "پیری کی سپیدی ہے کہ مرتا ہوں میں",
      "FullUrl": "/p61/rubai/sh1614"
    },
    {
      "Id": 1607,
      "Title": "سچ ہے کہ جہاں میں سیر کیا کیا دیکھی",
      "FullUrl": "/p61/rubai/sh1607"
    },
    {
      "Id": 1616,
      "Title": "کب کوئی فضول ہاتھ ملتا ہے بھلا",
      "FullUrl": "/p61/rubai/sh1616"
    },
    {
      "Id": 1599,
      "Title": "افلاس میں کیوں ٹیکس لگا رکھا ہے",
      "FullUrl": "/p61/rubai/sh1599"
    },
    {
      "Id": 1618,
      "Title": "گرمی امسال کس قیامت کی پڑی",
      "FullUrl": "/p61/rubai/sh1618"
    },
    {
      "Id": 1603,
      "Title": "جو مکتب ایجاد میں داخل ہوگا",
      "FullUrl": "/p61/rubai/sh1603"
    },
    {
      "Id": 1597,
      "Title": "آوارۂ حرص در بہ در پھرتا ہے",
      "FullUrl": "/p61/rubai/sh1597"
    }
