  "Poems": [
    {
      "Id": 1623,
      "Title": "تیرا ستم جو مجھ سے گدا نے سہا سہا",
      "FullUrl": "/p63/ghazal/sh1623"
    },
    {
      "Id": 1636,
      "Title": "میں ترے ڈر سے رو نہیں سکتا",
      "FullUrl": "/p63/ghazal/sh1636"
    },
    {
      "Id": 1634,
      "Title": "لے کے دل اس شوخ نے اک داغ سینے پر دیا",
      "FullUrl": "/p63/ghazal/sh1634"
    },
    {
      "Id": 1640,
      "Title": "کوئی کسی کا کہیں آشنا نہیں دیکھا",
      "FullUrl": "/p63/ghazal/sh1640"
    },
    {
      "Id": 1638,
      "Title": "پوچھتا کون ہے ڈرتا ہے تو اے یار عبث",
      "FullUrl": "/p63/ghazal/sh1638"
    },
    {
      "Id": 1637,
      "Title": "نہ فقط یار بن شراب ہے تلخ",
      "FullUrl": "/p63/ghazal/sh1637"
    },
    {
      "Id": 1644,
      "Title": "یہ آرزو ہے کہ وہ نامہ بر سے لے کاغذ",
      "FullUrl": "/p63/ghazal/sh1644"
    },
    {
      "Id": 1633,
      "Title": "فرہاد کس امید پہ لاتا ہے جوئے شیر",
      "FullUrl": "/p63/ghazal/sh1633"
    },
    {
      "Id": 1635,
      "Title": "مت ستا مجھ کو آن آن عزیز",
      "FullUrl": "/p63/ghazal/sh1635"
    },
    {
      "Id": 1645,
      "Title": "یہ خوب رو نہ چھری نے کٹار رکھتے ہیں",
      "FullUrl": "/p63/ghazal/sh1645"
    },
    {
      "Id": 1631,
      "Title": "شکوہ اپنے طالعوں کی نارسائی کا کروں",
      "FullUrl": "/p63/ghazal/sh1631"
    },
    {
      "Id": 1627,
      "Title": "جو زمیں پر فراغ رکھتے ہیں",
      "FullUrl": "/p63/ghazal/sh1627"
    },
    {
      "Id": 1628,
      "Title": "دل اب اس دل شکن کے پاس کہاں",
      "FullUrl": "/p63/ghazal/sh1628"
    },
    {
      "Id": 1643,
      "Title": "یا رب نہ ہند ہی میں یہ ماٹی خراب ہو",
      "FullUrl": "/p63/ghazal/sh1643"
    },
    {
      "Id": 1642,
      "Title": "کہتا ہے کون ہجر مجھے صبح و شام ہو",
      "FullUrl": "/p63/ghazal/sh1642"
    },
    {
      "Id": 1641,
      "Title": "کہا اغیار کا حق میں مرے منظور مت کیجو",
      "FullUrl": "/p63/ghazal/sh1641"
    },
    {
      "Id": 1624,
      "Title": "تیغ چڑھ اس کی سان پر آئی",
      "FullUrl": "/p63/ghazal/sh1624"
    },
    {
      "Id": 1629,
      "Title": "رات اس تنک مزاج سے کچھ بات بڑھ گئی",
      "FullUrl": "/p63/ghazal/sh1629"
    },
    {
      "Id": 1626,
      "Title": "جادو تھی سحر تھی بلا تھی",
      "FullUrl": "/p63/ghazal/sh1626"
    },
    {
      "Id": 1625,
      "Title": "جا کہے کوئے یار میں کوئی",
      "FullUrl": "/p63/ghazal/sh1625"
    },
    {
      "Id": 1630,
      "Title": "زلف تیری نے پریشاں کیا اے یار مجھے",
      "FullUrl": "/p63/ghazal/sh1630"
    },
    {
      "Id": 1639,
      "Title": "کوئی سمجھائیو یارو مرا محبوب جاتا ہے",
      "FullUrl": "/p63/ghazal/sh1639"
    },
    {
      "Id": 1632,
      "Title": "عشوہ ہے ناز ہے غمزہ ہے ادا ہے کیا ہے",
      "FullUrl": "/p63/ghazal/sh1632"
    }
  ]
}
