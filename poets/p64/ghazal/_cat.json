    {
      "Id": 1650,
      "Title": "شادمانی کا کبھی غم کا کبھی جوش رہا",
      "FullUrl": "/p64/ghazal/sh1650"
    },
    {
      "Id": 1646,
      "Title": "اثر نہ کم ہو کبھی نالۂ رسا تیرا",
      "FullUrl": "/p64/ghazal/sh1646"
    },
    {
      "Id": 1654,
      "Title": "کھٹک نے دل کی دیا زخم بے نشاں کا پتا",
      "FullUrl": "/p64/ghazal/sh1654"
    },
    {
      "Id": 1653,
      "Title": "ڈوب جانے کے سوا عشق میں چارا ہی نہیں",
      "FullUrl": "/p64/ghazal/sh1653"
    },
    {
      "Id": 1655,
      "Title": "ہجر میں غم کش کوئی مجھ سا نہیں",
      "FullUrl": "/p64/ghazal/sh1655"
    },
    {
      "Id": 1652,
      "Title": "غم سے نا اہل وفا حشر تک آزاد نہ ہو",
      "FullUrl": "/p64/ghazal/sh1652"
    },
    {
      "Id": 1647,
      "Title": "جس کو پڑی ہو اپنے گریباں کے تار کی",
      "FullUrl": "/p64/ghazal/sh1647"
    },
    {
      "Id": 1648,
      "Title": "دل لیے اور دکھا دکھا کے لیے",
      "FullUrl": "/p64/ghazal/sh1648"
    },
    {
      "Id": 1649,
      "Title": "ذرا سوچ کر اے جفا کرنے والے",
      "FullUrl": "/p64/ghazal/sh1649"
    },
    {
      "Id": 1651,
      "Title": "عقل دوڑائی بہت کچھ تو گماں تک پہنچے",
      "FullUrl": "/p64/ghazal/sh1651"
    }
  ]
