  "Poems": [
    {
      "Id": 1673,
      "Title": "یوں ہی رہا جو بتوں پر نثار دل میرا",
      "FullUrl": "/p65/ghazal/sh1673",
      "RadifLetter": "ا"
    },
    {
      "Id": 1665,
      "Title": "شکوہ سن کر جو مزاج بت بد خو بدلا",
      "FullUrl": "/p65/ghazal/sh1665",
      "RadifLetter": "ا"
    },
    {
      "Id": 1664,
      "Title": "ساتھ ساتھ اہل تمنا کا وہ مضطر جانا",
      "FullUrl": "/p65/ghazal/sh1664",
      "RadifLetter": "ا"
    },
    {
      "Id": 1667,
      "Title": "پیام لے کے جو پیغام بر روانہ ہوا",
      "FullUrl": "/p65/ghazal/sh1667",
      "RadifLetter": "ا"
    },
    {
      "Id": 1666,
      "Title": "نالے میں کبھی اثر نہ آیا",
      "FullUrl": "/p65/ghazal/sh1666",
      "RadifLetter": "ا"
    },
    {
      "Id": 1670,
      "Title": "کیوں میں اب قابل جفا نہ رہا",
      "FullUrl": "/p65/ghazal/sh1670",
      "RadifLetter": "ا"
    },
    {
      "Id": 1668,
      "Title": "کبھی حیا انہیں آئی کبھی غرور آیا",
      "FullUrl": "/p65/ghazal/sh1668",
      "RadifLetter": "ا"
    },
    {
      "Id": 1661,
      "Title": "حشر پر وعدۂ دیدار ہے کس کا تیرا",
      "FullUrl": "/p65/ghazal/sh1661",
      "RadifLetter": "ا"
    },
    {
      "Id": 1671,
      "Title": "گردش چشم یار نے مارا",
      "FullUrl": "/p65/ghazal/sh1671",
      "RadifLetter": "ا"
    },
    {
      "Id": 1658,
      "Title": "ان کو دماغ پرسش اہل محن کہاں",
      "FullUrl": "/p65/ghazal/sh1658",
      "RadifLetter": "ن"
    },
    {
      "Id": 1659,
      "Title": "جس میں سودا نہیں وہ سر ہی نہیں",
      "FullUrl": "/p65/ghazal/sh1659",
      "RadifLetter": "ن"
    },
    {
      "Id": 1660,
      "Title": "حاصل اس مہ لقا کی دید نہیں",
      "FullUrl": "/p65/ghazal/sh1660",
      "RadifLetter": "ن"
    },
    {
      "Id": 1672,
      "Title": "ہیں وصل میں شوخی سے پابند حیا آنکھیں",
      "FullUrl": "/p65/ghazal/sh1672",
      "RadifLetter": "ن"
    },
    {
      "Id": 1656,
      "Title": "آہ کرنا دل حزیں نہ کہیں",
      "FullUrl": "/p65/ghazal/sh1656",
      "RadifLetter": "ن"
    },
    {
      "Id": 1669,
      "Title": "کیوں مرا حال قصہ خواں سے سنو",
      "FullUrl": "/p65/ghazal/sh1669",
      "RadifLetter": "و"
    },
    {
      "Id": 1663,
      "Title": "رقیبوں کا مجھ سے گلا ہو رہا ہے",
      "FullUrl": "/p65/ghazal/sh1663",
      "RadifLetter": "ے"
    },
    {
      "Id": 1657,
      "Title": "اس بزم میں نہ ہوش رہے گا ذرا مجھے",
      "FullUrl": "/p65/ghazal/sh1657",
      "RadifLetter": "ے"
    },
    {
      "Id": 1662,
      "Title": "درد دل میں کمی نہ ہو جائے",
      "FullUrl": "/p65/ghazal/sh1662",
      "RadifLetter": "ے"
    }
  ]
}
