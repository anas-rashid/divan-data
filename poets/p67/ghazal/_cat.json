  "Poems": [
    {
      "Id": 1743,
      "Title": "جب ناز عشق حسن کے قابل نہیں رہا",
      "FullUrl": "/p67/ghazal/sh1743",
      "RadifLetter": "ا"
    },
    {
      "Id": 1754,
      "Title": "کہتے ہیں تیری لاش پہ آیا نہ جائے گا",
      "FullUrl": "/p67/ghazal/sh1754",
      "RadifLetter": "ا"
    },
    {
      "Id": 1751,
      "Title": "وہی عاشق ہے قاتل کا نہ جو شاکی وہاں ہوگا",
      "FullUrl": "/p67/ghazal/sh1751",
      "RadifLetter": "ا"
    },
    {
      "Id": 1740,
      "Title": "اپنا جہاں میں رہنا ہے یادگار رہنا",
      "FullUrl": "/p67/ghazal/sh1740",
      "RadifLetter": "ا"
    },
    {
      "Id": 1750,
      "Title": "نہ بھولے گا خیال و رنگ رخ کا نامہ بر ہونا",
      "FullUrl": "/p67/ghazal/sh1750",
      "RadifLetter": "ا"
    },
    {
      "Id": 1747,
      "Title": "عالم کو اس نے نقش کف پا بنا دیا",
      "FullUrl": "/p67/ghazal/sh1747",
      "RadifLetter": "ا"
    },
    {
      "Id": 1733,
      "Title": "آنکھوں پر آہ یاس کا پردہ سا پڑ گیا",
      "FullUrl": "/p67/ghazal/sh1733",
      "RadifLetter": "ا"
    },
    {
      "Id": 1749,
      "Title": "نظیر جس کی مل سکے وہ اپنا ماجرا نہ تھا",
      "FullUrl": "/p67/ghazal/sh1749",
      "RadifLetter": "ا"
    },
    {
      "Id": 1746,
      "Title": "صبر وعدے پہ نہ تھا کام تمنائی کا",
      "FullUrl": "/p67/ghazal/sh1746",
      "RadifLetter": "ا"
    },
    {
      "Id": 1758,
      "Title": "یوں بھی دیکھا نہ کبھی درد کا درماں ہونا",
      "FullUrl": "/p67/ghazal/sh1758",
      "RadifLetter": "ا"
    },
    {
      "Id": 1757,
      "Title": "ہنگامہ خیز دعوئ منصور ہو گیا",
      "FullUrl": "/p67/ghazal/sh1757",
      "RadifLetter": "ا"
    },
    {
      "Id": 1755,
      "Title": "کہے یہ کون مکاں اپنا لا مکاں اپنا",
      "FullUrl": "/p67/ghazal/sh1755",
      "RadifLetter": "ا"
    },
    {
      "Id": 1735,
      "Title": "ابھی چمن ابھی گل بس یہی سماں دیکھا",
      "FullUrl": "/p67/ghazal/sh1735",
      "RadifLetter": "ا"
    },
    {
      "Id": 1748,
      "Title": "میں نقش ما و من ہوتا کہ نقش ماسوا ہوتا",
      "FullUrl": "/p67/ghazal/sh1748",
      "RadifLetter": "ا"
    },
    {
      "Id": 1744,
      "Title": "جوش وحشت میں نظر پہنچی نہ اپنے دل کے پاس",
      "FullUrl": "/p67/ghazal/sh1744",
      "RadifLetter": "س"
    },
    {
      "Id": 1742,
      "Title": "تا حشر تو فراق کا احساں ہے اور ہم",
      "FullUrl": "/p67/ghazal/sh1742",
      "RadifLetter": "م"
    },
    {
      "Id": 1752,
      "Title": "پابند حکم گریۂ بے اختیار ہوں",
      "FullUrl": "/p67/ghazal/sh1752",
      "RadifLetter": "ن"
    },
    {
      "Id": 1756,
      "Title": "کیوں اے خیال یار تجھے کیا خبر نہیں",
      "FullUrl": "/p67/ghazal/sh1756",
      "RadifLetter": "ن"
    },
    {
      "Id": 1739,
      "Title": "امتحان و صبر کی حد کیوں پڑے تاخیر میں",
      "FullUrl": "/p67/ghazal/sh1739",
      "RadifLetter": "ن"
    },
    {
      "Id": 1736,
      "Title": "اجل نے کر دیا خاموش تو کیا ہے زباں ہوں میں",
      "FullUrl": "/p67/ghazal/sh1736",
      "RadifLetter": "ن"
    },
    {
      "Id": 1734,
      "Title": "اب تو ہجوم یاس کی کچھ انتہا نہیں",
      "FullUrl": "/p67/ghazal/sh1734",
      "RadifLetter": "ن"
    },
    {
      "Id": 1745,
      "Title": "جگر کو دیکھ کے زخم جگر کو دیکھتے ہیں",
      "FullUrl": "/p67/ghazal/sh1745",
      "RadifLetter": "ن"
    },
    {
      "Id": 1753,
      "Title": "پروانہ سوز شمع سے یوں باخبر نہ ہو",
      "FullUrl": "/p67/ghazal/sh1753",
      "RadifLetter": "و"
    },
    {
      "Id": 1737,
      "Title": "ازل کیا ابتدا حسن و محبت کے ترانے کی",
      "FullUrl": "/p67/ghazal/sh1737",
      "RadifLetter": "ی"
    },
    {
      "Id": 1738,
      "Title": "اف انتہائے شوق میں اب کیا کرے کوئی",
      "FullUrl": "/p67/ghazal/sh1738",
      "RadifLetter": "ی"
    },
    {
      "Id": 1741,
      "Title": "اہل دل اہل نظر شام و سحر رویا کیے",
      "FullUrl": "/p67/ghazal/sh1741",
      "RadifLetter": "ے"
    }
  ]
}
