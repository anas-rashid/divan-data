      "RhymeLetters": null,
      "PlainText": "داروئے درد نہاں راحت جانی صنما\r\nعیسیٰٔ مردہ دلاں یوسف ثانی صنما\r\nتیرے صدقے مری جاں تجھ پہ مرا دل قرباں\r\nوارث کون و مکاں فخر زمانی صنما\r\nتیرا ہر جلوہ ہے آئینۂ اسرار ازل\r\nتیری صورت میں ہیں انوار معانی صنما\r\nدل کے داغوں کو کلیجے سے لگا رکھا ہے\r\nکہ یہی داغ تو ہیں تیری نشانی صنما\r\nتو ہی جب قصۂ غم سے مرے گھبراتا ہے\r\nپھر سنے کون مرے غم کی کہانی صنما\r\nتا کجا اشک بجھائیں گے مرے دل کی لگی\r\nپھونکے دیتا ہے مجھے سوز نہانی صنما\r\nوقف سجدہ ہے ترے در پہ جبین بیدمؔ\r\nقبلۂ دل صنما کعبۂ جانی صنما",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 7
    }
