      "RhymeLetters": null,
      "PlainText": "عزیزاں ستم گر نہ آیا مرے گھر\r\nنہ آیا مرے گھر عزیزاں ستم گر\r\nمحبت تو مت کر دل اس بے وفا سے\r\nدل اس بے وفا سے محبت تو مت کر\r\nلگا دل میں خنجر تمہاری نگہ کا\r\nتمہاری نگہ کا لگا دل میں خنجر\r\nہوا کیوں مکدر تو اے آئنہ رو\r\nتو اے آئنہ رو ہوا کیوں مکدر\r\nوہ ایذا مکرر تجھے دے گا تاباںؔ\r\nتجھے دے گا تاباںؔ وہ ایذا مکرر",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 5
    }
