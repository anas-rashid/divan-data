      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "اس دل میں کر گزر جو یہ تیر آہ الٹے\r\nاک پل میں سب فلک کی یہ بارگاہ الٹے\r\nمفتی و شحنہ قاضی ہیں کشتہ اس نگہ کے\r\nپھرتے ہوں اس کے ہاتھوں یہ داد خواہ الٹے\r\nعشاق کے دلوں کو ٹک میں الٹ پلٹ دے\r\nمکھڑے سے گر دوپٹہ وہ رشک ماہ الٹے\r\nپھرتی ہے یوں نگاہیں اس شوخ جنگجو کی\r\nپامال کر کے جیسے کوئی سپاہ الٹے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
