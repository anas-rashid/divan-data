      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "یہ فرق جیتے ہی جی تک گدا‌ و شاہ میں ہے\r\nوگرنہ بعد فنا مشت خاک راہ میں ہے\r\nنشاں مقام کا غم اور نہ رہنما کوئی\r\nغرض کہ سخت اذیت عدم کی راہ میں ہے\r\nگدا نے چھوڑ کے دنیا کو نقد‌ دیں پایا\r\nبھلا یہ لطف کہاں شہ کے عز و جاہ میں ہے\r\nپسند طبع نہیں اپنی چار دن کا ملاپ\r\nمزا تو زیست کا اے میری جاں نباہ میں ہے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
