      "SectionType": "WholePoem",
      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "حسن اگر آشکار ہو جائے\r\nفتنۂ روزگار ہو جائے\r\nدل کو اس طرح دیکھنے والے\r\nدل اگر بے قرار ہو جائے\r\nشوخئ یار کا تقاضا ہے\r\nشوق بے اختیار ہو جائے\r\nکوئی شکوہ رہے نہ اکبرؔ کو\r\nتو اگر ایک بار ہو جائے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 4
    }
