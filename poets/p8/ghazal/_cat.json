  "Poems": [
    {
      "Id": 170,
      "Title": "انس اپنے میں کہیں پایا نہ بیگانے میں تھا",
      "FullUrl": "/p8/ghazal/sh170"
    },
    {
      "Id": 171,
      "Title": "بتوں کے واسطے تو دین و ایماں بیچ ڈالے ہیں",
      "FullUrl": "/p8/ghazal/sh171"
    },
    {
      "Id": 172,
      "Title": "بہار آئی ہے پھر چمن میں نسیم اٹھلا کے چل رہی ہے",
      "FullUrl": "/p8/ghazal/sh172"
    },
    {
      "Id": 173,
      "Title": "جان دیتے ہی بنی عشق کے دیوانے سے",
      "FullUrl": "/p8/ghazal/sh173"
    },
    {
      "Id": 174,
      "Title": "جس نے تجھے خلوت میں بھی تنہا نہیں دیکھا",
      "FullUrl": "/p8/ghazal/sh174"
    },
    {
      "Id": 175,
      "Title": "دل سرد ہو گیا ہے طبیعت بجھی ہوئی",
      "FullUrl": "/p8/ghazal/sh175"
    },
    {
      "Id": 176,
      "Title": "ذرہ بھی اگر رنگ خدائی نہیں دیتا",
      "FullUrl": "/p8/ghazal/sh176"
    },
    {
      "Id": 177,
      "Title": "رخسار کے پرتو سے بجلی کی نئی دھج ہے",
      "FullUrl": "/p8/ghazal/sh177"
    },
    {
      "Id": 178,
      "Title": "رونے سے جو بھڑاس تھی دل کی نکل گئی",
      "FullUrl": "/p8/ghazal/sh178"
    },
    {
      "Id": 179,
      "Title": "شاعر رنگیں فسانہ ہو گیا",
      "FullUrl": "/p8/ghazal/sh179"
    },
    {
      "Id": 180,
      "Title": "عریاں ہی رہے لاش غریب الوطنی میں",
      "FullUrl": "/p8/ghazal/sh180"
    },
    {
      "Id": 181,
      "Title": "لاکھ لاکھ احسان جس نے درد پیدا کر دیا",
      "FullUrl": "/p8/ghazal/sh181"
    },
    {
      "Id": 182,
      "Title": "مجھ کو آتا ہے تیمم نہ وضو آتا ہے",
      "FullUrl": "/p8/ghazal/sh182"
    },
    {
      "Id": 183,
      "Title": "مسکن وہیں کہیں ہے وہیں آشیاں کہیں",
      "FullUrl": "/p8/ghazal/sh183"
    },
    {
      "Id": 184,
      "Title": "میں خودی میں مبتلا خود کو مٹانے کے لیے",
      "FullUrl": "/p8/ghazal/sh184"
    },
    {
      "Id": 185,
      "Title": "نہ نکلا منہ سے کچھ نکلی نہ کچھ بھی قلب مضطر کی",
      "FullUrl": "/p8/ghazal/sh185"
    },
    {
      "Id": 186,
      "Title": "چلے گا نہیں مجھ پہ فقرا تمہارا",
      "FullUrl": "/p8/ghazal/sh186"
    },
    {
      "Id": 187,
      "Title": "کیا خبر تھی راز دل اپنا عیاں ہو جائے گا",
      "FullUrl": "/p8/ghazal/sh187"
    },
    {
      "Id": 188,
      "Title": "کیا کر رہے ہو ظلم کرو راہ راہ کا",
      "FullUrl": "/p8/ghazal/sh188"
    },
    {
      "Id": 189,
      "Title": "گری گر کر اٹھی پلٹی تو جو کچھ تھا اٹھا لائی",
      "FullUrl": "/p8/ghazal/sh189"
    },
    {
      "Id": 190,
      "Title": "یہ کیسے بال کھولے آئے کیوں صورت بنی غم کی",
      "FullUrl": "/p8/ghazal/sh190"
    }
  ]
