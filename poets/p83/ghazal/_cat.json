  "Poems": [
    {
      "Id": 2186,
      "Title": "سب کو گمان بھی کہ میں آگاہ راز تھا",
      "FullUrl": "/p83/ghazal/sh2186"
    },
    {
      "Id": 2178,
      "Title": "انجام یہ ہوا ہے دل بے قرار کا",
      "FullUrl": "/p83/ghazal/sh2178"
    },
    {
      "Id": 2192,
      "Title": "وہ خوش ہو کے مجھ سے خفا ہو گیا",
      "FullUrl": "/p83/ghazal/sh2192"
    },
    {
      "Id": 2185,
      "Title": "رواںؔ کس کو خبر عنوان آغاز جہاں کیا تھا",
      "FullUrl": "/p83/ghazal/sh2185"
    },
    {
      "Id": 2194,
      "Title": "گل ویرانہ ہوں کوئی نہیں ہے قدرداں میرا",
      "FullUrl": "/p83/ghazal/sh2194"
    },
    {
      "Id": 2191,
      "Title": "نکل جائے یوں ہی فرقت میں دم کیا",
      "FullUrl": "/p83/ghazal/sh2191"
    },
    {
      "Id": 2183,
      "Title": "جینے میں تھی نہ نزع کے رنج و محن میں تھی",
      "FullUrl": "/p83/ghazal/sh2183"
    },
    {
      "Id": 2180,
      "Title": "تقدیر جب معاون تدبیر ہو گئی",
      "FullUrl": "/p83/ghazal/sh2180"
    },
    {
      "Id": 2196,
      "Title": "یوں ہی گر ہر سانس میں تھوڑی کمی ہو جائے گی",
      "FullUrl": "/p83/ghazal/sh2196"
    },
    {
      "Id": 2184,
      "Title": "راہ و رسم ابتدائی دیکھ لی",
      "FullUrl": "/p83/ghazal/sh2184"
    },
    {
      "Id": 2188,
      "Title": "غرض رہبر سے کیا مجھ کو گلہ ہے جذب کامل سے",
      "FullUrl": "/p83/ghazal/sh2188"
    }
  ]
