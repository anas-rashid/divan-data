    },
    {
      "Id": 2240,
      "Title": "شب فراق ہے اور نیند آئی جاتی ہے",
      "FullUrl": "/p84/ghazal/sh2240"
    },
    {
      "Id": 2241,
      "Title": "شب وصل کیا مختصر ہو گئی",
