  "ChildCats": [],
  "Poems": [
    {
      "Id": 2197,
      "Title": "آج کیا حال ہے یا رب سر محفل میرا",
      "FullUrl": "/p84/ghazal/sh2197"
    },
    {
      "Id": 2198,
      "Title": "آدمی آدمی سے ملتا ہے",
      "FullUrl": "/p84/ghazal/sh2198"
    },
    {
      "Id": 2199,
      "Title": "آنکھوں میں بس کے دل میں سما کر چلے گئے",
      "FullUrl": "/p84/ghazal/sh2199"
    },
    {
      "Id": 2200,
      "Title": "آنکھوں کا تھا قصور نہ دل کا قصور تھا",
      "FullUrl": "/p84/ghazal/sh2200"
    },
    {
      "Id": 2201,
      "Title": "آیا نہ راس نالۂ دل کا اثر مجھے",
      "FullUrl": "/p84/ghazal/sh2201"
    },
    {
      "Id": 2202,
      "Title": "اب تو یہ بھی نہیں رہا احساس",
      "FullUrl": "/p84/ghazal/sh2202"
    },
    {
      "Id": 2203,
      "Title": "احساس عاشقی نے بیگانہ کر دیا ہے",
      "FullUrl": "/p84/ghazal/sh2203"
    },
    {
      "Id": 2204,
      "Title": "اس عشق کے ہاتھوں سے ہرگز نہ مفر دیکھا",
      "FullUrl": "/p84/ghazal/sh2204"
    },
    {
      "Id": 2205,
      "Title": "اس کی نظروں میں انتخاب ہوا",
      "FullUrl": "/p84/ghazal/sh2205"
    },
    {
      "Id": 2206,
      "Title": "اسے حال و قال سے واسطہ نہ غرض مقام و قیام سے",
      "FullUrl": "/p84/ghazal/sh2206"
    },
    {
      "Id": 2207,
      "Title": "اللہ اگر توفیق نہ دے انسان کے بس کا کام نہیں",
      "FullUrl": "/p84/ghazal/sh2207"
    },
    {
      "Id": 2208,
      "Title": "اللہ رے اس گلشن ایجاد کا عالم",
      "FullUrl": "/p84/ghazal/sh2208"
    },
    {
      "Id": 2210,
      "Title": "اک لفظ محبت کا ادنیٰ یہ فسانا ہے",
      "FullUrl": "/p84/ghazal/sh2210"
    },
    {
      "Id": 2211,
      "Title": "اگر نہ زہرہ جبینوں کے درمیاں گزرے",
      "FullUrl": "/p84/ghazal/sh2211"
    },
    {
      "Id": 2212,
      "Title": "اے حسن یار شرم یہ کیا انقلاب ہے",
      "FullUrl": "/p84/ghazal/sh2212"
    },
    {
      "Id": 2213,
      "Title": "برابر سے بچ کر گزر جانے والے",
      "FullUrl": "/p84/ghazal/sh2213"
    },
    {
      "Id": 2214,
      "Title": "بے کیف دل ہے اور جیے جا رہا ہوں میں",
      "FullUrl": "/p84/ghazal/sh2214"
    },
    {
      "Id": 2215,
      "Title": "تجھی سے ابتدا ہے تو ہی اک دن انتہا ہوگا",
      "FullUrl": "/p84/ghazal/sh2215"
    },
    {
      "Id": 2216,
      "Title": "ترے جمال حقیقت کی تاب ہی نہ ہوئی",
      "FullUrl": "/p84/ghazal/sh2216"
    },
    {
      "Id": 2218,
      "Title": "جان کر من جملۂ خاصان مے خانہ مجھے",
      "FullUrl": "/p84/ghazal/sh2218"
    },
    {
      "Id": 2219,
      "Title": "جنوں کم جستجو کم تشنگی کم",
      "FullUrl": "/p84/ghazal/sh2219"
    },
    {
      "Id": 2220,
      "Title": "جو اب بھی نہ تکلیف فرمائیے گا",
      "FullUrl": "/p84/ghazal/sh2220"
    },
    {
      "Id": 2221,
      "Title": "جو طوفانوں میں پلتے جا رہے ہیں",
      "FullUrl": "/p84/ghazal/sh2221"
    },
    {
      "Id": 2222,
      "Title": "جہل خرد نے دن یہ دکھائے",
      "FullUrl": "/p84/ghazal/sh2222"
    },
    {
      "Id": 2223,
      "Title": "حسن کافر شباب کا عالم",
      "FullUrl": "/p84/ghazal/sh2223"
    },
    {
      "Id": 2224,
      "Title": "حسن کے احترام نے مارا",
      "FullUrl": "/p84/ghazal/sh2224"
    },
    {
      "Id": 2225,
      "Title": "خوشا بیداد خون حسرت بیداد ہوتا ہے",
      "FullUrl": "/p84/ghazal/sh2225"
    },
    {
      "Id": 2226,
      "Title": "داستان غم دل ان کو سنائی نہ گئی",
      "FullUrl": "/p84/ghazal/sh2226"
    },
    {
      "Id": 2228,
      "Title": "دل میں کسی کے راہ کئے جا رہا ہوں میں",
      "FullUrl": "/p84/ghazal/sh2228"
    },
    {
      "Id": 2229,
      "Title": "دل کو سکون روح کو آرام آ گیا",
      "FullUrl": "/p84/ghazal/sh2229"
    },
    {
      "Id": 2230,
      "Title": "دل کو مٹا کے داغ تمنا دیا مجھے",
      "FullUrl": "/p84/ghazal/sh2230"
    },
    {
      "Id": 2231,
      "Title": "دل گیا رونق حیات گئی",
      "FullUrl": "/p84/ghazal/sh2231"
    },
    {
      "Id": 2232,
      "Title": "دنیا کے ستم یاد نہ اپنی ہی وفا یاد",
      "FullUrl": "/p84/ghazal/sh2232"
    },
    {
      "Id": 2233,
      "Title": "راز جو سینۂ فطرت میں نہاں ہوتا ہے",
