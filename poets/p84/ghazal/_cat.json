    },
    {
      "Id": 2242,
      "Title": "شرما گئے لجا گئے دامن چھڑا گئے",
      "FullUrl": "/p84/ghazal/sh2242"
    },
    {
      "Id": 2244,
      "Title": "طبیعت ان دنوں بیگانۂ غم ہوتی جاتی ہے",
      "FullUrl": "/p84/ghazal/sh2244"
    },
    {
      "Id": 2245,
      "Title": "عشق لا محدود جب تک رہنما ہوتا نہیں",
      "FullUrl": "/p84/ghazal/sh2245"
    },
    {
      "Id": 2246,
      "Title": "عشق میں لا جواب ہیں ہم لوگ",
      "FullUrl": "/p84/ghazal/sh2246"
    },
    {
      "Id": 2247,
      "Title": "عشق کو بے نقاب ہونا تھا",
