    },
    {
      "Id": 2234,
      "Title": "رکھتے ہیں خضر سے نہ غرض رہ نما سے ہم",
      "FullUrl": "/p84/ghazal/sh2234"
    },
    {
      "Id": 2235,
      "Title": "سب پہ تو مہربان ہے پیارے",
      "FullUrl": "/p84/ghazal/sh2235"
    },
    {
      "Id": 2236,
      "Title": "سبھی انداز حسن پیارے ہیں",
      "FullUrl": "/p84/ghazal/sh2236"
    },
    {
      "Id": 2237,
      "Title": "ستم کامیاب نے مارا",
      "FullUrl": "/p84/ghazal/sh2237"
    },
    {
      "Id": 2238,
      "Title": "سینے میں اگر ہو دل بیدار محبت",
