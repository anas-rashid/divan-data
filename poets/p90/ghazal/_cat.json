  "Poems": [
    {
      "Id": 2497,
      "Title": "یار ابتدائے عشق سے بے زار ہی رہا",
      "FullUrl": "/p90/ghazal/sh2497"
    },
    {
      "Id": 2460,
      "Title": "اس زلف سے دل ہو کر آزاد بہت رویا",
      "FullUrl": "/p90/ghazal/sh2460"
    },
    {
      "Id": 2480,
      "Title": "نہ چھٹا ہاتھ سے یک لحظہ گریباں میرا",
      "FullUrl": "/p90/ghazal/sh2480"
    },
    {
      "Id": 2465,
      "Title": "جس کا میسر نہ تھا بھر کے نظر دیکھنا",
      "FullUrl": "/p90/ghazal/sh2465"
    },
    {
      "Id": 2467,
      "Title": "حسن کو اس کے خط کا داغ لگا",
      "FullUrl": "/p90/ghazal/sh2467"
    },
    {
      "Id": 2491,
      "Title": "ہر گھڑی مت روٹھ اس سے پھیر پل میں مل نہ جا",
      "FullUrl": "/p90/ghazal/sh2491"
    },
    {
      "Id": 2495,
      "Title": "ہے یاد تجھ سے میرا وہ شرح حال دینا",
      "FullUrl": "/p90/ghazal/sh2495"
    },
    {
      "Id": 2494,
      "Title": "ہے رشک وصل سے غم دل دار ہی بھلا",
      "FullUrl": "/p90/ghazal/sh2494"
    },
    {
      "Id": 2489,
      "Title": "گر عشق سے واقف مرے محبوب نہ ہوتا",
      "FullUrl": "/p90/ghazal/sh2489"
    },
    {
      "Id": 2469,
      "Title": "دل نے پایا جو مرے مژدہ تری پاتی کا",
      "FullUrl": "/p90/ghazal/sh2469"
    },
    {
      "Id": 2468,
      "Title": "دامن ہے میرا دشت کا دامان دوسرا",
      "FullUrl": "/p90/ghazal/sh2468"
    },
    {
      "Id": 2475,
      "Title": "عزیزو تم نہ کچھ اس کو کہو ہوا سو ہوا",
      "FullUrl": "/p90/ghazal/sh2475"
    },
    {
      "Id": 2459,
      "Title": "اب تجھ سے پھرا یہ دل ناکام ہمارا",
      "FullUrl": "/p90/ghazal/sh2459"
    },
    {
      "Id": 2496,
      "Title": "یا الٰہی مرا دل دار سلامت باشد",
      "FullUrl": "/p90/ghazal/sh2496"
    },
    {
      "Id": 2472,
      "Title": "رکھا پا جہاں میں نگارا زمیں پر",
      "FullUrl": "/p90/ghazal/sh2472"
    },
    {
      "Id": 2477,
      "Title": "قاصد خوش فال لایا اس کے آنے کی خبر",
      "FullUrl": "/p90/ghazal/sh2477"
    },
    {
      "Id": 2464,
      "Title": "جان کر کہتا ہے ہم سے اپنے جانے کی خبر",
      "FullUrl": "/p90/ghazal/sh2464"
    },
    {
      "Id": 2457,
      "Title": "آتا ہوں جب اس گلی سے سو سو خواری کھینچ کر",
      "FullUrl": "/p90/ghazal/sh2457"
    },
    {
      "Id": 2456,
      "Title": "آئے ہیں ہم جہاں میں غم لے کر",
      "FullUrl": "/p90/ghazal/sh2456"
    },
    {
      "Id": 2481,
      "Title": "وفا کے ہیں خوان پر نوالے ز آب اول دوم بہ آتش",
      "FullUrl": "/p90/ghazal/sh2481"
    },
    {
      "Id": 2473,
      "Title": "ساقی ہیں روز نو بہار یک دو سہ چار پنج و شش",
      "FullUrl": "/p90/ghazal/sh2473"
    },
    {
      "Id": 2493,
      "Title": "ہم عشق سوا کم ہیں کسی نام سے واقف",
      "FullUrl": "/p90/ghazal/sh2493"
    },
    {
      "Id": 2471,
      "Title": "راہ رستے میں تو یوں رہتا ہے آ کر ہم سے مل",
      "FullUrl": "/p90/ghazal/sh2471"
    },
    {
      "Id": 2482,
      "Title": "پھری سی دیکھتا ہوں اس چمن کی کچھ ہوا بلبل",
      "FullUrl": "/p90/ghazal/sh2482"
    },
    {
      "Id": 2488,
      "Title": "کیا کہوں تجھ سے مری جان میں شب کا احوال",
      "FullUrl": "/p90/ghazal/sh2488"
    },
    {
      "Id": 2484,
      "Title": "کب تلک پیوے گا تو تر دامنوں سے مل کے مل",
      "FullUrl": "/p90/ghazal/sh2484"
    },
    {
      "Id": 2479,
      "Title": "نہ غرض ننگ سے رکھتے ہیں نہ کچھ نام سے کام",
      "FullUrl": "/p90/ghazal/sh2479"
    },
    {
      "Id": 2487,
      "Title": "کم تر یا بیشتر گئے ہم",
      "FullUrl": "/p90/ghazal/sh2487"
    },
    {
      "Id": 2490,
      "Title": "ہر طرف ہے اس سے میرے دل کے لگ جانے میں دھوم",
      "FullUrl": "/p90/ghazal/sh2490"
    },
    {
      "Id": 2470,
      "Title": "دیکھیں تجھے نہ آویں گے ہم",
      "FullUrl": "/p90/ghazal/sh2470"
    },
    {
      "Id": 2466,
      "Title": "جو ہمیں چاہے اس کے چاکر ہیں",
      "FullUrl": "/p90/ghazal/sh2466"
    },
    {
      "Id": 2462,
      "Title": "ایک دم خشک مرا دیدۂ تر ہے کہ نہیں",
      "FullUrl": "/p90/ghazal/sh2462"
    },
    {
      "Id": 2485,
      "Title": "کب تلک ہم کو نہ آوے گا نظر دیکھیں تو",
      "FullUrl": "/p90/ghazal/sh2485"
    },
    {
      "Id": 2463,
      "Title": "بے وفا گو ملے نہ تو مجھ کو",
      "FullUrl": "/p90/ghazal/sh2463"
    },
    {
      "Id": 2458,
      "Title": "آشنا کب ہو ہے یہ ذکر دل شاد کے ساتھ",
      "FullUrl": "/p90/ghazal/sh2458"
    },
    {
      "Id": 2478,
      "Title": "میری اس پیاری جھب سے آنکھ لگی",
      "FullUrl": "/p90/ghazal/sh2478"
    },
    {
      "Id": 2474,
      "Title": "سینہ تو ڈھونڈ لیا متصل اپنا ہم نے",
      "FullUrl": "/p90/ghazal/sh2474"
    },
    {
      "Id": 2486,
      "Title": "کرے عاشق پہ وہ بیداد جتنا اس کا جی چاہے",
      "FullUrl": "/p90/ghazal/sh2486"
    },
    {
      "Id": 2476,
      "Title": "عشق میں گل کے جو نالاں بلبل غم ناک ہے",
      "FullUrl": "/p90/ghazal/sh2476"
    },
    {
      "Id": 2461,
      "Title": "ان دونوں گھر کا خانہ خدا کون غیر ہے",
      "FullUrl": "/p90/ghazal/sh2461"
    },
    {
      "Id": 2492,
      "Title": "ہم آپ کو تو عشق میں برباد کریں گے",
      "FullUrl": "/p90/ghazal/sh2492"
    },
    {
      "Id": 2483,
      "Title": "چاہے سو ہمیں کر تو گنہ گار ہیں تیرے",
      "FullUrl": "/p90/ghazal/sh2483"
    }
  ]
