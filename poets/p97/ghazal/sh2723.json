      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "بوسہ لیا جو چشم کا بیمار ہو گئے\r\nزلفیں چھوئیں بلا میں گرفتار ہو گئے\r\nسکتہ ہے بیٹھے سامنے تکتے ہیں ان کی شکل\r\nکیا ہم بھی عکس آئینۂ یار ہو گئے\r\nبیٹھے تمہارے در پہ تو جنبش تلک نہ کی\r\nایسے جمے کہ سایۂ دیوار ہو گئے\r\nہم کو تو ان کے خنجر ابرو کے عشق میں\r\nدن زندگی کے کاٹنے دشوار ہو گئے",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur",
      "CoupletsCount": 4
    }
