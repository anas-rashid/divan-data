      "VerseType": "First",
      "RhymeLetters": null,
      "PlainText": "دیکھ بے بادہ کیا ہے اپنا رنگ\r\nرحم اے آسمان مینا رنگ\r\nزور دکھلا رہا ہے کیا کیا رنگ\r\nواہ وا اے جہان رنگا رنگ\r\nہو گئی صنف سے سبک ایسی\r\nلے اڑا ہم کو بھی ہمارا رنگ",
      "HtmlText": null,
      "PoemFormat": "Ghazal",
      "Language": "ur-PK",
      "CoupletsCount": 3
    }
