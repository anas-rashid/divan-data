    },
    {
      "Id": 2772,
      "Title": "عشق ہرچند مری جان سدا کھاتا ہے",
      "FullUrl": "/p99/ghazal/sh2772"
    },
    {
      "Id": 2773,
      "Title": "قتل عاشق کسی معشوق سے کچھ دور نہ تھا",
      "FullUrl": "/p99/ghazal/sh2773"
    },
    {
