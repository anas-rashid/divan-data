    {
      "Id": 2765,
      "Title": "جگ میں آ کر ادھر ادھر دیکھا",
      "FullUrl": "/p99/ghazal/sh2765",
      "RadifLetter": "ا"
    },
    {
      "Id": 2760,
      "Title": "اگر یوں ہی یہ دل ستاتا رہے گا",
      "FullUrl": "/p99/ghazal/sh2760",
      "RadifLetter": "ا"
    },
    {
      "Id": 2762,
      "Title": "تجھی کو جو یاں جلوہ فرما نہ دیکھا",
      "FullUrl": "/p99/ghazal/sh2762",
      "RadifLetter": "ا"
    },
    {
      "Id": 2766,
      "Title": "جگ میں کوئی نہ ٹک ہنسا ہوگا",
      "FullUrl": "/p99/ghazal/sh2766",
      "RadifLetter": "ا"
    },
    {
      "Id": 2773,
      "Title": "قتل عاشق کسی معشوق سے کچھ دور نہ تھا",
      "FullUrl": "/p99/ghazal/sh2773",
      "RadifLetter": "ا"
    },
    {
      "Id": 2784,
      "Title": "ہم نے کس رات نالہ سر نہ کیا",
      "FullUrl": "/p99/ghazal/sh2784",
      "RadifLetter": "ا"
    },
    {
      "Id": 2776,
      "Title": "مدرسہ یا دیر تھا یا کعبہ یا بت خانہ تھا",
      "FullUrl": "/p99/ghazal/sh2776",
      "RadifLetter": "ا"
    },
    {
      "Id": 2771,
      "Title": "سینہ و دل حسرتوں سے چھا گیا",
      "FullUrl": "/p99/ghazal/sh2771",
      "RadifLetter": "ا"
    },
    {
      "Id": 2781,
      "Title": "چمن میں صبح یہ کہتی تھی ہو کر چشم تر شبنم",
      "FullUrl": "/p99/ghazal/sh2781",
      "RadifLetter": "م"
    },
    {
      "Id": 2783,
      "Title": "ہم تجھ سے کس ہوس کی فلک جستجو کریں",
      "FullUrl": "/p99/ghazal/sh2783",
      "RadifLetter": "ن"
    },
    {
      "Id": 2761,
      "Title": "باغ جہاں کے گل ہیں یا خار ہیں تو ہم ہیں",
      "FullUrl": "/p99/ghazal/sh2761",
      "RadifLetter": "ن"
    },
    {
      "Id": 2759,
      "Title": "ان نے کیا تھا یاد مجھے بھول کر کہیں",
      "FullUrl": "/p99/ghazal/sh2759",
      "RadifLetter": "ن"
    },
    {
      "Id": 2775,
      "Title": "مجھے در سے اپنے تو ٹالے ہے یہ بتا مجھے تو کہاں نہیں",
      "FullUrl": "/p99/ghazal/sh2775",
      "RadifLetter": "ن"
    },
    {
      "Id": 2779,
      "Title": "مژگان تر ہوں یا رگ تاک بریدہ ہوں",
      "FullUrl": "/p99/ghazal/sh2779",
      "RadifLetter": "ن"
    },
    {
      "Id": 2770,
      "Title": "سمجھنا فہم گر کچھ ہے طبیعی سے الٰہی کو",
      "FullUrl": "/p99/ghazal/sh2770",
      "RadifLetter": "و"
    },
    {
      "Id": 2778,
      "Title": "ملاؤں کس کی آنکھوں سے میں اپنی چشم حیراں کو",
      "FullUrl": "/p99/ghazal/sh2778",
      "RadifLetter": "و"
    },
    {
      "Id": 2769,
      "Title": "ربط ہے ناز بتاں کو تو مری جان کے ساتھ",
